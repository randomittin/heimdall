 #!/usr/bin/env bash
 # summarize.sh -- top client IPs in a web server access log.
-#
 # Usage: bash summarize.sh <logfile> [N]
-#
-# Reads an Apache/nginx common (or combined) log format file, one request per
-# line, e.g.
-#   203.0.113.7 - - [10/Oct/2023:13:55:36 +0000] "GET /index.html HTTP/1.1" 200 2326
-#
-# Prints the top N (default 3) client IPs by number of successful (2xx/3xx)
-# requests, one per line as "<count> <ip>", highest count first, ties broken by
-# ip in plain string order.  See the task description for the full rules.
-#
-# NOT IMPLEMENTED YET.
+# Counts only lines starting with an IPv4 address whose status (first token
+# after the first quoted request) is 2xx/3xx. Prints "<count> <ip>", top N
+# (default 3), count descending, ties by ip in byte order.
 
-echo "summarize.sh: not implemented yet" >&2
-exit 1
+file=$1
+n=${2:-3}
+
+if [ ! -e "$file" ]; then
+  echo "error: no such file: $file" >&2
+  exit 2
+fi
+
+octet='[0-9][0-9]?[0-9]?'
+LC_ALL=C awk -v re="^${octet}\\\\.${octet}\\\\.${octet}\\\\.${octet} " '
+$0 ~ re {
+  ip = $0
+  sub(/ .*/, "", ip)
+  q1 = index($0, "\"")
+  if (q1 == 0) next
+  rest = substr($0, q1 + 1)
+  q2 = index(rest, "\"")
+  if (q2 == 0) next
+  rest = substr(rest, q2 + 1)
+  sub(/^[ \t]+/, "", rest)
+  sub(/[ \t].*/, "", rest)
+  if (rest ~ /^[23][0-9][0-9]$/) c[ip]++
+}
+END { for (ip in c) print c[ip], ip }
+' < "$file" | LC_ALL=C sort -k1,1nr -k2,2 | head -n "$n"
