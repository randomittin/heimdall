+                fields.append(field)
+                i = n
+                break
+            c = text[j]
+            if c == delimiter:
+                fields.append(field)
+                i = j + 1
+                if i >= n:
+                    fields.append("")
+                    break
+                continue
+            i = skip_term(j)
+            if field or fields:
+                fields.append(field)
+            break
+        records.append(fields)
+    return records
