+
+def slugify(text, max_length=None):
+    """Return an ASCII, lowercase, hyphen-separated slug of text.
+
+    If max_length is given, the slug is truncated to at most that many
+    characters, preferring a word ('-') boundary. Empty results become 'n-a'.
+    """
+    if not isinstance(text, str):
+        raise TypeError("text must be a str")
+    if max_length is not None and max_length < 1:
+        raise ValueError("max_length must be >= 1")
+    ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    slug = re.sub(r"[^a-z0-9]+", "-", ascii_text.lower()).strip("-")
+    if max_length is not None and len(slug) > max_length:
+        head = slug[:max_length]
+        if slug[max_length] == "-" or head.endswith("-"):
+            slug = head
+        else:
+            cut = head.rfind("-")
+            slug = head[:cut] if cut > 0 else head
+        slug = slug.rstrip("-")
+    return slug or "n-a"
