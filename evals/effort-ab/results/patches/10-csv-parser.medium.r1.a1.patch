diff --git a/csvparse.py b/csvparse.py
index e6fb5a9..f479084 100644
--- a/csvparse.py
+++ b/csvparse.py
@@ -38,4 +38,59 @@ def parse_csv(text, delimiter=","):
       is not blank: "  \\n" -> [["  "]].
     * No other processing: no backslash escapes, no type conversion.
     """
-    raise NotImplementedError
+    if not isinstance(delimiter, str) or len(delimiter) != 1 or delimiter in '"\r\n':
+        raise ValueError("invalid delimiter")
+    if text.startswith("\ufeff"):
+        text = text[1:]
+    n = len(text)
+    records = []
+    i = 0
+    while i < n:
+        fields = []
+        blank = text[i] in "\r\n"
+        while True:
+            if i < n and text[i] == '"':
+                i += 1
+                buf = []
+                while True:
+                    if i >= n:
+                        raise ValueError("unterminated quoted field")
+                    c = text[i]
+                    if c == '"':
+                        if i + 1 < n and text[i + 1] == '"':
+                            buf.append('"')
+                            i += 2
+                            continue
+                        i += 1
+                        break
+                    buf.append(c)
+                    i += 1
+                fields.append("".join(buf))
+                if i < n and text[i] not in (delimiter, "\r", "\n"):
+                    line = 1
+                    j = 0
+                    while j < i:
+                        if text[j] == "\r":
+                            if j + 1 < i and text[j + 1] == "\n":
+                                j += 1
+                            line += 1
+                        elif text[j] == "\n":
+                            line += 1
+                        j += 1
+                    raise ValueError("line %d: unexpected character after closing quote" % line)
+            else:
+                j = i
+                while j < n and text[j] not in (delimiter, "\r", "\n"):
+                    j += 1
+                fields.append(text[i:j])
+                i = j
+            if i < n and text[i] == delimiter:
+                i += 1
+                continue
+            if i < n:
+                if text[i] == "\r" and i + 1 < n and text[i + 1] == "\n":
+                    i += 1
+                i += 1
+            break
+        records.append([] if blank else fields)
+    return records
