#!/usr/bin/env python3
"""bin/heimdall-session-usage — proactive, PRE-exhaustion session-budget advisory.

THE QUESTION THIS ANSWERS: bin/heimdall-fallback answers "may I route" (a
safety preflight). Nothing in this repo answers "should I route yet" — a
trigger that fires BEFORE the current Claude Code session actually exhausts
its usage limit, not after. This tool is that trigger.

PHASE 1 FINDING — measured, not assumed. Claude Code's own harness-computed
usage percentage (`rate_limits.five_hour.used_percentage`, `.resets_at`,
`rate_limits.seven_day.used_percentage`) is REAL and IS officially documented
(code.claude.com/docs/en/statusline.md) — sentinels/hmd-statusline.py reads
it defensively today. But three independent checks confirmed it is NOT
reachable from a standalone CLI:
  1. It is delivered EXCLUSIVELY via the statusline hook's own stdin, fresh
     on every render (refreshInterval). Claude Code's hooks schema for every
     OTHER hook event (SessionStart, PreToolUse, PostToolUse, Stop,
     SubagentStop, Notification, UserPromptSubmit) does not include it.
  2. There is no scriptable CLI/`/usage` equivalent — `/usage` is
     interactive-only and does not print a parseable rate_limits object.
  3. There is no on-disk cache. `~/.claude/policy-limits.json` and
     `~/.claude/daemon-auth-status.json` were the two plausibly-named
     candidates found by directory listing; both were inspected directly
     and both hold unrelated data (org policy flags; auth-daemon state).
So: a standalone invocation of THIS tool — not itself the live statusline
process receiving fresh stdin — structurally cannot reach that number, and
the one file that could bridge the gap (sentinels/hmd-statusline.py) is out
of this tool's ownership by explicit instruction.

Per that finding, this tool NEVER reports a percentage of Anthropic's real
quota, and NEVER invents a token-count proxy dressed as one — "a hardcoded
token guess dressed as '95% of limit' would be worse than no trigger" is the
standard this was built to. Instead it reports an honest, OPERATOR-CONFIGURED
CONSUMPTION ADVISORY: tokens + requests actually observed in the CURRENT
session's own transcript within a recent window, compared against a budget
the operator sets explicitly (HEIMDALL_SESSION_TOKEN_BUDGET). Every field
name says "budget" (operator-set), never "limit" (Anthropic-real) — the two
are not interchangeable anywhere in this file or its output.

FOUR VERDICT STATES, ON PURPOSE — collapsing "unknown" into either neighbor
is exactly the failure mode this tool exists to prevent:
  unconfigured — no operator budget set; a percentage is mathematically
                 undefined, not merely "0% used"
  unknown      — a budget IS set, but consumption could not be measured
                 (missing transcript, unreadable file, no usable records)
  under        — measured, below threshold
  crossed      — measured, at/above threshold

EXIT CODE CONTRACT: exit code answers exactly one question — "should the
caller act right now?" 0 = no (covers under, unknown, AND unconfigured —
none of those is grounds for a caller to change behavior), 1 = crossed (the
one actionable state). This is deliberately unconditional (not gated behind
--strict) because the task this was built for is exactly "make the verdict
visible to a shell `if` without parsing JSON." --strict is reserved, exactly
as in bin/heimdall-529-scan and bin/heimdall-pressure, for surfacing REJECTED
input (2) or an internal crash (3) — operational failure modes that are
orthogonal to the verdict and stay invisible to a normal caller by default.

CURRENT SESSION: identified via $CLAUDE_CODE_SESSION_ID (confirmed exported
into tool/hook subprocess environments by Claude Code 2.1.241 — verified
directly in this environment), overridable with --session-id, or bypassed
entirely with --file (what the test suite uses, so tests never touch a real
transcript). Transcript-directory resolution mirrors bin/heimdall-529-scan's
resolve_dir() (git-common-dir-based, worktree-safe) — reimplemented here
rather than imported, matching that tool's own precedent of a self-contained,
stdlib-only script with no cross-tool coupling.

BOUNDED WORK, ON PURPOSE: reads at most --max-bytes (default 8 MiB, env
HEIMDALL_SESSION_USAGE_MAX_BYTES) from the END of exactly one file — the
current session's own — never the transcript corpus. Only sums usage records
whose own timestamp falls within --window-secs (default 18000s / 5h — the
same real window Claude Code's own "five_hour" limit uses; borrowed because
it is a real, disclosed constant of the system being approximated, not
invented by this tool). Reports measured wall-clock latency every call.

NEVER-FAILS CONTRACT (matches bin/heimdall-pressure and bin/heimdall-529-
scan): a missing transcript, an unreadable file, or malformed JSON lines all
degrade to the "unknown" verdict at exit 0 — never a crash, never a
fabricated number — unless the caller opts into --strict.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

DEFAULT_WINDOW_SECS = 18000  # 5h — matches Claude Code's own five_hour rate-limit window
DEFAULT_MAX_BYTES = 8 * 1024 * 1024  # 8 MiB tail cap
DEFAULT_THRESHOLD_PCT = 95.0  # the operator's own stated target, not invented here

BUDGET_ENV = "HEIMDALL_SESSION_TOKEN_BUDGET"
WINDOW_ENV = "HEIMDALL_SESSION_USAGE_WINDOW_SECS"
MAXBYTES_ENV = "HEIMDALL_SESSION_USAGE_MAX_BYTES"
THRESHOLD_ENV = "HEIMDALL_SESSION_USAGE_THRESHOLD_PCT"

UNCONFIGURED = "unconfigured"
UNKNOWN = "unknown"
UNDER = "under"
CROSSED = "crossed"

USAGE_KEYS = (
    "input_tokens",
    "output_tokens",
    "cache_creation_input_tokens",
    "cache_read_input_tokens",
)

NOTE = (
    "percent_of_budget is NOT Anthropic's real usage percentage. That figure "
    "(rate_limits.five_hour.used_percentage) is real but is only delivered "
    "via the statusline hook's live stdin, with no CLI or on-disk access "
    "path (verified 2026-08-25 — see module docstring). This is consumption "
    "measured from this session's own transcript against an "
    "OPERATOR-CONFIGURED budget, nothing more."
)


class Rejected(Exception):
    """Bad CLI usage / bad flag value — caught by main(), never a crash."""


def _env_int(name, default):
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        return int(float(raw))
    except (TypeError, ValueError):
        return default


def _env_float(name, default):
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        return float(raw)
    except (TypeError, ValueError):
        return default


def _parse_ts(raw):
    """Same contract as heimdall-529-scan._parse_ts: ISO-8601 'Z'-suffixed
    Claude Code transcript timestamp -> aware datetime, or None (fail open)."""
    if not raw or not isinstance(raw, str):
        return None
    text = raw.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(text)
    except (TypeError, ValueError):
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def _slugify_path(path):
    """Best-effort reconstruction of Claude Code's own ~/.claude/projects/
    directory naming (same guess as bin/heimdall-529-scan; not a stable
    public contract — pass --file to bypass it entirely)."""
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def _git_common_dir(repo):
    try:
        out = subprocess.run(
            ["git", "-C", repo, "rev-parse", "--git-common-dir"],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode == 0 and out.stdout.strip():
        return out.stdout.strip()
    return None


def _canonical_repo_root(repo):
    """The MAIN repo working directory, even when called from inside a git
    worktree — see bin/heimdall-529-scan for the full rationale. Falls back
    to the given repo path on any error; never raises."""
    git_dir = _git_common_dir(repo)
    if git_dir is None:
        return os.path.abspath(repo)
    if not os.path.isabs(git_dir):
        git_dir = os.path.join(repo, git_dir)
    return os.path.dirname(os.path.abspath(git_dir))


def resolve_dir(repo):
    root = _canonical_repo_root(repo)
    return str(Path.home() / ".claude" / "projects" / _slugify_path(root))


def resolve_transcript_path(repo, session_id):
    """None is a normal, expected outcome (no session id available) — not an
    error; the caller folds it into the 'unknown' verdict."""
    if not session_id:
        return None
    directory = resolve_dir(repo)
    return os.path.join(directory, "%s.jsonl" % session_id)


def _extract_usage_tokens(record):
    """message.usage.{input,output,cache_creation_input,cache_read_input}
    tokens -> int total, or None if this record carries no usable usage
    block. None means 'skip this record', never 'zero' — a record that
    legitimately used 0 tokens must never be indistinguishable from one hmd
    could not read at all."""
    if not isinstance(record, dict):
        return None
    message = record.get("message")
    if not isinstance(message, dict):
        return None
    usage = message.get("usage")
    if not isinstance(usage, dict):
        return None
    total = 0
    found = False
    for key in USAGE_KEYS:
        v = usage.get(key)
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            total += v
            found = True
    return int(total) if found else None


def measure(path, cutoff_ts, max_bytes):
    """Read-only, bounded to at most max_bytes from the tail of exactly one
    file. Returns a dict; NEVER raises.
      ok         bool — False means 'could not measure' (feeds UNKNOWN)
      tokens     int  — summed usage tokens observed in-window
      requests   int  — count of usage-bearing records observed in-window
      bytes_read int
      truncated  bool — True if the read window did not start at byte 0
      reason     str|None — populated only when ok is False
    """
    result = {"ok": False, "tokens": 0, "requests": 0, "bytes_read": 0,
              "truncated": False, "reason": None}
    if not path:
        result["reason"] = "no transcript path resolvable (no session id and no --file)"
        return result
    try:
        size = os.path.getsize(path)
    except OSError as exc:
        result["reason"] = "transcript not readable: %s" % (exc.strerror or exc,)
        return result
    try:
        with open(path, "rb") as fh:
            if size > max_bytes:
                fh.seek(size - max_bytes)
                result["truncated"] = True
            raw = fh.read()
    except OSError as exc:
        result["reason"] = "transcript not readable: %s" % (exc.strerror or exc,)
        return result

    result["bytes_read"] = len(raw)
    text = raw.decode("utf-8", errors="replace")
    lines = text.split("\n")
    if result["truncated"] and lines:
        lines = lines[1:]  # drop the line a mid-file seek likely cut in half

    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            record = json.loads(line)
        except (ValueError, TypeError):
            continue  # malformed line: skip it, never fail the whole read
        ts = _parse_ts(record.get("timestamp")) if isinstance(record, dict) else None
        if ts is None or ts.timestamp() < cutoff_ts:
            continue
        tokens = _extract_usage_tokens(record)
        if tokens is None:
            continue
        result["tokens"] += tokens
        result["requests"] += 1

    result["ok"] = True
    return result


def compute_verdict(measured, budget, threshold_pct):
    """-> (verdict_str, percent_or_None). budget<=0 is treated the same as
    'not configured' — a non-positive budget cannot yield a meaningful
    percentage either."""
    if budget is None or budget <= 0:
        return UNCONFIGURED, None
    if not measured["ok"]:
        return UNKNOWN, None
    pct = (measured["tokens"] / budget) * 100.0
    return (CROSSED if pct >= threshold_pct else UNDER), pct


def cmd_status(args):
    start = time.monotonic()
    budget = args.budget if args.budget is not None else _env_float(BUDGET_ENV, None)
    threshold = args.threshold if args.threshold is not None else _env_float(THRESHOLD_ENV, DEFAULT_THRESHOLD_PCT)
    window = args.window_secs if args.window_secs is not None else _env_int(WINDOW_ENV, DEFAULT_WINDOW_SECS)
    max_bytes = args.max_bytes if args.max_bytes is not None else _env_int(MAXBYTES_ENV, DEFAULT_MAX_BYTES)
    window = max(1, window)
    max_bytes = max(1, max_bytes)
    session_id = args.session_id or os.environ.get("CLAUDE_CODE_SESSION_ID")

    cutoff = datetime.now(timezone.utc) - timedelta(seconds=window)
    path = args.file or resolve_transcript_path(args.repo, session_id)
    measured = measure(path, cutoff.timestamp(), max_bytes)
    verdict, pct = compute_verdict(measured, budget, threshold)
    latency_ms = round((time.monotonic() - start) * 1000, 2)

    result = {
        "verdict": verdict,
        "crossed": verdict == CROSSED,
        "percent_of_budget": round(pct, 2) if pct is not None else None,
        "threshold_pct": threshold,
        "budget_tokens": budget,
        "budget_configured": budget is not None and budget > 0,
        "tokens_observed": measured["tokens"],
        "requests_observed": measured["requests"],
        "window_secs": window,
        "since": cutoff.isoformat(),
        "session_id": session_id,
        "transcript_path": path,
        "transcript_ok": measured["ok"],
        "transcript_reason": measured["reason"],
        "bytes_read": measured["bytes_read"],
        "window_truncated_by_byte_cap": measured["truncated"],
        "max_bytes": max_bytes,
        "latency_ms": latency_ms,
        "note": NOTE,
    }

    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print("heimdall-session-usage: verdict=%s" % verdict)
        if result["budget_configured"]:
            print("  budget: %s tokens (operator-configured via %s)" % (budget, BUDGET_ENV))
        else:
            print("  budget: NOT CONFIGURED (%s unset or <=0) - percentage is undefined, not zero" % BUDGET_ENV)
        if pct is not None:
            print("  observed: %d tokens / %d requests in last %ds (%.2f%% of budget, threshold %.1f%%)" % (
                measured["tokens"], measured["requests"], window, pct, threshold))
        else:
            print("  observed: %d tokens / %d requests in last %ds (percentage undefined)" % (
                measured["tokens"], measured["requests"], window))
        if not measured["ok"]:
            print("  transcript: UNREADABLE (%s)" % measured["reason"])
        else:
            print("  transcript: %s (%d bytes read%s)" % (
                path, measured["bytes_read"], ", tail-truncated" if measured["truncated"] else ""))
        print("  latency: %.2fms" % latency_ms)
        print("  NOTE: not Anthropic's real quota %% (inaccessible outside the live statusline hook) - operator-budget consumption only.")

    return 1 if verdict == CROSSED else 0


def cmd_where(args):
    session_id = args.session_id or os.environ.get("CLAUDE_CODE_SESSION_ID")
    path = args.file or resolve_transcript_path(args.repo, session_id)
    print(path or "")
    return 0


def build_parser():
    class _Parser(argparse.ArgumentParser):
        """Route a usage error through Rejected instead of straight to
        sys.exit(2), so the never-fails contract covers a malformed
        invocation too (mirrors bin/heimdall-529-scan / bin/heimdall-pressure)."""

        def error(self, message):
            raise Rejected(message)

    ap = _Parser(
        prog="heimdall-session-usage",
        description="Honest, operator-configured consumption advisory for "
                    "the CURRENT Claude Code session. Reports observed "
                    "token/request usage from this session's own transcript "
                    "against an operator-set budget. Does NOT and cannot "
                    "report Anthropic's real quota percentage (see module "
                    "docstring). Exit 0 = no action needed (under/unknown/"
                    "unconfigured), exit 1 = crossed. Never crashes a caller.")
    ap.add_argument("--repo", default=".", help="repo root, used to derive the transcript directory (default: cwd)")
    ap.add_argument("--strict", action="store_true", help="surface rejected input / internal errors as real exit codes (tests only; does not change the crossed/under exit contract)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status", help="report current-session consumption vs the operator-configured budget")
    s.add_argument("--session-id", default=None, help="override $CLAUDE_CODE_SESSION_ID")
    s.add_argument("--file", default=None, help="read this transcript file directly, bypassing session-id resolution (tests use this)")
    s.add_argument("--budget", type=float, default=None, help="operator token budget for the window (default: env %s; unset/<=0 = unconfigured)" % BUDGET_ENV)
    s.add_argument("--threshold", type=float, default=None, help="percent-of-budget that counts as crossed (default: %.1f, env %s)" % (DEFAULT_THRESHOLD_PCT, THRESHOLD_ENV))
    s.add_argument("--window-secs", type=int, default=None, help="how far back to sum usage, in seconds (default: %d, env %s)" % (DEFAULT_WINDOW_SECS, WINDOW_ENV))
    s.add_argument("--max-bytes", type=int, default=None, help="cap on bytes read from the tail of the transcript (default: %d, env %s)" % (DEFAULT_MAX_BYTES, MAXBYTES_ENV))
    s.add_argument("--json", action="store_true", help="emit result as one JSON object")
    s.set_defaults(fn=cmd_status)

    w = sub.add_parser("where", help="print the resolved transcript path and exit")
    w.add_argument("--session-id", default=None)
    w.add_argument("--file", default=None)
    w.set_defaults(fn=cmd_where)

    return ap


def main(argv):
    strict = "--strict" in argv
    try:
        args = build_parser().parse_args(argv)
    except Rejected as exc:
        if strict:
            sys.stderr.write("error: %s\n" % exc)
            return 2
        return 0
    args.repo = os.path.abspath(args.repo)
    return args.fn(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except BrokenPipeError:
        raise SystemExit(0)
    except SystemExit:
        raise
    except Exception as exc:  # last-resort guard: this tool must never crash its caller
        if "--strict" in sys.argv:
            sys.stderr.write("error: %s\n" % exc)
            raise SystemExit(3)
        raise SystemExit(0)
