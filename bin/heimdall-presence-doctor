#!/usr/bin/env bash
# heimdall-presence-doctor — SELF-HEALING autoenroll / presence doctor.
#
# WHY THIS EXISTS. Getting a teammate onto the presence wall took HOURS of manual
# diagnosis: a missing crypto backend, the WRONG python interpreter (crypto installed
# into interpreter A while hmd ran interpreter B), a closed enroll gate, a STALE enroll
# throttle stamp, a PATH shadow. Every machine is different. This doctor folds that
# manual chase into ONE idempotent, best-effort, background self-heal loop that
# diagnoses -> remediates -> verifies until presence is HEALTHY (a signed beat lands
# and the caller appears in their OWN roster), then QUIESCES. When it exhausts what it
# can safely fix it emits ONE loud, actionable message and stops — never a hot loop.
#
# THE CHAIN (each step: detect -> auto-fix if safe -> re-verify):
#   1. INTERPRETER — resolve the EXACT python heimdall-presence uses
#      (command -v python3 || python) and use THAT SAME one for every check + fix. The
#      #1 subtle bug is installing crypto into a DIFFERENT interpreter than hmd runs.
#   2. CRYPTO BACKEND — if cp_auth.crypto_available() is False under THAT interpreter,
#      auto-install `cryptography` into it (--user, then --break-system-packages for a
#      PEP-668 externally-managed interpreter), then RE-VERIFY the import (mirrors
#      install.sh's ensure_crypto_backend approach).
#   3. STALE THROTTLE — a failed enroll writes <haid>.enroll-attempt which throttles the
#      client's bootstrap ~180s. The doctor is itself driving a FRESH remediation, so it
#      CLEARS that stamp (its own backoff governs cadence — no hammer loop).
#   4. ENROLL — keygen -> POST /enroll (with the team secret). The REAL HTTP status is
#      captured (never swallowed). 2xx -> persist the 0600 seed, done. 4xx -> map the
#      reason (bad_enroll_token / team_full / team_frozen / invalid_pubkey / ...) to an
#      actionable diagnostic and STOP (server-side, cannot self-fix). transport 0 / 5xx
#      -> offline/transient, retry with backoff.
#   5. VERIFY — with a seed present, beat and confirm the caller's HAID appears in its
#      OWN roster read -> HEALTHY, stop retrying.
#
# BACKGROUND + BACKOFF. `--bg` runs a detached loop (keeper-start spawns it) that retries
# on an exponential-ish backoff (5s,15s,60s,120s,180s cap) until HEALTHY or a hard,
# server-side, unfixable cause, then quiesces. A wallclock backstop bounds a perpetually
# offline machine (then it emits the loud message and stops). It NEVER spins hot, NEVER
# blocks a session, and does NOTHING when consent is OFF (respects the existing gate).
#
# EXPOSED (via `heimdall-presence doctor …`, which exec's this):
#   heimdall-presence doctor            run the chain ONCE, verbose (what it fixed / what's left).
#   heimdall-presence doctor --bg       detached self-heal loop (keeper-start invokes this).
#   heimdall-presence doctor --status   print the persisted last-diagnosis.
#
# Non-fatal by construction: every step is best-effort + idempotent + logged to a
# persisted diagnosis; the process always exits 0 (a doctor that crashed a session would
# be worse than the disease).

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PRESENCE="$SELF_DIR/heimdall-presence"   # REUSE its beat/roster/status (never re-implemented).
IDENTITY_CLI="$SELF_DIR/heimdall-identity"
HAID_CLI="$SELF_DIR/heimdall-haid"
REPO="$(cd "$SELF_DIR/.." && pwd)"
LIB="$REPO/bin/lib"

# Canonical CP URL + opt-in consent gate — the SAME source-of-truth the client reads, so the
# doctor honors the fail-safe DEFAULT OFF: it resolves the baked-in default (and thus enrolls /
# phones home) ONLY when the dev has opted in. shellcheck source=lib/cp-consent.sh
[ -f "$LIB/cp-consent.sh" ] && . "$LIB/cp-consent.sh"

# ── the interpreter — THE SAME one heimdall-presence resolves (bin/heimdall-presence:74).
# Every check + fix below runs under THIS python, so crypto is never installed into a
# different interpreter than the one hmd actually beats with (the #1 subtle bug).
PY="$(command -v python3 || command -v python || true)"

# ── argv (the doctor's own flags — the client exec's us with the args after `doctor`) ──
MODE="once"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --bg)      MODE="bg"; shift ;;
    --once)    MODE="once"; shift ;;
    --status)  MODE="status"; shift ;;
    -h|--help|help) MODE="help"; shift ;;
    *) echo "heimdall-presence-doctor: unexpected argument: $1" >&2; exit 2 ;;
  esac
done

# ── identity / project / wire resolution (mirrors heimdall-presence, flag>env>derive) ──
HMD_DIR="${HOME:-}/.heimdall"
CONFIG_FILE="$HMD_DIR/cp-endpoint.json"

# Normalize a git remote to a STABLE project id — byte-identical to heimdall-presence's
# normalize_remote so the doctor enrolls/verifies against the SAME project the client beats to.
normalize_remote() {
  printf '%s' "$1" \
    | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' \
          -e 's#^[^@/]*@##' \
          -e 's#:[0-9][0-9]*/#/#' \
          -e 's#:#/#' \
          -e 's#\.git$##' \
          -e 's#/$##' \
    | tr '[:upper:]' '[:lower:]'
}

HAID="${HMD_HAID:-}"
if [ -z "$HAID" ] && [ -x "$IDENTITY_CLI" ]; then HAID="$("$IDENTITY_CLI" current 2>/dev/null || true)"; fi
if [ -z "$HAID" ] && [ -x "$HAID_CLI" ];     then HAID="$("$HAID_CLI" current 2>/dev/null || true)"; fi

PROJECT="${HMD_PROJECT:-}"
if [ -z "$PROJECT" ]; then
  REMOTE_URL="$(git config --get remote.origin.url 2>/dev/null || true)"
  [ -n "$REMOTE_URL" ] && PROJECT="$(normalize_remote "$REMOTE_URL")"
  if [ -z "$PROJECT" ]; then
    TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "$TOP" ] && PROJECT="$(basename "$TOP")"
  fi
fi

HANDLE="${HMD_HANDLE:-}"
if [ -z "$HANDLE" ] && [ -x "$IDENTITY_CLI" ]; then HANDLE="$("$IDENTITY_CLI" --handle 2>/dev/null || true)"; fi

# CP url (env > shipped config > baked default) + the config's enroll token. Parsed via the
# SAME python the beat uses, so there is no jq dependency on this path.
CFG_URL=""; CFG_TOKEN=""
if [ -n "$PY" ] && [ -n "${HOME:-}" ] && [ -f "$CONFIG_FILE" ]; then
  CFG_OUT="$("$PY" - "$CONFIG_FILE" 2>/dev/null <<'PYEOF' || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    sys.stdout.write((d.get("url") or "") + "\n" + (d.get("enroll_token") or "") + "\n")
except Exception:
    sys.stdout.write("\n\n")
PYEOF
)"
  CFG_URL="$(printf '%s\n' "$CFG_OUT" | sed -n '1p')"
  CFG_TOKEN="$(printf '%s\n' "$CFG_OUT" | sed -n '2p')"
fi
URL="${HEIMDALL_CP_URL:-${BASE_URL:-}}"
[ -n "$URL" ] || URL="$CFG_URL"
DEFAULT_CP_URL="${HEIMDALL_DEFAULT_CP_URL:-}"   # canonical (sourced from lib/cp-consent.sh).
# OPT-IN GATE (fail-safe): resolve the baked-in default ONLY when the dev opted in. Undecided/
# declined => URL empty => the doctor's remediation is a clean no-op (no enroll, no phone-home).
if [ -z "$URL" ] && [ "$(_cp_consent_decision 2>/dev/null)" = "connected" ]; then
  URL="$(_cp_consent_url 2>/dev/null)"
fi
ENROLL_TOKEN="$CFG_TOKEN"

# The per-repo TEAM secret — resolved with the SAME precedence + auto-solo mint the client
# uses (bin/heimdall-presence), so the doctor's enroll binds this HAID to the IDENTICAL team
# the client's beats/reads scope to (otherwise VERIFY would read a different partition and
# never see itself). The secret crosses to python via the ENVIRONMENT only, never argv.
TEAM_DIR="${HEIMDALL_TEAM_DIR:-}"
if [ -z "$TEAM_DIR" ]; then
  TEAM_TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$TEAM_TOP" ]; then TEAM_DIR="$TEAM_TOP/.heimdall"; else TEAM_DIR="$PWD/.heimdall"; fi
fi
TEAM_FILE="$TEAM_DIR/team.json"
SHARED_FILE="$TEAM_DIR/team.shared.json"
TEAM_SECRET=""
if [ -n "$PY" ]; then
  TEAM_SECRET="$(HMD_TEAM_DIR_R="$TEAM_DIR" HMD_TEAM_FILE_R="$TEAM_FILE" HMD_TEAM_SHARED_R="$SHARED_FILE" "$PY" - 2>/dev/null <<'PYEOF' || true
import json, os, secrets, sys, time
team_dir = os.environ["HMD_TEAM_DIR_R"]
path = os.environ["HMD_TEAM_FILE_R"]
shared = os.environ["HMD_TEAM_SHARED_R"]


def _read(p):
    try:
        d = json.load(open(p))
        s = d.get("team_secret")
    except Exception:
        return "", ""
    if isinstance(s, str) and s:
        src = d.get("source")
        return s, (src if isinstance(src, str) else "")
    return "", ""


ps, psrc = _read(path)
ss, _ss = _read(shared)
if ps and psrc in ("new", "join", "rotate"):
    sys.stdout.write(ps); sys.exit(0)
if ss:
    sys.stdout.write(ss); sys.exit(0)
if ps:
    sys.stdout.write(ps); sys.exit(0)
try:
    os.makedirs(team_dir, mode=0o700, exist_ok=True)
    sec = secrets.token_urlsafe(32)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, (json.dumps({"team_secret": sec, "created": int(time.time()), "source": "auto-solo"}) + "\n").encode("utf-8"))
    finally:
        os.close(fd)
    os.chmod(path, 0o600)
    sys.stdout.write(sec)
except FileExistsError:
    sys.stdout.write(_read(path)[0])
except Exception:
    sys.stdout.write("")
PYEOF
)"
fi

# Per-(machine,repo) seed + throttle-stamp + diagnosis paths, keyed by the slugged haid —
# byte-identical to the client so both agree on the SAME files.
PKI_DIR=""; SEED_FILE=""; ENROLL_STAMP=""; DOCTOR_DIAG=""
if [ -n "${HOME:-}" ] && [ -n "$HAID" ]; then
  PKI_DIR="$HMD_DIR/pki"
  HAID_SLUG="$(printf '%s' "$HAID" | tr '/:' '__')"
  SEED_FILE="$PKI_DIR/$HAID_SLUG.seed"
  ENROLL_STAMP="$PKI_DIR/$HAID_SLUG.enroll-attempt"
  DOCTOR_DIAG="$PKI_DIR/$HAID_SLUG.doctor-diagnosis"
fi

# The detached-loop lock (ONE live doctor per project — idempotent, mirrors the keeper pidfile).
DOCTOR_DIR="${HEIMDALL_DOCTOR_DIR:-$HMD_DIR/presence-doctor}"
PROJ_SLUG="$(printf '%s' "${PROJECT:-repo}" | tr '/:@ ' '____')"
DOCTOR_PIDFILE="$DOCTOR_DIR/$PROJ_SLUG.pid"

# ── small helpers ───────────────────────────────────────────────────────────────
CHAIN_STATE=""   # HEALTHY | UNFIXABLE | RETRY — set by run_chain.
CHAIN_MSG=""     # a human sentence describing the current state.

_loud()  { printf 'heimdall %s\n' "$1" >&2; }             # ONE loud, actionable stderr line.
step()   { local v="$1"; shift; [ "$v" = "verbose" ] && printf '  %s\n' "$*" || true; }

# Consent — reuse heimdall-presence's OWN canonical evaluation (per-repo + global toggles) via
# its status output, so the doctor's gate can never drift from the beat's gate. Captured into a
# var + matched with `case` (NOT `status | grep -q`) because grep -q closes the pipe on the first
# match -> `status` takes SIGPIPE -> `set -o pipefail` would report the pipeline as FAILED and the
# off-state would be missed.
_pres_off() {
  local out; out="$("$PRESENCE" status 2>/dev/null || true)"
  case "$out" in *"effective: OFF"*) return 0 ;; *) return 1 ;; esac
}

# crypto_available() under THE SAME interpreter (through the REAL cp_auth — agrees byte-for-byte
# with what the beat will decide at signing time).
_crypto_available() {
  [ -n "$PY" ] || return 1
  LIB="$LIB" "$PY" - <<'PYEOF' >/dev/null 2>&1
import os, sys
sys.path.insert(0, os.environ["LIB"])
import cp_auth
sys.exit(0 if cp_auth.crypto_available() else 1)
PYEOF
}

# Install `cryptography` into THAT interpreter (mirrors install.sh ensure_crypto_backend):
# plain --user first, then --break-system-packages for a PEP-668 externally-managed interpreter.
# Best-effort; pip's exit is NOT trusted — _crypto_available re-checks. HMD_DOCTOR_PIP_CMD is a
# TEST SEAM (injects a harmless command in place of the real network install).
_install_crypto() {
  [ -n "$PY" ] || return 0
  if [ -n "${HMD_DOCTOR_PIP_CMD:-}" ]; then
    eval "$HMD_DOCTOR_PIP_CMD" >/dev/null 2>&1 || true
    return 0
  fi
  "$PY" -m pip install --user --quiet cryptography >/dev/null 2>&1 \
    || "$PY" -m pip install --user --break-system-packages --quiet cryptography >/dev/null 2>&1 \
    || true
}

# Persist the last diagnosis (readable by `heimdall-presence status` + `doctor --status`).
# Atomic; never secret-bearing (state + human reason + interpreter + ts only).
persist_diag() {
  [ -n "$DOCTOR_DIAG" ] && [ -n "$PY" ] || return 0
  mkdir -p "$(dirname "$DOCTOR_DIAG")" 2>/dev/null || true
  D_STATE="$1" D_REASON="$2" D_DETAIL="${3:-}" D_INTERP="$PY" \
    "$PY" - "$DOCTOR_DIAG" <<'PYEOF' 2>/dev/null || true
import json, os, sys, time
p = sys.argv[1]
d = {"state": os.environ.get("D_STATE"),
     "reason": os.environ.get("D_REASON"),
     "detail": os.environ.get("D_DETAIL") or None,
     "interpreter": os.environ.get("D_INTERP"),
     "ts": int(time.time())}
tmp = p + ".tmp.%d" % os.getpid()
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(d, f)
os.replace(tmp, p)
PYEOF
}

# The ENROLL: keygen (REUSE cp_auth — never hand-roll Ed25519) -> POST /enroll capturing the
# REAL HTTP status -> on 2xx persist the 0600 seed. Emits ONE line: `RESULT <status> <reason>`.
# The team secret + token ride the ENVIRONMENT (never argv), matching the client's security.
_do_enroll() {
  LIB="$LIB" PRES_URL="$URL" PRES_HAID="$HAID" PRES_ENROLL_TOKEN="$ENROLL_TOKEN" \
  PRES_TEAM_SECRET="$TEAM_SECRET" PRES_HANDLE="$HANDLE" PRES_SEED_FILE="$SEED_FILE" \
  "$PY" - <<'PYEOF'
import json, os, sys, urllib.error, urllib.request
sys.path.insert(0, os.environ["LIB"])
import cp_auth as K  # REUSE the shipped Ed25519 keygen.

BASE = (os.environ.get("PRES_URL") or "").rstrip("/")
HAID = os.environ.get("PRES_HAID") or ""
token = os.environ.get("PRES_ENROLL_TOKEN") or ""
team = os.environ.get("PRES_TEAM_SECRET") or ""
handle = os.environ.get("PRES_HANDLE") or None
seed_file = os.environ.get("PRES_SEED_FILE") or ""


def out(status, reason):
    sys.stdout.write("RESULT %s %s\n" % (status, reason))
    sys.exit(0)


if not K.crypto_available():
    out(0, "crypto_unavailable")
if not BASE or not HAID or not seed_file:
    out(0, "no_wire")
try:
    priv_b64, pub_b64 = K.generate_keypair()
except Exception:  # noqa: BLE001 — keygen fault -> offline (the chain retries).
    out(0, "keygen_failed")

body = json.dumps({"haid": HAID, "pubkey": pub_b64, "handle": handle}).encode("utf-8")
req = urllib.request.Request(BASE + "/enroll", data=body, method="POST")
req.add_header("Content-Type", "application/json")
req.add_header("X-Heimdall-HAID", HAID)
if token:
    req.add_header("X-Heimdall-Enroll-Token", token)
if team:
    req.add_header("X-Heimdall-Team-Secret", team)

status, reason = 0, ""
try:
    with urllib.request.urlopen(req, timeout=10) as resp:
        status = resp.status
        resp.read()
except urllib.error.HTTPError as exc:
    status = exc.code
    try:
        d = json.loads(exc.read() or b"{}")
        reason = d.get("reason") or ""
    except Exception:  # noqa: BLE001 — a non-JSON error body -> no reason code.
        reason = ""
except Exception:  # noqa: BLE001 — transport/DNS/TLS fault -> status 0 (offline).
    status = 0

if 200 <= status < 300:
    try:
        os.makedirs(os.path.dirname(seed_file), mode=0o700, exist_ok=True)
        fd = os.open(seed_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            os.write(fd, priv_b64.encode("ascii"))
        finally:
            os.close(fd)
        os.chmod(seed_file, 0o600)
    except OSError:
        out(status, "seed_persist_failed")
    out(status, "enrolled")
out(status, reason or "refused")
PYEOF
}

# Map a 4xx enroll refusal reason to an ACTIONABLE, human diagnostic. These are all SERVER-SIDE
# causes the doctor cannot self-fix — it surfaces them loudly and stops (never a hot loop).
_map_enroll_reason() {
  local st="$1" r="$2"
  case "$r" in
    bad_enroll_token) printf 'enroll refused (%s): the enroll token is wrong/expired/revoked — fix enroll_token in %s (server-side)' "$st" "$CONFIG_FILE" ;;
    enroll_disabled|enroll_disabled_cloud_profile) printf 'enroll refused (%s): the server has enrollment DISABLED (no enroll token configured server-side) — ask the team admin' "$st" ;;
    team_full) printf 'enroll refused (%s): your team is FULL (per-team member cap reached) — ask the team admin to raise HEIMDALL_TEAM_MAX_MEMBERS' "$st" ;;
    team_frozen) printf 'enroll refused (%s): team enrollment is FROZEN (anomaly guard) — ask the team admin to unfreeze' "$st" ;;
    enroll_registry_full) printf 'enroll refused (%s): the server registry is FULL (global cap) — ask the team admin to raise HEIMDALL_ENROLL_MAX_KEYS' "$st" ;;
    team_secret_weak) printf 'enroll refused (%s): the team secret is too weak/short — re-mint the team (hmd team new)' "$st" ;;
    team_required) printf 'enroll refused (%s): no team configured and the server has no default team — set up a team (hmd team new)' "$st" ;;
    invalid_pubkey) printf 'enroll refused (%s): the server rejected the public key (invalid_pubkey) — likely a crypto version mismatch, reinstall cryptography' "$st" ;;
    haid_pubkey_conflict) printf 'enroll refused (%s): this HAID is already enrolled with a DIFFERENT key — remove the stale seed (%s) or contact the admin' "$st" "$SEED_FILE" ;;
    *) printf 'enroll refused (%s): %s (server-side)' "$st" "${r:-refused}" ;;
  esac
}

# VERIFY: read the caller's OWN roster (REUSE `heimdall-presence roster --json`) and confirm
# this HAID is on it — the definition of HEALTHY (a signed beat landed where its team reads it).
_verify_roster() {
  [ -n "$PY" ] || return 1
  local out; out="$("$PRESENCE" roster --json 2>/dev/null || printf '[]')"
  printf '%s' "$out" | HAID="$HAID" "$PY" -c '
import json, os, sys
try:
    rows = json.load(sys.stdin)
except Exception:
    sys.exit(1)
if not isinstance(rows, list):
    sys.exit(1)
h = os.environ["HAID"]
sys.exit(0 if any(isinstance(r, dict) and r.get("haid") == h for r in rows) else 1)' 2>/dev/null
}

# ── the diagnose -> remediate -> verify chain (one pass). Sets CHAIN_STATE / CHAIN_MSG. ──
run_chain() {
  local V="$1"   # "verbose" | "quiet"
  CHAIN_STATE=""; CHAIN_MSG=""

  # 1. INTERPRETER — the SAME python the beat uses; every fix below runs under it.
  step "$V" "1. interpreter: ${PY:-<none>}  (command -v python3 || python)"
  if [ -z "$PY" ]; then
    CHAIN_STATE="UNFIXABLE"; CHAIN_MSG="no python interpreter on PATH — presence needs one"
    persist_diag no_python "$CHAIN_MSG" ""; _loud "presence-doctor: $CHAIN_MSG"
    return 0
  fi
  if [ -z "$HAID" ]; then
    CHAIN_STATE="RETRY"; CHAIN_MSG="no HAID/identity resolved yet (heimdall-identity/heimdall-haid) — will retry"
    persist_diag no_identity "$CHAIN_MSG" ""
    step "$V" "   -> no identity resolved yet — will retry"
    return 0
  fi

  # 2. CRYPTO BACKEND — auto-install into THAT interpreter, then re-verify.
  if _crypto_available; then
    step "$V" "2. crypto backend: OK (Ed25519 available under this interpreter)"
  else
    step "$V" "2. crypto backend: MISSING — installing cryptography into $PY"
    _install_crypto
    if _crypto_available; then
      step "$V" "   -> installed; the Ed25519 backend now imports"
    else
      CHAIN_STATE="RETRY"
      CHAIN_MSG="Ed25519 backend missing; auto-install failed — run: $PY -m pip install --user cryptography"
      persist_diag crypto_missing "$CHAIN_MSG" "$PY"
      _loud "presence-doctor: $CHAIN_MSG"
      step "$V" "   -> STILL MISSING after auto-install (you are INVISIBLE until this is fixed)"
      return 0
    fi
  fi

  # 3. STALE THROTTLE — the doctor drives a FRESH attempt, so clear the enroll-attempt stamp
  #    (its own backoff, not the client's per-render throttle, governs cadence here).
  if [ -n "$ENROLL_STAMP" ] && [ -f "$ENROLL_STAMP" ]; then
    rm -f "$ENROLL_STAMP" 2>/dev/null || true
    step "$V" "3. stale enroll-throttle stamp CLEARED (self-heal drives a fresh enroll)"
  else
    step "$V" "3. no stale enroll-throttle stamp"
  fi

  # 4. ENROLL — only when there is no seed yet (a present seed means already enrolled).
  if [ -s "$SEED_FILE" ]; then
    step "$V" "4. enroll: a signing seed already exists — skipping (idempotent)"
  else
    step "$V" "4. enroll: keygen -> POST /enroll (team secret in header)"
    local res st reason
    res="$(_do_enroll)"
    st="$(printf '%s\n' "$res" | awk 'NR==1{print $2}')"; st="${st//[^0-9]/}"; st="${st:-0}"
    reason="$(printf '%s\n' "$res" | awk 'NR==1{print $3}')"
    if [ "$st" -ge 200 ] && [ "$st" -lt 300 ]; then
      step "$V" "   -> enrolled (HTTP $st); persisted the 0600 signing seed"
    elif [ "$st" -ge 400 ] && [ "$st" -lt 500 ]; then
      case "$reason" in
        bad_enroll_token|enroll_disabled|enroll_disabled_cloud_profile|team_full|team_frozen|enroll_registry_full|team_secret_weak|team_required|invalid_pubkey|haid_pubkey_conflict|malformed)
          local diag; diag="$(_map_enroll_reason "$st" "$reason")"
          CHAIN_STATE="UNFIXABLE"; CHAIN_MSG="$diag"
          persist_diag enroll_refused "$diag" "HTTP $st reason=$reason"
          _loud "presence-doctor: $diag"
          step "$V" "   -> REFUSED (HTTP $st, $reason) — server-side, cannot self-fix; STOPPING"
          return 0 ;;
        *)
          # A bare 429 (rate-limit / load) or an unknown 4xx with no actionable reason: back off.
          CHAIN_STATE="RETRY"; CHAIN_MSG="enroll throttled/refused (HTTP $st${reason:+ $reason}) — retrying with backoff"
          persist_diag transient "$CHAIN_MSG" "HTTP $st reason=$reason"
          step "$V" "   -> not enrolled (HTTP $st) — transient, will retry"
          return 0 ;;
      esac
    else
      if [ "$st" = "0" ]; then
        CHAIN_STATE="RETRY"; CHAIN_MSG="control plane unreachable (offline) — retrying with backoff"
        persist_diag offline "$CHAIN_MSG" "reason=$reason"
      else
        CHAIN_STATE="RETRY"; CHAIN_MSG="transient server error (HTTP $st) — retrying with backoff"
        persist_diag transient "$CHAIN_MSG" "HTTP $st"
      fi
      step "$V" "   -> not enrolled ($CHAIN_MSG)"
      return 0
    fi
  fi

  # 5. VERIFY — beat (REUSE the client) then confirm this HAID is on its OWN roster.
  step "$V" "5. verify: signed beat + roster self-check"
  "$PRESENCE" beat >/dev/null 2>&1 || true
  if _verify_roster; then
    CHAIN_STATE="HEALTHY"
    CHAIN_MSG="presence HEALTHY — a signed beat landed and $HAID is on its own roster"
    persist_diag healthy "$CHAIN_MSG" ""
    step "$V" "   -> HEALTHY: $HAID appears on its own roster (self-heal complete)"
  else
    CHAIN_STATE="RETRY"
    CHAIN_MSG="seed present but the roster self-check did not yet show $HAID — retrying (offline/propagation)"
    persist_diag verify_pending "$CHAIN_MSG" ""
    step "$V" "   -> not yet visible on the roster — will retry"
  fi
  return 0
}

# ── the detached background self-heal loop (keeper-start spawns this via `doctor --bg`) ──
_doctor_alive() {
  [ -f "$DOCTOR_PIDFILE" ] || return 1
  local pid; pid="$(cat "$DOCTOR_PIDFILE" 2>/dev/null || true)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null
}

_doctor_sleep() {  # interruptible sleep (0 == no wait, for deterministic tests).
  local s="$1"
  [ "$s" = "0" ] && return 0
  sleep "$s" & swait=$!; wait "$swait" 2>/dev/null; swait=""
}

_bg_loop() {
  # IDEMPOTENT: one live doctor per project. A second `--bg` (a re-invoked keeper-start) no-ops.
  if _doctor_alive; then return 0; fi
  # CONSENT: OFF -> do NOTHING (respect the existing gate, mirror the beat/keeper).
  if _pres_off; then persist_diag consent_off "presence is OFF (consent) — doctor idle" ""; return 0; fi

  mkdir -p "$DOCTOR_DIR" 2>/dev/null || true
  printf '%s\n' "$$" > "$DOCTOR_PIDFILE.tmp.$$" 2>/dev/null && mv -f "$DOCTOR_PIDFILE.tmp.$$" "$DOCTOR_PIDFILE" 2>/dev/null
  local swait=""
  # shellcheck disable=SC2064 — expand at trap-fire time.
  trap 'rm -f "$DOCTOR_PIDFILE.tmp.$$" 2>/dev/null; [ -n "$swait" ] && kill "$swait" 2>/dev/null; [ "$(cat "$DOCTOR_PIDFILE" 2>/dev/null)" = "$$" ] && rm -f "$DOCTOR_PIDFILE" 2>/dev/null; exit 0' TERM INT

  # exponential-ish backoff, capped; overridable for deterministic tests.
  local schedule=(${HMD_DOCTOR_BACKOFF:-5 15 60 120 180})
  local max_cycles="${HMD_DOCTOR_MAX_CYCLES:-0}"       # 0 = unbounded (positive N = test seam).
  local max_seconds="${HMD_DOCTOR_MAX_SECONDS:-1800}"  # wallclock backstop (0 = unbounded).
  local cycles=0 idx=0 start_ts now w last=$(( ${#schedule[@]} - 1 ))
  start_ts="$(date +%s 2>/dev/null || echo 0)"

  while :; do
    # Re-check consent every cycle — a dev may `hmd presence off` mid-heal.
    if _pres_off; then persist_diag consent_off "presence is OFF (consent) — doctor idle" ""; break; fi
    run_chain quiet
    cycles=$((cycles + 1))
    case "$CHAIN_STATE" in
      HEALTHY)   break ;;   # QUIESCE — stop retrying, presence is up.
      UNFIXABLE) break ;;   # a loud, server-side cause was surfaced — stop (never a hot loop).
    esac
    [ "$max_cycles" != "0" ] && [ "$cycles" -ge "$max_cycles" ] && break
    now="$(date +%s 2>/dev/null || echo 0)"
    if [ "$max_seconds" != "0" ] && [ "$((now - start_ts))" -ge "$max_seconds" ]; then
      persist_diag exhausted "self-heal exhausted after ${max_seconds}s — last: $CHAIN_MSG" "$CHAIN_MSG"
      _loud "presence-doctor: could NOT self-heal presence after ${max_seconds}s — last state: $CHAIN_MSG"
      break
    fi
    w="${schedule[$idx]:-${schedule[$last]}}"
    [ "$idx" -lt "$last" ] && idx=$((idx + 1))
    _doctor_sleep "$w"
  done
  [ "$(cat "$DOCTOR_PIDFILE" 2>/dev/null || true)" = "$$" ] && rm -f "$DOCTOR_PIDFILE" 2>/dev/null || true
  return 0
}

# ── the interactive ONE-SHOT (verbose): print the full chain + what it fixed / what's left ──
_once() {
  printf 'heimdall presence-doctor — diagnose -> remediate -> verify\n'
  if _pres_off; then
    printf '  presence is OFF (consent) — nothing to heal. (run: hmd presence on)\n'
    persist_diag consent_off "presence is OFF (consent) — doctor idle" ""
    return 0
  fi
  run_chain verbose
  printf '\n'
  case "$CHAIN_STATE" in
    HEALTHY)   printf 'result: HEALTHY — %s\n' "$CHAIN_MSG" ;;
    UNFIXABLE) printf 'result: NEEDS ATTENTION (server-side) — %s\n' "$CHAIN_MSG" ;;
    *)         printf 'result: NOT YET HEALTHY — %s\n' "$CHAIN_MSG"
               printf '        the background self-heal loop will keep retrying (heimdall-presence doctor --status).\n' ;;
  esac
  return 0
}

# ── doctor --status: print the persisted last diagnosis ──
_show_status() {
  if [ -z "$DOCTOR_DIAG" ] || [ ! -f "$DOCTOR_DIAG" ] || [ -z "$PY" ]; then
    printf 'presence-doctor: no diagnosis recorded yet (run: heimdall-presence doctor)\n'
    return 0
  fi
  "$PY" - "$DOCTOR_DIAG" <<'PYEOF' 2>/dev/null || printf 'presence-doctor: diagnosis unreadable\n'
import json, sys, time
d = json.load(open(sys.argv[1]))
print("presence-doctor — last diagnosis")
print("  state:       %s" % (d.get("state") or "?"))
print("  reason:      %s" % (d.get("reason") or "-"))
if d.get("detail"):
    print("  detail:      %s" % d["detail"])
print("  interpreter: %s" % (d.get("interpreter") or "?"))
ts = d.get("ts")
if ts:
    print("  at:          %s" % time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ts)))
PYEOF
}

case "$MODE" in
  bg)     _bg_loop ;;
  once)   _once ;;
  status) _show_status ;;
  help)
    cat <<'USAGE'
heimdall-presence doctor — self-healing autoenroll / presence doctor

  heimdall-presence doctor            run the diagnose->remediate->verify chain ONCE (verbose)
  heimdall-presence doctor --bg       detached background self-heal loop (keeper-start invokes it)
  heimdall-presence doctor --status   print the persisted last diagnosis

The chain: (1) resolve the EXACT python heimdall-presence uses; (2) auto-install the Ed25519
crypto backend into THAT interpreter if missing; (3) clear a stale enroll-throttle stamp;
(4) enroll (keygen -> POST /enroll) capturing the REAL HTTP status — 2xx persists the seed,
a 4xx server-side refusal is surfaced loudly and STOPS, offline/5xx retries with backoff;
(5) verify a signed beat lands and this HAID is on its own roster -> HEALTHY, then QUIESCE.

Background: retries on 5s,15s,60s,120s,180s backoff (capped) until HEALTHY or a hard
server-side cause, then quiesces. Never hot-loops, never blocks a session, does NOTHING when
consent is OFF (hmd presence off). Test seams: HMD_DOCTOR_MAX_CYCLES, HMD_DOCTOR_MAX_SECONDS,
HMD_DOCTOR_BACKOFF, HMD_DOCTOR_PIP_CMD, HEIMDALL_DOCTOR_DIR.
USAGE
    ;;
esac
exit 0
