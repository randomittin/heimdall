#!/usr/bin/env bash
# heimdall-control-plane — the thin CLI over the control-plane substrate (piece a).
#
# DESIGN DOSSIER §3/§10 (authoritative). House style: a thin bin/heimdall-* bash CLI
# over the bin/lib/cp_*.py engine (mirrors bin/heimdall-redum / bin/heimdall-holdout).
# This CLI starts the server and manages per-instance PKI identity + the audit view.
#
# Subcommands:
#   heimdall-control-plane serve [--host H] [--port N] [--home DIR] [--no-revocation]
#       Start the stateless server (§10): authenticates every request (§3), routes
#       the built-in /dispatch (§1) + any registered seam routes, audits (§9).
#       Self-hostable: one process + a gitignored ${HEIMDALL_HOME}/control-plane/
#       state tree, no external DB. Blocks until interrupted.
#
#   heimdall-control-plane identity [--haid HAID] [--owner] [--home DIR]
#       Generate an Ed25519 keypair for THIS instance, bind the PUBLIC key to the
#       instance HAID in the control-plane key registry (§3), and print the keypair
#       (private seed for the instance to keep locally; public already registered).
#       --owner flags a distinguished gate-override identity (§7). Without --haid the
#       instance HAID is derived via heimdall-haid current.
#
#   heimdall-control-plane status [--home DIR]
#       Print the substrate status as JSON: crypto backend, allowlist action types,
#       registered routes, audit row count, store paths. Read-only.
#
#   heimdall-control-plane audit [--actor HAID] [--event E] [--action-type T]
#                                [--since ISO] [--until ISO] [--export] [--home DIR]
#       Search the append-only audit log (§9); --export streams matching rows as
#       NDJSON. Searchable + exportable, the security + 3am-debug record.
#
#   heimdall-control-plane jobs [--json] [--home DIR]
#       List every server-hosted job + its durable replayed state (§4). Read-only.
#   heimdall-control-plane run-job <job_id> [--actor HAID] [--home DIR]
#       RUN ONE server-hosted job to completion, SYNCHRONOUSLY (not a thread) — the
#       OUT-OF-PROCESS execution entrypoint (§4 flight fix on Cloud Run). This is the
#       command the Cloud Run Job container runs (and the SubprocessRunner spawns): it
#       loads the durable job record, drives cp_worker.run_job against the selected
#       StateBackend (firestore in prod), and BLOCKS until the job reaches a terminal
#       state. Exit 0 iff the job reached `done`; nonzero on refusal / isolation
#       violation / a non-done terminal (the dispatcher leaves it for resume/retry).
#   heimdall-control-plane schedules [--json] [--home DIR]
#       List stored cron schedules fired by the per-minute tick driver (§6). Read-only.
#   heimdall-control-plane schedule-maintainer --repo <owner/repo> --cron "<expr>"
#                          [--max N] [--budget-tokens N] [--dry-run] [--home DIR]
#       Register (IDEMPOTENTLY) the maintainer autopilot cron (§6): the per-minute tick
#       fires an ALLOWLISTED run-maintainer-cycle dispatch at the due minute, which the
#       hybrid runner routes to the operator's box (Arch A) or the Cloud Run Job (Arch B —
#       set HEIMDALL_MAINTAINER_RUNNER=cloud|hybrid so an absent local runner uses the Job).
#       Registered AS the server identity (HEIMDALL_CP_SERVER_HAID / heimdall-haid current)
#       — the SAME identity the tick fires as. Typed + bounded by the run-maintainer-cycle
#       allowlist (repo slug, 1..100 max, optional token budget); a bad repo/cron/max is
#       REFUSED, never persisted. Re-registering the same repo+cron UPDATES IN PLACE (never
#       duplicates). It registers ONLY the allowlisted action — NEVER a free-form command.
#       --dry-run prints the registration and writes NOTHING. Prints the schedule_id + cron.
#   heimdall-control-plane approvals [--json] [--home DIR]
#       List the pending owner-gate queue (§7). Read-only — never decides.
#   heimdall-control-plane notify [--haid HAID] [--json] [--home DIR]
#       Poll an instance's notification inbox (§8): DATA only, never a command.
#   heimdall-control-plane dashboard [--json] [--home DIR]
#       The cross-dev observe roll-up (§5). Read-only.
#   heimdall-control-plane diagnose [--json] [--home DIR]
#       Operator self-check (§C): run every cp_selfcheck probe against the local
#       control-plane state tree and print a PASS/FAIL table (text) or a structured
#       report (--json). Read-only — inspects state, mutates nothing, NEVER prints
#       secret/key material (status + paths only). Exits nonzero iff a CRITICAL
#       check fails (crypto backend, PKI key registry, audit + state stores
#       writable, allowlist sane); advisory checks are reported but never fail it.
#
#   -h, --help
#
# Conventions (match bin/ — bash + python3, graceful when a dep is absent):
#   - crypto deps (cryptography|pynacl) are OPTIONAL: serve/status work without them;
#     `identity` reports the degraded message rather than crashing.
#   - all state under ${HEIMDALL_HOME:-<repo>/.heimdall}/control-plane/ (gitignored).
#
# Exit: 0 ok; 2 usage/IO error; 3 a degraded-crypto identity request.
set -euo pipefail

# ── path resolution (mirrors bin/heimdall-redum) ──────────────────────────────
SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
LIB_DIR="$BIN_DIR/lib"
HAID_CLI="$BIN_DIR/heimdall-haid"

usage() { sed -n '2,76p' "$SELF" | sed 's/^# \{0,1\}//'; }

PY="$(command -v python3 || command -v python || true)"
if [ -z "$PY" ]; then
  echo "error: python3 not found (required for the control plane)" >&2
  exit 2
fi

[ $# -ge 1 ] || { usage >&2; exit 2; }
SUB="$1"; shift

case "$SUB" in
  -h|--help) usage; exit 0 ;;
esac

# ── shared option parsing ─────────────────────────────────────────────────────
HOST="127.0.0.1"
PORT="8787"
HOME_DIR=""
HAID=""
OWNER=""
EVENT=""
ACTOR=""
ACTION_TYPE=""
SINCE=""
UNTIL=""
EXPORT=""
NO_REVOCATION=""
JSON=""
JOB_ID=""
REPO=""
CRON=""
MAXN="3"
BUDGET_TOKENS=""
DRY_RUN=""

while [ $# -gt 0 ]; do
  case "$1" in
    --json)        JSON="1"; shift ;;
    --host)        HOST="${2:?--host needs a value}"; shift 2 ;;
    --port)        PORT="${2:?--port needs a value}"; shift 2 ;;
    --home)        HOME_DIR="${2:?--home needs a dir}"; shift 2 ;;
    --haid)        HAID="${2:?--haid needs a value}"; shift 2 ;;
    --owner)       OWNER="1"; shift ;;
    --event)       EVENT="${2:?--event needs a value}"; shift 2 ;;
    --actor)       ACTOR="${2:?--actor needs a value}"; shift 2 ;;
    --action-type) ACTION_TYPE="${2:?--action-type needs a value}"; shift 2 ;;
    --since)       SINCE="${2:?--since needs a value}"; shift 2 ;;
    --until)       UNTIL="${2:?--until needs a value}"; shift 2 ;;
    --export)      EXPORT="1"; shift ;;
    --no-revocation) NO_REVOCATION="1"; shift ;;
    --repo)        REPO="${2:?--repo needs a value}"; shift 2 ;;
    --cron)        CRON="${2:?--cron needs an expression}"; shift 2 ;;
    --max)         MAXN="${2:?--max needs a value}"; shift 2 ;;
    --budget-tokens) BUDGET_TOKENS="${2:?--budget-tokens needs a value}"; shift 2 ;;
    --dry-run)     DRY_RUN="1"; shift ;;
    -h|--help)     usage; exit 0 ;;
    --*)           echo "error: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)             # the first bare positional is the run-job <job_id> target; any further
                   # positional is a usage error (every other subcommand is option-only).
                   if [ -z "$JOB_ID" ]; then JOB_ID="$1"; shift;
                   else echo "error: unexpected argument: $1" >&2; usage >&2; exit 2; fi ;;
  esac
done

# Resolve the instance HAID for the identity command (derive when not given).
resolve_haid() {
  if [ -n "$HAID" ]; then printf '%s' "$HAID"; return 0; fi
  if [ -x "$HAID_CLI" ]; then "$HAID_CLI" current; return 0; fi
  echo "error: no --haid given and heimdall-haid not available to derive one" >&2
  exit 2
}

case "$SUB" in
  serve)
    LIB_DIR="$LIB_DIR" HOST="$HOST" PORT="$PORT" HOME_DIR="$HOME_DIR" \
    NO_REVOCATION="$NO_REVOCATION" "$PY" - <<'PYEOF'
import os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_server
home = os.environ.get("HOME_DIR") or None
enforce = not os.environ.get("NO_REVOCATION")
host = os.environ.get("HOST", "127.0.0.1")
port = int(os.environ.get("PORT", "8787"))
sys.stderr.write("heimdall-control-plane serving on %s:%d (home=%s, revocation=%s)\n"
                 % (host, port, home or "default", "on" if enforce else "off"))
sys.exit(cp_server.serve(host=host, port=port, home=home,
                         enforce_revocation=enforce))
PYEOF
    ;;

  identity)
    INSTANCE_HAID="$(resolve_haid)"
    set +e
    LIB_DIR="$LIB_DIR" INSTANCE_HAID="$INSTANCE_HAID" OWNER="$OWNER" \
    HOME_DIR="$HOME_DIR" "$PY" - <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_auth
haid = os.environ["INSTANCE_HAID"]
owner = bool(os.environ.get("OWNER"))
home = os.environ.get("HOME_DIR") or None
if not cp_auth.crypto_available():
    sys.stdout.write(json.dumps({
        "ok": False, "haid": haid,
        "reason": "crypto_unavailable",
        "detail": "install `cryptography` or `pynacl` to enable PKI identity",
    }) + "\n")
    sys.exit(3)
# THE GAP FIX wired at the identity boundary. When HEIMDALL_CP_PKI_KEY is present (the
# deploy's --set-secrets seed) DERIVE the DETERMINISTIC keypair from it — the SAME pair
# every instance/cold-start — instead of minting a fresh random key. In the cloud profile
# an absent/invalid seed makes load_signing_key RAISE (fail-closed): we refuse rather than
# mint a per-instance key. Locally with no seed/cloud-signal, keep the dev mint path.
seeded = bool(os.environ.get(cp_auth.PKI_KEY_ENV)) or cp_auth.cloud_profile()
try:
    if seeded:
        priv, pub = cp_auth.load_signing_key()   # raises (fail-closed) in cloud w/o seed.
        source = "seed"
    else:
        priv, pub = cp_auth.generate_keypair()    # dev mint (no seed, local profile).
        source = "minted"
except cp_auth.AuthError as err:
    sys.stdout.write(json.dumps({
        "ok": False, "haid": haid, "reason": err.reason, "detail": err.detail,
    }) + "\n")
    sys.exit(3)
stored = cp_auth.register_key(haid, pub, owner=owner, home=home)
sys.stdout.write(json.dumps({
    "ok": True, "haid": haid, "owner": owner, "backend": cp_auth.backend_name(),
    "public_key": pub, "private_key": priv, "registered": stored, "key_source": source,
    "note": "keep private_key local; public_key is registered with the server",
}, indent=2) + "\n")
sys.exit(0)
PYEOF
    RC=$?
    set -e
    exit "$RC"
    ;;

  status)
    LIB_DIR="$LIB_DIR" HOME_DIR="$HOME_DIR" "$PY" - <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_allowlist, cp_audit, cp_auth, cp_server, cp_state
home = os.environ.get("HOME_DIR") or None


def _fs_path(fn):
    """Resolve a filesystem path accessor BEST-EFFORT. The *_path() accessors route to the
    SELECTED backend's path(), which a non-filesystem backend (firestore) REFUSES
    (BackendUnavailable) — an external store has no local file to point at. A path is purely
    informational here, so under such a backend we report None instead of letting path()
    refusal crash `status` (the same path()-under-firestore class fixed in
    cp_selfcheck/cp_diag). The audit_rows COUNT below reads THROUGH read_records and works on
    every backend regardless."""
    try:
        return fn(home)
    except cp_state.BackendUnavailable:
        return None


out = {
    "crypto_backend": cp_auth.backend_name(),
    "crypto_available": cp_auth.crypto_available(),
    "allowlist_actions": cp_allowlist.action_types(),
    "registered_routes": ["%s %s" % (m, p) for m, p in cp_server.registered_routes()],
    "audit_rows": len(cp_audit.read_records(home)),
    "audit_path": _fs_path(cp_audit.audit_path),
    "keys_path": _fs_path(cp_auth.keys_path),
    "state_backend": (os.environ.get(cp_state.BACKEND_ENV) or cp_state.BACKEND_LOCAL).strip().lower(),
}
sys.stdout.write(json.dumps(out, indent=2, sort_keys=True) + "\n")
PYEOF
    ;;

  audit)
    LIB_DIR="$LIB_DIR" HOME_DIR="$HOME_DIR" ACTOR="$ACTOR" EVENT="$EVENT" \
    ACTION_TYPE="$ACTION_TYPE" SINCE="$SINCE" UNTIL="$UNTIL" EXPORT="$EXPORT" \
    "$PY" - <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_audit
home = os.environ.get("HOME_DIR") or None


def opt(name):
    v = os.environ.get(name)
    return v if v else None


filters = {
    "actor_haid": opt("ACTOR"),
    "event": opt("EVENT"),
    "action_type": opt("ACTION_TYPE"),
    "since": opt("SINCE"),
    "until": opt("UNTIL"),
}
filters = {k: v for k, v in filters.items() if v is not None}
if os.environ.get("EXPORT"):
    sys.stdout.write(cp_audit.export(home, **filters))
else:
    rows = cp_audit.search(home, **filters) if filters else cp_audit.read_records(home)
    sys.stdout.write(json.dumps(rows, indent=2, sort_keys=True) + "\n")
PYEOF
    ;;

  jobs)
    # Read-only view of every server-hosted job + its durable state (§4). The state is
    # replayed from the append-only log, the same view the running server serves.
    LIB_DIR="$LIB_DIR" HOME_DIR="$HOME_DIR" JSON="$JSON" "$PY" - <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_jobstore
home = os.environ.get("HOME_DIR") or None
rows = cp_jobstore.list_jobs(home)
if os.environ.get("JSON"):
    sys.stdout.write(json.dumps(rows, indent=2, sort_keys=True) + "\n")
elif not rows:
    sys.stdout.write("no jobs yet\n")
else:
    for j in rows:
        sys.stdout.write("%s  %-9s  %s\n"
                         % (j.get("job_id", "?"), j.get("state", "?"),
                            j.get("action_type", "?")))
PYEOF
    ;;

  run-job)
    # RUN ONE job to completion, SYNCHRONOUSLY — the OUT-OF-PROCESS execution entrypoint
    # (§4 flight fix on Cloud Run). This is the container command the Cloud Run Job runs and
    # the cp_jobrunner.SubprocessRunner spawns: it drives cp_worker.run_job (NOT a thread)
    # against the SELECTED StateBackend (firestore in prod), BLOCKING until the job reaches a
    # terminal state, then exits 0 iff `done`. A queued job left undriven by the (throttled /
    # scaled-to-zero) service instance is brought to completion HERE, in a process whose
    # lifetime is independent of the request that started it. The §1 allowlist + §2 isolation
    # gates fire inside run_job exactly as for the in-thread run — this entrypoint runs no
    # arbitrary command, only the durable job's allowlisted, isolated handler.
    # A BARE `run-job` with no job_id is the Cloud Run Job's DEFAULT-ARGS invocation (or an
    # accidental bare `gcloud run jobs execute`): there is no job to run, so it is a CLEAN
    # no-op, NOT an error. Exiting nonzero here marks the Cloud Run execution red FAILED (the
    # alarming-but-benign krdp7 signature). Exit 0 with a clear message instead. A SUPPLIED but
    # unknown id stays a real error (exit 2 + "no such job") inside the python below — that is a
    # genuine dispatch/operator bug worth surfacing.
    if [ -z "$JOB_ID" ]; then
      echo "run-job: no job_id supplied (default-args invocation) — nothing to run"
      exit 0
    fi
    set +e
    LIB_DIR="$LIB_DIR" HOME_DIR="$HOME_DIR" JOB_ID="$JOB_ID" ACTOR="$ACTOR" "$PY" - <<'PYEOF'
import os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_jobstore
import cp_worker
home = os.environ.get("HOME_DIR") or None
job_id = os.environ["JOB_ID"]
actor = os.environ.get("ACTOR") or None

# The job MUST already exist in the durable store (create_job ran in start_route before the
# dispatch). An unknown id is an operator/dispatch error — fail loudly, do not invent a job.
folded = cp_jobstore.read_job(job_id, home)
if folded is None:
    sys.stderr.write("run-job: no such job %s in the store\n" % job_id)
    sys.exit(2)

try:
    # SYNCHRONOUS run-to-completion (NOT _detach_run / a thread): this process IS the durable
    # execution. run_job is idempotent — a job already running/terminal is a no-op return, so a
    # double-dispatch (e.g. a retry) cannot double-run it.
    final = cp_worker.run_job(job_id, actor_haid=actor, home=home)
except cp_worker.ActionRefused as exc:
    # the job named an action the §1 allowlist refuses — already cancelled + audited in run_job.
    sys.stderr.write("run-job: %s refused (%s)\n" % (job_id, exc))
    sys.exit(3)
except cp_worker.IsolationRefused as exc:
    # the §2 boundary fired — the job reached for a control-plane resource; failed + audited.
    sys.stderr.write("run-job: %s isolation violation (%s)\n" % (job_id, exc))
    sys.exit(4)
except cp_jobstore.IllegalTransition as exc:
    sys.stderr.write("run-job: %s illegal transition (%s)\n" % (job_id, exc))
    sys.exit(5)

state = (final or {}).get("state") if final else None
sys.stderr.write("run-job: %s -> %s\n" % (job_id, state))
# Exit 0 iff the job reached `done`. A non-done terminal (cancelled, or parked-paused) is a
# nonzero exit so a wrapping Cloud Run Job execution / the dispatcher sees the job did not
# complete and resume/retry can re-drive it.
sys.exit(0 if state == cp_jobstore.STATE_DONE else 1)
PYEOF
    RC=$?
    set -e
    exit "$RC"
    ;;

  schedules)
    # Read-only view of stored cron schedules (§6). Each fires its allowlisted dispatch
    # autonomously via the server's per-minute tick driver.
    LIB_DIR="$LIB_DIR" HOME_DIR="$HOME_DIR" JSON="$JSON" "$PY" - <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_scheduler
home = os.environ.get("HOME_DIR") or None
rows = cp_scheduler.list_schedules(home)
if os.environ.get("JSON"):
    sys.stdout.write(json.dumps(rows, indent=2, sort_keys=True) + "\n")
elif not rows:
    sys.stdout.write("no schedules yet\n")
else:
    for s in rows:
        sys.stdout.write("%s  %-12s  %-10s  %s\n"
                         % (s.get("schedule_id", "?"), s.get("cron", "?"),
                            "enabled" if s.get("enabled") else "disabled",
                            s.get("action_type", "?")))
PYEOF
    ;;

  schedule-maintainer)
    # Register (IDEMPOTENTLY) the maintainer autopilot cron (§6). The per-minute tick fires
    # an ALLOWLISTED run-maintainer-cycle dispatch at the due minute; the hybrid runner routes
    # it to the operator's box (Arch A) or the Cloud Run Job (Arch B). Registered AS the server
    # identity — the SAME identity the tick fires as. Typed + bounded by the run-maintainer-cycle
    # allowlist; a bad repo/cron/max is REFUSED (never persisted). Same repo+cron -> update in
    # place (never duplicated). NEVER a free-form command — only the allowlisted action.
    [ -n "$REPO" ] || { echo "error: schedule-maintainer needs --repo <owner/repo>" >&2; usage >&2; exit 2; }
    [ -n "$CRON" ] || { echo "error: schedule-maintainer needs --cron \"<expr>\"" >&2; usage >&2; exit 2; }
    set +e
    LIB_DIR="$LIB_DIR" HOME_DIR="$HOME_DIR" REPO="$REPO" CRON="$CRON" MAXN="$MAXN" \
    BUDGET_TOKENS="$BUDGET_TOKENS" DRY_RUN="$DRY_RUN" HAID="$HAID" JSON="$JSON" "$PY" - <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_allowlist, cp_auth, cp_scheduler
home = os.environ.get("HOME_DIR") or None
repo = os.environ["REPO"]
cron = os.environ["CRON"]
as_json = bool(os.environ.get("JSON"))
dry = bool(os.environ.get("DRY_RUN"))


def _fail(msg, code=2):
    sys.stderr.write("schedule-maintainer: %s\n" % msg)
    sys.exit(code)


# max / budget are ALWAYS integers to the typed allowlist (Int); a non-int is a usage error
# refused BEFORE the store is touched (the CLI mirrors the allowlist's own bounds refusal).
try:
    max_cycles = int(os.environ["MAXN"])
except (KeyError, ValueError):
    _fail("--max must be an integer 1..100 (got %r)" % os.environ.get("MAXN"))
budget = None
raw_budget = os.environ.get("BUDGET_TOKENS") or ""
if raw_budget:
    try:
        budget = int(raw_budget)
    except ValueError:
        _fail("--budget-tokens must be an integer (got %r)" % raw_budget)

# Resolve the SERVER identity the tick fires as: an explicit --haid wins, else the deploy's
# HEIMDALL_CP_SERVER_HAID pin / `heimdall-haid current` (cp_auth.server_haid). Without one we
# cannot own the schedule as the server — refuse rather than guess an identity.
haid = (os.environ.get("HAID") or "").strip() or cp_auth.server_haid(home)
if not haid:
    _fail("no server identity — set HEIMDALL_CP_SERVER_HAID (deploy pin) or pass --haid, "
          "so the schedule is owned by the identity the tick fires as")
identity = cp_auth.Identity(haid, owner=True)

if dry:
    # DRY-RUN: validate the params through the §1 allowlist (so a bad repo/cron/max still
    # fails loudly) but write NOTHING to the store.
    try:
        params = {"repo": repo, "max": max_cycles}
        if budget is not None:
            params["budget_tokens"] = budget
        cp_allowlist.validate(cp_scheduler.MAINTAINER_ACTION_TYPE, params)
        cp_scheduler.parse_cron(cron)
    except cp_allowlist.RefusedDispatch as ref:
        _fail("refused: %s (%s) — nothing registered" % (ref.reason, ref.detail))
    except cp_scheduler.ScheduleError as err:
        _fail("bad cron: %s (%s) — nothing registered" % (err.reason, err.detail))
    existing = cp_scheduler.find_maintainer_schedule(haid, repo, cron, home=home)
    plan = {
        "dry_run": True, "would_register": True,
        "action_type": cp_scheduler.MAINTAINER_ACTION_TYPE,
        "owner_haid": haid, "repo": repo, "cron": cron, "max": max_cycles,
        "budget_tokens": budget,
        "would_update_in_place": bool(existing),
        "schedule_id": existing["schedule_id"] if existing else None,
    }
    if as_json:
        sys.stdout.write(json.dumps(plan, indent=2, sort_keys=True) + "\n")
    else:
        sys.stdout.write(
            "DRY-RUN: would %s run-maintainer-cycle for %s (cron=%r, max=%d%s) as %s — "
            "NOTHING written\n" % (
                "UPDATE" if existing else "register", repo, cron, max_cycles,
                ("" if budget is None else ", budget_tokens=%d" % budget), haid))
    sys.exit(0)

# REGISTER (idempotent): same owner+repo+cron -> update in place, else create. The typed §1
# gate refuses an off-slug repo / out-of-range max / bad cron here — never persisted.
try:
    result = cp_scheduler.upsert_maintainer_schedule(
        identity, repo, max_cycles, cron, budget_tokens=budget, home=home)
except cp_allowlist.RefusedDispatch as ref:
    _fail("refused: %s (%s) — nothing registered" % (ref.reason, ref.detail))
except cp_scheduler.ScheduleError as err:
    _fail("bad cron: %s (%s) — nothing registered" % (err.reason, err.detail))
entry = result["entry"]
out = {
    "registered": True, "created": result["created"],
    "schedule_id": entry["schedule_id"], "action_type": entry["action_type"],
    "cron": entry["cron"], "repo": entry["params"].get("repo"),
    "max": entry["params"].get("max"),
    "budget_tokens": entry["params"].get("budget_tokens"),
    "owner_haid": entry["owner_haid"], "enabled": entry["enabled"],
}
if as_json:
    sys.stdout.write(json.dumps(out, indent=2, sort_keys=True) + "\n")
else:
    sys.stdout.write(
        "%s maintainer schedule %s: run-maintainer-cycle for %s (cron=%r, max=%s%s)\n"
        % ("created" if result["created"] else "updated (idempotent)",
           entry["schedule_id"], entry["params"].get("repo"), entry["cron"],
           entry["params"].get("max"),
           ("" if entry["params"].get("budget_tokens") is None
            else ", budget_tokens=%s" % entry["params"].get("budget_tokens"))))
sys.exit(0)
PYEOF
    RC=$?
    set -e
    exit "$RC"
    ;;

  approvals)
    # Read-only view of the pending owner-gate queue (§7): irreversible dispatches
    # waiting on an owner approve/reject. Read-only — never decides.
    LIB_DIR="$LIB_DIR" HOME_DIR="$HOME_DIR" JSON="$JSON" "$PY" - <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_approval
home = os.environ.get("HOME_DIR") or None
rows = cp_approval.list_pending(home)
if os.environ.get("JSON"):
    sys.stdout.write(json.dumps(rows, indent=2, sort_keys=True) + "\n")
elif not rows:
    sys.stdout.write("no pending approvals\n")
else:
    for a in rows:
        sys.stdout.write("%s  %-18s  by %s\n"
                         % (a.get("approval_id", "?"), a.get("action_type", "?"),
                            a.get("requested_by", "?")))
PYEOF
    ;;

  notify)
    # Read-only poll of an instance's notification inbox (§8): DATA only, never a
    # command. Polls the resolved instance HAID (or --haid).
    TARGET_HAID="$(resolve_haid)"
    LIB_DIR="$LIB_DIR" HOME_DIR="$HOME_DIR" JSON="$JSON" TARGET_HAID="$TARGET_HAID" \
    "$PY" - <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_notify
home = os.environ.get("HOME_DIR") or None
target = os.environ["TARGET_HAID"]
rows = cp_notify.poll(target, home)
if os.environ.get("JSON"):
    sys.stdout.write(json.dumps(rows, indent=2, sort_keys=True) + "\n")
elif not rows:
    sys.stdout.write("no notifications for %s\n" % target)
else:
    for n in rows:
        sys.stdout.write("%s  %s\n" % (n.get("kind", "?"), json.dumps(n.get("data", {}))))
PYEOF
    ;;

  dashboard)
    # The cross-dev observe roll-up (§5). Delegates to the dashboard lib CLI; --json
    # for the structured view, text otherwise. Read-only.
    DASH_ARGS=()
    [ -n "$JSON" ] && DASH_ARGS+=(--json)
    [ -n "$HOME_DIR" ] && DASH_ARGS+=(--home "$HOME_DIR")
    LIB_DIR="$LIB_DIR" "$PY" - "${DASH_ARGS[@]}" <<'PYEOF'
import os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_dashboard
sys.exit(cp_dashboard._cli(sys.argv[1:]))
PYEOF
    ;;

  diagnose)
    # Operator self-check (§C). Runs every cp_selfcheck probe against the local
    # state tree and prints a PASS/FAIL table (or --json). Read-only — never mutates,
    # never prints secret/key material (the no-secret discipline §5/§7). Exits nonzero
    # iff a CRITICAL check fails so a wrapping script can gate on a sane control plane.
    set +e
    LIB_DIR="$LIB_DIR" HOME_DIR="$HOME_DIR" JSON="$JSON" "$PY" - <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["LIB_DIR"])
import cp_selfcheck
home = os.environ.get("HOME_DIR") or None
report = cp_selfcheck.run_all(home)
if os.environ.get("JSON"):
    sys.stdout.write(json.dumps(report, indent=2, sort_keys=True) + "\n")
else:
    sys.stdout.write(cp_selfcheck.render_table(report))
# nonzero exit iff a CRITICAL check failed (advisory failures do NOT fail the run).
sys.exit(0 if report["ok"] else 1)
PYEOF
    RC=$?
    set -e
    exit "$RC"
    ;;

  *)
    echo "error: unknown subcommand: $SUB" >&2
    usage >&2
    exit 2 ;;
esac
