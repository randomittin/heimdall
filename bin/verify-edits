#!/usr/bin/env bash
# verify-edits — review all edits made this session for correctness.
#
# Checks:
#   1. Every edited file still exists on disk
#   2. No stub/placeholder/TODO code introduced
#   3. Git diff summary of all changes
#   4. Optional: run project linter/tests against changed files
#
# Usage:
#   verify-edits              Full verification report
#   verify-edits --quick      File existence + stub check only
#   verify-edits --diff       Show git diff of all edited files
#   verify-edits --json       Output as JSON
#
# Exit codes:
#   0  PASS (or WARN) — verification ran and the edits check out
#   1  FAIL           — verification ran and found problems
#   2  NON-VERIFIED   — verification could NOT establish the truth. One of:
#                       (a) the session edit ledger is absent (the PostToolUse
#                       edit-tracker hook never fired); (b) the ledger claims
#                       zero edits while git shows an uncommitted, dirty
#                       working tree, a contradiction that means the ledger
#                       cannot be trusted (see the ledger-git cross-check
#                       below); or (c) `edit-tracker clears` shows this
#                       ledger was reset mid-session while it held real
#                       entries — a resume/compact SessionStart firing `clear`
#                       unconditionally (no gate on `source`), or a concurrent
#                       agent sharing this session id and ledger, can each
#                       destroy entries another part of the session already
#                       logged, committed or not (see the mid-session-clear
#                       cross-check below). Distinct from 1 so "nothing was
#                       checked" can never be mistaken for "everything is
#                       fine".
set -euo pipefail

PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
TRACKER="$PLUGIN_DIR/bin/edit-tracker"

# Rebuild when missing OR stale: a binary older than its source may predate
# `status`, which would make every run look NON-VERIFIED.
# Progress/diagnostics go to STDERR, never stdout: `--json` promises a stdout
# that is nothing but the payload. Prepending build chatter produced
# `edit-tracker not built or stale. Building...{ "verdict": ... }`, which no
# strict parser accepts — so a machine that happened to rebuild the tracker
# silently lost its downstream stub gate.
if [ ! -x "$TRACKER" ] || [ "$PLUGIN_DIR/bin/edit-tracker.c" -nt "$TRACKER" ]; then
  echo "edit-tracker not built or stale. Building..." >&2
  clang -O2 -Wall -Wextra -o "$TRACKER" "$PLUGIN_DIR/bin/edit-tracker.c" 2>/dev/null || {
    echo "Build failed. Run: clang -O2 -Wall -Wextra -o bin/edit-tracker bin/edit-tracker.c" >&2
    exit 1
  }
fi

MODE="${1:---full}"
PASS=0
FAIL=0
WARN=0
ISSUES=""

# ── Gate 0: ledger presence (proof the tracker actually ran) ──
# ABSENT ledger => the PostToolUse edit-tracker hook never fired. "Zero edits" is
#   then UNKNOWABLE, not proven, so we report NON-VERIFIED (exit 2) — never a pass.
# PRESENT + zero entries => the session genuinely made no edits. That is a pass,
#   and stays quiet so read-only/planning sessions do not get a false alarm.
# An edit-tracker too old to know `status` prints nothing here and is treated as
# absent — fail closed, because it also cannot prove anything was tracked.
ledger_state=$("$TRACKER" status 2>/dev/null || true)
case "$ledger_state" in
  "present "*) ledger_present=1; ledger_file="${ledger_state#present }" ;;
  "absent "*)  ledger_present=0; ledger_file="${ledger_state#absent }" ;;
  *)           ledger_present=0; ledger_file="(edit-tracker status unavailable)" ;;
esac

if [ "$ledger_present" -eq 0 ]; then
  if [ "$MODE" = "--json" ]; then
    echo "{"
    echo "  \"verdict\": \"NON_VERIFIED\","
    echo "  \"reason\": \"edit-ledger-absent\","
    echo "  \"ledger\": \"$ledger_file\","
    echo "  \"files_edited\": null,"
    echo "  \"checks_passed\": 0,"
    echo "  \"checks_failed\": 0,"
    # Zero warnings is the truth: nothing was checked, so nothing warned. The
    # receipt gate keys on verdict=="NON_VERIFIED" directly, so this field no
    # longer has to carry a tripwire value to keep downstream honest.
    echo "  \"warnings\": 0,"
    echo "  \"paths\": []"
    echo "}"
    exit 2
  fi
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "[heimdall] verify-edits: NOT VERIFIED — edit tracking unavailable"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "Session edit ledger does not exist:"
  echo "  $ledger_file"
  echo ""
  echo "The PostToolUse edit-tracker hook never ran, so no edit this session was"
  echo "recorded. This is NOT a clean bill of health — it means NOTHING was"
  echo "checked. Treat every edit this session as UNVERIFIED."
  echo ""
  echo "Fix: load heimdall's hooks (hooks/hooks.json PostToolUse Write|Edit ->"
  echo "bin/edit-tracker log), then re-run. To start tracking from this point:"
  echo "  $TRACKER init"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "VERDICT: NON-VERIFIED"
  exit 2
fi

# Mid-session clear evidence: `edit-tracker clear` records "<ts>|<entries_lost>"
# whenever it wiped a ledger that held real entries (bin/edit-tracker.c
# do_clear()). hooks.json's SessionStart hook fires `edit-tracker clear`
# UNCONDITIONALLY on every session-start event — startup, resume, AND compact
# alike, with no gate on `source` (confirmed by reading hooks/hooks.json: the
# SessionStart command never inspects its own stdin JSON before calling
# clear). Concurrent agents that share one $CLAUDE_CODE_SESSION_ID share one
# ledger file too (confirmed directly: a sibling worktree agent's edits have
# been observed landing in this exact session's ledger) — so ANY one of them
# starting, resuming, or compacting can clear entries another is still relying
# on. clears_lost > 0 means the ledger's current contents are a
# KNOWN-INCOMPLETE record, not a trustworthy one, regardless of what it
# currently shows.
clear_events=$("$TRACKER" clears 2>/dev/null || true)
clears_lost=0
if [ -n "$clear_events" ]; then
  while IFS='|' read -r clear_ts clear_n; do
    case "$clear_n" in
      ''|*[!0-9]*) ;;
      *) clears_lost=$((clears_lost + clear_n)) ;;
    esac
  done <<< "$clear_events"
fi

paths=$("$TRACKER" paths 2>/dev/null || true)
if [ -z "$paths" ]; then
  # --- ledger-git cross-check: begin ---
  # The ledger claims zero edits. Before trusting that, cross-check against
  # git: a ledger can go from "correctly tracking real edits" to "present and
  # empty" if something clears it mid-session (e.g. a SessionStart hook
  # re-firing on compaction/resume without gating on `source` — see
  # hooks/hooks.json). A dirty working tree while the ledger says zero is
  # exactly that contradiction: report NON-VERIFIED, not a confident pass.
  #
  # `git rev-parse --is-inside-work-tree` (not `[ -d .git ]`) on purpose: in a
  # git worktree checkout — precisely where this defect was reported —
  # `.git` is a plain FILE (a `gitdir:` pointer), not a directory, so a
  # `[ -d .git ]` guard would silently never fire in the one place this check
  # matters most. No git at all => no ground truth to check against, so fall
  # through unchanged to the existing pass below.
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git_dirty=$(git status --porcelain 2>/dev/null || true)
    if [ -n "$git_dirty" ]; then
      if [ "$MODE" = "--json" ]; then
        echo "{"
        echo "  \"verdict\": \"NON_VERIFIED\","
        echo "  \"reason\": \"ledger-git-mismatch\","
        echo "  \"ledger\": \"$ledger_file\","
        echo "  \"files_edited\": null,"
        echo "  \"checks_passed\": 0,"
        echo "  \"checks_failed\": 0,"
        echo "  \"warnings\": 0,"
        echo "  \"paths\": []"
        echo "}"
        exit 2
      fi
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "[heimdall] verify-edits: NOT VERIFIED — ledger/git mismatch"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "The edit ledger reports ZERO edits this session:"
      echo "  $ledger_file"
      echo ""
      echo "...but git shows an uncommitted, dirty working tree:"
      echo ""
      printf '%s\n' "$git_dirty" | head -20 || true
      echo ""
      echo "A ledger claiming zero edits while git shows real, uncommitted changes"
      echo "is a contradiction, not a pass. Something most likely reset the ledger"
      echo "mid-session (e.g. a SessionStart hook re-firing on compaction/resume)"
      echo "after real edits were already logged. Treat every edit this session as"
      echo "UNVERIFIED — do not trust the \"0 edits\" count."
      echo ""
      echo "Fix: find out why the ledger was reset (a SessionStart hook calling"
      echo "edit-tracker clear/init without gating on \`source\` is the likely"
      echo "cause). To resume tracking from this point:"
      echo "  $TRACKER init"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "VERDICT: NON-VERIFIED"
      exit 2
    fi
  fi
  # --- ledger-git cross-check: end ---
  # --- mid-session-clear cross-check: begin ---
  # Runs only once the git-dirty check above has NOT already exited: a dirty
  # tree is the stronger, more specific signal (it names the actual
  # uncommitted diff), so it wins when both are true — this preserves the
  # existing ledger/git mismatch banner and reason for that exact scenario.
  # What THIS check catches that the git-dirty one structurally cannot: entries
  # lost to a mid-session clear that were ALREADY COMMITTED before the clear
  # ran, leaving the tree clean and the ledger silent about work that
  # genuinely happened. (Deliberately phrased as "ledger/git mismatch" here,
  # not the exact reason-string below, so a grep for that string still finds
  # only the one place it is actually emitted.)
  if [ "$clears_lost" -gt 0 ]; then
    if [ "$MODE" = "--json" ]; then
      echo "{"
      echo "  \"verdict\": \"NON_VERIFIED\","
      echo "  \"reason\": \"ledger-cleared-mid-session\","
      echo "  \"ledger\": \"$ledger_file\","
      echo "  \"entries_lost\": $clears_lost,"
      echo "  \"files_edited\": null,"
      echo "  \"checks_passed\": 0,"
      echo "  \"checks_failed\": 0,"
      echo "  \"warnings\": 0,"
      echo "  \"paths\": []"
      echo "}"
      exit 2
    fi
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "[heimdall] verify-edits: NOT VERIFIED — ledger cleared mid-session"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "This session's edit ledger reports ZERO edits:"
    echo "  $ledger_file"
    echo ""
    echo "...but it was reset at least once while it held real entries"
    echo "($clears_lost total lost). That happens when hooks.json's SessionStart"
    echo "hook fires \`edit-tracker clear\` on a resume/compact boundary, not"
    echo "just a true fresh session start — or when a concurrent agent sharing"
    echo "this ledger starts, resumes, or compacts."
    echo ""
    echo "Edits made before that clear are gone from this ledger even if they"
    echo "are already committed. Treat this session's edit history as"
    echo "UNVERIFIED, not zero."
    echo ""
    echo "Fix: find out why the clear fired (hooks.json's SessionStart ->"
    echo "edit-tracker clear has no gate on \`source\`). To resume tracking:"
    echo "  $TRACKER init"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "VERDICT: NON-VERIFIED"
    exit 2
  fi
  # --- mid-session-clear cross-check: end ---
  # Ledger PRESENT + zero entries, and git agrees (clean, or nothing to check
  # it against) => the session genuinely made no edits: a real pass. Under
  # --json that must still be a JSON payload — this is the most-hit --json
  # path (every read-only / planning session), and prose here left the
  # receipt's stub gate unparseable on most real runs.
  if [ "$MODE" = "--json" ]; then
    echo "{"
    echo "  \"files_edited\": 0,"
    echo "  \"checks_passed\": 0,"
    echo "  \"checks_failed\": 0,"
    echo "  \"warnings\": 0,"
    echo "  \"verdict\": \"PASS\","
    echo "  \"paths\": []"
    echo "}"
    exit 0
  fi
  echo "[heimdall] verify-edits: No edits tracked this session (ledger present, 0 edits)."
  exit 0
fi

file_count=$(echo "$paths" | wc -l | tr -d ' ')

# --- mid-session-clear cross-check (full-report): begin ---
# Mid-session clear evidence applies here too: a NON-empty ledger can still be
# an incomplete one if it was cleared earlier in the same session and only
# picked up new entries afterward. "Some edits verified" is not the same claim
# as "ALL of this session's edits are accounted for" — say so instead of
# silently verifying a partial set as if it were the whole session. This is
# the exact shape of the originally reported defect: a ledger showing ONE
# operation (e.g. a scratchpad write) while a real 89-line source edit and a
# new test file, logged earlier in the same session, had already been wiped.
if [ "$clears_lost" -gt 0 ]; then
  if [ "$MODE" = "--json" ]; then
    echo "{"
    echo "  \"verdict\": \"NON_VERIFIED\","
    echo "  \"reason\": \"ledger-cleared-mid-session\","
    echo "  \"ledger\": \"$ledger_file\","
    echo "  \"entries_lost\": $clears_lost,"
    echo "  \"files_edited\": $file_count,"
    echo "  \"checks_passed\": 0,"
    echo "  \"checks_failed\": 0,"
    echo "  \"warnings\": 0,"
    echo "  \"paths\": []"
    echo "}"
    exit 2
  fi
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "[heimdall] verify-edits: NOT VERIFIED — ledger cleared mid-session"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "This ledger currently tracks $file_count file(s), but it was reset at"
  echo "least once mid-session while holding real entries ($clears_lost total"
  echo "lost). This report can only cover what was logged AFTER that clear —"
  echo "edits made before it are not included here, verified or not."
  echo ""
  echo "Fix: find out why the clear fired (hooks.json's SessionStart ->"
  echo "edit-tracker clear has no gate on \`source\`, so it re-fires on"
  echo "resume/compact — or a concurrent agent sharing this ledger cleared it)."
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "VERDICT: NON-VERIFIED"
  exit 2
fi
# --- mid-session-clear cross-check (full-report): end ---

# --- untracked-git-diff cross-check: begin ---
# A non-empty ledger is not proof of a COMPLETE one: any file edited via a raw
# Bash command (sed/cat/heredoc/cp — not a Write/Edit/MultiEdit/NotebookEdit
# tool call) never reaches `edit-tracker log`, because the PostToolUse hook
# only matches those four tool names. This environment's own guidance steers
# agents toward exactly that raw-Bash path, so the gap is the common case, not
# a corner case. Cross-check the ledger's claimed paths against git's own
# dirty/staged file list: any file git considers changed that the ledger never
# logged is proof, not suspicion, that the ledger is an incomplete record —
# regardless of how many OTHER files it did catch correctly.
canon_path() {
  # Resolve a file path to its canonical absolute form (collapses double
  # slashes and resolves symlinked ancestors — e.g. macOS's $TMPDIR ends in
  # "/", and /tmp is itself a symlink to /private/tmp) so a byte-exact
  # compare against git's own already-canonical toplevel path doesn't
  # false-positive on the same file reached two different textual ways.
  _d=$(dirname -- "$1"); _b=$(basename -- "$1")
  _cd=$(cd "$_d" 2>/dev/null && pwd -P)
  if [ -n "$_cd" ]; then
    printf '%s/%s' "$_cd" "$_b"
  else
    printf '%s' "$1"
  fi
}
untracked_dirty=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null || true)
  git_files=$( { git diff --name-only 2>/dev/null; git diff --cached --name-only 2>/dev/null; } | sort -u || true)
  if [ -n "$git_files" ] && [ -n "$toplevel" ]; then
    paths_canon=""
    if [ -n "$paths" ]; then
      while IFS= read -r p; do
        [ -z "$p" ] && continue
        paths_canon="$paths_canon
$(canon_path "$p")"
      done <<< "$paths"
    fi
    while IFS= read -r gf; do
      [ -z "$gf" ] && continue
      case "$gf" in
        /*) gfabs="$gf" ;;
        *) gfabs="$toplevel/$gf" ;;
      esac
      gfcanon=$(canon_path "$gfabs")
      if ! printf '%s\n' "$paths_canon" | grep -qxF "$gfcanon"; then
        untracked_dirty="$untracked_dirty
$gf"
      fi
    done <<< "$git_files"
  fi
fi
if [ -n "$untracked_dirty" ]; then
  if [ "$MODE" = "--json" ]; then
    echo "{"
    echo "  \"verdict\": \"NON_VERIFIED\","
    echo "  \"reason\": \"untracked-git-diff\","
    echo "  \"ledger\": \"$ledger_file\","
    echo "  \"files_edited\": $file_count,"
    echo "  \"checks_passed\": 0,"
    echo "  \"checks_failed\": 0,"
    echo "  \"warnings\": 0,"
    echo "  \"paths\": []"
    echo "}"
    exit 2
  fi
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "[heimdall] verify-edits: NOT VERIFIED — untracked edits outside the ledger"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "This ledger tracks $file_count file(s), but git shows real changes to"
  echo "file(s) the ledger never logged:"
  printf '%s\n' "$untracked_dirty"
  echo ""
  echo "A file edited via a raw shell command (sed/cat/heredoc/cp) rather than"
  echo "the Write/Edit/MultiEdit/NotebookEdit tools never reaches"
  echo "\`edit-tracker log\` — the PostToolUse hook only matches those four."
  echo "This report can only cover what the ledger actually saw, and that is"
  echo "provably not everything that changed."
  echo ""
  echo "Fix: log the missed file(s) manually to resume tracking:"
  echo "  $TRACKER log Edit <path>"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "VERDICT: NON-VERIFIED"
  exit 2
fi
# --- untracked-git-diff cross-check: end ---

# ── Check 1: File existence ──
missing=""
while IFS= read -r filepath; do
  if [ ! -f "$filepath" ]; then
    missing="$missing\n  MISSING: $filepath"
    FAIL=$((FAIL + 1))
  else
    PASS=$((PASS + 1))
  fi
done <<< "$paths"

# ── Check 2: Stub/placeholder detection ──
stubs=""
stub_patterns='(//\s*TODO|#\s*TODO|FIXME|XXX|NotImplementedError|unimplemented!\(\)|todo!\(\)|placeholder|\bstub\b|\bshim\b|throw new Error\([\"'"'"']not implemented|^\s*pass\s*$|\(\)\s*=>\s*\{\s*\}|function\s*\(\)\s*\{\s*\})'

# Skip stub detection in these files (they reference patterns by necessity)
skip_stub_check() {
  case "$1" in
    */verify-edits|*/hooks.json|*/CLAUDE.md|*.md) return 0 ;;
    *) return 1 ;;
  esac
}

while IFS= read -r filepath; do
  if [ -f "$filepath" ] && ! skip_stub_check "$filepath"; then
    matches=$(grep -nE "$stub_patterns" "$filepath" 2>/dev/null | head -5 || true)
    if [ -n "$matches" ]; then
      stubs="$stubs\n  $filepath:"
      while IFS= read -r match; do
        stubs="$stubs\n    $match"
      done <<< "$matches"
      WARN=$((WARN + 1))
    fi
  fi
done <<< "$paths"

# ── Check 3: Git diff summary ──
diff_stats=""
if [ -d .git ]; then
  while IFS= read -r filepath; do
    if [ -f "$filepath" ]; then
      stat=$(git diff --stat -- "$filepath" 2>/dev/null || true)
      if [ -n "$stat" ]; then
        diff_stats="$diff_stats\n$stat"
      fi
      # Also check staged
      staged=$(git diff --cached --stat -- "$filepath" 2>/dev/null || true)
      if [ -n "$staged" ]; then
        diff_stats="$diff_stats\n$staged"
      fi
    fi
  done <<< "$paths"
fi

# ── Output ──
if [ "$MODE" = "--json" ]; then
  echo "{"
  echo "  \"files_edited\": $file_count,"
  echo "  \"checks_passed\": $PASS,"
  echo "  \"checks_failed\": $FAIL,"
  echo "  \"warnings\": $WARN,"
  echo "  \"verdict\": \"$([ $FAIL -eq 0 ] && echo 'PASS' || echo 'FAIL')\","
  echo "  \"paths\": ["
  first=1
  while IFS= read -r filepath; do
    [ $first -eq 0 ] && echo ","
    first=0
    exists="true"
    [ ! -f "$filepath" ] && exists="false"
    printf "    {\"path\": \"%s\", \"exists\": %s}" "$filepath" "$exists"
  done <<< "$paths"
  echo ""
  echo "  ]"
  echo "}"
  exit 0
fi

if [ "$MODE" = "--diff" ]; then
  while IFS= read -r filepath; do
    if [ -f "$filepath" ] && [ -d .git ]; then
      echo "=== $filepath ==="
      git diff -- "$filepath" 2>/dev/null || true
      git diff --cached -- "$filepath" 2>/dev/null || true
      echo ""
    fi
  done <<< "$paths"
  exit 0
fi

# Full or quick report
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "[heimdall] Edit Verification Report"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
"$TRACKER" summary
echo ""

if [ -n "$missing" ]; then
  echo "## File Existence: FAIL"
  echo -e "$missing"
  echo ""
else
  echo "## File Existence: PASS ($file_count/$file_count files exist)"
  echo ""
fi

if [ -n "$stubs" ]; then
  echo "## Stub/Placeholder Check: WARNING"
  echo -e "$stubs"
  echo ""
else
  echo "## Stub/Placeholder Check: PASS (no stubs detected)"
  echo ""
fi

if [ "$MODE" != "--quick" ] && [ -n "$diff_stats" ]; then
  echo "## Git Diff Summary:"
  echo -e "$diff_stats"
  echo ""
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $FAIL -gt 0 ]; then
  echo "VERDICT: FAIL ($FAIL issues)"
  exit 1
elif [ $WARN -gt 0 ]; then
  echo "VERDICT: WARN ($WARN warnings)"
  exit 0
else
  echo "VERDICT: PASS"
  exit 0
fi
