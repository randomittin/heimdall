#!/usr/bin/env bash
# heimdall-checkpoint — mechanical, LLM-free auto-save of forward session state.
#
# WHY THIS EXISTS
#   Heimdall is meant to auto-save session state to .planning/ so a fresh run
#   resumes with context. The RICH save is /hmd:save (commands/save.md) — but that
#   is an LLM PROMPT, so it only runs when a human types /hmd:save. Nothing wrote
#   the .planning state files on its own: the SessionEnd hook only did a git COMMIT
#   ("session-end checkpoint"), and .planning/ is gitignored, so forward state was
#   never persisted automatically. Result: RJ had to run /hmd:save by hand.
#
#   This script is the MECHANICAL fallback that the SessionEnd hook invokes so
#   auto-checkpointing fires on its own. It does NOT reimplement the LLM handoff —
#   it captures the machine-derivable forward state (git HEAD, recent commits,
#   dirty files, active goal, phase) into an .planning/CHECKPOINT.md block that a
#   resuming session (and bin/heimdall-context-capsule) already knows how to read.
#   A subsequent /hmd:save enriches the same file; this guarantees SOMETHING is
#   always there.
#
# CONTRACT
#   - Best-effort / non-fatal: every step tolerates missing git/jq/state. Exit 0.
#   - Idempotent: the auto block is delimited by markers and REPLACED in place, so
#     re-runs update (mtime advances) rather than appending forever.
#   - Non-destructive: a manual (marker-less) CHECKPOINT.md is preserved; the auto
#     block is inserted around it.
#   - .planning/ is gitignored — we write to disk only, never `git add`.
#
# USAGE
#   heimdall-checkpoint write [project_dir]   # write/update .planning/CHECKPOINT.md
#   heimdall-checkpoint help
#
# DEV-CHECKOUT COVERAGE
#   This is invoked from the EXISTING SessionEnd command in hooks/hooks.json (it is
#   an additive prefix to that one command, not a new hook entry). Plugin installs
#   load hooks.json directly; dev-checkouts get it because install.sh reads
#   hooks/hooks.json and mirrors every command into ~/.claude/settings.json. So no
#   NEW wiring is needed — a dev-checkout only re-runs install.sh (or reloads the
#   plugin) to pick up the updated SessionEnd command. If you hand-wire settings.json
#   instead, the SessionEnd entry must include this prefix (before the autocommit
#   early-exit, so state saves even when autocommit is off):
#     "SessionEnd": [{ "hooks": [{ "type": "command", "command":
#        "PLUGIN=\"${CLAUDE_PLUGIN_ROOT:-$(git rev-parse --show-toplevel)}\"; CKPT=\"$PLUGIN/bin/heimdall-checkpoint\"; if [ -x \"$CKPT\" ] && { [ -d .planning ] || [ -f heimdall-state.json ]; }; then \"$CKPT\" write . >/dev/null 2>&1 || true; fi; ..." }] }]

set -uo pipefail

BEGIN_MARK="<!-- heimdall-auto-checkpoint:begin -->"
END_MARK="<!-- heimdall-auto-checkpoint:end -->"

_timestamp() { date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "unknown"; }

# Best-effort wall-clock ceiling for a single external command. macOS ships no
# timeout(1); perl's alarm+exec is the portable substitute. Falls back to running
# unbounded if perl is missing — still non-fatal, since the outer SessionEnd hook
# chain already wraps this whole script at 10s (hooks/hooks.json).
_bounded() {
  local secs="$1"; shift
  if command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV' "$secs" "$@"
  else
    "$@"
  fi
}

# Resolve a sibling bin/ tool by this script's OWN location, not PATH — same
# resolution _publish_shared already uses below for checkpoint_share.py/heimdall-haid.
_sibling_tool() {
  local name="$1" self bindir
  self="$0"
  command -v readlink >/dev/null 2>&1 && self="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
  bindir="$(cd "$(dirname "$self")" 2>/dev/null && pwd)"
  if [ -x "$bindir/$name" ]; then
    printf '%s' "$bindir/$name"
  else
    command -v "$name" 2>/dev/null || true
  fi
}

# "Nothing is lost" proof (mechanical, no LLM): enumerate every git worktree of this
# repo and report whether each holds uncommitted changes or commits not yet merged
# into the base branch. `git log` on ONE checkout cannot answer this — the fear a
# context-reset has to overcome is "did I just lose another agent's work", and this
# is the only mechanical way to check every worktree at once. Bounded to wt_max
# entries so a runaway worktree count can never blow the SessionEnd time budget.
_worktree_ledger() {
  local project_dir="$1"
  local wt_max=25
  git -C "$project_dir" rev-parse --git-dir >/dev/null 2>&1 || return 0

  local raw
  raw=$(git -C "$project_dir" worktree list --porcelain 2>/dev/null)
  [ -n "$raw" ] || return 0

  local base
  base=$(printf '%s\n' "$raw" | awk '/^$/{exit} /^branch /{print $2}')
  base=${base#refs/heads/}
  [ -n "$base" ] || base="main"

  local wt_paths total_count
  wt_paths=$(printf '%s\n' "$raw" | awk '/^worktree /{print $2}')
  total_count=$(printf '%s\n' "$wt_paths" | grep -c .)
  [ -n "$total_count" ] || total_count=0

  local scanned=0 clean=0 flagged_count=0 flagged_lines="" wt n merged ok
  while IFS= read -r wt; do
    [ -n "$wt" ] || continue
    scanned=$((scanned + 1))
    if [ "$scanned" -gt "$wt_max" ]; then
      scanned=$((scanned - 1))
      break
    fi

    if [ ! -d "$wt" ]; then
      flagged_count=$((flagged_count + 1))
      flagged_lines="${flagged_lines}- MISSING \`${wt}\` — worktree directory no longer exists"$'\n'
      continue
    fi

    n=$(git -C "$wt" status --porcelain 2>/dev/null | grep -c .)
    [ -n "$n" ] || n=0

    merged=yes
    git -C "$wt" merge-base --is-ancestor HEAD "$base" 2>/dev/null || merged=no

    ok=yes
    if [ "$n" != "0" ]; then
      ok=no
      flagged_lines="${flagged_lines}- DIRTY \`${wt}\` — ${n} uncommitted file(s)"$'\n'
    fi
    if [ "$merged" = "no" ]; then
      ok=no
      flagged_lines="${flagged_lines}- UNMERGED \`${wt}\` — HEAD has commits not on \`${base}\`"$'\n'
    fi
    if [ "$ok" = "yes" ]; then
      clean=$((clean + 1))
    else
      flagged_count=$((flagged_count + 1))
    fi
  done <<WTPATHS
$wt_paths
WTPATHS

  local more=""
  if [ "$total_count" -gt "$wt_max" ] 2>/dev/null; then
    more=" (+$((total_count - wt_max)) more not scanned)"
  fi

  printf '### Worktree ledger — nothing-lost proof (%s of %s worktree(s) scanned%s)\n' "$scanned" "$total_count" "$more"
  printf -- '> Base ref: `%s`. Clean = zero uncommitted files AND HEAD merged into base.\n\n' "$base"
  if [ "$flagged_count" -eq 0 ]; then
    printf -- '- All %s scanned worktree(s) are clean. Nothing to rescue before a restart.\n\n' "$scanned"
  else
    printf -- '- %s/%s clean, %s flagged — rescue these before restarting:\n' "$clean" "$scanned" "$flagged_count"
    printf '%s\n' "$flagged_lines"
  fi
}

# This session's edited files (mechanical, no LLM): `git log` cannot attribute an
# edit to a SESSION — only the edit-tracker ledger (PostToolUse hook) can. An
# absent/untracked ledger is NOT the same as zero edits, so this section is omitted
# rather than printed as "0 files" when the ledger itself never ran.
_session_edits() {
  local tracker
  tracker="$(_sibling_tool edit-tracker)"
  [ -n "$tracker" ] || return 0

  local summary
  summary=$(_bounded 2 "$tracker" summary 2>/dev/null)
  [ -n "$summary" ] || return 0
  case "$summary" in
    *"NOT VERIFIED"*) return 0 ;;
  esac

  printf '### This session'"'"'s edited files (edit-tracker — git log cannot attribute these)\n'
  printf '```\n%s\n```\n\n' "$summary"
}

# Gate state (mechanical, no LLM): a resuming session must know a gate is RED BEFORE
# it tries to push — `git log` has no concept of gate status. The exit code is the
# ONLY authoritative signal: 0=clean, 2=failing, anything else (missing
# heimdall-state.json, missing binary, timeout, ...) is NOT-EVALUATED and must
# never be read as a pass.
_gate_state() {
  local project_dir="$1"
  local hstate verdict detail rc
  hstate="$(_sibling_tool heimdall-state)"

  verdict="NOT-EVALUATED"; detail=""
  if [ -n "$hstate" ]; then
    detail=$(cd "$project_dir" 2>/dev/null && _bounded 3 "$hstate" check-quality-gates 2>&1)
    rc=$?
    if [ "$rc" -eq 0 ]; then
      verdict="PASS"
    elif [ "$rc" -eq 2 ]; then
      verdict="FAILING"
    fi
  fi

  printf '### Gate state (push-gate verdict — %s)\n' "$verdict"
  if [ "$verdict" = "FAILING" ]; then
    printf '> RED — do not push until this clears. Detail:\n```\n%s\n```\n\n' "$detail"
  elif [ "$verdict" = "PASS" ]; then
    printf '> Clean — `heimdall-state check-quality-gates` exited 0.\n\n'
  else
    printf '> Never evaluated this run (no heimdall-state.json, no heimdall-state binary, or it timed out). Not a pass — run `heimdall-state check-quality-gates` before pushing.\n\n'
  fi

  local reports f st gid hint failcount=0 faillines=""
  if command -v jq >/dev/null 2>&1 && [ -d "$project_dir/evals/oracles" ]; then
    reports=$(find "$project_dir/evals/oracles" -maxdepth 2 -name report.json 2>/dev/null | head -50)
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      st=$(jq -r '.status // empty' "$f" 2>/dev/null)
      if [ "$st" = "fail" ]; then
        failcount=$((failcount + 1))
        gid=$(jq -r '.gate_id // "unknown"' "$f" 2>/dev/null)
        hint=$(jq -r '.fix_hint // ""' "$f" 2>/dev/null)
        faillines="${faillines}- FAIL \`${gid}\` (\`${f#"$project_dir"/}\`)${hint:+ — $hint}"$'\n'
      fi
    done <<REPORTS
$reports
REPORTS
  fi
  if [ "$failcount" -gt 0 ]; then
    printf '### Failing eval oracle gates (%s)\n' "$failcount"
    printf '%s\n' "$faillines"
  fi
}

# Build the machine-readable auto-checkpoint block (stdout). Pure, no side effects.
_build_block() {
  local project_dir="$1" ts="$2"
  local branch head_sha commits changed goal phase

  if git -C "$project_dir" rev-parse --git-dir >/dev/null 2>&1; then
    branch=$(git -C "$project_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    head_sha=$(git -C "$project_dir" rev-parse --short HEAD 2>/dev/null || echo "none")
    commits=$(git -C "$project_dir" log --oneline -10 2>/dev/null || true)
    changed=$(git -C "$project_dir" status --porcelain 2>/dev/null | head -40 || true)
  else
    branch="n/a"; head_sha="n/a"; commits=""; changed=""
  fi

  # Active goal (best-effort; heimdall-state may be absent or uninitialised).
  goal="none"
  if command -v heimdall-state >/dev/null 2>&1; then
    goal=$( (cd "$project_dir" && heimdall-state goal-get 2>/dev/null) || echo "none" )
  fi
  [ -z "$goal" ] && goal="none"

  # Phase from STATE.md frontmatter if present.
  phase="unknown"
  if [ -f "$project_dir/.planning/STATE.md" ]; then
    phase=$(awk '/^---$/{c++; next} c==1 && /^phase:/{gsub(/^phase:[[:space:]]*"?/,""); gsub(/"$/,""); print; exit}' \
      "$project_dir/.planning/STATE.md" 2>/dev/null || echo "unknown")
    [ -z "$phase" ] && phase="unknown"
  fi

  local dirty_count
  dirty_count=$(printf '%s\n' "$changed" | grep -c .)
  [ -n "$dirty_count" ] || dirty_count=0

  printf '%s\n' "$BEGIN_MARK"
  printf '## Auto-checkpoint — %s\n\n' "$ts"
  printf '> Written automatically at session end (mechanical, no LLM). Run `/hmd:save`\n'
  printf '> for a richer human/LLM-authored handoff — it enriches this same file.\n\n'
  printf -- '- **Branch:** %s\n' "$branch"
  printf -- '- **HEAD:** %s\n' "$head_sha"
  printf -- '- **Phase:** %s\n' "$phase"
  printf -- '- **Active goal:** %s\n' "$goal"
  printf -- '- **Uncommitted files:** %s\n\n' "$dirty_count"

  _worktree_ledger "$project_dir"
  _session_edits
  _gate_state "$project_dir"

  printf '### Recent commits\n'
  if [ -n "$commits" ]; then
    printf '%s\n' "$commits" | sed 's/^/- /'
  else
    printf -- '- (no git history)\n'
  fi
  printf '\n'

  if [ -n "$changed" ]; then
    printf '### Uncommitted changes (git status --porcelain)\n'
    printf '```\n%s\n```\n\n' "$changed"
  fi

  printf '### Resume\n'
  printf 'Runnable, in order:\n'
  printf '```bash\n'
  printf 'cat "%s/.planning/CHECKPOINT.md"    # this file, full context\n' "$project_dir"
  printf 'heimdall-state check-quality-gates  # gate must be green before any push\n'
  printf 'git -C "%s" status --porcelain      # confirm nothing changed since this write\n' "$project_dir"
  printf '```\n'
  printf 'Then `heimdall` to resume. If a goal is set above, restore it with `/goal <condition>`.\n'
  printf '%s\n' "$END_MARK"
}

# Splice the fresh block into CHECKPOINT.md.
#   - no file        -> header + block
#   - has markers    -> replace between begin/end (update in place)
#   - marker-less    -> prepend block, preserve existing (manual save protected)
_write_checkpoint() {
  local ckpt="$1" block="$2"
  local tmp
  tmp=$(mktemp) || return 1

  # Line numbers of an existing auto block, if any. Both markers must be present
  # and ordered for an in-place replace; otherwise we treat the file as manual.
  local bstart="" bend="" total
  if [ -f "$ckpt" ]; then
    bstart=$(grep -nF "$BEGIN_MARK" "$ckpt" 2>/dev/null | head -1 | cut -d: -f1)
    bend=$(grep -nF "$END_MARK" "$ckpt" 2>/dev/null | head -1 | cut -d: -f1)
  fi

  if [ ! -f "$ckpt" ]; then
    {
      printf '# Checkpoint\n\n'
      printf '%s\n' "$block"
    } > "$tmp"
  elif [ -n "$bstart" ] && [ -n "$bend" ] && [ "$bend" -ge "$bstart" ]; then
    # Replace the existing auto block in place (sed line-slice — no multi-line
    # awk -v, which breaks on BSD awk). Keep surrounding content verbatim.
    total=$(wc -l < "$ckpt" | tr -d ' ')
    {
      [ "$bstart" -gt 1 ] && sed -n "1,$((bstart - 1))p" "$ckpt"
      printf '%s\n' "$block"
      [ "$bend" -lt "$total" ] && sed -n "$((bend + 1)),\$p" "$ckpt"
    } > "$tmp"
  else
    # Manual/LLM-authored checkpoint (no clean auto block) — do NOT clobber.
    # Prepend the auto block, preserve the existing content below.
    {
      printf '%s\n\n' "$block"
      cat "$ckpt"
    } > "$tmp"
  fi

  mv "$tmp" "$ckpt" 2>/dev/null || { rm -f "$tmp"; return 1; }
}

# Persist goal + phase + last-checkpoint timestamp into .planning/settings.json.
# Best-effort: needs jq; a "none" goal is not written as a fake condition.
_update_settings() {
  local settings="$1" goal="$2" phase="$3" ts="$4"
  command -v jq >/dev/null 2>&1 || return 0

  local base tmp
  if [ -f "$settings" ]; then
    base=$(cat "$settings" 2>/dev/null)
    # Guard against a corrupt/non-JSON file — fall back to {} rather than error.
    echo "$base" | jq -e . >/dev/null 2>&1 || base='{}'
  else
    base='{}'
  fi

  tmp=$(mktemp) || return 0
  if [ "$goal" = "none" ] || [ -z "$goal" ]; then
    printf '%s' "$base" | jq --arg p "$phase" --arg ts "$ts" \
      '.phase = $p | .auto_checkpoint_at = $ts' > "$tmp" 2>/dev/null \
      && mv "$tmp" "$settings" 2>/dev/null || rm -f "$tmp"
  else
    printf '%s' "$base" | jq --arg g "$goal" --arg p "$phase" --arg ts "$ts" \
      '.goal = ((.goal // {}) + {condition: $g}) | .phase = $p | .auto_checkpoint_at = $ts' > "$tmp" 2>/dev/null \
      && mv "$tmp" "$settings" 2>/dev/null || rm -f "$tmp"
  fi
}

# Publish the SHAREABLE team checkpoint (TEAM MODE P4) — best-effort, non-fatal, consent-gated.
# This is the mechanical companion to the local CHECKPOINT.md write: it projects the machine-
# derivable forward state into the ALLOWLISTED, scrubbed, secret-scanned per-HAID record at
# .planning/ledger/checkpoints/{slug}.json (git-committed shared state) so a teammate can resume
# this session's work if this machine drops. All routing (consent OFF -> no-op; security-
# sensitive -> local lane; secret -> abort) lives in bin/lib/checkpoint_share.py; this only
# GATHERS the inputs (git + heimdall-state + the ledger claim) and hands them to publish().
_publish_shared() {
  local project_dir="$1" phase="$2" goal="$3"
  local self bindir lib py haid branch head_sha
  self="$0"
  command -v readlink >/dev/null 2>&1 && self="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
  bindir="$(cd "$(dirname "$self")" && pwd)"
  lib="$bindir/lib"
  [ -f "$lib/checkpoint_share.py" ] || return 0
  py="$(command -v python3 || command -v python || true)"
  [ -n "$py" ] || return 0

  branch="$(git -C "$project_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
  head_sha="$(git -C "$project_dir" rev-parse --short HEAD 2>/dev/null || echo none)"
  haid=""
  [ -x "$bindir/heimdall-haid" ] && haid="$("$bindir/heimdall-haid" current 2>/dev/null || true)"
  [ -n "$haid" ] || haid="haid:local"

  CS_PROJECT="$project_dir" CS_LIB="$lib" CS_HAID="$haid" CS_BRANCH="$branch" \
  CS_HEAD="$head_sha" CS_PHASE="$phase" CS_GOAL="$goal" \
  "$py" - <<'PYEOF' >/dev/null 2>&1 || true
import json, os, re, sys
sys.path.insert(0, os.environ["CS_LIB"])
import checkpoint_share as cs

project = os.environ["CS_PROJECT"]
haid = os.environ["CS_HAID"]
goal = os.environ.get("CS_GOAL", "none")
if goal in ("", "none"):
    goal = None

# claimed_surfaces + task_ref: mirror THIS haid's ledger claim (already-public globs), never
# re-derived. Reuse the same slug rule the claim store uses.
surfaces, task = [], None
claim = os.path.join(cs.claims_dir(project), cs.haid_slug(haid) + ".json")
try:
    with open(claim, "r", encoding="utf-8") as fh:
        cj = json.load(fh)
    if isinstance(cj, dict):
        surfaces = [s for s in (cj.get("claimed_surfaces") or []) if isinstance(s, str)]
        task = cj.get("task_ref")
except (OSError, ValueError):
    surfaces, task = [], None

# progress: coarse, derived from completed vs total task checkboxes in the planning state.
done = total = 0
for name in ("STATE.md", "CHECKPOINT.md"):
    p = os.path.join(project, ".planning", name)
    try:
        with open(p, "r", encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        continue
    done += len(re.findall(r"^\s*[-*]\s*\[[xX]\]", text, re.M))
    total += len(re.findall(r"^\s*[-*]\s*\[[ xX]\]", text, re.M))
progress = int(round(100 * done / total)) if total else 0

cs.publish({
    "haid": haid,
    "branch": os.environ.get("CS_BRANCH", "unknown"),
    "head_sha": os.environ.get("CS_HEAD", "none"),
    "phase": os.environ.get("CS_PHASE", "unknown"),
    "progress_pct": progress,
    "active_goal": goal,
    "claimed_surfaces": surfaces,
    "task_ref": task,
}, repo_root=project)
PYEOF
  return 0
}

cmd_write() {
  local project_dir="${1:-$PWD}"
  # Resolve; a bad path is non-fatal (we simply do nothing).
  project_dir=$(cd "$project_dir" 2>/dev/null && pwd) || return 0
  local planning="$project_dir/.planning"

  mkdir -p "$planning" 2>/dev/null || return 0

  local ts block
  ts=$(_timestamp)
  block=$(_build_block "$project_dir" "$ts") || return 0

  _write_checkpoint "$planning/CHECKPOINT.md" "$block" || return 0

  # Derive goal/phase once more for settings (cheap; keeps settings authoritative).
  local goal phase
  goal="none"
  if command -v heimdall-state >/dev/null 2>&1; then
    goal=$( (cd "$project_dir" && heimdall-state goal-get 2>/dev/null) || echo "none" )
  fi
  [ -z "$goal" ] && goal="none"
  phase="unknown"
  if [ -f "$planning/STATE.md" ]; then
    phase=$(awk '/^---$/{c++; next} c==1 && /^phase:/{gsub(/^phase:[[:space:]]*"?/,""); gsub(/"$/,""); print; exit}' \
      "$planning/STATE.md" 2>/dev/null || echo "unknown")
    [ -z "$phase" ] && phase="unknown"
  fi
  _update_settings "$planning/settings.json" "$goal" "$phase" "$ts"

  # Publish the shareable team checkpoint (P4) — consent-gated + non-fatal, inside publish().
  _publish_shared "$project_dir" "$phase" "$goal"

  echo "[heimdall-checkpoint] auto-saved $planning/CHECKPOINT.md" >&2
  return 0
}

case "${1:-help}" in
  write) cmd_write "${2:-}" ;;
  help|--help|-h)
    cat <<'USAGE'
heimdall-checkpoint — mechanical auto-save of forward session state to .planning/

Usage:
  heimdall-checkpoint write [project_dir]   Write/update .planning/CHECKPOINT.md
                                            (+ STATE.md phase & settings.json goal)
                                            from git + heimdall-state. Non-fatal,
                                            idempotent, never clobbers a manual save.

Invoked automatically by the SessionEnd hook. The rich, human-authored handoff is
/hmd:save (commands/save.md); this is the always-on mechanical safety net.
USAGE
    ;;
  *)
    echo "Unknown command: ${1}. Try: heimdall-checkpoint help" >&2
    exit 1
    ;;
esac
