#!/usr/bin/env bash
# discover-skills — mid-session skill gap detection and installation
# Called by Claude during a session when it encounters a new domain.
set -eo pipefail

SELF="$0"
if command -v readlink &>/dev/null; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
PLUGIN_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
SKILLS_DIR="$HOME/.claude/skills"
REGISTRY="$PLUGIN_DIR/skills-registry.json"
MANIFEST="$PLUGIN_DIR/skills.manifest.json"

# Receipted installs (bin/lib/install-receipt.sh). HMD_RUN_ID is inherited from the launching session, so a
# skill installed mid-session lands in that run's receipt; run by hand it goes to the "manual" one.
if [ -f "$PLUGIN_DIR/bin/lib/install-receipt.sh" ]; then
  # shellcheck disable=SC1091
  . "$PLUGIN_DIR/bin/lib/install-receipt.sh"
fi

# registry_on — is skills.registry on? Asked as the launcher and skill-manager ask it, `python3 -I bin/lib/skills_config.py get registry` (the
# environment, else the operator's $HEIMDALL_HOME/skills-config.json, else off; never a file of the repository). Anything but a clean "on" is off:
# the legacy code.
registry_on() {
  [ "$(python3 -I "$PLUGIN_DIR/bin/lib/skills_config.py" get registry 2>/dev/null)" = on ]
}

# registry_answer SUBCOMMAND [ARGS...] — print the answer of `skills_resolver.py SUBCOMMAND --manifest M ARGS...`, the registry reader the caller
# replaces. Non-zero, with nothing printed on stdout, when the flag is off or the resolver could not answer (any non-zero exit: an invalid manifest is
# exit 3, a crash): the caller then runs its legacy code, which stays authoritative in M1. The callers answer the two legacy non-zero results (an empty
# prompt, a missing file) themselves before they ask, so a non-zero here is never an answer. The answer is captured before it is printed, so a failed
# run never leaves half of one on stdout; the trailing x keeps the final newlines the substitution would cut. The resolver reads the caller's stdin.
registry_answer() {
  local subcommand="$1" answer
  shift
  registry_on || return 1
  if answer="$(python3 -I "$PLUGIN_DIR/bin/lib/skills_resolver.py" "$subcommand" --manifest "$MANIFEST" "$@" && printf x)"; then
    printf '%s' "${answer%x}"
    return 0
  fi
  echo "discover-skills: the skills registry resolver could not answer; using the legacy $subcommand" >&2
  return 1
}

# File extension → skill domain mapping (bash 3.2 compatible)
ext_to_domain() {
  case "$1" in
    tsx|jsx|vue|svelte|css|scss|less) echo "design" ;;
    gd|tscn|tres)                     echo "gamedev" ;;
    mmd|mermaid)                      echo "documentation" ;;
    *)                                echo "" ;;
  esac
}

# Content pattern → skill domain mapping
detect_domain_from_content() {
  local file="$1"
  [ -f "$file" ] || return 0
  local head
  head=$(head -50 "$file" 2>/dev/null || true)

  # Check content patterns
  if echo "$head" | grep -qiE 'tailwind|className.*flex|styled-component|@apply|css-in-js'; then
    echo "design"
  elif echo "$head" | grep -qiE 'extends Node|@onready|func _ready|GDScript'; then
    echo "gamedev"
  elif echo "$head" | grep -qiE 'mermaid|flowchart|sequenceDiagram|classDiagram|graph TD|graph LR'; then
    echo "documentation"
  elif echo "$head" | grep -qiE 'meta.*description|sitemap|robots|canonical|og:title|schema.org'; then
    echo "marketing"
  elif echo "$head" | grep -qiE 'obsidian|vault|wiki|knowledge.base'; then
    echo "knowledge"
  fi
}

# Find skills from registry matching a domain/category
find_skills_for_domain() {
  local domain="$1"
  [ -f "$REGISTRY" ] || return 0
  command -v python3 &>/dev/null || return 0
  # Every python program in this file is fixed text: the registry path and the domain/name/prompt reach it as argv (or
  # stdin), never spliced into its source, so a value holding a quote, ''' or a newline is a value, not code. -I keeps
  # the working directory (any project the user is in) off sys.path, so a planted json.py is never imported. The
  # here-document delimiter is quoted: bash expands nothing in it.
  python3 -I - "$REGISTRY" "$domain" 2>/dev/null <<'PYEOF'
import json, os, sys
with open(sys.argv[1]) as f:
    reg = json.load(f)
skills_dir = os.path.expanduser('~/.claude/skills')
for s in reg.get('skills', []):
    if s.get('category') == sys.argv[2]:
        installed = os.path.isdir(os.path.join(skills_dir, s['name']))
        status = 'installed' if installed else 'NOT INSTALLED'
        print(f"{s['name']}|{s['repo']}|{status}|{s['description']}")
PYEOF
}

# manifest_binds_repo NAME REPO -- 0 only when skills.manifest.json lists NAME as a github-skill whose repo is exactly REPO; 1 for anything else: another
# repository, a name the manifest lists as a plugin or does not list, a manifest that cannot be read or is not valid (the reason goes to stderr: a
# manifest that cannot vouch for a repository vouches for none). The consent gate decides by NAME (an allowlist line, consent auto), so on its own it
# approves `attacker/NAME` exactly as it approves the repository the manifest lists for NAME: this is what ties an approval to the repository. The
# manifest is read the way every reader of it reads it (bin/lib/skills_manifest.py: strict JSON, the whole contract checked). Fixed program text, NAME
# and REPO reach it as argv; -I keeps the working directory off sys.path and no .pyc is left in the plugin directory.
manifest_binds_repo() {
  python3 -I -c '
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, sys.argv[1])
try:
    import skills_manifest
    doc = skills_manifest.load(sys.argv[2])
    reasons = skills_manifest.validate(doc)
    if reasons:
        raise ValueError(reasons[0])
except Exception as exc:
    sys.exit("discover-skills: the skills manifest cannot vouch for a repository: %s" % exc)
sys.exit(0 if any(e["id"] == sys.argv[3] and e["kind"] == "github-skill" and e["repo"] == sys.argv[4] for e in doc["entries"]) else 1)
' "$PLUGIN_DIR/bin/lib" "$MANIFEST" "$1" "$2"
}

# install_skill NAME [OWNER/REPO] -- clone a skill into ~/.claude/skills, once somebody has said yes. A NEW install asks bin/lib/skills_consent.sh
# first (3.x M1, T5.2 of docs/superpowers/plans/2026-11-12-3x-m1-skill-registry.md, "Consent model"): with a terminal and consent=ask the person gets
# the Install now / Not now / Never ask again menu; with no terminal (this is what an agent calls mid-session) nothing is cloned, the skill becomes a
# `suggested` row in the skills lock and the exit status is 3, so the agent relays the question to the person. A yes is HMD_SKILLS_YES=1 or "Install
# now"; consent auto (chosen, or an install that predates the model) and an allowlisted name are a yes only for the repository the manifest lists for
# that name (manifest_binds_repo): any other repository is asked like consent=ask. A name the registry does not know and a skill that is already
# installed never reach the gate. Exit: 0 installed or already there | 1 unknown skill or the clone failed | 3 consent required | 4 declined.
install_skill() {
  local name="$1" repo="${2:-}"

  # If name contains /, treat as repo
  if [[ "$name" == */* ]]; then
    repo="$name"
    name=$(basename "$repo" | sed 's/\.git$//')
  fi

  # Look up in registry if no repo given
  if [ -z "$repo" ] && [ -f "$REGISTRY" ]; then
    # REGISTRY is argv[1], the skill name argv[2]: a name holding a quote is just an unknown name. A single-quoted
    # program, not a here-document: bash 3.2 cannot parse a here-document inside a command substitution.
    repo=$(python3 -I -c '
import json, sys
with open(sys.argv[1]) as f:
    reg = json.load(f)
for s in reg.get("skills", []):
    if s["name"] == sys.argv[2]:
        print(s["repo"]); break
' "$REGISTRY" "$name" 2>/dev/null)
  fi

  if [ -z "$repo" ]; then
    echo "ERROR: Skill '$name' not in registry. Use: discover-skills install owner/repo"
    return 1
  fi

  local skill_path="$SKILLS_DIR/$name"
  if [ -d "$skill_path" ]; then
    echo "ALREADY INSTALLED: $name at $skill_path"
    return 0
  fi

  # A NEW install is asked before anything is created or cloned. The why the lock row records (the rule that fired and the repo that was asked for,
  # never prompt text) and the project it belongs to (the one this command runs in: the lock tool's own default, and where the gate writes its rows,
  # so a `suggested` row becomes the `installed` row of the same lock) are read by the gate and by hmd_skill_install below, and live only as long
  # as this function.
  local consent_lib="$PLUGIN_DIR/bin/lib/skills_consent.sh" consent_rc=0
  local HMD_INSTALL_WHY_RULE=explicit HMD_INSTALL_WHY_EVIDENCE="$repo" WORK_DIR="${WORK_DIR:-$PWD}"
  if [ -f "$consent_lib" ]; then
    # shellcheck disable=SC1090
    if ! . "$consent_lib" || ! type hmd_skills_consent >/dev/null 2>&1; then
      echo "ERROR: cannot load the consent gate $consent_lib; not installing $name"
      return 3
    fi
    # `|| consent_rc=$?`, the form the gate's header gives for a caller under set -e: its 10 (defer) and 11 (declined) are answers, not failures.
    # The gate answers by NAME, and whoever runs this command chooses the repository (an agent mid-session, on the word of whatever it read), so an
    # allowlisted name or consent auto would approve `attacker/NAME` as readily as the repository the manifest lists for NAME. Such an approval counts
    # only for that repository: for any other one the gate runs with consent=ask, the way bin/lib/skills_cli_install.py asks an explicit_consent
    # entry (a terminal gets the menu, nothing else clones without a yes).
    if manifest_binds_repo "$name" "$repo"; then
      hmd_skills_consent "$name" discover-skills || consent_rc=$?
    else
      echo "discover-skills: $repo is not the repository the skills manifest lists for $name; only a yes installs it, whatever the consent mode (an allowlist, consent auto)" >&2
      HMD_SKILLS_CONSENT=ask hmd_skills_consent "$name" discover-skills || consent_rc=$?
    fi
    case "$consent_rc" in
      0) ;;
      11)
        echo "declined: $name was declined earlier and is not installed (hmd skills suggest --reset asks again)"
        return 4 ;;
      *)
        echo "consent required: $name ($repo) was not installed. Ask the user; if they agree, rerun the same discover-skills install command with HMD_SKILLS_YES=1."
        return 3 ;;
    esac
  else
    # A tree without the gate predates the consent model, and installs as it always did: said, never silent.
    echo "discover-skills: $consent_lib is missing; installing $name without a consent check" >&2
  fi

  mkdir -p "$SKILLS_DIR"
  echo "INSTALLING: $name from $repo..."
  if hmd_skill_install "$name" "$repo" "$skill_path" discover-skills; then
    echo "OK: Installed $name to $skill_path"

    # Auto-create SKILL.md if missing (needed for Claude Code skill discovery)
    if [ ! -f "$skill_path/SKILL.md" ] && [ -f "$skill_path/CLAUDE.md" ]; then
      local desc=""
      if [ -f "$skill_path/skill.json" ] && command -v python3 &>/dev/null; then
        desc=$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1])).get("description", ""))' "$skill_path/skill.json" 2>/dev/null || true)
      fi
      [ -z "$desc" ] && desc="Skill installed from $repo"
      {
        echo "---"
        echo "name: $name"
        echo "description: $desc"
        echo "---"
        echo ""
        # Include CLAUDE.md content (skip the "# CLAUDE.md" header line if present). awk, not sed '1{/re/d}': BSD sed (macOS) rejects that
        # script ("extra characters at the end of d command"), which aborted the install under set -e.
        awk 'NR == 1 && /^# CLAUDE\.md$/ { next } { print }' "$skill_path/CLAUDE.md"
      } > "$skill_path/SKILL.md"
      echo "OK: Generated SKILL.md for Claude Code discovery"
    fi
  else
    echo "ERROR: Failed to clone $repo"
    return 1
  fi
}

cmd_detect() {
  # Detect skill gaps from prompt keywords
  local prompt="$*"
  [ -z "$prompt" ] && { echo "Usage: discover-skills detect <prompt or description>"; return 1; }

  local prompt_lower
  prompt_lower=$(echo "$prompt" | tr '[:upper:]' '[:lower:]')

  [ -f "$REGISTRY" ] || { echo "No registry found"; return 0; }
  command -v python3 &>/dev/null || { echo "python3 required"; return 0; }

  # skills.registry on: the resolver's `detect` answers. The prompt is DATA for it too: it arrives on stdin (a here-string, the same text the legacy
  # program below reads plus a newline, which no keyword can tell from the end of the text), never in its command line.
  registry_answer detect --prompt-file /dev/stdin <<< "$prompt_lower" && return 0

  # The prompt is DATA: it reaches python on stdin and the registry path as argv[1]; the program is one fixed
  # single-quoted string (it holds no '), run with -I. Splicing the prompt into the source (prompt = '''...''') made a
  # prompt holding ''' a SyntaxError -- an aborted script under set -e -- and a crafted one arbitrary code.
  local gaps
  gaps=$(printf '%s' "$prompt_lower" | python3 -I -c '
import json, re, os, sys
prompt = sys.stdin.buffer.read().decode("utf-8", "replace")
with open(sys.argv[1]) as f:
    reg = json.load(f)
skills_dir = os.path.expanduser("~/.claude/skills")
found = []
for skill in reg.get("skills", []):
    if os.path.isdir(os.path.join(skills_dir, skill["name"])):
        continue
    for kw in skill.get("keywords", []):
        if re.search(r"\b" + re.escape(kw) + r"\b", prompt):
            found.append(skill)
            break
for s in found:
    name, repo, desc = s["name"], s["repo"], s["description"]
    print(f"MISSING: {name} ({repo}) — {desc}")
    print(f"  Install: discover-skills install {name}")
if not found:
    print("No skill gaps detected.")
' "$REGISTRY" 2>/dev/null)

  echo "$gaps"
}

cmd_detect_file() {
  local file="$1"
  [ -f "$file" ] || { echo "File not found: $file"; return 1; }

  # skills.registry on: the resolver's `detect-file` answers the whole command (find_skills_for_domain below stays legacy: this is its only caller, and
  # on a resolver that cannot answer the legacy code is what runs). --file=PATH keeps a path that starts with a dash a value, never an option.
  registry_answer detect-file --file="$file" && return 0

  # Detect domain from extension
  local ext="${file##*.}"
  local domain
  domain=$(ext_to_domain "$ext")

  # Fall back to content detection
  if [ -z "$domain" ]; then
    domain=$(detect_domain_from_content "$file")
  fi

  if [ -z "$domain" ]; then
    echo "No skill domain detected for $file"
    return 0
  fi

  echo "Domain detected: $domain (from $file)"
  local skills
  skills=$(find_skills_for_domain "$domain")
  if [ -n "$skills" ]; then
    echo ""
    echo "Relevant skills:"
    while IFS='|' read -r name repo status desc; do
      if [ "$status" = "NOT INSTALLED" ]; then
        echo "  ⚠ $name — $desc"
        echo "    Install: discover-skills install $name"
      else
        echo "  ✔ $name — $desc"
      fi
    done <<< "$skills"
  fi
}

cmd_search() {
  local query="$1"
  [ -z "$query" ] && { echo "Usage: discover-skills search <query>"; return 1; }

  if command -v gh &>/dev/null; then
    gh api search/repositories --method GET \
      -f q="topic:claude-code ${query} sort:stars" \
      -f per_page=8 \
      --jq '.items[] | "★\(.stargazers_count)  \(.full_name)\n  \(.description // "no description")\n  Install: discover-skills install \(.full_name)\n"' 2>/dev/null
  else
    echo "gh CLI required for search. Install: brew install gh"
    return 1
  fi
}

cmd_gaps() {
  # Show all uninstalled skills from registry
  [ -f "$REGISTRY" ] || { echo "No registry found"; return 0; }
  command -v python3 &>/dev/null || return 0

  # skills.registry on: the resolver's `gaps` answers, header and footer included.
  registry_answer gaps && return 0

  echo "Skill gaps (not installed):"
  echo ""
  python3 -I - "$REGISTRY" 2>/dev/null <<'PYEOF'
import json, os, sys
with open(sys.argv[1]) as f:
    reg = json.load(f)
skills_dir = os.path.expanduser('~/.claude/skills')
missing = 0
for s in reg.get('skills', []):
    if not os.path.isdir(os.path.join(skills_dir, s['name'])):
        missing += 1
        print(f"  ⚠ {s['name']:<25} {s['description']}")
        print(f"    Install: discover-skills install {s['name']}")
if missing == 0:
    print('  All registry skills installed!')
else:
    print(f'\n  {missing} skill(s) not installed.')
PYEOF
}

# Dispatch
case "${1:-}" in
  detect)       shift; cmd_detect "$@" ;;
  detect-file)  cmd_detect_file "${2:-}" ;;
  search)       cmd_search "${2:-}" ;;
  install)      install_skill "${2:-}" "${3:-}" ;;
  gaps)         cmd_gaps ;;
  *)
    echo "discover-skills — mid-session skill gap detection"
    echo ""
    echo "Commands:"
    echo "  detect <prompt>        Check if prompt needs skills not installed"
    echo "  detect-file <path>     Detect skill domain from file content"
    echo "  search <query>         Search GitHub for skills"
    echo "  install <name|repo>    Install a skill from registry or GitHub"
    echo "  gaps                   Show all uninstalled registry skills"
    ;;
esac
