#!/usr/bin/env bash
# heimdall-watch-tui — `hmd watch`, the TUI dashboard (spec section C).
#
# NAME: this is a DISTINCT bin from bin/heimdall-watch (the H-3 sentinel watch-mode
# tool), mirroring the heimdall-drain anti-clobber convention. The dispatcher routes
# `hmd watch` here; the sentinel keeps its own direct/git-hook invocation.
#
# The dashboard lives inside the dev's own terminal (iTerm/Ghostty/tmux/Warp) and is
# a RENDERER over Heimdall's local caches — it makes ZERO additional server calls
# (the WALL reads the roster cache the beat cadence already maintains; the FEED reads
# the local receipt/verdict trail; the INSPECTOR reads local artifacts). Owner actions
# shell the existing CLI. See bin/lib/watch_data.py + bin/lib/watch_tui.py.
#
# Modes:
#   hmd watch            full dashboard (Textual) when textual is importable. When textual
#                        is ABSENT, a no-textual auto-refresh LIVE wall (ANSI reprint every
#                        ~2s + self-beating) — a live wall with ZERO extra deps. Piped/CI
#                        (non-TTY) degrades to a single static dump (never an infinite loop).
#   hmd watch --pane     slim tmux-split wall-only view.
#   hmd watch --once     one-shot static wall+feed dump (no interactive loop; CI/pipes).
#   hmd watch --install-tui  install textual into hmd's OWN python (PEP-668-aware) for the
#                        rich TUI — targets the exact interpreter hmd watch runs under, NOT
#                        an isolated pipx/brew venv hmd can't import from.
#   hmd watch -h|--help  this help.
#
# Textual is NOT a hard dependency of hmd — its absence degrades to a live wall, never blocks.
set -euo pipefail

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
LIB_DIR="$BIN_DIR/lib"
ENTRY="$LIB_DIR/watch_entry.py"

usage() { sed -n '2,26p' "$SELF" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

PY="$(command -v python3 || command -v python || true)"
if [ -z "$PY" ]; then
  echo "hmd watch needs python3 (not found on PATH)." >&2
  echo "Install python3, then re-run: hmd watch" >&2
  exit 2
fi
if [ ! -f "$ENTRY" ]; then
  echo "error: watch entry not found at $ENTRY" >&2
  echo "Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
  exit 2
fi

exec "$PY" "$ENTRY" "$@"
