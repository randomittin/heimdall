#!/usr/bin/env bash
# heimdall-render-version — render every version-bearing surface FROM plugin.json.
#
# .claude-plugin/plugin.json .version is the SINGLE SOURCE of version truth. Every other
# place that names the version is GENERATED from it by this script — never hand-typed. That
# is what makes test/version-drift.test.sh a real gate rather than a chore: the only way to
# change a rendered surface is to change the manifest and re-render.
#
# Rendered surfaces:
#   1. VERSION                 — repo-root plain-text mirror (tooling/CI that has no JSON parser)
#   2. README.md               — the generated region between the HEIMDALL:VERSION markers
#                                (badge + version line). Nothing else in the region is touched.
#   2b. README.md version pins — two version-bearing spots that live OUTSIDE the markers, so the
#                                generated region cannot reach them, yet the drift gate greps
#                                EVERY X.Y.Z in the file: the `Pinned to the vX.Y.Z tag` prose
#                                and the releases/download/vX.Y.Z/install.sh.minisig asset URL.
#                                Rewritten in place with anchored regexes keyed on their
#                                surrounding text — only those two spots move; every other line
#                                (and any historical version reference) is passed through untouched.
#
# The remaining surfaces (packages/runheimdall/package.json, vercel.json, _redirects,
# install.sh DEFAULT_REF) are tag-derived and rendered by release/sync-release.sh, which
# ship.sh calls with the same tag. This script deliberately does NOT duplicate that logic.
#
# Usage:
#   bin/heimdall-render-version            # render surfaces from plugin.json, in place
#   bin/heimdall-render-version --check    # exit 1 if any surface is stale (renders nothing)
#   bin/heimdall-render-version --print    # print the authoritative version, exit
#
# Exit 0 = surfaces match the manifest (or were rendered to match).
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SELF_DIR/.." && pwd)"
MANIFEST="$ROOT/.claude-plugin/plugin.json"
README="$ROOT/README.md"
VERSION_FILE="$ROOT/VERSION"

MARK_BEGIN='<!-- HEIMDALL:VERSION:BEGIN — generated by bin/heimdall-render-version; do not edit by hand -->'
MARK_END='<!-- HEIMDALL:VERSION:END -->'

die() { printf 'heimdall-render-version: %s\n' "$*" >&2; exit 1; }

MODE="render"
case "${1:-}" in
  --check) MODE="check" ;;
  --print) MODE="print" ;;
  -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "") ;;
  *) die "unknown arg: $1 (try --help)" ;;
esac

# ── Read the single source of truth ──────────────────────────────────────────
# Prefer jq; the sed fallback keeps this runnable on a box without jq and uses the SAME
# resolution as release/ship.sh read_version, so the two can never disagree.
[ -f "$MANIFEST" ] || die "manifest not found: $MANIFEST"
if command -v jq >/dev/null 2>&1; then
  VERSION="$(jq -r '.version // empty' "$MANIFEST" 2>/dev/null || true)"
else
  VERSION="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([0-9]*\.[0-9]*\.[0-9]*\)".*/\1/p' "$MANIFEST" | head -1)"
fi
printf '%s' "$VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' \
  || die "plugin.json .version is not semver: '${VERSION:-<none>}'"

if [ "$MODE" = "print" ]; then printf '%s\n' "$VERSION"; exit 0; fi

# ── The generated README region ──────────────────────────────────────────────
render_readme_region() {
  cat <<EOF
$MARK_BEGIN
[![Version](https://img.shields.io/badge/version-${VERSION}-00d4ff?style=flat-square)](CHANGELOG.md)
$MARK_END
EOF
}

STALE=0
note_stale() { printf '  stale: %s\n' "$*"; STALE=1; }

# ── 1. VERSION ───────────────────────────────────────────────────────────────
render_version_file() {
  local cur=""
  [ -f "$VERSION_FILE" ] && cur="$(tr -d '[:space:]' < "$VERSION_FILE")"
  if [ "$cur" = "$VERSION" ]; then return 0; fi
  if [ "$MODE" = "check" ]; then note_stale "VERSION is '${cur:-<missing>}', manifest is '$VERSION'"; return 0; fi
  printf '%s\n' "$VERSION" > "$VERSION_FILE" || die "could not write $VERSION_FILE"
  printf '  rendered VERSION -> %s\n' "$VERSION"
}

# ── 2. README generated region ───────────────────────────────────────────────
# awk splits the file on the markers and substitutes the freshly rendered block, so
# everything outside the markers (including A4's install section) is passed through byte
# for byte. A missing marker pair is a hard error, not a silent skip — an unrendered
# README is exactly the drift this script exists to prevent.
render_readme() {
  [ -f "$README" ] || die "README not found: $README"
  grep -Fq "$MARK_BEGIN" "$README" || die "README is missing the HEIMDALL:VERSION:BEGIN marker — add the generated region before rendering"
  grep -Fq "$MARK_END"   "$README" || die "README is missing the HEIMDALL:VERSION:END marker"

  local new tmp
  new="$(mktemp "${TMPDIR:-/tmp}/hmd-readme.XXXXXX")" || die "mktemp failed"
  tmp="$(mktemp "${TMPDIR:-/tmp}/hmd-readme.XXXXXX")" || die "mktemp failed"
  render_readme_region > "$new"

  awk -v begin="$MARK_BEGIN" -v end="$MARK_END" -v blockfile="$new" '
    $0 == begin { inblock = 1; while ((getline line < blockfile) > 0) print line; close(blockfile); next }
    $0 == end   { inblock = 0; next }
    !inblock    { print }
  ' "$README" > "$tmp" || { rm -f "$new" "$tmp"; die "README render failed"; }

  # The rendered region must actually carry the manifest version — a template that silently
  # produced nothing would otherwise pass as "rendered".
  grep -Fq "badge/version-${VERSION}-" "$tmp" \
    || { rm -f "$new" "$tmp"; die "render produced a README without the version badge — refusing to write"; }

  if cmp -s "$README" "$tmp"; then rm -f "$new" "$tmp"; return 0; fi
  if [ "$MODE" = "check" ]; then
    note_stale "README generated region does not match manifest '$VERSION'"
    rm -f "$new" "$tmp"; return 0
  fi
  mv "$tmp" "$README" || { rm -f "$new" "$tmp"; die "could not write $README"; }
  rm -f "$new"
  printf '  rendered README version region -> %s\n' "$VERSION"
}

# ── 2b. README un-marked version pins (prose + minisig URL) ───────────────────
# Two version-bearing spots live OUTSIDE the HEIMDALL:VERSION markers, so render_readme above
# cannot reach them, yet test/version-drift + version-unified grep EVERY X.Y.Z in the file —
# leave them and every version bump silently reintroduces version-drift red (they were last
# hand-synced, which is exactly the manual step this renderer exists to remove):
#   - the prose:  Pinned to the `vX.Y.Z` tag
#   - the asset:  .../releases/download/vX.Y.Z/install.sh.minisig
# Both are rewritten FROM plugin.json with anchored regexes keyed on their surrounding text —
# NOT a blind s/<oldver>/<newver>/g — so ONLY these two spots move and any other version
# reference is left untouched. The anchors are REQUIRED to exist: a README that lost either
# line is a hard error, not a silent skip, mirroring the marker guard in render_readme.
render_readme_pins() {
  [ -f "$README" ] || die "README not found: $README"
  grep -Eq 'Pinned to the `v[0-9]+\.[0-9]+\.[0-9]+` tag' "$README" \
    || die "README is missing the 'Pinned to the \`vX.Y.Z\` tag' pin — cannot render it (anchor gone)"
  grep -Eq 'releases/download/v[0-9]+\.[0-9]+\.[0-9]+/install\.sh\.minisig' "$README" \
    || die "README is missing the releases/download/vX.Y.Z/install.sh.minisig pin — cannot render it (anchor gone)"

  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/hmd-readme-pins.XXXXXX")" || die "mktemp failed"
  sed -E \
    -e "s|(Pinned to the \`v)[0-9]+\.[0-9]+\.[0-9]+(\` tag)|\1${VERSION}\2|g" \
    -e "s|(releases/download/v)[0-9]+\.[0-9]+\.[0-9]+(/install\.sh\.minisig)|\1${VERSION}\2|g" \
    "$README" > "$tmp" || { rm -f "$tmp"; die "README pin render failed"; }

  # Both spots must actually carry the manifest version now — a silent no-op or a rewrite that
  # produced the wrong version would otherwise pass as "rendered".
  grep -Fq "Pinned to the \`v${VERSION}\` tag" "$tmp" \
    && grep -Fq "releases/download/v${VERSION}/install.sh.minisig" "$tmp" \
    || { rm -f "$tmp"; die "pin render did not produce version ${VERSION} at both spots — refusing to write"; }

  if cmp -s "$README" "$tmp"; then rm -f "$tmp"; return 0; fi
  if [ "$MODE" = "check" ]; then
    note_stale "README version pins (prose + minisig URL) do not match manifest '$VERSION'"
    rm -f "$tmp"; return 0
  fi
  mv "$tmp" "$README" || { rm -f "$tmp"; die "could not write $README"; }
  printf '  rendered README version pins -> %s\n' "$VERSION"
}

printf 'heimdall-render-version: manifest=%s mode=%s\n' "$VERSION" "$MODE"
render_version_file
render_readme
render_readme_pins

if [ "$MODE" = "check" ]; then
  [ "$STALE" -eq 0 ] || die "version surfaces are STALE — run bin/heimdall-render-version"
  printf '  all rendered surfaces match plugin.json (%s)\n' "$VERSION"
fi
exit 0
