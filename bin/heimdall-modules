#!/usr/bin/env bash
# heimdall-modules — the module system core: install, wire, verify and TOTALLY
# remove optional capability modules.
#
# WHAT THIS IS. hmd's base install ships the SYSTEM and ZERO module payloads.
# A module is an optional capability described by a manifest in the registry.
# The registry IS this repo (modules/<name>/manifest.json), so every pin is a
# reviewed commit rather than a network lookup.
#
# THE PROPERTY THIS EXISTS TO GUARANTEE. A module that fails its own class test
# must leave NO TRACE. add and remove therefore share one removal path, and an
# invariant failure calls exactly that path — so a rejected module rolls back
# byte-identically to the pre-add tree. "It half-installed" is the failure mode
# that eats an afternoon; it is designed out, not documented around.
#
# THE ORDER IS THE CONTRACT:
#
#     validate -> class contract -> preflight -> consent
#              -> install + digest-verify -> wire -> invariants
#
# Everything before `install` is READ-ONLY, so a manifest rejected at validate,
# class, preflight or consent mutates nothing at all. From `install` onward every
# failure unwinds through remove_module().
#
# PREFLIGHT SITS BEFORE CONSENT deliberately: nobody should be asked to agree to
# an install that cannot happen. It converts the preconditions an install depends
# on into named checks with named fixes, so a failure arrives as a command the
# operator can run rather than as a compiler traceback ten minutes in.
#
# CLASSES ARE DATA, NOT CODE. modules/_classes/<class>.json carries
# `consent_required` plus a `requires_invariants` list, and this harness
# DISCOVERS what to enforce by reading that file. Nothing here is hardcoded per
# module, and adding a class is a JSON file, not a patch to this script.
#
# A MODULE MAY CLAIM SEVERAL CLASSES. `permission_class` takes a string or a
# list, and every class named contributes its invariants — the UNION runs, never
# the first match. A module that proxies traffic AND encodes what it stores is
# genuinely both, and modelling only one would not fail loudly: it would quietly
# stop running the other class's checks. Consent is the union too (if any class
# requires it, it is required), and each recorded result carries the class that
# demanded it so a class dropped later is visible in the receipt.
#
# An invariant check is one of two kinds:
#   suite     the CLASS owns the command (repo-owned, reviewable in one place).
#             Used where the repo already holds the falsifier — the traffic-proxy
#             and storage-codec classes both consume the judgment falsifier.
#   manifest  the MODULE owns the command, supplied under `invariants.<id>`.
#             Used where only the module knows how to drive itself (a codec's
#             round-trip, an adapter's wrap/unwrap).
# A manifest that does not cover every required invariant is REFUSED and NOT
# WIRED, and the message names the missing ids.
#
# TRUST BOUNDARY. `manifest` checks run a command from the manifest, and suite
# checks run a command from the class file. Both are repo-tracked content: the
# registry is the repo, so a manifest lands through review exactly like any
# other file. Every check runs under a hard wall-clock alarm so a hung or
# malicious check cannot wedge the run.
#
# PINS, NOT LATEST. A manifest records `pinned_version` (version + artifact
# sha256). There is NO code path that resolves "latest" — `update` moves to the
# pin the manifest already holds, which a human edited and committed. Blind
# -latest is not disabled by a flag; it does not exist.
#
# TIERS. `available` -> `suggested`. A `suggested` module must carry
# `tier_evidence` (a green pre-registered A/B or equivalent receipt) or it is
# refused. The tier controls how loudly hmd RECOMMENDS a module. It never
# controls whether one installs: nothing here self-installs, ever.
#
# STATE. One directory per installed module under the state root (default
# <plugin>/.heimdall/modules, which .gitignore already excludes). There is no
# shared ledger file to rewrite, so removal is `rm -rf` of exactly one directory
# plus pruning any directory this tool created — which is what makes
# byte-identical removal reachable rather than aspirational.
#
# Usage:
#   heimdall-modules list                 installed + available (default verb)
#   heimdall-modules add <name>           run the full ordered pipeline
#   heimdall-modules remove <name>        total removal
#   heimdall-modules update [<name>]      move to the manifest's human-set pin
#   heimdall-modules status <name>        one module in detail
#   heimdall-modules verify [<name>]      re-run class invariants (CI entry point)
#   heimdall-modules preflight <name>     can it install? every precondition + its fix
#   heimdall-modules repair <name>        preflight, fix what is fixable, re-attempt
#   heimdall-modules defer <name>         record install intent; do NOT fetch now
#   heimdall-modules pending              names wanting a repair (empty = no work)
#   heimdall-modules optout <name>        deliberately decline; nothing re-installs it
#   heimdall-modules optin <name>         undo an optout
#
#   --json            structured output on stdout
#   --yes             grant consent non-interactively (the operator is saying yes)
#   --quiet           no stdout on success (the backgrounded `hmd update` path)
#   --registry DIR    registry root (default <plugin>/modules)
#   --state DIR       install state root (default <plugin>/.heimdall/modules)
#   -h | --help
#
# EXIT: 0 success (INCLUDING an honest empty list — nothing installed is a real
#       answer, not an error). 1 a module was refused or an invariant failed.
#       2 usage / IO error.
set -uo pipefail

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$BIN_DIR/.." && pwd)"

command -v jq >/dev/null 2>&1 || { echo "error: jq is required" >&2; exit 2; }

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$SELF"; }

die()  { echo "error: $*" >&2; exit 2; }
warn() { echo "$*" >&2; }

# ── Arguments ────────────────────────────────────────────────────────────────
CMD=""
TARGET=""
AS_JSON=0
ASSUME_YES=0
QUIET=0
REGISTRY="${HMD_MODULES_REGISTRY:-$PLUGIN_DIR/modules}"
STATE="${HMD_MODULES_STATE:-$PLUGIN_DIR/.heimdall/modules}"

while [ $# -gt 0 ]; do
  case "$1" in
    --json)     AS_JSON=1; shift ;;
    --yes|-y)   ASSUME_YES=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    --registry) REGISTRY="${2:-}"; [ -n "$REGISTRY" ] || die "--registry needs a path"; shift 2 ;;
    --state)    STATE="${2:-}";    [ -n "$STATE" ]    || die "--state needs a path";    shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    -*)         die "unknown option: $1" ;;
    *)
      if [ -z "$CMD" ]; then CMD="$1"
      elif [ -z "$TARGET" ]; then TARGET="$1"
      else die "unexpected argument: $1"
      fi
      shift ;;
  esac
done

CMD="${CMD:-list}"
case "$CMD" in
  list|add|remove|update|status|verify|preflight|repair|defer|pending|optout|optin) : ;;
  *) echo "error: unknown command: $CMD" >&2; usage >&2; exit 2 ;;
esac

CLASS_DIR="$REGISTRY/_classes"

# ── Small helpers ────────────────────────────────────────────────────────────
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Pick a sha256 tool once, and REFUSE clearly if the machine has none rather
# than letting a "command not found" surface as an empty digest — an empty
# digest compared against a pin would silently never match, which reads as a
# tampered artifact instead of a missing tool.
HASHER=""
if command -v shasum >/dev/null 2>&1; then HASHER="shasum -a 256"
elif command -v sha256sum >/dev/null 2>&1; then HASHER="sha256sum"
elif command -v openssl >/dev/null 2>&1; then HASHER="openssl dgst -sha256"
fi
[ -n "$HASHER" ] || die "no sha256 tool available (need one of: shasum, sha256sum, openssl)"

# Every one of the three prints the digest as the only 64-hex token on the line,
# in three different layouts. Extracting the token normalises all three.
sha256_file()   { $HASHER "$1" | grep -oE '[0-9a-f]{64}' | head -1; }
sha256_string() { printf '%s' "$1" | $HASHER | grep -oE '[0-9a-f]{64}' | head -1; }

# Run a check command under a hard wall-clock alarm. macOS ships no timeout(1),
# so the alarm is perl's. Sets CAP_OUT / CAP_RC. A check that outlives its
# budget is a FAILED check, never an ignored one.
CAP_OUT=""; CAP_RC=0
capture() {
  local cmd="$1" secs="${2:-600}"
  CAP_OUT="$(cd "$PLUGIN_DIR" && perl -e 'alarm shift @ARGV; exec @ARGV' -- "$secs" bash -c "$cmd" 2>&1)"
  CAP_RC=$?
  if [ "$CAP_RC" -eq 142 ] || [ "$CAP_RC" -eq 14 ]; then
    CAP_OUT="${CAP_OUT}
[heimdall-modules] check exceeded its ${secs}s budget and was killed"
  fi
}

manifest_path() { printf '%s/%s/manifest.json' "$REGISTRY" "$1"; }
class_path()    { printf '%s/%s.json' "$CLASS_DIR" "$1"; }

# A module is installed iff its receipt exists. No shared ledger to drift.
is_installed() { [ -f "$STATE/$1/receipt.json" ]; }

# ── lifecycle side-records: the three states that are NOT "installed" ────────
# "Not installed" is three different facts, and conflating them is what makes an
# optional module feel broken:
#   opted out      the operator declined. Nothing may ever re-install it.
#   install failed we tried and it did not work. WHICH STAGE failed is the fact
#                  that turns a shrug into a fix.
#   not attempted  no install has run — either deferred on purpose, or untouched.
# One file per fact, mirroring `is_installed`'s rule that a state is a file's
# existence and never an entry in a ledger that can drift.
#
# These live under $STATE/.modstate/<name>/ — deliberately OUTSIDE $STATE/<name>/,
# because remove_module() rm -rf's that directory to guarantee byte-identical
# rollback. A failure record kept inside it would either be destroyed by the
# rollback (losing the diagnosis) or survive it (breaking byte-identity). Outside,
# both properties hold — and `add` never writes here AT ALL, so the add/remove
# round trip stays byte-identical exactly as before. Recording a failure is
# `repair`'s job, because `repair` is the verb that owns retrying.
MODSTATE="$STATE/.modstate"
optout_file()   { printf '%s/%s/optout.json'   "$MODSTATE" "$1"; }
failure_file()  { printf '%s/%s/failure.json'  "$MODSTATE" "$1"; }
deferred_file() { printf '%s/%s/deferred.json' "$MODSTATE" "$1"; }

# An opt-out is honoured from the two places that actually HAVE a writer: this
# tool's own record (written by `optout`, cleared by `optin`) and an env switch
# the operator sets directly.
#
# There is deliberately NO third source. An earlier draft also read a home-level
# file, but nothing in this repo writes one — `grep -rn HEIMDALL_NO_MODULES` over
# install.sh and heimdall-autoupdate returns nothing. A reader for a file that is
# never written is not a feature; it is a branch that can only ever report the
# default, which reads as a working opt-out that silently is not one. When the
# install side grows a writer, this is where its reader goes.
is_opted_out() {
  local name="$1"
  [ -f "$(optout_file "$name")" ] && return 0
  case ",${HMD_MODULE_OPTOUT:-}," in *",$name,"*) return 0 ;; esac
  return 1
}

has_failed()  { [ -f "$(failure_file "$1")" ]; }
is_deferred() { [ -f "$(deferred_file "$1")" ]; }

# The waiver a module DECLARES, read from its manifest — as distinct from the
# waiver a receipt RECORDS, which only exists once something is installed. Both
# surfaces are needed and they answer different questions: the receipt answers
# "was I asked?", this answers "will I be asked?". A reader deciding whether to
# accept a module is asking the second one, and on a fresh machine the receipt
# does not exist yet — so a waiver visible only in the receipt would be visible
# only after it had already been applied, which is not disclosure at all.
# Prints a JSON object, or the literal `null` when no waiver is declared.
declared_waiver_json() {
  local mf out="null"
  mf="$(manifest_path "$1")"
  if [ -f "$mf" ]; then
    out="$(jq -c 'if (.consent_waived // false) == true
                  then {waived:true,
                        reason:(.consent_waived_reason // ""),
                        declared_in:"module manifest (`consent_waived`)",
                        disclosure_still_shown:true,
                        scope:"this module only — the class contract is unmodified"}
                  else null end' "$mf" 2>/dev/null || printf 'null')"
  fi
  [ -n "$out" ] || out="null"
  printf '%s' "$out"
}

# The one question every caller asks: which state is this module in? Prints
# exactly one of: installed | opted-out | failed | deferred | not-attempted
module_state() {
  local name="$1"
  is_opted_out "$name" && { printf 'opted-out'; return 0; }
  is_installed "$name" && { printf 'installed'; return 0; }
  has_failed   "$name" && { printf 'failed';    return 0; }
  is_deferred  "$name" && { printf 'deferred';  return 0; }
  printf 'not-attempted'
}

# Write a side-record, creating only what is needed. Best-effort BY CONTRACT: a
# state root we cannot write is not a reason to fail the caller — the module is
# optional and hmd must keep working without it.
write_modstate() {
  local name="$1" file="$2" json="$3"
  mkdir -p "$MODSTATE/$name" 2>/dev/null || return 0
  printf '%s\n' "$json" > "$file" 2>/dev/null || true
}

# Clear a side-record and prune the per-module dir if it is now empty, so a
# resolved failure leaves nothing that still reads like an unresolved one.
clear_modstate() {
  local name="$1" file="$2"
  rm -f "$file" 2>/dev/null || true
  rmdir "$MODSTATE/$name" 2>/dev/null || true
  rmdir "$MODSTATE" 2>/dev/null || true
}

# Record a failure with the STAGE that failed and a retry clock. The clock is
# what stops a permanently-broken module re-attempting on every single `hmd
# update` — a retry storm is how a background repair becomes noise.
record_failure() {
  local name="$1" stage="$2" detail="$3"
  local prior=0
  [ -f "$(failure_file "$name")" ] \
    && prior="$(jq -r '.attempts // 0' "$(failure_file "$name")" 2>/dev/null || echo 0)"
  case "$prior" in ''|*[!0-9]*) prior=0 ;; esac
  write_modstate "$name" "$(failure_file "$name")" "$(jq -n \
    --arg s "$stage" --arg d "$detail" --arg at "$(now_iso)" \
    --argjson n "$((prior+1))" --argjson epoch "$(date +%s 2>/dev/null || echo 0)" \
    '{stage:$s, detail:$d, failed_at:$at, attempts:$n, last_attempt_epoch:$epoch}')"
}

installed_names() {
  [ -d "$STATE" ] || return 0
  local d
  for d in "$STATE"/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"; d="${d##*/}"
    is_installed "$d" && printf '%s\n' "$d"
  done
}

registry_names() {
  [ -d "$REGISTRY" ] || return 0
  local d n
  for d in "$REGISTRY"/*/; do
    [ -d "$d" ] || continue
    n="${d%/}"; n="${n##*/}"
    [ "$n" = "_classes" ] && continue
    [ -f "$d/manifest.json" ] && printf '%s\n' "$n"
  done
}

available_classes() {
  [ -d "$CLASS_DIR" ] || return 0
  local f n
  for f in "$CLASS_DIR"/*.json; do
    [ -f "$f" ] || continue
    n="${f##*/}"; printf '%s\n' "${n%.json}"
  done
}

# ── Step 1: VALIDATE ─────────────────────────────────────────────────────────
# Pure schema + pin + tier checks over the manifest. Read-only: a manifest that
# fails here has mutated nothing, because nothing has been created yet.
# Emits every problem it finds, not just the first — a manifest author should
# need one run to fix the file, not six.
VALIDATE_ERRORS=""
verr() { VALIDATE_ERRORS="${VALIDATE_ERRORS}  - $1
"; }

validate_manifest() {
  local name="$1" mf="$2"
  VALIDATE_ERRORS=""

  jq -e . "$mf" >/dev/null 2>&1 || { verr "manifest is not valid JSON"; return 1; }

  local v
  local field
  for field in name description upstream license tier; do
    v="$(jq -r --arg f "$field" '.[$f] // "" | if type=="string" then . else "" end' "$mf")"
    [ -n "$v" ] || verr "missing or non-string required field: \`$field\`"
  done

  # permission_class is a STRING or a NON-EMPTY ARRAY of strings. A module can sit
  # in more than one class at once — a context proxy that also stores what it
  # compressed is genuinely both a traffic-proxy and a storage-codec — and each
  # class it claims contributes its own invariants. Modelling only the first would
  # silently skip the second class's checks, which is the same as not declaring it.
  if ! jq -e '(.permission_class | type) as $t
              | ($t == "string" and (.permission_class | length) > 0)
                or ($t == "array" and (.permission_class | length) > 0
                    and all(.permission_class[]; type == "string" and length > 0))' \
       "$mf" >/dev/null 2>&1; then
    verr "missing or invalid \`permission_class\` — expected a non-empty string, or a non-empty array of strings for a module that sits in several classes at once"
  fi

  # default_included — a DISTRIBUTION fact (does this ship in hmd's default module
  # set), deliberately NOT a tier. `tier` is an EVIDENCE claim and `suggested`
  # means a green pre-registered A/B exists; shipping something by default is a
  # packaging decision that proves nothing about whether it helps. Conflating them
  # would let a distribution choice launder itself into an evidence claim.
  if jq -e 'has("default_included")' "$mf" >/dev/null 2>&1; then
    jq -e '.default_included | type == "boolean"' "$mf" >/dev/null 2>&1 \
      || verr "\`default_included\` must be a boolean (a distribution fact, separate from \`tier\`, which is an evidence claim)"
  fi

  # consent_waived — a PER-MODULE waiver of the consent QUESTION. Never of the
  # disclosure, never of the class invariants, never of reversibility.
  #
  # WHY IT LIVES HERE AND NOT ON THE CLASS. The one-word alternative is to set
  # `consent_required: false` in modules/_classes/<class>.json, and it is wrong by
  # a wide margin: that field governs the CLASS, so flipping it disarms consent for
  # every module of that class hmd ever ships, permanently, including ones nobody
  # has written yet. A distribution decision about ONE module is recorded on that
  # one module, so the blast radius is exactly the thing that was decided.
  #
  # AND IT MUST SAY WHY. A silent waiver is indistinguishable from a bug, and the
  # reader who finds it later has no way to tell whether it was chosen or leaked
  # in. So an unexplained waiver is REFUSED here rather than honoured quietly —
  # the declaration is the whole reason a waiver is defensible at all.
  if jq -e 'has("consent_waived")' "$mf" >/dev/null 2>&1; then
    if ! jq -e '.consent_waived | type == "boolean"' "$mf" >/dev/null 2>&1; then
      verr "\`consent_waived\` must be a boolean — a waiver is never inferred from a truthy string"
    elif [ "$(jq -r '.consent_waived' "$mf")" = "true" ]; then
      v="$(jq -r '.consent_waived_reason // "" | if type=="string" then . else "" end' "$mf")"
      [ -n "$v" ] \
        || verr "\`consent_waived\` is true but \`consent_waived_reason\` is missing — a waiver that does not say why is indistinguishable from a mistake, and the reason is what a reviewer needs most"
      v="$(jq -r '.consent_text // "" | if type=="string" then . else "" end' "$mf")"
      [ -n "$v" ] \
        || verr "\`consent_waived\` is true but the manifest ships no \`consent_text\` — a waiver removes the QUESTION, never the DISCLOSURE. The operator is still told what is being installed."
    fi
  fi

  v="$(jq -r '.name // ""' "$mf")"
  [ -z "$v" ] || [ "$v" = "$name" ] || verr "\`name\` is \"$v\" but the module directory is \"$name\" — they must match"

  # Pins, not latest.
  jq -e '.pinned_version | type == "object"' "$mf" >/dev/null 2>&1 \
    || verr "missing \`pinned_version\` object (a module is installed at a PIN; there is no latest)"
  for field in version artifact artifact_sha256; do
    v="$(jq -r --arg f "$field" '.pinned_version[$f] // "" | if type=="string" then . else "" end' "$mf" 2>/dev/null || echo "")"
    [ -n "$v" ] || verr "missing or non-string \`pinned_version.$field\`"
  done
  v="$(jq -r '.pinned_version.artifact_sha256 // ""' "$mf" 2>/dev/null || echo "")"
  if [ -n "$v" ]; then
    case "$v" in
      *[!0-9a-f]*|"") verr "\`pinned_version.artifact_sha256\` must be lowercase hex" ;;
      *) [ "${#v}" -eq 64 ] || verr "\`pinned_version.artifact_sha256\` must be 64 hex chars (got ${#v})" ;;
    esac
  fi

  # installs_via
  v="$(jq -r '.installs_via.kind // ""' "$mf" 2>/dev/null || echo "")"
  case "$v" in
    local)
      local ap
      ap="$(jq -r '.installs_via.artifact_path // ""' "$mf")"
      [ -n "$ap" ] || verr "\`installs_via.kind\` is \"local\" so \`installs_via.artifact_path\` is required" ;;
    upstream)
      v="$(jq -r '.installs_via.fetch // ""' "$mf")"
      [ -n "$v" ] || verr "\`installs_via.kind\` is \"upstream\" so \`installs_via.fetch\` (the operator's fetch command) is required" ;;
    "") verr "missing \`installs_via.kind\` (expected \"local\" or \"upstream\")" ;;
    *)  verr "unknown \`installs_via.kind\`: \"$v\" (expected \"local\" or \"upstream\")" ;;
  esac

  # wires — an array of {kind,target}. Empty is allowed and reported honestly as
  # an inert module; malformed is not.
  if jq -e '.wires | type == "array"' "$mf" >/dev/null 2>&1; then
    v="$(jq -r '[.wires[] | select((.kind // "") == "" or (.target // "") == "")] | length' "$mf")"
    [ "$v" = "0" ] || verr "every entry in \`wires\` needs a non-empty \`kind\` and \`target\` ($v malformed)"
  else
    verr "missing \`wires\` array"
  fi

  jq -e '.invariants | type == "object"' "$mf" >/dev/null 2>&1 \
    || verr "missing \`invariants\` object (may be empty, but the key must exist)"

  # Tier. `suggested` is a claim about evidence, so it must carry the evidence.
  v="$(jq -r '.tier // ""' "$mf")"
  case "$v" in
    available) : ;;
    suggested)
      jq -e '(.tier_evidence | type == "object") and ((.tier_evidence.receipt // "") != "")' "$mf" >/dev/null 2>&1 \
        || verr "tier \"suggested\" requires \`tier_evidence.receipt\` — a green pre-registered A/B or equivalent receipt. A recommendation without evidence is an advertisement." ;;
    "") : ;;
    *) verr "unknown \`tier\`: \"$v\" (expected \"available\" or \"suggested\")" ;;
  esac

  [ -z "$VALIDATE_ERRORS" ]
}

# ── Step 2: CLASS CONTRACT ───────────────────────────────────────────────────
# permission_class must name a real contract. Missing or invalid is REFUSED,
# never defaulted: silently choosing a class for a module is choosing its
# security posture for it.
# A module may claim SEVERAL classes. Every class it claims is resolved and every
# one of them contributes its invariants — the union is enforced, never the first
# match. Dropping a class would drop that class's checks silently, so an unknown
# or duplicated entry is refused outright rather than skipped.
CLASS_FILES=""   # newline-separated contract paths, in manifest order
CLASS_NAMES=""   # newline-separated class names, in manifest order
CLASS_JOINED=""  # "traffic-proxy + storage-codec" — for receipts and display

# The declared classes, one per line. Normalises the string and array forms so
# every caller downstream sees a list.
manifest_classes() {
  jq -r 'if (.permission_class | type) == "array" then .permission_class[]
         else (.permission_class // empty) end
         | select(type == "string" and . != "")' "$1" 2>/dev/null
}

resolve_classes() {
  local mf="$1" pc cf declared list seen=""
  CLASS_FILES=""; CLASS_NAMES=""; CLASS_JOINED=""

  list="$(manifest_classes "$mf")"
  if [ -z "$list" ]; then
    warn "refused: manifest declares no \`permission_class\`."
    warn "  A permission class is never defaulted — it decides consent and which"
    warn "  invariants are enforced. Declare one of: $(available_classes | tr '\n' ' ')"
    return 1
  fi

  while IFS= read -r pc; do
    [ -n "$pc" ] || continue
    case " $seen " in
      *" $pc "*)
        warn "refused: \`permission_class\` lists \"$pc\" more than once."
        return 1 ;;
    esac
    seen="$seen $pc"

    cf="$(class_path "$pc")"
    if [ ! -f "$cf" ]; then
      warn "refused: unknown \`permission_class\`: \"$pc\""
      warn "  No contract at ${cf#"$PLUGIN_DIR"/}. Valid classes: $(available_classes | tr '\n' ' ')"
      return 1
    fi
    if ! jq -e . "$cf" >/dev/null 2>&1; then
      warn "refused: class contract is not valid JSON: ${cf#"$PLUGIN_DIR"/}"
      return 1
    fi
    declared="$(jq -r '.class // ""' "$cf")"
    if [ "$declared" != "$pc" ]; then
      warn "refused: class contract ${cf#"$PLUGIN_DIR"/} declares class \"$declared\", not \"$pc\""
      return 1
    fi
    if ! jq -e '.requires_invariants | type == "array"' "$cf" >/dev/null 2>&1; then
      warn "refused: class contract \"$pc\" has no \`requires_invariants\` array"
      return 1
    fi

    CLASS_FILES="${CLASS_FILES}${cf}
"
    CLASS_NAMES="${CLASS_NAMES}${pc}
"
    [ -z "$CLASS_JOINED" ] && CLASS_JOINED="$pc" || CLASS_JOINED="$CLASS_JOINED + $pc"
  done <<< "$list"
  return 0
}

# Every invariant the class requires must be satisfiable. A `manifest`-kind
# invariant with no command in the manifest is a HOLE, and a hole in a class
# contract is exactly the thing this system exists to refuse.
check_invariant_coverage() {
  local mf="$1" missing="" id kind cmd cf pc
  while IFS= read -r cf; do
    [ -n "$cf" ] || continue
    pc="$(jq -r '.class' "$cf")"
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      kind="$(jq -r --arg i "$id" '.requires_invariants[] | select(.id == $i) | .check.kind // ""' "$cf")"
      case "$kind" in
        suite)
          cmd="$(jq -r --arg i "$id" '.requires_invariants[] | select(.id == $i) | .check.command // ""' "$cf")"
          [ -n "$cmd" ] || missing="${missing} ${pc}/${id}(class-contract-has-no-command)" ;;
        manifest)
          cmd="$(jq -r --arg i "$id" '.invariants[$i].command // ""' "$mf")"
          [ -n "$cmd" ] || missing="${missing} ${pc}/${id}" ;;
        *)
          missing="${missing} ${pc}/${id}(unknown-check-kind:${kind:-none})" ;;
      esac
    done <<< "$(jq -r '.requires_invariants[].id // empty' "$cf")"
  done <<< "$CLASS_FILES"

  if [ -n "$missing" ]; then
    warn "refused: manifest does not cover every invariant its class requires."
    warn "  classes: $CLASS_JOINED"
    warn "  uncovered:$missing"
    warn "  Each needs a runnable command under \`invariants.<id>.command\`."
    warn "  Nothing was installed and nothing was wired."
    return 1
  fi
  return 0
}

# A default-included module reaches EVERY machine that installs hmd, so a hole in
# its disclosure is not a per-operator problem — it is a fleet-wide one. If any
# class it claims requires consent, the disclosure text must exist at VALIDATE
# time, not merely at the moment of a prompt somebody might never see.
check_default_included() {
  local mf="$1" cf
  [ "$(jq -r '.default_included // false' "$mf")" = "true" ] || return 0
  while IFS= read -r cf; do
    [ -n "$cf" ] || continue
    [ "$(jq -r '.consent_required // false' "$cf")" = "true" ] || continue
    if [ -z "$(jq -r '.consent_text // ""' "$mf")" ]; then
      warn "refused: \`default_included\` is true and class \"$(jq -r '.class' "$cf")\" requires consent,"
      warn "  but the manifest ships no \`consent_text\`. A module in the default set"
      warn "  reaches every machine, so its disclosure must exist before it ships —"
      warn "  not at a prompt an operator may never be shown."
      return 1
    fi
  done <<< "$CLASS_FILES"
  return 0
}

# ── Step 3: CONSENT ──────────────────────────────────────────────────────────
# Read-only. A class that requires consent gets it explicitly or the add stops
# here, before a single byte is written.
CONSENT_JSON="null"
obtain_consent() {
  local name="$1" mf="$2"
  local required="false" text cf pc consenting="" rationales=""
  # Consent is the UNION across the declared classes: if any one of them requires
  # it, it is required. The strictest class wins, because a module that is both a
  # storage codec and a traffic proxy still intercepts traffic.
  while IFS= read -r cf; do
    [ -n "$cf" ] || continue
    [ "$(jq -r '.consent_required // false' "$cf")" = "true" ] || continue
    required="true"
    pc="$(jq -r '.class' "$cf")"
    [ -z "$consenting" ] && consenting="$pc" || consenting="$consenting + $pc"
    rationales="${rationales}  ${pc}: $(jq -r '.consent_rationale // "This class can change behaviour you own."' "$cf")
"
  done <<< "$CLASS_FILES"

  if [ "$required" != "true" ]; then
    CONSENT_JSON="$(jq -n --arg c "$CLASS_JOINED" \
      '{required:false, note:("no declared class requires consent (" + $c + ")")}')"
    return 0
  fi

  text="$(jq -r '.consent_text // ""' "$mf")"
  if [ -z "$text" ]; then
    warn "refused: class \"$consenting\" requires consent, but the manifest ships no \`consent_text\`."
    warn "  An operator cannot agree to a blank prompt."
    return 1
  fi

  # A WAIVER removes the QUESTION, never the DISCLOSURE. The text below is
  # printed either way — a waived operator is TOLD what is happening and why they
  # were not asked; they simply are not asked. Deleting the disclosure instead is
  # the version of this that would actually be indefensible.
  local waived="false" waived_reason=""
  if [ "$(jq -r '.consent_waived // false' "$mf")" = "true" ]; then
    waived="true"
    waived_reason="$(jq -r '.consent_waived_reason // ""' "$mf")"
  fi

  if [ "$waived" = "true" ]; then
    printf '\n  Module "%s" is class %s, which requires consent — WAIVED for this module.\n\n' \
      "$name" "$consenting"
  else
    printf '\n  Module "%s" is class %s, which requires your consent.\n\n' \
      "$name" "$consenting"
  fi
  printf '%s\n' "$rationales"
  printf '  %s\n\n' "$text"

  if [ "$waived" = "true" ]; then
    printf '  CONSENT WAIVED — this is disclosure, not a question.\n'
    printf '  Declared in this module'"'"'s own manifest (`consent_waived`), NOT in the\n'
    printf '  class contract: class %s still requires consent from every OTHER\n' "$consenting"
    printf '  module that claims it. The waiver covers "%s" alone.\n\n' "$name"
    printf '    why: %s\n\n' "$waived_reason"
    printf '  Waived here is the QUESTION only. The class invariants below still run\n'
    printf '  with the module active, and `hmd modules remove %s` still returns the\n' "$name"
    printf '  tree byte-identically. Decline it outright: hmd modules optout %s\n\n' "$name"
    CONSENT_JSON="$(jq -n \
      --arg t "$(now_iso)" --arg h "$(sha256_string "$text")" --arg text "$text" \
      --arg r "$waived_reason" --arg c "$consenting" \
      '{required:true, waived:true, granted:true, granted_via:"manifest-waiver",
        granted_at:$t, waived_reason:$r,
        waived_by:"module manifest (`consent_waived`)",
        consent_required_by:$c,
        note:"The class contract still requires consent. This module carries an explicit per-module waiver, so the disclosure was SHOWN and the question was NOT asked. Deleting `consent_waived` from the manifest restores the prompt; the class contract was never modified.",
        consent_text:$text, consent_text_sha256:$h}')"
    return 0
  fi

  local granted_via=""
  if [ "$ASSUME_YES" -eq 1 ]; then
    printf '  Consent granted via --yes.\n\n'
    granted_via="--yes"
  else
    local reply=""
    # Ask only when stdin is a terminal. A piped or CI invocation is REFUSED
    # rather than prompted: reading /dev/tty behind a pipe would seize a
    # terminal the caller did not offer, and defaulting to yes would install a
    # consent-required module nobody agreed to. Refusing is the safe read of
    # an ambiguous situation.
    if [ -t 0 ]; then
      printf '  Install it? [y/N] '
      IFS= read -r reply || reply=""
      printf '\n'
    else
      warn "refused: consent is required and stdin is not a terminal."
      warn "  Re-run with --yes if you are the operator and you agree."
      return 1
    fi
    case "$reply" in
      y|Y|yes|YES|Yes) granted_via="interactive" ;;
      *) warn "refused: consent declined. Nothing was installed."; return 1 ;;
    esac
  fi

  CONSENT_JSON="$(jq -n \
    --arg via "$granted_via" --arg t "$(now_iso)" \
    --arg h "$(sha256_string "$text")" --arg text "$text" \
    '{required:true, granted:true, granted_via:$via, granted_at:$t,
      consent_text:$text, consent_text_sha256:$h}')"
  return 0
}

# ── Removal: the ONE path ────────────────────────────────────────────────────
# add's rollback and `remove` call this same function, which is what makes a
# rejected module and a removed module byte-identical outcomes. It reads the
# receipt for the marker this tool wrote, so it can also unwind directories the
# tool created — leaving a directory behind is residue, and residue fails the
# round-trip falsifier.
STATE_MARKER=".hmd-created"

remove_module() {
  local name="$1" mdir="$STATE/$name"
  [ -d "$mdir" ] || return 0
  rm -rf "$mdir" || { warn "error: could not remove $mdir"; return 1; }

  # Prune directories this tool created, deepest first, stopping at the topmost
  # one the marker records. Anything that pre-existed the add is never touched.
  [ -f "$STATE/$STATE_MARKER" ] || return 0
  local remaining
  remaining="$(ls -A "$STATE" 2>/dev/null | grep -v "^${STATE_MARKER}\$" | head -1)"
  [ -z "$remaining" ] || return 0

  local topmost dir
  topmost="$(head -1 "$STATE/$STATE_MARKER" 2>/dev/null || true)"
  rm -f "$STATE/$STATE_MARKER"
  dir="$STATE"
  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    rmdir "$dir" 2>/dev/null || break
    [ "$dir" = "$topmost" ] && break
    dir="$(dirname "$dir")"
  done
  return 0
}

# ── Step 4: INSTALL + DIGEST-VERIFY ──────────────────────────────────────────
# The first mutating step. Creates the state root if it is absent and records
# the topmost directory it created, so removal can unwind exactly that much.
DIGEST_JSON="null"
install_module() {
  local name="$1" mf="$2" mdir="$STATE/$name"

  if [ ! -d "$STATE" ]; then
    # Find the topmost non-existent ancestor so removal knows where to stop.
    local probe topmost="$STATE"
    probe="$(dirname "$STATE")"
    while [ ! -d "$probe" ] && [ "$probe" != "/" ] && [ "$probe" != "." ]; do
      topmost="$probe"; probe="$(dirname "$probe")"
    done
    mkdir -p "$STATE" || { warn "error: cannot create state root $STATE"; return 1; }
    printf '%s\n' "$topmost" > "$STATE/$STATE_MARKER"
  fi

  mkdir -p "$mdir" || { warn "error: cannot create $mdir"; return 1; }

  # Digest-verify. A local artifact is hashed and compared to the pin; a
  # mismatch is a REFUSAL. An upstream module is depended on, not cloned, so
  # there is nothing on disk to hash at add time — that is recorded as
  # DEFERRED rather than reported as verified. Claiming a check that did not
  # run is the one thing worse than not running it.
  local kind pinned actual apath
  kind="$(jq -r '.installs_via.kind' "$mf")"
  pinned="$(jq -r '.pinned_version.artifact_sha256' "$mf")"

  if [ "$kind" = "local" ]; then
    apath="$(jq -r '.installs_via.artifact_path' "$mf")"
    case "$apath" in
      /*) : ;;
      *) apath="$REGISTRY/$name/$apath" ;;
    esac
    if [ ! -f "$apath" ]; then
      warn "refused: pinned artifact not found at ${apath#"$PLUGIN_DIR"/}"
      warn "  \`installs_via.kind\` is \"local\", so the artifact must ship with the manifest."
      return 1
    fi
    actual="$(sha256_file "$apath")"
    if [ "$actual" != "$pinned" ]; then
      warn "refused: artifact digest MISMATCH — the pin does not describe this file."
      warn "  artifact: ${apath#"$PLUGIN_DIR"/}"
      warn "  pinned:   $pinned"
      warn "  actual:   $actual"
      return 1
    fi
    DIGEST_JSON="$(jq -n --arg s "$actual" --arg p "${apath#"$PLUGIN_DIR"/}" \
      '{status:"verified", sha256:$s, artifact:$p,
        note:"artifact hashed at install and matched the manifest pin"}')"
  else
    DIGEST_JSON="$(jq -n --arg p "$pinned" --arg f "$(jq -r '.installs_via.fetch' "$mf")" \
      '{status:"deferred-upstream", pinned_sha256:$p, fetch:$f,
        note:"upstream dependency — depend, do not clone. Nothing is vendored at add time, so no artifact existed to hash. The pin is RECORDED and re-checked by `verify` once the artifact is present; it is NOT reported as verified."}')"
  fi

  jq -n \
    --arg name "$name" \
    --arg version "$(jq -r '.pinned_version.version' "$mf")" \
    --arg artifact "$(jq -r '.pinned_version.artifact' "$mf")" \
    --arg class "$CLASS_JOINED" \
    --argjson classes "$(printf '%s' "$CLASS_NAMES" | jq -R -s 'split("\n") | map(select(. != ""))')" \
    --arg tier "$(jq -r '.tier // "available"' "$mf")" \
    --argjson default_included "$(jq -r '.default_included // false' "$mf")" \
    --arg at "$(now_iso)" \
    --arg mfsha "$(sha256_file "$mf")" \
    --argjson digest "$DIGEST_JSON" \
    --argjson consent "$CONSENT_JSON" \
    '{name:$name, pinned_version:{version:$version, artifact:$artifact},
      permission_class:$class, permission_classes:$classes,
      tier:$tier, default_included:$default_included, installed_at:$at,
      manifest_sha256:$mfsha, digest:$digest, consent:$consent}' \
    > "$mdir/receipt.json" || { warn "error: cannot write receipt"; return 1; }
  return 0
}

# ── Step 5: WIRE ─────────────────────────────────────────────────────────────
# Wiring is what makes a module ACTIVE. It is recorded before invariants run,
# by design: the class contracts assert behaviour "with the module active", so
# the invariants must execute against a wired module or they prove nothing.
wire_module() {
  local name="$1" mf="$2" mdir="$STATE/$name"
  jq --arg at "$(now_iso)" \
     '{wired_at:$at, targets:(.wires // []),
       note:"wiring precedes invariant verification so every invariant runs with the module active"}' \
     "$mf" > "$mdir/wired.json" || { warn "error: cannot write wiring record"; return 1; }
  return 0
}

# ── Step 6: INVARIANTS ───────────────────────────────────────────────────────
# Discovered from the class contract, never hardcoded. Any failure returns
# non-zero and the caller unwinds through remove_module().
INVARIANT_RESULTS="[]"
run_invariants() {
  local name="$1" mf="$2"
  local results="[]" failed=0
  local id kind cmd expect expect_exit secs source desc pass cf pc

  # Every declared class contributes its invariants, and each result carries the
  # class that demanded it. Two classes asking for the same guarantee run twice
  # and are reported twice, on purpose: the receipt has to show which contract
  # each green belongs to, or dropping a class later would go unnoticed.
  while IFS= read -r cf; do
    [ -n "$cf" ] || continue
    pc="$(jq -r '.class' "$cf")"
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    kind="$(jq -r --arg i "$id" '.requires_invariants[] | select(.id == $i) | .check.kind // ""' "$cf")"
    desc="$(jq -r --arg i "$id" '.requires_invariants[] | select(.id == $i) | .description // ""' "$cf")"
    if [ "$kind" = "suite" ]; then
      source="class-contract"
      cmd="$(jq -r --arg i "$id" '.requires_invariants[] | select(.id == $i) | .check.command // ""' "$cf")"
      expect="$(jq -r --arg i "$id" '.requires_invariants[] | select(.id == $i) | .check.expect // ""' "$cf")"
      expect_exit="$(jq -r --arg i "$id" '.requires_invariants[] | select(.id == $i) | .check.expect_exit // 0' "$cf")"
      secs="$(jq -r --arg i "$id" '.requires_invariants[] | select(.id == $i) | .check.timeout_sec // 600' "$cf")"
    else
      source="manifest"
      cmd="$(jq -r --arg i "$id" '.invariants[$i].command // ""' "$mf")"
      expect="$(jq -r --arg i "$id" '.invariants[$i].expect // ""' "$mf")"
      expect_exit="$(jq -r --arg i "$id" '.invariants[$i].expect_exit // 0' "$mf")"
      secs="$(jq -r --arg i "$id" '.invariants[$i].timeout_sec // 600' "$mf")"
    fi

    capture "$cmd" "$secs"
    pass=1
    local reason=""
    if [ "$CAP_RC" != "$expect_exit" ]; then
      pass=0; reason="exit $CAP_RC, expected $expect_exit"
    elif [ -n "$expect" ] && ! printf '%s' "$CAP_OUT" | grep -qF -- "$expect"; then
      pass=0; reason="output did not contain the expected marker: \"$expect\""
    fi
    [ "$pass" -eq 1 ] || failed=$((failed+1))

    if [ "$AS_JSON" -eq 0 ]; then
      if [ "$pass" -eq 1 ]; then
        printf '    \033[32mPASS\033[0m %s (%s · %s)\n' "$id" "$pc" "$source"
      else
        printf '    \033[31mFAIL\033[0m %s (%s · %s) — %s\n' "$id" "$pc" "$source" "$reason"
      fi
    fi

    results="$(jq -n --argjson acc "$results" \
      --arg id "$id" --arg src "$source" --arg cmd "$cmd" --arg desc "$desc" \
      --arg class "$pc" \
      --argjson ok "$pass" --arg reason "$reason" \
      --arg out "$(printf '%s' "$CAP_OUT" | tail -20)" \
      '$acc + [{id:$id, class:$class, source:$src, command:$cmd, description:$desc,
                passed:($ok == 1), reason:$reason, output_tail:$out}]')"
  done <<< "$(jq -r '.requires_invariants[].id // empty' "$cf")"
  done <<< "$CLASS_FILES"

  INVARIANT_RESULTS="$results"
  [ "$failed" -eq 0 ]
}

# ═════════════════════════════════════════════════════════════════════════════
#  Commands
# ═════════════════════════════════════════════════════════════════════════════

cmd_list() {
  local inst avail
  inst="$(installed_names)"
  avail="$(registry_names)"

  if [ "$AS_JSON" -eq 1 ]; then
    local arr="[]" n
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      arr="$(jq -n --argjson acc "$arr" --slurpfile r "$STATE/$n/receipt.json" \
        --argjson wired "$([ -f "$STATE/$n/wired.json" ] && echo true || echo false)" \
        '$acc + [$r[0] + {wired:$wired}]')"
    done <<< "$inst"
    local av="[]"
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      av="$(jq -n --argjson acc "$av" --arg n "$n" --slurpfile m "$(manifest_path "$n")" \
        '$acc + [{name:$n,
                  description:($m[0].description // ""),
                  permission_class:($m[0].permission_class // null),
                  tier:($m[0].tier // "available"),
                  pinned_version:($m[0].pinned_version.version // null)}]')"
    done <<< "$avail"
    jq -n --argjson installed "$arr" --argjson available "$av" \
      --arg registry "${REGISTRY#"$PLUGIN_DIR"/}" \
      '{tool:"heimdall-modules", registry:$registry,
        installed_count:($installed|length), installed:$installed,
        available_count:($available|length), available:$available}'
    return 0
  fi

  printf '\n  Heimdall modules\n\n'
  if [ -z "$inst" ]; then
    # An honest empty state. Not an error, and never a fake entry: the base
    # install ships the system and zero module payloads, so this IS the
    # expected reading on a fresh machine.
    printf '  Installed: none.\n'
    printf '  The base install ships the module system and no module payloads.\n'
  else
    printf '  Installed:\n'
    local n
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      printf '    %-24s %-14s %-13s %s\n' \
        "$n" \
        "$(jq -r '.pinned_version.version' "$STATE/$n/receipt.json")" \
        "$(jq -r '.permission_class' "$STATE/$n/receipt.json")" \
        "$([ -f "$STATE/$n/wired.json" ] && echo wired || echo 'NOT WIRED')"
    done <<< "$inst"
  fi
  printf '\n'
  if [ -z "$avail" ]; then
    printf '  Available in the registry: none.\n'
  else
    printf '  Available in the registry (%s):\n' "$(printf '%s\n' "$avail" | grep -c .)"
    local n
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      printf '    %-24s %-11s %s\n' \
        "$n" \
        "$(jq -r '.tier // "available"' "$(manifest_path "$n")")" \
        "$(jq -r '.description // ""' "$(manifest_path "$n")")"
    done <<< "$avail"
  fi
  printf '\n  hmd modules add <name>    install at the manifest pin\n\n'
}

cmd_add() {
  local name="$1"
  [ -n "$name" ] || die "add needs a module name"
  local mf; mf="$(manifest_path "$name")"
  [ -f "$mf" ] || { warn "error: no manifest for \"$name\" at ${mf#"$PLUGIN_DIR"/}"; exit 2; }

  if is_installed "$name"; then
    warn "\"$name\" is already installed. Use \`update $name\` or \`remove $name\`."
    exit 1
  fi

  printf '\n  Adding module "%s"\n\n' "$name"

  # 1. VALIDATE (read-only)
  printf '  [1/7] validate\n'
  if ! validate_manifest "$name" "$mf"; then
    warn "refused: manifest failed validation. Nothing was installed."
    printf '%s' "$VALIDATE_ERRORS" >&2
    exit 1
  fi

  # 2. CLASS CONTRACT (read-only)
  printf '  [2/7] class contract\n'
  resolve_classes "$mf" || exit 1
  check_invariant_coverage "$mf" || exit 1
  check_default_included "$mf" || exit 1

  # 3. PREFLIGHT (read-only) — before consent on purpose: nobody should be asked
  #    to agree to an install that cannot happen.
  printf '  [3/7] preflight\n'
  add_preflight "$name" "$mf" || exit 1

  # 4. CONSENT (read-only)
  printf '  [4/7] consent\n'
  obtain_consent "$name" "$mf" || exit 1

  # 5. INSTALL + DIGEST-VERIFY (first mutation)
  printf '  [5/7] install + digest-verify\n'
  if ! install_module "$name" "$mf"; then
    remove_module "$name"
    warn "refused: install failed. Rolled back — no trace left."
    exit 1
  fi
  printf '        digest: %s\n' "$(printf '%s' "$DIGEST_JSON" | jq -r '.status')"

  # 6. WIRE
  printf '  [6/7] wire\n'
  if ! wire_module "$name" "$mf"; then
    remove_module "$name"
    warn "refused: wiring failed. Rolled back — no trace left."
    exit 1
  fi

  # 7. INVARIANTS — with the module installed and wired.
  printf '  [7/7] class invariants (module active)\n'
  if ! run_invariants "$name" "$mf"; then
    printf '%s' "$INVARIANT_RESULTS" | jq -r '.[] | select(.passed | not)
      | "  FAILED INVARIANT: \(.id)\n    why: \(.reason)\n    what it guarantees: \(.description)\n    command: \(.command)"' >&2
    remove_module "$name"
    warn ""
    warn "REFUSED: \"$name\" failed its class invariants and is NOT WIRED."
    warn "  Rolled back through the same removal path \`remove\` uses, so the tree"
    warn "  is byte-identical to before the add. Nothing half-installed."
    exit 1
  fi

  # Checked: an unwritable state dir here would otherwise report a successful
  # install whose invariant evidence silently does not exist.
  if ! printf '%s' "$INVARIANT_RESULTS" > "$STATE/$name/invariants.json"; then
    remove_module "$name"
    warn "refused: could not record invariant results. Rolled back — an install"
    warn "  whose evidence cannot be written is not an install."
    exit 1
  fi
  printf '\n  Installed "%s" at pin %s (class %s).\n\n' \
    "$name" "$(jq -r '.pinned_version.version' "$mf")" "$CLASS_JOINED"

  if [ "$AS_JSON" -eq 1 ]; then
    jq -n --slurpfile r "$STATE/$name/receipt.json" --argjson inv "$INVARIANT_RESULTS" \
      '{tool:"heimdall-modules", action:"add", ok:true, receipt:$r[0], invariants:$inv}'
  fi
}

cmd_remove() {
  local name="$1"
  [ -n "$name" ] || die "remove needs a module name"
  if ! is_installed "$name"; then
    if [ "$AS_JSON" -eq 1 ]; then
      jq -n --arg n "$name" '{tool:"heimdall-modules", action:"remove", ok:true,
        name:$n, note:"not installed — nothing to remove"}'
    else
      printf '\n  "%s" is not installed. Nothing to remove.\n\n' "$name"
    fi
    return 0
  fi
  remove_module "$name" || exit 1
  if [ "$AS_JSON" -eq 1 ]; then
    jq -n --arg n "$name" '{tool:"heimdall-modules", action:"remove", ok:true, name:$n,
      note:"removed totally — install dir deleted and tool-created dirs pruned"}'
  else
    printf '\n  Removed "%s". Install directory deleted; directories this tool\n' "$name"
    printf '  created were pruned. Nothing of it remains.\n\n'
  fi
}

cmd_status() {
  local name="$1"
  [ -n "$name" ] || die "status needs a module name"
  # NOT INSTALLED IS THREE DIFFERENT FACTS. "not installed" alone is the answer
  # that makes an optional module feel broken: the user cannot tell whether they
  # declined it, whether it tried and failed, or whether it simply has not run
  # yet. Each wants a different next action, so each gets its own answer — and the
  # failed one names the STAGE that failed, which is what turns a shrug into a fix.
  if ! is_installed "$name"; then
    local st; st="$(module_state "$name")"
    if [ "$AS_JSON" -eq 1 ]; then
      jq -n --arg n "$name" --arg st "$st" \
        --argjson optout "$([ -f "$(optout_file "$name")" ] && cat "$(optout_file "$name")" || echo null)" \
        --argjson failure "$([ -f "$(failure_file "$name")" ] && cat "$(failure_file "$name")" || echo null)" \
        --argjson deferred "$([ -f "$(deferred_file "$name")" ] && cat "$(deferred_file "$name")" || echo null)" \
        --argjson waiver "$(declared_waiver_json "$name")" \
        '{tool:"heimdall-modules", action:"status", name:$n, installed:false,
          state:$st, consent_waiver:$waiver,
          optout:$optout, failure:$failure, deferred:$deferred}'
      return 0
    fi
    printf '\n  %s\n\n' "$name"
    case "$st" in
      opted-out)
        printf '    state:    OPTED OUT — not installed because you declined it.\n'
        printf '    Nothing will re-install it, including `hmd update`.\n'
        printf '    Change your mind: hmd modules optin %s\n' "$name" ;;
      failed)
        printf '    state:    not installed — INSTALL FAILED at stage: %s\n' \
          "$(jq -r '.stage // "unknown"' "$(failure_file "$name")" 2>/dev/null)"
        printf '    when:     %s (attempt %s)\n' \
          "$(jq -r '.failed_at // "?"' "$(failure_file "$name")" 2>/dev/null)" \
          "$(jq -r '.attempts // "?"' "$(failure_file "$name")" 2>/dev/null)"
        printf '    why:      %s\n' \
          "$(jq -r '.detail // "no detail recorded"' "$(failure_file "$name")" 2>/dev/null)"
        printf '\n    Diagnose: hmd modules preflight %s\n' "$name"
        printf '    Retry:    hmd modules repair %s\n' "$name" ;;
      deferred)
        printf '    state:    NOT YET ATTEMPTED — not installed; deferred by design.\n'
        printf '    hmd installed fast and left this for the background; it will be\n'
        printf '    attempted on the next `hmd update`, or now with:\n'
        printf '              hmd modules repair %s\n' "$name" ;;
      *)
        printf '    state:    NOT ATTEMPTED — not installed, and no install was tried.\n'
        printf '    Install:     hmd modules add %s\n' "$name"
        printf '    Check first: hmd modules preflight %s\n' "$name" ;;
    esac
    local dw; dw="$(declared_waiver_json "$name")"
    if [ "$dw" != "null" ]; then
      printf '\n    consent:  WAIVED for this module — when it installs you will be\n'
      printf '              TOLD what it does, not asked to approve it.\n'
      printf '              why: %s\n' "$(printf '%s' "$dw" | jq -r '.reason')"
      printf '              Declared in this module'"'"'s manifest. The class contract is\n'
      printf '              unmodified, so every other module of that class still asks.\n'
      printf '              Decline it outright: hmd modules optout %s\n' "$name"
    fi
    printf '\n'
    return 0
  fi
  local d="$STATE/$name"
  if [ "$AS_JSON" -eq 1 ]; then
    jq -n --slurpfile r "$d/receipt.json" \
      --argjson wired "$([ -f "$d/wired.json" ] && cat "$d/wired.json" || echo null)" \
      --argjson inv "$([ -f "$d/invariants.json" ] && cat "$d/invariants.json" || echo null)" \
      '{tool:"heimdall-modules", action:"status", installed:true,
        receipt:$r[0], wiring:$wired, invariants:$inv}'
    return 0
  fi
  printf '\n  %s\n\n' "$name"
  jq -r '"    pin:      \(.pinned_version.version)
    class:    \(.permission_class)
    tier:     \(.tier)
    added:    \(.installed_at)
    digest:   \(.digest.status) — \(.digest.note)
    consent:  \(if (.consent.waived // false) then
                   "WAIVED for this module — disclosed, not asked, at \(.consent.granted_at)
              why:      \(.consent.waived_reason // "")
              scope:    class \(.consent.consent_required_by // "?") still requires consent from every other module"
                 elif .consent.required then "granted via \(.consent.granted_via) at \(.consent.granted_at)"
                 else "not required for this class" end)"' "$d/receipt.json"
  local ntargets
  ntargets="$(jq -r '.targets | length' "$d/wired.json" 2>/dev/null || echo 0)"
  if [ "$ntargets" = "0" ]; then
    printf '    wiring:   0 targets — the module is inert\n'
  else
    printf '    wiring:   %s target(s): %s\n' "$ntargets" \
      "$(jq -r '[.targets[] | "\(.kind):\(.target)"] | join(", ")' "$d/wired.json")"
  fi
  if [ -f "$d/invariants.json" ]; then
    printf '    invariants verified at add:\n'
    jq -r '.[] | "      \(if .passed then "PASS" else "FAIL" end) \(.id) (\(.source))"' "$d/invariants.json"
  fi
  printf '\n'
}

cmd_verify() {
  local name="$1" targets rc=0
  if [ -n "$name" ]; then
    is_installed "$name" || { warn "error: \"$name\" is not installed"; exit 2; }
    targets="$name"
  else
    targets="$(installed_names)"
  fi

  if [ -z "$targets" ]; then
    if [ "$AS_JSON" -eq 1 ]; then
      jq -n '{tool:"heimdall-modules", action:"verify", ok:true, verified:[],
        note:"no modules installed — nothing to verify"}'
    else
      printf '\n  No modules installed. Nothing to verify.\n\n'
    fi
    return 0
  fi

  local all="[]" n mf
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    mf="$(manifest_path "$n")"
    if [ ! -f "$mf" ]; then
      warn "FAIL $n — installed but its manifest is gone from the registry (${mf#"$PLUGIN_DIR"/})"
      rc=1
      all="$(jq -n --argjson acc "$all" --arg n "$n" \
        '$acc + [{name:$n, ok:false, reason:"manifest missing from registry"}]')"
      continue
    fi
    if ! resolve_classes "$mf"; then rc=1; continue; fi
    [ "$AS_JSON" -eq 1 ] || printf '\n  %s (class %s)\n' "$n" "$CLASS_JOINED"
    if run_invariants "$n" "$mf"; then
      all="$(jq -n --argjson acc "$all" --arg n "$n" --argjson inv "$INVARIANT_RESULTS" \
        '$acc + [{name:$n, ok:true, invariants:$inv}]')"
    else
      rc=1
      all="$(jq -n --argjson acc "$all" --arg n "$n" --argjson inv "$INVARIANT_RESULTS" \
        '$acc + [{name:$n, ok:false, invariants:$inv}]')"
    fi
  done <<< "$targets"

  if [ "$AS_JSON" -eq 1 ]; then
    jq -n --argjson v "$all" --argjson ok "$([ "$rc" -eq 0 ] && echo true || echo false)" \
      '{tool:"heimdall-modules", action:"verify", ok:$ok, verified:$v}'
  else
    printf '\n'
    [ "$rc" -eq 0 ] && printf '  All installed modules hold their class invariants.\n\n' \
                    || printf '  One or more modules FAILED their class invariants.\n\n'
  fi
  return "$rc"
}

cmd_update() {
  local name="$1" targets rc=0
  if [ -n "$name" ]; then
    is_installed "$name" || { warn "error: \"$name\" is not installed"; exit 2; }
    targets="$name"
  else
    targets="$(installed_names)"
  fi

  if [ -z "$targets" ]; then
    printf '\n  No modules installed. Nothing to update.\n\n'
    return 0
  fi

  local n mf have want
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    mf="$(manifest_path "$n")"
    if [ ! -f "$mf" ]; then
      warn "  $n — manifest gone from the registry; cannot update. Remove it or restore the manifest."
      rc=1; continue
    fi
    have="$(jq -r '.pinned_version.version' "$STATE/$n/receipt.json")"
    want="$(jq -r '.pinned_version.version // ""' "$mf")"
    if [ "$have" = "$want" ]; then
      printf '\n  %s is already at the pinned version %s. Nothing to do.\n' "$n" "$have"
      printf '  (There is no "latest" to move to — the pin lives in the manifest,\n'
      printf '   and a human edits and commits it.)\n\n'
      continue
    fi
    printf '\n  %s: %s -> %s (human-verified pin from the manifest)\n\n' "$n" "$have" "$want"
    # Reinstall through the full ordered pipeline so the new pin faces every
    # gate the first one did. Remove first: a partially-overwritten module is
    # exactly the residue this system refuses to create.
    remove_module "$n" || { rc=1; continue; }
    if ! ( cmd_add "$n" ); then
      warn "  update FAILED for $n at the new pin. The old install was removed first,"
      warn "  so nothing is half-updated — re-run \`add $n\` once the manifest is fixed."
      rc=1
    fi
  done <<< "$targets"
  return "$rc"
}

# ═════════════════════════════════════════════════════════════════════════════
#  Preflight, repair, and the deliberate opt-out
# ═════════════════════════════════════════════════════════════════════════════
#
# THE PROBLEM THESE SOLVE. An upstream module's install command has many more
# ways to fail than to succeed, and almost every failure surfaces as something
# that is not a diagnosis — a compiler traceback, a connect timeout, or a
# "command not found" for a binary that installed perfectly but landed off PATH.
# `preflight` converts each of those into a precondition with a named fix BEFORE
# anything is attempted; `repair` re-runs it, fixes what it can, and re-attempts
# idempotently so a partial install never needs a manual teardown.
#
# ONE MECHANISM, TWO CALLERS. `hmd update` drives this same repair path through
# the same library (bin/lib/module_preflight.sh). There is no second updater and
# no second remedy table — a fix written once is the fix everywhere.

# A big source build is legitimately slow, so the fetch budget is generous — but
# it IS a budget. An unbounded fetch is how a background repair wedges a machine.
HMD_MODULE_FETCH_TIMEOUT="${HMD_MODULE_FETCH_TIMEOUT:-1800}"

PREFLIGHT_LIB="$BIN_DIR/lib/module_preflight.sh"
load_preflight() {
  if [ ! -f "$PREFLIGHT_LIB" ]; then
    warn "error: preflight library missing at ${PREFLIGHT_LIB#"$PLUGIN_DIR"/}"
    warn "  It ships with hmd itself, so this is a damaged install — re-run the"
    warn "  hmd installer to restore it. No module verb can run without it."
    return 1
  fi
  # shellcheck source=/dev/null
  . "$PREFLIGHT_LIB" || { warn "error: preflight library could not load"; return 1; }
  return 0
}

# WHICH PREFLIGHT FAILURES BLOCK AN `add` — and why the rest do not.
#
# `add` on an upstream module is a DECLARATION, not a download. Its own digest
# step says so in as many words: "depend, do not clone. Nothing is vendored at
# add time." `add` records the pin, wires the module and runs the class
# invariants; it never runs `installs_via.fetch`. The verb that fetches is
# `repair`, and `repair` blocks on EVERY blocking check for exactly that reason.
#
# So `add` refuses on precisely the checks that would falsify what IT writes:
#   pin       the receipt would record a pin the artifact can never be proven against
#   disk      there is not room to write the receipt and its invariant evidence
#   platform  no wheel and no toolchain — the payload can never run on this box
# Every other failure is RENDERED in full, with its remedy and with the repair
# command that needs it. Refusing an add for a precondition the add never touches
# would be a FALSE refusal, and a false refusal is how a gate teaches people to
# route around it.
ADD_BLOCKING_CHECKS="pin disk platform"

# Runs preflight for `add`, prints what it found, and returns non-zero only when
# a check `add` itself depends on is failing. Read-only: nothing here mutates.
add_preflight() {
  local name="$1" mf="$2"
  load_preflight || return 1
  hmd_preflight "$name" "$mf" "$STATE"

  local blockers advisories
  blockers="$(printf '%s' "$PF_RESULTS" | jq -r --arg ids "$ADD_BLOCKING_CHECKS" \
    '($ids | split(" ")) as $b
     | .[] | select(.status == "fail") | select([.id] | inside($b))
     | "        \(.id): \(.requirement)\n          found: \(.found)\n          fix:   \(.remedy)"')"
  advisories="$(printf '%s' "$PF_RESULTS" | jq -r --arg ids "$ADD_BLOCKING_CHECKS" \
    '($ids | split(" ")) as $b
     | .[] | select(.status == "fail") | select([.id] | inside($b) | not)
     | "        \(.id): \(.found)\n          fix: \(.remedy)"')"

  if [ -n "$blockers" ]; then
    warn "refused: a precondition this install depends on is not met."
    printf '%s\n' "$blockers" >&2
    warn "  Nothing was installed and nothing was wired."
    warn "  Full report: hmd modules preflight $name"
    return 1
  fi

  if [ -n "$advisories" ]; then
    printf '        preflight: %s check(s) the PAYLOAD needs are not met yet.\n' \
      "$(printf '%s\n' "$advisories" | grep -c 'fix:')"
    printf '%s\n' "$advisories"
    printf '        The module records at its pin now; `hmd modules repair %s`\n' "$name"
    printf '        fetches the payload and requires the fixes above.\n'
  else
    printf '        preflight: every precondition met.\n'
  fi
  return 0
}

cmd_preflight() {
  local name="$1"
  [ -n "$name" ] || die "preflight needs a module name"
  load_preflight || exit 2
  local mf; mf="$(manifest_path "$name")"
  hmd_preflight "$name" "$mf" "$STATE"
  local rc=$?
  if [ "$AS_JSON" -eq 1 ]; then
    jq -n --arg n "$name" --argjson checks "$PF_RESULTS" \
      --argjson ok "$([ "$rc" -eq 0 ] && echo true || echo false)" \
      --argjson failed "$PF_FAILED" --argjson warned "$PF_WARNED" \
      --arg st "$(module_state "$name")" \
      '{tool:"heimdall-modules", action:"preflight", name:$n, ok:$ok,
        module_state:$st, blocking_failures:$failed, warnings:$warned,
        checks:$checks}'
  else
    hmd_preflight_render "$name"
  fi
  return "$rc"
}

# The ONE precondition repair can resolve on its own. Everything else needs a
# decision only the operator can make — install a toolchain, free disk, open a
# firewall — so repair NAMES those instead of guessing at them. Sets REPAIR_FIXED.
REPAIR_FIXED=0
repair_fixable() {
  local mf="$1"
  REPAIR_FIXED=0
  local fetch tool pyver
  fetch="$(jq -r '.installs_via.fetch // ""' "$mf")"
  tool="$(pf_derive_tool "$fetch")"
  pyver="$(pf_derive_python "$fetch")"
  [ -n "$pyver" ] || return 0
  [ "$tool" = "uv" ] || return 0
  # Read the preflight result rather than re-probing PATH: if the tool check did
  # not pass, the MISSING TOOL is the failure to report, not something to work
  # around — and asking a tool that is not there to fix anything is noise.
  printf '%s' "$PF_RESULTS" \
    | jq -e '.[] | select(.id == "tool" and .status == "pass")' >/dev/null 2>&1 || return 0
  printf '%s' "$PF_RESULTS" \
    | jq -e '.[] | select(.id == "python" and .status == "fail")' >/dev/null 2>&1 || return 0

  # Provisioning an interpreter is a real download, which is why it is never a
  # side effect of `preflight` or of any read path. `repair` IS the deliberate
  # act, so here it is allowed — and bounded.
  [ "$QUIET" -eq 1 ] || printf '  fixing:  provisioning python %s via uv…\n' "$pyver"
  pf_bounded "$HMD_MODULE_FETCH_TIMEOUT" "uv python install '$pyver'"
  if [ "$PF_RC" -eq 0 ]; then
    REPAIR_FIXED=1
  else
    [ "$QUIET" -eq 1 ] || warn "  could not provision python $pyver: $(printf '%s' "$PF_OUT" | tail -3)"
  fi
  return 0
}

# The repair/verify entry point. Idempotent by construction: healthy is a no-op,
# broken is rebuilt through the SAME ordered pipeline a first install faces.
cmd_repair() {
  local name="$1"
  [ -n "$name" ] || die "repair needs a module name"

  # 1. AN OPT-OUT IS FINAL. A repair that silently reinstalls what someone
  #    deliberately declined is worse than shipping no opt-out at all: it teaches
  #    the user that their choice does not stick. Checked FIRST, before any work.
  if is_opted_out "$name"; then
    if [ "$AS_JSON" -eq 1 ]; then
      jq -n --arg n "$name" '{tool:"heimdall-modules", action:"repair", ok:true,
        name:$n, state:"opted-out", changed:false,
        note:"opted out — repair honours the choice and does nothing"}'
    elif [ "$QUIET" -eq 0 ]; then
      printf '\n  "%s" is opted out. Nothing to repair — your choice stands.\n' "$name"
      printf '  Undo it with: hmd modules optin %s\n\n' "$name"
    fi
    return 0
  fi

  load_preflight || return 2
  local mf; mf="$(manifest_path "$name")"
  if [ ! -f "$mf" ]; then
    record_failure "$name" "manifest" "no manifest for \"$name\" in the registry"
    [ "$QUIET" -eq 1 ] || warn "error: no manifest for \"$name\" at ${mf#"$PLUGIN_DIR"/}"
    return 1
  fi

  # 2. ALREADY HEALTHY → a TRUE no-op. This is the property that lets `hmd
  #    update` call repair on every run: a working module costs one invariant
  #    pass, prints nothing, and re-downloads nothing.
  if is_installed "$name"; then
    if ( AS_JSON=0; cmd_verify "$name" ) >/dev/null 2>&1; then
      clear_modstate "$name" "$(failure_file "$name")"
      clear_modstate "$name" "$(deferred_file "$name")"
      if [ "$AS_JSON" -eq 1 ]; then
        jq -n --arg n "$name" '{tool:"heimdall-modules", action:"repair", ok:true,
          name:$n, state:"installed", changed:false,
          note:"already installed and holding its invariants — no work done"}'
      elif [ "$QUIET" -eq 0 ]; then
        printf '\n  "%s" is installed and holds its invariants. Nothing to repair.\n\n' "$name"
      fi
      return 0
    fi
    # Installed but FAILING its invariants — a partial install. Unwind through
    # the one removal path and re-attempt, so recovery never needs the user to
    # hand-delete anything.
    [ "$QUIET" -eq 1 ] || printf '\n  "%s" is installed but FAILS its invariants — rebuilding it.\n' "$name"
    remove_module "$name" || {
      record_failure "$name" "rollback" "could not remove the partial install at $STATE/$name"
      return 1
    }
  fi

  [ "$QUIET" -eq 1 ] || printf '\n  Repairing "%s"\n\n' "$name"

  # 3. PREFLIGHT — every precondition, each with its fix. `repair` gates on ALL
  #    of them, unlike `add`: this is the verb that actually runs the fetch.
  hmd_preflight "$name" "$mf" "$STATE"
  # 4. Fix what is fixable, then re-check so the decision is made on fresh facts.
  if [ "$PF_FAILED" -ne 0 ]; then
    repair_fixable "$mf"
    [ "$REPAIR_FIXED" -eq 1 ] && hmd_preflight "$name" "$mf" "$STATE"
  fi

  if [ "$PF_FAILED" -ne 0 ]; then
    record_failure "$name" "preflight" \
      "$PF_FAILED blocking precondition(s): $(printf '%s' "$PF_RESULTS" | jq -r '[.[] | select(.status=="fail") | .id] | join(", ")')"
    if [ "$AS_JSON" -eq 1 ]; then
      jq -n --arg n "$name" --argjson checks "$PF_RESULTS" --argjson f "$PF_FAILED" \
        '{tool:"heimdall-modules", action:"repair", ok:false, name:$n,
          state:"failed", stage:"preflight", blocking_failures:$f, checks:$checks}'
    elif [ "$QUIET" -eq 0 ]; then
      hmd_preflight_render "$name"
      printf '  Repair stopped: %s precondition(s) need you. Each fix is above.\n' "$PF_FAILED"
      printf '  Nothing was installed and hmd is unaffected.\n\n'
    fi
    return 1
  fi

  # 5. FETCH. Output is captured, not streamed, so a compiler traceback lands in
  #    the failure record where `status` can quote it — rather than scrolling
  #    past in a terminal nobody was watching.
  local fetch; fetch="$(jq -r '.installs_via.fetch // ""' "$mf")"
  if [ -n "$fetch" ] && [ "$(jq -r '.installs_via.kind // ""' "$mf")" = "upstream" ]; then
    [ "$QUIET" -eq 1 ] || printf '  fetching: %s\n' "$fetch"
    pf_bounded "$HMD_MODULE_FETCH_TIMEOUT" "$fetch"
    if [ "$PF_RC" -ne 0 ]; then
      record_failure "$name" "fetch" "$(printf '%s' "$PF_OUT" | tail -5)"
      if [ "$AS_JSON" -eq 1 ]; then
        jq -n --arg n "$name" --arg out "$(printf '%s' "$PF_OUT" | tail -5)" --argjson rc "$PF_RC" \
          '{tool:"heimdall-modules", action:"repair", ok:false, name:$n,
            state:"failed", stage:"fetch", exit_code:$rc, output_tail:$out}'
      elif [ "$QUIET" -eq 0 ]; then
        warn ""
        warn "  FETCH FAILED (exit $PF_RC). The install command did not complete:"
        warn "    $fetch"
        printf '%s\n' "$PF_OUT" | tail -5 | sed 's/^/    /' >&2
        warn ""
        warn "  hmd is unaffected — the module stays absent and \`status\` says why."
        warn "  Re-run when the cause is addressed: hmd modules repair $name"
      fi
      return 1
    fi
  fi

  # 6. The ordered pipeline. Every gate the first install would have faced.
  local addrc=0
  if [ "$QUIET" -eq 1 ]; then
    ( cmd_add "$name" ) >/dev/null 2>&1 || addrc=$?
  else
    ( cmd_add "$name" ) || addrc=$?
  fi
  if [ "$addrc" -ne 0 ]; then
    record_failure "$name" "add" "the ordered install pipeline refused the module (exit $addrc) — see \`hmd modules add $name\` for the full reason"
    [ "$QUIET" -eq 1 ] || warn "  repair could not complete the install pipeline for \"$name\"."
    return 1
  fi

  clear_modstate "$name" "$(failure_file "$name")"
  clear_modstate "$name" "$(deferred_file "$name")"
  if [ "$AS_JSON" -eq 1 ]; then
    jq -n --arg n "$name" '{tool:"heimdall-modules", action:"repair", ok:true,
      name:$n, state:"installed", changed:true, note:"repaired and installed"}'
  elif [ "$QUIET" -eq 0 ]; then
    printf '  Repaired "%s".\n\n' "$name"
  fi
  return 0
}

# Record the DEFERRED intent — the "not yet attempted" fact, stated on purpose so
# `status` can distinguish it from "we tried and it failed".
cmd_defer() {
  local name="$1"
  [ -n "$name" ] || die "defer needs a module name"
  if is_opted_out "$name"; then
    [ "$QUIET" -eq 1 ] || printf '\n  "%s" is opted out — not deferring an install nobody asked for.\n\n' "$name"
    return 0
  fi
  if is_installed "$name"; then
    [ "$QUIET" -eq 1 ] || printf '\n  "%s" is already installed. Nothing to defer.\n\n' "$name"
    return 0
  fi
  write_modstate "$name" "$(deferred_file "$name")" "$(jq -n --arg at "$(now_iso)" \
    '{deferred_at:$at,
      reason:"the install is not blocked on here; the payload is fetched in the background",
      next:"attempted by the next `hmd update`, or now with `hmd modules repair`"}')"
  if [ "$AS_JSON" -eq 1 ]; then
    jq -n --arg n "$name" '{tool:"heimdall-modules", action:"defer", ok:true,
      name:$n, state:"deferred"}'
  elif [ "$QUIET" -eq 0 ]; then
    printf '\n  "%s" install deferred — hmd is ready now; the module follows in the background.\n\n' "$name"
  fi
  return 0
}

# Names that WANT a repair attempt, one per line, and NOTHING when none do.
#
# THIS IS THE CHEAP DECISION `hmd update` makes before spending anything. It is
# deliberately a set of file-existence tests and never a preflight run: the
# healthy case must cost a stat() per module, print nothing and download nothing,
# because it runs on a schedule. Empty output means "no work" and the caller
# returns immediately.
#
# The retry backoff is what stops a permanently-broken module turning every
# session into a retry storm — a module that failed an hour ago is not retried;
# one that failed yesterday is.
HMD_MODULE_RETRY_INTERVAL="${HMD_MODULE_RETRY_INTERVAL:-86400}"
cmd_pending() {
  [ -d "$MODSTATE" ] || return 0
  local d n now epoch age
  now="$(date +%s 2>/dev/null || echo 0)"
  for d in "$MODSTATE"/*/; do
    [ -d "$d" ] || continue
    n="${d%/}"; n="${n##*/}"
    # An opt-out wins over every other record. Checked first, always.
    is_opted_out "$n" && continue
    is_installed "$n" && continue
    if has_failed "$n"; then
      epoch="$(jq -r '.last_attempt_epoch // 0' "$(failure_file "$n")" 2>/dev/null || echo 0)"
      case "$epoch" in ''|*[!0-9]*) epoch=0 ;; esac
      age=$(( now - epoch ))
      if [ "$age" -ge 0 ] && [ "$age" -lt "$HMD_MODULE_RETRY_INTERVAL" ]; then continue; fi
      printf '%s\n' "$n"
      continue
    fi
    is_deferred "$n" && printf '%s\n' "$n"
  done
  return 0
}

cmd_optout() {
  local name="$1"
  [ -n "$name" ] || die "optout needs a module name"
  write_modstate "$name" "$(optout_file "$name")" "$(jq -n --arg at "$(now_iso)" \
    '{opted_out_at:$at,
      note:"deliberate opt-out. No install path — including `hmd update` — may re-install this module."}')"
  # A pending install intent is no longer wanted; clear it so nothing acts on it.
  clear_modstate "$name" "$(deferred_file "$name")"
  if [ "$AS_JSON" -eq 1 ]; then
    jq -n --arg n "$name" '{tool:"heimdall-modules", action:"optout", ok:true,
      name:$n, state:"opted-out"}'
  elif [ "$QUIET" -eq 0 ]; then
    printf '\n  Opted out of "%s". Nothing will install it, including `hmd update`.\n' "$name"
    printf '  Undo: hmd modules optin %s\n\n' "$name"
  fi
  return 0
}

cmd_optin() {
  local name="$1"
  [ -n "$name" ] || die "optin needs a module name"
  clear_modstate "$name" "$(optout_file "$name")"
  if [ "$AS_JSON" -eq 1 ]; then
    jq -n --arg n "$name" --arg st "$(module_state "$name")" \
      '{tool:"heimdall-modules", action:"optin", ok:true, name:$n, state:$st}'
  elif [ "$QUIET" -eq 0 ]; then
    printf '\n  "%s" is no longer opted out.\n' "$name"
    printf '  Install it with: hmd modules repair %s\n\n' "$name"
  fi
  return 0
}

case "$CMD" in
  list)      cmd_list ;;
  add)       cmd_add "$TARGET" ;;
  remove)    cmd_remove "$TARGET" ;;
  status)    cmd_status "$TARGET" ;;
  verify)    cmd_verify "$TARGET" ;;
  update)    cmd_update "$TARGET" ;;
  preflight) cmd_preflight "$TARGET" ;;
  repair)    cmd_repair "$TARGET" ;;
  defer)     cmd_defer "$TARGET" ;;
  pending)   cmd_pending ;;
  optout)    cmd_optout "$TARGET" ;;
  optin)     cmd_optin "$TARGET" ;;
esac
