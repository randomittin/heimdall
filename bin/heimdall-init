#!/usr/bin/env bash
# heimdall-init — install the universal git core (Layer 0). Zero further config.
#
# CONTRACT. In ANY git repo, `hmd init` produces a working watchman with git alone
# in the loop — no Claude Code, no plugin runtime, no MCP:
#   1. Installs git hooks via `core.hooksPath=.heimdall/hooks` so a repo's own
#      user hooks are NOT clobbered — any pre-existing hooksPath/hooks is CHAINED
#      (a prior pre-commit STILL runs, first, and its failure still blocks).
#        pre-commit / pre-push : run the configured gates headless (heimdall-gate-run).
#                                DENY = nonzero + a BIFRÖST block on stderr.
#                                Escape: HMD_SKIP=1 git commit … (logs an unproven
#                                        -merge receipt — visible, never silent).
#        post-commit           : fire-and-forget presence beat (verdict = last gate
#                                result, file = the commit's top path). Never blocks.
#   2. Reuses everything: team auto-mint/auto-join, identity, presence, roster.
#      NO new server surface, NO redeploy — this is client-only.
#   3. Writes AGENTS.md — the file EVERY coding agent reads at session start
#      (Cursor, Codex, Gemini CLI, Claude Code), so the whole field becomes
#      Heimdall-aware with zero adapters. ONE fenced region between the
#      HEIMDALL:AGENTS markers says: this repo is gated, and the oracle is the
#      only path. A pre-existing AGENTS.md is NEVER clobbered — the block is
#      appended and re-init re-renders ONLY what is inside the fence.
#
# Usage:
#   heimdall-init [--force]     install (or refresh) the hooks in the current repo
#   heimdall-init --agents-only re-render ONLY the AGENTS.md fence (no hooks, no config)
#   -h, --help
#
# Exit: 0 = installed; 1 = not a git repo / IO error.
set -uo pipefail

# Resolve through symlinks so the plugin bin dir we embed into the hooks is the REAL
# location of the gate runner + presence client (works when `hmd` is a ~/.local/bin
# symlink into ~/.heimdall).
SELF="$0"
while [ -h "$SELF" ]; do
  _d="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$_d/$SELF" ;; esac
done
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"

usage() { sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; }

FORCE=""
AGENTS_ONLY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1; shift ;;
    --agents-only) AGENTS_ONLY=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "heimdall-init: unexpected argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

REPO="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO" ]; then
  echo "  hmd init: not inside a git repository. cd into a repo (or run: git init) and retry." >&2
  exit 1
fi

C='\033[38;2;0;212;255m'; G='\033[38;2;78;204;163m'; D='\033[2m'; B='\033[1m'; R='\033[0m'

# ══════════════════════════════════════════════════════════════════════════════
# AGENTS.md — make every coding agent Heimdall-aware with zero adapters.
#
# AGENTS.md is the one file Cursor, Codex, Gemini CLI and Claude Code all read at
# session start, so ONE fenced region reaches the whole field. The region is
# generated; everything outside it belongs to the repo and is passed through byte
# for byte. This mirrors the HEIMDALL:VERSION region that bin/heimdall-render-version
# manages in README.md (same marker naming, same awk substitution) — one pattern for
# generated regions in this codebase, not two.
# ══════════════════════════════════════════════════════════════════════════════
AGENTS_MD="$REPO/AGENTS.md"
AG_BEGIN='<!-- HEIMDALL:AGENTS:BEGIN — generated by `hmd init`; edits inside this fence are overwritten on re-init -->'
AG_END='<!-- HEIMDALL:AGENTS:END -->'

# The block an agent actually reads. Deliberately short: this is skimmed at session
# start, and a wall of text changes no behaviour. Quoted heredoc — the backticks and
# $-signs below are literal markdown, never shell.
render_agents_block() {
  printf '%s\n' "$AG_BEGIN"
  cat <<'AGEOF'

## Heimdall — this repo is gated

Heimdall is a watchman wired into git. Gates run from `pre-commit` and `pre-push`,
so every change here is checked whether or not an agent is in the loop.

- `hmd verdict` — the last gate result for this repo, and why.
- `hmd demo` — watch a gated build run end to end.

**A deny blocks the commit.** git exits nonzero and a `BIFRÖST` block prints on
stderr naming what failed. Read the name, fix the code, commit again. `HMD_SKIP=1
git commit …` bypasses the gate but logs an unproven-merge receipt to
`.heimdall/receipts/unproven.log` — visible, never silent.

**Gates are external and falsifiable — satisfying the oracle is the only path.**
The verdict is computed from artifacts on disk, not from your explanation, so you
cannot argue your way past a gate. Rewriting or weakening the test is not a path to
green; it is the exact failure the gate exists to catch.

AGEOF
  printf '%s\n' "$AG_END"
}

# write_agents_md — create, append, or re-render the fence. NEVER clobbers.
# Sets AGENTS_ACTION to created|appended|updated. Returns 1 on IO error.
AGENTS_ACTION=""
write_agents_md() {
  local new tmp last
  new="$(mktemp "${TMPDIR:-/tmp}/hmd-agents.XXXXXX")" || return 1
  tmp="$(mktemp "${TMPDIR:-/tmp}/hmd-agents.XXXXXX")" || { rm -f "$new"; return 1; }
  render_agents_block > "$new" || { rm -f "$new" "$tmp"; return 1; }

  if [ ! -f "$AGENTS_MD" ]; then
    cat "$new" > "$tmp" || { rm -f "$new" "$tmp"; return 1; }
    AGENTS_ACTION="created"
  elif grep -Fqx "$AG_BEGIN" "$AGENTS_MD" 2>/dev/null; then
    # A BEGIN with no END is an UNCLOSED fence: the region runs to EOF, so re-rendering
    # it would swallow every line after the marker. We do not own those lines, so we
    # refuse and leave the file exactly as it is — the caller reports the failure and
    # the hooks (the actual enforcement) are unaffected. Restore the END marker, or
    # delete the BEGIN, and re-init.
    if ! grep -Fqx "$AG_END" "$AGENTS_MD" 2>/dev/null; then
      rm -f "$new" "$tmp"
      AGENTS_ACTION="unclosed-fence"
      return 1
    fi
    # RE-RENDER in place. awk splits on the markers and substitutes the fresh block,
    # so every line outside the fence is passed through untouched. `emitted` makes a
    # duplicated fenced region collapse back to exactly one instead of multiplying.
    awk -v begin="$AG_BEGIN" -v end="$AG_END" -v blockfile="$new" '
      $0 == begin { inblock = 1
                    if (!emitted) { while ((getline line < blockfile) > 0) print line; close(blockfile); emitted = 1 }
                    next }
      $0 == end   { inblock = 0; next }
      !inblock    { print }
    ' "$AGENTS_MD" > "$tmp" || { rm -f "$new" "$tmp"; return 1; }
    AGENTS_ACTION="updated"
  else
    # APPEND to a repo that already had its own AGENTS.md. The prior file is copied
    # byte for byte; the ONLY edit we ever make to it is restoring a missing final
    # newline, without which the BEGIN marker would land mid-line and stop being a
    # marker at all.
    cat "$AGENTS_MD" > "$tmp" || { rm -f "$new" "$tmp"; return 1; }
    if [ -s "$tmp" ]; then
      last="$(tail -c 1 "$tmp" | od -An -tx1 | tr -d '[:space:]')"
      [ "$last" = "0a" ] || printf '\n' >> "$tmp"
    fi
    cat "$new" >> "$tmp" || { rm -f "$new" "$tmp"; return 1; }
    AGENTS_ACTION="appended"
  fi
  rm -f "$new"

  # A render that lost the fence, or produced more than one, is a corrupt file — refuse
  # to write it rather than hand the repo a broken (or duplicating) AGENTS.md.
  if [ "$(grep -Fxc "$AG_BEGIN" "$tmp" 2>/dev/null || echo 0)" != "1" ] \
  || [ "$(grep -Fxc "$AG_END"   "$tmp" 2>/dev/null || echo 0)" != "1" ]; then
    rm -f "$tmp"; return 1
  fi

  # Write through the existing inode so a repo's own file mode survives a re-init.
  cat "$tmp" > "$AGENTS_MD" || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
}

# Why the write failed, in words the reader can act on. An unclosed fence is the one
# failure a human caused and a human must undo, so it is never reported as plain IO.
agents_fail_detail() {
  if [ "$AGENTS_ACTION" = "unclosed-fence" ]; then
    printf 'the HEIMDALL:AGENTS fence is unclosed (BEGIN with no END) — restore the END marker or delete the BEGIN, then re-init. Your file was left untouched.'
  else
    printf 'IO error.'
  fi
}

if [ -n "$AGENTS_ONLY" ]; then
  if write_agents_md; then
    printf "  ${G}✓${R} AGENTS.md ${D}%s${R} ${D}(fence only — no hooks, no git config touched)${R}\n" "$AGENTS_ACTION"
    exit 0
  fi
  printf '  hmd init: could not write %s — %s\n' "$AGENTS_MD" "$(agents_fail_detail)" >&2
  exit 1
fi

HOOKS_REL=".heimdall/hooks"
HOOKS_DIR="$REPO/$HOOKS_REL"

# ── CHAINING: capture the prior hooksPath BEFORE we take it over ───────────────
# git resolves core.hooksPath relative to the repo root; the default is .git/hooks.
PRIOR="$(git -C "$REPO" config --get core.hooksPath 2>/dev/null || true)"
if [ -n "$PRIOR" ]; then
  case "$PRIOR" in /*) PRIOR_ABS="$PRIOR" ;; *) PRIOR_ABS="$REPO/$PRIOR" ;; esac
else
  PRIOR_ABS="$REPO/.git/hooks"
fi
# On re-init our own dir is already the hooksPath — do NOT record ourselves as the
# chain target (that would drop the real prior hooks and never self-chain). Keep the
# chain we saved the first time.
if [ "$PRIOR_ABS" = "$HOOKS_DIR" ]; then
  PRIOR_ABS="$(git -C "$REPO" config --get heimdall.prevHooksPath 2>/dev/null || echo "$REPO/.git/hooks")"
fi
git -C "$REPO" config heimdall.prevHooksPath "$PRIOR_ABS"

mkdir -p "$HOOKS_DIR"

# The absolute plugin bin dir embedded into the generated hooks so they run
# STANDALONE from a git-hook process with no reliance on PATH or a plugin runtime.
PLUGIN_BIN="$BIN_DIR"

# ── emit the hooks ────────────────────────────────────────────────────────────
# A shared gate hook body (pre-commit and pre-push are identical except the name).
write_gate_hook() {
  local name="$1" out="$HOOKS_DIR/$1"
  cat > "$out" <<EOF
#!/usr/bin/env bash
# Generated by \`hmd init\` — Heimdall universal git core (Layer 0). Do not edit;
# re-run \`hmd init\` to refresh. Runs the configured gates from a plain git hook.
set -u
HMD_BIN="$PLUGIN_BIN"
REPO="\$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
HOOK="$name"

# 1. CHAIN any pre-existing hook — a repo that had its own $name STILL runs it,
#    first, and its failure still blocks (we never clobber a user's gate).
PREV="\$(git config --get heimdall.prevHooksPath 2>/dev/null || true)"
if [ -n "\$PREV" ] && [ "\$PREV" != "$HOOKS_DIR" ] && [ -x "\$PREV/\$HOOK" ]; then
  "\$PREV/\$HOOK" "\$@" || exit \$?
fi

# 2. Escape hatch — HMD_SKIP=1 proceeds BUT logs a VISIBLE unproven-merge receipt.
if [ "\${HMD_SKIP:-0}" = "1" ]; then
  mkdir -p "\$REPO/.heimdall/receipts" 2>/dev/null || true
  printf '%s\tHMD_SKIP\t%s\tstaged=%s\n' \\
    "\$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)" "\$HOOK" \\
    "\$(git diff --cached --name-only 2>/dev/null | sed '/^\$/d' | head -1)" \\
    >> "\$REPO/.heimdall/receipts/unproven.log" 2>/dev/null || true
  printf '\033[33m⚠ HMD_SKIP=1 — Heimdall gates BYPASSED; unproven-merge receipt logged → %s\033[0m\n' \\
    "\$REPO/.heimdall/receipts/unproven.log" >&2
  exit 0
fi

# 3. Run the configured gates headless. DENY = nonzero + BIFRÖST block on stderr.
GATE="\$HMD_BIN/heimdall-gate-run"
[ -x "\$GATE" ] || GATE="\$(command -v heimdall-gate-run 2>/dev/null || true)"
if [ -n "\$GATE" ] && [ -x "\$GATE" ]; then
  "\$GATE" --phase "\$HOOK" || exit \$?
fi
exit 0
EOF
  chmod +x "$out"
}

write_post_commit() {
  local out="$HOOKS_DIR/post-commit"
  cat > "$out" <<EOF
#!/usr/bin/env bash
# Generated by \`hmd init\` — Heimdall presence beat (Layer 0). Never blocks.
set -u
HMD_BIN="$PLUGIN_BIN"
REPO="\$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Chain any pre-existing post-commit (best-effort, never blocks a commit).
PREV="\$(git config --get heimdall.prevHooksPath 2>/dev/null || true)"
[ -n "\$PREV" ] && [ "\$PREV" != "$HOOKS_DIR" ] && [ -x "\$PREV/post-commit" ] && "\$PREV/post-commit" "\$@" || true

# verdict = the last gate result; file = the top path of THIS commit.
VERDICT="\$("\$HMD_BIN/heimdall-verdict" --field verdict 2>/dev/null || echo unknown)"
[ -n "\$VERDICT" ] || VERDICT="unknown"
TOPFILE="\$(git show --name-only --pretty=format: HEAD 2>/dev/null | sed '/^\$/d' | head -1)"

# Local beat spool — an offline audit trail proving the beat fired even when the
# control plane is unreachable (the beat itself is a silent no-op offline).
mkdir -p "\$REPO/.heimdall/receipts" 2>/dev/null || true
printf '%s\t%s\t%s\n' \\
  "\$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)" "\$VERDICT" "\$TOPFILE" \\
  >> "\$REPO/.heimdall/receipts/beats.log" 2>/dev/null || true

# Fire-and-forget presence beat (reuses heimdall-presence; silent no-op offline).
PRES="\$HMD_BIN/heimdall-presence"
[ -x "\$PRES" ] || PRES="\$(command -v heimdall-presence 2>/dev/null || true)"
if [ -n "\$PRES" ] && [ -x "\$PRES" ]; then
  ( "\$PRES" beat --verdict "\$VERDICT" --file "\$TOPFILE" >/dev/null 2>&1 & ) || true
fi
exit 0
EOF
  chmod +x "$out"
}

write_gate_hook pre-commit
write_gate_hook pre-push
write_post_commit

# ── take over the hooksPath (relative — portable across clones of THIS checkout) ─
git -C "$REPO" config core.hooksPath "$HOOKS_REL"

# ── keep the transient local state out of the repo's own git noise ─────────────
# The file belongs to the repo, so the ONLY edit we ever make to a line we did not
# write is restoring a missing final newline — exactly as write_agents_md does above,
# and for the same reason. Without it a bare `>>` welds our first pattern onto the
# repo's last line ("node_modules" + ".heimdall/verdict.json"), which silently kills
# BOTH rules: theirs stops matching and ours never starts. It also defeats the
# grep -qxF dedupe below (a welded line is not a whole-line match), so every re-init
# would append the pattern again.
GI="$REPO/.gitignore"
if [ -s "$GI" ] && [ "$(tail -c 1 "$GI" | od -An -tx1 | tr -d '[:space:]')" != "0a" ]; then
  printf '\n' >> "$GI" 2>/dev/null || true
fi
for pat in ".heimdall/verdict.json" ".heimdall/receipts/" ".heimdall/audit.json"; do
  if [ -f "$GI" ] && grep -qxF "$pat" "$GI" 2>/dev/null; then continue; fi
  printf '%s\n' "$pat" >> "$GI" 2>/dev/null || true
done

# ── make every coding agent Heimdall-aware (see the AGENTS.md section above) ────
# Non-blocking by contract, exactly like the audit block below: a failed write is
# reported but never changes init's exit status — the hooks are already installed
# and THEY are the enforcement. AGENTS.md only tells the agent what it will hit.
AGENTS_WROTE=""
if write_agents_md; then AGENTS_WROTE=1; fi

# ── reuse the team/identity plumbing: auto-mint/auto-join a team, fire-and-forget
#    (mirrors the plugin SessionStart — never blocks, silent offline). ───────────
HMDTEAM="$PLUGIN_BIN/heimdall-team"
[ -x "$HMDTEAM" ] && ( "$HMDTEAM" auto >/dev/null 2>&1 & ) || true

# ── done — the watchman is keeping watch ───────────────────────────────────────
printf '\n'
printf "  ${G}${B}✓ Heimdall is watching this repo.${R}\n"
printf "  ${D}hooks →${R} %s ${D}(pre-commit · pre-push · post-commit)${R}\n" "$HOOKS_REL"
if [ "$PRIOR_ABS" != "$REPO/.git/hooks" ] || { [ -x "$PRIOR_ABS/pre-commit" ] || [ -x "$PRIOR_ABS/pre-push" ] || [ -x "$PRIOR_ABS/post-commit" ]; }; then
  printf "  ${D}chained  →${R} %s ${D}(your existing hooks still run)${R}\n" "$PRIOR_ABS"
fi
if [ -n "$AGENTS_WROTE" ]; then
  printf "  ${D}AGENTS.md${R} %s ${D}— every coding agent now reads that this repo is gated${R}\n" "$AGENTS_ACTION"
else
  printf "  ${D}AGENTS.md not written — %s (hooks are installed and still enforce)${R}\n" "$(agents_fail_detail)" >&2
fi
printf "  ${D}gates run on every commit; deny blocks it.${R}\n"
printf "  ${D}escape once:${R} ${B}HMD_SKIP=1 git commit …${R} ${D}(logged, never silent)${R}\n"
printf "  ${D}last verdict:${R} ${C}hmd verdict${R}\n"

# ── Δ2 audit-on-init: a fast, fully-offline repo audit → A NUMBER WORTH POSTING,
#    printed here and STORED to <repo>/.heimdall/audit.json for `hmd badge`/`hmd
#    clip`. Runs on FIRST init only (no audit.json yet). NON-BLOCKING by contract:
#    the whole block is guarded + `|| true`, so a scan/python hiccup never changes
#    init's exit status (still 0). ────────────────────────────────────────────────
AUDIT_LIB="$PLUGIN_BIN/lib/repo_audit.py"
if [ ! -f "$REPO/.heimdall/audit.json" ] && command -v python3 >/dev/null 2>&1 && [ -f "$AUDIT_LIB" ]; then
  AUDIT_LINE="$(python3 "$AUDIT_LIB" run --repo "$REPO" --store "$REPO/.heimdall/audit.json" 2>/dev/null || true)"
  [ -n "$AUDIT_LINE" ] && printf "  ${C}%s${R}\n" "$AUDIT_LINE"
fi

# ── Δ6 funnel: record the `init` growth-loop stage (client-side, consent-gated,
#    fire-and-forget — never blocks or prints; the engine no-ops when off). ────────
FUNNEL_BIN="$PLUGIN_BIN/heimdall-funnel"
[ -x "$FUNNEL_BIN" ] && ( "$FUNNEL_BIN" emit init --context hook >/dev/null 2>&1 & ) || true

printf '\n'
exit 0
