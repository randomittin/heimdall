#!/usr/bin/env bash
# heimdall-dream-permission — ASK the operator for the one permission the nightly /dream
# needs, ONCE, at first run — instead of failing at 03:00 forever and hoping he reads a log.
#
# WHERE THIS SITS IN THE STORY.
#   Commit 245ede5 fixed the SILENCE: the nightly runner now lives outside the protected
#   repo, probes it, records a structured status and exits 75 instead of dying mute. That
#   turned 24 invisible days into a visible failure. But visible is not fixed — the machine
#   now says "blocked: tcc-denied" every single night, and nobody ever ASKS the operator
#   for the grant that would end it. This is that ask.
#
# ARMED BY STRUCTURE, DISARMED BY EVIDENCE.
#   It ARMS on a structural fact: the repo lives inside a folder macOS gates (~/Downloads,
#   ~/Documents, ~/Desktop), and a LaunchAgent carries no TCC grant, so the 03:00 job
#   cannot read it. It DISARMS on evidence from the launchd domain itself — a scheduled run
#   that recorded result=ok is proof the job CAN read the repo, which is the only honest way
#   to know a grant landed. Nothing here is self-reported and nothing needs the operator to
#   remember to tick a box: the status file can only say "ok" after the job actually ran.
#   When it disarms it DELETES its marker, so a later recurrence asks again rather than
#   being permanently muted by a success that has since stopped being true.
#
# IT DETECTS AND ASKS. IT NEVER ACTS.
#   macOS exposes NO API to request or set Full Disk Access — not to us, not to anyone —
#   and it does NOT raise its own prompt for a launchd job (measured in 245ede5: a probe
#   LaunchAgent was refused with no prompt shown, and at 03:00 there is nobody awake to
#   answer one anyway). So this never invokes tccutil, never touches the TCC database, and
#   never opens System Settings on its own. `open-settings` is a SEPARATE verb the human
#   runs, and all it does is hand the request to macOS's own UI. A tool that implied it
#   could grant this would send him hunting for a dialog that is never coming.
#
# WHY THE FIRST OPTION IS "MOVE THE REPO".
#   It needs no permission at all, which makes it strictly narrower than any grant. The
#   grant route is offered honestly with its blast radius attached, because the binary
#   macOS judges for a scheduled shell script is a SHARED system interpreter — measured on
#   this machine: the denial named /Applications/Xcode.app/.../python3, the interpreter the
#   job resolved, not the script. Granting that Full Disk Access grants it to every other
#   use of the same interpreter, and an operator deserves to know that before clicking.
#
# IT PROMPTS WHEN — AND ONLY WHEN — A HUMAN IS THERE TO ANSWER.
#   Printing a block that ends in "now go type another command" is homework, and the owner
#   said so: "the user would grant this, but prompt from hmd is required". So with a real
#   terminal on BOTH stdin and stdout, `ask` puts the choice to him and acts on the answer
#   in the same flow — including opening the Full Disk Access pane for him.
#
#   Everywhere else — the SessionStart hook, a pipe, CI, `curl | bash` — it falls back to
#   the printed block and exits 0. That arm does not even READ stdin, which is what makes
#   blocking impossible rather than merely unlikely: a prompt that wedges an unattended job
#   is far worse than the homework it replaces. Interactive answers additionally time out
#   to "do nothing", so even a terminal nobody is watching cannot hang.
#
# COMMANDS
#   check         --repo DIR [--json]   exit 0 = nothing to grant, 1 = a grant is needed
#   ask           --repo DIR [--force] [--no-interactive] [--interactive-only]
#                                       prompt when a human is present, else print the
#                                       block. ONCE either way; ALWAYS exits 0 (hook-safe)
#                                       --interactive-only DEFERS instead of printing:
#                                       with no human it does nothing at all and stays
#                                       armed. That is the form the INSTALL and UPDATE
#                                       paths use — see the note on cmd_ask.
#   open-settings                       open macOS's Full Disk Access pane (explicit only)
#   reset         [--repo DIR]          forget the block was shown (re-arm the ask)
#
# ENV
#   HEIMDALL_HOME                    state dir (default $HOME/.heimdall)
#   HEIMDALL_DREAM_STATUS            the runner's status file
#   HEIMDALL_DREAM_PERMISSION_STATE  the "already asked" marker
#   HEIMDALL_LAUNCH_AGENTS_DIR       plist dir, read to name the exact binary to grant
#   HEIMDALL_OPEN                    the `open` binary (test seam)
#   HEIMDALL_DREAM_PERMISSION_TTY    force the interactive branch (test seam; the REAL
#                                    gate is a terminal on stdin AND stdout)
#   HEIMDALL_DREAM_PERMISSION_TIMEOUT seconds to wait for an answer (default 300)

set -u

SELF="$0"
BINDIR="$(cd "$(dirname "$0")" && pwd)"

# real-home.sh first: heimdall_tcc_protected_root consults the PASSWD home as well as
# $HOME, and can only do so when that helper is defined. Both are sourced best-effort —
# see the fail-safe note on classify() for what an unreadable lib means here.
if [ -r "$BINDIR/lib/real-home.sh" ]; then
  # shellcheck disable=SC1091
  . "$BINDIR/lib/real-home.sh" 2>/dev/null || true
fi
if [ -r "$BINDIR/lib/tcc-paths.sh" ]; then
  # shellcheck disable=SC1091
  . "$BINDIR/lib/tcc-paths.sh" 2>/dev/null || true
fi

HEIMDALL_HOME="${HEIMDALL_HOME:-$HOME/.heimdall}"
STATUS="${HEIMDALL_DREAM_STATUS:-$HEIMDALL_HOME/dream-status.json}"
MARKER="${HEIMDALL_DREAM_PERMISSION_STATE:-$HEIMDALL_HOME/dream-permission.json}"
LA_DIR="${HEIMDALL_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
PLIST="$LA_DIR/com.heimdall.dream.plist"
OPEN_BIN="${HEIMDALL_OPEN:-open}"

# The private, ad-hoc-signed hmd-dream identity heimdall-dream-schedule builds into
# RUNNER_DIR at install time. Read-only from here — BUILDING is schedule's job, done once
# at install, before this file's ask ever runs; this file only reports what already
# exists (`identity`, never `build`).
BUNDLE="$BINDIR/heimdall-dream-bundle"
RUNNER_DIR="$HEIMDALL_HOME/bin"

# The pane macOS opens for a Full Disk Access request. This is a URL handed to the OS,
# not a mutation — the human still does every part of the granting.
FDA_PANE="x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"

# The launchd PATH is /usr/bin:/bin:/usr/sbin:/sbin — a DIFFERENT search path than any
# interactive shell. Resolving a `#!/usr/bin/env X` shebang against anything else would
# name a binary the 03:00 job never actually runs, which is worse than naming none.
LAUNCHD_PATH="/usr/bin:/bin:/usr/sbin:/sbin"

REPO=""
JSON=0
FORCE=0
NO_INTERACTIVE=0
INTERACTIVE_ONLY=0

die() { echo "heimdall-dream-permission: error: $*" >&2; exit 2; }

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)  REPO="${2:-}"; shift 2 ;;
      --json)  JSON=1; shift ;;
      --force) FORCE=1; shift ;;
      --no-interactive) NO_INTERACTIVE=1; shift ;;
      --interactive-only) INTERACTIVE_ONLY=1; shift ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [ -n "$REPO" ] || REPO="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  REPO="$(cd "$REPO" 2>/dev/null && pwd)" || die "repo not a directory: $REPO"
}

# ── flat-JSON field reads (no jq: the scheduled context does not have it, and a tool
# that needs a dependency the failing context lacks fails exactly when it is needed) ──
json_field() { # json_field <file> <key>
  [ -f "$1" ] || return 0
  sed -n "s/^[[:space:]]*\"$2\"[[:space:]]*:[[:space:]]*\"\(.*\)\"[[:space:]]*,\{0,1\}[[:space:]]*\$/\1/p" \
    "$1" 2>/dev/null | head -1
}

# json_field_var — the same reader as json_field above, over a STRING already in hand
# instead of a file on disk. heimdall-dream-bundle's `identity --json` prints to stdout,
# not a file, so its output is read this way rather than redirected to a temp file just
# to satisfy json_field's file-based signature.
json_field_var() { # json_field_var <string> <key>
  printf '%s\n' "$1" | sed -n "s/^[[:space:]]*\"$2\"[[:space:]]*:[[:space:]]*\"\(.*\)\"[[:space:]]*,\{0,1\}[[:space:]]*\$/\1/p" | head -1
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/ }"
  s="${s//$'\n'/ }"
  s="${s//$'\r'/ }"
  printf '%s' "$s"
}

# ── the hmd-dream identity — read-only here; heimdall-dream-schedule is what builds it ──
BUNDLE_ID_EXISTS=0
BUNDLE_ID_PATH=""
BUNDLE_ID_EXEC=""
BUNDLE_ID_NAME=""
BUNDLE_ID_CDHASH=""

load_bundle_identity() {
  BUNDLE_ID_EXISTS=0; BUNDLE_ID_PATH=""; BUNDLE_ID_EXEC=""; BUNDLE_ID_NAME=""; BUNDLE_ID_CDHASH=""
  [ -x "$BUNDLE" ] || return 0
  local out rc=0
  out="$("$BUNDLE" identity --out "$RUNNER_DIR" --json 2>/dev/null)" || rc=$?
  [ "$rc" -eq 0 ] || return 0
  BUNDLE_ID_PATH="$(json_field_var "$out" path)"
  BUNDLE_ID_EXEC="$(json_field_var "$out" executable)"
  BUNDLE_ID_NAME="$(json_field_var "$out" display_name)"
  BUNDLE_ID_CDHASH="$(json_field_var "$out" cdhash)"
  [ -n "$BUNDLE_ID_EXEC" ] && [ -x "$BUNDLE_ID_EXEC" ] && BUNDLE_ID_EXISTS=1
  return 0
}

# bundle_current_cdhash — the CDHash of WHATEVER ProgramArguments[0] actually is right
# now, live and uncached. Never trust a remembered value: TCC keys a grant to code
# identity, and a rebuilt interpreter gets a NEW CDHash even sitting at the same path.
bundle_current_cdhash() {
  local p out
  p="$(plist_arg 0)"
  if [ -z "$p" ] || [ ! -x "$p" ] || ! command -v codesign >/dev/null 2>&1; then
    return 0
  fi
  out="$(codesign -dvvv "$p" 2>&1)" || true
  printf '%s' "$out" | sed -n 's/^CDHash=//p' | head -1
  return 0
}

# identity_drifted — true unless the interpreter that earned the LAST successful,
# repo-reaching run is POSITIVELY CONFIRMED to still be ProgramArguments[0] today. A grant
# is earned by a human clicking a specific row in System Settings for a specific code
# identity; when that identity moves — a rebuild, a reinstall, a macOS update that
# re-signs /bin/bash — the grant does not follow it, and TCC gives no signal that it
# silently stopped applying. This is the only way we ever find out.
#
# FAILS SAFE TOWARD "DRIFTED": an unrecorded or unrecomputable hash on EITHER side counts
# as drift, never as a pass — trusting a grant we cannot actually confirm is the exact
# failure this exists to catch.
identity_drifted() {
  local recorded current
  recorded="$(json_field "$STATUS" interpreter_cdhash)"
  current="$(bundle_current_cdhash)"
  if [ -n "$recorded" ] && [ -n "$current" ] && [ "$recorded" = "$current" ]; then
    return 1
  fi
  return 0
}

# ── classification ───────────────────────────────────────────────────────────────
#
# THE STATUS FILE IS ONLY CONSULTED WHEN IT IS ABOUT THIS REPO. A status left behind by a
# different checkout describes a different job; quoting its denied path under this repo's
# heading would be a fabricated diagnosis, and treating its result=ok as proof would
# disarm an ask for a grant that was never given.
#
# FAIL SAFE. When bin/lib/tcc-paths.sh could not be sourced the predicate is undefined and
# this cannot tell protected from safe. It answers "unknown" and stays SILENT rather than
# guessing: a spurious permission demand teaches the operator to ignore the one real one,
# and the loud 03:00 failure path (runner exit 75 + the SessionStart notice) is untouched
# by this file and still reports the outage on its own.
STATE=""
REASON=""
PROT_ROOT=""
S_DENIED=""
S_DETAIL=""
S_TS=""
S_RESULT=""
S_REACH=""

classify() {
  STATE=""; REASON=""; PROT_ROOT=""
  S_DENIED=""; S_DETAIL=""; S_TS=""; S_RESULT=""; S_REACH=""

  if ! type heimdall_tcc_protected_root >/dev/null 2>&1; then
    STATE="unknown"; REASON="predicate-unavailable"
    return 0
  fi

  if ! PROT_ROOT="$(heimdall_tcc_protected_root "$REPO")"; then
    PROT_ROOT=""
    STATE="ok"; REASON="repo-not-protected"
    return 0
  fi

  local s_repo
  s_repo="$(json_field "$STATUS" repo)"
  if [ -n "$s_repo" ] && [ "$s_repo" = "$REPO" ]; then
    S_RESULT="$(json_field "$STATUS" result)"
    S_DENIED="$(json_field "$STATUS" denied_path)"
    S_DETAIL="$(json_field "$STATUS" detail)"
    S_TS="$(json_field "$STATUS" ts)"
    S_REACH="$(json_field "$STATUS" repo_reachable)"
  fi

  # A completed run is NOT evidence the grant landed.
  #
  # dream reads its state from $HEIMDALL_HOME, not from the repo, so it runs to
  # completion and records result=ok even when TCC refused it the repo entirely —
  # all it loses is the mirror-back of the report. Treating that result=ok as proof
  # of a grant is what made this ask self-silencing: the first scheduled run after
  # the denial flipped STATE to "granted", and since "needs-grant" is the only state
  # that speaks (see the callers), the ask went quiet permanently while the denial
  # it exists to report was still in force. Twenty-six days of blocked runs went
  # unmentioned that way.
  #
  # So the grant is only claimed when the run actually reached the repo. The runner
  # records repo_reachable on EVERY status (default yes, set no on the TCC path), so
  # this reads a field that is always present on anything it writes.
  #
  # Missing or empty means the status predates that field: reachability is then
  # unrecorded, not confirmed, and an unverifiable gate is NON_VERIFIED, never OPEN.
  # It costs at most one extra ask — the one-shot marker suppresses the repeat — and
  # that is the cheap side of this trade. Silence is the expensive side.
  if [ "$S_RESULT" = "ok" ]; then
    case "$S_REACH" in
      yes)
        if identity_drifted; then
          STATE="needs-grant"; REASON="interpreter-identity-changed"
        else
          STATE="granted"; REASON="scheduled-run-succeeded"
        fi
        return 0
        ;;
      no)
        STATE="needs-grant"; REASON="run-completed-repo-unreachable"
        return 0
        ;;
      *)
        STATE="needs-grant"; REASON="run-completed-reachability-unrecorded"
        return 0
        ;;
    esac
  fi

  STATE="needs-grant"; REASON="tcc-protected-repo"
  return 0
}

# subject — WHAT the block was about. The marker suppresses a repeat only for the SAME
# subject, so a different repo (or the same repo moved under a different protected root)
# is a genuinely different grant and gets asked about again.
subject() { printf '%s|%s' "$REPO" "$PROT_ROOT"; }

marker_subject() { json_field "$MARKER" subject; }
marker_reason() { json_field "$MARKER" reason; }

write_marker() {
  local dir tmp
  dir="$(dirname "$MARKER")"
  mkdir -p "$dir" 2>/dev/null || true
  chmod 0700 "$dir" 2>/dev/null || true
  tmp="$MARKER.$$.tmp"
  cat > "$tmp" <<EOF
{
  "schema": 1,
  "asked_ts": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "subject": "$(json_escape "$(subject)")",
  "repo": "$(json_escape "$REPO")",
  "protected_root": "$(json_escape "$PROT_ROOT")",
  "reason": "$(json_escape "$REASON")"
}
EOF
  mv -f "$tmp" "$MARKER" 2>/dev/null || rm -f "$tmp" 2>/dev/null || true
}

# ── naming the EXACT binary a Full Disk Access grant must be given to ────────────
#
# "Grant Full Disk Access to the scheduled interpreter" is useless advice if the operator
# cannot tell WHICH binary that is — the System Settings picker wants a concrete path.
# The plist is the single source of the scheduled argv, so the answer is read from it
# rather than guessed. plutil is the platform's own plist reader and ships with every
# macOS; where it is absent there is no launchd either, so printing nothing beats
# fabricating an answer.
#
# TCC JUDGES THE INTERPRETER, NOT THE SCRIPT. Measured on this machine: the denial named
# /Applications/Xcode.app/Contents/Developer/usr/bin/python3 — the interpreter the job
# resolved through the shebang — never the script path in ProgramArguments[0]. So the
# shebang is followed, and `#!/usr/bin/env X` is resolved against the LAUNCHD path,
# because that is the search path the 03:00 job actually has.
plist_arg() { # plist_arg <index>
  [ -f "$PLIST" ] || return 0
  command -v plutil >/dev/null 2>&1 || return 0
  plutil -extract "ProgramArguments.$1" raw -o - "$PLIST" 2>/dev/null || return 0
}

# the value following --python in the scheduled argv (the pinned interpreter, when one
# was resolved at install time), searched over a bounded argv.
plist_pinned_python() {
  local i=0 a
  while [ "$i" -lt 12 ]; do
    a="$(plist_arg "$i")"
    [ -n "$a" ] || break
    if [ "$a" = "--python" ]; then
      plist_arg $((i + 1))
      return 0
    fi
    i=$((i + 1))
  done
  return 0
}

resolve_shebang_interpreter() { # <script path>
  local script="$1" line interp arg
  [ -n "$script" ] && [ -r "$script" ] || return 0
  line="$(head -1 "$script" 2>/dev/null)" || return 0
  case "$line" in '#!'*) : ;; *) return 0 ;; esac
  line="${line#\#!}"
  # shellcheck disable=SC2086
  set -- $line
  interp="${1:-}"
  arg="${2:-}"
  [ -n "$interp" ] || return 0
  # `#!/usr/bin/env X` — resolve X the way the 03:00 job would.
  case "$interp" in
    */env)
      [ -n "$arg" ] || return 0
      local d
      for d in $(printf '%s' "$LAUNCHD_PATH" | tr ':' ' '); do
        if [ -x "$d/$arg" ]; then printf '%s' "$d/$arg"; return 0; fi
      done
      return 0
      ;;
    *) printf '%s' "$interp" ;;
  esac
}

# ── the block ────────────────────────────────────────────────────────────────────
p() { printf '%s\n' "$*"; }

print_block() {
  local prog interp pinned safe_suggest
  load_bundle_identity
  prog="$(plist_arg 0)"
  [ -n "$prog" ] || prog="$HEIMDALL_HOME/bin/heimdall-dream-runner"
  interp="$(resolve_shebang_interpreter "$prog")"
  [ -n "$interp" ] || interp="$prog"
  pinned="$(plist_pinned_python)"
  safe_suggest="$HOME/$(basename "$REPO")"

  p "=============================================================================="
  p "  HEIMDALL NEEDS ONE PERMISSION DECISION FROM YOU  —  once, about a minute"
  p "=============================================================================="
  p ""
  if [ "$REASON" = "interpreter-identity-changed" ]; then
    p "  WHAT IS BROKEN"
    p "    The nightly dream at 03:00 HAD the permission it needs — a previous run"
    p "    reached this repo successfully. But the interpreter it runs through changed"
    p "    code identity since then (a Heimdall update, a reinstall, or a macOS update"
    p "    can all do this), and macOS ties the grant to that identity, not to the path."
    p "    The old grant does not follow the new binary — this is not a bug you caused,"
    p "    it is what TCC does, by design, whenever the underlying code changes."
    p ""
    p "      repo        : $REPO"
    p "      interpreter : $interp"
  else
    p "  WHAT IS BROKEN"
    p "    The nightly dream at 03:00 cannot read this repo, so no morning report is"
    p "    ever written. Running it by hand still works — this is only the unattended run."
    p ""
    p "      repo        : $REPO"
    if [ -n "$S_DENIED" ]; then
      p "      denied      : $S_DENIED"
    fi
    if [ -n "$S_DETAIL" ]; then
      p "      os error    : $S_DETAIL"
    fi
    if [ -n "$S_TS" ]; then
      p "      last attempt: $S_TS  (blocked)"
    fi
  fi
  p ""
  p "  WHY"
  p "    This repo lives inside $PROT_ROOT, a folder macOS protects."
  p "    A scheduled LaunchAgent carries NO permission grant, so every read is refused"
  p "    before the dream can start. Your terminal is a different case — it already holds"
  p "    the grant, which is exactly why running it by hand works today."
  p ""
  p "  WHAT WILL NOT WORK — so you do not spend time on it"
  p "    - Heimdall cannot grant this itself. macOS exposes no API to request or set Full"
  p "      Disk Access. Only you can, and only in System Settings."
  p "    - macOS shows no prompt for a background job. Measured: a probe LaunchAgent was"
  p "      refused with no prompt at all — and at 03:00 nobody is awake to click one."
  p "    - Moving the program or the log does not help, and is already done: the runner"
  p "      lives outside the protected folder at"
  p "        $HEIMDALL_HOME/bin/heimdall-dream-runner"
  p "      which is the only reason you are reading this instead of getting silence."
  p ""
  p "  PICK ONE"
  p ""
  p "    [A]  MOVE THE REPO OUT OF THE PROTECTED FOLDER   — no permission needed at all"
  p ""
  p "           mv $REPO $safe_suggest"
  p "           $safe_suggest/bin/heimdall-dream-schedule install --repo $safe_suggest"
  p ""
  p "         Recommended. Nothing to grant, nothing to maintain, no click, and it"
  p "         cannot be revoked by a macOS update."
  p ""
  if [ "$BUNDLE_ID_EXISTS" = 1 ]; then
    p "    [B]  GRANT FULL DISK ACCESS TO hmd-dream          — one click, narrowly scoped"
    p ""
    p "           1.  heimdall-dream-permission open-settings"
    p "               (opens System Settings > Privacy & Security > Full Disk Access)"
    p "           2.  click +, press Cmd+Shift+G, and paste exactly:"
    p "                 $BUNDLE_ID_EXEC"
    p "               It will list as \"$BUNDLE_ID_NAME\" — a private identity built"
    p "               only for this job, distinct from the system's own /bin/bash."
    if [ -n "$pinned" ]; then
      p "           3.  dream ALSO runs through a pinned python interpreter — add this"
      p "               path too (still the shared system/Homebrew binary; Heimdall does"
      p "               not build it a private identity the way it does for bash above):"
      p "                 $pinned"
    fi
    p "           4.  switch it ON, then reload the job so launchd stops using its"
    p "               cached (denied) decision:"
    p "                 launchctl bootout gui/$(id -u)/com.heimdall.dream 2>/dev/null"
    p "                 launchctl bootstrap gui/$(id -u) $PLIST"
    p "               (or, equivalently:  launchctl kickstart -k gui/$(id -u)/com.heimdall.dream)"
    p "           5.  confirm it actually took, from tonight's real scheduled run —"
    p "               not from this tool, which cannot see inside System Settings:"
    p "                 heimdall-dream-permission check --repo $REPO"
    p ""
    p "         Recommended over [C] below: this identity is used by nothing else on the"
    p "         machine, so the grant cannot leak to any other program."
    p ""
    p "    [C]  GRANT FULL DISK ACCESS TO THE RAW INTERPRETER  — LAST RESORT, BROAD GRANT"
    p ""
    p "           add instead: $interp"
    p "           BLAST RADIUS, HONESTLY: that path is a shared system binary — granting"
    p "           it Full Disk Access grants it to every other program that runs through"
    p "           that same binary, not just this job. Prefer [B] above."
    p ""
    p "    [D]  DO NOTHING                                  — keep running it by hand"
    p ""
    p "           $REPO/bin/heimdall-dream --repo $REPO run"
    p ""
    p "         Your terminal holds the grant, so this works right now. The 03:00 run stays"
    p "         broken and Heimdall keeps telling you so at the start of each session."
  else
    p "    [B]  GRANT FULL DISK ACCESS                      — one human click, broad grant"
    p ""
    p "           1.  heimdall-dream-permission open-settings"
    p "               (opens System Settings > Privacy & Security > Full Disk Access)"
    p "           2.  click +, press Cmd+Shift+G, and add:"
    if [ -n "$interp" ]; then
      p "                 $interp"
    fi
    if [ -n "$pinned" ] && [ "$pinned" != "$interp" ]; then
      p "                 $pinned"
    fi
    if [ -z "$interp" ] && [ -z "$pinned" ]; then
      p "                 the interpreter named in the error above"
    fi
    p "           3.  switch it ON, then reload the job so launchd stops using its"
    p "               cached (denied) decision:"
    p "                 launchctl bootout gui/$(id -u)/com.heimdall.dream 2>/dev/null"
    p "                 launchctl bootstrap gui/$(id -u) $PLIST"
    p "               (or, equivalently:  launchctl kickstart -k gui/$(id -u)/com.heimdall.dream)"
    p "           4.  confirm it actually took, from tonight's real scheduled run:"
    p "                 heimdall-dream-permission check --repo $REPO"
    p ""
    p "         LAST RESORT: a narrower, private grant (hmd-dream) could not be built on"
    p "         this machine (codesign unavailable, or heimdall-dream-bundle missing) —"
    p "         run heimdall-dream-bundle build --out $HEIMDALL_HOME/bin to see why."
    p "         BLAST RADIUS, HONESTLY: macOS judges the INTERPRETER, not the script —"
    p "         the recorded denial named the interpreter, not the job. Those paths are"
    p "         shared system binaries, so granting them Full Disk Access grants it to"
    p "         every other program that runs through them. Prefer [A] unless you have a"
    p "         specific reason not to."
    p ""
    p "    [C]  DO NOTHING                                  — keep running it by hand"
    p ""
    p "           $REPO/bin/heimdall-dream --repo $REPO run"
    p ""
    p "         Your terminal holds the grant, so this works right now. The 03:00 run stays"
    p "         broken and Heimdall keeps telling you so at the start of each session."
  fi
  p ""
  p "  Shown once. It will not ask again unless something changes, and it goes quiet by"
  p "  itself the moment a scheduled run succeeds AND still uses the same interpreter"
  p "  identity you granted. To see it again:"
  p "    heimdall-dream-permission ask --repo $REPO --force"
  p "=============================================================================="
}

# ── interactivity ────────────────────────────────────────────────────────────────
#
# THE GATE IS THE ENTIRE SAFETY ARGUMENT. Both descriptors must be a terminal: stdout
# alone would still let a piped-stdin caller be prompted at, and stdin alone would prompt
# into a log nobody reads. Requiring both is the closest thing to "a human is sitting
# there" that a shell can actually check. Everything else — hooks, pipes, CI, curl | bash
# — takes the printed arm, which never touches stdin at all.
can_prompt() {
  [ "$NO_INTERACTIVE" = 1 ] && return 1
  [ "${HEIMDALL_DREAM_PERMISSION_TTY:-0}" = "1" ] && return 0
  [ -t 0 ] && [ -t 1 ]
}

# ask_line <prompt> — read one answer into $ANSWER.
# rc 1 on EOF **or** timeout, and every caller treats that as "do nothing". A terminal is
# not proof anyone is watching it (a detached tmux pane is a terminal), so the bounded
# read is what turns "unlikely to hang" into "cannot hang".
ANSWER=""
ask_line() {
  ANSWER=""
  printf '%s' "$1"
  if ! read -r -t "${HEIMDALL_DREAM_PERMISSION_TIMEOUT:-300}" ANSWER; then
    echo ""
    return 1
  fi
  return 0
}

open_pane() {
  if ! command -v "$OPEN_BIN" >/dev/null 2>&1 && [ ! -x "$OPEN_BIN" ]; then
    return 1
  fi
  "$OPEN_BIN" "$FDA_PANE" >/dev/null 2>&1
}

# ── [B] grant Full Disk Access ───────────────────────────────────────────────────
#
# hmd OPENS THE PANE; THE HUMAN GRANTS. That division is not a limitation we are being
# coy about — macOS provides no API to set Full Disk Access, so the pane is genuinely the
# whole of what any program can do here.
#
# AND IT DOES NOT PRETEND TO KNOW THE OUTCOME. macOS will not let a program read its own
# permission state either, so "did it work?" is unanswerable from in here. Claiming
# success because he clicked would be exactly the invented-confidence this whole feature
# exists to replace. Instead: re-probe, say what is still visible, say what is not, and
# name the one thing that WILL prove it — a scheduled run recording result: ok, which is
# also what makes this ask go quiet on its own.
flow_grant() {
  local interp pinned prog target
  load_bundle_identity
  prog="$(plist_arg 0)"
  [ -n "$prog" ] || prog="$HEIMDALL_HOME/bin/heimdall-dream-runner"
  interp="$(resolve_shebang_interpreter "$prog")"
  [ -n "$interp" ] || interp="$prog"
  pinned="$(plist_pinned_python)"
  [ -n "$interp" ] || interp="$pinned"

  if [ "$BUNDLE_ID_EXISTS" = 1 ]; then
    target="$BUNDLE_ID_EXEC"
  else
    target="$interp"
  fi

  echo ""
  if [ "$BUNDLE_ID_EXISTS" = 1 ]; then
    p "  This grants Full Disk Access to a private identity built only for this job"
    p "  (\"$BUNDLE_ID_NAME\"), not the shared system interpreter — unlike a raw grant,"
    p "  nothing else on the machine runs through this exact binary."
    if [ -n "$pinned" ]; then
      p "  dream also runs through a separate, still-shared python interpreter"
      p "  ($pinned) that this narrowing does not cover — add it too if you use --python."
    fi
  else
    p "  Before you do — the blast radius. macOS judges the INTERPRETER, not the script,"
    p "  so the grant would land on:"
    if [ -n "$target" ]; then
      p "    $target"
    else
      p "    the scheduled interpreter (named in the error above)"
    fi
    p "  Full Disk Access on that binary reaches EVERY program that runs through it, not"
    p "  just Heimdall. [A] avoids this entirely if moving the repo is an option."
  fi
  echo ""
  if ! ask_line "  Open System Settings at Full Disk Access now? [y/N] "; then
    p "  No answer — leaving everything as it is. Nothing was changed."
    return 0
  fi
  case "$ANSWER" in
    y|Y|yes|YES|Yes) : ;;
    *) p "  Left it alone. Nothing was changed."; return 0 ;;
  esac

  if open_pane; then
    p "  Opened System Settings > Privacy & Security > Full Disk Access."
  else
    p "  Could not open it automatically. Open it by hand:"
    p "    System Settings > Privacy & Security > Full Disk Access"
  fi
  p "  Click +, press Cmd+Shift+G, and add:"
  if [ -n "$target" ]; then
    p "    $target"
  else
    p "    the interpreter named in the error above"
  fi
  if [ "$BUNDLE_ID_EXISTS" = 1 ] && [ -n "$pinned" ]; then
    p "  and, separately, if you use --python:"
    p "    $pinned"
  fi
  p "  then switch it ON."
  echo ""
  p "  Then reload the job so launchd stops using its cached (denied) decision:"
  p "    launchctl bootout gui/$(id -u)/com.heimdall.dream 2>/dev/null"
  p "    launchctl bootstrap gui/$(id -u) $PLIST"
  echo ""
  ask_line "  Press Enter when you are done (or Ctrl-C to leave it): " || true

  # Re-probe. This is a MEASUREMENT of what is still knowable, not a verdict on his click.
  classify
  echo ""
  if [ "$STATE" != "needs-grant" ]; then
    p "  Re-checked: $REPO no longer needs a grant."
    p "  The 03:00 run should work from here. Confirm with:"
    p "    heimdall-dream-permission check --repo $REPO"
    return 0
  fi
  p "  Re-checked. I cannot tell you whether the grant landed — macOS does not let any"
  p "  program read its own permission state, which is the same restriction that stops"
  p "  hmd granting this for you. So, precisely:"
  p "    what I can still see : $REPO is inside $PROT_ROOT"
  p "                           (structural — a grant does not change it)"
  p "    what I cannot see    : whether Full Disk Access is now set for"
  p "                           $([ -n "$target" ] && printf '%s' "$target" || printf 'the scheduled interpreter')"
  p "    the proof that counts: the next scheduled run records  result: ok  in"
  p "                           $STATUS, and this ask goes quiet by itself."
  p "    check any time       : heimdall-dream-permission check --repo $REPO"
}

# ── [A] move the repo out of the protected folder ────────────────────────────────
#
# THE MOVE GETS ITS OWN CONFIRMATION, AND A LITERAL WORD. Relocating a live checkout as a
# side effect of a permission prompt would be the worst kind of helpful — so [A] prints
# paste-ready commands by default and only moves anything when he types MOVE, which no
# reflexive "y" can produce by accident.
#
# AND IT REFUSES WHEN THE MOVE WOULD BREAK THINGS. A linked worktree records an ABSOLUTE
# gitdir path, so moving the main checkout detaches every one of them at once. This repo
# routinely carries dozens. Refusing and saying why beats a helpful move that detonates
# them; `git worktree repair` can fix it afterwards, but only if he chose it knowingly.
flow_move() {
  local dest wt_count
  dest="$HOME/$(basename "$REPO")"

  echo ""
  p "  Paste-ready:"
  p "    mv $REPO $dest"
  p "    $dest/bin/heimdall-dream-schedule install --repo $dest"
  echo ""

  wt_count=0
  if command -v git >/dev/null 2>&1 && [ -d "$REPO/.git" ]; then
    wt_count="$(git -C "$REPO" worktree list 2>/dev/null | sed -n '2,$p' | grep -c . || printf '0')"
  fi
  if [ "$wt_count" -gt 0 ] 2>/dev/null && [ "$wt_count" != 0 ]; then
    p "  I will NOT move it for you: this checkout has $wt_count linked git worktree(s),"
    p "  and each one records an ABSOLUTE path back to here. Moving the main checkout"
    p "  detaches all of them at once. If you want to go ahead, run the mv yourself and"
    p "  then repair them:"
    p "    git -C $dest worktree repair"
    return 0
  fi
  if [ -e "$dest" ]; then
    p "  I will NOT move it for you: $dest already exists."
    return 0
  fi

  if ! ask_line "  Move it now? Type MOVE to confirm, anything else cancels: "; then
    p "  No answer — nothing was moved."
    return 0
  fi
  if [ "$ANSWER" != "MOVE" ]; then
    p "  Cancelled. Nothing was moved."
    return 0
  fi
  if mv "$REPO" "$dest" 2>/dev/null; then
    p "  Moved to $dest."
    p "  Now re-register the nightly job from the new location (run it yourself — this"
    p "  writes to launchd, and that should be your keystroke, not mine):"
    p "    $dest/bin/heimdall-dream-schedule install --repo $dest"
  else
    p "  Move FAILED — nothing was changed. Check permissions on $REPO and $dest."
  fi
}

# interactive_flow — put the choice to him and act on it.
interactive_flow() {
  local label
  load_bundle_identity
  label="grant Full Disk Access"
  [ "$BUNDLE_ID_EXISTS" = 1 ] && label="grant Full Disk Access to hmd-dream"
  echo ""
  if ! ask_line "  Your choice — [A] move the repo, [B] $label, [C] not now: "; then
    p "  No answer — leaving everything as it is."
    return 0
  fi
  case "$ANSWER" in
    a|A) flow_move ;;
    b|B) flow_grant ;;
    c|C|"") p "  Left as is. The 03:00 run stays blocked and Heimdall will keep saying so." ;;
    *)   p "  Not one of A, B or C — leaving everything as it is."
         p "  Run this again when you have decided:"
         p "    heimdall-dream-permission ask --repo $REPO --force" ;;
  esac
}

# ── subcommands ──────────────────────────────────────────────────────────────────
cmd_check() {
  classify
  local asked=false
  [ -f "$MARKER" ] && [ "$(marker_subject)" = "$(subject)" ] && asked=true
  if [ "$JSON" = 1 ]; then
    printf '{"schema":1,"state":"%s","reason":"%s","repo":"%s","protected_root":"%s","asked":%s,"denied_path":"%s","detail":"%s","last_attempt":"%s"}\n' \
      "$STATE" "$REASON" "$(json_escape "$REPO")" "$(json_escape "$PROT_ROOT")" \
      "$asked" "$(json_escape "$S_DENIED")" "$(json_escape "$S_DETAIL")" "$(json_escape "$S_TS")"
  else
    case "$STATE" in
      needs-grant)
        if [ "$REASON" = "interpreter-identity-changed" ]; then
          echo "needs-grant: $REPO's interpreter changed identity since the last granted run — re-grant needed"
        else
          echo "needs-grant: $REPO is inside $PROT_ROOT — the 03:00 job cannot read it"
        fi
        ;;
      granted)     echo "granted: the scheduled job has read $REPO successfully ($S_TS)" ;;
      ok)          echo "ok: $REPO is not inside a macOS-protected folder — no grant needed" ;;
      *)           echo "unknown: the protected-path predicate is unavailable (bin/lib/tcc-paths.sh)" ;;
    esac
  fi
  [ "$STATE" = "needs-grant" ] && return 1
  return 0
}

# ask — ALWAYS exits 0. It is wired into the install path and pointed at from a
# SessionStart notice; a permission prompt that can break the thing it advises about is a
# worse bug than the one it reports.
#
# --interactive-only — DEFER TO THE FIRST HUMAN INSTEAD OF SPENDING THE ASK ON NOBODY.
#
#   The published install is `curl … | bash`, and `hmd --update` can run detached. On
#   those paths the printed block is not a remedy, it is litter: it scrolls past unread,
#   and — worse — the marker records that the operator was asked. The one chance is then
#   spent, and the first person who actually sits down at a terminal is met with silence.
#   Not asking is recoverable; asking nobody is not.
#
#   So the install and update call sites pass this flag, which means: ask NOW if a human
#   is demonstrably present, otherwise do NOTHING AT ALL and leave the ask armed for the
#   moment one is. Nothing means nothing — no block, no marker, no stdin read, exit 0.
#
#   IT IS THE SAME GATE, NOT A SECOND ONE. can_prompt() is called verbatim, so there is
#   exactly one definition of "a human is here" in this file. A caller that rolled its own
#   `[ -t 0 ]` could drift from it; this cannot. And the flag only ever REMOVES the
#   printed fallback — with a real terminal the behaviour is byte-for-byte plain `ask`.
cmd_ask() {
  if [ "$INTERACTIVE_ONLY" = 1 ] && ! can_prompt; then
    return 0
  fi
  classify
  if [ "$STATE" != "needs-grant" ]; then
    # SELF-CLEARING. Dropping the marker on any non-asking state is what makes a
    # recurrence re-arm: the operator is asked again if the grant is ever lost, instead of
    # being permanently muted by a success that has stopped being true.
    rm -f "$MARKER" 2>/dev/null || true
    return 0
  fi
  # BOTH subject AND reason must match to suppress. Subject alone would let a stale
  # marker from an earlier, different-reason block silently swallow a genuinely NEW ask —
  # e.g. the original tcc-protected-repo block gets shown and marked, the operator grants
  # FDA out-of-band, and months later an unrelated rebuild triggers
  # interpreter-identity-changed: same subject, different reason, and it deserves to be
  # shown rather than muted by an ask that was about something else.
  if [ "$FORCE" != 1 ] && [ -f "$MARKER" ] \
     && [ "$(marker_subject)" = "$(subject)" ] && [ "$(marker_reason)" = "$REASON" ]; then
    return 0
  fi
  print_block
  # The marker is written BEFORE the prompt on purpose: whatever he answers — including
  # walking away — the ask has been made, and re-asking every session would be the nag
  # this feature is explicitly not. `--force` brings it back on demand, and real evidence
  # (a scheduled run recording result: ok) clears it automatically.
  write_marker
  can_prompt && interactive_flow
  return 0
}

cmd_reset() {
  rm -f "$MARKER" 2>/dev/null || true
  echo "permission ask re-armed (removed $MARKER)"
}

# open-settings — the ONLY thing in this file that touches the GUI, and it runs only when
# a human typed it. It hands a URL to macOS; macOS does the rest, and the operator does
# every part of the granting.
cmd_open_settings() {
  if ! command -v "$OPEN_BIN" >/dev/null 2>&1 && [ ! -x "$OPEN_BIN" ]; then
    echo "cannot open System Settings automatically — open it by hand:" >&2
    echo "  System Settings > Privacy & Security > Full Disk Access" >&2
    return 2
  fi
  "$OPEN_BIN" "$FDA_PANE" >/dev/null 2>&1 || {
    echo "could not open the pane — open it by hand:" >&2
    echo "  System Settings > Privacy & Security > Full Disk Access" >&2
    return 2
  }
  echo "opened System Settings > Privacy & Security > Full Disk Access"
  echo "  click +, press Cmd+Shift+G, and add the interpreter named by:"
  echo "    heimdall-dream-permission ask --force"
}

usage() { sed -n '2,50p' "$SELF" | sed 's/^# \{0,1\}//'; }

[ $# -ge 1 ] || { usage >&2; exit 2; }
CMD="$1"; shift
case "$CMD" in
  -h|--help)     usage; exit 0 ;;
  check)         parse_args "$@"; cmd_check ;;
  ask)           parse_args "$@"; cmd_ask ;;
  reset)         parse_args "$@"; cmd_reset ;;
  open-settings) cmd_open_settings ;;
  *) echo "error: unknown command: $CMD" >&2; usage >&2; exit 2 ;;
esac
