#!/usr/bin/env bash
# heimdall-app — `hmd app`, Tailscale Funnel publishing for the companion phone app
# (.planning/plans/PLAN-hmd-app-connect.md, Wave 2).
#
# Composes three Wave-1 pieces, never re-implementing their logic:
#   bin/lib/hmd_tailscale.sh   Tailscale CLI wrapper (ts_bin, ts_status_json,
#                              ts_online, ts_dns_name, ts_funnel_start/stop,
#                              ts_install_prompt, ts_login_hint, ...)
#   bin/lib/hmd_qr.py          stdlib-only QR encoder + terminal renderer
#   bin/heimdall-ui            the loopback companion web UI this publishes
#
# Usage:
#   hmd app connect [--repo DIR] [--port N] [--relay URL] [--bg] [--no-code] [--confirm] [--tmux]
#                              With no transport flag: publish through the hosted Cloudflare relay (the
#                              DEFAULT, https://hmd-relay.therishabh16.workers.dev; HMD_RELAY_URL overrides
#                              it and --relay URL overrides both) -- see the relay block below.
#                              --tailscale, --https-port and --no-install select Tailscale Funnel instead.
#   hmd app connect --tailscale [--repo DIR] [--port N] [--https-port 443|8443|10000]
#                    [--no-install] [--bg]
#                              Ensure tailscale is installed and online, start
#                              `hmd ui` on loopback (fixed port 8710 unless
#                              --port says otherwise -- exit 6 if that port is
#                              busy rather than silently picking another), then
#                              `tailscale funnel` it to the public internet. A
#                              funnel already up from a previous session is
#                              torn down first. Prints the pairing URL, a QR
#                              code of that URL, and the exposure warning,
#                              then waits in the foreground -- Ctrl-C, TERM, or
#                              HUP tears down the funnel, the ui process, and
#                              the state file. --bg returns immediately instead
#                              of waiting, leaving both running (tear down
#                              later with `hmd app disconnect`).
#   hmd app connect [--repo DIR] [--port N] [--relay URL] [--bg]
#                              Publish through a Cloudflare relay instead of
#                              Tailscale Funnel -- mutually exclusive with
#                              --https-port and --tailscale (exit 2 with either). Skips
#                              every tailscale step entirely: no install/login
#                              checks, no Funnel. Starts `hmd ui` loopback-only
#                              (no --allow-host/--trust-proxy -- the relay
#                              never proxies HTTP to it) and spawns
#                              `bin/heimdall-relay-client` against it. Prints a
#                              QR code + pairing code from the client's
#                              `pair_init` event, "phone paired" on
#                              `device_bound`, then waits in the foreground --
#                              Ctrl-C, TERM, or HUP sends the client SIGTERM
#                              (it revokes the session itself) before tearing
#                              down the ui and state files. --bg returns once
#                              pairing has started, leaving both running (tear
#                              down later with `hmd app disconnect`).
#                              PAIR BY CODE (on whenever `gh auth token` yields a
#                              token, off with --no-code): the 5-character session
#                              code the statusline shows is registered with the
#                              relay under this laptop's GitHub identity and
#                              printed as SESSION CODE -- typing it in the app
#                              pairs a phone signed in to GitHub as the same user,
#                              at once: no QR, no number to compare, no question
#                              here (with --bg too, and with no terminal). The
#                              token goes to the relay client on a pipe, once, and
#                              is on no argv, environment variable or file. The
#                              claim must name this laptop's own GitHub login or it
#                              is refused and nothing is revealed; past that the
#                              relay is trusted to deliver the right keys, and a
#                              pairing leaves a notice in the Claude session and on
#                              the statusline. --confirm asks instead: the phone
#                              shows a 6-digit number, the same number is shown
#                              here and you approve it (y/N, 60 s) -- nothing is
#                              sent to the phone until you do. It needs a terminal
#                              and cannot be combined with --bg (exit 64);
#                              --no-confirm is accepted and means the default. The
#                              code is the REPO's: the one every surface of this
#                              repo shows, whichever Claude session asks. It is kept
#                              registered while this runs -- the relay holds a
#                              registration 360 s and connect renews it on the pair
#                              window's schedule (HMD_PAIR_WINDOW_RENEW_MIN_S 300,
#                              HMD_PAIR_WINDOW_RENEW_LEAD_S 10: about every 350 s,
#                              ahead of the lapse) for up to HMD_PAIR_WINDOW_IDLE_H
#                              hours (default 0, never stop: a connect that pairs by code is
#                              watched, and when its client ends for a reason that is not
#                              final -- pairing-expired, a window that ran out, a crash, a
#                              relay that did not answer -- the next one is started after a
#                              back-off (HMD_CONNECT_RESTART_S 5, doubling to
#                              HMD_CONNECT_RESTART_MAX_S 300), so the code stays claimable
#                              for as long as connect runs, also with --bg, which leaves a
#                              watcher behind; never after `hmd app disconnect`, the phone's
#                              revoke or an auth failure, and not past an explicit
#                              HMD_PAIR_WINDOW_IDLE_H above 0, which is a bound that ends it;
#                              a phone that comes back by code is logged as "re-paired by
#                              code"; HMD_RELAY_CODE_WINDOW_S sets the
#                              seconds instead) with no phone paired, and tries a
#                              renewal the relay could not take again 30 s on
#                              (HMD_RELAY_CODE_RENEW_RETRY_S). --confirm keeps the
#                              same schedule; a phone you turn down at the compare is
#                              the exception: its window is renewed at once, as soon as
#                              HMD_RELAY_CODE_RENEW_EVENT_MIN_S (default 5) seconds
#                              after the last registration allow, so another claim can
#                              follow -- one more send of the token each. No gh, signed
#                              out, a code clash or a relay that
#                              cannot do it prints one line and leaves the QR as it
#                              was. When this repo's pair window (below) already
#                              offers the code, connect says so and leaves the code to
#                              it; --confirm stops that window first, the compare
#                              needing the code for itself. ONE phone pairs by default: once it has, the code is
#                              closed (a relay session binds one phone and releases its code at the bind) and is
#                              offered again only when that phone's client ends -- a client that crashed is replaced
#                              and its phone pairs again, logged as a re-pair. Another phone is added only on
#                              purpose, with `hmd app add-device` (below).
#                              THE PORT (--port N, default 8710; 0 = any free port) may
#                              already be held, and connect settles it by what holds it
#                              rather than failing to bind: a loopback `hmd ui` of THIS
#                              repo that no relay client is serving (one a connect left
#                              running when its client went) is reused if its /healthz
#                              answers as that process, and stopped and started afresh on
#                              the same port if it does not (an older build, stuck or
#                              stopped); one a live relay client serves is left alone and
#                              connect says to disconnect first (exit 6); anything else --
#                              another repo's ui, a published (Funnel) ui, another user's
#                              process, a foreign program -- is never signalled: the next
#                              free port above it is used, printed, and recorded in
#                              connect.json. Only a process connect can positively name is
#                              ever stopped: this user's, python running
#                              <...>/sentinels/hmd-ui.py with --repo resolving to this repo
#                              and neither --allow-host nor --trust-proxy, re-checked
#                              before each signal. (--tailscale keeps its fixed port.)
#   hmd app connect [...] --tmux
#                              Opt in to the session's own tmux pane as the delivery path for a phone message that lands while
#                              Claude Code sits idle at its prompt (either transport: add --tmux to any connect above). The wake
#                              types ONE fixed prompt, "phone message waiting", plus Enter into that pane -- a real user turn -- and
#                              the companion inbox hooks hand the session the message in that turn, marked as data from the paired
#                              phone. Nothing the phone sent is ever typed. Checked BEFORE anything starts (exit 2, one line saying
#                              why, nothing started, nothing typed): tmux is on PATH; a Claude Code session of this repo has
#                              registered (its SessionStart hook records the pane from its own TMUX_PANE/TMUX; run from inside a
#                              session only that session is considered, from another pane every registered session of the repo);
#                              the pane is on a tmux socket this user owns; and tmux itself lists the pane's process as an ancestor
#                              of that session's claude pid and as this user's. The panes go in connect.json's `tmux` list, so the
#                              opt-in lives and ends with this connect (disconnect removes it) and `hmd app status` prints a
#                              `tmux wake:` line while it is on; to change it, disconnect and connect again. What it changes: a
#                              terminal read 10-30 s ago may hold a half-typed draft, which the default answers with the exit-2 wake
#                              notice; with the opt-in that window is waited out and the prompt typed once the terminal has been
#                              quiet. A pane that cannot be proven at that moment still falls back to the notice, so a message is
#                              never stuck. It loosens no gate: the same pane proof is repeated before every key, and
#                              HMD_INBOX_WAKE=off (nothing) or =rewake (no keystrokes) in the session's environment still win.
#                              Delegates to bin/heimdall-inbox-wake (`optin` checks, `watch` types).
#   hmd app pair-window --session SID [--pid N] [--repo DIR] [--relay URL] [--transcript FILE]
#   hmd app pair-window --stop --session SID [--repo DIR]
#                              The REPO's pair-by-code window, with no terminal: the
#                              SessionStart hook (every start, resume, /clear and
#                              compact) runs the first form, the SessionEnd hook the
#                              second. The window belongs to the repo, not to a
#                              session: there is one per repo, and it offers the repo's
#                              code -- the one the statusline shows and `hmd app
#                              connect` prints, in whatever session they are run -- so
#                              the next session opens it again after a restart, and a
#                              session ending closes it only when no other session of
#                              the repo is alive and no `hmd app connect` client runs.
#                              The first form records the session
#                              (<repo>/.heimdall/app/sessions/SID.json: --pid N, the
#                              Claude process, by default the caller's parent; and
#                              --transcript FILE, an absolute path) and, when `gh` is
#                              signed in and no window is open, starts a detached
#                              supervisor that keeps a `heimdall-relay-client --code
#                              --no-confirm --code-only` registered for the code, opens
#                              a new window each time the client's own ends
#                              (HMD_PAIR_WINDOW_RESTART_S, default 5). ONE phone pairs by default: a relay session
#                              binds ONE phone, its client keeps serving it, and the code stays closed until that
#                              client ends (the phone left, or the client crashed). More phones only by `hmd app
#                              add-device`. A running `hmd app connect --confirm` keeps the window from opening
#                              beside it: it compares every phone. Stops when no
#                              recorded session has a live process and no connect client
#                              runs, on --stop of the last session, or on `hmd app
#                              disconnect`. A phone that types the code pairs at once,
#                              with the notice and no compare. gh signed out prints one
#                              line (scan the QR) and opens nothing; HMD_PAIR_WINDOW=0
#                              turns it off; an unattended session (claude -p, an hmd
#                              sub-session) gets none. `hmd hooks disable
#                              pair-window-start` opts out of the hook.
#                              Every registration of the code sends the laptop's gh token
#                              to the relay (on a pipe, over TLS). The relay keeps a
#                              registration 360 s, so the window registers no more often
#                              than every HMD_PAIR_WINDOW_RENEW_MIN_S seconds (default
#                              300), and HMD_PAIR_WINDOW_RENEW_LEAD_S (default 10) ahead
#                              of the lapse: about every 350 s, the old registration freed
#                              first, so the code is claimable all the time and the token
#                              goes out about every 5 minutes. Against a relay that keeps
#                              a registration for less than the floor the code is
#                              claimable only that long after each one. `hmd app connect`
#                              renews on this schedule while it runs.
#                              The window stops for good after HMD_PAIR_WINDOW_IDLE_H
#                              hours (default 4, 0 = never) with no phone paired by its
#                              code and no activity in ANY session of the repo -- the
#                              newest modification time among their transcripts
#                              (--transcript FILE, which the SessionStart hook passes;
#                              with none, only a pairing counts) -- and says nothing is
#                              live then: its state file and relay session go, and the
#                              next session or `hmd app connect` opens a window again.
#   hmd app identity revoke [--relay URL]
#                              Revoke every phone sign-in made with this laptop's
#                              GitHub identity (`gh auth token` is sent to the
#                              relay once, on a pipe): each phone must sign in
#                              again. Revoking the hmd GitHub App at github.com
#                              does NOT do this by itself -- a sign-in already
#                              minted stays valid until it expires or you run this.
#   hmd app status [--repo DIR]
#                              Tailscale install/online/DNSName, funnel state,
#                              the state file's contents, the public URL with
#                              its token REDACTED, and the pending companion-
#                              inbox count. Never touches or requires the real
#                              token. Exits nonzero and prints ORPHANED FUNNEL
#                              if the funnel is still up but its ui process is
#                              gone or was never on record. With phones paired
#                              (relay mode) it also prints `devices: N paired
#                              (limit 4)` and one line per phone: the label and
#                              GitHub login the relay reported for it, its id,
#                              when it paired, when it was last heard from and
#                              the capabilities it listed.
#   hmd app disconnect [--repo DIR]
#                              Stop the funnel, kill the `hmd ui` this started,
#                              remove the state file. Idempotent: a second call
#                              with nothing connected still exits 0 -- and even
#                              then a funnel-stop is always attempted, so a
#                              funnel never outlives this command.
#   hmd app disconnect [--repo DIR] --device LABEL|ID
#                              Revoke ONE phone (relay mode): its label (any case) or
#                              its id, as `hmd app status` lists them. Its relay session
#                              is revoked at the relay -- the phone's token stops working
#                              -- its record and the push registrations only it made are
#                              removed, and every other phone, the pair window and the ui
#                              are left alone. Exit 1 for a name no paired phone has, 2
#                              for one that fits several (use the id). Plain `disconnect`
#                              keeps its meaning: everything, every phone included.
#   hmd app add-device [--repo DIR] [--relay URL] [--confirm]
#                              Pair ONE more phone, on purpose. The repo pairs one phone by default and closes its
#                              code at the bind; this opens a single extra window under the same code -- registered
#                              at the relay first, then printed here with its expiry, so the code is never shown
#                              before a phone can use it -- for HMD_ADD_DEVICE_WINDOW_S seconds (default 600, at most
#                              3600), accepts exactly ONE phone, and closes: on the bind, at expiry, or on Ctrl-C.
#                              Each run admits one phone; at most 4 are paired at once (HMD_PAIR_MAX_DEVICES=1..4
#                              can only lower that; 1 refuses add-device). It needs a phone already paired (nothing
#                              to add to otherwise: the first one pairs by the code connect or the pair window
#                              offers), gh signed in, and the same GitHub account on the phone as for the first.
#                              --confirm -- or a running `hmd app connect --confirm` -- asks for the compare: the
#                              phone shows a 6-digit number, the same is shown here and you approve it (y/N, 60 s);
#                              it needs a terminal (exit 64 without one). The added phone leaves its own pairing
#                              notice in the Claude session, is listed by `hmd app status` and removed with `hmd app
#                              disconnect --device LABEL|ID` (`hmd app disconnect` ends every phone). A crashed
#                              client of an added phone is not replaced: run add-device again. Exit 0 a phone
#                              paired, 1 none did (expired, refused, nothing to add to), 2 usage or tooling, 3 gh
#                              signed out, 64 --confirm without a terminal.
#   hmd app doctor [--repo DIR] [--https-port 443|8443|10000] [--relay URL]
#                              One line per check, a fix hint on every failure.
#                              Exits 0 only if every check passes. With
#                              --relay (or when connect.json records relay
#                              mode), the tailscale-specific checks are
#                              skipped and a relay-reachability check runs
#                              instead.
#   hmd app remote-login on [--pin-next] | off | status [--repo DIR]
#                              Remote Claude Code login from the paired phone
#                              (capability login-v1). Off by default. `on` needs
#                              Claude Code signed in on this laptop and pins that
#                              account: the phone can sign the laptop in again,
#                              never into another account. With --pin-next the
#                              first successful remote login sets the pin
#                              instead. `off` switches it off and clears the pin.
#                              `status` prints the switch, the pin, the account
#                              signed in now (masked), its config directory and
#                              the last result. Delegates to
#                              bin/lib/companion_cc_login.py.
#   hmd app remote-launch on|off|status [--repo DIR]
#   hmd app remote-merge  on|off|status [--repo DIR]
#   hmd app launch-allow <repo-path> [--merge] | --remove <id> | --list
#                              The laptop-side safeguards for the phone's `expand`
#                              actions (start a Claude Code session in a repo, merge
#                              a pull request). Each switch is off until a person
#                              turns it on, and an action only reaches a repo on the
#                              launch allowlist (only one added with --merge can be
#                              merged). `on` and `launch-allow <repo-path>` refuse
#                              unless stdin is a terminal -- an agent's shell, a
#                              script and the phone have none -- and `on` also
#                              refuses under HMD_UI_CONTROLS=0 or where the repo's
#                              controls-disabled file exists. `off`, `status`,
#                              `--list` and `--remove` only reduce or read, so they
#                              need no terminal. State, all 0600:
#                              $HEIMDALL_HOME/remote-launch.json,
#                              $HEIMDALL_HOME/remote-merge.json and
#                              $HEIMDALL_HOME/app/launch-allowlist.json (the phone is
#                              shown an id and a label, never a path). `hmd app
#                              status` prints one `remote:` line with both switches
#                              and the allowlist size. Delegates to
#                              bin/lib/companion_remote_switches.py.
#   hmd app remote-dashboards on|off|status [--repo DIR]
#                              Custom dashboards from the paired phone (capability dash-v1): the phone describes a
#                              panel in words and hmd on this laptop builds a read-only data panel for it over your own
#                              connectors -- nothing runs until you confirm it here. Off by default. `on` refuses unless
#                              stdin is a terminal (an agent's shell, a script and the phone have none) and under
#                              HMD_UI_CONTROLS=0; `off` and `status` need no terminal. State, 0600:
#                              $HEIMDALL_HOME/remote-dashboards.json. `hmd app status` prints one `remote dashboards:`
#                              line (switch, tiles, pending confirmations). Delegates to
#                              bin/lib/companion_remote_switches.py; the slice and the store are bin/lib/companion_dashboards.py.
#   hmd app remote-asks on|off|status [--repo DIR]
#                              Quick asks from the paired phone and its watch (capability ask-v1): a short question about the
#                              dashboard numbers, answered in two lines from the tiles' current values, read-only -- no producer
#                              runs, nothing is queried, the coding agent is never reached. Off by default; it also needs remote
#                              dashboards on. `on` refuses unless stdin is a terminal and under HMD_UI_CONTROLS=0; `off` and
#                              `status` need no terminal. State, 0600: $HEIMDALL_HOME/remote-asks.json. `hmd app status` prints one
#                              `remote asks:` line. Delegates to bin/lib/companion_remote_switches.py; the rest is
#                              bin/lib/companion_quick_ask.py.
#   hmd app remote-alerts on|off|status [--repo DIR]
#                              Threshold alerts on a number tile (capability dash-alert-v1, which needs dash-v1): the phone
#                              sets "tell me when this number crosses X" and this laptop evaluates it after every producer
#                              run, then sends a push (kind tile_alert, capability push-tile-alert-v1) -- a sleeping laptop
#                              evaluates nothing. Off by default; needs remote dashboards on and a push registration. `on`
#                              refuses unless stdin is a terminal; `off` and `status` need no terminal. State, 0600:
#                              $HEIMDALL_HOME/remote-alerts.json. Delegates to bin/lib/companion_remote_switches.py; the
#                              alerts are bin/lib/dashboard_alerts.py.
#   hmd app controls on|off|status [--repo DIR]
#                              The paired phone's remote controls (capability
#                              controls-v1: interrupt, save-checkpoint, hook-toggle,
#                              fallback-mode). On by default. `off` is the kill
#                              switch (creates .heimdall/app/controls-disabled):
#                              every control is then refused `controls-off`;
#                              `on` removes it. HMD_UI_CONTROLS=0 in a process's
#                              environment switches it off the same way and is not
#                              undone by `on`. `status` (and `hmd app status`)
#                              prints the switch, the last control and how many
#                              are audited in .heimdall/ui/controls-audit.jsonl.
#                              Delegates to bin/lib/companion_ui_controls.py.
#   hmd app push-test [--repo DIR] [--wait SECONDS]
#                              Check that a phone registered for push receives
#                              a notification: one `test` notification per
#                              registered device, put on the phone by the SAME
#                              push sender (and the same text rules) as every
#                              real notification, then one line per device --
#                              an 8-hex fingerprint of its Expo token (never
#                              the token), its platform, and accepted /
#                              DeviceNotRegistered (the registration is then
#                              removed) / error: <code> / not sent
#                              (rate-limited). accepted means Expo queued it for
#                              APNs/FCM; the phone shows it within seconds.
#                              This command never sends: the sender is the one
#                              process per repo that holds
#                              .heimdall/app/push-sender.lock (the `hmd ui` or
#                              relay client `hmd app connect` started), and a
#                              second process taking that lock would make it
#                              drop what it detects meanwhile. So this posts a
#                              request (.heimdall/app/push-test) and that
#                              process answers it
#                              (.heimdall/app/push-test.result); no sender
#                              running = no answer. The test skips the
#                              kind filter, foreground suppression and the 5 s
#                              coalescing window (so the 10 s spacing too); it
#                              still obeys the 20-per-hour cap, the provider
#                              back-off, the lock, HMD_PUSH=0 and the
#                              loopback-only HMD_PUSH_EXPO_URL rule.
#                              --wait is how long the answer may take (1-120
#                              seconds, default 60); a sender that has not
#                              picked the request up within 10 seconds is not
#                              running. Delegates to bin/lib/companion_push_cli.py.
#                              Exit codes (push-test): 0 at least one device
#                              accepted, 1 a local fault (the request could not
#                              be written), 2 usage, 3 no device registered for
#                              push, 4 no sender picked the request up (or it did
#                              not finish in time), 5 push is switched off
#                              (HMD_PUSH=0), 6 every device failed or was held
#                              back.
#   hmd app -h|--help          This help.
#
# Exit codes (connect): 64 bad --https-port (or --confirm without a terminal, or
# with --bg), 4 tailscale not installed
# (declined the install prompt, or --no-install), 5 tailscale installed but
# not online, or its DNSName fails validation, 3 the tailnet's policy blocks
# Funnel (HTTPS certs / the Funnel node attribute aren't granted -- the CLI's
# own hint is printed VERBATIM on stderr, per hmd_tailscale.sh's
# ts_funnel_start contract), 6 `hmd ui` did not come up in time (including a
# busy fixed port), 2 a required file/flag/tool is missing or malformed (a failed --tmux check included), 9
# the installed tailscale build is macsys/App Store -- ts_variant identifies
# it and Funnel is refused before the ui ever starts (2026-09-21
# tailscale-macsys-funnel-cli-error-3: --help advertises the modern funnel
# flags on that build too, but Funnel only ever works on the open-source
# tailscaled build), 10 tailscale funnel start did not return within
# HMD_FUNNEL_START_TIMEOUT_S seconds (default 45) -- the funnel process is
# killed and torn down before returning, same as a normal Ctrl-C. Every
# ts_funnel_stop call (disconnect, and teardown after any of the above) is
# time-boxed too (HMD_FUNNEL_STOP_TIMEOUT_S, default 20), so nothing here
# can hang forever regardless of what the tailscale CLI itself does. --relay
# mode has its own two, both meaning the relay client exited before pairing
# could start: 11 relay E2E crypto is unavailable, 12 the relay was
# unreachable or pair-init failed (bin/heimdall-relay-client's own contract).
#
# State file: <repo>/.heimdall/app/connect.json
#   {"pid_ui": N, "port": N, "https_port": N, "host": "...", "started_at": "..."}
# In --relay mode the same file instead holds:
#   {"mode": "relay", "pid_ui": N, "pid_client": N, "port": N, "relay": "...",
#    "started_at": "..."}
# With --tmux either shape also holds "tmux": [{"pid": N, "pane": "%N", "socket": "/abs/path"}] -- the panes connect --tmux
# verified; the key is absent without the flag.
# and bin/heimdall-relay-client maintains its own status file,
# <repo>/.heimdall/app/relay.json:
#   {"session_id": "...", "relay": "...", "paired": bool, "bound_at": N|null,
#    "last_seq": N, "frames_sent": N, "last_delivered": "...", "pid": N,
#    "last_command_at": N|null, "started_at": N, "event_log": "..."|null}
# event_log is the durable NDJSON mirror of every event the relay client ever
# printed (HMD_RELAY_EVENT_LOG; default <repo>/.heimdall/app/relay-events.jsonl,
# null when disabled via HMD_RELAY_EVENT_LOG=""). cmd_status_relay below
# surfaces its path plus the mtime of that file (best-effort, no python3
# dependency) as "last event at" so a phone-side session has something to
# point at when asking "what did the client actually do".
# The token (tailscale mode) is NEVER written to connect.json -- it lives
# only in the one line `hmd ui` printed at startup and inside that process's
# own memory. The relay mode's pairing code / hmd_pubkey are likewise never
# written there -- only in the client's pair_init event and its own memory.
#
# Auth model: unchanged from `hmd ui` -- loopback bind, a Host allowlist
# extended with the Funnel hostname, the per-launch token, and --trust-proxy
# so the per-IP 401/403 backoff keys off Funnel's X-Forwarded-For. Funnel is a
# public TLS-terminating reverse proxy: anyone holding the printed URL's token
# can read this session and post to its inbox. Rotate by disconnecting (Ctrl-C
# or `hmd app disconnect`) and reconnecting -- that mints a fresh token.
set -uo pipefail

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
LIB_DIR="$BIN_DIR/lib"

# Self-extracting help: print the shebang-less leading comment block above, so
# the usage text lives in exactly one place. No hardcoded line range (compare
# bin/heimdall-init) -- it just prints comment lines until the first non-#
# line, which is the blank line right before `set -uo pipefail`.
usage() { awk 'NR==1{next} /^#/{print; next} {exit}' "$SELF" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

TAILSCALE_LIB="$LIB_DIR/hmd_tailscale.sh"
if [ ! -r "$TAILSCALE_LIB" ]; then
  echo "hmd app: required library not found: $TAILSCALE_LIB" >&2
  exit 2
fi
# shellcheck source=lib/hmd_tailscale.sh
# shellcheck disable=SC1091  # sourced lib is not a shellcheck input without -x
. "$TAILSCALE_LIB"

UI_BIN="${HEIMDALL_UI_BIN:-$BIN_DIR/heimdall-ui}"
INBOX_DELIVER_BIN="${HEIMDALL_INBOX_DELIVER_BIN:-$BIN_DIR/heimdall-inbox-deliver}"
INBOX_WAKE_BIN="${HEIMDALL_INBOX_WAKE_BIN:-$BIN_DIR/heimdall-inbox-wake}"
RELAY_CLIENT_BIN="${HEIMDALL_RELAY_CLIENT_BIN:-$BIN_DIR/heimdall-relay-client}"
QR_PY="$LIB_DIR/hmd_qr.py"
# The hosted relay `hmd app connect` publishes through when no transport flag says otherwise: the one origin the
# phone app ships as its default too (app.json extra.hmdRelayUrl), so a code typed on the phone and a session
# opened here meet at the same relay. HMD_RELAY_URL, then --relay URL, override it.
DEFAULT_RELAY_URL="https://hmd-relay.therishabh16.workers.dev"
SESSION_CODE_RE='^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{5}$'

PY3=""
if [ -r "$LIB_DIR/hmd-python.sh" ]; then
  # shellcheck source=lib/hmd-python.sh
  # shellcheck disable=SC1091  # sourced lib is not a shellcheck input without -x
  . "$LIB_DIR/hmd-python.sh"
  PY3="$(hmd_python 2>/dev/null || true)"
fi

# ── repo state: reached without following a link, believed only when it is ours, and never an instruction ─────────────────────
# What hmd app keeps in <repo>/.heimdall/app (connect.json, relay.json, pair-window.json, the paired-<code>.json marker) lives in a
# tree the repository controls: a cloned repo can carry `.heimdall` or `.heimdall/app` as a link, a connect.json of its own, or a
# pid that is another program's. So no such file is written, removed or read with a shell redirection, rm, test or jq on its path:
# every one goes through bin/lib/hmd_private_state.py, which walks down from the repo root a component at a time without following a
# link, writes 0600, and reads back only a regular file this user owns with no group or other permission bits (anything else is no
# state at all). And what a believed file says is data, not an instruction: it never chooses the relay (that is --relay,
# HMD_RELAY_URL or the default), a file to open, or a process to signal -- a pid is signalled only after the process itself has been
# looked at (_pid_is_heimdall_ui, _pid_is_relay_client, _pid_is_pair_window: this user's, the right program, working on THIS repo).
APP_REL=".heimdall/app"

# _state_read REPO NAME -- the file's bytes on stdout; nothing, and 1, when it is missing or not to be trusted
_state_read() {
  [ -n "$PY3" ] || return 1
  "$PY3" "$LIB_DIR/hmd_private_state.py" read --root "$1" --rel "$APP_REL" --name "$2" 2>/dev/null
}

# _state_write REPO NAME -- stdin becomes the file (0600; a link at the name is replaced, never written through); 1 when refused
_state_write() {
  [ -n "$PY3" ] || return 1
  "$PY3" "$LIB_DIR/hmd_private_state.py" write --root "$1" --rel "$APP_REL" --name "$2" 2>/dev/null
}

# _state_remove REPO NAME -- unlink the file (a link goes as a link, never followed); nothing is said when it cannot
_state_remove() {
  [ -n "$PY3" ] || return 0
  "$PY3" "$LIB_DIR/hmd_private_state.py" remove --root "$1" --rel "$APP_REL" --name "$2" >/dev/null 2>&1 || true
}

# _doc_field DOC JQ_PATH -- one field of a JSON document held in a variable: nothing when it has none
_doc_field() {
  printf '%s' "$1" | jq -r "$2 // empty" 2>/dev/null
}

# _state_mtime REPO NAME -- the modification time (epoch second) of <repo>/.heimdall/app/NAME, taken without following a link, when
# that is a regular file of this user's; nothing, and 1, otherwise
_state_mtime() {
  [ -n "$PY3" ] || return 1
  "$PY3" -I -c 'import importlib.util, sys
spec = importlib.util.spec_from_file_location("hmd_private_state", sys.argv[1])
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
st = mod.stat_file(sys.argv[2], ".heimdall/app", sys.argv[3])
if st is None:
    sys.exit(1)
print(int(st.st_mtime))' "$LIB_DIR/hmd_private_state.py" "$1" "$2" 2>/dev/null
}

# _state_read_loose REPO NAME -- the file's bytes, believed when it is a regular file of this user's that nobody else can write: the
# 0644 file an older hmd left passes, a link, another account's file or a group/world-writable one does not. Nothing, and 1, otherwise.
_state_read_loose() {
  [ -n "$PY3" ] || return 1
  "$PY3" "$LIB_DIR/hmd_private_state.py" read --root "$1" --rel "$APP_REL" --name "$2" --forbidden 022 2>/dev/null
}

# _state_mode REPO NAME -- the permission bits (four octal digits) of <repo>/.heimdall/app/NAME, taken without following a link, when
# that is a regular file of this user's; nothing, and 1, otherwise
_state_mode() {
  [ -n "$PY3" ] || return 1
  "$PY3" -I -c 'import importlib.util, sys
spec = importlib.util.spec_from_file_location("hmd_private_state", sys.argv[1])
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
st = mod.stat_file(sys.argv[2], ".heimdall/app", sys.argv[3])
if st is None:
    sys.exit(1)
print("%04o" % (st.st_mode & 0o7777))' "$LIB_DIR/hmd_private_state.py" "$1" "$2" 2>/dev/null
}

# _connect_doc REPO -- connect.json's content, or nothing and 1. A 0600 file of this user's is believed as ever. A file an older hmd
# wrote is 0644 (the shell's umask), which _state_read refuses -- and which made status say `connected: no` of a live session, and
# disconnect leave it running. Such a file is believed only while it names something this repo really runs: its relay client or its
# ui, each looked at as a process (this user's, the right program, working on THIS repo). A file a checkout planted names nothing of
# the kind, so it stays no state at all. Nothing is changed on disk: connect writes the file 0600 again, disconnect removes it.
_connect_doc() {
  local doc real
  doc="$(_state_read "$1" connect.json)" && { printf '%s' "$doc"; return 0; }
  doc="$(_state_read_loose "$1" connect.json)" || return 1
  real="$(_real_dir "$1")" || return 1
  if _pid_is_relay_client "$(_doc_field "$doc" .pid_client)" "$real" \
      || _pid_is_heimdall_ui "$(_doc_field "$doc" .pid_ui)" "$real" published; then
    printf '%s' "$doc"
    return 0
  fi
  return 1
}

# _connect_loose_note REPO -- "connect.json is mode 0644 (...)" when connect.json is a file of this user's with group or other permission
# bits (hmd app writes 0600); nothing otherwise
_connect_loose_note() {
  local mode
  mode="$(_state_mode "$1" connect.json)" || return 0
  case "${mode: -2}" in 00) return 0 ;; esac
  printf 'connect.json is mode %s (hmd app writes 0600; an older hmd wrote 0644)' "$mode"
}

# _real_dir DIR -- the real path of the directory DIR; 1 when it is not one
_real_dir() {
  (cd "$1" 2>/dev/null && pwd -P)
}

# _proc_mine PID -- 0 when PID is a live process of this user
_proc_mine() {
  local uid
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$1" 2>/dev/null || return 1
  uid="$(ps -o uid= -p "$1" 2>/dev/null | tr -d ' ')"
  [ -n "$uid" ] && [ "$uid" = "$(id -u)" ]
}

# _argv_repo PID ARGS -- the real path of the directory the command line ARGS (the part of PID's argv after the program) gives as
# `--repo`; a relative one is resolved against PID's own working directory, as the process itself resolved it. 1 when there is
# none or it is not a directory.
_argv_repo() {
  local pid="$1" val cwd real
  case " $2" in *" --repo "*) ;; *) return 1 ;; esac
  val="${2#*--repo }"
  val="${val%% --*}"
  case "$val" in
    /*) ;;
    *)
      cwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
      [ -n "$cwd" ] || return 1
      val="$cwd/$val"
      ;;
  esac
  real="$(_real_dir "$val")" || return 1
  [ -n "$real" ] || return 1
  printf '%s' "$real"
}

# _connect_state_ready REPO -- the directory connect.json goes in made (0700) or verified, without following a link, BEFORE connect
# starts anything; otherwise the one line that says why it will not start (connect's exit 2) and 1.
_connect_state_ready() {
  if [ -z "$PY3" ]; then
    echo "hmd app connect: refusing to start -- python3 not found (set HMD_PYTHON=/path/to/python3), so connect.json cannot be written safely"
    return 1
  fi
  if ! "$PY3" "$LIB_DIR/hmd_private_state.py" ensure --root "$1" --rel "$APP_REL" >/dev/null 2>&1; then
    echo "hmd app connect: refusing to start -- $1/.heimdall/app is not a plain directory of yours (a link, or another account's), so connect.json cannot be written safely"
    return 1
  fi
}

# _tmux_optin_prepare REPO -- `connect --tmux`'s check, made before anything starts (see the usage block): bin/heimdall-inbox-wake optin
# proves, with tmux's own answer, which panes are the own panes of this repo's registered sessions. On success TMUX_OPTIN holds the list
# (connect.json's `tmux` key), rebuilt here from the two validated fields -- a pane id and an absolute socket path -- plus the pid, and
# nothing else the tool printed; otherwise the one line that says why goes to stderr and the return is 1 (connect's exit 2).
_tmux_optin_prepare() {
  local out why errf
  if [ ! -x "$INBOX_WAKE_BIN" ]; then
    echo "hmd app connect --tmux: heimdall-inbox-wake not found at $INBOX_WAKE_BIN" >&2
    return 1
  fi
  errf="$(mktemp)" || { echo "hmd app connect --tmux: mktemp failed to create a temp file" >&2; return 1; }
  out="$("$INBOX_WAKE_BIN" optin --repo "$1" 2>"$errf")"
  why="$(_clean_text "$(head -c 400 "$errf")")"
  rm -f "$errf"
  TMUX_OPTIN="$(printf '%s' "$out" | jq -c 'if type == "array" and length > 0 and length <= 16 and all(.[]; type == "object"
      and (.pid | type == "number" and . > 1 and . == floor)
      and (.pane | type == "string" and test("^%[0-9]{1,9}$"))
      and (.socket | type == "string" and startswith("/") and (contains("..") | not) and (contains("\n") | not) and length < 512))
    then [.[] | {pid, pane, socket}] else empty end' 2>/dev/null)"
  if [ -z "$TMUX_OPTIN" ]; then
    echo "hmd app connect --tmux: ${why:-the wake tool gave no usable answer}" >&2
    return 1
  fi
}

# _tmux_optin_say -- one line once connect.json carries the opt-in: which panes, and the one thing that will be typed into them
_tmux_optin_say() {
  [ -n "$TMUX_OPTIN" ] || return 0
  echo "hmd app: tmux wake on -- an idle session is woken by typing \"phone message waiting\" into pane $(printf '%s' "$TMUX_OPTIN" | jq -r '[.[] | "\(.pane) (Claude Code pid \(.pid))"] | join(", ")') -- nothing the phone sends is ever typed"
}

# _status_tmux_line DOC -- `tmux wake: on -- pane %7 (Claude Code pid N)` when connect.json (DOC) carries the --tmux opt-in; nothing otherwise
_status_tmux_line() {
  local panes
  panes="$(_clean_text "$(printf '%s' "$1" | jq -r '[(.tmux // [])[] | select(type == "object") | "\(.pane) (Claude Code pid \(.pid))"] | join(", ")' 2>/dev/null)")"
  [ -n "$panes" ] && echo "tmux wake: on -- pane $panes"
  return 0
}

# ── connect()'s teardown state -- GLOBAL on purpose, never `local` ─────────
# A trap registered inside a function fires later, at actual process exit,
# after that function has already `return`ed and bash has popped its locals.
# cleanup() below is called from an EXIT/INT/TERM trap set inside cmd_connect,
# so every variable it reads must survive past cmd_connect's own return. Same
# pattern documented in test/heimdall-ui-allowhost.test.sh's launch_server(),
# which sets PORT/TOKEN/BASE/AUTH/OUT as globals "for the caller to copy out
# immediately" -- here the "caller" is the trap itself, not another function.
UI_PID=""
TMUX_OPTIN=""     # --tmux: the verified panes as connect.json's `tmux` list (JSON), "" without the flag; _relay_write_state rewrites it each time
HTTPS_PORT=""
ACTUAL_PORT=""
UI_REUSED=false   # UI_PID is a ui connect found already running and adopted, not a child of this shell
V_KIND=""         # _ui_port_verdict's answer about the port it was asked of, and the pid it names (see there)
V_PID=""
FUNNEL_UP=false
STATE_WRITTEN=false
STATE_REPO=""     # the repo whose connect.json (and, in relay mode, relay.json) this run wrote: cleanup() removes them again
REPO_REAL=""      # that repo's real path: the repo every adopted ui cleanup() may signal must be rendering
UI_OUT=""
CLEANED_UP=false
# --relay mode's own teardown state, same "GLOBAL, never local" rule as
# above -- cleanup() branches on RELAY_MODE to decide which of this block or
# the tailscale fields above it actually applies.
RELAY_MODE=false
CLIENT_PID=""
CLIENT_OUT=""
CLIENT_ERR=""
# Pair by code: the private directory the relay client's control pipe is made in. It is removed the moment both
# ends are open, so the pipe is anonymous from then on; this shell keeps the only write end open as fd 3.
CTL_DIR=""

# shellcheck disable=SC2329  # runs via the EXIT/INT/TERM traps cmd_connect installs; shellcheck does not follow them
cleanup() {
  [ "$CLEANED_UP" = true ] && return 0
  CLEANED_UP=true
  local funnel_stop_rc=0
  if [ "$RELAY_MODE" = true ]; then
    # Relay's own analogue of the funnel-stop-and-verify branch below: TERM,
    # a bounded wait, then kill-tree if it didn't leave on its own. Unlike a
    # still-public funnel, a forced kill here does NOT override this
    # process's own pending exit code -- a relay pairing session's lifetime
    # is the relay's call, not this process's. (cmd_disconnect_relay is the
    # one place a failed revoke DOES change the exit code, to 8.)
    # only a connect that wrote its own state (STATE_WRITTEN) owns the session: one refused as "already connected" started nothing and ends nobody's
    # client -- not the live session's, not a phone's whose record was made from a client older than the records
    [ "$STATE_WRITTEN" != true ] || [ -z "$STATE_REPO" ] || _stop_device_clients "$STATE_REPO" "$REPO_REAL" || true  # every phone's client (an added one too): each revokes its own relay session
    if ! _relay_stop_client "$CLIENT_PID"; then
      echo "hmd app connect: relay client had to be force-killed -- the pairing session stays open until its token expires" >&2
    fi
  elif [ "$FUNNEL_UP" = true ] && [ -n "$HTTPS_PORT" ]; then
    # A11/A13 (bin/lib/hmd_tailscale.sh D6): pass hmd's own backend port so
    # ts_funnel_stop can recognize its own target instead of conservatively
    # refusing (exit 7) to reset when it can't tell "mine" from "foreign".
    # N1: capture + verify like every other call site -- a Ctrl-C/kill/HUP
    # that fails to actually take the funnel down must never look like a
    # clean exit.
    _funnel_stop_and_verify "hmd app connect" "$HTTPS_PORT" "$ACTUAL_PORT"
    funnel_stop_rc=$?
  fi
  # An adopted ui is not this shell's child, so its pid may have been handed to another process while this ran
  # (a child's cannot be): signal it only while it still looks like a ui.
  if [ -n "$UI_PID" ] && kill -0 "$UI_PID" 2>/dev/null && { [ "$UI_REUSED" != true ] || _pid_is_heimdall_ui "$UI_PID" "$REPO_REAL"; }; then
    kill "$UI_PID" >/dev/null 2>&1 || true
    wait "$UI_PID" 2>/dev/null || true
  fi
  if [ "$STATE_WRITTEN" = true ] && [ -n "$STATE_REPO" ]; then
    _state_remove "$STATE_REPO" connect.json
    [ "$RELAY_MODE" = true ] && _state_remove "$STATE_REPO" relay.json
  fi
  if [ -n "$UI_OUT" ]; then
    rm -f "$UI_OUT" 2>/dev/null || true
  fi
  if [ -n "$CLIENT_OUT" ]; then
    rm -f "$CLIENT_OUT" 2>/dev/null || true
  fi
  if [ -n "$CLIENT_ERR" ]; then
    rm -f "$CLIENT_ERR" 2>/dev/null || true
  fi
  if [ -n "$CTL_DIR" ]; then
    rm -rf "$CTL_DIR" 2>/dev/null || true
  fi
  exec 3>&-  # the relay client's control pipe (closing an fd that was never opened is harmless)
  # N1: an explicit exit is the only way to change the process's final exit
  # code from inside an EXIT-trap handler (a plain `return` here would not
  # override whatever code was already pending) -- and for the INT/TERM/HUP
  # compound traps ("cleanup; exit N"), this short-circuits their trailing
  # exit N so a still-public funnel always wins over the signal's own code.
  # CLEANED_UP above guards the re-entry this exit triggers (calling exit
  # always re-fires the EXIT trap too) from attempting a second stop.
  if [ "$funnel_stop_rc" -ne 0 ]; then
    exit "$funnel_stop_rc"
  fi
}

resolve_repo_value() {
  # $1: --repo flag value, may be empty
  if [ -n "$1" ]; then printf '%s' "$1"; return 0; fi
  if [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then printf '%s' "$CLAUDE_PROJECT_DIR"; return 0; fi
  local top
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ]; then printf '%s' "$top"; return 0; fi
  pwd
}

# A14: verify a pid is actually one of ours before signaling it. A bare
# `kill -0 $pid` only proves SOME process holds that number -- pids recycle,
# so a stale state file can point at an unrelated process the OS handed the
# same number to later. Same `ps -o command=` / `comm=` fallback idiom as
# bin/heimdall-gc:175. heimdall-ui execs into sentinels/hmd-ui.py partway
# through startup (see bin/heimdall-ui), so a live process shows either name
# depending on how far it got.
#
# A pid read back from a state file is further not enough on its own: a number a checkout planted, or another repo's hmd, would
# pass a name match. So each of the three below asks for all of it -- the process is this user's, runs the program, and works on
# THIS repo (its `--repo` resolves to REPO_REAL, the real path of the repo) -- the check _ui_proc_repo made for a stale ui.

# _pid_is_heimdall_ui PID REPO_REAL [published] -- 0 when PID is a loopback hmd ui rendering REPO_REAL (with "published", one
# fronted by a Funnel too: --allow-host / --trust-proxy)
_pid_is_heimdall_ui() {
  local seen
  seen="$(_ui_proc_repo "$1" "${3:-}")" || return 1
  [ -n "$2" ] && [ "$seen" = "$2" ]
}

# _pid_is_relay_client PID REPO_REAL -- 0 when PID is a bin/heimdall-relay-client run with `--repo` REPO_REAL
_pid_is_relay_client() {
  local cmd seen
  _proc_mine "$1" || return 1
  cmd="$(ps -ww -o command= -p "$1" 2>/dev/null)"
  case "$cmd" in *"/heimdall-relay-client "*) ;; *) return 1 ;; esac
  seen="$(_argv_repo "$1" "${cmd#*/heimdall-relay-client }")" || return 1
  [ -n "$2" ] && [ "$seen" = "$2" ]
}

# A4: "is a public funnel actually configured right now" -- real
# `tailscale funnel status --json` (and the legacy `serve status --json`
# fallback) reports an empty `{}` object under Funnel/Serve when nothing is
# exposed, and a populated one when something is. $1, if given, is an
# already-fetched ts_funnel_status_json payload (cmd_status has one on hand);
# omitted, this fetches its own.
_funnel_looks_up() {
  local json="${1:-}"
  if [ -z "$json" ]; then
    json="$(ts_funnel_status_json 2>/dev/null)" || return 1
  fi
  printf '%s' "$json" | jq -e '
    (.Funnel // {} | length > 0) or (.Serve // {} | length > 0)
  ' >/dev/null 2>&1
}

# N1: every ts_funnel_stop call site used to swallow its result entirely
# (`>/dev/null 2>&1 || true`) -- a refusal (exit 7, D6's foreign-target
# guard), or any other failure, looked identical to success, so `disconnect`
# could print "stopped" and exit 0 while the funnel stayed publicly
# reachable. This is the one place that decides "stopped" vs "still up" for
# every call site: run the stop, show whatever it printed (never redirected
# away), then re-check reality with _funnel_looks_up instead of trusting the
# stop's own exit code. $1: a prefix for the message ("hmd app connect" /
# "hmd app disconnect"). $2: https_port. $3: backend port, may be empty.
# Returns 0 only once verified down; 7 if ts_funnel_stop itself refused and
# the funnel is still up; 8 if the stop reported success but verification
# still finds it up (e.g. a target ts_funnel_stop didn't know to clear) OR
# the stop itself timed out (HMD_FUNNEL_STOP_TIMEOUT_S, default 20s --
# 2026-09-21 tailscale-macsys-funnel-cli-error-3 established that a hung
# funnel CLI can't be trusted to fail fast either, so this can't just wait
# forever the way it used to).
_funnel_stop_and_verify() {
  local prefix="$1" https_port="$2" port="${3:-}" err rc errfile
  local stop_timeout="${HMD_FUNNEL_STOP_TIMEOUT_S:-20}"
  # A6: mktemp is required, not best-effort -- no predictable /tmp fallback
  # umask 077 while it's created ensures the file is 0600 even if mktemp's own
  # default were ever looser than that on some platform.
  if ! command -v mktemp >/dev/null 2>&1; then
    echo "hmd app disconnect: required tool missing: mktemp" >&2
    return 2
  fi
  local old_umask
  old_umask="$(umask)"
  umask 077
  errfile="$(mktemp)"
  local mktemp_rc=$?
  umask "$old_umask"
  if [ "$mktemp_rc" -ne 0 ] || [ -z "$errfile" ]; then
    echo "hmd app disconnect: mktemp failed to create a temp file" >&2
    return 2
  fi
  _run_with_timeout "$stop_timeout" ts_funnel_stop "$https_port" "$port" >/dev/null 2>"$errfile"
  rc=$?
  err="$(cat "$errfile" 2>/dev/null || true)"
  rm -f "$errfile" 2>/dev/null || true
  [ -n "$err" ] && printf '%s\n' "$err" >&2
  if ! _funnel_looks_up; then
    return 0
  fi
  if [ "$rc" -eq 124 ]; then
    printf '%s: FUNNEL STILL PUBLIC -- stop timed out after %ss -- run: HMD_FUNNEL_FORCE_RESET=1 hmd app disconnect\n' "$prefix" "$stop_timeout" >&2
    return 8
  fi
  if [ "$rc" -eq 7 ]; then
    echo "$prefix: FUNNEL STILL PUBLIC -- refused (exit 7) -- run: HMD_FUNNEL_FORCE_RESET=1 hmd app disconnect" >&2
    return 7
  fi
  printf '%s: FUNNEL STILL PUBLIC -- stop ran (exit %d) but the funnel is still reachable -- run: HMD_FUNNEL_FORCE_RESET=1 hmd app disconnect\n' "$prefix" "$rc" >&2
  return 8
}

# Relay analogue of _funnel_stop_and_verify above: SIGTERM the relay client
# so it gets a chance to POST /revoke itself, wait up to
# HMD_RELAY_STOP_TIMEOUT_S (default 15) for it to exit on its own, then kill
# its whole process tree if it didn't. $1: the client's pid (may be empty --
# a no-op then, same as a pid that's already gone). Returns 0 once the
# client is confirmed gone on its own, 8 if it had to be force-killed --
# same 0/8 convention as _funnel_stop_and_verify, so callers can treat "had
# to force it" as a soft failure without a separate code to remember.
_relay_stop_client() {
  local pid="${1:-}" sig="${2:-TERM}" timeout="${HMD_RELAY_STOP_TIMEOUT_S:-15}" waited=0
  [ -n "$pid" ] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  kill -"$sig" "$pid" 2>/dev/null || true  # TERM ends the client; USR1 revokes just its phone's session (--device)
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt "$timeout" ]; do
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    _kill_tree KILL "$pid"
    wait "$pid" 2>/dev/null || true
    return 8
  fi
  wait "$pid" 2>/dev/null || true
  return 0
}

# A6: print a file to stderr with any pairing token redacted. heimdall-ui's
# own stdout/stderr can legitimately contain the live token it just minted
# (it is the process that owns it), so any path that surfaces this file's
# contents on a failure must never echo it raw.
_print_redacted() {
  sed -E 's/token=[^ &"]+/token=<redacted>/g' "$1" 2>/dev/null || true
}

# List every live descendant of $1 (children, grandchildren, ...), one pid
# per line. Order is unspecified -- the caller signals the whole set
# together, so discovery order doesn't matter. `pgrep -P` (already relied on
# elsewhere in this file via `pkill -P`) is the same portable BSD/macOS
# primitive, just walked recursively instead of one level.
_pid_descendants() {
  local parent="$1" kid
  for kid in $(pgrep -P "$parent" 2>/dev/null || true); do
    printf '%s\n' "$kid"
    _pid_descendants "$kid"
  done
}

# Signal $2 and every descendant of it with signal $1. Best-effort
# throughout -- a pid that already exited between enumeration and kill is
# not an error.
_kill_tree() {
  local sig="$1" root="$2" p
  for p in $(_pid_descendants "$root"); do
    kill "-$sig" "$p" 2>/dev/null || true
  done
  kill "-$sig" "$root" 2>/dev/null || true
}

# 2026-09-21 tailscale-macsys-funnel-cli-error-3: a funnel start/stop can
# hang indefinitely on some tailscale builds instead of failing fast, so
# every call into the CLI that can block needs a hard wall-clock deadline.
# macOS ships neither GNU coreutils `timeout` nor `setsid`, so this can't
# rely on either -- it backgrounds the command, polls `kill -0` once a
# second, and on expiry kills the whole subtree: $pid (the wrapper subshell)
# plus every descendant it has forked by then, recursively (_kill_tree /
# _pid_descendants above) -- "$@" can itself be a function (ts_funnel_start)
# that shells out more than once, so the process actually stuck can be a
# grandchild or deeper, not just $pid's direct child (this file's own fake
# `tailscale` test fixture is one such case: its `--bg` mode hangs in a
# `sleep` that is a child of the fake binary's own shell, which is $pid's
# child -- two hops down, and a plain `pkill -P "$pid"` alone would miss
# it and leak it). TERM first, a 1s grace period, then KILL, matching
# cleanup()'s own kill-then-verify style elsewhere in this file.
# $1: budget in seconds. $2..: command + args, run with whatever
# stdout/stderr the caller already has (no redirection of its own -- a
# caller that wants output captured redirects the call itself).
# Returns the command's own exit code, or 124 (matching GNU timeout's
# convention) if the deadline hit first.
_run_with_timeout() {
  local budget="$1"
  shift
  local pid rc waited=0
  ( "$@" ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$waited" -ge "$budget" ]; then
      _kill_tree TERM "$pid"
      sleep 1
      _kill_tree KILL "$pid"
      wait "$pid" 2>/dev/null
      return 124
    fi
    sleep 1
    waited=$((waited + 1))
  done
  wait "$pid"
  rc=$?
  return "$rc"
}

# _dns_suffix_hint DNSNAME — print a hint when DNSNAME carries a Tailscale
# disambiguating "-N" numeric suffix on this box's own hostname label (an
# older node registered under the same base name is still listed, offline,
# in the tailnet -- see hmdapp docs/HANDOFF-TO-HEIMDALL-2026-09-21.md item 4:
# switching tailscaled builds got this machine a "-1" suffix instead of
# reclaiming its bare name). Hostname normalization follows the slugify
# idiom at bin/heimdall-agents:190 -- lowercased, every non-alnum char ->
# '-'. Exit 0 with the hint line on stdout when DNSNAME's first label is
# exactly "<host>-<digits>"; exit 1, silent, otherwise (no hostname
# resolved, or no suffix match).
_dns_suffix_hint() {
  local dnsname="${1:-}" raw_host host lower_dns reclaim
  [ -n "$dnsname" ] || return 1
  raw_host="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null)"
  [ -n "$raw_host" ] || return 1
  host="$(printf '%s' "$raw_host" | tr '[:upper:]' '[:lower:]')"
  host="${host//[^a-z0-9]/-}"
  [ -n "$host" ] || return 1
  lower_dns="$(printf '%s' "$dnsname" | tr '[:upper:]' '[:lower:]')"
  printf '%s' "$lower_dns" | grep -Eq -- "^${host}-[0-9]+\.[a-z0-9.-]+\.ts\.net$" || return 1
  reclaim="${host}.${lower_dns#*.}"
  printf '%s' "DNSName carries a -N suffix: an older node named ${host} is probably still registered (offline) in the tailnet admin console — remove it at https://login.tailscale.com/admin/machines and re-run 'tailscale up' to reclaim ${reclaim}"
  return 0
}

# ── pair by code: helpers (docs/superpowers/specs/2026-10-05-pair-by-session-code.md) ─────────────────────

# _clean_text TEXT -- TEXT without bytes < 0x20 (ESC among them), DEL and the two-byte UTF-8 forms of the C1
# controls (U+0080..U+009F): the escape-sequence material a phone-claimed label or a relay-supplied name could
# use to dress up this terminal. Whatever the relay client already cleaned is passed through it again before
# anything is printed.
_clean_text() {
  printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177' | LC_ALL=C sed $'s/\xc2[\x80-\x9f]//g'
}

# _safe_label TEXT -- a phone-claimed name reduced to what a notice, a status line or a log may show: letters, digits, space and - _ . ' ( ),
# 40 characters at most, on one line (the relay client reduces it the same way before it sends it on; this is the second look, for an event or
# a record something else wrote). It is shown as data and never put in a command: a device is named to the CLI by its id.
_safe_label() {
  printf '%s' "$1" | jq -Rrs 'gsub("[^\\p{L}\\p{N} ._()\u0027-]"; "") | .[0:40]' 2>/dev/null
}

# _safe_login TEXT -- a GitHub login as the relay reported it, reduced to letters, digits and hyphens (39 characters at most).
_safe_login() {
  printf '%s' "$1" | LC_ALL=C tr -cd 'A-Za-z0-9-' | cut -c1-39
}

# _gh_token_into NAME -- put this laptop's GitHub CLI token in the shell variable NAME, read from `gh auth
# token`'s own stdout pipe: never a file, never an argv, never an environment variable. Returns 1 with NAME
# empty when gh is missing, signed out, silent for 10 s, or answers something that is not token-shaped.
_gh_token_into() {
  local __var="$1" __tok=""
  printf -v "$__var" '%s' ""
  command -v gh >/dev/null 2>&1 || return 1
  IFS= read -r -t 10 __tok < <(gh auth token 2>/dev/null </dev/null) || true
  printf '%s' "$__tok" | LC_ALL=C grep -Eq '^[!-~]{1,255}$' || return 1
  printf -v "$__var" '%s' "$__tok"
}

# _session_code_for_repo REPO -- the 5-character code `hmd ui --repo REPO` shows (bin/lib/hmd_app_code.py asks
# the very function hmd ui asks, so the statusline, /api/state and the SESSION CODE printed here agree), or 1.
_session_code_for_repo() {
  local c
  [ -n "$PY3" ] && [ -r "$LIB_DIR/hmd_app_code.py" ] || return 1
  c="$("$PY3" "$LIB_DIR/hmd_app_code.py" --repo "$1" 2>/dev/null)" || return 1
  printf '%s' "$c" | grep -Eq "$SESSION_CODE_RE" || return 1
  printf '%s' "$c"
}

# _ctl_send WORD -- one line to the relay client's control pipe (fd 3): `approve` or `reject`. A pipe that has
# no reader left (the client exited) is not an error here: the exit is what the event loop reports.
_ctl_send() {
  printf '%s\n' "$1" 2>/dev/null >&3 || true
}

# ── the pair window: the repo's code, offered with no terminal (see `hmd app pair-window` above) ─────

# _session_attended -- 0 when a person is typing into this session. False for a headless `claude -p` / SDK session
# and for hmd's own sub-sessions: they share a repo, and its hooks, with the real one and must not each open a
# window (bin/heimdall-inbox-deliver's attended_session, the same rule for the same reason).
_session_attended() {
  case "${CLAUDE_CODE_ENTRYPOINT:-}" in sdk-cli|sdk-ts|sdk-py|mcp|claude-code-github-action) return 1 ;; esac
  [ -z "${HMD_AGENT_TYPE:-}" ] || return 1
  case "$(printf '%s' "${HMD_JUDGMENT:-}" | tr '[:upper:]' '[:lower:]')" in ''|0|false) return 0 ;; *) return 1 ;; esac
}

# _pw_valid_sid SID -- a Claude Code session id as a file-name-safe key (it names the session's record).
_pw_valid_sid() { printf '%s' "$1" | LC_ALL=C grep -Eq '^[A-Za-z0-9_-]{1,128}$'; }

# _pid_is_pair_window PID REPO_REAL -- 0 when PID is a `heimdall-app pair-window-loop --repo REPO_REAL`: the supervisor of THIS repo's window.
_pid_is_pair_window() {
  local cmd seen
  _proc_mine "$1" || return 1
  cmd="$(ps -ww -o command= -p "$1" 2>/dev/null)"
  case "$cmd" in *"/heimdall-app pair-window-loop "*) ;; *) return 1 ;; esac
  seen="$(_argv_repo "$1" "${cmd#*/heimdall-app pair-window-loop }")" || return 1
  [ -n "$2" ] && [ "$seen" = "$2" ]
}

# _pw_live REPO -- the repo's believed pair-window.json (a repo has one window) on stdout, and 0, while the supervisor it names is
# alive and is this repo's; otherwise 1. A believed file whose supervisor is gone is cleared on the way.
_pw_live() {
  local doc real
  doc="$(_state_read "$1" pair-window.json)" || return 1
  real="$(_real_dir "$1")" || return 1
  if _pid_is_pair_window "$(_doc_field "$doc" .pid)" "$real"; then
    printf '%s' "$doc"
    return 0
  fi
  _state_remove "$1" pair-window.json
  return 1
}

# _pair_window_holds REPO CODE -- 0 when this repo's pair window is live and offers CODE.
_pair_window_holds() {
  local doc
  doc="$(_pw_live "$1")" || return 1
  [ "$(_doc_field "$doc" .code)" = "$2" ]
}

# _pair_window_stop REPO [WAIT_S] -- TERM the live window's supervisor (it stops its client, which revokes its session, and
# removes the file itself) and wait up to WAIT_S seconds (default 20) for it to be gone; past 5 s of patience it is killed
# outright. A short WAIT_S (the SessionEnd hook's) leaves a slow clean-up to finish on its own. 1 when the repo has no live window.
_pair_window_stop() {
  local repo="$1" wait_s="${2:-20}" doc pid real steps=0 max
  doc="$(_pw_live "$repo")" || return 1
  pid="$(_doc_field "$doc" .pid)"
  real="$(_real_dir "$repo")" || return 1
  max=$((wait_s * 5))
  kill -TERM "$pid" 2>/dev/null || true
  while kill -0 "$pid" 2>/dev/null && [ "$steps" -lt "$max" ]; do
    sleep 0.2
    steps=$((steps + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    [ "$wait_s" -ge 5 ] && _pid_is_pair_window "$pid" "$real" && _kill_tree KILL "$pid"
    return 0
  fi
  _state_remove "$repo" pair-window.json
}

# _pair_window_stop_all REPO -- stop the repo's live window; prints how many it stopped (0 or 1).
_pair_window_stop_all() {
  if _pair_window_stop "$1" 20; then printf '1'; else printf '0'; fi
}

# _pair_window_stop_code REPO CODE -- stop the repo's live window when it offers CODE.
_pair_window_stop_code() {
  _pair_window_holds "$1" "$2" && _pair_window_stop "$1" 20
  return 0
}

# _sas_prompt LINE -- an `approve_request` event: show what the relay CLAIMED about the phone and the 6-digit number it shows, and answer the
# client (approve or reject, on its control pipe fd 3) from the operator's reply at the terminal: 60 s, anything but y rejects. The name is
# reduced (_safe_label) and only the number shows which phone this is. client_gone is read from the caller's scope.
_sas_prompt() {
  local line="$1" sas label login tmo ans
  [ "${client_gone:-false}" = true ] && return 0  # the client exited: nobody is left to answer
  sas="$(printf '%s' "$line" | jq -r '.sas // empty' 2>/dev/null | tr -cd '0-9')"
  label="$(_safe_label "$(printf '%s' "$line" | jq -r '.device_label // empty' 2>/dev/null)")"
  login="$(_safe_login "$(printf '%s' "$line" | jq -r '.gh_login // empty' 2>/dev/null)")"
  tmo="$(printf '%s' "$line" | jq -r '.timeout_s // 60' 2>/dev/null)"
  tmo="${tmo%%.*}"
  case "$tmo" in ''|*[!0-9]*) tmo=60 ;; esac
  [ "$tmo" -ge 1 ] || tmo=60
  echo ""
  echo "hmd app: a phone wants to pair."
  echo "  relay-claimed device name: '${label:-unnamed device}'"
  echo "  relay-claimed GitHub user: @${login:-unknown}"
  echo "  (the relay says so -- only the number below shows which phone this is)"
  echo "  The phone shows:  ${sas:0:3} ${sas:3:3}"
  if [ ! -t 0 ]; then  # --confirm needs a terminal (checked before anything starts); this keeps a prompt from ever waiting on a pipe
    echo "  No terminal to confirm at -- the pairing is rejected."
    _ctl_send reject
    return 0
  fi
  printf '  Same number on both screens? Approve [y/N]: '
  ans=""
  read -r -t "$tmo" ans || ans=""
  echo ""
  case "$ans" in
    y|Y|yes|YES|Yes) _ctl_send approve ;;
    *) _ctl_send reject ;;
  esac
}

# _relay_event LINE -- what `hmd app connect` does with one event line the relay client printed. It reads and
# sets cmd_connect_relay's own variables (pair_init_seen, pairing_exp, code_*, ...): bash scopes `local`
# dynamically, and the loop that feeds it keeps them alive for exactly as long as it needs them.
_relay_event() {
  local line="$1" ev
  ev="$(printf '%s' "$line" | jq -r '.event // empty' 2>/dev/null)"
  case "$ev" in
    pair_init)
      pair_init_seen=true
      ever_started=true
      local qr_json pcode exp remain now renewal
      qr_json="$(printf '%s' "$line" | jq -c '.qr // empty' 2>/dev/null)"
      exp="$(printf '%s' "$line" | jq -r '.exp // empty' 2>/dev/null)"
      renewal="$(printf '%s' "$line" | jq -r '.renewal // empty' 2>/dev/null)"
      [ -n "$exp" ] && pairing_exp="$exp"
      # a renewal is the SAME session code behind a fresh session: its QR is not printed again
      [ -n "$renewal" ] && return 0
      [ "$generation" -gt 1 ] && return 0  # a client started by the supervisor: nobody is shown its QR
      pcode="$(printf '%s' "$qr_json" | jq -r '.pairing_code // empty' 2>/dev/null)"
      echo ""
      if [ "$code_requested" = true ]; then
        echo "hmd app: pair a device --"
      else
        echo "hmd app: scan to pair a device --"
      fi
      echo ""
      if [ -n "$PY3" ] && [ -r "$QR_PY" ]; then
        # A5: the QR payload (session id, pairing code, pubkey) goes on
        # stdin, never argv -- same rationale as the Funnel URL above.
        printf '%s' "$qr_json" | "$PY3" "$QR_PY" --ascii || true
        echo ""
      fi
      if [ -n "$pcode" ]; then
        echo "  PAIRING CODE: $pcode"
        echo ""
      fi
      now="$(date +%s)"
      remain=60
      [ -n "$exp" ] && remain=$((exp - now))
      echo "WARNING: anyone who scans this code within ${remain}s binds a device to"
      echo "this session -- E2E-encrypted; the relay sees only ciphertext."
      echo ""
      ;;
    code_window)
      local wcode wlogin
      code_resolved=true
      code_active=true
      [ "$code_shown" = true ] && return 0
      code_shown=true
      wcode="$(_clean_text "$(printf '%s' "$line" | jq -r '.code // empty' 2>/dev/null)")"
      wlogin="$(_clean_text "$(printf '%s' "$line" | jq -r '.gh_login // empty' 2>/dev/null)")"
      echo "  SESSION CODE: $wcode"
      echo "  In the hmd app tap \"Enter code\" and type $wcode."
      echo "  Only a phone signed in to GitHub as @$wlogin can use it. It is this repo's code -- the statusline shows the same one -- renewed every few minutes while this runs."
      if [ "$CONFIRM" != true ]; then
        echo "  No number to compare: a claim must name @$wlogin, and past that the relay is trusted (--confirm asks you)."
      fi
      echo ""
      ;;
    code_unavailable)
      local reason
      code_resolved=true
      code_active=false
      reason="$(_clean_text "$(printf '%s' "$line" | jq -r '.reason // empty' 2>/dev/null)")"
      case "$reason" in
        no-gh) echo "hmd app: code pairing off — laptop not signed in to GitHub (gh auth login). Scan the QR." ;;
        conflict) echo "hmd app: code pairing off — session code $code is held by another open window of yours. Scan the QR." ;;
        disabled) echo "hmd app: code pairing off — this relay has code pairing disabled. Scan the QR." ;;
        device-limit) echo "hmd app: code pairing off — $(_dev_limit) phones are paired to this repo already (the limit). hmd app disconnect --device <label> frees a place. Scan the QR." ;;
        *) echo "hmd app: code pairing off — the relay answered ${reason:-nothing usable}. Scan the QR." ;;
      esac
      ;;
    code_window_closed)
      code_active=false
      window_closed=true
      warned_expired=true
      echo "hmd app connect: code window closed — rerun to pair" >&2
      ;;
    code_rejected)
      echo "hmd app: pairing rejected — device revoked"
      ;;
    approve_request) _sas_prompt "$line" ;;
    code_paired)
      local plabel plogin
      plabel="$(_safe_label "$(printf '%s' "$line" | jq -r '.device_label // empty' 2>/dev/null)")"
      plogin="$(_safe_login "$(printf '%s' "$line" | jq -r '.gh_login // empty' 2>/dev/null)")"
      code_active=false
      paired_announced=true  # its device_bound follows at once and is not announced a second time
      if [ "$(printf '%s' "$line" | jq -r '.repaired // empty' 2>/dev/null)" = true ]; then
        # a phone back on the code after an earlier pairing: the app's silent re-pair, which nobody else would see
        echo "hmd app: phone re-paired by code -- relay-claimed device '${plabel:-unnamed device}', GitHub @${plogin:-unknown}" >&2
      else
        echo "hmd app: phone paired via code -- relay-claimed device '${plabel:-unnamed device}', GitHub @${plogin:-unknown}"
      fi
      paired_before=true
      echo "hmd app: one phone is paired and the code is closed now. \`hmd app add-device\` opens it for ONE more (hmd app status lists the phones, hmd app disconnect --device <label> removes one)"
      ;;
    session_ended)
      ended_reason="$(printf '%s' "$line" | jq -r '.reason // empty' 2>/dev/null)"
      ;;
    device_bound)
      code_active=false
      if [ "$paired_announced" = true ]; then
        paired_announced=false
      else
        echo "hmd app: phone paired"
      fi
      ;;
    stream_drop)
      echo "hmd app: relay stream dropped -- the client will attempt to reconnect" >&2
      ;;
    error)
      local msg
      msg="$(printf '%s' "$line" | jq -r '.message // .error // empty' 2>/dev/null)"
      echo "hmd app connect: relay client error: ${msg:-$line}" >&2
      case "${msg:-$line}" in *"pair/init HTTP 401"*|*"pair/init HTTP 403"*) auth_failed=true ;; esac
      case "${msg:-$line}" in *"E2E unavailable"*) e2e_missing=true ;; esac
      ;;
    *) : ;;
  esac
}

# _relay_drain -- feed _relay_event every line the relay client has printed since the last look. The lines come
# in on fd 5 so that the operator's answer to an approval prompt is read from the real stdin.
_relay_drain() {
  local line
  while IFS= read -r -u 5 line; do
    seen_lines=$((seen_lines + 1))
    [ -n "$line" ] || continue
    _relay_event "$line"
  done 5< <(tail -n +"$((seen_lines + 1))" "$CLIENT_OUT" 2>/dev/null)
}

# ── `hmd ui` on a port something already holds ───────────────────────────────────────────────────────────────
# connect asks hmd ui for one fixed port (8710 unless --port says otherwise) and hmd ui will not share a port: it exits with
# "cannot bind". A `hmd ui` an earlier connect left running -- its relay client gone, the ui not -- used to turn every later
# connect into exit 6. _relay_start_ui settles the port by what holds it, and touches only what it can positively name:
#   nothing          a ui is started there, as before.
#   this repo's ui   a loopback-only `hmd ui` (sentinels/hmd-ui.py, this user's, --repo resolving to this repo) that no relay
#                    client is serving. ADOPTED when GET /healthz answers as that very process and it is making progress;
#                    otherwise (an older build without the route, stuck, stopped) STOPPED and a fresh ui started on the same
#                    port. One a live relay client of this repo serves is neither stale nor ours to stop: exit 6, "disconnect".
#   anything else    another repo's ui, a published (Funnel) ui, another user's process, a foreign program, a listener lsof
#                    cannot name: never signalled. The next free port above it is used, printed, and recorded in connect.json.
# Each decision is a fresh look at the port (so, after any stop too), and a bind lost to a race is retried on the next port
# instead of being trusted to the probe that came before it.

# _ui_port_ok PORT -- 0 when PORT is a fixed port (1-65535). 0 means "any free port" and cannot be held; anything else is
# left to hmd ui's own argument parsing, which refuses it as it always has.
_ui_port_ok() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "${#1}" -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# _tcp_open PORT -- 0 when something accepts a TCP connection on 127.0.0.1:PORT. One connect, given 2 s (a listener whose
# accept queue is full never answers), closed at once: the peer reads an empty request and drops it without a word.
_tcp_open() {
  [ -n "$PY3" ] || return 1
  "$PY3" -I -c 'import socket, sys
sock = socket.socket()
sock.settimeout(2)
try:
    sock.connect(("127.0.0.1", int(sys.argv[1])))
except OSError:
    sys.exit(1)
finally:
    sock.close()' "$1" 2>/dev/null
}

# _port_listeners PORT -- the pid of every process with a LISTEN socket on PORT (lsof), one per line; nothing when there is
# none or no lsof to ask.
_port_listeners() {
  command -v lsof >/dev/null 2>&1 || return 0
  lsof -nP -iTCP:"$1" -sTCP:LISTEN -Fp 2>/dev/null | sed -n 's/^p\([0-9][0-9]*\)$/\1/p'
}

# _ui_proc_repo PID [published] -- prints the real path of the repo the process PID renders, and returns 0, ONLY when PID is
# positively a loopback-only hmd ui of this user: the same uid, argv `<python> <...>/sentinels/hmd-ui.py ... --repo <dir> ...` and
# neither --allow-host nor --trust-proxy (those make a ui a published, Funnel-fronted one; "published" accepts that kind too -- the
# ui a Tailscale connect starts). A relative --repo is resolved against the process's own working directory, as the ui itself
# resolved it. Anything it cannot read as that returns 1: not ours to touch.
_ui_proc_repo() {
  local pid="$1" published="${2:-}" cmd rest
  _proc_mine "$pid" || return 1
  cmd="$(ps -ww -o command= -p "$pid" 2>/dev/null)"
  case "$(printf '%s' "${cmd%% *}" | tr '[:upper:]' '[:lower:]')" in *python*) ;; *) return 1 ;; esac
  case "$cmd" in *"/sentinels/hmd-ui.py "*) ;; *) return 1 ;; esac
  rest="${cmd#*/sentinels/hmd-ui.py }"
  if [ "$published" != published ]; then
    case " $rest " in *" --allow-host "*|*" --trust-proxy "*) return 1 ;; esac
  fi
  _argv_repo "$pid" "$rest"
}

# _ui_serves_client REPO REPO_REAL PID -- 0 when REPO's believed connect.json names PID as its ui and a live relay client OF THIS REPO
# as its client: a running session, not a leftover.
_ui_serves_client() {
  local doc
  doc="$(_connect_doc "$1")" || return 1
  [ "$(_doc_field "$doc" .pid_ui)" = "$3" ] || return 1
  _pid_is_relay_client "$(_doc_field "$doc" .pid_client)" "$2"
}

# _ui_health_ok PORT PID -- 0 when 127.0.0.1:PORT answers GET /healthz (sentinels/hmd-ui.py) as an hmd ui that IS process PID
# and is making progress: 200, ok, service hmd-ui, pid PID. A ui from before the route answers 401, a stuck or stopped one
# does not answer within 3 s: neither can be reused. The client closes with a RST: the ui binds without SO_REUSEADDR, so a
# TIME_WAIT left on its port would keep the replacement from binding the port this is about to free.
_ui_health_ok() {
  [ -n "$PY3" ] || return 1
  "$PY3" -I - "$1" "$2" <<'PYEOF'
import json, socket, struct, sys

port, pid = int(sys.argv[1]), int(sys.argv[2])
sock = socket.socket()
sock.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
healthy = False
try:
    sock.settimeout(3)
    sock.connect(("127.0.0.1", port))
    sock.sendall(("GET /healthz HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nConnection: close\r\n\r\n" % port).encode())
    raw = b""
    while len(raw) < 65536:
        chunk = sock.recv(4096)
        if not chunk:
            break
        raw += chunk
    head, _, body = raw.partition(b"\r\n\r\n")
    doc = json.loads(body.decode("utf-8"))
    healthy = (head.split(b" ", 2)[1] == b"200" and doc.get("ok") is True
               and doc.get("service") == "hmd-ui" and doc.get("pid") == pid)
except (OSError, ValueError, IndexError, AttributeError):
    healthy = False
finally:
    sock.close()
sys.exit(0 if healthy else 1)
PYEOF
}

# _ui_stop PID REPO_REAL -- stop the hmd ui PID and wait until it is gone. It is re-read as a ui of this repo before every
# signal -- a pid can be handed to another process the moment the old one exits -- and one that is no longer is left alone
# (0: nothing of ours remains). SIGCONT first, so a stopped process can act on the TERM; a process still there after
# HMD_UI_STOP_TIMEOUT_S (default 5) is killed. 0 once it is gone, 1 if it is not.
_ui_stop() {
  local pid="$1" repo_real="$2" timeout="${HMD_UI_STOP_TIMEOUT_S:-5}" steps=0 seen
  case "$timeout" in ''|*[!0-9]*) timeout=5 ;; esac
  seen="$(_ui_proc_repo "$pid")" || return 0
  [ "$seen" = "$repo_real" ] || return 0
  kill -CONT "$pid" 2>/dev/null || true
  kill -TERM "$pid" 2>/dev/null || true
  while kill -0 "$pid" 2>/dev/null && [ "$steps" -lt $((timeout * 10)) ]; do
    sleep 0.1
    steps=$((steps + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    seen="$(_ui_proc_repo "$pid")" && [ "$seen" = "$repo_real" ] && kill -KILL "$pid" 2>/dev/null
    steps=0
    while kill -0 "$pid" 2>/dev/null && [ "$steps" -lt 20 ]; do
      sleep 0.1
      steps=$((steps + 1))
    done
  fi
  ! kill -0 "$pid" 2>/dev/null
}

# _ui_port_verdict REPO REPO_REAL PORT -- sets V_KIND (and V_PID) from a fresh look at 127.0.0.1:PORT:
#   free    nothing listens there
#   reuse   a loopback hmd ui of REPO_REAL (V_PID), no relay client serving it, healthy
#   stale   the same, but not healthy: an older build, stuck, stopped
#   live    the same, and REPO's connect.json shows a live relay client serving it
#   other   anything else, or a listener that cannot be named: never touched
_ui_port_verdict() {
  local repo="$1" repo_real="$2" port="$3" listeners pid prepo
  V_KIND="" V_PID=""
  listeners="$(_port_listeners "$port")"
  if [ -z "$listeners" ] && ! _tcp_open "$port"; then
    V_KIND=free
    return 0
  fi
  pid="$listeners"
  if [ "$(printf '%s\n' "$listeners" | grep -c .)" -ne 1 ] || ! prepo="$(_ui_proc_repo "$pid")" || [ "$prepo" != "$repo_real" ]; then
    V_KIND=other
    return 0
  fi
  V_PID="$pid"
  if _ui_serves_client "$repo" "$repo_real" "$pid"; then
    V_KIND=live
  elif _ui_health_ok "$port" "$pid"; then
    V_KIND=reuse
  else
    V_KIND=stale
  fi
}

# _ui_next_free_port PORT -- prints the first port above PORT that nothing listens on (looks at up to 200); 1 when none.
_ui_next_free_port() {
  local p="$1" i=0
  while [ "$i" -lt 200 ] && [ "$p" -lt 65535 ]; do
    p=$((p + 1))
    i=$((i + 1))
    [ -n "$(_port_listeners "$p")" ] && continue
    _tcp_open "$p" && continue
    printf '%s' "$p"
    return 0
  done
  return 1
}

# _ui_stop_superseded REPO REPO_REAL PORT -- stop the hmd uis an earlier connect left behind for THIS repo on any OTHER port:
# detached (ppid 1), loopback-only, no relay client serving them. The port-based decisions below only ever look at PORT, so a
# ui on 8711 stayed up -- re-running hooks/identity/agents every poll for nothing -- once connect had moved on to 8713 (handoff
# 2026-10-11). The ui on PORT itself is left to those decisions (reused, replaced or refused). bin/lib/hmd_ui_procs.py does the
# identification and the stop (SIGTERM, wait, SIGKILL); it never signals anything it cannot positively name. Best effort: 0 always.
_ui_stop_superseded() {
  local helper="$LIB_DIR/hmd_ui_procs.py" line timeout="${HMD_UI_STOP_TIMEOUT_S:-5}"
  local -a keep=()
  [ -n "$PY3" ] && [ -n "$2" ] && [ -r "$helper" ] || return 0
  case "$timeout" in ''|*[!0-9]*) timeout=5 ;; esac
  _ui_port_ok "$3" && keep=(--keep-port "$3")
  while IFS= read -r line; do
    case "$line" in
      reaped\ *)   echo "hmd app connect: stopped a superseded hmd ui left behind for this repo (${line#reaped })" >&2 ;;
      SURVIVED\ *) echo "hmd app connect: a superseded hmd ui did not stop (${line#SURVIVED })" >&2 ;;
    esac
  done < <("$PY3" -I "$helper" supersede --repo "$2" ${keep[@]+"${keep[@]}"} --timeout "$timeout" 2>/dev/null)
  return 0
}

# _relay_start_ui REPO PORT -- bring up (or adopt) the loopback hmd ui cmd_connect_relay reports against; the policy is the
# block comment above. Sets UI_PID, ACTUAL_PORT and UI_REUSED; UI_OUT is the ui's own output. 0 when a ui is up, 6 with the
# reason already printed when none can be.
_relay_start_ui() {
  local repo="$1" port="$2" wanted="$2" repo_real="" tries=0 stops=0 next url_line waited
  local url_re='^http://127\.0\.0\.1:[0-9]+/\?token='
  repo_real="$(cd "$repo" 2>/dev/null && pwd -P)" || repo_real=""
  UI_REUSED=false
  _ui_stop_superseded "$repo" "$repo_real" "$port"
  while [ "$tries" -lt 12 ]; do
    tries=$((tries + 1))
    if [ -n "$repo_real" ] && _ui_port_ok "$port"; then
      _ui_port_verdict "$repo" "$repo_real" "$port"
      [ "$V_KIND" = stale ] && [ "$stops" -ge 2 ] && V_KIND=other
      if [ "$V_KIND" = reuse ]; then
        UI_PID="$V_PID"
        ACTUAL_PORT="$port"
        UI_REUSED=true
        echo "hmd app: reusing the hmd ui already running for this repo (pid $UI_PID, port $port)"
        return 0
      elif [ "$V_KIND" = live ]; then
        echo "hmd app connect: this repo is already connected -- its hmd ui (pid $V_PID, port $port) is served by a live relay client; run 'hmd app disconnect' first" >&2
        return 6
      elif [ "$V_KIND" = stale ]; then
        stops=$((stops + 1))
        echo "hmd app connect: the hmd ui for this repo on port $port (pid $V_PID) is not answering as a working one -- stopping it to start a fresh one" >&2
        _ui_stop "$V_PID" "$repo_real" || echo "hmd app connect: hmd ui pid $V_PID did not stop" >&2
        continue
      elif [ "$V_KIND" = other ]; then
        if ! next="$(_ui_next_free_port "$port")"; then
          echo "hmd app connect: port $port is held by another process and no free port was found above it" >&2
          return 6
        fi
        port="$next"
        continue
      fi
    fi
    : >"$UI_OUT"
    # Loopback only -- no --allow-host/--trust-proxy. Unlike the tailscale path, nothing ever proxies public HTTP
    # traffic to this port: the relay client talks to the relay itself and reads ui state over loopback, so
    # heimdall-ui's trust boundary never needs extending to a public hostname.
    (
      cd "$repo" 2>/dev/null || exit 2
      HEIMDALL_WATCH_ROOT="$repo" exec "$UI_BIN" --repo "$repo" --port "$port" --no-open
    ) >"$UI_OUT" 2>&1 &
    UI_PID=$!
    url_line="" waited=0
    while [ "$waited" -lt 100 ]; do
      kill -0 "$UI_PID" 2>/dev/null || break
      url_line="$(grep -E "$url_re" "$UI_OUT" 2>/dev/null | head -1)"
      [ -n "$url_line" ] && break
      sleep 0.1
      waited=$((waited + 1))
    done
    if [ -z "$url_line" ]; then
      if kill -0 "$UI_PID" 2>/dev/null; then
        echo "hmd app connect: heimdall-ui did not print a URL within 10s:" >&2
      else
        wait "$UI_PID" 2>/dev/null
        if _ui_port_ok "$port" && grep -q 'cannot bind' "$UI_OUT" 2>/dev/null && next="$(_ui_next_free_port "$port")"; then
          UI_PID=""   # the port was taken between the look and the bind: that ui is gone, ask the next port
          port="$next"
          continue
        fi
        echo "hmd app connect: heimdall-ui exited before it started listening:" >&2
      fi
      _print_redacted "$UI_OUT" >&2
      return 6
    fi
    ACTUAL_PORT="$(printf '%s' "$url_line" | sed -E 's#^http://127\.0\.0\.1:([0-9]+)/.*#\1#')"
    if _ui_port_ok "$wanted" && [ "$ACTUAL_PORT" != "$wanted" ]; then
      echo "hmd app: port $wanted is held by something else -- using port $ACTUAL_PORT instead (recorded in connect.json)"
    fi
    return 0
  done
  echo "hmd app connect: could not start heimdall-ui after $tries attempts" >&2
  return 6
}

cmd_connect() {
  local REPO="" PORT="8710" NO_INSTALL=false BG=false
  local RELAY_URL="" RELAY_SET=false HTTPS_PORT_SET=false TAILSCALE=false NO_CODE=false NO_CONFIRM=false CONFIRM=false TMUX_WAKE=false
  HTTPS_PORT="443"
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        REPO="${2:-}"
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      --port)
        PORT="${2:-}"
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      --https-port)
        HTTPS_PORT="${2:-}"
        HTTPS_PORT_SET=true
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      --relay)
        RELAY_URL="${2:-}"
        RELAY_SET=true
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      --tailscale) TAILSCALE=true; shift ;;
      --no-code) NO_CODE=true; shift ;;
      --confirm) CONFIRM=true; shift ;;
      --no-confirm) NO_CONFIRM=true; shift ;;  # the default since pairing by code stopped asking; kept so old command lines work
      --no-install) NO_INSTALL=true; shift ;;
      --bg) BG=true; shift ;;
      --tmux) TMUX_WAKE=true; shift ;;
      *) echo "hmd app connect: unknown flag: $1" >&2; return 2 ;;
    esac
  done
  REPO="$(resolve_repo_value "$REPO")"

  if [ "$RELAY_SET" = true ] && [ -z "$RELAY_URL" ]; then
    echo "hmd app connect: --relay needs a URL" >&2
    return 2
  fi
  if [ -n "$RELAY_URL" ] && [ "$HTTPS_PORT_SET" = true ]; then
    echo "hmd app connect: --relay and --https-port are mutually exclusive" >&2
    return 2
  fi
  if [ -n "$RELAY_URL" ] && [ "$TAILSCALE" = true ]; then
    echo "hmd app connect: --relay and --tailscale are mutually exclusive" >&2
    return 2
  fi
  # The relay is the default transport (the hosted one unless HMD_RELAY_URL or --relay says otherwise); a flag
  # only Tailscale Funnel understands -- --tailscale itself, --https-port, --no-install -- selects Funnel.
  if [ -z "$RELAY_URL" ] && [ "$TAILSCALE" != true ] && [ "$HTTPS_PORT_SET" != true ] && [ "$NO_INSTALL" != true ]; then
    RELAY_URL="${HMD_RELAY_URL:-$DEFAULT_RELAY_URL}"
  fi
  if [ -z "$RELAY_URL" ] && { [ "$NO_CODE" = true ] || [ "$CONFIRM" = true ] || [ "$NO_CONFIRM" = true ]; }; then
    echo "hmd app connect: --no-code, --confirm and --no-confirm belong to the relay transport, not Tailscale Funnel" >&2
    return 2
  fi
  if [ "$CONFIRM" = true ] && [ "$NO_CONFIRM" = true ]; then
    echo "hmd app connect: --confirm and --no-confirm are mutually exclusive" >&2
    return 2
  fi
  if [ "$CONFIRM" = true ] && [ "$NO_CODE" = true ]; then
    echo "hmd app connect: --confirm compares a phone that pairs by code; it cannot be combined with --no-code" >&2
    return 2
  fi

  # --tmux is checked before anything starts: a refusal (exit 2) leaves nothing to tear down
  TMUX_OPTIN=""
  if [ "$TMUX_WAKE" = true ]; then
    _tmux_optin_prepare "$REPO" || return 2
  fi

  if [ -n "$RELAY_URL" ]; then
    RELAY_MODE=true
    cmd_connect_relay "$REPO" "$PORT" "$BG" "$RELAY_URL" "$NO_CODE" "$CONFIRM"
    return $?
  fi

  case "$HTTPS_PORT" in
    443|8443|10000) : ;;
    *)
      echo "hmd app connect: --https-port must be 443, 8443, or 10000 (got '$HTTPS_PORT')" >&2
      return 64
      ;;
  esac

  if [ ! -x "$UI_BIN" ]; then
    echo "hmd app connect: heimdall-ui not found at $UI_BIN" >&2
    return 2
  fi

  if ! ts_installed; then
    if [ "$NO_INSTALL" = true ]; then
      ( HMD_ASSUME_NO=1 ts_install_prompt ) || true
      return 4
    fi
    # No redirection: D1 requires the prompt to never be silent, and read -r
    # inside ts_install_prompt must see connect's real stdin. In a
    # non-interactive context (closed/empty stdin) the read fails and
    # ts_install_prompt takes its own decline branch -- exit 4 below either
    # way, since "still not installed" is exit 4 regardless of why.
    ts_install_prompt || true
    if ! ts_installed; then
      return 4
    fi
  fi

  if ! ts_online; then
    ts_login_hint
    return 5
  fi

  local host
  host="$(ts_dns_name 2>/dev/null || true)"
  if [ -z "$host" ]; then
    echo "hmd app connect: tailscale is online but has no DNSName yet -- wait a few seconds and retry, or check 'tailscale status'" >&2
    return 5
  fi
  # A12: DNSName comes back from `tailscale status`, an external process --
  # it becomes an --allow-host value passed straight to heimdall-ui, so it is
  # validated as a trust-boundary input, not assumed well-formed.
  if ! printf '%s' "$host" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*\.ts\.net$'; then
    echo "hmd app connect: tailscale returned a DNSName that fails validation: '$host'" >&2
    return 5
  fi

  # 2026-09-21 tailscale-macsys-funnel-cli-error-3: --help still advertises
  # the modern funnel flag syntax on the macsys/App Store Tailscale build,
  # but Funnel only ever works on the open-source tailscaled build -- refuse
  # here, before the ui (or anything else) ever starts, rather than let
  # ts_funnel_start hang or fail deep into a connect attempt. ts_funnel_start
  # itself refuses too (exit 9), but only after the ui is already up; this
  # is what keeps that case from ever reaching the ui at all.
  case "$(ts_variant 2>/dev/null || echo unknown)" in
    macsys|appstore)
      echo "hmd app connect: tailscale build variant does not support Funnel -- install the open-source build: brew install tailscale (then: tailscale up)" >&2
      return 9
      ;;
  esac

  # A4(d): a funnel can already be up from a session this repo's state file
  # no longer knows about (a crash, a manual rm, a prior bug) -- connect must
  # never layer a new funnel on top of a stale one.
  if _funnel_looks_up; then
    echo "hmd app connect: a funnel from a previous session is still up -- tearing it down first" >&2
    # A11/A13: the stale session's own backend port, if this repo's state
    # file still names one -- lets ts_funnel_stop recognize it as hmd's own
    # target rather than conservatively refusing (exit 7) to reset it. Same
    # empty-on-miss jq idiom as cmd_disconnect/cmd_status below; no -f guard
    # needed since jq's own "file not found" stderr is redirected away and
    # an empty result behaves identically to the port being unknown.
    local stale_port=""
    stale_port="$(_doc_field "$(_connect_doc "$REPO")" .port)"
    _ui_port_ok "$stale_port" || stale_port=""
    # N1: best-effort here, deliberately -- surfaces the same loud warning
    # and never claims success it doesn't have, but a stale funnel that
    # won't clear must not block a fresh connect attempt; cmd_status's
    # ORPHANED FUNNEL check is the backstop for whatever this can't.
    _funnel_stop_and_verify "hmd app connect" "$HTTPS_PORT" "$stale_port" || true
  fi

  # the state directory is made (or refused) before anything is started: a link on the way to connect.json is no place to write
  _connect_state_ready "$REPO" || return 2
  REPO_REAL="$(_real_dir "$REPO")"
  STATE_REPO="$REPO"

  # A6: mktemp is required, not best-effort -- the old fallback
  # (/tmp/hmd-app-ui.$$.out) is a predictable, symlink-plantable path. umask
  # 077 while it's created means the file is 0600 even if mktemp's own
  # default were ever looser than that on some platform.
  if ! command -v mktemp >/dev/null 2>&1; then
    echo "hmd app connect: required tool missing: mktemp" >&2
    return 2
  fi
  local old_umask
  old_umask="$(umask)"
  umask 077
  UI_OUT="$(mktemp)"
  local mktemp_rc=$?
  umask "$old_umask"
  if [ "$mktemp_rc" -ne 0 ] || [ -z "$UI_OUT" ]; then
    echo "hmd app connect: mktemp failed to create a temp file" >&2
    return 2
  fi
  (
    cd "$REPO" 2>/dev/null || exit 2
    HEIMDALL_WATCH_ROOT="$REPO" exec "$UI_BIN" --repo "$REPO" --port "$PORT" --no-open --allow-host "$host" --trust-proxy
  ) >"$UI_OUT" 2>&1 &
  UI_PID=$!

  # From here on, teardown must happen even on Ctrl-C / kill / normal exit.
  trap 'cleanup; exit 130' INT
  trap 'cleanup; exit 143' TERM
  trap 'cleanup; exit 129' HUP
  trap cleanup EXIT

  local url_re='^http://127\.0\.0\.1:[0-9]+/\?token='
  local waited=0 url_line=""
  while [ "$waited" -lt 100 ]; do
    if ! kill -0 "$UI_PID" 2>/dev/null; then
      echo "hmd app connect: heimdall-ui exited before it started listening:" >&2
      _print_redacted "$UI_OUT" >&2
      return 6
    fi
    url_line="$(grep -E "$url_re" "$UI_OUT" 2>/dev/null | head -1)"
    [ -n "$url_line" ] && break
    sleep 0.1
    waited=$((waited + 1))
  done
  if [ -z "$url_line" ]; then
    echo "hmd app connect: heimdall-ui did not print a URL within 10s:" >&2
    _print_redacted "$UI_OUT" >&2
    return 6
  fi

  local actual_port token
  actual_port="$(printf '%s' "$url_line" | sed -E 's#^http://127\.0\.0\.1:([0-9]+)/.*#\1#')"
  token="$(printf '%s' "$url_line" | sed -E 's#^[^?]*\?token=##')"
  ACTUAL_PORT="$actual_port"

  local start_timeout="${HMD_FUNNEL_START_TIMEOUT_S:-45}"
  _run_with_timeout "$start_timeout" ts_funnel_start "$actual_port" "$HTTPS_PORT"
  local frc=$?
  if [ "$frc" -eq 124 ]; then
    # The start hung past its budget -- we can't tell whether tailscaled
    # partially applied it before being killed, so assume it might have
    # (FUNNEL_UP=true) and let cleanup()'s own time-boxed stop-and-verify
    # settle it, same as a Ctrl-C mid-connect would.
    echo "hmd app connect: funnel start timed out after ${start_timeout}s -- run hmd app doctor" >&2
    FUNNEL_UP=true
    return 10
  elif [ "$frc" -eq 3 ]; then
    echo "hmd app connect: run 'hmd app doctor' for diagnostics." >&2
    return 3
  elif [ "$frc" -ne 0 ]; then
    echo "hmd app connect: tailscale funnel failed (exit $frc)" >&2
    return "$frc"
  fi
  FUNNEL_UP=true

  local pub_url
  if [ "$HTTPS_PORT" = "443" ]; then
    pub_url="https://$host/?token=$token"
  else
    pub_url="https://$host:$HTTPS_PORT/?token=$token"
  fi

  if jq -n \
    --argjson pid_ui "$UI_PID" \
    --argjson port "$actual_port" \
    --argjson https_port "$HTTPS_PORT" \
    --arg host "$host" \
    --arg started_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson tmux "${TMUX_OPTIN:-null}" \
    '{pid_ui: $pid_ui, port: $port, https_port: $https_port, host: $host, started_at: $started_at}
      + (if $tmux == null then {} else {tmux: $tmux} end)' \
    | _state_write "$REPO" connect.json; then
    STATE_WRITTEN=true
    _tmux_optin_say
  else
    echo "hmd app connect: connect.json could not be written -- tearing down" >&2
    return 2
  fi

  echo ""
  echo "hmd app: connected -- public URL:"
  echo "  $pub_url"
  echo ""
  local dns_hint
  dns_hint="$(_dns_suffix_hint "$host")"
  if [ -n "$dns_hint" ]; then
    echo "$dns_hint"
    echo ""
  fi
  if [ -n "$PY3" ] && [ -r "$QR_PY" ]; then
    # A5: the pairing URL (with its live token) goes on stdin, never argv --
    # argv is visible to any local user via `ps`, stdin is not.
    printf '%s' "$pub_url" | "$PY3" "$QR_PY" --ascii || true
    echo ""
  fi
  echo "WARNING: this URL is reachable from the public internet. Anyone who has"
  echo "it can read this session and post messages to its inbox. Rotate access"
  echo "by disconnecting (Ctrl-C, or 'hmd app disconnect') and reconnecting --"
  echo "that mints a fresh token."
  echo ""

  if [ "$BG" = true ]; then
    echo "hmd app: running in background (ui pid $UI_PID). Tear down with: hmd app disconnect"
    trap - INT TERM EXIT
    disown "$UI_PID" 2>/dev/null || true
    rm -f "$UI_OUT" 2>/dev/null || true
    return 0
  fi

  echo "hmd app: waiting -- press Ctrl-C to disconnect and stop."
  local ui_rc=0
  wait "$UI_PID"
  ui_rc=$?
  return "$ui_rc"
}

# ── `hmd app connect` keeps the relay client it pairs by code with up ─────────────────────────────────────────────────────────────
# A client that ended at pairing-expired after its window left the phone unable to pair until someone noticed. A connect that pairs by
# code (not --confirm, which is attended at its terminal; not QR-only, whose QR nobody else sees) now watches its client and starts the
# next one when it ends for a reason that is not final, after a back-off. The helpers below read and set cmd_connect_relay's own
# locals (dynamic scope, as _relay_event does): supervise, ever_started, ended_reason, fails, generation, started_ts, ...
#   final     the client said local-disconnect (hmd app disconnect, a signal), revoked or ended (the phone's revoke); the relay answered
#             its /pair/init 401 or 403, or the stream 401 (an auth failure); there is no E2E (another try changes nothing); the
#             operator bounded the window (HMD_PAIR_WINDOW_IDLE_H above 0) and it closed; connect.json is no longer this run's (a
#             disconnect ran, or a newer connect took over); ten starts in a row each ended within 30 s.
#   anything  else -- pairing-expired, a window that ran out, a crash, a relay that did not answer -- is followed by a new client:
#             --code-only, the same code behind a new session, after HMD_CONNECT_RESTART_S seconds (default 5) doubled with each end
#             that came within 30 s of its start, up to HMD_CONNECT_RESTART_MAX_S (default 300).
# _relay_write_state -- connect.json for the ui and client that run now
_relay_write_state() {
  jq -n --argjson pid_ui "$UI_PID" --argjson pid_client "$CLIENT_PID" --argjson port "$actual_port" --arg relay "$RELAY_URL" \
    --arg started_at "$relay_started_at" --argjson tmux "${TMUX_OPTIN:-null}" --arg confirm "${CONFIRM:-false}" \
    '{mode: "relay", pid_ui: $pid_ui, pid_client: $pid_client, port: $port, relay: $relay, started_at: $started_at}
      + (if $tmux == null then {} else {tmux: $tmux} end)
      + (if $confirm == "true" then {confirm: true} else {} end)' \
    | _state_write "$REPO" connect.json
}

# _relay_still_mine -- 0 while connect.json is this run's (it names this run's ui)
_relay_still_mine() {
  [ "$(_doc_field "$(_connect_doc "$REPO")" .pid_ui)" = "$UI_PID" ]
}

# _relay_respawn -- start the next relay client: --code-only (it ends with a code that says whether another try can do better, as the
# pair window's does), the GitHub token read again and handed over on a private pipe exactly as the first was, connect.json naming it.
# 1 when it could not be started or connect.json is no longer this run's.
_relay_respawn() {
  local tok="" ctl win_s min_s lead_s event_s repaired=""
  [ "$paired_before" = true ] && repaired=1
  if ! _gh_token_into tok; then
    echo "hmd app connect: laptop not signed in to GitHub (gh auth login) -- the code cannot be offered again" >&2
    return 1
  fi
  ctl="$(umask 077; mktemp -d)" || return 1
  if ! mkfifo "$ctl/in" 2>/dev/null; then
    rm -rf "$ctl"
    return 1
  fi
  exec 3<>"$ctl/in"
  exec 4<"$ctl/in"
  rm -rf "$ctl"
  read -r win_s min_s lead_s event_s <<<"$(_connect_window_knobs false)"
  : >"$CLIENT_OUT"
  : >"$CLIENT_ERR"
  HMD_RELAY_REPAIRED="$repaired" HMD_RELAY_CODE_WINDOW_S="$win_s" HMD_RELAY_CODE_RENEW_MIN_S="$min_s" HMD_RELAY_CODE_RENEW_LEAD_S="$lead_s" \
    HMD_RELAY_CODE_RENEW_EVENT_MIN_S="$event_s" \
    "$RELAY_CLIENT_BIN" "${client_args[@]}" --code-only <&4 3>&- 4>&- >"$CLIENT_OUT" 2>"$CLIENT_ERR" &
  CLIENT_PID=$!
  exec 4<&-
  printf '%s\n' "$tok" >&3
  tok=""
  exec 3>&-
  generation=$((generation + 1))
  started_ts="$(date +%s)"
  seen_lines=0 pair_init_seen=false code_resolved=false code_active=false client_gone=false
  ended_reason="" auth_failed=false e2e_missing=false window_closed=false self_stopped=false
  _relay_write_state || return 1
  _relay_still_mine
}

# _relay_supervise_step -- the client is gone (client_rc, and what its events said): 0 once the next one runs, 1 when connect is over
_relay_supervise_step() {
  local ran delay
  [ "$supervise" = true ] && [ "$ever_started" = true ] || return 1
  if [ "$self_stopped" != true ]; then
    case "$ended_reason" in local-disconnect|revoked|ended) return 1 ;; esac
  fi
  case "$ended_reason" in stream-401) return 1 ;; esac
  [ "$auth_failed" = true ] && return 1
  [ "$e2e_missing" = true ] && return 1
  if [ "$window_closed" = true ] && _connect_capped; then return 1; fi
  _relay_still_mine || { STATE_WRITTEN=false; return 1; }
  ran=$(( $(date +%s) - started_ts ))
  if [ "$ran" -ge 30 ]; then fails=0; else fails=$((fails + 1)); fi
  if [ "$fails" -ge 10 ]; then
    echo "hmd app connect: the relay client ended $fails times in a row within 30 s of its start -- not starting another; run hmd app connect again" >&2
    return 1
  fi
  delay="$restart_s"
  [ "$fails" -gt 1 ] && delay=$(( restart_s * (1 << (fails - 1)) ))
  [ "$delay" -gt "$restart_max_s" ] && delay="$restart_max_s"
  echo "hmd app connect: the relay client ended (${ended_reason:-exit $client_rc}) -- starting another in ${delay}s so the code stays claimable" >&2
  _pw_nap "$delay"
  _relay_still_mine || { STATE_WRITTEN=false; return 1; }
  if ! _relay_respawn; then
    _relay_stop_client "$CLIENT_PID" || true
    return 1
  fi
  return 0
}

# _relay_loop HANDOFF -- the wait loop of cmd_connect_relay: renders the client's events, returns 0 once `--bg` (HANDOFF true) has what
# it came for, and returns 10 when the client is gone for good (or, with nothing to supervise, gone at all).
_relay_loop() {
  local handoff="$1" now2
  while :; do
    if ! kill -0 "$CLIENT_PID" 2>/dev/null; then
      wait "$CLIENT_PID" 2>/dev/null
      client_rc=$?
      client_gone=true
      _relay_drain  # whatever it printed between the last look and its exit
      _relay_supervise_step && continue
      return 10
    fi

    _relay_drain

    # a window that ran out is followed by the next one at once, not when the relay ends the unclaimed session a minute on: the client
    # is asked to stop, which revokes its session and frees the code
    if [ "$supervise" = true ] && [ "$window_closed" = true ] && [ "$self_stopped" != true ] && ! _connect_capped; then
      self_stopped=true
      _relay_stop_client "$CLIENT_PID" || true
      continue
    fi

    # --bg returns once pairing has started -- and, when a code was asked for, once the relay has answered
    # for it (or 30 s have passed), so the SESSION CODE is on screen before this leaves.
    if [ "$pair_init_seen" = true ] && [ "$handoff" = true ] \
        && { [ "$code_requested" != true ] || [ "$code_resolved" = true ] || [ "$(date +%s)" -ge "$bg_code_deadline" ]; }; then
      return 0
    fi

    if [ "$pair_init_seen" = true ] && [ "$warned_expired" = false ] && [ "$code_active" != true ] && [ "$pairing_exp" -gt 0 ] && [ "$supervise" != true ]; then
      now2="$(date +%s)"
      if [ "$now2" -gt $((pairing_exp + 5)) ]; then
        echo "hmd app connect: pairing code expired -- Ctrl-C and reconnect to mint a new one" >&2
        warned_expired=true
      fi
    fi
    sleep 0.2
  done
}

# cmd_connect_relay: the --relay counterpart to cmd_connect's tailscale path
# above -- publish through the Cloudflare relay instead of Tailscale Funnel.
# Never reimplements bin/heimdall-relay-client's own logic (E2E crypto, the
# relay HTTP contract) -- this only spawns it, renders what it reports on
# its own stdout, and tears it down. $1: REPO (already resolved). $2: PORT.
# $3: BG (true/false). $4: RELAY_URL.
cmd_connect_relay() {
  local REPO="$1" PORT="$2" BG="$3" RELAY_URL="$4" NO_CODE="${5:-false}" CONFIRM="${6:-false}"

  if [ ! -x "$UI_BIN" ]; then
    echo "hmd app connect: heimdall-ui not found at $UI_BIN" >&2
    return 2
  fi
  if [ ! -x "$RELAY_CLIENT_BIN" ]; then
    echo "hmd app connect: heimdall-relay-client not found at $RELAY_CLIENT_BIN" >&2
    return 2
  fi
  if ! command -v mktemp >/dev/null 2>&1; then
    echo "hmd app connect: required tool missing: mktemp" >&2
    return 2
  fi

  # --confirm asks at THIS terminal, so it needs one and cannot outlive this command (--bg returns and leaves
  # nobody to ask). Both are settled before anything starts: nothing to tear down, no token read. Without
  # --confirm nothing is asked, so a pipe or --bg pairs by code like any other run.
  if [ "$CONFIRM" = true ]; then
    if [ "$BG" = true ]; then
      echo "hmd app connect: --confirm asks at this terminal and --bg leaves it, so nobody would be left to ask -- drop one of them" >&2
      return 64
    fi
    if [ ! -t 0 ]; then
      echo "hmd app connect: --confirm asks at this terminal and stdin is not one -- run it at a terminal, or drop --confirm" >&2
      return 64
    fi
  fi

  # The state directory is made (or refused) before anything starts and before any token is read: a link on the way to connect.json,
  # or a directory of another account's, is no place to put the pids, and nothing is left to tear down.
  _connect_state_ready "$REPO" || return 2
  REPO_REAL="$(_real_dir "$REPO")"
  STATE_REPO="$REPO"

  # Pair by code (see the usage block). The token lives in gh_tok only until it has been written to the client's
  # pipe; it is never passed as an argument or exported. The repo's pair window, when open, holds the
  # code (one live window per GitHub id and code on the relay), so a plain connect leaves it there and says so,
  # while --confirm, which needs the code for a window that asks, stops that one first.
  local code_requested=false code="" gh_tok=""
  if [ "$NO_CODE" != true ]; then
    if code="$(_session_code_for_repo "$REPO")"; then
      if [ "$CONFIRM" = true ]; then
        _pair_window_stop_code "$REPO" "$code"
      elif _pair_window_holds "$REPO" "$code"; then
        echo "hmd app: session code $code is held by this repo's pair window, which keeps it registered (renewed about every 5 minutes) -- \`hmd app disconnect\` first to have this connect offer it. This connect pairs by QR."
        code=""
      fi
      if [ -n "$code" ]; then
        if _gh_token_into gh_tok; then
          code_requested=true
        else
          echo "hmd app: code pairing off — laptop not signed in to GitHub (gh auth login). Scan the QR."
        fi
      fi
    else
      code=""
      echo "hmd app: code pairing off — could not derive this repo's code. Scan the QR."
    fi
  fi

  # A6: mktemp required, not a predictable /tmp fallback; umask 077 so every
  # temp file that can carry pairing/session data (the client's own stdout
  # is the QR payload -- session_id, pairing_code, hmd_pubkey) is 0600 from
  # creation, same discipline as UI_OUT below.
  local old_umask
  old_umask="$(umask)"
  umask 077
  UI_OUT="$(mktemp)"; local ui_out_rc=$?
  CLIENT_OUT="$(mktemp)"; local client_out_rc=$?
  CLIENT_ERR="$(mktemp)"; local client_err_rc=$?
  umask "$old_umask"
  if [ "$ui_out_rc" -ne 0 ] || [ -z "$UI_OUT" ] || [ "$client_out_rc" -ne 0 ] || [ -z "$CLIENT_OUT" ] || [ "$client_err_rc" -ne 0 ] || [ -z "$CLIENT_ERR" ]; then
    echo "hmd app connect: mktemp failed to create a temp file" >&2
    return 2
  fi

  # From here on, teardown must happen even on Ctrl-C / kill / normal exit (cleanup is a no-op until there is a ui).
  trap 'cleanup; exit 130' INT
  trap 'cleanup; exit 143' TERM
  trap 'cleanup; exit 129' HUP
  trap cleanup EXIT

  # Start the loopback ui -- or adopt the one a former connect left on the port, or step around whatever else holds it
  # (_relay_start_ui). What the client is told, and connect.json records, is the port the ui is really on.
  _relay_start_ui "$REPO" "$PORT" || return $?
  local actual_port="$ACTUAL_PORT"

  local relay_host
  relay_host="$(printf '%s' "$RELAY_URL" | sed -E 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##; s#/.*$##; s#:.*$##')"

  local client_args=(--relay "$RELAY_URL" --repo "$REPO" --ui-port "$actual_port" --public-host "$relay_host")
  if [ "$code_requested" = true ]; then
    # The token reaches the client on its stdin and nowhere else: a pipe made here whose directory entry is
    # removed as soon as both ends are open, so it is anonymous before a byte is written. This shell keeps the
    # only write end (fd 3) for the operator's approve/reject lines; the client gets the read end as stdin and
    # neither of ours.
    local old_umask2 ctl_rc
    old_umask2="$(umask)"
    umask 077
    CTL_DIR="$(mktemp -d)"
    ctl_rc=$?
    umask "$old_umask2"
    if [ "$ctl_rc" -eq 0 ] && [ -n "$CTL_DIR" ] && mkfifo "$CTL_DIR/in" 2>/dev/null; then
      exec 3<>"$CTL_DIR/in"
      exec 4<"$CTL_DIR/in"
      rm -rf "$CTL_DIR"
      CTL_DIR=""
    else
      code_requested=false
      gh_tok=""
      echo "hmd app: code pairing off — cannot make a private pipe for the relay client. Scan the QR."
    fi
  fi
  if [ "$code_requested" = true ]; then
    client_args+=(--code "$code")
    [ "$CONFIRM" != true ] && client_args+=(--no-confirm)
    # The window runs on the pair window's schedule, --confirm included: a terminal left at a prompt through the relay's 360 s
    # lapse must not find its code gone. What differs is a phone turned down at the compare -- its window is renewed at once
    # (the fourth knob), the timer staying on the schedule.
    local win_s min_s lead_s event_s
    read -r win_s min_s lead_s event_s <<<"$(_connect_window_knobs "$CONFIRM")"
    env HMD_RELAY_CODE_WINDOW_S="$win_s" HMD_RELAY_CODE_RENEW_MIN_S="$min_s" HMD_RELAY_CODE_RENEW_LEAD_S="$lead_s" \
      HMD_RELAY_CODE_RENEW_EVENT_MIN_S="$event_s" \
      "$RELAY_CLIENT_BIN" "${client_args[@]}" <&4 3>&- 4>&- >"$CLIENT_OUT" 2>"$CLIENT_ERR" &
    CLIENT_PID=$!
    exec 4<&-
    printf '%s\n' "$gh_tok" >&3
    gh_tok=""
  else
    "$RELAY_CLIENT_BIN" "${client_args[@]}" >"$CLIENT_OUT" 2>"$CLIENT_ERR" &
    CLIENT_PID=$!
  fi

  local relay_started_at
  relay_started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if _relay_write_state; then
    STATE_WRITTEN=true
    _tmux_optin_say
  else
    echo "hmd app connect: connect.json could not be written -- tearing down" >&2
    return 2
  fi

  # What _relay_event reads and sets while it renders the client's events (see its comment).
  local pair_init_seen=false warned_expired=false pairing_exp=0 seen_lines=0 client_rc=0
  local code_resolved=false code_active=false code_shown=false client_gone=false paired_announced=false
  local bg_code_deadline=$(( $(date +%s) + 30 ))
  # What the supervisor decides by (see _relay_supervise_step): only a connect that pairs by code with no compare to answer has one.
  local supervise=false ever_started=false paired_before=false ended_reason="" auth_failed=false e2e_missing=false window_closed=false
  local self_stopped=false fails=0 generation=1 started_ts loop_rc=0
  local restart_s="${HMD_CONNECT_RESTART_S:-5}" restart_max_s="${HMD_CONNECT_RESTART_MAX_S:-300}"
  case "$restart_s" in ''|*[!0-9]*) restart_s=5 ;; esac
  case "$restart_max_s" in ''|*[!0-9]*) restart_max_s=300 ;; esac
  [ "$code_requested" = true ] && [ "$CONFIRM" != true ] && supervise=true
  started_ts="$(date +%s)"

  _relay_loop "$BG"
  loop_rc=$?
  if [ "$loop_rc" -eq 0 ]; then
    echo "hmd app: running in background (ui pid $UI_PID, relay client pid $CLIENT_PID). Tear down with: hmd app disconnect"
    trap - INT TERM HUP EXIT
    exec 3>&-  # the client sees its stdin end: with --no-confirm nothing was ever going to be said on it
    if [ "$supervise" = true ]; then
      # the wait loop goes on in a process of its own, with the ui and the client under its care: it starts the next client when this
      # one ends for a reason that is not final, and tears everything down (cleanup) when it does end
      (
        exec </dev/null >/dev/null 2>&1
        trap 'cleanup; exit 143' TERM
        trap 'cleanup; exit 130' INT
        trap 'cleanup; exit 129' HUP
        trap cleanup EXIT
        _relay_loop false
      ) &
      disown "$!" 2>/dev/null || true
    else
      disown "$UI_PID" 2>/dev/null || true
      disown "$CLIENT_PID" 2>/dev/null || true
      rm -f "$UI_OUT" "$CLIENT_OUT" "$CLIENT_ERR" 2>/dev/null || true
    fi
    return 0
  fi

  if [ "$pair_init_seen" != true ]; then
    echo "hmd app connect: relay client exited before pairing could start:" >&2
    _print_redacted "$CLIENT_ERR" >&2
    return "$client_rc"
  fi

  echo "hmd app: relay session ended (client exit $client_rc)"
  return "$client_rc"
}

# cmd_pair_window: `hmd app pair-window [--stop] --session SID ...` -- see the usage block. Both forms are what the
# SessionStart / SessionEnd hooks run, so they print nothing a hook would put in front of the model except the one
# line the usage block promises for a signed-out gh, and they never fail a session: every refusal is exit 0 except a
# call that is itself malformed (2).
cmd_pair_window() {
  local SID="" OWNER="" REPO="" RELAY_URL="" TRANSCRIPT="" STOP=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) SID="${2:-}"; if [ $# -ge 2 ]; then shift 2; else shift 1; fi ;;
      --pid) OWNER="${2:-}"; if [ $# -ge 2 ]; then shift 2; else shift 1; fi ;;
      --repo) REPO="${2:-}"; if [ $# -ge 2 ]; then shift 2; else shift 1; fi ;;
      --relay) RELAY_URL="${2:-}"; if [ $# -ge 2 ]; then shift 2; else shift 1; fi ;;
      --transcript) TRANSCRIPT="${2:-}"; if [ $# -ge 2 ]; then shift 2; else shift 1; fi ;;
      --stop) STOP=true; shift ;;
      *) echo "hmd app pair-window: unknown flag: $1" >&2; return 2 ;;
    esac
  done
  if ! _pw_valid_sid "$SID"; then
    echo "hmd app pair-window: --session needs a Claude Code session id (letters, digits, - and _)" >&2
    return 2
  fi
  case "$OWNER" in
    *[!0-9]*) echo "hmd app pair-window: --pid must be a number" >&2; return 2 ;;
  esac
  [ -n "$OWNER" ] || OWNER="$PPID"  # the process that called this: for a hook, Claude Code itself
  REPO="$(resolve_repo_value "$REPO")"
  REPO="$(cd "$REPO" 2>/dev/null && pwd -P)" || { echo "hmd app pair-window: not a directory: $REPO" >&2; return 2; }
  if [ "$STOP" = true ]; then
    _pw_stop "$REPO" "$SID"
    return 0
  fi
  _pw_start "$REPO" "$SID" "$OWNER" "$RELAY_URL" "$TRANSCRIPT"
}

# _pw_sessions REPO -- "N ACTIVITY": how many of the sessions recorded for REPO have a live Claude process, and the newest
# modification time (epoch second, 0 when there is none) of their transcripts. Nothing, and failure, when it cannot be told.
_pw_sessions() {
  local out n t
  [ -n "$PY3" ] || return 1
  out="$("$PY3" "$LIB_DIR/hmd_session_code.py" --live-sessions --repo "$1" 2>/dev/null)" || return 1
  n="$(printf '%s' "$out" | jq -r '.sessions // empty' 2>/dev/null)"
  t="$(printf '%s' "$out" | jq -r '.activity // 0' 2>/dev/null)"
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  case "$t" in ''|*[!0-9]*) t=0 ;; esac
  printf '%s %s' "$n" "$t"
}

# _pw_connect_live REPO -- 0 while a `hmd app connect` relay client of REPO is running (connect.json says relay mode and
# the client it names is alive and is one): somebody is using this repo's phone link, and the window it holds stays.
_pw_connect_live() {
  local doc real
  doc="$(_connect_doc "$1")" || return 1
  real="$(_real_dir "$1")" || return 1
  [ "$(_doc_field "$doc" .mode)" = "relay" ] || return 1
  _pid_is_relay_client "$(_doc_field "$doc" .pid_client)" "$real"
}

# _pw_confirm_connect_live REPO -- 0 while a `hmd app connect --confirm` of REPO runs: it holds the code and compares every phone, so a pair
# window (which pairs with no compare) is not opened beside it -- not for the first phone, and not for the phones after it.
_pw_confirm_connect_live() {
  _pw_connect_live "$1" && [ "$(_doc_field "$(_connect_doc "$1")" .confirm)" = "true" ]
}

# _pw_stop REPO SID -- the session ended (or the operator said so): forget it, and close the repo's window unless it is
# still needed -- by another live session of the repo, or by a running `hmd app connect` client. The record goes first
# and the wait is short -- SessionEnd gives a hook little time, and the supervisor finishes revoking on its own. A window
# that is kept does not run for ever: its supervisor ends it when the last of those is gone.
_pw_stop() {
  local repo="$1" sid="$2" live
  [ -z "$PY3" ] || "$PY3" "$LIB_DIR/hmd_session_code.py" --forget-session --repo "$repo" --session-id "$sid" >/dev/null 2>&1 || true
  live="$(_pw_sessions "$repo")" || return 0  # who else is here cannot be told: the supervisor's own look ends the window
  case "$live" in "0 "*) ;; *) return 0 ;; esac
  _pw_connect_live "$repo" && return 0
  _pair_window_stop "$repo" 2 || true
}

# _pw_start REPO SID OWNER RELAY TRANSCRIPT -- record the session, then open the repo's window if it is not open and can
# be. The record comes first and stands on its own: it is what keeps the window alive while the session lives. The window
# is the repo's, so a second session finds it open and only joins it. TRANSCRIPT is the session's transcript, whose
# modification time is the session's activity for the idle stop (an absolute path, or none -- a relative one is ignored
# here as the record ignores it, never a reason not to open).
_pw_start() {
  local repo="$1" sid="$2" owner="$3" relay="$4" transcript="$5" code pid="" i=0 probe=""
  case "$transcript" in /*) ;; *) transcript="" ;; esac
  if [ -n "$PY3" ]; then
    "$PY3" "$LIB_DIR/hmd_session_code.py" --record-session --repo "$repo" --session-id "$sid" --pid "$owner" ${transcript:+--transcript "$transcript"} >/dev/null 2>&1 || true
  fi
  case "${HMD_PAIR_WINDOW:-}" in
    0|off|false|no) echo "hmd app: pair window off (HMD_PAIR_WINDOW=${HMD_PAIR_WINDOW})"; return 0 ;;
  esac
  _session_attended || return 0
  [ -n "$PY3" ] && [ -x "$RELAY_CLIENT_BIN" ] || return 0
  code="$("$PY3" "$LIB_DIR/hmd_session_code.py" --repo "$repo" 2>/dev/null)" || return 0
  printf '%s' "$code" | grep -Eq "$SESSION_CODE_RE" || return 0
  if _pw_live "$repo" >/dev/null; then
    echo "hmd app: pair window already open -- session code $code"
    return 0
  fi
  if _pw_confirm_connect_live "$repo"; then
    echo "hmd app: a connect --confirm is running here and compares every phone -- no pair window beside it (it would pair phones with no compare)"
    return 0
  fi
  # a state directory that cannot be used link-free (a link, another account's) takes no window: nothing is started, and a hook says nothing
  "$PY3" "$LIB_DIR/hmd_private_state.py" ensure --root "$repo" --rel "$APP_REL" >/dev/null 2>&1 || return 0
  if ! _gh_token_into probe || [ -z "$probe" ]; then
    echo "hmd app: code pairing off — laptop not signed in to GitHub (gh auth login). Scan the QR."
    return 0
  fi
  printf -v probe '%s' ""  # the probe only asked whether gh can give a token; the supervisor reads its own
  relay="${relay:-${HMD_RELAY_URL:-$DEFAULT_RELAY_URL}}"
  # the supervisor is this script run again as its own top-level process: its $$ is its real pid (a subshell's is the
  # parent's), and nohup + disown + /dev/null detach it from the hook so it outlives it, as heimdall-presence's keeper does
  nohup "$SELF" pair-window-loop --repo "$repo" --relay "$relay" </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
  while [ "$i" -lt 60 ]; do
    pid="$(_doc_field "$(_state_read "$repo" pair-window.json)" .pid)"
    _pid_is_pair_window "$pid" "$repo" && break
    i=$((i + 1))
    sleep 0.1
  done
  if _pid_is_pair_window "$pid" "$repo"; then
    echo "hmd app: pair window open -- session code $code"
  else
    echo "hmd app: pair window not confirmed -- if the code does not pair, run: hmd app connect"
  fi
}

# The supervisor's own state. GLOBAL on purpose, never `local`: _pw_cleanup runs from a signal trap after the
# function that set it has returned (the rule cleanup() above documents).
PW_REPO=""
PW_CODE=""
PW_RELAY=""
PW_RELAY_HOST=""
PW_STARTED=""
PW_LAST_RC=""
PW_CLIENT_PID=""
PW_NAP=""
PW_CLEANED=false
PW_SESSIONS=1       # live sessions of the repo at the last look (1 until a look says otherwise: a look that fails never ends a window)
PW_ACTIVITY_T=0     # the newest modification time among those sessions' transcripts, epoch second; 0 when there is none
PW_ACTIVE_AT=0      # epoch second of the last pairing or activity, or of the window's opening
PW_IDLE_S=0         # seconds of neither that end the window; 0 never
PW_RENEW_MIN_S=300  # the client's floor between two registrations of the code, and the margin ahead of a lapse, in seconds
PW_RENEW_LEAD_S=10

# _pw_write_state STATE [REASON] -- this supervisor's state file, <repo>/.heimdall/app/pair-window.json: what
# `hmd app connect|disconnect` and the SessionEnd hook find it by. Written through bin/lib/hmd_private_state.py (no
# link followed, 0600) with the JSON on its stdin; a failure (a link in the way, no python) is the caller's to act on.
_pw_write_state() {
  [ -n "$PY3" ] || return 1
  jq -cn --argjson pid "$$" --arg code "$PW_CODE" \
    --arg state "$1" --arg reason "${2:-}" --arg started "$PW_STARTED" --argjson crc "${PW_LAST_RC:-null}" \
    '{pid: $pid, code: $code, state: $state, reason: $reason, started_at: $started, last_client_exit: $crc}' \
    | "$PY3" "$LIB_DIR/hmd_private_state.py" write --root "$PW_REPO" --rel .heimdall/app --name pair-window.json 2>/dev/null
}

# shellcheck disable=SC2329  # runs via the traps cmd_pair_window_loop installs
_pw_cleanup() {
  [ "$PW_CLEANED" = true ] && return 0
  PW_CLEANED=true
  [ -z "$PW_NAP" ] || kill "$PW_NAP" 2>/dev/null
  _pw_stop_clients  # TERM first: each client revokes its relay session itself
  exec 3>&-
  if [ -n "$PW_REPO" ] && [ "$(_doc_field "$(_state_read "$PW_REPO" pair-window.json)" .pid)" = "$$" ]; then
    _state_remove "$PW_REPO" pair-window.json
  fi
}

# _pw_nap SECONDS -- sleep, but wake at once for a trapped signal (a foreground sleep would hold the trap until it ends).
_pw_nap() {
  sleep "$1" &
  PW_NAP=$!
  wait "$PW_NAP" 2>/dev/null
  PW_NAP=""
}

# _pw_refresh_owners -- look again at who needs this window: the repo's recorded sessions that are alive, and how recently
# any of them did anything. One look per poll. A look that cannot be made leaves the last answer standing.
_pw_refresh_owners() {
  local s
  s="$(_pw_sessions "$PW_REPO")" || return 0
  PW_SESSIONS="${s%% *}"
  PW_ACTIVITY_T="${s##* }"
}

# _pw_owner_alive -- 0 while somebody needs the window: a live session of the repo (as of the last _pw_refresh_owners), or a
# running `hmd app connect` client of it. The window belongs to the repo, so one session ending is not the end of it.
_pw_owner_alive() {
  [ "$PW_SESSIONS" -gt 0 ] || _pw_connect_live "$PW_REPO"
}

# _pw_now -- the current epoch second. HMD_PAIR_WINDOW_NOW_FILE names a file holding the second to read as now instead:
# the one seam a test moves hours of idle time through without sleeping them.
_pw_now() {
  local t=""
  if [ -n "${HMD_PAIR_WINDOW_NOW_FILE:-}" ]; then
    { read -r t < "$HMD_PAIR_WINDOW_NOW_FILE"; } 2>/dev/null || true
  fi
  case "$t" in ''|*[!0-9]*) date +%s ;; *) printf '%s' "$t" ;; esac
}

# _pw_seconds_ok N -- 0 when N is a number of seconds this window's timers can take: above 0 and at most a day, which is
# the relay client's own bound (outside it the client falls back to its default, and a floor that silently became 5 s
# would be no floor at all).
_pw_seconds_ok() {
  printf '%s' "$1" | grep -Eq '^[0-9]+(\.[0-9]+)?$' && awk -v n="$1" 'BEGIN { exit !(n > 0 && n <= 86400) }'
}

# _connect_window_knobs CONFIRM -- "WINDOW_S RENEW_MIN_S RENEW_LEAD_S EVENT_MIN_S": the code-window timings `hmd app connect` launches its
# relay client with, the pair window's own (_pw_launch_client), `--confirm` (CONFIRM = true) included. An unpaired connect keeps its code
# claimable: the client renews it about every RENEW_MIN_S seconds, RENEW_LEAD_S ahead of the relay's lapse and never after it, and offers
# it for WINDOW_S -- HMD_PAIR_WINDOW_IDLE_H hours (default 4; 0 or over a day is the client's ceiling, 24 h) unless HMD_RELAY_CODE_WINDOW_S
# names the seconds. The client's own defaults (renew 1.5 s after each lapse, give up after 10 minutes) left a `connect --bg` code
# answering 404 after about 12 minutes. EVENT_MIN_S is the least time after a registration that a renewal an EVENT asks for is made. It is
# RENEW_MIN_S -- a connect nobody is attending must not send the token faster than the schedule because a relay keeps ending its sessions --
# except for --confirm: attended at a terminal, a phone turned down at the compare has had its session revoked, so its window is renewed
# as soon as HMD_RELAY_CODE_RENEW_EVENT_MIN_S (default 5 s, never above RENEW_MIN_S) allows, while the timer stays on the schedule.
_connect_window_knobs() {
  local confirm="${1:-false}" win min lead idle_h event
  min="${HMD_PAIR_WINDOW_RENEW_MIN_S:-${HMD_RELAY_CODE_RENEW_MIN_S:-300}}"
  lead="${HMD_PAIR_WINDOW_RENEW_LEAD_S:-${HMD_RELAY_CODE_RENEW_LEAD_S:-10}}"
  _pw_seconds_ok "$min" || min=300
  _pw_seconds_ok "$lead" || lead=10
  event="$min"
  if [ "$confirm" = true ]; then
    event="${HMD_RELAY_CODE_RENEW_EVENT_MIN_S:-5}"
    _pw_seconds_ok "$event" || event=5
    event="$(awk -v e="$event" -v m="$min" 'BEGIN { print (e < m ? e : m) }')"
  fi
  win="${HMD_RELAY_CODE_WINDOW_S:-}"
  if ! _pw_seconds_ok "$win"; then
    idle_h="${HMD_PAIR_WINDOW_IDLE_H:-0}"
    printf '%s' "$idle_h" | grep -Eq '^[0-9]+(\.[0-9]+)?$' || idle_h=0
    win="$(awk -v h="$idle_h" 'BEGIN { s = h * 3600; if (h == 0 || s > 86400) s = 86400; if (s < 1) s = 1; printf "%d", s }')"
  fi
  printf '%s %s %s %s' "$win" "$min" "$lead" "$event"
}

# _connect_capped -- 0 when the operator bounded how long connect offers its code: HMD_PAIR_WINDOW_IDLE_H above 0. Connect then ends
# when that window does. Unset (the default) or 0, the code is offered for as long as connect runs: the client's own window is 24 h at
# most, and the supervisor (_relay_supervise_step) opens the next one when it closes.
_connect_capped() {
  local h="${HMD_PAIR_WINDOW_IDLE_H:-0}"
  printf '%s' "$h" | grep -Eq '^[0-9]+(\.[0-9]+)?$' && awk -v h="$h" 'BEGIN { exit !(h > 0) }'
}

# _dev_count REPO -- how many phones of REPO are paired right now: the live relay clients with a device record (bin/lib/hmd_devices.py,
# which reads <repo>/.heimdall/app/device-*.json through hmd_private_state: no link followed). 0 when that cannot be told.
_dev_count() {
  local n=""
  [ -n "$PY3" ] && n="$("$PY3" "$LIB_DIR/hmd_devices.py" count --repo "$1" 2>/dev/null)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  printf '%s' "$n"
}

# _dev_limit -- how many phones one repo may have paired at once (bin/lib/hmd_devices.py's MAX_DEVICES).
_dev_limit() {
  local n=""
  [ -n "$PY3" ] && n="$("$PY3" "$LIB_DIR/hmd_devices.py" limit 2>/dev/null)"
  case "$n" in ''|*[!0-9]*) n=4 ;; esac
  printf '%s' "$n"
}

# _pw_paired -- 0 while a phone is paired to this repo, through this window's client or any other (a `hmd app connect` client's, a
# window of an earlier run): the repo's device records, each naming the live relay client that serves its phone. A paired phone is
# never idle -- stopping the window would cut it off.
_pw_paired() {
  [ "$(_dev_count "$PW_REPO")" -gt 0 ]
}

# _pw_stop_clients -- stop the client this window runs and every other client that serves a phone of the repo (an added one): all are asked
# first (ONE TERM each: a second TERM during its shutdown would end the client inside the revoke call it is making), so they revoke their
# relay sessions side by side, then each is waited for.
_pw_stop_clients() {
  local real
  real="$(_real_dir "$PW_REPO")" || real=""
  _stop_device_clients "$PW_REPO" "$real" $PW_CLIENT_PID || true
}

# _pw_idle -- 0 when this window has had nobody for PW_IDLE_S seconds (HMD_PAIR_WINDOW_IDLE_H hours; 0 never): no phone paired
# by its code and no activity in ANY session of the repo. A paired phone is never idle -- its client is serving it, and
# stopping that would cut it off. Each call first moves PW_ACTIVE_AT up to the latest of the pairing and the newest activity
# the last _pw_refresh_owners saw, so the answer is about the time since then.
_pw_idle() {
  local now
  [ "$PW_IDLE_S" -gt 0 ] || return 1
  now="$(_pw_now)"
  if _pw_paired; then
    PW_ACTIVE_AT="$now"
    return 1
  fi
  if [ "$PW_ACTIVITY_T" -gt "$PW_ACTIVE_AT" ]; then PW_ACTIVE_AT="$PW_ACTIVITY_T"; fi
  [ $((now - PW_ACTIVE_AT)) -ge "$PW_IDLE_S" ]
}

# _pw_launch_client TOKEN_VAR -- start the headless relay client for this window and hand it the GitHub token held
# in the variable TOKEN_VAR on its stdin, then clear the variable. The token travels exactly as in cmd_connect_relay:
# a pipe whose directory entry is removed as soon as both ends are open, so it is on no argv, no environment variable
# and no file. The client's event log is off (HMD_RELAY_EVENT_LOG=""): a window renews for as long as the repo has a
# session, and its events are nobody's to read. HMD_RELAY_CODE_WINDOW_S is the client's own cap on how long
# one process offers the code (10 minutes by default); a window with no terminal runs for the sessions, so the cap is
# raised to its ceiling (24 h) and the supervisor opens the next one when it ends. Each renewal sends the token again, so
# the client is given the floor between two of them and the margin ahead of a lapse (PW_RENEW_MIN_S, PW_RENEW_LEAD_S) -- the
# same floor for a renewal an event asks for, which a HMD_RELAY_CODE_RENEW_EVENT_MIN_S in the environment (meant for --confirm)
# must not lower for a window nobody attends.
_pw_launch_client() {
  local __var="$1" ctl
  ctl="$(umask 077; mktemp -d)" || return 1
  if ! mkfifo "$ctl/in" 2>/dev/null; then
    rm -rf "$ctl"
    return 1
  fi
  exec 3<>"$ctl/in"
  exec 4<"$ctl/in"
  rm -rf "$ctl"
  HMD_RELAY_EVENT_LOG="" HMD_RELAY_CODE_WINDOW_S="${HMD_RELAY_CODE_WINDOW_S:-86400}" \
    HMD_RELAY_CODE_RENEW_MIN_S="$PW_RENEW_MIN_S" HMD_RELAY_CODE_RENEW_LEAD_S="$PW_RENEW_LEAD_S" \
    HMD_RELAY_CODE_RENEW_EVENT_MIN_S="$PW_RENEW_MIN_S" \
    "$RELAY_CLIENT_BIN" --relay "$PW_RELAY" --repo "$PW_REPO" --ui-port 0 --public-host "$PW_RELAY_HOST" \
      --code "$PW_CODE" --no-confirm --code-only <&4 3>&- 4>&- >/dev/null 2>&1 &
  PW_CLIENT_PID=$!
  exec 4<&-
  printf '%s\n' "${!__var}" >&3
  printf -v "$__var" '%s' ""
  exec 3>&-
}

# cmd_pair_window_loop: INTERNAL -- the detached supervisor `hmd app pair-window` starts (see _pw_start), one per repo. Keeps
# one `heimdall-relay-client --code --no-confirm --code-only` offering the repo's code: a new window when the client's
# ends or the relay ends its session, a retry (HMD_PAIR_WINDOW_RETRY_S, default 60 but never under the renewal floor)
# when it could not be offered, and no more at all when the relay will not take the code (no usable token, code pairing
# off) or ten tries in a row failed. The client renews its own registration of the code no more often than the floor
# PW_RENEW_MIN_S (see _pw_launch_client). It ends -- stopping its client first, which revokes the relay session -- when
# no session recorded for the repo has a live Claude process and no `hmd app connect` client runs (_pw_owner_alive: a
# session ending is not the end of the window while another lives), when nobody has paired or touched any session of the
# repo for PW_IDLE_S seconds (_pw_idle: nothing says a window is live after that, and no token is sent again), or on
# TERM/INT/HUP, which is how `pair-window --stop` of the last session, `hmd app disconnect` and `--confirm` stop it.
cmd_pair_window_loop() {
  local fails=0 started rc ran delay tok="" restart_s retry_s poll_s idle_h full_noted=false limit
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) PW_REPO="${2:-}"; if [ $# -ge 2 ]; then shift 2; else shift 1; fi ;;
      --relay) PW_RELAY="${2:-}"; if [ $# -ge 2 ]; then shift 2; else shift 1; fi ;;
      *) return 2 ;;
    esac
  done
  [ -d "$PW_REPO" ] && [ -n "$PW_RELAY" ] && [ -n "$PY3" ] && [ -x "$RELAY_CLIENT_BIN" ] || return 2
  PW_CODE="$("$PY3" "$LIB_DIR/hmd_session_code.py" --repo "$PW_REPO" 2>/dev/null)" || return 1
  PW_RELAY_HOST="$(printf '%s' "$PW_RELAY" | sed -E 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##; s#/.*$##; s#:.*$##')"
  PW_STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  restart_s="${HMD_PAIR_WINDOW_RESTART_S:-5}"
  poll_s="${HMD_PAIR_WINDOW_POLL_S:-5}"
  # the pair window's own knobs win; the relay client's generic ones, where already set, keep meaning what they did
  PW_RENEW_MIN_S="${HMD_PAIR_WINDOW_RENEW_MIN_S:-${HMD_RELAY_CODE_RENEW_MIN_S:-300}}"
  PW_RENEW_LEAD_S="${HMD_PAIR_WINDOW_RENEW_LEAD_S:-${HMD_RELAY_CODE_RENEW_LEAD_S:-10}}"
  idle_h="${HMD_PAIR_WINDOW_IDLE_H:-4}"
  case "$restart_s" in ''|*[!0-9]*) restart_s=5 ;; esac
  _pw_seconds_ok "$poll_s" || poll_s=5
  _pw_seconds_ok "$PW_RENEW_MIN_S" || PW_RENEW_MIN_S=300
  _pw_seconds_ok "$PW_RENEW_LEAD_S" || PW_RENEW_LEAD_S=10
  retry_s="${HMD_PAIR_WINDOW_RETRY_S:-}"
  case "$retry_s" in
    ''|*[!0-9]*) retry_s="$(awk -v a=60 -v b="$PW_RENEW_MIN_S" 'BEGIN { print (b > a ? b : a) }')" ;;
  esac
  printf '%s' "$idle_h" | grep -Eq '^[0-9]+(\.[0-9]+)?$' || idle_h=4
  PW_IDLE_S="$(awk -v h="$idle_h" 'BEGIN { printf "%d", h * 3600 }')"
  PW_ACTIVE_AT="$(_pw_now)"
  trap '_pw_cleanup; exit 0' TERM INT HUP
  trap _pw_cleanup EXIT
  # no state file, no way to stop this by name: a supervisor that cannot be found does not run
  limit="$(_dev_limit)"
  _pw_write_state starting || return 1
  while :; do
    _pw_refresh_owners
    _pw_owner_alive || break
    _pw_idle && break  # nobody here for the whole idle period: no new registration, so no token goes out again
    if [ "$(_dev_count "$PW_REPO")" -ge "$limit" ]; then
      # every place is taken: the code is not offered (nothing is sent to the relay, no token goes out) until a phone is disconnected
      [ "$full_noted" = true ] || _pw_write_state full "device limit reached ($limit)"
      full_noted=true
      _pw_nap "$poll_s"
      continue
    fi
    full_noted=false
    if _pw_confirm_connect_live "$PW_REPO"; then
      _pw_nap "$poll_s"  # a connect --confirm holds the code and compares every phone: nothing is offered beside it
      continue
    fi
    _gh_token_into tok || break  # signed out since the session began: no window (the QR still pairs)
    _pw_launch_client tok || break
    started="$(date +%s)"
    _pw_write_state running
    while kill -0 "$PW_CLIENT_PID" 2>/dev/null; do
      _pw_refresh_owners
      if ! _pw_owner_alive; then
        _pw_stop_clients
        break 2
      fi
      if _pw_idle; then
        _pw_stop_clients  # TERM: each client revokes its relay session itself
        break 2
      fi
      _pw_nap "$poll_s"
    done
    wait "$PW_CLIENT_PID" 2>/dev/null
    rc=$?
    PW_CLIENT_PID=""
    PW_LAST_RC="$rc"
    # 2 a call this script got wrong, 3 the relay will not take the code (no usable GitHub token, code pairing off
    # there), 11 no E2E crypto: another try changes nothing
    case "$rc" in 2|3|11) break ;; esac
    ran=$(( $(date +%s) - started ))
    case "$rc" in
      0|5) fails=0; delay="$restart_s" ;;  # a clean end, or the window's whole lifetime passed unclaimed
      *)
        if [ "$ran" -ge 30 ]; then fails=0; else fails=$((fails + 1)); fi
        [ "$fails" -ge 10 ] && break
        delay="$retry_s"
        ;;
    esac
    _pw_write_state waiting
    _pw_nap "$delay"
  done
  return 0
}

# cmd_identity: `hmd app identity revoke` -- see the usage block. The relay client does the one HTTP call
# (--identity-revoke); this reads the laptop's GitHub token, pipes it in and says what came back.
cmd_identity() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    revoke) cmd_identity_revoke "$@" ;;
    *) echo "hmd app identity: unknown subcommand: ${sub:-(none)} (try: revoke)" >&2; return 2 ;;
  esac
}

cmd_identity_revoke() {
  local RELAY_URL="" RELAY_SET=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --relay)
        RELAY_URL="${2:-}"
        RELAY_SET=true
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      *) echo "hmd app identity revoke: unknown flag: $1" >&2; return 2 ;;
    esac
  done
  if [ "$RELAY_SET" = true ] && [ -z "$RELAY_URL" ]; then
    echo "hmd app identity revoke: --relay needs a URL" >&2
    return 2
  fi
  RELAY_URL="${RELAY_URL:-${HMD_RELAY_URL:-$DEFAULT_RELAY_URL}}"
  if [ ! -x "$RELAY_CLIENT_BIN" ]; then
    echo "hmd app identity revoke: heimdall-relay-client not found at $RELAY_CLIENT_BIN" >&2
    return 2
  fi
  local tok="" out rc ev login reason
  if ! _gh_token_into tok; then
    echo "hmd app identity revoke: laptop not signed in to GitHub (gh auth login) -- nothing to revoke with" >&2
    return 3
  fi
  # the token goes to the client on a pipe: printf is a builtin, so it is in no process's argv
  out="$(printf '%s\n' "$tok" | "$RELAY_CLIENT_BIN" --identity-revoke --relay "$RELAY_URL" 2>/dev/null)"
  rc=$?
  tok=""
  ev="$(printf '%s\n' "$out" | grep -E '"event":"identity_revoke' | tail -n 1)"
  if [ "$(printf '%s' "$ev" | jq -r '.event // empty' 2>/dev/null)" = "identity_revoked" ]; then
    login="$(_clean_text "$(printf '%s' "$ev" | jq -r '.gh_login // empty' 2>/dev/null)")"
    echo "revoked every hmd app sign-in for @$login"
    return 0
  fi
  reason="$(_clean_text "$(printf '%s' "$ev" | jq -r '.reason // empty' 2>/dev/null)")"
  case "$reason" in
    no-gh) echo "hmd app identity revoke: GitHub did not accept this laptop's token (gh auth login) -- nothing was revoked" >&2 ;;
    disabled) echo "hmd app identity revoke: this relay has code pairing disabled -- there is nothing to revoke" >&2 ;;
    *) echo "hmd app identity revoke: failed (${reason:-the relay client exited $rc})" >&2 ;;
  esac
  [ "$rc" -ne 0 ] && return "$rc"
  return 12
}

cmd_status() {
  local REPO=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        REPO="${2:-}"
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      *) echo "hmd app status: unknown flag: $1" >&2; return 2 ;;
    esac
  done
  REPO="$(resolve_repo_value "$REPO")"

  local connect_doc loose
  connect_doc="$(_connect_doc "$REPO")"
  loose="$(_connect_loose_note "$REPO")"
  if [ -n "$loose" ] && [ -z "$connect_doc" ]; then
    # a file of ours that is not 0600 and that nothing running backs: said plainly, never taken for "nothing is connected here"
    echo "$loose, and no running relay client or ui of this repo backs it: ignored (a leftover; hmd app disconnect clears it)"
    echo "connected: no"
    return 1
  fi
  [ -n "$loose" ] && echo "note: $loose; read because it names this repo's running relay client or ui"
  if [ "$(_doc_field "$connect_doc" .mode)" = "relay" ]; then
    cmd_status_relay "$REPO" "$connect_doc"
    return $?
  fi

  if ts_installed; then
    echo "tailscale installed: yes"
  else
    echo "tailscale installed: no"
  fi

  echo "tailscale build variant: $(ts_variant 2>/dev/null || echo unknown)"
  echo "tailscale binary: $(ts_bin 2>/dev/null || echo '(unresolved)')"

  if ts_online; then
    echo "tailscale online: yes"
  else
    echo "tailscale online: no"
  fi

  local dns
  dns="$(ts_dns_name 2>/dev/null || true)"
  echo "DNSName: ${dns:-(none)}"

  local funnel_json
  if funnel_json="$(ts_funnel_status_json 2>/dev/null)"; then
    echo "funnel status: $funnel_json"
  else
    echo "funnel status: unavailable"
  fi

  local orphaned=false
  if [ -n "$connect_doc" ]; then
    local host port https_port pid_ui started_at alive
    host="$(_clean_text "$(_doc_field "$connect_doc" .host)")"
    port="$(_clean_text "$(_doc_field "$connect_doc" .port)")"
    https_port="$(_clean_text "$(_doc_field "$connect_doc" .https_port)")"
    pid_ui="$(_clean_text "$(_doc_field "$connect_doc" .pid_ui)")"
    started_at="$(_clean_text "$(_doc_field "$connect_doc" .started_at)")"
    alive="not running"
    _pid_is_heimdall_ui "$pid_ui" "$(_real_dir "$REPO")" published && alive="running"
    echo "connected: yes"
    echo "  ui pid: ${pid_ui:-?} ($alive)"
    echo "  local port: ${port:-?}"
    echo "  https port: ${https_port:-?}"
    echo "  host: ${host:-?}"
    echo "  started at: ${started_at:-?}"
    if [ -n "$host" ] && [ -n "$https_port" ]; then
      if [ "$https_port" = "443" ]; then
        echo "  public URL: https://$host/?token=<redacted>"
      else
        echo "  public URL: https://$host:$https_port/?token=<redacted>"
      fi
    fi
    # A4(c): the ui process is the only thing that can ever tear the funnel
    # down again (cmd_disconnect reads its pid from this same state file) --
    # once it's gone, a funnel that's still up is orphaned: publicly
    # reachable with no local process left that a normal disconnect would
    # find anything to kill for.
    if [ "$alive" = "not running" ] && _funnel_looks_up; then
      orphaned=true
      echo "ORPHANED FUNNEL -- ui process is gone but the tailnet funnel is still up. Run: hmd app disconnect" >&2
    fi
  else
    echo "connected: no"
    if _funnel_looks_up; then
      orphaned=true
      echo "ORPHANED FUNNEL -- no connect state on record but the tailnet funnel is still up. Run: hmd app disconnect" >&2
    fi
  fi

  if [ -x "$INBOX_DELIVER_BIN" ]; then
    local inbox_json pending
    inbox_json="$("$INBOX_DELIVER_BIN" status --repo "$REPO" 2>/dev/null)"
    pending="$(printf '%s' "$inbox_json" | jq -r '.pending // empty' 2>/dev/null)"
    echo "inbox pending: ${pending:-0}"
  fi
  if [ -n "$PY3" ] && [ -r "$LIB_DIR/companion_ui_controls.py" ]; then
    "$PY3" "$LIB_DIR/companion_ui_controls.py" status-line --repo "$REPO" 2>/dev/null
  fi
  if [ -n "$PY3" ] && [ -r "$LIB_DIR/companion_remote_switches.py" ]; then
    "$PY3" "$LIB_DIR/companion_remote_switches.py" status-line --repo "$REPO" 2>/dev/null
  fi
  if [ -n "$PY3" ] && [ -r "$LIB_DIR/companion_dashboards.py" ]; then
    "$PY3" "$LIB_DIR/companion_dashboards.py" status-line --repo "$REPO" 2>/dev/null
  fi
  if [ -n "$PY3" ] && [ -r "$LIB_DIR/companion_quick_ask.py" ]; then
    "$PY3" "$LIB_DIR/companion_quick_ask.py" status-line --repo "$REPO" 2>/dev/null
  fi

  _status_devices "$REPO"
  _status_tmux_line "$connect_doc"
  [ "$orphaned" = true ] && return 1
  return 0
}

# _status_devices REPO -- one line per phone paired to REPO (bin/lib/hmd_devices.py: its label and GitHub login as the relay claimed them, its
# id, when it paired, when it was last heard from, the capabilities it listed), nothing when there is none. At the limit it says how to make room.
_status_devices() {
  local json n limit
  [ -n "$PY3" ] && [ -r "$LIB_DIR/hmd_devices.py" ] || return 0
  json="$("$PY3" "$LIB_DIR/hmd_devices.py" list --repo "$1" 2>/dev/null)" || return 0
  n="$(printf '%s' "$json" | jq -r 'length' 2>/dev/null)"
  case "$n" in ''|0|*[!0-9]*) return 0 ;; esac
  limit="$(_dev_limit)"
  echo "devices: $n paired (limit $limit)"
  printf '%s' "$json" | jq -r '.[] | "  device: \(.label | gsub("[^\\p{L}\\p{N} ._()\u0027-]"; "") | .[0:40])  id \(.id)  @\(.gh_login | gsub("[^A-Za-z0-9-]"; "") | .[0:39])  paired \(.bound_at | todate)  last seen \(.last_seen | todate)  caps: \(if (.caps | length) > 0 then (.caps | join(",")) else "none" end)"' 2>/dev/null
  if [ "$n" -ge "$limit" ]; then
    echo "  limit $limit reached: hmd app add-device refuses until one is disconnected -- hmd app disconnect --device <label|id>"
  fi
}

# cmd_status_relay: the --relay counterpart to cmd_status's tailscale report
# above. $1: REPO (already resolved). $2: connect.json's path (already
# confirmed to exist with mode "relay" by the caller).
cmd_status_relay() {
  local REPO="$1" doc="$2" repo_real relay_doc
  local relay pid_ui pid_client port started_at
  repo_real="$(_real_dir "$REPO")"
  # shown, never used: which relay a session runs against is the environment's to say, not a file in the repo's
  relay="$(_clean_text "$(_doc_field "$doc" .relay)")"
  pid_ui="$(_clean_text "$(_doc_field "$doc" .pid_ui)")"
  pid_client="$(_clean_text "$(_doc_field "$doc" .pid_client)")"
  port="$(_clean_text "$(_doc_field "$doc" .port)")"
  started_at="$(_clean_text "$(_doc_field "$doc" .started_at)")"

  relay_doc="$(_state_read "$REPO" relay.json)"
  local session_id="" paired="" bound_at="" frames_sent="" last_seq="" last_delivered="" event_log=""
  if [ -n "$relay_doc" ]; then
    session_id="$(_clean_text "$(_doc_field "$relay_doc" .session_id)")"
    paired="$(_doc_field "$relay_doc" .paired)"
    bound_at="$(_clean_text "$(_doc_field "$relay_doc" .bound_at)")"
    frames_sent="$(_clean_text "$(_doc_field "$relay_doc" .frames_sent)")"
    last_seq="$(_clean_text "$(_doc_field "$relay_doc" .last_seq)")"
    last_delivered="$(_clean_text "$(_doc_field "$relay_doc" .last_delivered)")"
    event_log="$(_clean_text "$(_doc_field "$relay_doc" .event_log)")"
  fi

  local ui_alive="not running" client_alive="not running"
  _pid_is_heimdall_ui "$pid_ui" "$repo_real" && ui_alive="running"
  _pid_is_relay_client "$pid_client" "$repo_real" && client_alive="running"

  echo "mode: relay"
  if [ "$client_alive" = running ]; then echo "connected: yes"; else echo "connected: no"; fi
  echo "  relay: ${relay:-?}"
  echo "  session id: ${session_id:-?}"
  local ndev
  ndev="$(_dev_count "$REPO")"
  if [ "$ndev" -gt 0 ]; then
    echo "  paired: yes ($ndev phone(s) bound)"  # relay.json is the current client's alone: the phones are the device records
  elif [ "$paired" = "true" ]; then
    echo "  paired: yes (bound at ${bound_at:-?})"
  else
    echo "  paired: no"
  fi
  echo "  frames sent: ${frames_sent:-0}"
  echo "  last seq: ${last_seq:-0}"
  echo "  last delivered: ${last_delivered:-(none)}"
  if [ -n "$event_log" ]; then
    echo "  event log: $event_log"
    # mtime -> ISO-8601 UTC, BSD (stat -f/date -r) then GNU (stat -c/date -d)
    # -- same fallback order as e.g. bin/heimdall-autoupdate's own mtime read
    # and bin/heimdall-city's epoch<-ISO conversion, composed here for the
    # reverse (epoch->ISO) direction since no prior bin/ site needed exactly
    # that direction before. Best-effort throughout: a missing/unreadable
    # file (log configured but no event written yet) just falls through to
    # the "no events written yet" default below, never an error.
    # The path relay.json records is only shown: the mtime is taken from the client's own log file in the repo's state directory
    # (bin/lib/hmd_private_state.py: no link followed, a file of ours), never from a path a file chose.
    local event_log_mtime="" event_log_when=""
    event_log_mtime="$(_state_mtime "$REPO" relay-events.jsonl || true)"
    if [ -n "$event_log_mtime" ]; then
      event_log_when="$(date -u -r "$event_log_mtime" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
        || date -u -d "@$event_log_mtime" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
    fi
    echo "  last event at: ${event_log_when:-(no events written yet)}"
  else
    echo "  event log: disabled"
  fi
  echo "  ui pid: ${pid_ui:-?} ($ui_alive)"
  echo "  client pid: ${pid_client:-?} ($client_alive)"
  echo "  local port: ${port:-?}"
  echo "  started at: ${started_at:-?}"
  _status_devices "$REPO"

  # Orphan rules, mirroring cmd_status's ORPHANED FUNNEL check above: the
  # relay client is the only thing that can revoke the session, so its death
  # while the ui lingers (or both gone but state left behind) both need a
  # human to run disconnect rather than silently look "connected".
  if [ "$client_alive" = "not running" ] && [ "$ui_alive" = "running" ]; then
    echo "relay client not running -- hmd ui is up, but the phone can neither pair nor reach this session; run: hmd app disconnect, then hmd app connect"
    return 1
  fi
  if [ "$client_alive" = "not running" ] && [ "$ui_alive" = "not running" ]; then
    echo "relay client not running (stale) -- run hmd app disconnect" >&2
    return 1
  fi

  if [ -x "$INBOX_DELIVER_BIN" ]; then
    local inbox_json pending
    inbox_json="$("$INBOX_DELIVER_BIN" status --repo "$REPO" 2>/dev/null)"
    pending="$(printf '%s' "$inbox_json" | jq -r '.pending // empty' 2>/dev/null)"
    echo "inbox pending: ${pending:-0}"
  fi
  _status_tmux_line "$doc"
  if [ -n "$PY3" ] && [ -r "$LIB_DIR/companion_cc_login.py" ]; then
    "$PY3" "$LIB_DIR/companion_cc_login.py" status-line --repo "$REPO" 2>/dev/null
  fi
  if [ -n "$PY3" ] && [ -r "$LIB_DIR/companion_ui_controls.py" ]; then
    "$PY3" "$LIB_DIR/companion_ui_controls.py" status-line --repo "$REPO" 2>/dev/null
  fi
  if [ -n "$PY3" ] && [ -r "$LIB_DIR/companion_remote_switches.py" ]; then
    "$PY3" "$LIB_DIR/companion_remote_switches.py" status-line --repo "$REPO" 2>/dev/null
  fi
  if [ -n "$PY3" ] && [ -r "$LIB_DIR/companion_dashboards.py" ]; then
    "$PY3" "$LIB_DIR/companion_dashboards.py" status-line --repo "$REPO" 2>/dev/null
  fi
  if [ -n "$PY3" ] && [ -r "$LIB_DIR/companion_quick_ask.py" ]; then
    "$PY3" "$LIB_DIR/companion_quick_ask.py" status-line --repo "$REPO" 2>/dev/null
  fi
  return 0
}

cmd_remote_login() {
  if [ -z "$PY3" ]; then
    echo "hmd app remote-login: python3 not found (set HMD_PYTHON=/path/to/python3)" >&2
    return 2
  fi
  "$PY3" "$LIB_DIR/companion_cc_login.py" "$@"
}

# cmd_remote_switches: `hmd app remote-launch|remote-merge|launch-allow ...` -- see the usage block above. $1 is the subcommand
# as typed; everything else is bin/lib/companion_remote_switches.py's, its refusals and its exit code included. stdin is left
# exactly as the caller had it: that script's terminal check ("only a person at a terminal may widen what the phone can do")
# is the whole point, so nothing here may redirect or replace it.
cmd_remote_switches() {
  local sub="$1"
  shift
  if [ -z "$PY3" ]; then
    echo "hmd app $sub: python3 not found (set HMD_PYTHON=/path/to/python3)" >&2
    return 2
  fi
  "$PY3" "$LIB_DIR/companion_remote_switches.py" "$sub" "$@"
}

# cmd_controls: `hmd app controls on|off|status [--repo DIR]` -- the kill switch for the phone's remote controls (see the
# usage block above). Everything is bin/lib/companion_ui_controls.py's; its exit code is this command's.
cmd_controls() {
  if [ -z "$PY3" ]; then
    echo "hmd app controls: python3 not found (set HMD_PYTHON=/path/to/python3)" >&2
    return 2
  fi
  local sub="status"
  case "${1:-}" in
    on|off|status) sub="$1"; shift ;;
    ""|--*) ;;
    *) echo "usage: hmd app controls on|off|status [--repo DIR]" >&2; return 2 ;;
  esac
  "$PY3" "$LIB_DIR/companion_ui_controls.py" "$sub" "$@"
}

# cmd_push_test: `hmd app push-test` -- see the usage block above. Resolves the repo like status/disconnect do, then
# hands everything else to bin/lib/companion_push_cli.py, whose exit code is this command's (0 sent, 3 no device,
# 4 no sender answered, 5 push off, 6 every device failed). The flags are checked here, the --wait range there.
cmd_push_test() {
  local REPO="" WAIT="" WAIT_SET=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        REPO="${2:-}"
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      --wait)
        WAIT="${2:-}"
        WAIT_SET=true
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      *) echo "hmd app push-test: unknown flag: $1" >&2; return 2 ;;
    esac
  done
  REPO="$(resolve_repo_value "$REPO")"
  if [ -z "$PY3" ]; then
    echo "hmd app push-test: python3 not found (set HMD_PYTHON=/path/to/python3)" >&2
    return 2
  fi
  if [ ! -d "$REPO" ]; then
    echo "hmd app push-test: not a directory: $REPO" >&2
    return 2
  fi
  if [ "$WAIT_SET" = true ]; then
    "$PY3" "$LIB_DIR/companion_push_cli.py" push-test --repo "$REPO" --wait "$WAIT"
  else
    "$PY3" "$LIB_DIR/companion_push_cli.py" push-test --repo "$REPO"
  fi
}

# _stop_recorded_ui PID REPO_REAL [published] -- stop the ui a state file names, but only when that process is a ui of THIS repo (see
# _pid_is_heimdall_ui); anything else -- a recycled pid, another repo's ui, whatever a checkout planted -- is left alone and said so.
_stop_recorded_ui() {
  local pid="$1" waited=0
  if _pid_is_heimdall_ui "$pid" "$2" "${3:-}"; then
    kill "$pid" 2>/dev/null || true
    while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 30 ]; do
      sleep 0.1
      waited=$((waited + 1))
    done
    _pid_is_heimdall_ui "$pid" "$2" "${3:-}" && kill -9 "$pid" 2>/dev/null
  elif [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "hmd app disconnect: pid $pid in state file is not a heimdall-ui process of this repo -- not killing it" >&2
  fi
  return 0
}

# _disconnect_gone_device REPO WANTED -- `hmd app disconnect --device` for a phone no running client serves. A client that crashed took its
# relay session token with it -- the token lives in that client's memory, never on disk -- so that session cannot be revoked from here, and
# this says so and exits 1 rather than let a local cleanup pass for a revoke. The phone's record and push registrations ARE removed
# (hmd_devices.py forget), so it stops being listed and notified. 1 as well for a name no phone has, 2 for one that fits several.
_disconnect_gone_device() {
  local repo="$1" wanted="$2" found rc id
  found="$("$PY3" "$LIB_DIR/hmd_devices.py" resolve --dead --repo "$repo" "$wanted" 2>/dev/null)"
  rc=$?
  case "$rc" in
    0) ;;
    2) echo "hmd app disconnect: more than one paired device is called '$(_clean_text "$wanted")' -- name one by its id" >&2; return 2 ;;
    *) echo "hmd app disconnect: no paired device '$(_clean_text "$wanted")' -- hmd app status lists the paired ones" >&2; return 1 ;;
  esac
  id="${found%% *}"
  if "$PY3" "$LIB_DIR/hmd_devices.py" forget --repo "$repo" "$id" >/dev/null 2>&1; then
    echo "hmd app disconnect: device $id ($(_clean_text "$wanted")): its client is not running, so its relay session could NOT be revoked from here -- it stays open until it expires (hmd app identity revoke signs every phone out); its record and push registrations were removed" >&2
  else
    echo "hmd app disconnect: device $id ($(_clean_text "$wanted")): its client is not running, so its relay session could NOT be revoked from here, and its push registrations could not be removed either -- run this again (hmd app identity revoke signs every phone out)" >&2
  fi
  return 1
}

# _disconnect_device REPO WANTED -- `hmd app disconnect --device`: revoke ONE phone. WANTED is its label (any case) or its id, as `hmd app
# status` lists them. The relay client serving that phone is asked (SIGUSR1) to revoke its relay session -- which invalidates that phone's
# token at the relay -- and to end; its record and the push registrations only it held go with it. Every other phone's client, the
# window and the ui are left alone. 1 for no such device, 2 for a name that fits several (name one by its id).
_disconnect_device() {
  local repo="$1" wanted="$2" found rc id pid repo_real sig
  if [ -z "$wanted" ]; then
    echo "hmd app disconnect: --device needs a device label or id (hmd app status lists them)" >&2
    return 2
  fi
  [ -n "$PY3" ] || { echo "hmd app disconnect: --device needs python3" >&2; return 2; }
  found="$("$PY3" "$LIB_DIR/hmd_devices.py" resolve --repo "$repo" "$wanted" 2>/dev/null)"
  rc=$?
  case "$rc" in
    0) ;;
    2) echo "hmd app disconnect: more than one paired device is called '$(_clean_text "$wanted")' -- name one by its id (hmd app status lists them)" >&2; return 2 ;;
    *) _disconnect_gone_device "$repo" "$wanted"; return $? ;;
  esac
  id="${found%% *}"
  pid="${found##* }"
  # SIGUSR1 revokes the phone of a client that has the handler; a client started by v2.4.6 or earlier has none (USR1 would end it with
  # no revoke), so its phone is revoked with TERM, which that client answers by revoking its session and ending (hmd_devices.py signal)
  sig="$("$PY3" "$LIB_DIR/hmd_devices.py" signal --repo "$repo" "$id" 2>/dev/null)"
  case "$sig" in TERM|USR1) ;; *) sig=USR1 ;; esac
  repo_real="$(_real_dir "$repo")"
  rc=0
  # A14: verify identity before signaling -- a recycled pid must never take an unrelated process down with it.
  if _pid_is_relay_client "$pid" "$repo_real"; then
    _relay_stop_client "$pid" "$sig"
    rc=$?
  else
    echo "hmd app disconnect: pid $pid of device $id is not a heimdall-relay-client process of this repo -- not signalling it" >&2
    rc=1
  fi
  # the push registrations go before success is reported: a revoke that left them would keep notifying the phone it revoked
  local frc=0
  "$PY3" "$LIB_DIR/hmd_devices.py" forget --repo "$repo" "$id" >/dev/null 2>&1 || frc=1
  [ "$frc" -eq 0 ] || echo "hmd app disconnect: device $id: its push registrations could not be removed, so it may still be notified and its record is kept -- run this again" >&2
  if [ "$rc" -ne 0 ]; then
    echo "hmd app disconnect: revoke of device $id may not have reached the relay -- its session stays open until its token expires" >&2
    return "$rc"
  fi
  [ "$frc" -eq 0 ] || return 1
  echo "hmd app disconnect: revoked device $id ($(_clean_text "$wanted")) -- the other devices stay connected"
}

cmd_disconnect() {
  local REPO="" DEVICE="" DEVICE_GIVEN=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        REPO="${2:-}"
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      --device)
        DEVICE="${2:-}"
        DEVICE_GIVEN=true
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      *) echo "hmd app disconnect: unknown flag: $1" >&2; return 2 ;;
    esac
  done
  REPO="$(resolve_repo_value "$REPO")"
  if [ "$DEVICE_GIVEN" = true ]; then
    _disconnect_device "$REPO" "$DEVICE"
    return $?
  fi
  local connect_doc repo_real vrc pw_stopped devs=""
  connect_doc="$(_connect_doc "$REPO")"
  repo_real="$(_real_dir "$REPO")"
  # every phone paired right now, listed before anything below ends a client (the pair windows closed next end them too, and a list names
  # running clients only): the relay path forgets each of them once its client is gone -- its push registrations removed, a record that a
  # client older than the records left behind tombstoned
  if [ -n "$PY3" ]; then
    devs="$("$PY3" "$LIB_DIR/hmd_devices.py" list --repo "$REPO" 2>/dev/null | jq -r '.[] | "\(.id) \(.pid)"' 2>/dev/null)" || devs=""
  fi
  if [ -z "$connect_doc" ] && [ -n "$(_connect_loose_note "$REPO")" ]; then
    _state_remove "$REPO" connect.json
    echo "hmd app disconnect: removed a leftover connect.json that backed no running relay client or ui of this repo"
  fi

  # a pair window is a way for a phone in, so disconnect closes it too (it is opened again by the next session)
  pw_stopped="$(_pair_window_stop_all "$REPO")"
  [ "${pw_stopped:-0}" -gt 0 ] && echo "hmd app disconnect: stopped $pw_stopped pair window(s)"
  _stop_device_clients "$REPO" "$repo_real" || true  # every phone's client, an added one too: each revokes its own relay session

  if [ "$(_doc_field "$connect_doc" .mode)" = "relay" ]; then
    cmd_disconnect_relay "$REPO" "$repo_real" "$connect_doc" "$devs"
    return $?
  fi

  if [ -z "$connect_doc" ]; then
    # A4(a): a funnel can outlive its state file (crash, a manual rm, a prior
    # bug) -- disconnect is the one command that guarantees no funnel
    # survives it, so it always attempts a stop, never conditional on state.
    # N1: with no state file there's no known backend port either -- but if
    # exactly one loopback Funnel/Serve target is configured, nothing else
    # on this machine would plausibly own it, so treat it as ours instead of
    # leaving the port unknown (which ts_funnel_stop's own foreign-target
    # check -- D6 -- would then conservatively refuse). Two or more targets
    # really is ambiguous: refuse rather than guess whose is whose.
    local status_json targets target_count=0 inferred_port="" was_up=false
    status_json="$(ts_funnel_status_json 2>/dev/null)"
    targets="$(ts_funnel_foreign_targets "$status_json" "")"
    if [ -n "$targets" ]; then
      was_up=true
      target_count="$(printf '%s\n' "$targets" | grep -c .)"
      if [ "$target_count" -eq 1 ]; then
        case "$targets" in
          http://127.0.0.1:*) inferred_port="${targets#http://127.0.0.1:}" ;;
        esac
      fi
    fi
    # _funnel_looks_up reads .Funnel/.Serve -- a different view of the same
    # status than ts_funnel_foreign_targets's .Web/.TCP above (D6) -- a
    # target can show in one and not the other, so check both before
    # deciding whether there was actually anything to report on.
    _funnel_looks_up "$status_json" && was_up=true
    _funnel_stop_and_verify "hmd app disconnect" 443 "$inferred_port"
    vrc=$?
    if [ "$vrc" -eq 0 ]; then
      if [ "$was_up" = true ]; then
        echo "hmd app disconnect: stopped (no state file, but an orphaned funnel was found and cleared)"
      else
        echo "hmd app disconnect: not connected (no state file)"
      fi
    fi
    return "$vrc"
  fi

  local pid_ui https_port port
  pid_ui="$(_doc_field "$connect_doc" .pid_ui)"
  case "$pid_ui" in ''|*[!0-9]*) pid_ui="" ;; esac
  https_port="$(_doc_field "$connect_doc" .https_port)"
  case "$https_port" in 443|8443|10000) ;; *) https_port=443 ;; esac
  port="$(_doc_field "$connect_doc" .port)"
  _ui_port_ok "$port" || port=""  # only ever the backend a funnel target is recognised as hmd's own by -- never a port to reuse

  # A11/A13: pass hmd's own backend port so ts_funnel_stop recognizes its
  # own target instead of conservatively refusing (exit 7) to reset it.
  _funnel_stop_and_verify "hmd app disconnect" "$https_port" "$port"
  vrc=$?

  # A14: verify identity before signaling -- a recycled pid must never take
  # an unrelated process down with it.
  _stop_recorded_ui "$pid_ui" "$repo_real" published

  _state_remove "$REPO" connect.json
  # N1: disconnect must never claim success while the funnel is still
  # publicly reachable -- only print "stopped" (and only exit 0) once
  # _funnel_stop_and_verify has actually confirmed it's down. The ui
  # kill/state-file removal above still happen unconditionally either way --
  # a bad Funnel teardown must not leave the ui process or state file behind
  # too.
  [ "$vrc" -eq 0 ] && echo "hmd app disconnect: stopped"
  return "$vrc"
}

# cmd_disconnect_relay: the --relay counterpart to cmd_disconnect above.
# $1: REPO (already resolved). $2: connect.json's path (already confirmed to
# exist with mode "relay" by the caller).
cmd_disconnect_relay() {
  local REPO="$1" repo_real="$2" doc="$3"
  local pid_ui pid_client
  pid_ui="$(_doc_field "$doc" .pid_ui)"
  pid_client="$(_doc_field "$doc" .pid_client)"
  case "$pid_ui" in ''|*[!0-9]*) pid_ui="" ;; esac
  case "$pid_client" in ''|*[!0-9]*) pid_client="" ;; esac
  local rc=0 did dpid devs="${4:-}"  # devs: "<id> <pid>" per phone paired when this disconnect began, listed by cmd_disconnect before any client went
  # every phone's client, an added one too: each revokes its own relay session on TERM
  _stop_device_clients "$REPO" "$repo_real" || rc=$?

  # A14: verify identity before signaling -- a recycled pid, another repo's process or a number a checkout planted must never
  # take an unrelated process down with it: it has to be a relay client run for THIS repo.
  if _pid_is_relay_client "$pid_client" "$repo_real"; then
    _relay_stop_client "$pid_client"
    rc=$?
  elif [ -n "$pid_client" ] && kill -0 "$pid_client" 2>/dev/null; then
    echo "hmd app disconnect: pid $pid_client in state file is not a heimdall-relay-client process of this repo -- not killing it" >&2
  fi

  if [ "$rc" -ne 0 ]; then
    echo "hmd app disconnect: revoke may not have reached the relay -- the pairing session stays open until its token expires" >&2
  fi
  # every phone that was bound goes from the records now that its client is gone -- a client older than the records removed none of it --
  # and one whose push registrations cannot be removed is reported, never counted as disconnected
  while read -r did dpid; do
    [ -n "$did" ] || continue
    "$PY3" "$LIB_DIR/hmd_devices.py" forget --repo "$REPO" "$did" >/dev/null 2>&1 \
      || { echo "hmd app disconnect: device $did: its push registrations could not be removed, so it may still be notified and its record is kept" >&2; rc=1; }
  done <<<"$devs"

  _stop_recorded_ui "$pid_ui" "$repo_real"

  # Unconditional either way, matching cmd_disconnect's own documented
  # rationale above: a bad revoke must not leave the ui process or either
  # state file behind too.
  _state_remove "$REPO" connect.json
  _state_remove "$REPO" relay.json

  [ "$rc" -eq 0 ] && echo "hmd app disconnect: stopped"
  return "$rc"
}

# _stop_device_clients REPO REPO_REAL [PID...] -- end every relay client that serves a phone of REPO (the repo's device records name them), and
# the extra PIDs given (a client still offering the code): ONE TERM each, all asked first so they revoke their relay sessions side by side,
# then each waited for. A number is signalled only while it is still a relay client of THIS repo. 8 when one had to be force-killed.
_stop_device_clients() {
  local repo="$1" real="$2" pid pids="" rc=0
  shift 2
  if [ -n "$PY3" ]; then
    for pid in "$@" $("$PY3" "$LIB_DIR/hmd_devices.py" list --repo "$repo" 2>/dev/null | jq -r '.[].pid' 2>/dev/null); do
      case " $pids " in *" $pid "*) continue ;; esac
      _pid_is_relay_client "$pid" "$real" && pids="$pids $pid"
    done
  fi
  for pid in $pids; do kill -TERM "$pid" 2>/dev/null || true; done
  for pid in $pids; do _relay_stop_client "$pid" 0 || rc=$?; done
  return "$rc"
}

# _add_device_window_s -- how long `hmd app add-device` offers the code: HMD_ADD_DEVICE_WINDOW_S seconds, default 600, never above an hour.
# What is not a positive number is the default: this limits a way in, so a bad value never lengthens it.
_add_device_window_s() {
  local s="${HMD_ADD_DEVICE_WINDOW_S:-600}"
  _pw_seconds_ok "$s" || s=600
  awk -v s="$s" 'BEGIN { s = int(s); if (s < 1) s = 1; if (s > 3600) s = 3600; printf "%d", s }'
}

# The extra client `hmd app add-device` runs while it owns it: ended (TERM, so it revokes its relay session itself and the code is free again)
# by Ctrl-C, TERM or a window nobody claimed; once a phone has paired it is that phone's (AD_KEEP) and is left running.
AD_PID=""
AD_OUT=""
AD_KEEP=false
# shellcheck disable=SC2329  # runs via the traps cmd_add_device installs
_add_device_cleanup() {
  if [ "$AD_KEEP" != true ] && [ -n "$AD_PID" ] && kill -0 "$AD_PID" 2>/dev/null; then
    kill -TERM "$AD_PID" 2>/dev/null || true
    _relay_stop_client "$AD_PID" 0 || true
  fi
  [ -z "$AD_OUT" ] || rm -f "$AD_OUT" 2>/dev/null || true
  exec 3>&-
}

# cmd_add_device: `hmd app add-device` -- see the usage block. One more relay client (--code-only: it ends with its window, which closes at
# its own expiry; a relay session binds exactly one phone, so it admits one) offers the repo's code for HMD_ADD_DEVICE_WINDOW_S seconds. The
# code and its expiry are printed only once the relay has REGISTERED the window (the client's code_window event): a code shown before that
# would 404 a phone that typed it, and those misses count toward the relay's lockout.
cmd_add_device() {
  local REPO="" RELAY_URL="" CONFIRM=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO="${2:-}"; if [ $# -ge 2 ]; then shift 2; else shift 1; fi ;;
      --relay) RELAY_URL="${2:-}"; if [ $# -ge 2 ]; then shift 2; else shift 1; fi ;;
      --confirm) CONFIRM=true; shift ;;
      *) echo "hmd app add-device: unknown flag: $1" >&2; return 2 ;;
    esac
  done
  REPO="$(resolve_repo_value "$REPO")"
  RELAY_URL="${RELAY_URL:-${HMD_RELAY_URL:-$DEFAULT_RELAY_URL}}"
  local repo_real code n limit win_s port gh_tok="" ctl line ev seen=0 client_gone=false deadline exp when label login reason failed="" registered=false paired=false
  local min_s lead_s relay_host args
  if [ -z "$PY3" ] || [ ! -x "$RELAY_CLIENT_BIN" ]; then
    echo "hmd app add-device: python3 and bin/heimdall-relay-client are needed" >&2
    return 2
  fi
  repo_real="$(_real_dir "$REPO")" || { echo "hmd app add-device: not a directory: $REPO" >&2; return 2; }
  # a running `connect --confirm` compares every phone it pairs: an added one too
  _pw_confirm_connect_live "$REPO" && CONFIRM=true
  if [ "$CONFIRM" = true ] && [ ! -t 0 ]; then
    echo "hmd app add-device: the compare is asked at this terminal and stdin is not one -- run it at a terminal" >&2
    return 64
  fi
  n="$(_dev_count "$REPO")"
  limit="$(_dev_limit)"
  if [ "$n" -lt 1 ]; then
    echo "hmd app add-device: no phone is paired to this repo yet -- nothing to add to. The first one pairs by the code hmd app connect or the pair window offers (hmd app status)" >&2
    return 1
  fi
  if [ "$n" -ge "$limit" ]; then
    echo "hmd app add-device: $n phones are paired (limit $limit) -- hmd app disconnect --device <label|id> frees a place" >&2
    return 1
  fi
  code="$(_session_code_for_repo "$REPO")" || { echo "hmd app add-device: could not derive this repo's code" >&2; return 2; }
  _connect_state_ready "$REPO" || return 2
  if ! _gh_token_into gh_tok; then
    echo "hmd app add-device: laptop not signed in to GitHub (gh auth login) -- the code cannot be offered" >&2
    return 3
  fi
  win_s="$(_add_device_window_s)"
  port=0
  if _pw_connect_live "$REPO"; then
    port="$(_doc_field "$(_connect_doc "$REPO")" .port)"
    _ui_port_ok "$port" || port=0
  fi
  relay_host="$(printf '%s' "$RELAY_URL" | sed -E 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##; s#/.*$##; s#:.*$##')"
  AD_OUT="$(umask 077; mktemp)" || { echo "hmd app add-device: mktemp failed" >&2; return 2; }
  ctl="$(umask 077; mktemp -d)" || return 2
  if ! mkfifo "$ctl/in" 2>/dev/null; then
    rm -rf "$ctl"
    return 2
  fi
  exec 3<>"$ctl/in"
  exec 4<"$ctl/in"
  rm -rf "$ctl"
  trap '_add_device_cleanup; exit 130' INT
  trap '_add_device_cleanup; exit 143' TERM
  trap '_add_device_cleanup; exit 129' HUP
  trap _add_device_cleanup EXIT
  read -r _ min_s lead_s _ <<<"$(_connect_window_knobs false)"
  args=(--relay "$RELAY_URL" --repo "$REPO" --ui-port "$port" --public-host "$relay_host" --code "$code" --code-only)
  [ "$CONFIRM" = true ] || args+=(--no-confirm)
  HMD_RELAY_EVENT_LOG="" HMD_RELAY_CODE_WINDOW_S="$win_s" HMD_RELAY_CODE_RENEW_MIN_S="$min_s" HMD_RELAY_CODE_RENEW_LEAD_S="$lead_s" \
    HMD_RELAY_CODE_RENEW_EVENT_MIN_S="$min_s" \
    "$RELAY_CLIENT_BIN" "${args[@]}" <&4 3>&- 4>&- >"$AD_OUT" 2>/dev/null &
  AD_PID=$!
  exec 4<&-
  printf '%s\n' "$gh_tok" >&3
  gh_tok=""
  [ "$CONFIRM" = true ] || exec 3>&-  # --confirm keeps the pipe: the operator's answer goes down it
  deadline=$(( $(date +%s) + 30 ))
  while :; do
    while IFS= read -r -u 5 line; do
      seen=$((seen + 1))
      [ -n "$line" ] || continue
      ev="$(printf '%s' "$line" | jq -r '.event // empty' 2>/dev/null)"
      case "$ev" in
        code_window)
          registered=true
          exp=$(( $(date +%s) + win_s ))
          when="$(date -u -r "$exp" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$exp" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "$exp")"
          echo "hmd app add-device: ONE more phone can pair for the next ${win_s}s (until $when)."
          echo "  SESSION CODE: $code"
          echo "  In the hmd app tap \"Enter code\" and type $code. Only a phone signed in to the same GitHub account can use it. The window closes when a phone pairs, at the expiry, or on Ctrl-C."
          if [ "$CONFIRM" = true ]; then echo "  The phone shows a 6-digit number: compare it with the one shown here and approve it."; fi
          ;;
        code_unavailable)
          reason="$(_clean_text "$(printf '%s' "$line" | jq -r '.reason // empty' 2>/dev/null)")"
          case "$reason" in
            no-gh) failed="laptop not signed in to GitHub (gh auth login)" ;;
            conflict) failed="session code $code is held by another open window of yours -- wait for it to close" ;;
            disabled) failed="this relay has code pairing disabled" ;;
            device-limit) failed="$limit phones are paired to this repo already (the limit)" ;;
            *) failed="the relay answered ${reason:-nothing usable}" ;;
          esac
          ;;
        approve_request) _sas_prompt "$line" ;;
        code_paired)
          label="$(_safe_label "$(printf '%s' "$line" | jq -r '.device_label // empty' 2>/dev/null)")"
          login="$(_safe_login "$(printf '%s' "$line" | jq -r '.gh_login // empty' 2>/dev/null)")"
          echo "hmd app add-device: phone paired via code -- relay-claimed device '${label:-unnamed device}', GitHub @${login:-unknown}. The window is closed again; hmd app status lists the phones."
          paired=true
          ;;
      esac
    done 5< <(tail -n +"$((seen + 1))" "$AD_OUT" 2>/dev/null)
    [ "$paired" = true ] && break
    [ -z "$failed" ] || break
    [ "$client_gone" = true ] && break
    if ! kill -0 "$AD_PID" 2>/dev/null; then
      client_gone=true  # one more look at what it printed on its way out
      continue
    fi
    if [ "$registered" != true ] && [ "$(date +%s)" -ge "$deadline" ]; then
      failed="the relay did not register the code within 30 s"
      break
    fi
    if [ "$registered" = true ] && [ "$(date +%s)" -ge "$exp" ]; then
      break  # the window's time is up and nobody paired: the client is asked to end below (it revokes its session), so the code is free again
    fi
    sleep 0.2
  done
  if [ "$paired" = true ]; then
    AD_KEEP=true  # the client is the phone's now: it outlives this command, as `connect --bg`'s does
    trap - INT TERM HUP EXIT
    exec 3>&-
    disown "$AD_PID" 2>/dev/null || true
    rm -f "$AD_OUT" 2>/dev/null || true
    return 0
  fi
  if [ -n "$failed" ]; then
    echo "hmd app add-device: $failed" >&2
  else
    echo "hmd app add-device: no phone paired -- the window closed (hmd app add-device opens another)" >&2
  fi
  return 1
}

cmd_doctor() {
  local REPO="" HTTPS_PORT="443" RELAY_URL=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        REPO="${2:-}"
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      --https-port)
        HTTPS_PORT="${2:-}"
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      --relay)
        RELAY_URL="${2:-}"
        if [ $# -ge 2 ]; then shift 2; else shift 1; fi
        ;;
      *) echo "hmd app doctor: unknown flag: $1" >&2; return 2 ;;
    esac
  done
  REPO="$(resolve_repo_value "$REPO")"

  # relay mode: --relay wins if given; otherwise inferred from a live
  # connect.json, so `hmd app doctor` alone still diagnoses the session
  # that's actually running -- same inference cmd_status/cmd_disconnect use.
  local relay_mode=false
  if [ -n "$RELAY_URL" ]; then
    relay_mode=true
  else
    if [ "$(_doc_field "$(_connect_doc "$REPO")" .mode)" = "relay" ]; then
      relay_mode=true
      # a file in the repo says THAT a relay is in use, never which one: doctor asks the relay the environment (or the default) names
      RELAY_URL="${HMD_RELAY_URL:-$DEFAULT_RELAY_URL}"
    fi
  fi

  echo "hmd app doctor"
  local failed=0 installed=false online=false

  if [ "$relay_mode" = true ]; then
    echo "skip  tailscale installed (relay mode)"
  elif ts_installed; then
    echo "ok    tailscale installed"
    installed=true
  else
    echo "FAIL  tailscale installed"
    echo "      fix: run 'hmd app connect' to be offered an install, or see https://tailscale.com/download"
    failed=$((failed + 1))
  fi

  if [ "$relay_mode" = true ]; then
    echo "skip  tailscale build variant (relay mode)"
    echo "skip  tailscale daemon running (relay mode)"
    echo "skip  logged in / online (relay mode)"
    echo "skip  DNSName resolvable (relay mode)"
    echo "skip  funnel capability (relay mode)"
    echo "skip  HTTPS certs / funnel node attribute (relay mode)"
    echo "skip  https-port allowed (relay mode)"

    if [ -n "$RELAY_URL" ]; then
      local relay_code
      relay_code="$(curl -sS -m 10 -o /dev/null -w '%{http_code}' -X GET "${RELAY_URL%/}/pair/init" 2>/dev/null)"
      if [ -n "$relay_code" ] && [ "$relay_code" != "000" ]; then
        echo "ok    relay reachable ($RELAY_URL, HTTP $relay_code)"
      else
        echo "FAIL  relay reachable"
        echo "      fix: relay unreachable -- carrier or DNS blackhole? try another network"
        failed=$((failed + 1))
      fi
    else
      echo "FAIL  relay reachable"
      echo "      fix: pass --relay <url>, or connect first so doctor can read it from connect.json"
      failed=$((failed + 1))
    fi
  else
    # 2026-09-21 tailscale-macsys-funnel-cli-error-3: the macsys/App Store
    # build advertises the same modern funnel flags in --help as the
    # open-source build, but Funnel only ever works on open-source tailscaled
    # -- this machine can easily have both installed (Homebrew AND the App
    # Store GUI) at once, so the resolved binary PATH is printed alongside the
    # variant, not just the classification, so a "why does it say macsys" ever
    # comes down to one visible fact instead of a guess.
    local variant="" variant_failed=false bin_path=""
    if [ "$installed" = true ]; then
      bin_path="$(ts_bin 2>/dev/null || echo '(unresolved)')"
      variant="$(ts_variant 2>/dev/null || echo unknown)"
      case "$variant" in
        oss)
          echo "ok    tailscale build variant ($variant, $bin_path)"
          ;;
        macsys|appstore)
          echo "FAIL  tailscale build variant ($variant, $bin_path)"
          echo "      fix: install the open-source build: brew install tailscale (then: tailscale up)"
          failed=$((failed + 1))
          variant_failed=true
          ;;
        *)
          echo "warn  tailscale build variant (unknown, $bin_path) -- Funnel support could not be confirmed"
          ;;
      esac
    else
      echo "FAIL  tailscale build variant"
      echo "      fix: resolve the tailscale-installed check above first"
      failed=$((failed + 1))
    fi

    local daemon_rc=99
    if [ "$installed" = true ]; then
      ts_status_json >/dev/null 2>/dev/null
      daemon_rc=$?
    fi
    if [ "$daemon_rc" -eq 0 ]; then
      echo "ok    tailscale daemon running"
    elif [ "$installed" = false ]; then
      echo "FAIL  tailscale daemon running"
      echo "      fix: resolve the tailscale-installed check above first"
      failed=$((failed + 1))
    else
      echo "FAIL  tailscale daemon running"
      echo "      fix: start tailscaled (Linux: sudo systemctl start tailscaled; macOS: open the Tailscale app)"
      failed=$((failed + 1))
    fi

    if [ "$daemon_rc" -eq 0 ] && ts_online; then
      echo "ok    logged in / online"
      online=true
    else
      echo "FAIL  logged in / online"
      echo "      fix: run 'tailscale up' and complete login"
      failed=$((failed + 1))
    fi

    if [ "$online" = true ]; then
      local dns dns_hint
      dns="$(ts_dns_name 2>/dev/null || true)"
      if [ -n "$dns" ]; then
        echo "ok    DNSName resolvable ($dns)"
        dns_hint="$(_dns_suffix_hint "$dns")"
        [ -n "$dns_hint" ] && echo "info  $dns_hint"
      else
        echo "FAIL  DNSName resolvable"
        echo "      fix: wait a few seconds for tailscaled to register a name, then retry"
        failed=$((failed + 1))
      fi
    else
      echo "FAIL  DNSName resolvable"
      echo "      fix: resolve the checks above first"
      failed=$((failed + 1))
    fi

    if [ "$installed" = true ] && [ "$variant_failed" = true ]; then
      # The variant check above already failed (macsys/App Store) -- Funnel
      # never works there regardless of what --help advertises, so this must
      # FAIL too, with the same brew-install fix, rather than trust
      # ts_funnel_supported's content-sniffed "upgrade the client" hint (which
      # is correct for a genuinely outdated CLI, but wrong for this case).
      echo "FAIL  funnel capability (blocked by unsupported tailscale build)"
      echo "      fix: install the open-source build: brew install tailscale (then: tailscale up)"
      failed=$((failed + 1))
    elif [ "$installed" = true ]; then
      local mode
      mode="$(ts_funnel_supported)"
      case "$mode" in
        modern|legacy)
          echo "ok    funnel capability ($mode)"
          ;;
        *)
          echo "FAIL  funnel capability (none)"
          echo "      fix: upgrade the tailscale client -- this version doesn't expose funnel"
          failed=$((failed + 1))
          ;;
      esac
    else
      echo "FAIL  funnel capability"
      echo "      fix: resolve the tailscale-installed check above first"
      failed=$((failed + 1))
    fi

    if [ "$installed" = true ]; then
      if ts_funnel_status_json >/dev/null 2>/dev/null; then
        echo "ok    HTTPS certs / funnel node attribute (best-effort -- the CLI answered a"
        echo "      funnel/serve status query; this does NOT prove Funnel will start. Run"
        echo "      'hmd app connect' to fully confirm.)"
      else
        echo "FAIL  HTTPS certs / funnel node attribute"
        echo "      fix: run 'tailscale funnel status' to see the underlying error, or grant"
        echo "      HTTPS certs + the Funnel node attribute in the tailnet admin console"
        echo "      (https://login.tailscale.com/admin/dns)"
        failed=$((failed + 1))
      fi
    else
      echo "FAIL  HTTPS certs / funnel node attribute"
      echo "      fix: resolve the tailscale-installed check above first"
      failed=$((failed + 1))
    fi

    case "$HTTPS_PORT" in
      443|8443|10000)
        echo "ok    https-port allowed ($HTTPS_PORT)"
        ;;
      *)
        echo "FAIL  https-port allowed ($HTTPS_PORT)"
        echo "      fix: use one of 443, 8443, 10000 -- the only ports Tailscale Funnel allows"
        failed=$((failed + 1))
        ;;
    esac
  fi

  if [ -n "$PY3" ]; then
    echo "ok    python3 resolvable ($PY3)"
  else
    echo "FAIL  python3 resolvable"
    echo "      fix: install python3, or set HMD_PYTHON=/path/to/python3"
    failed=$((failed + 1))
  fi

  if [ -x "$UI_BIN" ]; then
    echo "ok    bin/heimdall-ui present"
  else
    echo "FAIL  bin/heimdall-ui present"
    echo "      fix: reinstall heimdall -- bin/heimdall-ui is missing or not executable at $UI_BIN"
    failed=$((failed + 1))
  fi

  echo ""
  if [ "$failed" -eq 0 ]; then
    echo "hmd app doctor: all checks passed"
    return 0
  fi
  echo "hmd app doctor: $failed check(s) failed"
  return 1
}

CMD="${1:-}"
if [ $# -gt 0 ]; then shift; fi

case "$CMD" in
  ""|help)
    usage
    exit 0
    ;;
  connect) cmd_connect "$@"; exit $? ;;
  pair-window) cmd_pair_window "$@"; exit $? ;;
  pair-window-loop) cmd_pair_window_loop "$@"; exit $? ;;
  identity) cmd_identity "$@"; exit $? ;;
  status) cmd_status "$@"; exit $? ;;
  disconnect) cmd_disconnect "$@"; exit $? ;;
  add-device) cmd_add_device "$@"; exit $? ;;
  doctor) cmd_doctor "$@"; exit $? ;;
  remote-login) cmd_remote_login "$@"; exit $? ;;
  remote-launch|remote-merge|launch-allow|remote-dashboards|remote-asks|remote-alerts) cmd_remote_switches "$CMD" "$@"; exit $? ;;
  controls) cmd_controls "$@"; exit $? ;;
  push-test) cmd_push_test "$@"; exit $? ;;
  *)
    echo "hmd app: unknown subcommand: $CMD" >&2
    usage >&2
    exit 2
    ;;
esac
