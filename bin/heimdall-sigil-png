#!/usr/bin/env bash
# heimdall-sigil-png — the `hmd sigil-png` front door: a CRISP PNG render of the
# deterministic watchman sigil, for the surfaces that can display an image (the
# share card avatar, the presence wall). The ANSI terminal keeps its half-block
# approximation; THIS emits a true-fidelity pixel-art PNG that matches RJ's
# high-res reference gallery (.planning/ref/sigil-target-spec.md).
#
# Thin router to the SHARED render core (sentinels/hmd_sigil_png.py), which reuses
# the SAME value→color palette as the terminal sigil (sentinels/hmd_sigil.py) — so
# the terminal and the PNG agree hue-for-hue. Pure stdlib (PNG via zlib/struct); no
# extra dependency. Deterministic: same sprite → byte-identical PNG.
#
#   hmd sigil-png --seed fox --out fox.png            render a sprite by name
#   hmd sigil-png --seed fox --emotion rage --out f.png   an emotion variant
#   hmd sigil-png --seed <HAID> --out me.png          a HAID → its family sprite
#   hmd sigil-png --seed lisa --scale 32 --out l.png  a bigger render (px/pixel)
#   hmd sigil-png --seed fox > fox.png                PNG bytes to stdout (no --out)
set -euo pipefail

self="$0"
if command -v readlink >/dev/null 2>&1; then
  self="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$self")" && pwd)"
PNG_PY="$BIN_DIR/../sentinels/hmd_sigil_png.py"

if [ ! -f "$PNG_PY" ]; then
  echo "  Error: sigil PNG core not found at $PNG_PY" >&2
  echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
  exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo "  Error: python3 is required to render the sigil PNG" >&2
  exit 1
fi

exec python3 "$PNG_PY" "$@"
