#!/usr/bin/env bash
# heimdall-metric-hook — mechanical bridge from the SubagentStop hook event to
# `heimdall-metric task`, so routing-relevant records land in
# .planning/metrics.jsonl without depending on anyone remembering the prose
# instruction to call heimdall-metric themselves.
#
# WHY: measured in THIS repo, hooks that PERFORM get ~100% adoption while
# advisory/prose-instructed mechanisms get ignored — 130 parallelism-tracker
# records vs 5 heimdall-metric records over the same 83-day window
# (.planning/metrics.jsonl). bin/heimdall-dream has never fired once: "task-
# outcome records seen: 5" sits under its own 20-per-(task_type,model) sample
# floor. The fix is not a louder reminder (measured to fail the same way,
# repeatedly) — it's a hook that calls heimdall-metric itself, unconditionally.
#
# WHAT THIS HONESTLY OBSERVES vs WHAT IT REFUSES TO GUESS:
#   task_type — REAL, but only for a short allowlist of SINGLE-PURPOSE agents
#               (see the case below) whose entire agents/*.md job description
#               IS one documented task type — lint-quality only lints,
#               docs-writer only writes docs, and so on, so the mapping
#               states a fact instead of guessing one. Every other
#               agent_type — including "coder", which builds features,
#               writes tests, AND updates docs in the same run — is
#               genuinely multi-purpose, so its task_type is OMITTED (null),
#               never guessed. Previously this slugged the RAW agent_type
#               itself, which produced off-vocabulary values ("coder",
#               "hmd-coder" — two spellings of one thing, and neither is in
#               bin/heimdall-metric's own documented vocabulary:
#               lint|docs|code|test|review|plan|design|security) instead of
#               a real task type or an honest null. Fixed 2026-08-23.
#   model     — REAL, but STATIC: read from the agent's own agents/<name>.md
#               frontmatter (`model:` line) — the same table the orchestrator
#               itself dispatches from. This is NOT the live per-call model:
#               a spawn-time `model:` override on the Agent tool_input is
#               invisible to SubagentStop (confirmed: no hook-accessible
#               `model` field exists outside SessionStart), and
#               subagent_type=fork always inherits the parent's own live
#               model (the Agent tool's own documented contract), which a
#               hook has no way to observe either — so fork calls are SKIPPED
#               below, never guessed at.
#   effort    — REAL: SubagentStop's own `effort.level` field, when present.
#               Omitted (not defaulted) when absent.
#   outcome   — Fail-only, and only from real transcript evidence, never from
#               last_assistant_message. Two eras below, both kept documented
#               because era 1's reasoning is exactly why era 2 stays narrow.
#
#               ERA 1 (outcome removed entirely, 2026-08-23): checked against
#               the official Claude Code hooks reference, SubagentStop's
#               payload carries NO success/failure/termination-reason field
#               of any kind — only agent_type, last_assistant_message, and
#               event plumbing (session_id, transcript paths,
#               stop_hook_active, ...). The only thing resembling a verdict
#               was last_assistant_message text — the AGENT'S OWN CLAIM, not
#               something this event can verify. This hook used to grep the
#               first 3 lines of that message for a Status Contract token
#               (DONE/DONE_WITH_CONCERNS -> pass, NEEDS_CONTEXT/BLOCKED ->
#               fail) on the premise that "every hmd:* agent definition
#               mandates this exact vocabulary" — false when checked: of the
#               16 shipped agents/*.md files, exactly ONE (coder.md) does.
#               For the other 15 the grep could only ever match a
#               coincidental substring, never a real signal — and even for
#               coder.md, a self-declared DONE is a claim the agent might be
#               wrong about, which is exactly the "did acceptance criteria
#               pass" fact a hook cannot truthfully observe. Recording it
#               anyway poisons the one number self-improve/dream route on.
#               last_assistant_message is STILL never inspected for outcome
#               below — that conclusion did not change.
#
#               This bullet used to also say it was undocumented whether
#               SubagentStop fires reliably on a killed (not clean) subagent.
#               RESOLVED, 2026-08-25:
#               docs/analysis/2026-08-25-hook-delivery-spike.md (Finding 2)
#               SIGKILLed a subagent's own foreground tool call directly and
#               observed SubagentStop fire ~2s later for that same agent_id.
#               It fires even when death is external and the subagent's own
#               code never runs another instruction — the firing logic lives
#               in the parent process, not in anything the dying subagent
#               cooperates with.
#
#               ERA 2 (fail-only outcome, ADDED 2026-08-25): that same spike
#               found the payload DOES carry a path to real evidence after
#               all — just not in a top-level field. `agent_transcript_path`
#               points at the dying subagent's OWN transcript, and a tool
#               call killed by a signal leaves a `tool_result` there with
#               `is_error:true` and content naming a 128+signal exit code
#               (137 for SIGKILL — the exact value the spike observed live).
#               _kill_outcome() below reads that, bounded and fail-open. When
#               it finds that structural marker, this hook adds `--outcome
#               fail` — a verified fact ("this agent's run included a killed
#               tool call"), not a guess. When it does NOT find the marker,
#               outcome is STILL omitted (null/unknown), exactly as in era 1:
#               absence of a kill marker is not evidence of a clean pass, so
#               this hook NEVER emits `--outcome pass`, under any condition,
#               from any signal. A record with task_type/model/effort but no
#               outcome remains just as useful as in era 1 — it proves the
#               hook fired and shows real per-tier usage volume — it just
#               cannot feed a pass-rate comparison. A verified PASS still
#               belongs to whoever can actually check acceptance criteria: an
#               orchestrator, calling `heimdall-metric task --outcome pass
#               ...` itself once it knows.
#   wall_secs, retries, escalated_to — DELIBERATELY OMITTED in this version.
#               SubagentStop is a single, self-sufficient event with no
#               correlated start-time or retry-count reachable from it without
#               a fragile cross-event join (tool_use_id is not echoed back to
#               SubagentStop). Leaving a field heimdall-metric already
#               defaults sensibly (0) unset is honest; inventing a start time
#               to subtract would not be.
#
# MUST FAIL OPEN — a metrics emitter is telemetry, not a correctness gate.
# Every path below reaches exit 0; heimdall-metric is never called with
# --strict, and its own exit code is always discarded.
set -uo pipefail
# No `set -e`, on purpose (mirrors bin/heimdall-precheck-agent): a stray
# nonzero from jq/grep on an odd payload must fall through to the next guard
# clause, never abort the script counted as some kind of denial — this hook
# has no denial path at all, only "record" or "skip".

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$BIN_DIR/.." && pwd)"
METRIC_BIN="$BIN_DIR/heimdall-metric"

# Bound on bytes read from a subagent's own transcript when checking for a
# non-clean-termination marker (see _kill_outcome below). Transcripts in this
# repo run tens to hundreds of KB; a kill's own tool_result sits within a
# handful of lines of the SubagentStop event that follows it ~2s later
# (measured: docs/analysis/2026-08-25-hook-delivery-spike.md, Finding 2), so
# a bounded tail finds it without ever reading a whole file. Override only
# for tests.
TRANSCRIPT_TAIL_BYTES="${HMD_METRIC_HOOK_TRANSCRIPT_TAIL_BYTES:-65536}"

# _kill_outcome <agent_transcript_path> — prints "fail" (and nothing else) on
# stdout iff the tail of that transcript shows STRUCTURAL evidence a tool
# call this agent was running was killed by a signal: a `type:"user"` record
# whose message.content carries a tool_result with `is_error:true` and
# content naming an exit code in the 128-192 "128+signal" range (137 =
# SIGKILL, 143 = SIGTERM, ... — the POSIX convention, and the exact value
# confirmed live in docs/analysis/2026-08-25-hook-delivery-spike.md). This is
# a real, verified-from-evidence "fail", never a guess — same structural-
# field-over-prose-regex approach as bin/heimdall-529-scan's classify().
#
# Prints NOTHING in every other case — path empty/missing/not a regular
# file/unreadable, no jq, or a tail with no such marker — and NEVER prints
# "pass": absence of a kill marker is not proof of a clean success (the
# marker only exists for the failure case), so the caller must treat empty
# output as "unknown", exactly like the null `outcome` this hook already
# emitted before this function existed (see the `outcome` header bullet).
#
# Bounded and fail-open at every step, same contract as the rest of this
# file: a `tail`/`jq`/`grep` failure anywhere in the pipeline degrades to "no
# output", never a non-zero exit propagated to the caller.
_kill_outcome() {
  local path="$1"
  [ -n "$path" ] || return 0
  [ -f "$path" ] || return 0    # excludes missing paths, dirs, pipes, devices
  [ -r "$path" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0

  # tail -n +2 always drops exactly the byte-capped first line. This is safe
  # unconditionally, not just a conservative bias: transcript line 1 is
  # always the opening turn, and a tool_result (what we key on) can never be
  # the first line of any transcript — it requires a preceding tool_use.
  if tail -c "$TRANSCRIPT_TAIL_BYTES" "$path" 2>/dev/null \
      | tail -n +2 \
      | jq -R -r '
          try (
            (. | fromjson) as $r
            | select($r.type == "user")
            | ($r.message.content // [])[]?
            | select(.type == "tool_result" and .is_error == true)
            | (if (.content | type) == "string" then .content
               elif (.content | type) == "array" then
                 ([.content[]? | (.text // "")] | join(" "))
               else "" end)
          ) catch empty
        ' 2>/dev/null \
      | grep -Eqi 'exit[[:space:]]code[[:space:]:]*(12[89]|1[3-8][0-9]|19[0-2])([^0-9]|$)' 2>/dev/null
  then
    printf 'fail\n'
  fi
  return 0
}

# Bound on bytes read from a subagent's own transcript when SUMMING its token
# usage — distinct from TRANSCRIPT_TAIL_BYTES above, which only needs the last
# couple of lines for kill-detection. Token summing wants as much of the
# transcript as practical: undercounting a long agent's true cost is exactly
# the blindness this hook exists to fix. 8MiB mirrors
# bin/heimdall-session-usage's own DEFAULT_MAX_BYTES bound for the identical
# tradeoff (bounded-tail read, accept undercount only on a pathologically
# large file — transcripts in this repo run tens to hundreds of KB, so in
# practice this reads the WHOLE file). Override only for tests.
TOKEN_SUM_MAX_BYTES="${HMD_METRIC_HOOK_TOKEN_MAX_BYTES:-8388608}"

# _sum_tokens <agent_transcript_path> — prints the SUM (and nothing else) of
# every message.usage.{input_tokens,output_tokens,cache_creation_input_tokens,
# cache_read_input_tokens} block found in the transcript's tail (see
# TOKEN_SUM_MAX_BYTES). This is the same message.usage shape
# bin/heimdall-session-usage's _extract_usage_tokens() already parses in
# production in this repo — real, measured token spend, never an estimate.
#
# Prints NOTHING when the path is empty/missing/unreadable, jq is absent, or
# no record in the (bounded) transcript carries a usage block at all: absence
# of measurable data is not the same as a real zero, so the caller must treat
# empty output as "unmeasured" (omit --tokens) — exactly like _kill_outcome's
# own empty-output-means-unknown contract above.
#
# Fail-open at every step, same contract as the rest of this file.
_sum_tokens() {
  local path="$1"
  [ -n "$path" ] || return 0
  [ -f "$path" ] || return 0    # excludes missing paths, dirs, pipes, devices
  [ -r "$path" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0

  tail -c "$TOKEN_SUM_MAX_BYTES" "$path" 2>/dev/null \
      | tail -n +2 \
      | jq -R -r '
          try (
            (. | fromjson) as $r
            | ($r.message.usage // empty) as $u
            | ([$u.input_tokens, $u.output_tokens,
                $u.cache_creation_input_tokens, $u.cache_read_input_tokens]
               | map(select(type == "number")) | add // 0)
          ) catch empty
        ' 2>/dev/null \
      | awk '{s+=$1; n++} END {if (n>0) print s+0}'
  return 0
}

cmd_stop() {
  local target_repo="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) target_repo="${2:-.}"; shift 2 ;;
      *) shift ;;
    esac
  done

  local input
  input="$(cat 2>/dev/null || true)"
  [ -n "$input" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0

  local agent_type
  agent_type="$(printf '%s' "$input" | jq -r '.agent_type // empty' 2>/dev/null)"
  [ -n "$agent_type" ] || return 0
  [ "$agent_type" != "fork" ] || return 0   # live model unobservable here — skip, never guess

  local name def_file cand
  name="${agent_type#hmd:}"
  def_file=""
  for cand in "$PLUGIN_DIR/agents/$name.md" "$PLUGIN_DIR/agents/$agent_type.md"; do
    if [ -f "$cand" ]; then def_file="$cand"; break; fi
  done
  [ -n "$def_file" ] || return 0

  local model
  model="$(grep -m1 '^model:' "$def_file" 2>/dev/null | sed -E 's/^model:[[:space:]]*//; s/[[:space:]]+$//')"
  case "$model" in
    haiku|sonnet|opus) ;;
    *) return 0 ;;   # "inherit", unknown, or missing — genuinely unknown, skip rather than guess
  esac

  # task_type: an honest allowlist, never a slug of agent_type. Each entry's
  # agents/*.md description names ONE job and nothing else — that singularity
  # is what makes the mapping a stated fact rather than a guess. Every other
  # agent_type (coder, architect, fixer, wave-executor, heimdall,
  # database-architect, incident-responder, seeker, verifier, and any
  # custom/unrecognized type) is left "" below -> recorded as null, never
  # guessed. Vocabulary is bin/heimdall-metric's own:
  # lint|docs|code|test|review|plan|design|security — note "code" has no
  # entry here: no shipped single-purpose agent maps to it honestly today.
  local task_type=""
  case "$name" in
    lint-quality)     task_type=lint ;;
    docs-writer)      task_type=docs ;;
    test-runner)      task_type=test ;;
    reviewer)         task_type=review ;;
    planner)          task_type=plan ;;
    design)           task_type=design ;;
    security-auditor) task_type=security ;;
  esac

  local effort
  effort="$(printf '%s' "$input" | jq -r '.effort.level // empty' 2>/dev/null)"

  [ -x "$METRIC_BIN" ] || return 0

  local transcript_path outcome tokens
  transcript_path="$(printf '%s' "$input" | jq -r '.agent_transcript_path // empty' 2>/dev/null)"
  outcome="$(_kill_outcome "$transcript_path")"
  tokens="$(_sum_tokens "$transcript_path")"

  local args=(task --model "$model" --source subagentstop)
  [ -n "$task_type" ] && args+=(--type "$task_type")
  [ -n "$effort" ] && args+=(--effort "$effort")
  [ "$outcome" = "fail" ] && args+=(--outcome fail)
  [ -n "$tokens" ] && args+=(--tokens "$tokens")
  "$METRIC_BIN" --repo "$target_repo" "${args[@]}" >/dev/null 2>&1 || true

  # Best-effort: feed the SAME measured total into bin/heimdall-state's own
  # budget tracker (add-tokens/budget verbs already existed; nothing real fed
  # them). `heimdall-state budget` becomes the one command that answers "what
  # did this session cost" — wired to real evidence instead of a parallel
  # mechanism. heimdall-state needs an already-initialized heimdall-state.json
  # in target_repo (SessionStart's own `heimdall-state init` call provides
  # this in a live session); its own ensure_state() exits 1 when absent, which
  # this subshell swallows exactly like every other failure path here — never
  # allowed to affect this hook's own always-exit-0 contract.
  if [ -n "$tokens" ]; then
    local state_bin="$BIN_DIR/heimdall-state"
    if [ -x "$state_bin" ]; then
      ( cd "$target_repo" 2>/dev/null && "$state_bin" add-tokens "$tokens" ) >/dev/null 2>&1 || true
    fi
  fi
  return 0
}

case "${1:-}" in
  stop) shift; cmd_stop "$@" ;;
esac
exit 0
