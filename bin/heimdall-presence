#!/usr/bin/env bash
# heimdall-presence — the dev-side client for SERVER-SYNCED TEAM PRESENCE.
#
# WHAT IT IS. A dev's hmd reports WHERE it is working (a heartbeat) to the control plane,
# and any dev can read the ONLINE team for the current project. Presence is synced
# THROUGH the server (cp_presence on the StateBackend seam — Firestore-durable on Cloud
# Run), not via local files, so a dev sees teammates on OTHER machines.
#
# SUBCOMMANDS
#   heimdall-presence beat            send a heartbeat for THIS repo's project + identity.
#   heimdall-presence roster [--json] print the ONLINE team for THIS repo's project.
#
# ZERO-CONFIG. A dev's FIRST beat/roster auto-resolves everything — the dev exports
# NOTHING. The CP url comes from a shipped local config, the signing key is auto-generated
# + auto-enrolled + persisted on first use, the project id is stable across clones, and the
# handle comes from heimdall-identity. Manual env overrides still win where set.
#
# IDENTITY / PROJECT / WIRE (resolved; flag > env > config/derive):
#   identity HAID : --haid > $HMD_HAID > `heimdall-identity current` (if present)
#                 > `heimdall-haid current`.
#   project       : --project > the NORMALIZED git remote (host+path, scheme/user/port
#                   stripped, .git dropped, lowercased — so every CLONE of one remote shares
#                   ONE project id) > $HMD_PROJECT > the repo dir name.
#   server URL    : --url > $HEIMDALL_CP_URL > $BASE_URL > local config
#                   ${HOME}/.heimdall/cp-endpoint.json `.url` > the SHIPPED DEFAULT
#                   (DEFAULT_CP_URL — the public surface, baked in since the URL is not a
#                   secret, so a dev sets NOTHING for the URL; only the token is distributed).
#   signing seed  : $HMD_PRESENCE_SEED (dev-scoped override, testing only) > persisted
#                   ${HOME}/.heimdall/pki/<haid>.seed (mode 0600) > AUTO-BOOTSTRAP — keygen
#                   (cp_auth), POST
#                   SECURITY: the dev signs as ITSELF with its OWN per-dev key; it MUST NOT
#                   read $HEIMDALL_CP_PKI_KEY (the SERVER's Secret-Manager identity seed —
#                   server-only, never on a dev path).
#                   {url}/enroll {haid, pubkey, handle} (the config's enroll_token rides ONLY
#                   IF configured — an OPEN server enrolls tokenless, so ZERO dev config),
#                   persist the seed 0600, reuse it thereafter. The seed lives in-process +
#                   the 0600 file ONLY — NEVER printed/logged/argv'd. A failed enroll is
#                   throttled (an mtime stamp) so it never hammers the server per render.
#   handle        : --handle > $HMD_HANDLE > `heimdall-identity --handle`.
#   beat data     : --verdict/$HMD_VERDICT, --file/$HMD_FILE.
#
# GRACEFUL DEGRADE (the statusline reads this — it MUST never traceback). With NO URL or
# NO seed, or on ANY transport/auth failure, `roster` prints a CLEAN EMPTY roster ([] for
# --json) and exits 0; `beat` is a silent no-op and exits 0. Offline is normal, not an
# error. The signing path REUSES the shipped cp_auth signer — never hand-rolled Ed25519.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SELF_DIR/.." && pwd)"
LIB="$REPO/bin/lib"
HAID_CLI="$SELF_DIR/heimdall-haid"
IDENTITY_CLI="$SELF_DIR/heimdall-identity"   # forward-compat: preferred when present.

PY="$(command -v python3 || command -v python || true)"

# ── parse argv (subcommand + option-style overrides) ───────────────────────────
SUB="${1:-}"; shift || true
HAID=""; PROJECT=""; URL=""; HANDLE=""; VERDICT=""; FILE=""; JSON=""; GLOBAL=""; NOFILES=""
# STRICT surfaces a DROPPED/refused beat LOUDLY (nonzero exit) instead of the fire-and-forget
# exit-0 the statusline relies on. Default is the silent-safe path; --strict / HMD_PRESENCE_STRICT=1
# opts in (used by tooling + the BUG2 regression test to prove a failed beat no longer fakes
# success). Either way a dropped beat is NAMED on stderr (below) so a human running it manually
# — the exact way the invisible-beat bug surfaced — sees the failure instead of nothing.
STRICT="${HMD_PRESENCE_STRICT:-}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --haid)    HAID="${2:?--haid needs a value}"; shift 2 ;;
    --project) PROJECT="${2:?--project needs a value}"; shift 2 ;;
    --url)     URL="${2:?--url needs a value}"; shift 2 ;;
    --handle)  HANDLE="${2:?--handle needs a value}"; shift 2 ;;
    --verdict) VERDICT="${2:?--verdict needs a value}"; shift 2 ;;
    --file)    FILE="${2:?--file needs a value}"; shift 2 ;;
    --json)    JSON="1"; shift ;;
    --global)  GLOBAL="1"; shift ;;   # off/on: machine-wide kill switch (~/.heimdall/presence-off)
    --no-files) NOFILES="1"; shift ;; # on: stay present but withhold file/activity detail
    --strict)  STRICT="1"; shift ;;   # beat: surface a dropped/refused beat with a nonzero exit
    *) echo "heimdall-presence: unexpected argument: $1" >&2; exit 2 ;;
  esac
done

# `roster --json` with nothing configured must STILL emit a clean empty roster — define
# the offline emitters up front so every degrade path is one call (no traceback, exit 0).
emit_empty_roster() {
  if [ -n "$JSON" ]; then printf '[]\n'; else printf 'presence: no teammates online\n'; fi
  exit 0
}
beat_noop() { exit 0; }   # an unconfigured/failed beat is a silent no-op (offline is fine).

[ -n "$PY" ] || { [ "$SUB" = "roster" ] && emit_empty_roster || beat_noop; }
[ -f "$LIB/cp_auth.py" ] || { [ "$SUB" = "roster" ] && emit_empty_roster || beat_noop; }

# ── local config (${HOME}/.heimdall/cp-endpoint.json) — the shipped CP endpoint ──
# Zero-config: the install ships {url, enroll_token} here so a dev exports NOTHING. Parsed
# via python (already required above) so there is no jq dependency on the degrade path.
HMD_DIR="${HOME:-}/.heimdall"
CONFIG_FILE="$HMD_DIR/cp-endpoint.json"
CFG_URL=""; CFG_TOKEN=""
if [ -n "${HOME:-}" ] && [ -f "$CONFIG_FILE" ]; then
  CFG_OUT="$("$PY" - "$CONFIG_FILE" 2>/dev/null <<'PYEOF' || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    sys.stdout.write((d.get("url") or "") + "\n" + (d.get("enroll_token") or "") + "\n")
except Exception:
    sys.stdout.write("\n\n")
PYEOF
)"
  CFG_URL="$(printf '%s\n' "$CFG_OUT" | sed -n '1p')"
  CFG_TOKEN="$(printf '%s\n' "$CFG_OUT" | sed -n '2p')"
fi

# ── PRESENCE OPT-OUT (consent surface) — per-repo + global toggles ───────────────
# State (local, cheap, readable — no server round-trip to CHECK it):
#   • per-repo: <repo>/.heimdall/presence.json -> {"enabled": false} silences THIS repo;
#     {"files": false} keeps the dev present but withholds file detail. (gitignored by
#     `.heimdall/*` — one dev's choice must NEVER commit into a teammate's repo.)
#   • global:  ~/.heimdall/presence-off (EXISTENCE = off), mirroring the no-autoupdate stamp.
# EFFECTIVE = NOT global-off AND NOT repo-off. Default (no files) = ON — existing users
# unchanged. OFF = invisible (no beats), NOT blind (roster/status still work).
GLOBAL_OFF_FILE="$HMD_DIR/presence-off"
_pres_state_dir() {
  if [ -n "${HEIMDALL_PRESENCE_DIR:-}" ]; then printf '%s' "$HEIMDALL_PRESENCE_DIR"; return; fi
  local top; top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ]; then printf '%s/.heimdall' "$top"; else printf '%s/.heimdall' "$PWD"; fi
}
PRES_STATE_DIR="$(_pres_state_dir)"
PRES_STATE_FILE="$PRES_STATE_DIR/presence.json"

# Effective-state probes are PURE BASH ($(<file) is a builtin — no python, no subprocess),
# so a `beat` no-op is a stat-only fast path a cron/hook can't leak around the toggle.
_global_pres_off() { [ -f "$GLOBAL_OFF_FILE" ]; }
_repo_pres_off() {
  [ -f "$PRES_STATE_FILE" ] || return 1
  local c; c="$(<"$PRES_STATE_FILE")" 2>/dev/null || return 1
  [[ "$c" =~ \"enabled\"[[:space:]]*:[[:space:]]*false ]]
}
_pres_off() { _global_pres_off || _repo_pres_off; }
_repo_nofiles() {   # the --no-files sub-toggle: present, but file detail withheld.
  [ -f "$PRES_STATE_FILE" ] || return 1
  local c; c="$(<"$PRES_STATE_FILE")" 2>/dev/null || return 1
  [[ "$c" =~ \"files\"[[:space:]]*:[[:space:]]*false ]]
}
_write_pres_state() {   # atomic write of presence.json (gitignored; non-secret).
  mkdir -p "$PRES_STATE_DIR" 2>/dev/null || true
  local tmp="$PRES_STATE_FILE.tmp.$$"
  printf '%s\n' "$1" > "$tmp" 2>/dev/null && mv -f "$tmp" "$PRES_STATE_FILE" 2>/dev/null
}

# OFF = ZERO beats. A `beat` (from the statusline fork, a cron, or a hook) is a stat-only
# no-op when effectively off — no python, no network, no seed bootstrap. This is defense in
# depth: the statusline also skips the beat when off, but the toggle is enforced HERE too so
# nothing can leak a beat around it. Retire/roster/status/on/off still run when off.
if [ "$SUB" = "beat" ] && _pres_off; then beat_noop; fi

# Normalize a git remote URL to a STABLE project id: host+path, with scheme/userinfo/port
# stripped, an scp-style "host:path" colon -> "/", a trailing .git dropped, lowercased. All
# clones of one remote (https or ssh, any user/port) collapse to ONE id, so teammates on
# other machines/clones land in the SAME project.
normalize_remote() {
  printf '%s' "$1" \
    | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' \
          -e 's#^[^@/]*@##' \
          -e 's#:[0-9][0-9]*/#/#' \
          -e 's#:#/#' \
          -e 's#\.git$##' \
          -e 's#/$##' \
    | tr '[:upper:]' '[:lower:]'
}

# ── resolve identity / project / wire (flag > env > config/derive) ─────────────
[ -n "$HAID" ] || HAID="${HMD_HAID:-}"
if [ -z "$HAID" ]; then
  if [ -x "$IDENTITY_CLI" ]; then HAID="$("$IDENTITY_CLI" current 2>/dev/null || true)"; fi
fi
if [ -z "$HAID" ] && [ -x "$HAID_CLI" ]; then
  HAID="$("$HAID_CLI" current 2>/dev/null || true)"
fi

# project = STABLE across clones: --project flag wins; else the NORMALIZED git remote (so
# every clone of one remote shares ONE id, putting teammates in the SAME project); else
# $HMD_PROJECT; else the working tree's top-level dir name. Derived from CWD so the project
# tracks the repo the dev is in (not the heimdall checkout that hosts this script).
if [ -z "$PROJECT" ]; then
  REMOTE_URL="$(git config --get remote.origin.url 2>/dev/null || true)"
  [ -n "$REMOTE_URL" ] && PROJECT="$(normalize_remote "$REMOTE_URL")"
  [ -n "$PROJECT" ] || PROJECT="${HMD_PROJECT:-}"
  if [ -z "$PROJECT" ]; then
    TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "$TOP" ] && PROJECT="$(basename "$TOP")"
  fi
fi

[ -n "$URL" ] || URL="${HEIMDALL_CP_URL:-${BASE_URL:-}}"
[ -n "$URL" ] || URL="$CFG_URL"
# Shipped DEFAULT public-surface URL (lowest precedence — every source above overrides it).
# The CP URL is NOT a secret (a public --allow-unauthenticated Cloud Run endpoint), so it is
# baked in: a dev needs ZERO config for the URL; only the enroll TOKEN (a secret, never
# committed) is distributed. Override per-team with --url / $HEIMDALL_CP_URL / the config.
DEFAULT_CP_URL="https://heimdall-cp-public-eqfrs7sfuq-uc.a.run.app"
[ -n "$URL" ] || URL="$DEFAULT_CP_URL"
ENROLL_TOKEN="$CFG_TOKEN"   # the bootstrap enroll credential (config-only; never derived).
SEED="${HMD_PRESENCE_SEED:-}"   # dev-scoped override only; NEVER the server's $HEIMDALL_CP_PKI_KEY
[ -n "$HANDLE" ]  || HANDLE="${HMD_HANDLE:-}"
if [ -z "$HANDLE" ] && [ -x "$IDENTITY_CLI" ]; then
  HANDLE="$("$IDENTITY_CLI" --handle 2>/dev/null || true)"
fi
[ -n "$VERDICT" ] || VERDICT="${HMD_VERDICT:-}"
[ -n "$FILE" ]    || FILE="${HMD_FILE:-}"

# Per-(machine,repo) seed + enroll-throttle paths, keyed by haid (slugged so ':' and '/'
# never break the filename). The seed material lives ONLY in this 0600 file + the signing
# process — the bash side handles the PATH, never the seed bytes.
PKI_DIR=""; SEED_FILE=""; ENROLL_STAMP=""
if [ -n "${HOME:-}" ] && [ -n "$HAID" ]; then
  PKI_DIR="$HMD_DIR/pki"
  HAID_SLUG="$(printf '%s' "$HAID" | tr '/:' '__')"
  SEED_FILE="$PKI_DIR/$HAID_SLUG.seed"
  ENROLL_STAMP="$PKI_DIR/$HAID_SLUG.enroll-attempt"
fi

# OFFLINE / UNCONFIGURED -> clean degrade. We need a URL, an identity, and a project; the
# SEED may legitimately be ABSENT here — the client auto-bootstraps it in-process below
# (persisted 0600 seed, else keygen+enroll). With no URL/identity/project there is nothing
# to do. The statusline relies on this: presence is a best-effort overlay, never a hard dep.
if [ -z "$URL" ] || [ -z "$HAID" ] || [ -z "$PROJECT" ]; then
  case "$SUB" in
    roster) emit_empty_roster ;;
    beat)   beat_noop ;;
  esac
fi

# ── per-repo TEAM secret (multi-tenant presence) — RULING 1b AUTO-SOLO ──────────
# The team secret lives PER-REPO in <repo>/.heimdall/team.json (0600, gitignored),
# NOT the global cp-endpoint.json (a dev may be on different teams in different
# repos). It is sent ONCE in the X-Heimdall-Team-Secret header at /enroll; signed
# beats/reads thereafter carry NO secret (membership is server-side — the signed
# GET /roster returns the caller's team). If team.json is ABSENT we AUTO-MINT one
# SILENTLY (same shape as `heimdall-team new`) so a dev is ZERO-CONFIG and starts
# in their OWN solo team (sees only themselves until they share/invite). The secret
# crosses bash->python via the ENVIRONMENT only — NEVER argv (argv shows in `ps`).
TEAM_DIR="${HEIMDALL_TEAM_DIR:-}"
if [ -z "$TEAM_DIR" ]; then
  TEAM_TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$TEAM_TOP" ]; then TEAM_DIR="$TEAM_TOP/.heimdall"; else TEAM_DIR="$PWD/.heimdall"; fi
fi
TEAM_FILE="$TEAM_DIR/team.json"
SHARED_FILE="$TEAM_DIR/team.shared.json"
TEAM_SECRET=""
# Resolve the team secret with SHARED > PERSONAL > SOLO precedence, else AUTO-MINT a
# personal solo team 0600 (silent, non-fatal). The TRACKED team.shared.json (committed
# only in a verified-private repo by `heimdall-team share`/`auto`) WINS so a teammate
# who clones/pulls the repo AUTO-JOINS the repo's team; otherwise the dev's personal
# team.json is used; otherwise a fresh solo team is minted. All IO is python-side (no jq
# dependency); any failure leaves TEAM_SECRET empty (enroll then omits the header —
# graceful, never a traceback).
TEAM_SECRET="$(HMD_TEAM_DIR_R="$TEAM_DIR" HMD_TEAM_FILE_R="$TEAM_FILE" HMD_TEAM_SHARED_R="$SHARED_FILE" "$PY" - 2>/dev/null <<'PYEOF' || true
import json, os, secrets, sys, time
team_dir = os.environ["HMD_TEAM_DIR_R"]
path = os.environ["HMD_TEAM_FILE_R"]
shared = os.environ["HMD_TEAM_SHARED_R"]

def _read(p):
    try:
        s = json.load(open(p)).get("team_secret")
        return s if isinstance(s, str) and s else ""
    except Exception:
        return ""

# 1) SHARED (committed team) wins — a teammate who cloned the repo auto-joins its team.
s = _read(shared)
if s:
    sys.stdout.write(s)
    sys.exit(0)
# 2) PERSONAL team.json.
s = _read(path)
if s:
    sys.stdout.write(s)
    sys.exit(0)
# 3) AUTO-SOLO mint: write team.json 0600 with a fresh 43-char base64url secret.
try:
    os.makedirs(team_dir, mode=0o700, exist_ok=True)
    sec = secrets.token_urlsafe(32)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, (json.dumps({"team_secret": sec, "created": int(time.time()), "source": "auto-solo"}) + "\n").encode("utf-8"))
    finally:
        os.close(fd)
    os.chmod(path, 0o600)
    sys.stdout.write(sec)
except FileExistsError:
    # a concurrent mint won the race -> read it back.
    sys.stdout.write(_read(path))
except Exception:
    sys.stdout.write("")  # nowhere to persist / crypto fault -> stay header-less.
PYEOF
)"

# ── the signed HTTP client (REUSE the shipped cp_auth signer over urllib) ──────
# The seed is resolved IN-PROCESS (env > the 0600 seed file > auto-bootstrap) and is NEVER
# argv'd (argv shows in `ps`) or printed — only the seed-file PATH crosses from bash. POST
# /presence carries the heartbeat body; GET /roster?project=<p> is the GFE-safe read
# (job_id-style: project in the QUERY, EMPTY body — Google's GFE rejects a GET-with-a-body).
# The signature covers the FULL path-with-query (canonical_message), so the read is
# authenticated + tamper-evident. Mirrors deploy/cloud-run remote_client.py.
run_client() {
  LIB="$LIB" PRES_URL="$URL" PRES_HAID="$HAID" PRES_SEED="$SEED" \
  PRES_SEED_FILE="$SEED_FILE" PRES_ENROLL_TOKEN="$ENROLL_TOKEN" \
  PRES_ENROLL_STAMP="$ENROLL_STAMP" PRES_THROTTLE="${HMD_ENROLL_THROTTLE:-180}" \
  PRES_PROJECT="$PROJECT" PRES_HANDLE="$HANDLE" PRES_VERDICT="$VERDICT" \
  PRES_FILE="$FILE" PRES_VERB="$1" PRES_JSON="$JSON" PRES_TEAM_SECRET="$TEAM_SECRET" \
  PRES_STRICT="$STRICT" \
  "$PY" - <<'PYEOF'
import contextlib
import json
import os
import secrets
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.environ["LIB"])
import cp_auth as K  # the SHIPPED Ed25519 signer + keygen — never re-implemented.

BASE = os.environ["PRES_URL"].rstrip("/")
HAID = os.environ["PRES_HAID"]
VERB = os.environ["PRES_VERB"]
AS_JSON = bool(os.environ.get("PRES_JSON"))


def request(method, path, body, seed, *, timeout=10):
    """Sign canonical_message(METHOD, PATH, BODY) with `seed` and drive an HTTPS request.
    `path` is the FULL path AS TRANSMITTED (incl. any ?query — the signature covers it).
    An EMPTY body is sent as a TRUE bodyless request (data=None) so a GFE-safe GET carries
    no body. Returns (status, parsed_dict); a transport error returns (0, {})."""
    if isinstance(body, str):
        body = body.encode("utf-8")
    data = body if body else None
    req = urllib.request.Request(BASE + path, data=data, method=method)
    req.add_header("X-Heimdall-HAID", HAID)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    req.add_header("X-Heimdall-Signature", K.sign(seed, K.canonical_message(method, path, body)))
    # The per-repo TEAM SECRET rides the header on EVERY presence call (beat / retire / roster),
    # not just enroll — the server hashes it (derive_team_id) to the SAME partition the browser
    # /roster-team read derives, so a signed beat lands EXACTLY where its team.json secret reads it
    # back (the BUG2 write<->read round-trip). The signature covers only method+path+body, so this
    # header never perturbs it; the secret is sent over TLS, never argv, never logged.
    team_secret = os.environ.get("PRES_TEAM_SECRET") or ""
    if team_secret:
        req.add_header("X-Heimdall-Team-Secret", team_secret)
    token = os.environ.get("ID_TOKEN") or ""   # optional Cloud Run IAM bearer.
    if token:
        req.add_header("Authorization", "Bearer " + token)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else {})
    except urllib.error.HTTPError as exc:
        raw = exc.read()
        try:
            return exc.code, (json.loads(raw) if raw else {})
        except (ValueError, TypeError):
            return exc.code, {}
    except Exception:  # noqa: BLE001 — any transport/TLS/DNS fault degrades to offline.
        return 0, {}


# ── seed resolution + auto-bootstrap (zero-config: keygen -> enroll -> persist) ──


def _enroll(body, token, *, timeout=10):
    """The bootstrap enroll: POST /enroll {haid, pubkey, handle}. UNSIGNED by design — this
    is the chicken-and-egg step that REGISTERS the key, so no signature exists yet. The
    config's enroll_token rides in X-Heimdall-Enroll-Token ONLY WHEN ONE IS CONFIGURED; an
    OPEN server (HEIMDALL_ENROLL_OPEN=1) accepts a tokenless enroll, so a token is OMITTED
    when absent (a token-mode server still gets it). Returns the HTTP status (0 on any
    transport error).

    MULTI-TENANT: the per-repo TEAM SECRET (PRES_TEAM_SECRET, from <repo>/.heimdall/
    team.json — auto-minted if absent) rides the X-Heimdall-Team-Secret HEADER (kept
    out of any body log). The server hashes it to a team_id, binds this HAID to that
    team, and DISCARDS the raw secret — it is sent ONCE here at enroll; signed beats/
    reads thereafter carry NO secret (membership is server-side). Omitted when empty
    (a single-tenant/back-compat server maps an absent secret to its default team)."""
    req = urllib.request.Request(BASE + "/enroll", data=body, method="POST")
    req.add_header("Content-Type", "application/json")
    req.add_header("X-Heimdall-HAID", HAID)
    if token:
        req.add_header("X-Heimdall-Enroll-Token", token)
    team_secret = os.environ.get("PRES_TEAM_SECRET") or ""
    if team_secret:
        req.add_header("X-Heimdall-Team-Secret", team_secret)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            resp.read()
            return resp.status
    except urllib.error.HTTPError as exc:
        return exc.code
    except Exception:  # noqa: BLE001 — offline / DNS / TLS -> a failed enroll.
        return 0


def _persisted_seed():
    """The base64 seed from the per-(machine,repo) 0600 file, or '' if absent/unreadable.
    Read here so the seed material stays in this process + the file ONLY (never bash/argv)."""
    path = os.environ.get("PRES_SEED_FILE") or ""
    if not path or not os.path.exists(path):
        return ""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def _bootstrap_seed():
    """Auto-enroll once: keygen (cp_auth) -> POST /enroll -> persist the seed 0600 -> return
    it. Throttled by an mtime stamp so a FAILING enroll does NOT hammer the server every
    render. Silent + non-fatal: ANY failure returns '' (the caller degrades to offline). Runs
    at most once — a later render finds the persisted seed and skips this.

    TOKEN-OPTIONAL: bootstrap proceeds whenever there is a URL (always — a shipped default)
    and a place to persist the seed. The enroll token is sent ONLY IF configured, so an OPEN
    server (HEIMDALL_ENROLL_OPEN=1) auto-enrolls a dev with ZERO config; a token-mode server
    still works because a configured token is still sent."""
    token = os.environ.get("PRES_ENROLL_TOKEN") or ""
    seed_file = os.environ.get("PRES_SEED_FILE") or ""
    if not BASE or not seed_file:
        return ""   # no URL / nowhere to persist the seed -> stay offline.
    stamp = os.environ.get("PRES_ENROLL_STAMP") or ""
    throttle = float(os.environ.get("PRES_THROTTLE") or "180")
    now = time.time()
    # Back off if we attempted recently — a failed enroll must not retry every render.
    if stamp and os.path.exists(stamp):
        recent = False
        with contextlib.suppress(OSError):
            recent = (now - os.path.getmtime(stamp)) < throttle
        if recent:
            return ""
    try:
        os.makedirs(os.path.dirname(seed_file), mode=0o700, exist_ok=True)
    except OSError:
        return ""
    # Stamp the attempt BEFORE the network call so a crash/failure still throttles.
    if stamp:
        with contextlib.suppress(OSError), open(stamp, "w", encoding="utf-8") as fh:
            fh.write("%f" % now)
    try:
        priv_b64, pub_b64 = K.generate_keypair()  # REUSE — never hand-roll Ed25519.
    except Exception:  # noqa: BLE001 — crypto unavailable / keygen fault -> offline.
        return ""
    body = json.dumps({
        "haid": HAID,
        "pubkey": pub_b64,
        "handle": os.environ.get("PRES_HANDLE") or None,
    }).encode("utf-8")
    status = _enroll(body, token)
    if not 200 <= status < 300:
        # LOUD on a REFUSED *CONFIGURED* enroll, mute otherwise. A 4xx means a reachable
        # server ACTIVELY REFUSED this enroll — but that is only a CREDENTIAL error worth
        # surfacing when the dev actually configured a token (a wrong/expired/revoked
        # enroll_token). A wrong token must NOT look like success, so name it ONCE on
        # stderr (the throttle stamp keeps it to one line per window). Everything else
        # stays MUTE: a tokenless zero-config beat merely probing the shipped DEFAULT
        # endpoint (no token, no expressed intent) gets a 4xx as a matter of course —
        # that is the beat's silent-no-op contract, not a credential error — and a
        # transport failure (status 0 == offline/DNS/TLS) or a 5xx (transient server
        # fault) are never credential errors either.
        if token and 400 <= status < 500:
            sys.stderr.write(
                "heimdall enroll refused (%d): check the enroll token / endpoint\n"
                % status)
        return ""   # enroll refused/offline -> no seed (the stamp throttles the retry).
    # Persist the seed 0600 (created restrictively; never world/group-readable).
    try:
        fd = os.open(seed_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            os.write(fd, priv_b64.encode("ascii"))
        finally:
            os.close(fd)
        os.chmod(seed_file, 0o600)
    except OSError:
        return ""
    return priv_b64


def resolve_seed():
    """The signing seed: $HMD_PRESENCE_SEED (PRES_SEED — dev-scoped override) > the
    persisted 0600 seed > AUTO-BOOTSTRAP (keygen + enroll + persist). '' -> offline.
    NEVER the server's $HEIMDALL_CP_PKI_KEY (Secret-Manager identity, server-only)."""
    env_seed = os.environ.get("PRES_SEED") or ""
    if env_seed:
        return env_seed
    persisted = _persisted_seed()
    if persisted:
        return persisted
    return _bootstrap_seed()


def render_roster(rows):
    """Print the online team. --json -> the raw roster list; else one line per dev:
    <handle-or-haid>  <verdict>  <file>  (<age>s ago)."""
    if AS_JSON:
        sys.stdout.write(json.dumps(rows, indent=2, sort_keys=True) + "\n")
        return
    if not rows:
        sys.stdout.write("presence: no teammates online\n")
        return
    for r in rows:
        who = r.get("handle") or r.get("haid") or "?"
        verdict = r.get("verdict") or "-"
        where = r.get("file") or "-"
        age = r.get("age_seconds")
        age_s = ("%ss ago" % age) if age is not None else ""
        sys.stdout.write("%-24s  %-12s  %-28s  %s\n" % (who, verdict, where, age_s))


def main():
    # Resolve the signing seed IN-PROCESS (env > persisted 0600 > auto-bootstrap). When no
    # seed resolves (offline / enroll failed / throttled), degrade cleanly: an empty roster
    # / a no-op beat. The statusline must NEVER break on a virgin, unenrolled checkout.
    seed = resolve_seed()
    if not seed:
        if VERB == "roster":
            render_roster([])
        return 0
    if VERB == "beat":
        # nonce + ts ride INSIDE the signed body (the signature covers it) so the server's
        # replay-nonce gate can prove this is a LIVE, first-use beat — a captured beat cannot
        # be replayed (the nonce is single-use within the freshness window). Unforgeable
        # because signed; only replayable, which the gate catches.
        body = json.dumps({
            "project": os.environ.get("PRES_PROJECT") or "",
            "handle": os.environ.get("PRES_HANDLE") or None,
            "verdict": os.environ.get("PRES_VERDICT") or None,
            "file": os.environ.get("PRES_FILE") or None,
            "nonce": secrets.token_hex(16),
            "ts": int(time.time()),
        }).encode()
        status, _ = request("POST", "/presence", body, seed)
        # LOUD on a DROPPED/REFUSED beat — the exit-0-no-output that MASKED the invisible-beat bug
        # is gone. A beat that never lands (transport drop -> status 0, or a non-2xx server refusal)
        # is NAMED on stderr so a human running `heimdall-presence beat` sees the failure instead of
        # nothing. stdout stays CLEAN (the statusline reads stdout); the default exit stays 0 so the
        # statusline never breaks on a flaky beat. STRICT (--strict / HMD_PRESENCE_STRICT=1) makes it
        # exit NONZERO so tooling/tests can assert the failure surfaces.
        if not (200 <= status < 300):
            strict = bool(os.environ.get("PRES_STRICT"))
            reason = "unreachable (transport drop)" if status == 0 else ("HTTP %d" % status)
            sys.stderr.write("heimdall presence: beat NOT delivered — %s\n" % reason)
            return 1 if strict else 0
        return 0
    if VERB == "retire":
        # The opt-out prompt-disappearance path: POST /presence-retire so the server writes a
        # retirement tombstone and drops this dev from teammates' rosters on the NEXT read (no
        # 45s TTL wait). Signed with the dev's OWN seed (retire yourself only). Fire-and-forget
        # — if the seed/URL is offline the retire is a no-op and the TTL expiry is the fallback.
        body = json.dumps({
            "project": os.environ.get("PRES_PROJECT") or "",
            "nonce": secrets.token_hex(16),
            "ts": int(time.time()),
        }).encode()
        request("POST", "/presence-retire", body, seed)
        return 0
    if VERB == "roster":
        project = os.environ.get("PRES_PROJECT") or ""
        path = "/roster?" + urllib.parse.urlencode({"project": project})
        st, b = request("GET", path, b"", seed)
        rows = b.get("roster") if isinstance(b, dict) else None
        render_roster(rows if isinstance(rows, list) else [])
        return 0
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001 — never traceback; degrade to offline/empty.
        if AS_JSON:
            sys.stdout.write("[]\n")
        elif VERB == "roster":
            sys.stdout.write("presence: no teammates online\n")
        sys.exit(0)
PYEOF
}

# Best-effort ONE final signed retire beat (opt-out prompt-disappearance). Only attempts when
# the wire is resolvable (URL+HAID+PROJECT+signer present); otherwise the TTL expiry is the
# graceful fallback. Never fatal — an offline `off` still writes the local toggle.
_try_retire() {
  [ -n "$PY" ] || return 0
  [ -f "$LIB/cp_auth.py" ] || return 0
  [ -n "$URL" ] && [ -n "$HAID" ] && [ -n "$PROJECT" ] || return 0
  run_client retire >/dev/null 2>&1 || true
}

case "$SUB" in
  beat)
    # Effectively-on here (the OFF guard above already no-op'd an off beat). Honor the
    # --no-files sub-toggle: withhold the file field so the beat body sends file:null.
    _repo_nofiles && FILE=""
    run_client beat ;;
  roster) run_client roster ;;   # OFF = invisible, NOT blind: an opted-out dev still SEES the wall.
  retire) run_client retire ;;   # emit ONE signed retire beat (used by `off`; exposed for tooling).
  off)
    if [ -n "$GLOBAL" ]; then
      mkdir -p "$HMD_DIR" 2>/dev/null || true
      : > "$GLOBAL_OFF_FILE" 2>/dev/null || true
      printf 'presence: OFF globally (machine-wide kill switch) — %s\n' "$GLOBAL_OFF_FILE"
    else
      _write_pres_state '{"enabled": false}'
      printf 'presence: OFF for this repo — %s\n' "$PRES_STATE_FILE"
    fi
    # Retire NOW so you drop from teammates' walls promptly (no 45s TTL wait).
    _try_retire
    printf 'you can still SEE the team; the team can no longer see you. (hmd presence on to return)\n'
    ;;
  on)
    if [ -n "$GLOBAL" ]; then
      rm -f "$GLOBAL_OFF_FILE" 2>/dev/null || true
      printf 'presence: ON globally — %s removed\n' "$GLOBAL_OFF_FILE"
    fi
    if [ -n "$NOFILES" ]; then
      _write_pres_state '{"enabled": true, "files": false}'
      printf 'presence: ON for this repo, file detail WITHHELD (--no-files) — handle+verdict only\n'
    elif [ -z "$GLOBAL" ]; then
      _write_pres_state '{"enabled": true}'
      printf 'presence: ON for this repo — %s\n' "$PRES_STATE_FILE"
    fi
    ;;
  status)
    _global_pres_off && G="off" || G="on"
    _repo_pres_off   && R="off" || R="on"
    _repo_nofiles    && FILES="withheld (--no-files)" || FILES="shown"
    if _pres_off; then
      EFF="OFF"
      if _global_pres_off; then WHY="global kill switch is on"; else WHY="this repo is opted out"; fi
    else
      EFF="ON"; WHY="broadcasting handle + verdict$([ "$FILES" = shown ] && printf ' + current file')"
    fi
    printf 'presence status\n'
    printf '  repo:      %-4s (%s)\n' "$R" "$PRES_STATE_FILE"
    printf '  global:    %-4s (%s)\n' "$G" "$GLOBAL_OFF_FILE"
    printf '  effective: %s — %s\n' "$EFF" "$WHY"
    printf '  files:     %s\n' "$FILES"
    printf '  note: OFF = invisible, not blind — you can still SEE the team; the team cannot see you.\n'
    ;;
  ""|-h|--help|help)
    cat <<'USAGE'
heimdall-presence — server-synced team presence (with consent opt-out)

  heimdall-presence beat              send a heartbeat for this repo's project + identity
  heimdall-presence roster [--json]   print the online team for this repo's project
  heimdall-presence off               stop broadcasting from THIS repo (+ retire now)
  heimdall-presence on  [--no-files]  re-enable this repo (--no-files: withhold file detail)
  heimdall-presence off --global      machine-wide kill switch (~/.heimdall/presence-off)
  heimdall-presence on  --global      lift the machine-wide kill switch
  heimdall-presence status            print repo/global/effective state + what is broadcast
  heimdall-presence retire            emit one signed retire beat (drop off walls now)

CONSENT: OFF = zero beats (a stat-only no-op — a cron/hook can't leak around it) AND a retire
beat so you vanish from teammates' walls promptly, not after the TTL. OFF is invisible, NOT
blind: `roster` still shows the team. Broadcast is ONLY handle + verdict + current filename —
never file contents, never code. --no-files keeps you present but sends file:null.

ZERO-CONFIG: with ${HOME}/.heimdall/cp-endpoint.json shipped, the first beat/roster
auto-resolves the url, auto-generates+enrolls+persists a 0600 signing key, derives a
stable project id from the git remote, and reads the handle from heimdall-identity — the
dev exports NOTHING. Overrides still win:
  Overrides: --haid --project --url --handle --verdict --file --global --no-files
  Env: HMD_HAID HMD_PROJECT HMD_HANDLE HMD_VERDICT HMD_FILE HMD_ENROLL_THROTTLE
       HEIMDALL_PRESENCE_DIR (per-repo state dir override)
       HEIMDALL_CP_URL|BASE_URL  HMD_PRESENCE_SEED (dev key override; server's HEIMDALL_CP_PKI_KEY is NOT read)
Offline/unconfigured degrades cleanly (empty roster, no-op beat, exit 0).
USAGE
    ;;
  *) echo "heimdall-presence: unknown subcommand '$SUB' (try: beat | roster | on | off | status | retire)" >&2; exit 2 ;;
esac
