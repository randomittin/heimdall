#!/usr/bin/env bash
# heimdall-read-dedup -- stub a Read that returns what the same agent already holds in context, and answer a subagent's unsliced Read of a
# big source file with its head and outline: the PostToolUse hook (`post-read`) and `clear --session ID` (the PreCompact hook runs it).
# Why, the payload fields, the rules, the state and its bounds: the header of bin/lib/hmd_read_dedup.py, which holds the behaviour. This
# file is only the launcher.
#
# SWITCHES, read in the environment Claude Code runs in. The STUB is opt-in: HMD_READ_DEDUP=on (also 1, true, yes). The OUTLINE is on
# unless HMD_READ_OUTLINE=off (also 0, false, no). With the outline off and the stub not on, `post-read` exits 0 at once: no interpreter,
# nothing recorded. `clear` is never switched off: forgetting reads is always safe, and a compaction that happened while the hook was off
# must not leave state behind for when it is on again. The whole hook can also be switched off by id: `hmd guardrails off read-dedup`.
SELF="${BASH_SOURCE[0]}"
while [ -h "$SELF" ]; do
  _dir="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$_dir/$SELF" ;; esac
done
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"

if [ "${1:-}" = post-read ]; then
  # Conservative: exit here only when the outline is off AND the stub is certainly not on; any other spelling goes on to the module.
  case "${HMD_READ_OUTLINE:-}" in
    off | OFF | Off | 0 | false | no)
      case "${HMD_READ_DEDUP:-}" in '' | off | OFF | Off | 0 | false | no) exit 0 ;; esac ;;
  esac
fi

# The interpreter the way bin/heimdall-ctx-meter resolves it (bin/lib/hmd-python.sh: a version-manager shim costs ~145 ms a call).
PY=""
if [ -r "$BIN_DIR/lib/hmd-python.sh" ]; then
  . "$BIN_DIR/lib/hmd-python.sh" 2>/dev/null
  if type hmd_python >/dev/null 2>&1; then PY="$(hmd_python 2>/dev/null || true)"; fi
fi
[ -n "$PY" ] || PY="$(command -v python3 2>/dev/null || true)"
if [ -z "$PY" ]; then
  # A hook never breaks a session: with no interpreter the verbs end here, quietly, and the original output stands.
  case "${1:-}" in post-read | clear) exit 0 ;; esac
  echo "heimdall-read-dedup: python3 not found" >&2
  exit 1
fi
exec "$PY" -I -S "$BIN_DIR/lib/hmd_read_dedup.py" "$@"
