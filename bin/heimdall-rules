#!/usr/bin/env bash
# heimdall-rules — V7: cluster the corpus DENIES, draft candidate rules, stage
# them for HUMAN REVIEW.
#
# WHAT THIS IS. evals/corpus/SCHEMA.md §4 states the contract this implements:
#
#     "Rule distillation — 3+ cases sharing a root pattern graduate into a
#      convention / stack-pack rule. Cases catch; rules prevent."
#
# This tool automates the FIRST half of that sentence and NONE of the second.
# It reads the corpus's own pinned verdicts, clusters the denies by shared root
# pattern, and DRAFTS 1-3 candidates with the evidence attached. It does not
# promote, install, or apply anything. Promotion is a human decision, every
# time. Heimdall's public claims say triage is captured/shared — never that it
# auto-synthesizes rules — and this tool is the one most likely to blur that
# line, so its output is labelled a PROPOSAL AWAITING REVIEW on every surface.
#
# WHAT IT NEVER DOES:
#   - never writes outside its staging path (default .planning/rule-proposals/)
#   - never modifies evals/corpus/, INDEX.json, or any convention file
#   - never submits anything to any external service — proposals are local files
#
# THE READ SEAM. The corpus's pinned `expected.json` IS the verdict truth
# (SCHEMA.md §1: the pinpoint is captured by replaying the case through the
# gate, never hand-written). This tool is a pure READER over that seam, exactly
# as bin/corpus is a pure SCORER over it — it replays no gate and owns no diff
# logic. Run `bin/corpus run` for the catch-rate; run this for the rules.
#
# WHAT COUNTS AS A DENY. A case whose pinned verdict is a REFUSAL:
#   status "fail"  — the gate caught a defect.
#   status "error" — the gate refused to grade an ungradable input (R-6).
# A status "pass" case is NOT a deny: it is a known-good false-RED guard, which
# the gate lets through by design. Those are retained as the FALSE-POSITIVE
# CONTROL SET, because the whole point of a control is to bound FP risk.
#
# HOW A CANDIDATE IS DERIVED (all four steps are computed from case data —
# nothing here is a fixed template):
#   1. CLUSTER   group denies by (gate, shared invariant tag); a group needs
#                >= --min-support members (default 3, per SCHEMA.md §4) to
#                graduate. Groups over identical member sets are merged and
#                their tags unioned. Everything below threshold is reported in
#                `rejected_clusters` — a near-miss is never silently dropped.
#   2. FIELDS    parse each member's pinned first_divergence into a field map
#                and compute, per case, which fields actually diverged. Two
#                on-disk shapes exist and both are handled: a JSON-encoded
#                object (exchange-lob) and a KEY:VAL register dump
#                (emulator-gb).
#   3. DISCRIMINATOR  find the SMALLEST set of fields that "covers" every
#                member (diverges in at least one field per case) — an exact
#                minimal hitting set searched at size 1, then 2, then 3. That
#                set is what the proposed rule tells you to assert.
#   4. BLIND SPOT  the complement (union of divergent fields minus the
#                discriminator) is the naive assertion a developer writes
#                instead. Report exactly which member cases it is byte-GREEN
#                on. That is the "what it would catch that is currently
#                missed", measured — not asserted.
#
# FALSE-POSITIVE HONESTY. A rule that fires on legitimate code gets the whole
# gate muted, so FP risk is never reported as a vibe. It is bounded against the
# known-good control cases the corpus actually holds for that gate, and when
# there are none, the level is UNVERIFIED and says so.
#
# PRIVACY GUARD (DATA.md §7 k-anonymity + IDENTITY.md). A case may carry:
#   "attribution": { "team_name": "...", "team_id_hash": "...",
#                    "consent": { "granted": true, "version": "t0-2026-07" } }
# Rules applied to every candidate, in this order:
#   - A raw team_id_hash is NEVER printed. It is a join key, not display copy.
#   - A named credit ships ONLY with recorded consent (consent.granted == true
#     AND a non-empty consent.version). That is the "credited to a single
#     identifiable team requires recorded consent" rule.
#   - Without consent, a team-derived aggregate is published only when it is
#     k-anonymous with k >= 5 DISTINCT teams (DATA.md §7). Below k, the detail
#     is dropped, not coarsened into something re-identifiable.
#   - Every suppression is STATED in the report. A reviewer must be able to see
#     that attribution was withheld and why; a silent drop is indistinguishable
#     from "nobody contributed".
#   When in doubt, the detail is dropped.
#
# Usage:
#   heimdall-rules propose [options]
#     --corpus DIR       corpus dir (default: <plugin>/evals/corpus)
#     --out PATH         staged proposal path (default:
#                        <repo>/.planning/rule-proposals/<period>.md)
#     --period LABEL     period label for the report (default: current ISO week)
#     --min-support N    members required to graduate a cluster (default 3)
#     --json             emit the structured result on stdout instead of markdown
#   heimdall-rules -h | --help
#
# EXIT: 0 = the run succeeded, INCLUDING when it proposes nothing (an honest
#       "no candidate rules this period" is a correct result, not a failure).
#       2 = IO / usage error.
set -euo pipefail

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$BIN_DIR/.." && pwd)"

command -v jq >/dev/null 2>&1 || { echo "error: jq is required" >&2; exit 2; }

usage() { sed -n '2,110p' "$SELF" | sed 's/^# \{0,1\}//'; }

CMD="${1:-propose}"
case "$CMD" in
  propose) shift || true ;;
  -h|--help) usage; exit 0 ;;
  *) echo "error: unknown command: $CMD" >&2; usage >&2; exit 2 ;;
esac

CORPUS_DIR="${CORPUS_DIR:-$PLUGIN_DIR/evals/corpus}"
OUT=""
PERIOD=""
MIN_SUPPORT=3
AS_JSON=0

while [ $# -gt 0 ]; do
  case "$1" in
    --corpus)      CORPUS_DIR="${2:-}"; shift 2 ;;
    --out)         OUT="${2:-}"; shift 2 ;;
    --period)      PERIOD="${2:-}"; shift 2 ;;
    --min-support) MIN_SUPPORT="${2:-}"; shift 2 ;;
    --json)        AS_JSON=1; shift ;;
    -h|--help)     usage; exit 0 ;;
    *) echo "error: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

case "$MIN_SUPPORT" in
  ''|*[!0-9]*) echo "error: --min-support must be a non-negative integer" >&2; exit 2 ;;
esac

INDEX="$CORPUS_DIR/INDEX.json"
[ -f "$INDEX" ] || { echo "error: corpus index missing: $INDEX" >&2; exit 2; }

# Period label. Default to the current ISO week (the "week's denies" framing).
# %G/%V are ISO year/week; fall back to a plain date if the platform lacks them.
if [ -z "$PERIOD" ]; then
  PERIOD="$(date +%G-W%V 2>/dev/null || true)"
  case "$PERIOD" in ''|*%*) PERIOD="$(date +%Y-%m-%d)" ;; esac
fi

if [ -z "$OUT" ]; then
  OUT="$PLUGIN_DIR/.planning/rule-proposals/${PERIOD}.md"
fi

CORPUS_VERSION="$(jq -r '.version // "unknown"' "$INDEX" 2>/dev/null || echo unknown)"

# Report the corpus as a repo-relative path when it lives inside the plugin, so
# a staged proposal is portable and diffable instead of pinning one machine's
# absolute checkout path (mirrors bin/corpus's `${INDEX#"$PLUGIN_DIR"/}`).
CORPUS_LABEL="${CORPUS_DIR#"$PLUGIN_DIR"/}"

# ── Assemble one record per case: the descriptor + the pinned verdict. ────────
# Missing/unreadable case files are SKIPPED and counted, never invented.
CASES_JSON="$(mktemp)"; RESULT_JSON="$(mktemp)"
trap 'rm -f "$CASES_JSON" "$RESULT_JSON"' EXIT

SKIPPED=0
{
  while IFS= read -r cid; do
    [ -n "$cid" ] || continue
    cj="$CORPUS_DIR/$cid/case.json"
    ej="$CORPUS_DIR/$cid/expected.json"
    if [ ! -f "$cj" ] || [ ! -f "$ej" ]; then
      SKIPPED=$((SKIPPED+1)); continue
    fi
    jq -n --arg id "$cid" --slurpfile c "$cj" --slurpfile e "$ej" '
      ($c[0] // {}) as $case | ($e[0] // {}) as $exp |
      { case_id:      $id,
        source:       ($case.source // "unknown"),
        difficulty:   ($case.difficulty // "unknown"),
        defect:       ($case.defect // ""),
        invariants:   ($case.invariants // []),
        gate:         ($exp.gate // ($case.gates_under_test // [])[0] // "unknown"),
        status:       ($exp.status // "fail"),
        summary:      ($exp.first_divergence_summary // ""),
        divergence:   ($exp.first_divergence // null),
        attribution:  ($case.attribution // null) }' 2>/dev/null || true
  done <<< "$(jq -r '.cases[]?.id // empty' "$INDEX" 2>/dev/null)"
} | jq -s '.' > "$CASES_JSON"

# ═══════════════════════════════════════════════════════════════════════════
#  The analysis. One jq program over the case array -> the structured result.
#  JSON is the single source of truth here; the markdown below is a pure
#  projection of it, so the two can never disagree.
# ═══════════════════════════════════════════════════════════════════════════
jq -n \
  --slurpfile cases "$CASES_JSON" \
  --argjson min_support "$MIN_SUPPORT" \
  --arg period "$PERIOD" \
  --arg corpus_dir "$CORPUS_LABEL" \
  --arg corpus_version "$CORPUS_VERSION" \
  --argjson skipped "$SKIPPED" '
  ($cases[0] // []) as $all |

  # ── Parse one side of a pinned divergence into a field -> value map. ──
  # Two real on-disk shapes, both present in the corpus today:
  #   exchange-lob  a JSON-encoded object string: {"makerId":1,"price":99,...}
  #   emulator-gb   a KEY:VAL register dump:      A:01 F:20 ... PCMEM:18,02
  # Anything else parses to {} and simply contributes no fields.
  def parse_side($s):
    if ($s | type) != "string" then {}
    else
      (try ($s | fromjson) catch null) as $j
      | if ($j | type) == "object" then $j
        else
          [ $s | split(" ")[] | select(length > 0)
            | (index(":")) as $i
            | if $i == null then empty else {key: .[0:$i], value: .[$i+1:]} end ]
          | from_entries
        end
    end;

  # Fields that actually differ between the pinned expected and actual sides.
  # tostring normalises 1 vs "1" so a JSON/text shape difference is not read as
  # a defect; a key present on one side only is a genuine divergence.
  def divergent($fd):
    if $fd == null then []
    else
      parse_side($fd.expected // "") as $e
      | parse_side($fd.actual // "") as $a
      | [ (($e | keys) + ($a | keys)) | unique[]
          | select(($e[.] | tostring) != ($a[.] | tostring)) ]
    end;

  def intersect_all($arrays):
    if ($arrays | length) == 0 then []
    else reduce $arrays[1:][] as $x ($arrays[0];
           [ .[] | select(. as $f | $x | index($f) != null) ])
    end;

  # All k-sized combinations of $arr (exact, not greedy — the discriminator is
  # a MINIMAL hitting set, and an approximation would overstate the rule).
  def combos($arr; $k):
    if $k == 0 then [[]]
    elif ($arr | length) < $k then []
    else ((combos($arr[1:]; $k - 1)) | map([$arr[0]] + .)) + combos($arr[1:]; $k)
    end;

  # A field set COVERS a case when at least one of its fields diverged there.
  def covers($set; $divsets):
    ($divsets | length) > 0 and
    all($divsets[]; . as $d | any($set[]; . as $f | $d | index($f) != null));

  # ALL minimal covering sets, searched at size 1 then 2 then 3 and stopping at
  # the first size that yields any. Returning every tie rather than one winner
  # is deliberate: several field sets are often equally minimal (on the seeded
  # corpus both {makerId,qty} and {makerId,takerId} cover the ordering cluster),
  # and silently picking one would present an arbitrary choice as THE answer.
  # The reviewer picks; the tool shows the options. Sorted for reproducibility —
  # the same corpus must always draft the same proposal.
  def minimal_covers($fields; $divsets):
    if ($divsets | length) == 0 then []
    else
      ( [ 1, 2, 3 ]
        | map(. as $k | combos($fields; $k) | map(select(covers(.; $divsets)) | sort))
        | map(select(length > 0)) | first ) as $found
      | if $found == null then [] else ($found | unique | sort) end
    end;

  # ── Partition: denies (refusals) vs known-good controls. ──
  [ $all[] | select(.status == "fail" or .status == "error") ] as $denies |
  [ $all[] | select(.status == "pass") ]                        as $controls |

  # ── 1. CLUSTER by (gate, shared invariant tag). ──
  ( [ $denies[] | . as $c | (.invariants[]? | {gate: $c.gate, tag: ., case_id: $c.case_id}) ]
    | group_by([.gate, .tag])
    | map({gate: .[0].gate, tag: .[0].tag, members: (map(.case_id) | unique | sort)})
  ) as $groups |

  # Merge groups sharing an identical member set (D3 and I4 over the same three
  # cases are ONE root pattern seen through two tags, not two candidates).
  ( [ $groups[] | select((.members | length) >= $min_support) ]
    | group_by([.gate, .members])
    | map({gate: .[0].gate, tags: (map(.tag) | unique | sort), members: .[0].members})
  ) as $graduated |

  ( [ $groups[] | select((.members | length) < $min_support)
      | {gate, tags: [.tag], support: (.members | length), members,
         reason: "support \(.members | length) < min_support \($min_support)"} ]
  ) as $rejected |

  # ── Build one candidate per graduated cluster. ──
  ( $graduated | to_entries | map(
      .key as $i | .value as $cl
      | [ $all[] | select(.case_id as $id | $cl.members | index($id)) ] as $members
      | [ $members[] | select(.divergence != null) ]                   as $pinned
      | ($pinned | map(divergent(.divergence)))                        as $divsets
      | ([ $divsets[] | .[] ] | unique | sort)                         as $union_fields
      | (if ($divsets | length) > 0 then intersect_all($divsets) | sort else [] end) as $always
      | minimal_covers($union_fields; $divsets)                        as $covers
      | (if ($covers | length) == 0 then null else $covers[0] end)     as $disc
      | (if ($covers | length) <= 1 then [] else $covers[1:] end)      as $alt_covers
      | (if $disc == null then [] else ($union_fields - $disc) end)    as $blind
      | ( if ($disc == null or ($blind | length) == 0) then []
          else [ $pinned[] | . as $m
                 | select([ $blind[] | select(. as $f | divergent($m.divergence) | index($f) != null) ] | length == 0)
                 | .case_id ]
          end )                                                        as $blind_missed
      # Per-single-field blind spots: which members an f-only assertion misses.
      | ( [ $union_fields[] | . as $f
            | { field: $f,
                missed_case_ids: [ $pinned[] | select(divergent(.divergence) | index($f) == null) | .case_id ] }
            | select((.missed_case_ids | length) > 0) ] )              as $field_blind
      | [ $controls[] | select(.gate == $cl.gate) | .case_id ]         as $control_ids

      # ── PRIVACY (DATA.md §7). Consent first, then k-anonymity, then drop. ──
      | [ $members[] | .attribution | select(. != null) ]              as $attrs
      | ([ $attrs[] | .team_id_hash // empty ] | unique)               as $team_keys
      | ($team_keys | length)                                          as $n_teams
      | [ $attrs[] | select((.consent.granted == true)
                            and ((.consent.version // "") != ""))
          | {team_name: (.team_name // ""), version: .consent.version}
          | select(.team_name != "") ]                                 as $consented
      | ( if ($attrs | length) == 0 then
            { published: false, mode: "none",
              detail: "no attribution recorded on any motivating case",
              teams: [], consent_version: null }
          elif ($consented | length) > 0 then
            { published: true, mode: "consented",
              detail: "credited with recorded consent",
              teams: ($consented | map(.team_name) | unique | sort),
              consent_version: ($consented[0].version) }
          elif $n_teams >= 5 then
            { published: true, mode: "k-anonymous-aggregate",
              detail: "\($n_teams) distinct teams (k-anonymous, k >= 5); names withheld — the aggregate is published, the identities are not",
              teams: [], consent_version: null }
          else
            { published: false, mode: "suppressed-sub-k",
              detail: "attribution WITHHELD — \($n_teams) distinct team(s) is sub-k (below the k >= 5 k-anonymity threshold of DATA.md §7) and no recorded consent was found; detail dropped rather than anonymised into something re-identifiable",
              teams: [], consent_version: null }
          end )                                                        as $attribution

      | { id: "CAND-\($i + 1)",
          status: "proposal",
          promoted: false,
          gate: $cl.gate,
          root_pattern: { invariant_tags: $cl.tags, support: ($cl.members | length) },
          rule: (
            if $disc == null then
              "Any change to `\($cl.gate)` behaviour under \($cl.tags | join("+")) must ship a differential check against a reference replay; the \($cl.members | length) motivating denies pin no comparable field, so the assertion surface needs a human to name it."
            else
              "Any change to `\($cl.gate)` behaviour under \($cl.tags | join("+")) must assert **\($disc | join(", "))** against the reference replay — not just \($blind | join(", ") | if . == "" then "the remaining fields" else . end). All \($cl.members | length) denies in this cluster diverge on \($disc | join("/"))."
            end ),
          discriminator: $disc,
          discriminator_alternatives: $alt_covers,
          divergent_fields: { union: $union_fields, in_every_member: $always },
          currently_missed: {
            naive_assertion: $blind,
            false_green_on: $blind_missed,
            note: (
              if $disc == null then "no field-level analysis available for this cluster"
              elif ($blind_missed | length) > 0 then
                "An assertion over \($blind | join(", ")) alone is byte-GREEN on \($blind_missed | length) of these \($pinned | length) pinned denies (\($blind_missed | join(", "))). Asserting \($disc | join(", ")) catches all \($pinned | length)."
              else
                "Every naive subset tested still catches all \($pinned | length) pinned denies; the discriminator sharpens the pinpoint rather than closing a hole."
              end ),
            per_field_blind_spots: $field_blind },
          false_positive_risk: {
            level: (if ($control_ids | length) == 0 then "UNVERIFIED"
                    elif ($control_ids | length) < 3 then "low-bounded (thin control set)"
                    else "low-bounded" end),
            control_cases: $control_ids,
            note: (
              (if ($control_ids | length) == 0 then
                 "This gate ships NO known-good (expected-pass) case, so nothing in the corpus can show this rule staying green on correct code. FP risk is UNMEASURED."
               else
                 "Bounded against \($control_ids | length) known-good control case(s) (\($control_ids | join(", "))): a known-good case diverges on no field, so adding field assertions cannot turn it red."
               end)
              + " A rule that fires on legitimate code gets the whole gate muted — the corpus bounds FP risk only over the cases it holds, so a human must review this discriminator against real code before promotion." ) },
          attribution: $attribution,
          evidence: [ $members[] | {case_id, source, difficulty, status,
                                    invariants, defect, summary,
                                    divergent_fields: divergent(.divergence)} ] } )
  ) as $candidates |

  { tool: "heimdall-rules",
    version: "1",
    status: "proposal",
    promoted: false,
    review: "human",
    period: $period,
    generated_from: { corpus_dir: $corpus_dir, corpus_version: $corpus_version,
                      cases_total: ($all | length), cases_skipped: $skipped,
                      denies: ($denies | length), known_good_controls: ($controls | length) },
    min_support: $min_support,
    candidate_count: ($candidates | length),
    candidates: $candidates,
    rejected_clusters: $rejected }
' > "$RESULT_JSON"

# ═══════════════════════════════════════════════════════════════════════════
#  Render the staged markdown proposal — a pure projection of the JSON above.
# ═══════════════════════════════════════════════════════════════════════════
OUT_DIR="$(dirname "$OUT")"
mkdir -p "$OUT_DIR" 2>/dev/null || { echo "error: cannot create $OUT_DIR" >&2; exit 2; }

jq -r '
  def bullets($a): if ($a | length) == 0 then "_none_" else ($a | map("`\(.)`") | join(", ")) end;

  [ "# Rule Proposals — PROPOSAL AWAITING REVIEW",
    "",
    "**STATUS: PROPOSAL. NOT PROMOTED.** Nothing here is in force. This file is a",
    "draft for human review: RJ reads it, approves or rejects each candidate, and",
    "promotion happens by hand. Heimdall clusters denies and drafts candidates — it",
    "does not decide what becomes a rule.",
    "",
    "| | |",
    "| --- | --- |",
    "| Period | \(.period) |",
    "| Corpus | `\(.generated_from.corpus_dir)` (version \(.generated_from.corpus_version)) |",
    "| Cases read | \(.generated_from.cases_total) (\(.generated_from.cases_skipped) skipped) |",
    "| Denies clustered | \(.generated_from.denies) |",
    "| Known-good controls | \(.generated_from.known_good_controls) |",
    "| Min support to graduate | \(.min_support) (SCHEMA.md §4: \"3+ cases sharing a root pattern\") |",
    "| Candidates | \(.candidate_count) |",
    "" ]
  + (if .candidate_count == 0 then
      [ "## No candidate rules this period",
        "",
        "The denies in this period share no root pattern with at least \(.min_support) members,",
        "so there is nothing worth proposing. This is a real result, not a failure:",
        "a proposal engine that always proposes something is noise, and noise trains",
        "a reviewer to ignore it.",
        "" ]
      + (if (.rejected_clusters | length) > 0 then
          [ "### Near misses (reported so nothing vanishes silently)", "",
            "| Gate | Tag(s) | Support | Why it did not graduate |",
            "| --- | --- | ---: | --- |" ]
          + (.rejected_clusters | sort_by(-.support) | map(
              "| `\(.gate)` | \(.tags | join(", ")) | \(.support) | \(.reason) |"))
          + [ "" ]
        else [] end)
    else
      (.candidates | map(
        [ "---", "",
          "## \(.id) — PROPOSAL (awaiting review)", "",
          "**Proposed rule.** \(.rule)", "",
          "- **Gate:** `\(.gate)`",
          "- **Root pattern:** \(.root_pattern.invariant_tags | join(" + ")) — \(.root_pattern.support) denies",
          "- **Assert these fields:** \(bullets(.discriminator // []))",
          "- **Fields diverging in every member:** \(bullets(.divergent_fields.in_every_member))" ]
        + (if (.discriminator_alternatives | length) > 0 then
            [ "- **Equally minimal alternatives:** \(.discriminator_alternatives | map("{" + join(", ") + "}") | join(" · ")) — the tool does not break this tie; pick the set that reads best against real code." ]
          else [] end)
        + [ "",
          "### Evidence trail",
          "",
          "The denies that motivated this. Check the reasoning — do not trust it.",
          "",
          "| Case id | Status | Difficulty | Fields that diverged | Pinned divergence |",
          "| --- | --- | --- | --- | --- |" ]
        + (.evidence | map(
            "| `\(.case_id)` | \(.status) | \(.difficulty) | \(if (.divergent_fields | length) == 0 then "_none pinned_" else (.divergent_fields | join(", ")) end) | \(.summary | gsub("\\|"; "\\\\|")) |"))
        + [ "",
            "### What this would catch that is currently missed",
            "",
            "\(.currently_missed.note)",
            "" ]
        + (if (.currently_missed.false_green_on | length) > 0 then
            [ "False-green under the naive assertion: \(bullets(.currently_missed.false_green_on))", "" ]
          else [] end)
        + (if (.currently_missed.per_field_blind_spots | length) > 0 then
            [ "Per-field blind spots (a check on that field alone is green on these denies):", "",
              "| Field asserted alone | Blind to |", "| --- | --- |" ]
            + (.currently_missed.per_field_blind_spots | map(
                "| `\(.field)` | \(.missed_case_ids | join(", ")) |"))
            + [ "" ]
          else [] end)
        + [ "### False-positive risk — **\(.false_positive_risk.level)**",
            "",
            "\(.false_positive_risk.note)",
            "",
            "Control cases: \(bullets(.false_positive_risk.control_cases))",
            "",
            "### Attribution",
            "",
            (if .attribution.published and (.attribution.teams | length) > 0 then
               "Credit: \(.attribution.teams | join(", ")) — \(.attribution.detail) (consent version `\(.attribution.consent_version)`)."
             elif .attribution.published then
               "\(.attribution.detail)"
             else
               "\(.attribution.detail)"
             end),
            "",
            "_Privacy guard applied: DATA.md §7 k-anonymity (k >= 5) plus the recorded-consent",
            "rule for any single identifiable team. Raw `team_id_hash` values are join keys and",
            "are never printed. When in doubt the detail is dropped._",
            "",
            "### Review decision",
            "",
            "- [ ] Approve — promote by hand, with the attribution line above",
            "- [ ] Revise — the discriminator or FP note needs work",
            "- [ ] Reject — record why, so the cluster is not re-proposed blindly",
            "" ]
      ) | add)
      + (if (.rejected_clusters | length) > 0 then
          [ "---", "",
            "## Near misses (below min support)", "",
            "| Gate | Tag(s) | Support | Why it did not graduate |",
            "| --- | --- | ---: | --- |" ]
          + (.rejected_clusters | sort_by(-.support) | map(
              "| `\(.gate)` | \(.tags | join(", ")) | \(.support) | \(.reason) |"))
          + [ "" ]
        else [] end)
    end)
  + [ "---", "",
      "_Generated by `heimdall-rules propose` from the corpus'"'"'s own pinned verdicts._",
      "_Staged locally. Nothing was submitted anywhere. Nothing was promoted._" ]
  | join("\n")
' "$RESULT_JSON" > "$OUT"

if [ "$AS_JSON" -eq 1 ]; then
  cat "$RESULT_JSON"
else
  cat "$OUT"
  echo
  echo "staged: $OUT"
fi

exit 0
