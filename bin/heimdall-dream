#!/usr/bin/env python3
# heimdall-dream — the OVERNIGHT autoresearch + maintainer sweep that surfaces a
# MORNING REPORT (a "dream journal"). RJ's mental model: "/sleep" — but there is no
# /sleep command; /dream is the canonical overnight wrapper. On-demand or scheduled.
#
# WHAT IT DOES (shadow-first — surface, don't auto-apply risky changes overnight):
#   1. autoresearch/self-improve loop (bin/heimdall-self-improve) — FORM hypotheses
#      from real metrics + queue evidence, and TEST them via the keep-or-rollback
#      gate: EVALUATE every open experiment (KEEP only a measured delta over baseline,
#      else ROLL BACK). Optionally START one bounded, reversible experiment.
#   2. maintainer sweep (seeker) — RAISE issues found from the evidence (recurring
#      dead-reason clusters + the live issue queue) WITH proposed FIXES, as candidates.
#   3. COLLECT improvements — the self-improve KEEPS (measured, validated wins).
#   4. WRITE a morning report to .planning/dream/YYYY-MM-DD.md with three sections:
#        (1) suggested changes   (2) issues raised & their fixes   (3) improvements kept.
#
# INVARIANTS (do not weaken):
#   • shadow-first — routing suggestions are SURFACED for review, not auto-applied.
#     Only the self-improve keep-gate (safe, measured, reversible) may persist a change.
#   • agent-never-pushes — this bin runs NO `git push`, NO `gh pr`, NO merge. Ever.
#     It writes a local report; a human reviews and applies in the morning.
#   • real, not fabricated — every line of the report is sourced from actual
#     self-improve output + real queue state. With NO evidence it says so honestly.
#
# The self-improve keep-gate is REUSED verbatim by shelling out to the sibling
# bin/heimdall-self-improve — this bin adds NO new keep/rollback logic of its own.
#
# Usage:
#   heimdall-dream run   [--repo DIR] [--date YYYY-MM-DD] [--min-samples N]
#                        [--min-delta F] [--out FILE] [--mode overnight|on-demand]
#                        [--start-experiment] [--json]
#   heimdall-dream where [--repo DIR] [--date YYYY-MM-DD]   # print the report path
#   -h | --help
#
# Exit status: 0 ok (incl. an honest empty report) · 2 usage · 3 runtime.

import argparse
import json
import os
import subprocess
import sys
import time

BIN_DIR = os.path.dirname(os.path.realpath(__file__))
SELF_IMPROVE = os.path.join(BIN_DIR, "heimdall-self-improve")
ISSUE_LOOP = os.path.join(BIN_DIR, "heimdall-issue-loop")

# ── the relocated state root (what makes an unattended 03:00 run possible at all) ──
#
# macOS TCC denies a LaunchAgent every read under ~/Downloads, ~/Documents and ~/Desktop,
# and it denies the JOB rather than the program — measured in 245ede5, a probe agent
# living outside the protected tree was refused the repo exactly as a repo-resident script
# was. So dream keeps its state under $HEIMDALL_HOME, which is not gated and is measured
# writable from launchd, and the nightly run then touches nothing under the repo.
#
# The import is GUARDED and the fallback is the old repo-relative behaviour. dream must
# still run on a checkout whose bin/lib was not staged alongside it; degrading to the
# path that has always worked is strictly better than refusing to run.
sys.path.insert(0, os.path.join(BIN_DIR, "lib"))
try:
    import dream_data as _dd
except ImportError:
    _dd = None

# ── THE SAMPLE-SIZE FLOOR (not negotiable by a flag) ──────────────────────────
#
# Heimdall's comparable scalar is a PROPORTION (first-try acceptance pass-rate),
# not a low-variance continuous scalar. autoresearch compares val_bpb, where a
# single 5-minute run is a usable measurement; a pass-rate over a handful of
# tasks is mostly noise. So the sample discipline has to be OURS, and it has to
# be quantified rather than asserted.
#
# The question that sets the floor: if a routing variant is TRULY NO BETTER than
# baseline, how often does it still clear `delta >= min_delta` by luck alone?
# That is the false-KEEP rate — the rate at which this loop "learns" something
# untrue. Worst case over baseline pass-rates, exact binomial:
#
#     n=3   min_delta=0.10  ->  72.9%      <- the shipped default. A coin flip.
#     n=10  min_delta=0.10  ->  38.3%
#     n=20  min_delta=0.10  ->  25.2%
#     n=20  min_delta=0.15  ->  13.2%      <- the floor enforced here
#     n=30  min_delta=0.15  ->   7.1%
#     n=20  min_delta=0.20  ->   5.8%
#
# At the previously shipped n=3, a change that is genuinely worthless is KEPT
# nearly three times in four. That is not a falsifier, it is a rubber stamp, and
# it would have been the FIRST thing to produce a confident-sounding but false
# "Heimdall improved itself overnight" line the moment task records existed.
#
# 20 is chosen as the smallest floor that (a) puts the worst-case false-keep rate
# into the teens when paired with min_delta 0.15, and (b) is still REACHABLE — a
# common task_type accumulates ~20 observations in a couple of maintainer cycles,
# so the loop converges in days, not months. Pushing to n=30 buys ~6 points of
# error rate at the cost of roughly doubling time-to-first-verdict; that trade is
# not worth it while a wrong KEEP is cheap, reversible, and re-evaluated on the
# very next /dream.
#
# The floor is a FLOOR: --min-samples may raise it, never lower it. An operator
# who could argue it down would eventually argue it down to 3 on the night the
# data looked exciting, which is exactly the failure mode it exists to prevent.
MIN_SAMPLES_FLOOR = 20
DEF_MIN_DELTA = 0.15


def _now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _today():
    return time.strftime("%Y-%m-%d", time.gmtime())


def _die(msg, code=3):
    sys.stderr.write("error: %s\n" % msg)
    raise SystemExit(code)


def _state_dir(repo):
    """Where the self-improve loop reads and writes its four state files. The relocated
    root when it can be had, else the repo's own .planning — see _dd.resolve_planning."""
    if _dd is None:
        return os.path.join(repo, ".planning")
    try:
        return _dd.resolve_planning(repo)
    except OSError:
        return os.path.join(repo, ".planning")


def _usable_dir(path):
    """Can this directory be written RIGHT NOW? Asked of the OS rather than inferred from
    mode bits, because a TCC denial is invisible to the bits."""
    if _dd is not None:
        return _dd.writable_dir(path)
    return os.path.isdir(path) and os.access(path, os.W_OK | os.X_OK)


def _relocated_report_dir(repo):
    """The relocated report directory, or None when there is no relocated root to use."""
    if _dd is None:
        return None
    try:
        return os.path.join(_dd.planning_dir(repo), "dream")
    except OSError:
        return None


def _report_dirs(repo):
    """Every directory this run should drop the morning report into, MOST HUMAN-VISIBLE
    FIRST. The head of the list is what `where` prints and what the run reports as its
    path; the tail is written too, best-effort.

    THE REPO COPY IS NOT OPTIONAL WHEN IT IS REACHABLE. The report is the artifact a human
    reads and git tracks, and .planning/dream is where the existing ones already live. An
    interactive run must keep landing there, or this "fix" would quietly relocate the one
    output the owner actually looks at. The relocated copy is what the 03:00 job can write
    when the repo is denied — so a normal terminal run writes BOTH, and the nightly run
    writes only the one it can reach."""
    dirs = []
    repo_dir = os.path.join(repo, ".planning", "dream")
    if _usable_dir(os.path.dirname(repo_dir)) or _usable_dir(repo):
        dirs.append(repo_dir)
    relocated = _relocated_report_dir(repo)
    if relocated and relocated not in dirs:
        dirs.append(relocated)
    if not dirs:
        dirs.append(repo_dir)
    return dirs


def _report_path(repo, date, out):
    if out:
        return out
    return os.path.join(_report_dirs(repo)[0], "%s.md" % date)


def _write_report(repo, date, out, body):
    """Write the report everywhere it can go. Returns (primary_path, all_written).

    A failure to write ONE destination is not a failed run — under TCC the repo copy
    simply cannot be made, and that is the entire scenario this exists for. The run fails
    only if NOTHING could be written, which is a genuine loss of the artifact."""
    if out:
        targets = [out]
    else:
        targets = [os.path.join(d, "%s.md" % date) for d in _report_dirs(repo)]

    written = []
    last_exc = None
    for path in targets:
        try:
            parent = os.path.dirname(path)
            if parent:
                os.makedirs(parent, exist_ok=True)
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(body)
            written.append(path)
        except OSError as exc:
            last_exc = exc

    if not written:
        _die("cannot write the morning report to %s: %s"
             % (", ".join(targets), last_exc))
    return written[0], written


def _backfill_reports(repo):
    """Copy reports the SCHEDULED run could only write to the relocated root back into
    <repo>/.planning/dream, so they reach git and the human's usual place.

    This is what keeps the nightly artifact from being stranded. The 03:00 job cannot
    write the repo; the next terminal session can, and it holds the TCC grant. Copy-only
    and never overwrite: a report already in the repo is authoritative, and this must
    never be able to damage one. Returns the count copied."""
    src_dir = _relocated_report_dir(repo)
    if not src_dir:
        return 0
    dst_dir = os.path.join(repo, ".planning", "dream")
    try:
        if not os.path.isdir(src_dir):
            return 0
        if not (_usable_dir(dst_dir) or _usable_dir(os.path.dirname(dst_dir))):
            return 0
        os.makedirs(dst_dir, exist_ok=True)
        names = sorted(os.listdir(src_dir))
    except OSError:
        return 0

    copied = 0
    for name in names:
        if not name.endswith(".md"):
            continue
        dst = os.path.join(dst_dir, name)
        if os.path.exists(dst):
            continue
        try:
            with open(os.path.join(src_dir, name), "r", encoding="utf-8") as fh:
                blob = fh.read()
            with open(dst, "w", encoding="utf-8") as fh:
                fh.write(blob)
            copied += 1
        except OSError:
            continue
    return copied


# ── reuse: shell out to the sibling self-improve bin (the keep-gate is REUSED, not
#    reimplemented). Returns parsed JSON stdout; None on a non-zero exit. ──────────

def _child_env(repo):
    """The environment every sibling runs under.

    HEIMDALL_PLANNING_DIR points self-improve at the relocated state dir — it is that
    bin's single path choke point, so one variable moves all four of its state files at
    once. HEIMDALL_HOME is asserted for the same reason one level out: heimdall-issue-loop
    defaults its queue to <repo>/.heimdall, which under launchd is inside the denied tree.
    Both are set only for the children, never exported into this process."""
    env = dict(os.environ)
    env["HEIMDALL_PLANNING_DIR"] = _state_dir(repo)
    env.setdefault("HEIMDALL_HOME", _dd.heimdall_home() if _dd is not None
                   else os.path.join(os.path.expanduser("~"), ".heimdall"))
    return env


def _si(repo, *args):
    if not os.path.exists(SELF_IMPROVE):
        _die("sibling bin not found: %s" % SELF_IMPROVE)
    cmd = [sys.executable, SELF_IMPROVE, "--repo", repo] + list(args)
    proc = subprocess.run(cmd, capture_output=True, text=True, env=_child_env(repo))
    if proc.returncode != 0:
        return {"_error": proc.stderr.strip() or proc.stdout.strip(),
                "_rc": proc.returncode}
    out = proc.stdout.strip()
    if not out:
        return {}
    try:
        return json.loads(out)
    except (ValueError, TypeError):
        return {"_raw": out}


def _issue_queue(repo):
    """Best-effort read of the live issue queue (the seeker's downstream). Absent
    bin/queue -> zeros (graceful — the sweep still runs on metric/queue evidence)."""
    if not os.path.exists(ISSUE_LOOP):
        return None
    proc = subprocess.run([sys.executable, ISSUE_LOOP, "status", "--repo", repo],
                          capture_output=True, text=True, env=_child_env(repo))
    if proc.returncode != 0:
        return None
    try:
        return json.loads(proc.stdout.strip() or "{}")
    except (ValueError, TypeError):
        return None


# ── the overnight run ─────────────────────────────────────────────────────────

def cmd_run(args):
    repo = args.repo
    date = args.date or _today()
    # Clamp UP to the floor. A caller asking for less evidence than the floor is
    # asking to be fooled; honour the request only when it is stricter than ours.
    floor_enforced = args.min_samples < MIN_SAMPLES_FLOOR
    min_samples = max(args.min_samples, MIN_SAMPLES_FLOOR)
    ms = str(min_samples)

    # Same discipline for min_delta — MIN_SAMPLES_FLOOR bounds HOW MUCH evidence,
    # this bounds HOW BIG a delta has to be before it counts; either alone is not
    # enough (see the false-KEEP table above: n=20/delta=0.10 is still 25.2%, only
    # n=20/delta=0.15 gets to 13.2%). Clamp UP only, exactly like min_samples above —
    # an unclamped --min-delta would let a caller silently reopen that gap.
    min_delta_floor_enforced = args.min_delta < DEF_MIN_DELTA
    min_delta = max(args.min_delta, DEF_MIN_DELTA)

    # 1. COLLECT the comparable scalar + FORM hypotheses (real self-improve output).
    collect = _si(repo, "collect")
    hypos = _si(repo, "hypotheses", "--min-samples", ms)
    status = _si(repo, "status")

    total_records = int(collect.get("total_task_records", 0) or 0)
    hyp_list = hypos.get("hypotheses", []) if isinstance(hypos, dict) else []
    routing_hyps = [h for h in hyp_list if h.get("kind") == "routing"]
    precheck_hyps = [h for h in hyp_list if h.get("kind") == "precheck"]

    # 2. TEST via the keep-gate — EVALUATE every open experiment (KEEP measured wins,
    #    else ROLL BACK). This is the self-improve falsifier, reused verbatim.
    open_exps = status.get("open_experiments", []) if isinstance(status, dict) else []
    evaluated = []
    for exp_id in open_exps:
        res = _si(repo, "experiment", "evaluate", "--id", exp_id)
        if isinstance(res, dict) and res.get("decision"):
            evaluated.append(res)
    kept = [e for e in evaluated if e.get("decision") == "keep"]
    discarded = [e for e in evaluated if e.get("decision") != "keep"]

    # 2b. Optionally START one bounded, reversible experiment (safe per the keep-gate:
    #     unvalidated, snapshotted, auto-rolled-back next cycle if it does not win).
    started = None
    if args.start_experiment and routing_hyps:
        # do not start on a subject that already carries an override (an open
        # experiment or a validated win) — one bounded experiment per subject.
        active = status.get("overrides_active", {}) if isinstance(status, dict) else {}
        cand = next((h for h in routing_hyps
                     if h.get("testable")
                     and h.get("proposal", {}).get("task_type") not in active), None)
        if cand:
            started = _si(repo, "experiment", "start", "--hypothesis", cand["id"],
                          "--min-samples", ms, "--min-delta", str(min_delta))
            if isinstance(started, dict) and started.get("started"):
                started["hypothesis"] = cand
            else:
                started = None

    # 3. maintainer SWEEP — the seeker's issues: recurring dead-reason clusters (from
    #    real queue-stats, surfaced by self-improve as precheck hypotheses) + the live
    #    issue queue state.
    queue = _issue_queue(repo)

    # re-read the post-evaluate status so validated wins reflect this run's KEEPs.
    status = _si(repo, "status")
    validated = status.get("validated_overrides", {}) if isinstance(status, dict) else {}

    honest_empty = (total_records == 0 and not routing_hyps and not precheck_hyps
                    and not kept and not validated
                    and not (queue and (queue.get("queued") or queue.get("flagged"))))

    report = _render(date, repo, args.mode, total_records, routing_hyps,
                     precheck_hyps, queue, kept, discarded, validated, started,
                     min_delta, honest_empty, min_samples, floor_enforced,
                     min_delta_floor_enforced)

    path, written = _write_report(repo, date, args.out, report)
    # Reports the 03:00 job could only strand in the relocated root are pulled back into
    # the repo now, while this process holds the grant that the LaunchAgent never has.
    backfilled = _backfill_reports(repo) if not args.out else 0

    summary = {
        "date": date,
        "report_path": path,
        "report_paths": written,
        "state_dir": _state_dir(repo),
        "backfilled_reports": backfilled,
        "mode": args.mode,
        "honest_empty": honest_empty,
        "min_samples": min_samples,
        "min_samples_floor": MIN_SAMPLES_FLOOR,
        "min_samples_floor_enforced": floor_enforced,
        "min_delta": min_delta,
        "min_delta_floor": DEF_MIN_DELTA,
        "min_delta_floor_enforced": min_delta_floor_enforced,
        "pushed": False,  # agent-never-pushes: this bin performs NO push/merge.
        "counts": {
            "suggested_changes": len(routing_hyps) + (1 if started else 0),
            "issues_raised": len(precheck_hyps)
                             + (1 if queue and (queue.get("queued") or queue.get("flagged")) else 0),
            "improvements_kept": len(kept),
            "experiments_discarded": len(discarded),
            "validated_overrides": len(validated),
        },
    }
    if args.json:
        print(json.dumps(summary, indent=2, sort_keys=True))
    else:
        print("dream: wrote %s (%s) — %d suggested, %d issues, %d kept%s"
              % (path, "nothing to suggest" if honest_empty else "signal found",
                 summary["counts"]["suggested_changes"],
                 summary["counts"]["issues_raised"],
                 summary["counts"]["improvements_kept"],
                 "" if not args.start_experiment else " · 1 experiment started"
                 if started else ""))
    return 0


# ── the morning report (markdown) — every line sourced from real output ─────────

def _render(date, repo, mode, total_records, routing_hyps, precheck_hyps, queue,
            kept, discarded, validated, started, min_delta, honest_empty,
            min_samples, floor_enforced, min_delta_floor_enforced):
    L = []
    L.append("# Dream Journal — %s" % date)
    L.append("")
    L.append("Overnight autoresearch + maintainer sweep. **Shadow-first**: routing "
             "suggestions are surfaced for review, not auto-applied. Only the "
             "self-improve keep-gate (safe, measured, reversible) persists a change. "
             "No changes were pushed or merged.")
    L.append("")
    L.append("- generated: `%s`" % _now())
    L.append("- repo: `%s`" % repo)
    L.append("- mode: `%s`" % mode)
    L.append("- task-outcome records seen: **%d**" % total_records)
    L.append("- sample-size floor: **%d** observations per `(task_type, model)` before "
             "any routing verdict is allowed (min-delta `%.2f`). Below the floor a "
             "pass-rate is noise: at 3 samples a variant that is truly no better "
             "still clears the delta ~73%% of the time, so no verdict is offered."
             % (min_samples, min_delta))
    if floor_enforced or min_delta_floor_enforced:
        clamped = []
        if floor_enforced:
            clamped.append("`--min-samples` was below the sample-size floor and was "
                           "clamped up to **%d**" % min_samples)
        if min_delta_floor_enforced:
            clamped.append("`--min-delta` was below the delta floor and was clamped "
                           "up to **%.2f**" % min_delta)
        L.append("- the requested %s. Neither floor may be lowered by a caller."
                 % " and ".join(clamped))
    L.append("")

    if honest_empty:
        L.append("> **Nothing to suggest — no evidence yet.** `.planning/metrics.jsonl` "
                 "carries no `task` outcome records (and the queue is clear), so there "
                 "is no measurable signal to form a hypothesis from. Dream ran honestly "
                 "and is not fabricating suggestions. Once maintainer cycles record task "
                 "outcomes, re-run `/dream`.")
        L.append("")
        L.append("## 1. Suggested changes")
        L.append("")
        L.append("_None — no measured signal._")
        L.append("")
        L.append("## 2. Issues raised & proposed fixes")
        L.append("")
        L.append("_None — no dead-reason clusters and an empty issue queue._")
        L.append("")
        L.append("## 3. Improvements kept")
        L.append("")
        L.append("_None — no experiments to evaluate._")
        L.append("")
        L.append("---")
        L.append("")
        L.append("_No changes pushed. The agent never pushes or merges — a human reviews "
                 "and applies. Schedule overnight with_ `/schedule \"/dream\" --cron "
                 "\"0 3 * * *\"`.")
        L.append("")
        return "\n".join(L)

    # ── 1. suggested changes ────────────────────────────────────────────────────
    L.append("## 1. Suggested changes")
    L.append("")
    L.append("Routing/planning hypotheses formed from the measured baseline. These are "
             "**suggestions** — apply after review with "
             "`heimdall-self-improve experiment start --hypothesis <id>`.")
    L.append("")
    if routing_hyps:
        for h in routing_hyps:
            b = h.get("baseline", {}) or {}
            prop = h.get("proposal", {}) or {}
            L.append("- **`%s`** — %s `%s` → `%s`"
                     % (h["id"], h.get("subject", "?"),
                        prop.get("from_model", "?"), prop.get("to_model", "?")))
            L.append("  - observation: %s" % h.get("observation", ""))
            L.append("  - rationale: %s" % h.get("rationale", ""))
            L.append("  - baseline: pass_rate **%.2f** over **%d** samples (avg_retries %.2f)"
                     % (float(b.get("pass_rate", 0) or 0), int(b.get("samples", 0) or 0),
                        float(b.get("avg_retries", 0) or 0)))
            L.append("  - expected: %s" % h.get("expected", ""))
    else:
        L.append("_None — no routing hypothesis met the min-samples gate._")
    if started:
        h = started.get("hypothesis", {})
        L.append("")
        L.append("**Experiment started this run (bounded · reversible · unvalidated):** "
                 "`%s` — routing `%s` → `%s`. The next matching tasks run the variant; "
                 "the keep-gate validates it on the next `/dream` (KEEP on a measured "
                 "delta ≥ %.2f, else auto-rollback)."
                 % (started.get("started"), h.get("subject", "?"),
                    started.get("variant_model", "?"), min_delta))
    L.append("")

    # ── 2. issues raised & proposed fixes ────────────────────────────────────────
    L.append("## 2. Issues raised & proposed fixes")
    L.append("")
    L.append("Candidates from the maintainer sweep — recurring failure clusters and the "
             "live issue queue. Raised as candidates for a human; not auto-filed.")
    L.append("")
    any_issue = False
    for h in precheck_hyps:
        any_issue = True
        b = h.get("baseline", {}) or {}
        L.append("- **issue** (`%s`): %s" % (h["id"], h.get("observation", "")))
        L.append("  - proposed fix: %s" % h.get("rationale", ""))
        L.append("  - evidence: reason=`%s` count=**%s**"
                 % (b.get("reason", "?"), b.get("count", "?")))
        L.append("  - action: add a pre-check or a `.planning/skills/*.md` pattern; if it "
                 "belongs in the codebase, file a repo issue via `heimdall-feedback`.")
    if queue and (queue.get("queued") or queue.get("flagged")):
        any_issue = True
        L.append("- **issue queue**: %d queued · %d flagged · %d in-flight · %d resolved"
                 % (int(queue.get("queued", 0) or 0), int(queue.get("flagged", 0) or 0),
                    int(queue.get("in_flight", 0) or 0), int(queue.get("resolved", 0) or 0)))
        if queue.get("flagged"):
            L.append("  - proposed fix: **flagged** issues failed the gate — a human should "
                     "triage; the fixer opens a PR only via `heimdall-issue-pr open` "
                     "(never by pushing).")
        if queue.get("queued"):
            L.append("  - proposed fix: **queued** issues are pickable — the fixer will "
                     "orient → fix → GATE → attest → PR-ready on the next maintainer cycle.")
    if not any_issue:
        L.append("_None — no dead-reason clusters and no queued/flagged issues._")
    L.append("")

    # ── 3. improvements kept ─────────────────────────────────────────────────────
    L.append("## 3. Improvements kept")
    L.append("")
    L.append("Measured wins from the self-improve keep-gate — an override persists ONLY "
             "with a measured pass-rate delta over its baseline (else it was rolled back).")
    L.append("")
    if kept:
        for e in kept:
            r = e.get("result", {}) or {}
            L.append("- **KEPT** `%s` — delta **%+.4f** (variant %.2f vs baseline %.2f) "
                     "over **%d** samples → override *validated*."
                     % (e.get("id", "?"), float(r.get("delta_pass_rate", 0) or 0),
                        float(r.get("variant_pass_rate", 0) or 0),
                        float(r.get("baseline_pass_rate", 0) or 0),
                        int(r.get("samples", 0) or 0)))
            L.append("  - verdict: %s" % r.get("reason", ""))
    if validated:
        for subj, ov in sorted(validated.items()):
            if isinstance(ov, dict):
                L.append("- active validated override: `%s` → `%s` (%s)"
                         % (subj, ov.get("model", "?"), ov.get("reason", "")))
    if not kept and not validated:
        L.append("_None kept this run._")
    if discarded:
        L.append("")
        L.append("**Rolled back (not an improvement — transparency):**")
        for e in discarded:
            r = e.get("result", {}) or {}
            L.append("- `%s` DISCARDED — %s" % (e.get("id", "?"), r.get("reason", "")))
    L.append("")
    L.append("---")
    L.append("")
    L.append("_No changes pushed. The agent never pushes or merges — a human reviews and "
             "applies suggestions. Re-run on demand with_ `/dream` _or schedule overnight "
             "with_ `/schedule \"/dream\" --cron \"0 3 * * *\"`.")
    L.append("")
    return "\n".join(L)


def cmd_where(args):
    print(_report_path(args.repo, args.date or _today(), args.out))
    return 0


def build_parser():
    ap = argparse.ArgumentParser(
        prog="heimdall-dream",
        description="Overnight autoresearch + maintainer sweep -> a morning report "
                    "(dream journal). Shadow-first; agent-never-pushes.")
    ap.add_argument("--repo", default=".", help="repo root (default: cwd)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="run the overnight loop and write the morning report")
    r.add_argument("--date", default=None, help="report date (default: today UTC)")
    r.add_argument("--min-samples", type=int, default=MIN_SAMPLES_FLOOR,
                   help="observations required before a routing verdict (floor: %d; "
                        "may be raised, never lowered)" % MIN_SAMPLES_FLOOR)
    r.add_argument("--min-delta", type=float, default=DEF_MIN_DELTA,
                   help="pass-rate improvement required to KEEP (floor: %.2f; "
                        "may be raised, never lowered)" % DEF_MIN_DELTA)
    r.add_argument("--out", default=None, help="override report path")
    r.add_argument("--mode", default="on-demand", choices=["overnight", "on-demand"])
    r.add_argument("--overnight", dest="mode", action="store_const", const="overnight",
                   help="alias for --mode overnight (used when a schedule fires /dream)")
    r.add_argument("--start-experiment", action="store_true",
                   help="also START one bounded, reversible experiment (default: surface only)")
    r.add_argument("--json", action="store_true", help="print the machine summary")
    r.set_defaults(fn=cmd_run)

    w = sub.add_parser("where", help="print the report path for a date")
    w.add_argument("--date", default=None)
    w.add_argument("--out", default=None)
    w.set_defaults(fn=cmd_where)

    return ap


def _require_repo(repo):
    """Reject a repo that is genuinely WRONG; tolerate one that is merely UNREADABLE.

    `os.path.isdir` cannot tell those apart — it answers False both for a path that does
    not exist and for one the OS refuses to stat — and under TCC the nightly job gets the
    second for a repo that is perfectly healthy. That difference is not theoretical; it is
    measured, and it inverts between the two denials:

        chmod 000 dir    EACCES   os.path.isdir() == True   (stat needs only the PARENT)
        TCC-denied dir   EPERM    os.path.isdir() == False  (the path itself is refused)

    So this guard passed every test written against a mode-000 fixture while aborting the
    real 03:00 run — one step AFTER heimdall-dream-runner had correctly decided to
    continue — and blamed a repo that was fine. The distinction is drawn on the errno,
    which is the only thing that actually carries it:

      * stats fine and is a directory  -> proceed.
      * PermissionError (EPERM/EACCES) -> proceed. This is the TCC case. dream reads its
        state from $HEIMDALL_HOME, so an unreachable repo costs it nothing it needs; only
        the mirror-back of the report into the repo is lost, and the next terminal session
        (which holds the grant) copies it across.
      * anything else (ENOENT, a file, a dead symlink) -> a genuine mistake: a typo, or a
        plist pinned to a deleted tree. Still fatal, because nothing downstream can
        recover from it and continuing would fabricate a report about nothing.

    NARROWED, NOT DELETED. The unreachable case is handed to a run that is honest about
    it: the runner records repo_reachable=no alongside the result, so a completed run is
    never mistaken for evidence the grant landed.
    """
    try:
        if os.path.isdir(repo):
            return
        os.stat(repo)
    except PermissionError:
        return
    except OSError:
        _die("repo not a directory: %s" % repo, 2)
    _die("repo not a directory: %s" % repo, 2)


def main(argv):
    ap = build_parser()
    args = ap.parse_args(argv)
    args.repo = os.path.abspath(args.repo)
    _require_repo(args.repo)
    return args.fn(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except BrokenPipeError:
        raise SystemExit(0)
