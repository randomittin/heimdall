#!/bin/sh
# heimdall-secret-filter — keep pasted credentials off the wire.
#
# WHAT THIS IS. A `UserPromptSubmit` hook. When a credential is pasted into a
# prompt, the value is stored locally under a reference (`{{HMD_SECRET_1}}`) and
# the prompt is REFUSED, so the value is never transmitted. The user re-sends
# using the reference.
#
# WHY IT BLOCKS INSTEAD OF SUBSTITUTING. Substitution is what everyone wants and
# it is not implementable. Measured against Claude Code 2.1.251: no prompt-rewrite
# field exists in any hook (`updatedPrompt`/`modifiedPrompt`/`rewritePrompt` are
# absent from the binary; `updatedInput` is PreToolUse-only), and a hook that
# returns every plausible rewrite field at once still has the ORIGINAL text
# delivered verbatim. Hook output can only be APPENDED as extra context. So the
# only mechanism that actually prevents transmission is refusal — and refusal is
# genuinely pre-transmission: a blocked turn reports `input_tokens: 0`,
# `duration_api_ms: 0`, `total_cost_usd: 0`. Full evidence, and the limits of what
# this can promise, in docs/secret-paste-filter.md.
#
# SPEED. This runs on EVERY prompt, so it is two-stage: a single grep pre-filter
# (no jq, no python) rejects the overwhelming majority of prompts, and the
# classifier is only started when something credential-shaped is actually
# present. The pre-filter is a strict SUPERSET of what the classifier can match —
# every named shape and the generic rule's key names are anchored here — so the
# fast path can never skip a prompt the slow path would have flagged.
# test/paste-secret-filter.test.sh pins that superset property.
#
# Verbs:
#   (no args, stdin = hook JSON)  hook mode: scan, vault, block
#   scan                          stdin = raw text; print `shape<TAB>ref<TAB>fp`, exit 1 if found
#   list                          show vaulted references (never values)
#   get REF                       print the value  — see the warning below
#   exec REF VARNAME -- cmd ...   run cmd with VARNAME=value in its environment
#
# get vs exec: `get` writes the value to stdout. Inside an agent-run shell
# command that lands in the tool output, which IS transmitted. Use `exec` for
# anything an agent might run — it injects the value into a child process and
# prints it nowhere.
#
# Exit codes (hook mode): 0 = nothing found, prompt proceeds. 2 = credential
# found, prompt refused.

set -eu

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LIB="$SELF_DIR/lib/paste_secret_filter.py"

# Coarse pre-filter. Superset of every classifier pattern; see header.
COARSE='sk-|gh[pousr]_|github_pat_|AKIA|ASIA|AIza|xox[baprs]-|eyJ|BEGIN[A-Za-z ]*PRIVATE KEY|(api[_-]?key|apikey|secret|token|password|passwd|private[_-]?key|access[_-]?key|client[_-]?secret|auth[_-]?token)[A-Za-z0-9_.-]*[[:space:]]*[:=]'

HEIMDALL_REPO_ROOT=${HEIMDALL_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
export HEIMDALL_REPO_ROOT

VERB=${1:-hook}

if [ "$VERB" != "hook" ]; then
  exec python3 "$LIB" "$@"
fi

# ── hook mode ───────────────────────────────────────────────────────────────
if [ "${HMD_SECRET_FILTER:-on}" = "off" ]; then
  exit 0
fi

INPUT=$(cat)

# Stage 1: the fast path. Runs against the RAW hook JSON rather than the
# extracted prompt — JSON escaping only ever touches `"`, `\` and control
# characters, none of which appear in any anchor above, so scanning the raw
# payload is a valid superset test and saves a jq process on every prompt.
if ! printf '%s' "$INPUT" | LC_ALL=C grep -qiE "$COARSE" 2>/dev/null; then
  exit 0
fi

# Stage 2: something is credential-shaped. Now it is worth extracting the prompt
# and classifying properly.
PROMPT=$(printf '%s' "$INPUT" | jq -r '.prompt // empty' 2>/dev/null || printf '')
[ -n "$PROMPT" ] || exit 0

if ! command -v python3 >/dev/null 2>&1; then
  # FAIL CLOSED. Something credential-shaped is present and cannot be classified.
  # Allowing the prompt through here would make this control theatre exactly when
  # it matters, so it refuses and names the escape hatch instead.
  printf 'BIFROST — Heimdall refused this prompt: python3 is missing, so a credential-shaped\n' >&2
  printf 'value in your prompt could not be classified. Nothing was sent.\n\n' >&2
  printf 'Install python3, or bypass with HMD_SECRET_FILTER=off (which TRANSMITS the value).\n' >&2
  exit 2
fi

FINDINGS=$(printf '%s' "$PROMPT" | python3 "$LIB" scan) || true
[ -n "$FINDINGS" ] || exit 0

VAULT=${HEIMDALL_HOME:-$HEIMDALL_REPO_ROOT/.heimdall}/secret-vault.ndjson
COUNT=$(printf '%s\n' "$FINDINGS" | wc -l | tr -d ' ')
FIRST_REF=$(printf '%s\n' "$FINDINGS" | head -1 | cut -f2)

{
  printf 'BIFROST — Heimdall blocked a credential paste. Nothing was sent.\n\n'
  printf '%s credential-shaped value(s) were found in your prompt. Claude Code hooks CANNOT\n' "$COUNT"
  printf 'rewrite prompt text, so refusing the whole prompt is the only way to keep these off\n'
  printf 'the wire. No API request was made — your text was not transmitted.\n\n'
  printf '%s\n' "$FINDINGS" | awk -F'\t' '{ printf "  %-22s %-20s %s\n", $2, $1, $3 }'
  printf '\nStored locally, 0600, gitignored:\n  %s\n\n' "$VAULT"
  printf 'Re-send your prompt with the reference in place of the value, e.g.\n'
  printf '  "deploy using %s"\n\n' "$FIRST_REF"
  printf 'To USE a value locally without it entering the conversation:\n'
  printf "  bin/heimdall-secret-filter exec '%s' MY_ENV_VAR -- your-command\n" "$FIRST_REF"
  printf 'That injects it into the child process environment and prints it nowhere.\n'
  printf 'Do NOT use `get` inside an agent-run command — that writes the value into the\n'
  printf 'tool output, which IS transmitted.\n\n'
  printf 'Bypass (TRANSMITS the secret): HMD_SECRET_FILTER=off\n'
} >&2

exit 2
