#!/usr/bin/env bash
# heimdall-statusline — CLI-AGNOSTIC statusline renderer, the ONE source of truth.
#
# This is what actually renders the HUD. Two callers wrap it, byte-identical output
# from both because both just `exec` straight into this file:
#   - hooks/statusline.sh                      Claude Code's registered `statusLine`
#                                               command (stdin JSON, width via the
#                                               $COLUMNS env var).
#   - bin/heimdall-statusline-register-cursor   wires Cursor CLI's `statusLine` in
#                                               ~/.cursor/cli-config.json to THIS
#                                               path directly (stdin JSON, width via
#                                               a `render_width_chars` JSON field
#                                               instead — Cursor spawns with no shell
#                                               and no tty on our stdout either, so
#                                               ~/.cursor/skills-cursor/statusline/
#                                               SKILL.md documents that field as the
#                                               one true width signal for that host).
# Also directly callable by hand from any shell, any AI CLI or none at all:
# `hmd status` (bin/heimdall's `status)` arm execs straight here too), or just run
# this file. test/heimdall-statusline-parity.test.sh locks the "one source of
# truth" property — it fails the moment the two wrapped paths disagree on a byte.
#
# PRIMARY: the full-width watchman (sentinels/hmd-statusline.py) — 4 rows, sigil
#   anchor left, gate verdict pinned right, team watch wall on the bottom rows.
#   It reads the stdin JSON itself; we pipe stdin straight through and hand it
#   COLUMNS so the right-pinned verdict aligns. Zero model — it works from local
#   ledger state (.heimdall/statusline.json, .heimdall/.roster-cache.json).
# FALLBACK: the legacy single-line instrument (bin/heimdall-face --statusline),
#   used iff python3 is unavailable, the watchman script is missing, or it exits
#   nonzero/empty. The bar must NEVER error, NEVER block, NEVER print prose.
#
# Never-error contract: the watchman output is captured to a var FIRST; we emit
# the fallback only after confirming the primary produced nothing usable. Every
# branch ends in `exit 0`.

HERE="$(cd "$(dirname "$0")" && pwd)"
WATCHMAN="$HERE/../sentinels/hmd-statusline.py"
FACE_BIN="$HERE/heimdall-face"

# ── FAST python3 — resolved ONCE, VERIFIED BY USE, before any subprocess below ──
# MEASURED (this machine): bare `python3` resolves through a pyenv shim
# (~/.pyenv/shims/python3 execs `pyenv exec python3`, a version-resolution
# dispatcher) at ~400-450ms/launch — against a DIRECT, non-shim python3 at
# ~30-70ms. A render used to launch python3 NINE times for a Cursor payload and
# ELEVEN for a Claude Code one: hmd_python's validation probe (1), the render-width
# probe (1), ctx-meter's four `$(hmd_python)` + four parses (8), the Cursor
# host-label normalizer (1), the watchman (1), the CTX-honesty post-process (1).
# Each is 56ms idle and several times that under CPU contention — the whole of why
# test/heimdall-statusline-perf-budget.test.sh failed at load 34-76. A render now
# launches it TWICE: the watchman, which does the width / host-label / CTX-honesty
# corrections itself (--host-boundary), and ONE ctx-meter parse.
#
# bin/lib/hmd-python.sh (the same library heimdall-ctx-meter already uses)
# resolves the real interpreter ONCE into $PY3; every call site below uses that
# variable instead of a bare `python3`. Deliberately NOT a PATH mutation —
# prepending a real bin/ directory ahead of a caller's own PATH previously
# unshadowed test/heimdall-maintain-loop.test.sh's fake gh/git fixtures. A
# resolved variable touches nothing outside this process.
#
# VERIFIED BY USE, NOT BY PROBE. hmd_python proves its answer with a `-c pass`
# launch on every call; here the interpreter is about to be RUN for real anyway,
# so the cached path (hmd_python_cached — no launch) is trusted for exactly that
# run, and an empty render is the signal to re-resolve through hmd_python, which
# probes, deletes a stale cache and names a working interpreter (see the retry
# below). The 2026-09-19 incident this guards (an executable licence-nag stub named
# by the cache) still self-heals inside the one render that hits it; test/heimdall-
# statusline-perf-budget.test.sh replays it. $PY3_PROVEN records whether $PY3 has
# actually run (or just been probed) — only a proven interpreter is handed on.
# DEGRADES SAFELY: no cache, no lib, no working interpreter anywhere (a broken macOS
# CLT stub) all end at the old `command -v python3` / "python3 unavailable" floor
# every jq/legacy fallback below already handled.
PY3=""
PY3_PROVEN=0
# shellcheck source=lib/hmd-python.sh
[ -r "$HERE/lib/hmd-python.sh" ] && . "$HERE/lib/hmd-python.sh"
if type hmd_python_cached >/dev/null 2>&1; then PY3="$(hmd_python_cached 2>/dev/null || true)"; fi
if [ -z "$PY3" ] && type hmd_python >/dev/null 2>&1; then
  PY3="$(hmd_python 2>/dev/null || true)"   # cold cache: the one probe, which also writes the cache
  [ -z "$PY3" ] || PY3_PROVEN=1
fi
[ -n "$PY3" ] || PY3="$(command -v python3 2>/dev/null || true)"

# ── Slurp the caller's statusLine stdin blob ONCE so both the watchman and the
# fallback signal-resolver can read it (stdin is consumable only once).
#
# A REAL controlling tty on stdin (nothing piped — a bare interactive `hmd status`
# at a prompt) is not "no data", it is "no host JSON, render from local state" — so
# it gets a valid empty JSON object, which the watchman's own null-safe contract
# already turns into the full multi-row HUD (gates/team read straight off the
# ledger; model/cost/context/rate-limit fields degrade gracefully since they're
# independently optional). A genuine empty PIPE (a harness deliberately piping
# nothing, e.g. CI) is left as an empty string, which is the existing, tested
# malformed/empty-input contract: fall through to the branded ⛭ HEIMDALL floor.
BLOB=""
if [ -t 0 ]; then
  BLOB="{}"
else
  BLOB="$(cat 2>/dev/null)"
fi

# ── Width. The watchman right-pins the verdict against COLUMNS, so whoever's
# widest, truest signal wins, in this order:
#   1. `render_width_chars` in the stdin JSON (Cursor CLI ONLY — Claude Code's schema
#      never sends this key, so its mere presence identifies the host). Cursor's own
#      docs name THIS field, not $COLUMNS, as the authoritative width, and it ALWAYS
#      wins over $COLUMNS when present: a no-shell `child_process.spawn` child still
#      inherits $COLUMNS from Cursor's own launching terminal by default (no explicit
#      `env` option strips it), and that inherited value can be STALE — no longer the
#      live width — while render_width_chars is computed fresh on every invocation.
#      Trusting a stale $COLUMNS over a fresh, authoritative JSON field would silently
#      render at the WRONG width. Because Cursor already subtracted its own padding,
#      we must NOT also apply Claude Code's separate (undocumented,
#      empirically-measured) 4-cell region reserve on top of a width that was already
#      corrected once — so when width comes from this field we pin
#      HMD_STATUSLINE_RESERVE=0 (unless the caller already set that override
#      themselves).
#   2. $COLUMNS already exported by the caller (Claude Code sets this itself; this is
#      Claude Code's ONLY width signal — its payload never carries render_width_chars,
#      so step 1 never fires and this step is unconditionally reached, unchanged from
#      before this reordering).
#   3. `tput cols` (a real terminal reachable on our own stdout — the bare
#      manual-invocation case).
#   4. 120, the long-standing safe default.
#
# Step 1 is NOT resolved here any more. It used to cost a python launch (a JSON parse of
# the blob just to read one number) before the watchman — which parses the same blob
# anyway — even started. The watchman now reads render_width_chars itself under
# --host-boundary (sentinels/hmd-statusline.py: resolve_cols), with identical precedence:
# a usable number beats whatever $COLUMNS holds, with the reserve held at 0 unless the
# caller set HMD_STATUSLINE_RESERVE; absent/null/zero/non-numeric falls through to the
# ambient width computed below. This block only supplies that ambient width (steps 2-4).
# (One cost of the move, accepted: a Cursor payload with NO inherited $COLUMNS now also
# runs the `tput cols` fork below even though its field will win — one ~5ms fork against
# the ~70ms launch it replaced; Cursor inherits $COLUMNS in practice.)
COLS="${COLUMNS:-}"
case "$COLS" in ''|*[!0-9]*) COLS="" ;; esac
case "$COLS" in ''|*[!0-9]*) COLS="$(tput cols 2>/dev/null)" ;; esac
case "$COLS" in ''|*[!0-9]*) COLS=120 ;; esac
export COLUMNS="$COLS"

# ── Color detection (legacy fallback honors it via --color/--no-color) ──
if [[ "${COLORTERM:-}" == "truecolor" || "${COLORTERM:-}" == "24bit" || "${TERM:-}" == *256color* ]]; then
  COLOR_FLAG="--color"
elif [ -t 1 ] || [ -n "${TERM:-}" ]; then
  COLOR_FLAG="--color"
else
  COLOR_FLAG="--no-color"
fi

# (The PUBLISH of the context reading to bin/heimdall-ctx-meter happens below, right after
# the render attempt: by then $PY3 has either just run for real or been re-resolved, so
# the meter is handed an interpreter that is KNOWN to work instead of re-proving one.)

# ── LIVE harness-subagent count (cached: background refresh, cheap read) ────────
# Claude Code Agent-tool subagents (hmd:coder &c.) are owned by the harness and
# never enter agent-pool, so a dead/hung one would keep inflating any raw count.
# bin/heimdall-agents enumerates them from the harness task dir and returns ONLY
# the live ones; we publish that as HMD_LIVE_SUBAGENTS so the HUD's agent segment
# reflects the honest live count. This is heimdall's OWN view — it does NOT
# (cannot) touch Claude Code's FleetView, and under a non-Claude-Code host there
# simply is no harness task dir to enumerate, so that case still degrades to 0
# exactly as before this fix.
#
# WHY CACHED: `heimdall-agents count` parses every harness transcript in the
# session task dir — measured 73 files/31MB against the main repo when this fix
# was scoped — which alone can exceed this bar's whole 1000ms budget. The prior
# fix (see the commit immediately before this one) gave the call a hard 1s
# ceiling via `perl -e 'alarm 1; exec @ARGV'` (this repo's documented
# timeout(1)/gtimeout stand-in — macOS ships neither): necessary, but alarm()
# truncates to whole seconds, so 1s alone was already most of the budget. The
# computation has to stop happening synchronously on the render path at all.
#
# PATTERN: mirrors sentinels/hmd-statusline.py's _spawn_presence() — the only
# other place this bar solves "expensive signal, must never block a render":
# a stat-only "is it due" gate, a lock file so concurrent renders don't each
# fork a refresh, a fully detached child that writes a tmp file and atomically
# `mv`s it into place, and a render path that only ever READS the cache. Kept
# in bash here (not imported from that python module) because the underlying
# signal — and its perl-alarm ceiling — has always lived in this file.
#
# HONESTY: a cached count is a real measurement, just up to AGENTS_COUNT_TTL
# seconds old — fine. A GUESSED one is not. A cache that is MISSING or older
# than its TTL renders as "" (unknown), never a fabricated number — the same
# precedent the CTX gauge below already sets (null used_percentage → honest
# "unavailable", never a fabricated "0%"). TTL matches the existing roster
# cache's own cadence (fresh<4s / lock<8s): comfortably longer than a Claude
# Code redraw (>=300ms) or Cursor's updateIntervalMs poll (3000ms), short
# enough that staleness is never more than a few seconds.
#
# DEATH-SPIRAL POSTMORTEM (found 2026-09-24, fixed here): the perl-alarm
# ceiling described above only ever killed the single exec'd PID. `alarm`
# delivers SIGALRM to exactly the process that called it, and `exec @ARGV`
# replaces that process's own image — so the signal's default terminate
# action reached the top-level `heimdall-agents count` shell and nothing
# else. But `enumerate` (inside heimdall-agents) does its own work in `$( )`
# command-substitution subshells (pgrep, `lsof -p` per candidate pid) —
# separate PIDs a single-PID kill never touches. Orphaned, they kept running
# on their own clock (~8s measured under load) even after the "ceiling" hit,
# so on a machine with neither `timeout` nor `gtimeout` (this repo's own dev
# Mac has neither) the 1s ceiling fired on every render without ever
# actually freeing anything: 39 distinct `heimdall-agents count` trees were
# observed alive at once, load average 40-50 on 10 cores. The pile-up starves
# EVERYTHING on the box, including this refresh's own lock-file cleanup, so
# the lock outlives its TTL too and the next render spawns yet another
# orphaned tree — the storm sustains itself. Fixed by killing the whole
# PROCESS GROUP instead of one PID (see the perl branch below), plus the
# failure/timeout backoff below so a wedged `count` is retried on a schedule
# instead of once per render.
HMD_LIVE_SUBAGENTS=0
AGENTS_BIN=""
if command -v heimdall-agents >/dev/null 2>&1; then AGENTS_BIN="heimdall-agents"
elif [ -x "$HERE/heimdall-agents" ]; then AGENTS_BIN="$HERE/heimdall-agents"; fi
if [ -n "$AGENTS_BIN" ]; then
  HMD_LIVE_SUBAGENTS=""   # tool exists ⇒ count is cache-driven; "" until proven fresh
  AC_CWD="${HMD_AGENT_CWD:-$PWD}"
  AC_DIR="$AC_CWD/.heimdall"
  AC_CACHE="$AC_DIR/.agents-count-cache"
  AC_LOCK="$AC_CACHE.lock"
  AC_FAIL="$AC_CACHE.fail"
  AGENTS_COUNT_TTL="${HMD_AGENTS_COUNT_TTL:-4}"
  AGENTS_LOCK_TTL="${HMD_AGENTS_LOCK_TTL:-8}"
  # Off the render path entirely (this ceiling only ever bounds the
  # BACKGROUND refresh subshell below, never the cache read above), so
  # raising it costs this bar nothing: 5s gives a loaded box's pgrep/lsof
  # enumeration room to finish cleanly instead of getting cut off mid-work
  # on every single render (see the DEATH-SPIRAL POSTMORTEM above).
  AGENTS_COUNT_CEIL="${HMD_AGENTS_COUNT_CEIL:-5}"
  # A refresh that failed or timed out is not retried on every render — that
  # was exactly the death spiral's own re-arm path. Once _ac_refresh records
  # a failure below, no new spawn is attempted until this many seconds pass.
  AGENTS_FAIL_BACKOFF="${HMD_AGENTS_FAIL_BACKOFF:-30}"
  # Cadence for the stale-tmp-leftover sweep (_ac_sweep_stale below) — bounded
  # to once per this many seconds regardless of how often a refresh itself
  # spawns. Independent of the TTLs above: this gates a `find`, not the count.
  CACHE_SWEEP_EVERY="${HMD_CACHE_SWEEP_EVERY:-300}"
  case "$AGENTS_COUNT_TTL" in ''|*[!0-9]*) AGENTS_COUNT_TTL=4 ;; esac
  case "$AGENTS_LOCK_TTL"  in ''|*[!0-9]*) AGENTS_LOCK_TTL=8 ;; esac
  case "$AGENTS_COUNT_CEIL" in ''|*[!0-9]*) AGENTS_COUNT_CEIL=5 ;; esac
  case "$AGENTS_FAIL_BACKOFF" in ''|*[!0-9]*) AGENTS_FAIL_BACKOFF=30 ;; esac
  case "$CACHE_SWEEP_EVERY" in ''|*[!0-9]*) CACHE_SWEEP_EVERY=300 ;; esac
  # Sub-second clock for the freshness math below. ROOT CAUSE this fixes: `date
  # +%s` and `stat %m` both floor to whole seconds, and this bar used to diff
  # two independently-floored instants. A write and a check that straddle a
  # wall-clock second boundary (write at x.999s, check at (x+1).001s) can then
  # compute a delta of a full second even though ~2ms really elapsed. Against a
  # short TTL that rounding noise can exceed the whole window, so a
  # just-written, genuinely-fresh cache gets misclassified as stale and a
  # needless recompute clobbers a perfectly good value — exactly
  # test/heimdall-statusline-agents-cache.test.sh case 3's intermittent "fresh
  # cache was overwritten... while still within TTL" (reproduced standalone on
  # an idle machine, not sweep contention). Widening the TTL or adding a sleep
  # would only shrink the odds, not close them, so instead the elapsed-time
  # arithmetic itself moves to nanoseconds, where the same floor/floor skew can
  # no longer cross a TTL this size. `date +%s.%N` / BSD `stat -f%Fm` / GNU
  # `stat -c%.9Y` give sub-second precision on every platform this bar already
  # targets; where a platform's date/stat genuinely lacks it, each helper falls
  # through to the old whole-second value — re-exposed to the rounding noise
  # this comment describes, but a transparent degrade, never a crash.
  _ac_ns_from_secfrac() {
    # $1 = "SECONDS.FRACTION" (any number of fractional digits) -> integer ns.
    local whole="${1%%.*}" frac="${1#*.}"
    frac="${frac}000000000"; frac="${frac:0:9}"
    case "$whole" in ''|*[!0-9]*) whole=0 ;; esac
    case "$frac"  in *[!0-9]*)    frac=0 ;; esac
    printf '%s' "$(( whole * 1000000000 + 10#$frac ))"
  }
  _ac_now_ns() {
    local raw
    raw="$(date +%s.%N 2>/dev/null)"
    case "$raw" in [0-9]*.[0-9]*) _ac_ns_from_secfrac "$raw"; return 0 ;; esac
    local s; s="$(date +%s 2>/dev/null || echo 0)"
    case "$s" in ''|*[!0-9]*) s=0 ;; esac
    printf '%s' "$((s * 1000000000))"
  }
  _ac_mtime_ns() {
    local raw
    raw="$(stat -L -f%Fm "$1" 2>/dev/null)"
    case "$raw" in [0-9]*.[0-9]*) _ac_ns_from_secfrac "$raw"; return 0 ;; esac
    raw="$(stat -L -c%.9Y "$1" 2>/dev/null)"
    case "$raw" in [0-9]*.[0-9]*) _ac_ns_from_secfrac "$raw"; return 0 ;; esac
    local s; s="$(stat -L -f%m "$1" 2>/dev/null || stat -L -c%Y "$1" 2>/dev/null || echo 0)"
    case "$s" in ''|*[!0-9]*) s=0 ;; esac
    printf '%s' "$((s * 1000000000))"
  }

  AC_NOW_NS="$(_ac_now_ns)"
  case "$AC_NOW_NS" in ''|*[!0-9]*) AC_NOW_NS=0 ;; esac
  AC_TTL_NS=$(( AGENTS_COUNT_TTL * 1000000000 ))
  AC_LOCK_TTL_NS=$(( AGENTS_LOCK_TTL * 1000000000 ))
  AC_FAIL_BACKOFF_NS=$(( AGENTS_FAIL_BACKOFF * 1000000000 ))

  AC_FRESH=0
  if [ -f "$AC_CACHE" ]; then
    AC_MTIME_NS="$(_ac_mtime_ns "$AC_CACHE")"
    case "$AC_MTIME_NS" in ''|*[!0-9]*) AC_MTIME_NS=0 ;; esac
    if [ $(( AC_NOW_NS - AC_MTIME_NS )) -lt "$AC_TTL_NS" ]; then
      AC_FRESH=1
      IFS= read -r HMD_LIVE_SUBAGENTS <"$AC_CACHE" 2>/dev/null || HMD_LIVE_SUBAGENTS=""
    fi
  fi

  LOCK_FRESH=0
  if [ -f "$AC_LOCK" ]; then
    LOCK_MTIME_NS="$(_ac_mtime_ns "$AC_LOCK")"
    case "$LOCK_MTIME_NS" in ''|*[!0-9]*) LOCK_MTIME_NS=0 ;; esac
    [ $(( AC_NOW_NS - LOCK_MTIME_NS )) -lt "$AC_LOCK_TTL_NS" ] && LOCK_FRESH=1
  fi

  # Same idea as LOCK_FRESH, gating on the failure marker instead of the
  # lock: a refresh that just failed or timed out stays un-retried until
  # AGENTS_FAIL_BACKOFF seconds have passed, so a permanently-broken or
  # perpetually-slow `count` gets retried once per backoff window, never
  # once per render.
  FAIL_FRESH=0
  if [ -f "$AC_FAIL" ]; then
    AC_FAIL_MTIME_NS="$(_ac_mtime_ns "$AC_FAIL")"
    case "$AC_FAIL_MTIME_NS" in ''|*[!0-9]*) AC_FAIL_MTIME_NS=0 ;; esac
    [ $(( AC_NOW_NS - AC_FAIL_MTIME_NS )) -lt "$AC_FAIL_BACKOFF_NS" ] && FAIL_FRESH=1
  fi

  if [ "$AC_FRESH" = 0 ] && [ "$LOCK_FRESH" = 0 ] && [ "$FAIL_FRESH" = 0 ] && mkdir -p "$AC_DIR" 2>/dev/null; then
    : >"$AC_LOCK" 2>/dev/null
    AC_TMP="$AC_CACHE.$$.tmp"
    # Publishes via a tmp-write + rename + unconditional lock/tmp cleanup (the
    # final `rm` below runs no matter which branch of the if/else just ran) so
    # a failed refresh never leaves an orphaned tmp file (the exact bug
    # already fixed elsewhere in this repo for the roster/wall caches). A
    # nonzero exit — a real failure, or 124 from either timeout mechanism
    # below — writes AC_FAIL with the exit code instead of publishing, so the
    # FAIL_FRESH gate above can back off; a clean publish removes any AC_FAIL
    # a prior failure left behind.
    #
    # LEAK FIX (found 2026-09-24: 9,683 orphaned .agents-count-cache.<pid>.tmp
    # files piled up in .heimdall/, slowing every stat/mkdir/mktemp under it
    # for every hook): the `trap` below registers the SAME "$AC_TMP"/"$AC_LOCK"
    # cleanup as the explicit `rm -f` at the end of this function, on EXIT TERM
    # INT, so it also fires if this subshell is torn down before reaching that
    # line — e.g. an external TERM landing on this refresh's whole process
    # group, which kills "$@" directly and thereby unblocks the wait below, so
    # the now-pending trap runs the moment bash regains control. It does NOT
    # cover SIGKILL: that signal's disposition can't be caught by any process,
    # trap or otherwise, by design. _ac_sweep_stale below is the backstop for
    # exactly that gap — it runs after this function returns, in the same
    # backgrounded subshell, and removes anything a SIGKILL left behind once
    # it's old enough to be unambiguously abandoned. Running both the trap and
    # the tail `rm -f` on the same normal-exit path is a harmless no-op the
    # second time — they target the identical two paths, never a glob.
    _ac_refresh() {
      local rc
      trap 'rm -f "$AC_TMP" "$AC_LOCK"' EXIT TERM INT
      "$@" >"$AC_TMP" 2>/dev/null
      rc=$?
      if [ "$rc" -eq 0 ] && mv -f "$AC_TMP" "$AC_CACHE" 2>/dev/null; then
        rm -f "$AC_FAIL" 2>/dev/null
      else
        [ "$rc" -eq 0 ] && rc=1   # "succeeded" but the tmp->cache publish failed
        printf '%s' "$rc" >"$AC_FAIL" 2>/dev/null
      fi
      rm -f "$AC_TMP" "$AC_LOCK"
    }
    # Bounded stale-leftover sweep — the SIGKILL backstop the trap above can't
    # cover. Runs ONLY here, inside the already-backgrounded, disowned refresh
    # subshell (never on the synchronous render path above it), and at most
    # once per CACHE_SWEEP_EVERY seconds regardless of how often a refresh
    # itself spawns: a marker file's mtime is the gate, touched BEFORE the
    # scan runs so two refreshes racing at the same moment cost at most one
    # harmless extra `find`, never a correctness bug. Scope is deliberately
    # narrow — maxdepth 1 (never descends into anything under .heimdall/),
    # exactly the three known leak-pattern globs, and only files already
    # older than 2 minutes — so this can only ever remove tmp files this
    # file's own agents-count refresh (above) or the wall/roster caches'
    # identically-shaped tmp-then-rename writers (sentinels/hmd-statusline.py)
    # are known to leak, never anything else living in .heimdall/. Fail-open
    # throughout: a missing AC_DIR, a `find` that errors, anything — silently
    # swallowed, since this must never be able to affect a render, only tidy
    # up after one.
    _ac_sweep_stale() {
      local marker="$AC_DIR/.cache-sweep-marker" now_ns marker_ns every_ns
      now_ns="$(_ac_now_ns)"
      case "$now_ns" in ''|*[!0-9]*) now_ns=0 ;; esac
      every_ns=$(( CACHE_SWEEP_EVERY * 1000000000 ))
      if [ -f "$marker" ]; then
        marker_ns="$(_ac_mtime_ns "$marker")"
        case "$marker_ns" in ''|*[!0-9]*) marker_ns=0 ;; esac
        [ $(( now_ns - marker_ns )) -lt "$every_ns" ] && return 0
      fi
      : >"$marker" 2>/dev/null || return 0
      find "$AC_DIR" -maxdepth 1 \
        \( -name '.agents-count-cache.*.tmp' -o -name '.wall-cache.json.*.tmp' -o -name '.roster-cache*.tmp' \) \
        -mmin +2 -delete 2>/dev/null
      return 0
    }
    TO=""
    command -v timeout  >/dev/null 2>&1 && TO="timeout $AGENTS_COUNT_CEIL"
    [ -z "$TO" ] && command -v gtimeout >/dev/null 2>&1 && TO="gtimeout $AGENTS_COUNT_CEIL"
    if [ -n "$TO" ]; then
      # GNU timeout's default behavior (i.e. WITHOUT --foreground) already
      # runs the monitored command in its own process group and signals that
      # whole group on expiry, so it already reaches count's pgrep/lsof
      # grandchildren the same as the perl branch below — never add
      # --foreground here, that opts back into the single-process signalling
      # this whole fix removes (see the DEATH-SPIRAL POSTMORTEM above).
      ( HMD_AGENT_CWD="$AC_CWD" _ac_refresh $TO "$AGENTS_BIN" count; _ac_sweep_stale ) >/dev/null 2>&1 </dev/null &
    elif command -v perl >/dev/null 2>&1; then
      # This machine's stand-in for timeout(1)/gtimeout (this repo's dev Mac
      # ships neither). Unlike the old `alarm 1; exec @ARGV` one-liner —
      # whose single-PID SIGALRM left count's own pgrep/lsof grandchildren
      # orphaned and running past the ceiling (see the DEATH-SPIRAL
      # POSTMORTEM above) — this forks, makes the CHILD its own
      # process-group leader before it execs into "$AGENTS_BIN" count, and on
      # ALRM signals that whole group: TERM, a 0.3s grace period, then KILL
      # for anything that ignored TERM. Every subshell count forks inherits
      # that same group (nothing it does changes its own pgid), so nothing in
      # that tree can outlive the ceiling. The ceiling arrives as argv[0]
      # (shifted off before the real command runs), not baked into the
      # script, so HMD_AGENTS_COUNT_CEIL controls it exactly like the
      # timeout/gtimeout branch above.
      ( HMD_AGENT_CWD="$AC_CWD" _ac_refresh perl -e '
          $ceil = shift @ARGV;
          $SIG{ALRM} = sub {
            kill TERM => -$pid;
            select undef, undef, undef, 0.3;
            kill KILL => -$pid;
            exit 124;
          };
          $pid = fork;
          if (!$pid) { setpgrp(0, 0); exec @ARGV; exit 127 }
          alarm $ceil;
          waitpid $pid, 0;
          exit $? >> 8;
        ' "$AGENTS_COUNT_CEIL" "$AGENTS_BIN" count; _ac_sweep_stale ) >/dev/null 2>&1 </dev/null &
    else
      ( HMD_AGENT_CWD="$AC_CWD" _ac_refresh "$AGENTS_BIN" count; _ac_sweep_stale ) >/dev/null 2>&1 </dev/null &
    fi
    disown 2>/dev/null || true
  fi
fi
case "$HMD_LIVE_SUBAGENTS" in ''|*[!0-9]*) HMD_LIVE_SUBAGENTS="" ;; esac
export HMD_LIVE_SUBAGENTS

# ── Host-boundary corrections: Cursor label, render_width_chars, CTX honesty ──
# Three corrections to the host's payload used to run HERE as three separate python
# launches wrapped around the watchman: the Cursor host-label normalizer (a blank
# model.display_name on a Cursor-shaped payload -> "Cursor", not the watchman's "Claude"
# default), the render_width_chars probe (above), and the CTX-honesty post-process of
# the rendered rows (a null/absent used_percentage must never render as "CTX 0%").
# All three are the watchman's job now, in the interpreter it launches anyway, switched
# on by the one flag passed below. The reasoning for each (why the boundary and not the
# gauge, why the Cursor keys are probed as raw substrings, the reserve precedence) moved
# with the code: sentinels/hmd-statusline.py — resolve_cols, _apply_host_boundary and
# _ctx_unavailable_row — and test/heimdall-statusline-host-boundary.test.sh pins both
# halves (flag on: corrected; flag off: the legacy renderer other suites rely on).
# Output through this wrapper is byte-identical to the three-launch version
# (heimdall-statusline-cursor-payload / -parity / -density / -fullbleed).

# ── PRIMARY: the full-width watchman ──
# Capture first; emit only on success (nonempty). Any failure falls through.
WM=""
if [ -n "$PY3" ] && [ -f "$WATCHMAN" ]; then
  # hand the watchman the SAME color verdict the legacy fallback honors, so the
  # swarm block + HUD collapse to clean plain text in CI/pipes with no truecolor.
  WM="$(printf '%s' "$BLOB" | "$PY3" "$WATCHMAN" "$COLOR_FLAG" --host-boundary 2>/dev/null)"
  # Verify by use: $PY3 may be the cached path, trusted without a probe. An empty render
  # is the one moment worth finding out whether the interpreter is what broke — re-resolve
  # through hmd_python (probes, deletes a stale cache, names a working one) and retry ONCE,
  # and only when that names a DIFFERENT interpreter: if it names the same one, the
  # watchman itself is what failed and a second identical launch would only repeat it.
  if [ -z "$WM" ] && [ "$PY3_PROVEN" = 0 ] && type hmd_python >/dev/null 2>&1; then
    PY3_FRESH="$(hmd_python 2>/dev/null || true)"
    if [ -n "$PY3_FRESH" ]; then PY3_PROVEN=1; else PY3_FRESH="$(command -v python3 2>/dev/null || true)"; fi
    if [ -n "$PY3_FRESH" ] && [ "$PY3_FRESH" != "$PY3" ]; then
      PY3="$PY3_FRESH"
      WM="$(printf '%s' "$BLOB" | "$PY3" "$WATCHMAN" "$COLOR_FLAG" --host-boundary 2>/dev/null)"
    fi
  fi
  [ -z "$WM" ] || PY3_PROVEN=1
fi

# ── PUBLISH the context reading for the per-prompt meter (bin/heimdall-ctx-meter) ──
# Claude Code exposes context size in exactly ONE place: this statusLine stdin blob
# (context_window.total_input_tokens). No hook receives it — UserPromptSubmit sees only
# the prompt and the session id. So the BAR is the publisher: it hands the meter the
# SAME blob its own CTX% gauge reads, and the UserPromptSubmit hook reads what the meter
# stored. One parser of one field — a second estimator that could disagree with the
# number on screen would be worse than no meter at all.
#
# Why it matters (docs/analysis/token-spend-forensics.md): one session ran 15 days at a
# mean context of 501,000 tokens and cost $913.54 — 82.8% of a three-week $1,103 bill.
# Capping at ~150K provably recovers $369.50. Drift is invisible without this.
#
# Same never-error contract as the rest of the bar: hard time ceiling when one is
# available, output fully discarded, every failure path a no-op. Cursor's own schema
# (~/.cursor/skills-cursor/statusline/SKILL.md) DOES carry
# context_window.total_input_tokens too — documented there as an ESTIMATE derived from
# used_percentage rather than an exact API count — so this publish call is a REAL write
# under Cursor as well, not a no-op: it records that estimate under the Cursor
# session's own session_id. Records are keyed per session_id, so a Cursor estimate can
# never blend with or overwrite an exact Claude Code reading. The early-session window
# where Cursor's used_percentage (and by extension total_input_tokens) may be null is
# already covered by the SAME guard that protects a missing CC signal: publish already
# treats "no context signal" as "write nothing", never a fabricated 0.
#
# COST: this call used to be the single most expensive stage of a render — 362ms median
# idle (4 interpreter launches for a Cursor payload, 8 for a Claude Code one: every
# field re-validated the interpreter through `$(hmd_python)` and then parsed). It is now
# ONE parse, and the interpreter this render just proved is handed over through
# HMD_PYTHON (honoured without a probe). Runs after the render and before ANY exit below
# — the record is on disk when this process ends, which test/heimdall-statusline-
# parity.test.sh and test/ctx-meter.test.sh both read the instant it does. An
# interpreter that is not proven (no render succeeded, nothing probed) is NOT forced on
# the meter: it resolves for itself, as it always did.
CTX_METER="$HERE/heimdall-ctx-meter"
if [ -n "$BLOB" ] && [ -x "$CTX_METER" ]; then
  CTO=""
  command -v timeout  >/dev/null 2>&1 && CTO="timeout 2"
  [ -z "$CTO" ] && command -v gtimeout >/dev/null 2>&1 && CTO="gtimeout 2"
  if [ "$PY3_PROVEN" = 1 ] && [ -n "$PY3" ]; then
    printf '%s' "$BLOB" | HMD_PYTHON="$PY3" $CTO "$CTX_METER" publish >/dev/null 2>&1 || true
  else
    printf '%s' "$BLOB" | $CTO "$CTX_METER" publish >/dev/null 2>&1 || true
  fi
fi

# The watchman produced a render (with the host-boundary corrections already applied):
# emit it. Anything else falls through to the legacy fallbacks below.
if [ -n "$WM" ]; then
  printf '%s\n' "$WM"
  exit 0
fi

# ── FALLBACK: legacy single-line instrument ──
# Re-resolve project + token burn from the blob we already slurped (python cannot
# re-read the stdin the watchman attempt consumed). Tolerant: any miss → safe
# defaults. Echoes "PROJECT BURN EXCEEDS".
resolve_signals() {
  local blob="$1"
  [ -n "$blob" ] || { echo ". - 0"; return; }
  if [ -n "$PY3" ]; then
    printf '%s' "$blob" | "$PY3" -c '
import json, os, sys
try:
    b = json.load(sys.stdin)
except Exception:
    print(". - 0"); sys.exit(0)
if not isinstance(b, dict):
    print(". - 0"); sys.exit(0)
proj = "."
cands = [b.get("cwd"), b.get("project_dir")]
ws = b.get("workspace")
if isinstance(ws, dict):
    cands += [ws.get("current_dir"), ws.get("project_dir")]
for c in cands:
    if isinstance(c, str) and c and os.path.isdir(c):
        proj = c
        break
burn = "-"
exceeds = "1" if b.get("exceeds_200k_tokens") is True else "0"
cw = b.get("context_window")
if isinstance(cw, dict):
    used = cw.get("used_percentage")
    if isinstance(used, (int, float)):
        burn = repr(float(used))
    else:
        size = cw.get("context_window_size")
        inp = cw.get("total_input_tokens")
        if isinstance(size, (int, float)) and size > 0 and isinstance(inp, (int, float)):
            burn = repr(max(0.0, min(100.0, (float(inp) / float(size)) * 100.0)))
print(proj, burn, exceeds)
' 2>/dev/null && return
  fi
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$blob" | jq -r '
      ((.cwd // .workspace.current_dir // .project_dir // .workspace.project_dir // ".")) as $p
      | ((.context_window.used_percentage) // "-") as $burn
      | (if .exceeds_200k_tokens == true then "1" else "0" end) as $ex
      | "\($p) \($burn) \($ex)"
    ' 2>/dev/null && return
  fi
  echo ". - 0"
}

PROJECT="."
BURN="-"
EXCEEDS="0"
if [ -n "${1:-}" ]; then
  PROJECT="$1"
else
  read -r PROJECT BURN EXCEEDS <<<"$(resolve_signals "$BLOB")"
fi
[ -n "$PROJECT" ] && [ -d "$PROJECT" ] || PROJECT="."

if [ -x "$FACE_BIN" ] && [ -n "$PY3" ]; then
  ARGS=(--statusline "$COLOR_FLAG")
  case "$BURN" in
    ''|'-'|'null') : ;;
    *) ARGS+=(--burn "$BURN") ;;
  esac
  [ "$EXCEEDS" = "1" ] && ARGS+=(--exceeds)
  ARGS+=("$PROJECT")
  LINE="$("$PY3" "$FACE_BIN" "${ARGS[@]}" </dev/null 2>/dev/null | head -n1)"
  if [ -n "$LINE" ]; then
    printf '%s\n' "$LINE"
    exit 0
  fi
fi

# ── Degraded floor: even the legacy bin is unavailable → idle watchman eyes, then
# plain text. Never blank, never an error. ──
if [ -x "$FACE_BIN" ] && [ -n "$PY3" ]; then
  EYES="$("$PY3" "$FACE_BIN" --eyes "$COLOR_FLAG" "$PROJECT" </dev/null 2>/dev/null | head -n1)"
  [ -n "$EYES" ] && { printf '%s\n' "$EYES"; exit 0; }
fi
printf '[ heimdall ]\n'
exit 0
