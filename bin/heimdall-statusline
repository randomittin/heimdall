#!/usr/bin/env bash
# heimdall-statusline — CLI-AGNOSTIC statusline renderer, the ONE source of truth.
#
# This is what actually renders the HUD. Two callers wrap it, byte-identical output
# from both because both just `exec` straight into this file:
#   - hooks/statusline.sh                      Claude Code's registered `statusLine`
#                                               command (stdin JSON, width via the
#                                               $COLUMNS env var).
#   - bin/heimdall-statusline-register-cursor   wires Cursor CLI's `statusLine` in
#                                               ~/.cursor/cli-config.json to THIS
#                                               path directly (stdin JSON, width via
#                                               a `render_width_chars` JSON field
#                                               instead — Cursor spawns with no shell
#                                               and no tty on our stdout either, so
#                                               ~/.cursor/skills-cursor/statusline/
#                                               SKILL.md documents that field as the
#                                               one true width signal for that host).
# Also directly callable by hand from any shell, any AI CLI or none at all:
# `hmd status` (bin/heimdall's `status)` arm execs straight here too), or just run
# this file. test/heimdall-statusline-parity.test.sh locks the "one source of
# truth" property — it fails the moment the two wrapped paths disagree on a byte.
#
# PRIMARY: the full-width watchman (sentinels/hmd-statusline.py) — 4 rows, sigil
#   anchor left, gate verdict pinned right, team watch wall on the bottom rows.
#   It reads the stdin JSON itself; we pipe stdin straight through and hand it
#   COLUMNS so the right-pinned verdict aligns. Zero model — it works from local
#   ledger state (.heimdall/statusline.json, .heimdall/.roster-cache.json).
# FALLBACK: the legacy single-line instrument (bin/heimdall-face --statusline),
#   used iff python3 is unavailable, the watchman script is missing, or it exits
#   nonzero/empty. The bar must NEVER error, NEVER block, NEVER print prose.
#
# Never-error contract: the watchman output is captured to a var FIRST; we emit
# the fallback only after confirming the primary produced nothing usable. Every
# branch ends in `exit 0`.

HERE="$(cd "$(dirname "$0")" && pwd)"
WATCHMAN="$HERE/../sentinels/hmd-statusline.py"
FACE_BIN="$HERE/heimdall-face"

# ── FAST python3 — resolved ONCE, before any subprocess below ───────────────────
# MEASURED (this machine): bare `python3` resolves through a pyenv shim
# (~/.pyenv/shims/python3 execs `pyenv exec python3`, a version-resolution
# dispatcher) at ~400-450ms/launch — against a DIRECT, non-shim python3 at
# ~30-70ms. This render path launches python3 up to 4 times (the render-width
# probe, the watchman, the Cursor host-label normalizer, the CTX-honesty
# post-process) and hands heimdall-ctx-meter up to 3 more internal launches — at
# ~400ms each that tax alone accounts for essentially the ENTIRE regression: the
# watchman alone measured 2.29s real through the shim vs 0.75s cold / 0.11s warm
# via a direct interpreter, BYTE-IDENTICAL output (diff confirmed) either way.
#
# bin/lib/hmd-python.sh (the same library heimdall-ctx-meter already uses)
# resolves the real interpreter ONCE into $PY3; every call site below uses that
# variable instead of a bare `python3`. Deliberately NOT a PATH mutation —
# prepending a real bin/ directory ahead of a caller's own PATH previously
# unshadowed test/heimdall-maintain-loop.test.sh's fake gh/git fixtures. A
# resolved variable touches nothing outside this process.
# DEGRADES SAFELY: hmd_python prints nothing when no working interpreter
# exists anywhere (missing lib, no python3 at all, or a broken macOS CLT
# stub), which is exactly the "python3 unavailable" signal every jq/legacy
# fallback below already handled — same contract as the old
# `command -v python3` guard, just resolved once instead of probed per call.
PY3=""
# shellcheck source=lib/hmd-python.sh
[ -r "$HERE/lib/hmd-python.sh" ] && . "$HERE/lib/hmd-python.sh"
if type hmd_python >/dev/null 2>&1; then PY3="$(hmd_python 2>/dev/null || true)"; fi
[ -n "$PY3" ] || PY3="$(command -v python3 2>/dev/null || true)"

# ── Slurp the caller's statusLine stdin blob ONCE so both the watchman and the
# fallback signal-resolver can read it (stdin is consumable only once).
#
# A REAL controlling tty on stdin (nothing piped — a bare interactive `hmd status`
# at a prompt) is not "no data", it is "no host JSON, render from local state" — so
# it gets a valid empty JSON object, which the watchman's own null-safe contract
# already turns into the full multi-row HUD (gates/team read straight off the
# ledger; model/cost/context/rate-limit fields degrade gracefully since they're
# independently optional). A genuine empty PIPE (a harness deliberately piping
# nothing, e.g. CI) is left as an empty string, which is the existing, tested
# malformed/empty-input contract: fall through to the branded ⛭ HEIMDALL floor.
BLOB=""
if [ -t 0 ]; then
  BLOB="{}"
else
  BLOB="$(cat 2>/dev/null)"
fi

# ── Width. The watchman right-pins the verdict against COLUMNS, so whoever's
# widest, truest signal wins, in this order:
#   1. `render_width_chars` in the stdin JSON (Cursor CLI ONLY — Claude Code's schema
#      never sends this key, so its mere presence identifies the host). Cursor's own
#      docs name THIS field, not $COLUMNS, as the authoritative width, and it ALWAYS
#      wins over $COLUMNS when present: a no-shell `child_process.spawn` child still
#      inherits $COLUMNS from Cursor's own launching terminal by default (no explicit
#      `env` option strips it), and that inherited value can be STALE — no longer the
#      live width — while render_width_chars is computed fresh on every invocation.
#      Trusting a stale $COLUMNS over a fresh, authoritative JSON field would silently
#      render at the WRONG width. Because Cursor already subtracted its own padding,
#      we must NOT also apply Claude Code's separate (undocumented,
#      empirically-measured) 4-cell region reserve on top of a width that was already
#      corrected once — so when width comes from this field we pin
#      HMD_STATUSLINE_RESERVE=0 (unless the caller already set that override
#      themselves).
#   2. $COLUMNS already exported by the caller (Claude Code sets this itself; this is
#      Claude Code's ONLY width signal — its payload never carries render_width_chars,
#      so step 1 never fires and this step is unconditionally reached, unchanged from
#      before this reordering).
#   3. `tput cols` (a real terminal reachable on our own stdout — the bare
#      manual-invocation case).
#   4. 120, the long-standing safe default.
resolve_render_width() {  # $1=blob -> prints digits, or nothing
  local blob="$1"
  [ -n "$blob" ] || return 0
  if [ -n "$PY3" ]; then
    printf '%s' "$blob" | "$PY3" -c '
import json, sys
try:
    b = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(b, dict):
    sys.exit(0)
w = b.get("render_width_chars")
if isinstance(w, (int, float)) and not isinstance(w, bool) and w > 0:
    print(int(w))
' 2>/dev/null
    return 0
  fi
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$blob" | jq -r '
      if (.render_width_chars? // empty) != "" and (.render_width_chars | type) == "number"
      then (.render_width_chars | floor) else empty end
    ' 2>/dev/null
  fi
}

COLS="${COLUMNS:-}"
case "$COLS" in ''|*[!0-9]*) COLS="" ;; esac
# Cheap, dependency-free substring probe for the Cursor-only render_width_chars key —
# skips the python3/jq subprocess entirely on Claude Code's hot per-prompt path (that
# key is never in a CC payload, so this case pattern never matches there), while still
# catching every real Cursor payload so its authoritative width can override a possibly
# stale inherited $COLUMNS (see the priority comment above). A blob that merely
# CONTAINS the literal substring in some unrelated string value still degrades safely:
# resolve_render_width re-parses as JSON and only trusts an actual top-level numeric
# render_width_chars key, so a false-positive substring match costs one wasted
# subprocess call, never a wrong width.
case "$BLOB" in
  *'"render_width_chars"'*)
    RENDER_WIDTH="$(resolve_render_width "$BLOB")"
    case "$RENDER_WIDTH" in ''|*[!0-9]*) RENDER_WIDTH="" ;; esac
    if [ -n "$RENDER_WIDTH" ]; then
      COLS="$RENDER_WIDTH"
      [ -n "${HMD_STATUSLINE_RESERVE:-}" ] || export HMD_STATUSLINE_RESERVE=0
    fi
    ;;
esac
case "$COLS" in ''|*[!0-9]*) COLS="$(tput cols 2>/dev/null)" ;; esac
case "$COLS" in ''|*[!0-9]*) COLS=120 ;; esac
export COLUMNS="$COLS"

# ── Color detection (legacy fallback honors it via --color/--no-color) ──
if [[ "${COLORTERM:-}" == "truecolor" || "${COLORTERM:-}" == "24bit" || "${TERM:-}" == *256color* ]]; then
  COLOR_FLAG="--color"
elif [ -t 1 ] || [ -n "${TERM:-}" ]; then
  COLOR_FLAG="--color"
else
  COLOR_FLAG="--no-color"
fi

# ── PUBLISH the context reading for the per-prompt meter (bin/heimdall-ctx-meter) ──
# Claude Code exposes context size in exactly ONE place: this statusLine stdin blob
# (context_window.total_input_tokens). No hook receives it — UserPromptSubmit sees only
# the prompt and the session id. So the BAR is the publisher: it hands the meter the
# SAME blob its own CTX% gauge reads, and the UserPromptSubmit hook reads what the meter
# stored. One parser of one field — a second estimator that could disagree with the
# number on screen would be worse than no meter at all.
#
# Why it matters (docs/analysis/token-spend-forensics.md): one session ran 15 days at a
# mean context of 501,000 tokens and cost $913.54 — 82.8% of a three-week $1,103 bill.
# Capping at ~150K provably recovers $369.50. Drift is invisible without this.
#
# Same never-error contract as the rest of the bar: hard time ceiling when one is
# available, output fully discarded, every failure path a no-op. Cursor's own schema
# (~/.cursor/skills-cursor/statusline/SKILL.md) DOES carry
# context_window.total_input_tokens too — documented there as an ESTIMATE derived from
# used_percentage rather than an exact API count — so this publish call is a REAL write
# under Cursor as well, not a no-op: it records that estimate under the Cursor
# session's own session_id. Records are keyed per session_id, so a Cursor estimate can
# never blend with or overwrite an exact Claude Code reading. The early-session window
# where Cursor's used_percentage (and by extension total_input_tokens) may be null is
# already covered by the SAME guard that protects a missing CC signal: publish already
# treats "no context signal" as "write nothing", never a fabricated 0.
CTX_METER="$HERE/heimdall-ctx-meter"
if [ -n "$BLOB" ] && [ -x "$CTX_METER" ]; then
  CTO=""
  command -v timeout  >/dev/null 2>&1 && CTO="timeout 2"
  [ -z "$CTO" ] && command -v gtimeout >/dev/null 2>&1 && CTO="gtimeout 2"
  printf '%s' "$BLOB" | $CTO "$CTX_METER" publish >/dev/null 2>&1 || true
fi

# ── LIVE harness-subagent count (reconciled: stale/failed/reaped EXCLUDED) ──────
# Claude Code Agent-tool subagents (hmd:coder &c.) are owned by the harness and
# never enter agent-pool, so a dead/hung one would keep inflating any raw count.
# bin/heimdall-agents enumerates them from the harness task dir and returns ONLY
# the live ones; we publish that as HMD_LIVE_SUBAGENTS so the HUD's agent segment
# reflects the honest live count. This is heimdall's OWN view — it does NOT (cannot)
# touch Claude Code's FleetView, and under a non-Claude-Code host there simply is no
# harness task dir to enumerate, so this degrades to 0 exactly like any other
# missing-signal field. Kept cheap + fail-safe: a fast stat-only read, hard 1s
# ceiling, any error → 0. The bar must never block or error on this signal.
HMD_LIVE_SUBAGENTS=0
AGENTS_BIN=""
if command -v heimdall-agents >/dev/null 2>&1; then AGENTS_BIN="heimdall-agents"
elif [ -x "$HERE/heimdall-agents" ]; then AGENTS_BIN="$HERE/heimdall-agents"; fi
if [ -n "$AGENTS_BIN" ]; then
  # A hard time ceiling when a `timeout` (or macOS `gtimeout`) is available; else run
  # bare — the count is already a stat-only read, so it stays sub-second regardless.
  TO=""
  command -v timeout  >/dev/null 2>&1 && TO="timeout 1"
  [ -z "$TO" ] && command -v gtimeout >/dev/null 2>&1 && TO="gtimeout 1"
  # macOS ships NEITHER timeout(1) NOR gtimeout, so both probes above miss and the
  # "hard ceiling" silently became a no-op. Measured consequence: `count` parses every
  # harness transcript in the session task dir (73 files / 31MB here) at a steady
  # 1.38-1.42s, which alone exceeds the bar's whole 1000ms budget. The comment that
  # used to sit here -- "the count is already a stat-only read, so it stays sub-second
  # regardless" -- was false, and being false is why the dead guard went unnoticed.
  # perl is this repo's documented stand-in (AGENTS.md); alarm() takes whole seconds,
  # so 1 is the floor. Single-quoted so the shell cannot split the `;`.
  if [ -n "$TO" ]; then
    HMD_LIVE_SUBAGENTS="$(HMD_AGENT_CWD="$PWD" $TO "$AGENTS_BIN" count 2>/dev/null || true)"
  elif command -v perl >/dev/null 2>&1; then
    HMD_LIVE_SUBAGENTS="$(HMD_AGENT_CWD="$PWD" perl -e 'alarm 1; exec @ARGV' -- "$AGENTS_BIN" count 2>/dev/null || true)"
  else
    HMD_LIVE_SUBAGENTS="$(HMD_AGENT_CWD="$PWD" "$AGENTS_BIN" count 2>/dev/null || true)"
  fi
fi
case "$HMD_LIVE_SUBAGENTS" in ''|*[!0-9]*) HMD_LIVE_SUBAGENTS=0 ;; esac
export HMD_LIVE_SUBAGENTS

# ── Cursor host-label normalization ──
# sentinels/hmd-statusline.py's own model.display_name fallback (when the field is
# absent/null/empty) defaults to the literal string "Claude" — a holdover from when
# Claude Code was this bar's only host. Real captured Cursor CLI traffic always
# carried a populated model.display_name (e.g. "Auto"), so this is an edge case, not
# the common path — but SKILL.md does not list model.display_name under "may be
# absent", so a future/early-frame Cursor payload that omits it would silently
# misattribute the session to Claude. `transcript_path`/`autorun` are Cursor-exclusive
# keys (SKILL.md; never present in Claude Code's statusLine schema — confirmed against
# test/heimdall-statusline-parity.test.sh's canned() fixture), so this probe costs
# Claude Code's hot path nothing: the case pattern never matches there and the whole
# block is skipped. Only rewrites $BLOB when display_name is genuinely missing — the
# common case (already populated) prints nothing and leaves $BLOB byte-identical.
case "$BLOB" in
  *'"transcript_path"'*|*'"autorun"'*)
    NORMALIZED=""
    if [ -n "$PY3" ]; then
      NORMALIZED="$(printf '%s' "$BLOB" | "$PY3" -c '
import json, sys
try:
    b = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(b, dict):
    sys.exit(0)
m = b.get("model")
if not isinstance(m, dict):
    m = {}
if not (m.get("display_name") or "").strip():
    m["display_name"] = "Cursor"
    b["model"] = m
    print(json.dumps(b))
' 2>/dev/null)"
    fi
    if [ -z "$NORMALIZED" ] && command -v jq >/dev/null 2>&1; then
      NORMALIZED="$(printf '%s' "$BLOB" | jq -c '
        if ((.model.display_name // "") | length) == 0
        then .model = ((.model // {}) + {display_name: "Cursor"})
        else empty end
      ' 2>/dev/null)"
    fi
    [ -n "$NORMALIZED" ] && BLOB="$NORMALIZED"
    ;;
esac

# ── PRIMARY: the full-width watchman ──
# Capture first; emit only on success (nonempty). Any failure falls through.
if [ -n "$PY3" ] && [ -f "$WATCHMAN" ]; then
  # hand the watchman the SAME color verdict the legacy fallback honors, so the
  # swarm block + HUD collapse to clean plain text in CI/pipes with no truecolor.
  WM="$(printf '%s' "$BLOB" | "$PY3" "$WATCHMAN" "$COLOR_FLAG" 2>/dev/null)"
  if [ -n "$WM" ]; then
    # ── CTX HONESTY: null/absent used_percentage must never render as "CTX 0%" ──
    # sentinels/hmd-statusline.py:1828 and sentinels/hmd_gauge.py:311 both
    # unconditionally coerce a missing used_percentage to 0.0 before the gauge ever
    # sees it -- there is no "unavailable" branch in render_gauge() (unlike this
    # same renderer's OWN render_micro_gauge()/micro_text(), which already treats
    # pct=None as "bare label, never a fabricated 0%" -- hmd_gauge.py:356-443).
    # That function is out of this file's scope to edit, so the boundary corrects
    # the ALREADY-RENDERED row instead: this is the ONE row on the whole HUD driven
    # by used_percentage, so once we know from the pre-render blob that the signal
    # was genuinely null/absent (never for a real reading, including a genuine 0),
    # we can find that exact row by its own literal "CTX" label and replace it --
    # never touching any other row, never re-deriving the gauge's own cell/gradient
    # model. The replacement reuses this SAME render's own already-chosen color for
    # the HUD's existing "unknown signal" idiom (the "– gates offline" / "◦ watching"
    # rows) so it never invents a new visual language, and it degrades to plain,
    # uncolored text under --no-color exactly like those sibling rows do.
    WM="$(printf '%s' "$WM" | HMD_CTX_BLOB="$BLOB" HMD_CTX_COLOR="$COLOR_FLAG" "$PY3" -c '
import json, os, re, sys

text = sys.stdin.read()
try:
    blob_raw = os.environ.get("HMD_CTX_BLOB", "")
    no_color = os.environ.get("HMD_CTX_COLOR", "") == "--no-color"
    unavailable = False
    b = json.loads(blob_raw) if blob_raw else {}
    if isinstance(b, dict):
        cw = b.get("context_window")
        if not isinstance(cw, dict):
            unavailable = True
        else:
            up = cw.get("used_percentage")
            if not isinstance(up, (int, float)) or isinstance(up, bool):
                unavailable = True
    if not unavailable:
        sys.stdout.write(text)
        sys.exit(0)

    ANSI = re.compile(r"\033\[[0-9;]*m")
    MARGIN = re.compile(r"^▄+")

    def raw_offset(line, target_idx):
        visible = 0
        i = 0
        n = len(line)
        while i < n:
            m = ANSI.match(line, i)
            if m:
                i = m.end()
                continue
            if visible == target_idx:
                return i
            visible += 1
            i += 1
        return len(line)

    style_open, style_close = "", ""
    if not no_color:
        style_re = re.compile(r"((?:\033\[[0-9;]*m)+)[–◦] ")
        for probe in text.split("\n"):
            m = style_re.search(probe)
            if m:
                style_open, style_close = m.group(1), "\033[0m"
                break
        if not style_open:
            style_open, style_close = "\033[2m", "\033[0m"

    out = []
    replaced = False
    for line in text.split("\n"):
        plain = ANSI.sub("", line)
        if not replaced:
            mm = MARGIN.match(plain)
            margin_len = mm.end() if mm else 0
            remainder = plain[margin_len:].lstrip()
            if remainder.startswith("CTX"):
                cut = raw_offset(line, margin_len)
                out.append(line[:cut] + " " + style_open + "– CTX unavailable" + style_close)
                replaced = True
                continue
        out.append(line)
    sys.stdout.write("\n".join(out))
except Exception:
    sys.stdout.write(text)
' 2>/dev/null || printf '%s' "$WM")"
    printf '%s\n' "$WM"
    exit 0
  fi
fi

# ── FALLBACK: legacy single-line instrument ──
# Re-resolve project + token burn from the blob we already slurped (python cannot
# re-read the stdin the watchman attempt consumed). Tolerant: any miss → safe
# defaults. Echoes "PROJECT BURN EXCEEDS".
resolve_signals() {
  local blob="$1"
  [ -n "$blob" ] || { echo ". - 0"; return; }
  if [ -n "$PY3" ]; then
    printf '%s' "$blob" | "$PY3" -c '
import json, os, sys
try:
    b = json.load(sys.stdin)
except Exception:
    print(". - 0"); sys.exit(0)
if not isinstance(b, dict):
    print(". - 0"); sys.exit(0)
proj = "."
cands = [b.get("cwd"), b.get("project_dir")]
ws = b.get("workspace")
if isinstance(ws, dict):
    cands += [ws.get("current_dir"), ws.get("project_dir")]
for c in cands:
    if isinstance(c, str) and c and os.path.isdir(c):
        proj = c
        break
burn = "-"
exceeds = "1" if b.get("exceeds_200k_tokens") is True else "0"
cw = b.get("context_window")
if isinstance(cw, dict):
    used = cw.get("used_percentage")
    if isinstance(used, (int, float)):
        burn = repr(float(used))
    else:
        size = cw.get("context_window_size")
        inp = cw.get("total_input_tokens")
        if isinstance(size, (int, float)) and size > 0 and isinstance(inp, (int, float)):
            burn = repr(max(0.0, min(100.0, (float(inp) / float(size)) * 100.0)))
print(proj, burn, exceeds)
' 2>/dev/null && return
  fi
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$blob" | jq -r '
      ((.cwd // .workspace.current_dir // .project_dir // .workspace.project_dir // ".")) as $p
      | ((.context_window.used_percentage) // "-") as $burn
      | (if .exceeds_200k_tokens == true then "1" else "0" end) as $ex
      | "\($p) \($burn) \($ex)"
    ' 2>/dev/null && return
  fi
  echo ". - 0"
}

PROJECT="."
BURN="-"
EXCEEDS="0"
if [ -n "${1:-}" ]; then
  PROJECT="$1"
else
  read -r PROJECT BURN EXCEEDS <<<"$(resolve_signals "$BLOB")"
fi
[ -n "$PROJECT" ] && [ -d "$PROJECT" ] || PROJECT="."

if [ -x "$FACE_BIN" ] && [ -n "$PY3" ]; then
  ARGS=(--statusline "$COLOR_FLAG")
  case "$BURN" in
    ''|'-'|'null') : ;;
    *) ARGS+=(--burn "$BURN") ;;
  esac
  [ "$EXCEEDS" = "1" ] && ARGS+=(--exceeds)
  ARGS+=("$PROJECT")
  LINE="$("$PY3" "$FACE_BIN" "${ARGS[@]}" </dev/null 2>/dev/null | head -n1)"
  if [ -n "$LINE" ]; then
    printf '%s\n' "$LINE"
    exit 0
  fi
fi

# ── Degraded floor: even the legacy bin is unavailable → idle watchman eyes, then
# plain text. Never blank, never an error. ──
if [ -x "$FACE_BIN" ] && [ -n "$PY3" ]; then
  EYES="$("$PY3" "$FACE_BIN" --eyes "$COLOR_FLAG" "$PROJECT" </dev/null 2>/dev/null | head -n1)"
  [ -n "$EYES" ] && { printf '%s\n' "$EYES"; exit 0; }
fi
printf '[ heimdall ]\n'
exit 0
