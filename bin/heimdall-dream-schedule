#!/usr/bin/env bash
# heimdall-dream-schedule — run /dream AUTOMATICALLY in the background, nightly.
#
# WHY THIS EXISTS
#   `/dream` (bin/heimdall-dream) is the overnight autoresearch + maintainer sweep that
#   leaves a MORNING REPORT. On-demand it is a manual `/dream`. This helper makes it
#   AUTO-BACKGROUND: it registers the overnight run with the platform-native scheduler
#   so it fires every night at 03:00 WITHOUT a live session and SURVIVES logout/reboot.
#
#   On macOS the platform scheduler is launchd — we do NOT invent a scheduler. We
#   register a per-user LaunchAgent `com.heimdall.dream` (no root: it lives in
#   ~/Library/LaunchAgents). launchd is restart-durable by construction: a
#   StartCalendarInterval fires at the next matching wall-clock minute, and if the box
#   was asleep/off at 03:00 launchd runs it at the next wake. The scheduled command is
#   the EXACT shadow-first, non-pushing overnight run:
#
#       heimdall-dream --repo <REPO> run --overnight
#
#   heimdall-dream already honors shadow-first + agent-never-pushes; this helper just
#   invokes it on a timer. stdout/stderr are appended to ~/.heimdall/logs/dream.log.
#
# COMMANDS
#   install   [--repo DIR] [--hour H] [--minute M]   register + load the nightly agent
#   uninstall [--repo DIR]                            unload + remove the agent (OFF switch)
#   status    [--repo DIR] [--json]                   is it installed / loaded? show cmd
#   run-now   [--repo DIR] [--json]                   fire the SAME overnight run once, now
#   -h | --help
#
# GUARANTEES
#   - IDEMPOTENT: the plist path is fixed (one file per label), so re-install overwrites
#     in place and unload-before-load means never two loaded copies — install twice ==
#     exactly ONE registered job.
#   - OFF SWITCH: `uninstall` unloads and removes the plist; a second uninstall is a
#     clean no-op. Nothing is left behind.
#   - SHADOW-FIRST / NEVER-PUSHES: inherited from heimdall-dream — this helper adds no
#     push/merge and passes no flag that would.
#
# TEST/PORTABILITY SEAMS (env overrides; all default to the real macOS values):
#   HEIMDALL_LAUNCH_AGENTS_DIR   plist dir      (default: $HOME/Library/LaunchAgents)
#   HEIMDALL_DREAM_LOG           log file       (default: $HOME/.heimdall/logs/dream.log)
#   LAUNCHCTL                    launchctl bin  (default: launchctl)
#   HEIMDALL_REAL_HOME           passwd home    (default: resolved from getpwuid)
#   HEIMDALL_DREAM_PYTHON        interpreter to pin (default: resolved — see resolve_python)
#   These let the acceptance suite prove install/idempotent/status/uninstall with a
#   shimmed launchctl and a tmp dir — no root, no real agent loaded.
#
# Exit status: 0 ok · 2 usage / unsupported platform · 3 runtime · 4 refused: synthetic
# HOME · 5 refused: ephemeral checkout · 6 refused: TCC-protected artifact path.
# The refusals are numbered DISTINCTLY on purpose — each one is a different operator
# action, and a code that collapses two causes is how a silent outage survives triage.

set -euo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
BINDIR="$(dirname "$SELF")"
DREAM="$BINDIR/heimdall-dream"

# ── Shared real-user detection (bin/lib/real-home.sh) ────────────────────────────
# This helper is THE choke point for LaunchAgent REGISTRATION: install.sh's
# ensure_dream_schedule and heimdall-autoupdate's reassert_dream_schedule both
# delegate here rather than calling launchctl themselves, so gating `install` gates
# every caller — including one that has not been written yet. The predicate lives in
# bin/lib/real-home.sh because bin/heimdall's uninstall side needs the SAME answer;
# two copies of a guard drift, and a drifted guard is an unguarded one.
# Sourced best-effort: an unreadable lib leaves heimdall_home_is_real undefined, and
# require_real_launchd_domain treats "undefined" exactly like "not the real user" —
# refuse. Fail safe at every unknown.
if [ -r "$BINDIR/lib/real-home.sh" ]; then
  # shellcheck disable=SC1091
  . "$BINDIR/lib/real-home.sh" 2>/dev/null || true
fi

# ── Shared TCC-protected-path predicate (bin/lib/tcc-paths.sh) ───────────────────
# The SAME question is asked from two directions and the two answers must never drift:
# here it gates the job's OWN ARTIFACTS (refuse to stage a reporter behind the locked
# door it reports on — exit 6 below), and in bin/heimdall-dream-permission it gates the
# REPO, which this guard deliberately exempts, to decide whether to ASK the operator for
# a grant. A drifted copy would let this register a job it privately knows cannot run
# while the ask never fires. Same reasoning that put real-home.sh in a lib, same
# best-effort sourcing: each consumer below refuses when the predicate is undefined.
if [ -r "$BINDIR/lib/tcc-paths.sh" ]; then
  # shellcheck disable=SC1091
  . "$BINDIR/lib/tcc-paths.sh" 2>/dev/null || true
fi

# The first-run permission ask. Lives beside this helper so `install` can hand the
# operator the one decision only he can make, at the moment he is standing there.
PERMISSION="$BINDIR/heimdall-dream-permission"

LABEL="com.heimdall.dream"
LA_DIR="${HEIMDALL_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
HEIMDALL_HOME="${HEIMDALL_HOME:-$HOME/.heimdall}"
LOG="${HEIMDALL_DREAM_LOG:-$HEIMDALL_HOME/logs/dream.log}"
LAUNCHCTL="${LAUNCHCTL:-launchctl}"
PLIST="$LA_DIR/$LABEL.plist"

# ── WHERE THE SCHEDULED PROGRAM LIVES, AND WHY IT IS NOT IN THE REPO ─────────────
#
# ProgramArguments[0] used to be <repo>/bin/heimdall-dream. On a machine whose repo sits
# under a TCC-protected folder (~/Downloads, ~/Documents, ~/Desktop) that is unrunnable:
# a LaunchAgent holds no TCC grant, so launchd could not even OPEN the script. The job
# died on its first syscall — `can't open file ...: [Errno 1] Operation not permitted` —
# for ten consecutive nights, and because the program itself was inside the denied tree
# there was no code of ours left running to notice or report it. The failure had no
# reporter because the reporter was behind the same locked door.
#
# So the scheduled program is now a small runner INSTALLED OUTSIDE the repo, under
# $HEIMDALL_HOME (~/.heimdall — not a TCC-protected location; measured writable from a
# probe LaunchAgent while every read under ~/Downloads was denied). The runner always
# gets to run, probes the repo, and either execs the real dream or records a structured
# failure that bin/heimdall-dream-notice surfaces in the operator's next session.
#
# THIS DOES NOT DEFEAT TCC and does not pretend to — a denied repo is still denied, and
# that was measured rather than assumed: a probe LaunchAgent whose program was /bin/sh at
# a NON-protected path was refused every read under ~/Downloads exactly as the
# repo-resident script was. What the split buys is that the denial is DETECTED and
# REPORTED instead of vanishing into a log nobody reads.
#
# The dream bin and --repo are still both encoded in the plist, so the scheduled argv
# stays readable and the ephemeral-checkout guards below still gate both pinned paths.
RUNNER_SRC="$BINDIR/heimdall-dream-runner"
RUNNER_DIR="$HEIMDALL_HOME/bin"
RUNNER="$RUNNER_DIR/heimdall-dream-runner"

# hmd-dream: a PRIVATE, ad-hoc-signed copy of bash, built fresh into $RUNNER_DIR by
# heimdall-dream-bundle. Its only purpose is a narrower TCC identity for
# ProgramArguments[0] than the shared system /bin/bash — see resolve_interpreter below.
# Always a GENERATED artifact, never a user-owned file, so uninstall always removes it
# outright (no same_physical_file guard needed, unlike the runner/liveness copies below).
BUNDLE_SRC="$BINDIR/heimdall-dream-bundle"
BUNDLE_APP="$RUNNER_DIR/hmd-dream.app"
BUNDLE_EXEC="$BUNDLE_APP/Contents/MacOS/hmd-dream"
IDENT_FILE="$HEIMDALL_HOME/dream-identity.json"

# The liveness receipt writer is staged beside the runner for the SAME reason the runner
# is staged at all: it must be reachable on the night the repo is not. Left in the repo it
# could only record a receipt when nothing was wrong, which is precisely the failure mode
# the receipt exists to end.
LIVENESS_SRC="$BINDIR/heimdall-liveness"
LIVENESS="$RUNNER_DIR/heimdall-liveness"

usage() { sed -n '2,40p' "$SELF" | sed 's/^# \{0,1\}//'; }
die()   { echo "error: $*" >&2; exit 3; }

# ── arg parse (shared across subcommands) ────────────────────────────────────────
REPO=""
HOUR=3
MINUTE=0
JSON=0
parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)   REPO="${2:-}"; shift 2 ;;
      --hour)   HOUR="${2:-}"; shift 2 ;;
      --minute) MINUTE="${2:-}"; shift 2 ;;
      --json)   JSON=1; shift ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  if [ -z "$REPO" ]; then
    REPO="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  fi
  # absolutize the repo path so the plist is location-independent.
  REPO="$(cd "$REPO" 2>/dev/null && pwd)" || die "repo not a directory: $REPO"
  case "$HOUR"   in ''|*[!0-9]*) die "bad --hour: $HOUR" ;; esac
  case "$MINUTE" in ''|*[!0-9]*) die "bad --minute: $MINUTE" ;; esac
}

# XML-escape a path for embedding in the plist (paths may hold & < > ' ").
xml_escape() {
  local s="$1"
  s="${s//&/&amp;}"; s="${s//</&lt;}"; s="${s//>/&gt;}"
  s="${s//\"/&quot;}"; s="${s//\'/&apos;}"
  printf '%s' "$s"
}

is_macos() { [ "$(uname -s)" = "Darwin" ]; }

# same_physical_file <a> <b> — TRUE when both names resolve to the SAME path.
#
# WHY THIS EXISTS. `cp X X` is not a no-op on macOS: it prints "are identical (not
# copied)" and EXITS 1. install_runner treated that as a staging failure and died, so the
# helper exited 3 and install.sh rendered the state word 'skipped' — meaning EVERY default
# `curl | bash` install registered no nightly dream at all, silently. The default layout
# puts the plugin tree at $HOME/.heimdall and defaults $HEIMDALL_HOME to the same path, so
# the runner's source and its staging destination are one file. Asking the question
# directly is the fix; letting `cp` answer it with an exit code is what broke.
#
# IT REFUSES RATHER THAN GUESS. heimdall_absolute_physical comes from bin/lib/tcc-paths.sh,
# which is sourced best-effort. Answering "different files" without it would send the
# default layout back through `cp X X` — the exact path that made every stranger's install
# register no nightly dream and say nothing. A missing predicate is a broken tree, so it
# fails loudly here instead of producing a wrong answer quietly.
same_physical_file() {
  local a b
  type heimdall_absolute_physical >/dev/null 2>&1 \
    || die "bin/lib/tcc-paths.sh did not load — cannot resolve $1 against $2"
  a="$(heimdall_absolute_physical "${1:-}")" || return 1
  b="$(heimdall_absolute_physical "${2:-}")" || return 1
  [ "$a" = "$b" ]
}

# ── Modes are SET, never INHERITED ───────────────────────────────────────────────
#
# `mkdir -p` and `chmod +x` take their bits from the caller's umask. Under `umask 000`
# that yields a 0777 WORLD-WRITABLE executable which the user's launchd then runs every
# night — any local process could rewrite it between runs. An installer cannot choose its
# caller's umask, so it must state the mode it needs.
#
# 0700 for directories: $HEIMDALL_HOME holds pki/, signing/, team.json and cp-endpoint.json.
# Nothing under it is for group or other, and the directory bit is the boundary that makes
# every file mode inside it moot for anyone but the owner.
ensure_private_dir() {
  local d="${1:-}"
  [ -n "$d" ] || die "ensure_private_dir: empty path"
  mkdir -p "$d" || die "cannot create $d"
  chmod 0700 "$d" || die "cannot set mode 0700 on $d"
}

# ── The launchd-reachability guard (exit 6) ──────────────────────────────────────
#
# THE RUNNER EXISTS TO SURVIVE A TCC DENIAL AND REPORT IT. Staging it inside a protected
# folder puts the reporter behind the same locked door as the thing it reports on, which
# is exactly the shape of the ten-night silence: the job died on its first syscall and no
# code of ours was left running to notice. A LaunchAgent carries no TCC grant, so a
# program, a log, or a plist under ~/Downloads, ~/Documents or ~/Desktop is unreachable at
# 03:00 no matter how correct everything else is.
#
# THE REPO IS DELIBERATELY EXEMPT. A protected repo is the case the runner's probe already
# handles by failing loudly and writing a structured status (commit 245ede5). This guard
# covers only the paths the job needs IN ORDER TO report that — its program, its output,
# and its registration. Guarding the repo too would refuse the very machine the loud-
# failure path was built for.
#
# BOTH HOMES ARE CHECKED. $HOME may be synthetic while the artifact path is written in
# terms of the real user's home (or the reverse), so the passwd home is consulted as well.
# The predicate itself is heimdall_tcc_protected_root, from bin/lib/tcc-paths.sh — see
# the sourcing note at the top of this file for why it is shared rather than local.
refuse_unreachable() {
  local what="$1" path="$2" prot="$3"
  echo "not scheduled $PLIST (TCC-protected artifact path — the job could not report its own failure)" >&2
  echo "  $what is inside $prot, a folder macOS TCC protects: $path" >&2
  echo "  A LaunchAgent holds no TCC grant, so at 03:00 this path is unreadable and the" >&2
  echo "  job dies before it can say why — the exact silent failure this runner exists to" >&2
  echo "  prevent. Point HEIMDALL_HOME at a non-protected directory (the default," >&2
  echo "  \$HOME/.heimdall, is measured reachable from a LaunchAgent). Nothing was written." >&2
  exit 6
}

# Gated BEFORE any write, so a refusal leaves no plist, no staged runner, and issues no
# launchctl verb — the same total-refusal contract exits 4 and 5 already hold to.
require_reachable_artifacts() {
  local prot logdir
  # Fail safe on an undefined predicate, exactly as require_durable_pinned_paths does:
  # "cannot tell whether the job can reach its own artifacts" must never read as "yes".
  if ! type heimdall_tcc_protected_root >/dev/null 2>&1; then
    echo "not scheduled $PLIST (cannot verify the job's artifacts are reachable)" >&2
    echo "  bin/lib/tcc-paths.sh did not load, so the protected-path predicate is" >&2
    echo "  unavailable and this refuses rather than guess. Nothing was written." >&2
    exit 6
  fi
  if prot="$(heimdall_tcc_protected_root "$RUNNER_DIR")"; then
    refuse_unreachable "the scheduled program's directory" "$RUNNER_DIR" "$prot"
  fi
  logdir="$(dirname "$LOG")"
  if prot="$(heimdall_tcc_protected_root "$logdir")"; then
    refuse_unreachable "the job's log directory" "$logdir" "$prot"
  fi
  if prot="$(heimdall_tcc_protected_root "$LA_DIR")"; then
    refuse_unreachable "the LaunchAgents directory" "$LA_DIR" "$prot"
  fi
  return 0
}

# ── The interpreter is RESOLVED at install time, not guessed at 03:00 ────────────
#
# bin/heimdall-dream is `#!/usr/bin/env python3`, and `env` resolves through $PATH. A
# LaunchAgent with no PATH key gets /usr/bin:/bin:/usr/sbin:/sbin, which is a DIFFERENT
# search path than any interactive shell. Measured on the machine this was written for,
# three interpreters answer to the name python3:
#     /usr/bin/python3            3.9.6    ← what the launchd PATH finds
#     ~/.pyenv/shims/python3      3.11.14  ← what the terminal finds
#     /opt/homebrew/bin/python3   3.14.4
# So the nightly run and the run the operator tested by hand were never guaranteed to be
# the same program. That is a latent failure with no symptom until the day the versions
# diverge enough to matter, and it was a contributing factor in the original incident
# (the error naming Xcode's python3 was the job telling us which one it had picked).
#
# VALIDATION USES THE LAUNCHD ENVIRONMENT, NOT THIS ONE. An interpreter that only works
# because the installing shell exported something is not an interpreter the 03:00 job can
# use. `/usr/bin/env -i` strips the shell's world so the candidate is tested the way
# launchd will actually see it — which is what makes this a measurement instead of a hope.
LAUNCHD_PATH="/usr/bin:/bin:/usr/sbin:/sbin"
PYTHON_FALLBACKS="/opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3"

python_runs() {
  local py="${1:-}"
  [ -n "$py" ] && [ -x "$py" ] || return 1
  /usr/bin/env -i HOME="${HOME:-/}" PATH="$LAUNCHD_PATH" "$py" -c 'import sys' >/dev/null 2>&1
}

# resolve_python — print an ABSOLUTE, VERIFIED python3, or return 1.
# Preference order: an explicit pin, then the installing user's own python3 (so the
# nightly job runs what the operator runs), then absolute fallbacks. Returning 1 is not
# fatal: the plist simply carries no pin and the runner reports a structured, loud failure
# at 03:00 rather than the install refusing on a box we cannot fully inspect.
resolve_python() {
  local py
  py="${HEIMDALL_DREAM_PYTHON:-}"
  if [ -n "$py" ]; then
    python_runs "$py" && { printf '%s' "$py"; return 0; }
    return 1
  fi
  py="$(command -v python3 2>/dev/null || true)"
  if [ -n "$py" ]; then
    case "$py" in
      /*) : ;;
      *)  py="$(cd "$(dirname "$py")" 2>/dev/null && pwd -P)/$(basename "$py")" ;;
    esac
    python_runs "$py" && { printf '%s' "$py"; return 0; }
  fi
  for py in $PYTHON_FALLBACKS; do
    python_runs "$py" && { printf '%s' "$py"; return 0; }
  done
  return 1
}

# ── The install-side sandbox guard (fail-safe, self-detecting) ───────────────────
#
# WHY REGISTRATION NEEDS THIS. `launchctl load` does NOT resolve through $HOME — it
# registers into the logged-in user's GUI session domain (gui/<uid>). A harness that
# sets HOME=$(mktemp -d) isolates WHERE the plist file lands but NOT which launchd
# hears about it, so an unguarded `install` under a throwaway HOME repoints the
# DEVELOPER'S OWN live nightly job at the harness's temp checkout — a tree that is
# then deleted, leaving the nightly job wired to a path that no longer exists. That
# happened. This is the fix.
#
# IT DOES NOT TRUST THE CALLER. heimdall_home_is_real compares $HOME against the
# PASSWD DATABASE, which $HOME cannot influence, so a synthetic HOME self-identifies
# with zero cooperation from whoever spawned the run. HEIMDALL_NO_DREAM_SCHEDULE=1
# stays the EXPLICIT opt-out (checked first, and honored here too so the helper's own
# CLI obeys the same switch install.sh and heimdall-autoupdate obey); this passwd
# comparison is the FLOOR underneath it, for every caller who forgets — the failure
# mode a remember-the-env-var guard has by construction.
#
# REFUSAL IS TOTAL AND EARLY: it returns before write_plist, so neither launchd NOR
# $LA_DIR is touched — no plist is created even in the sandbox. Exit 4 is distinct
# from a real failure (3) so install.sh can report "sandboxed" rather than a scary
# "load failed", while still being non-zero for anything that just checks success.
require_real_launchd_domain() {
  if type heimdall_home_is_real >/dev/null 2>&1 && heimdall_home_is_real; then
    return 0
  fi
  echo "not scheduled $PLIST (synthetic HOME — refusing to touch the real launchd domain)" >&2
  echo "  \$HOME is not this user's passwd home, so launchctl would reach the REAL" >&2
  echo "  per-user launchd domain that \$HOME does not isolate. Nothing was written." >&2
  exit 4
}

# ── The ephemeral-checkout guard (the SECOND mechanism behind the same incident) ──
#
# WHAT THE PASSWD GUARD ABOVE CANNOT SEE. It proves the run owns this launchd domain.
# It says nothing about whether the PATH being pinned survives the week. The run that
# rewrote the developer's live com.heimdall.dream.plist had a genuine $HOME — real
# user, real passwd home, real domain — and passed that guard cleanly. It registered
#   <repo>/.claude/worktrees/agent-<id>/bin/heimdall-dream --repo <same worktree>
# from an agent worktree. The worktree was later reaped, so the nightly job was left
# pinned to a path that no longer exists. Nothing errors at 03:00; the job just never
# runs again, and the only symptom is that dreams quietly stop arriving. A silent
# permanent outage is strictly worse than a loud refusal, which is why this refuses.
#
# BOTH PINNED PATHS ARE CHECKED. $DREAM becomes ProgramArguments[0] and $REPO becomes
# --repo AND WorkingDirectory. Either one landing in a disposable tree produces the
# same silently-dead job, so both are gated; the incident corrupted both at once.
#
# THE PREDICATE IS STRUCTURAL (bin/lib/real-home.sh): "is this a LINKED git worktree",
# asked of git itself and of the on-disk .git shape — not a substring match on
# ".claude/worktrees", which would miss a worktree created anywhere else. An undefined
# predicate (unreadable lib) refuses, matching the house rule above — though that case
# already exits 4 there, since the same lib supplies both.
#
# ORDERING: this runs AFTER require_real_launchd_domain and BEFORE write_plist, so a
# synthetic HOME still reports as 'sandboxed' (its wording is asserted elsewhere) and a
# refusal here still leaves nothing behind. Exit 5 is distinct from sandboxed (4) and
# from a genuine failure (3): an operator reading a log must be able to tell "refused
# because synthetic HOME" from "refused because worktree checkout" from "broke".
refuse_ephemeral() {
  local what="$1" path="$2"
  echo "not scheduled $PLIST (ephemeral checkout — refusing to pin a nightly job to a disposable tree)" >&2
  echo "  $what is inside a linked git worktree: $path" >&2
  echo "  A linked worktree exists to be reaped; a LaunchAgent pinned to one does not" >&2
  echo "  fail loudly when that happens, it just silently stops running. Re-run this" >&2
  echo "  from the main worktree (git worktree list | head -1). Nothing was written." >&2
  exit 5
}
require_durable_pinned_paths() {
  if ! type heimdall_path_is_ephemeral >/dev/null 2>&1; then
    echo "not scheduled $PLIST (ephemeral checkout — cannot verify the tree is durable)" >&2
    echo "  bin/lib/real-home.sh did not load, so the disposable-checkout predicate is" >&2
    echo "  unavailable and this refuses rather than guess. Nothing was written." >&2
    exit 5
  fi
  heimdall_path_is_ephemeral "$DREAM" && refuse_ephemeral "the dream command" "$DREAM"
  heimdall_path_is_ephemeral "$REPO"  && refuse_ephemeral "the --repo target" "$REPO"
  return 0
}

# ── stage the runner outside the repo (the program launchd is guaranteed to reach) ─
#
# COPIED, NOT SYMLINKED. A symlink back into the repo would resolve INTO the protected
# tree at 03:00 and be denied exactly like the old direct-exec plist — the link readable,
# its target not, which is the same silent death with one extra step. A copy is the only
# form that survives the denial it exists to report.
#
# RE-COPIED ON EVERY INSTALL, so the staged runner cannot drift from the checkout:
# install is idempotent (fixed path, overwritten in place) and heimdall-autoupdate
# re-asserts the schedule after every update, which makes this the normal refresh path
# rather than a manual chore that would rot.
#
# WHEN THE SOURCE *IS* THE DESTINATION, THERE IS NOTHING TO COPY. The default install
# layout puts the plugin tree at $HOME/.heimdall and $HEIMDALL_HOME defaults to the same
# path, so RUNNER_SRC and RUNNER name ONE file. `cp X X` exits 1 on macOS, which this
# used to treat as a staging failure — the helper died with exit 3 and install.sh printed
# the state word 'skipped', so a stranger's install registered no nightly dream and said
# nothing about it. The file is already exactly where it must be; the only work left is
# to assert its mode.
# ── resolve which interpreter EXECUTES THE RUNNER, and pin it outright ───────────
#
# launchd's posix_spawn resolves ProgramArguments[0] as an executable path directly — a
# script named there has its own #!/usr/bin/env bash shebang never consulted, the way it
# would be from an interactive shell. This worked by COINCIDENCE (plain /bin/bash sits on
# launchd's own minimal PATH); naming the interpreter outright here removes that
# coincidence AND buys a narrower TCC identity than the alternative.
#
# TCC keys a Full Disk Access grant to the RUNNING interpreter's code identity (path +
# CDHash) — never to the script text it interprets. Naming plain /bin/bash means any
# grant lands on the same shared system binary every other script on the machine runs
# through. heimdall-dream-bundle builds a PRIVATE, ad-hoc-signed copy of bash under its
# own identifier so a grant can be scoped to exactly this job. Building it is best-effort:
# a machine without codesign, or a non-macOS box, falls back to plain /bin/bash — loudly,
# on stderr, never silently, since that fallback is exactly the broad-grant case the
# bundle exists to avoid.
resolve_interpreter() {
  if is_macos && [ -x "$BUNDLE_SRC" ]; then
    local out rc=0
    out="$("$BUNDLE_SRC" build --out "$RUNNER_DIR" --json 2>&1)" || rc=$?
    if [ "$rc" -eq 0 ] && [ -x "$BUNDLE_EXEC" ]; then
      if printf '%s' "$out" | grep -q '"changed": "true"'; then
        echo "note: the hmd-dream signing identity changed — a previously granted Full" >&2
        echo "      Disk Access permission may need to be re-confirmed:" >&2
        echo "      heimdall-dream-permission check --repo $REPO" >&2
      fi
      printf '%s' "$BUNDLE_EXEC"
      return 0
    fi
    echo "warning: could not build the hmd-dream identity ($out) — falling back to" >&2
    echo "         /bin/bash. A Full Disk Access grant would then apply to the shared" >&2
    echo "         system bash rather than a narrowly scoped copy." >&2
  fi
  echo "/bin/bash"
}

install_runner() {
  [ -f "$RUNNER_SRC" ] || die "heimdall-dream-runner missing at $RUNNER_SRC"
  ensure_private_dir "$HEIMDALL_HOME"
  ensure_private_dir "$RUNNER_DIR"
  if ! same_physical_file "$RUNNER_SRC" "$RUNNER"; then
    cp "$RUNNER_SRC" "$RUNNER" || die "cannot stage the runner at $RUNNER"
  fi
  # EXPLICIT, never `chmod +x` — under `umask 000` that would leave a world-writable
  # program that launchd executes nightly. 0755 is the tree's convention for a bin; the
  # 0700 directory above is what actually keeps it out of anyone else's reach.
  chmod 0755 "$RUNNER" || die "cannot set mode 0755 on $RUNNER"
  install_liveness
}

# STAGED, NOT REQUIRED. The nightly report is the product; the receipt is how we learn the
# report stopped arriving. So a tree without heimdall-liveness still installs a working
# schedule — but it says so on stderr rather than leaving the operator to assume the
# receipt is being written. Same copy-not-symlink rule as the runner: a link would resolve
# back into the protected tree at 03:00 and be denied exactly when it is needed.
install_liveness() {
  if [ ! -f "$LIVENESS_SRC" ]; then
    echo "warning: heimdall-liveness missing at $LIVENESS_SRC — the nightly job will run," >&2
    echo "         but it cannot write a liveness receipt, so a future silence would not" >&2
    echo "         be reported. Re-install from a complete checkout to restore it." >&2
    return 0
  fi
  if ! same_physical_file "$LIVENESS_SRC" "$LIVENESS"; then
    if ! cp "$LIVENESS_SRC" "$LIVENESS"; then
      echo "warning: cannot stage heimdall-liveness at $LIVENESS — the nightly job will" >&2
      echo "         run, but its liveness receipt will not be written from launchd." >&2
      return 0
    fi
  fi
  chmod 0755 "$LIVENESS" 2>/dev/null \
    || echo "warning: cannot set mode 0755 on $LIVENESS — receipt writes may fail." >&2
  return 0
}

# ── emit the plist (the single source of the scheduled argv) ─────────────────────
write_plist() {
  # $LA_DIR is Apple's directory, not ours — create it if absent but never restyle the
  # mode of one that already exists. The log tree IS ours, so it gets stated modes: 0700
  # on the directory, and the file created here at 0600 rather than left for launchd to
  # create under whatever umask loaded the job. The log carries repo paths and verbatim
  # OS errors, which is diagnostic detail about this machine and nobody else's business.
  mkdir -p "$LA_DIR" || die "cannot create $LA_DIR"
  ensure_private_dir "$(dirname "$LOG")"
  [ -e "$LOG" ] || : > "$LOG"
  chmod 0600 "$LOG" || die "cannot set mode 0600 on $LOG"
  local e_dream e_repo e_log e_runner e_wd e_interp
  e_dream="$(xml_escape "$DREAM")"
  e_repo="$(xml_escape "$REPO")"
  e_log="$(xml_escape "$LOG")"
  e_runner="$(xml_escape "$RUNNER")"
  e_interp="$(xml_escape "${INTERP:-/bin/bash}")"
  # The interpreter pin, when one resolved. Emitted AFTER --interpreter and BEFORE the
  # forwarded `run --overnight`. registered_command/registered_runner/registered_dream
  # no longer depend on this block's presence shifting fixed indices — registered_dream
  # scans for its own `--dream` flag rather than trusting a position — so growing this
  # block never blinds the silent-death detector the way a fixed index once could.
  local py_block=""
  if [ -n "${PYTHON:-}" ]; then
    py_block="    <string>--python</string>
    <string>$(xml_escape "$PYTHON")</string>
"
  fi
  # WorkingDirectory must be a path the JOB can getcwd(). Pinning it to the repo is what
  # produced the `shell-init: error retrieving current directory: getcwd: cannot access
  # parent directories: Operation not permitted` lines in the real log — launchd could not
  # even enter the directory, so every child shell inherited a broken cwd. dream is told
  # where the repo is via --repo, so cwd carries no information; $HOME is always reachable
  # by the user's own LaunchAgent.
  e_wd="$(xml_escape "$HOME")"
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$e_interp</string>
    <string>$e_runner</string>
    <string>--dream</string>
    <string>$e_dream</string>
    <string>--repo</string>
    <string>$e_repo</string>
    <string>--interpreter</string>
    <string>$e_interp</string>
$py_block    <string>run</string>
    <string>--overnight</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>$HOUR</integer>
    <key>Minute</key>
    <integer>$MINUTE</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>WorkingDirectory</key>
  <string>$e_wd</string>
  <key>StandardOutPath</key>
  <string>$e_log</string>
  <key>StandardErrorPath</key>
  <string>$e_log</string>
</dict>
</plist>
PLIST
  # 0644 — launchd's own convention for a LaunchAgent, and the hard rule either way is
  # that a file naming the program the system runs nightly is never world-writable.
  chmod 0644 "$PLIST" || die "cannot set mode 0644 on $PLIST"
}

# ── launchctl helpers (unload-before-load == idempotent; tolerant of "not loaded") ─
unload_agent() {
  "$LAUNCHCTL" unload -w "$PLIST" >/dev/null 2>&1 || true
}
load_agent() {
  "$LAUNCHCTL" load -w "$PLIST" >/dev/null 2>&1 \
    || die "launchctl failed to load $PLIST"
}
is_loaded() {
  "$LAUNCHCTL" list "$LABEL" >/dev/null 2>&1
}

# ── Registered-command introspection (the SILENT-DEATH detector) ─────────────────
#
# WHY status HAS TO ANSWER THIS. launchd does not validate ProgramArguments[0] when a
# job is loaded and does not complain at 03:00 when that program has vanished —
# `launchctl list` keeps reporting the job either way. So `status` used to say
# "registered (installed + loaded)" about a job that had not run in weeks. That is the
# incident's lasting damage: not the bad write, but that NOTHING AFTERWARDS SAID SO. A
# schedule whose failure mode is silence needs a liveness check, or it has no failure
# mode at all — just an absence nobody attributes to anything.
#
# WHY THIS DETECTS AND DOES NOT REPAIR. Repair means CHOOSING a path to re-pin, and the
# only path `status` could choose is the tree it happens to be running from — which is
# exactly the hijack require_durable_pinned_paths exists to stop, re-introduced through
# a read-only subcommand and triggered by nothing more than a stale plist. Repair
# therefore stays where it already is and is already gated: `install` overwrites the
# plist in place (fixed path + unload-before-load = idempotent) and heimdall-autoupdate
# re-asserts it after every update, so the self-heal runs on the normal upgrade path —
# and both now refuse an ephemeral tree. Detection here is inert by construction: it
# writes nothing and issues no launchctl verb, so it cannot become a vector.
#
# plutil is the platform's OWN plist reader and ships with every macOS. Where it is
# absent there is no launchd either, so printing nothing beats guessing from the XML —
# a fabricated answer here would be worse than none.
registered_command() {
  local out
  [ -f "$PLIST" ] || return 0
  command -v plutil >/dev/null 2>&1 || return 0
  out="$(plutil -extract ProgramArguments.0 raw -o - "$PLIST" 2>/dev/null)" || return 0
  printf '%s' "$out"
}

# plist_program_args — the full ProgramArguments array, one value per line, via the SAME
# per-index plutil primitive registered_command uses above. There is no jq or other JSON
# parser to lean on here, and plutil has no "give me the array as lines" mode, so this
# walks indices until the first one fails to extract — which is exactly where the array
# ends. `while v="$(plutil ...)"` as the loop CONDITION is deliberate: under
# `set -euo pipefail` a condition position is always exempt from -e, so the loop's own
# termination is what ends it, never a script-ending failure.
plist_program_args() {
  [ -f "$PLIST" ] || return 0
  command -v plutil >/dev/null 2>&1 || return 0
  local i=0 v
  while v="$(plutil -extract "ProgramArguments.$i" raw -o - "$PLIST" 2>/dev/null)"; do
    printf '%s\n' "$v"
    i=$((i+1))
  done
}

# plist_flag_value <flag> — the value immediately following <flag> in ProgramArguments.
# Empty if the flag is absent or is the array's last element.
plist_flag_value() {
  local flag="$1" prev="" line
  while IFS= read -r line; do
    [ "$prev" = "$flag" ] && { printf '%s' "$line"; return 0; }
    prev="$line"
  done < <(plist_program_args)
}

# THREE PINNED PATHS NOW, THREE WAYS TO DIE SILENTLY.
# ProgramArguments[0] is the interpreter (registered_command, above — the hmd-dream
# bundle or a /bin/bash fallback), [1] is the staged runner, and the --dream target it
# execs is a further, separate path inside the repo. Any one vanishing produces the same
# registered-but-dead job the detector below exists to catch, so all three are checked.
# registered_dream scans for its own `--dream` flag rather than trusting a fixed index —
# a later argument insertion shifting positions must never again blind this the way a
# fixed ProgramArguments.2 once would have.
registered_runner() {
  local out
  [ -f "$PLIST" ] || return 0
  command -v plutil >/dev/null 2>&1 || return 0
  out="$(plutil -extract ProgramArguments.1 raw -o - "$PLIST" 2>/dev/null)" || return 0
  printf '%s' "$out"
}

registered_dream() {
  plist_flag_value --dream
}

# Minimal JSON string escaping for a value that comes from OUTSIDE this script (the
# plist on disk) — a path holding a quote or backslash would otherwise emit JSON that
# no consumer can parse.
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# ── subcommands ──────────────────────────────────────────────────────────────────
cmd_install() {
  # Explicit opt-out FIRST — a declining dev/CI never reaches launchd at all. Same
  # variable install.sh + heimdall-autoupdate honor, checked here so the switch holds
  # no matter which entry point is used.
  if [ "${HEIMDALL_NO_DREAM_SCHEDULE:-0}" = "1" ]; then
    echo "not scheduled $LABEL (HEIMDALL_NO_DREAM_SCHEDULE=1)" >&2
    return 0
  fi
  is_macos || die "unsupported platform: launchd scheduling is macOS-only (found $(uname -s)). \
Use the cron/cloud routine documented in commands/dream.md instead."
  # Fail-safe sandbox gate — before write_plist, so a refusal leaves NOTHING behind.
  require_real_launchd_domain
  # Second gate: never pin the nightly job to a checkout that is built to be reaped.
  require_durable_pinned_paths
  # Third gate: never stage the job's own artifacts where launchd cannot reach them.
  require_reachable_artifacts
  [ -x "$DREAM" ] || die "heimdall-dream not executable at $DREAM"
  # Resolve the interpreter while a real user's PATH is available. Empty is tolerated:
  # the plist then carries no pin and the runner falls back at 03:00 — loudly, with a
  # recorded status, never a silent success.
  PYTHON="$(resolve_python || true)"
  install_runner
  INTERP="$(resolve_interpreter)"
  write_plist
  unload_agent   # drop any prior copy so a re-install never yields two loaded jobs
  load_agent
  local cron="$MINUTE $HOUR * * *"
  if [ "$JSON" = 1 ]; then
    printf '{"installed":true,"loaded":%s,"label":"%s","plist":"%s","cron":"%s","command":"%s --repo %s run --overnight","log":"%s"}\n' \
      "$(is_loaded && echo true || echo false)" "$LABEL" "$PLIST" "$cron" "$DREAM" "$REPO" "$LOG"
  else
    echo "installed $LABEL — nightly at $(printf '%02d:%02d' "$HOUR" "$MINUTE") (cron '$cron')"
    echo "  command: $DREAM --repo $REPO run --overnight"
    echo "  plist:   $PLIST"
    echo "  log:     $LOG"
    echo "  loaded:  $(is_loaded && echo yes || echo no)"
    echo "  disable: heimdall-dream-schedule uninstall"
    # ── THE FIRST-RUN PERMISSION ASK ──────────────────────────────────────────────
    #
    # The repo is deliberately EXEMPT from require_reachable_artifacts: a protected repo
    # is the case the runner handles by failing loudly. But "fails loudly every night
    # forever" is not an outcome — it is a question nobody asked the operator. So at the
    # moment he is standing here having just registered the job, and ONLY when a grant is
    # genuinely needed, tell him plainly what is missing and what his options are.
    #
    # AFTER the install summary, so the block is the last thing on screen. NEVER in --json
    # mode: that output has parsers. Fully best-effort — a permission prompt must not be
    # able to fail an install that otherwise succeeded, and the ask is idempotent on its
    # own (it records what it showed and stays quiet on a re-install).
    if [ -x "$PERMISSION" ]; then
      "$PERMISSION" ask --repo "$REPO" 2>/dev/null || true
    fi
  fi
}

cmd_uninstall() {
  # off switch — tolerate a non-macOS box and an already-absent agent (idempotent).
  unload_agent
  rm -f "$PLIST"
  # Reclaim the STAGED COPY of the runner, so uninstall reverses what install added.
  #
  # ONLY WHEN IT IS A COPY. In the default layout the plugin tree IS $HEIMDALL_HOME, so
  # the "staged" runner is the installation's own file. `heimdall-dream-schedule uninstall`
  # is the documented OFF SWITCH — a user turning the nightly job off must not have it
  # quietly amputate part of the install. When the two paths differ the copy is ours and
  # nothing else refers to it, so leaving it would orphan a file the user never placed.
  #
  # The `type` check keeps the OFF SWITCH working on a tree whose lib did not load: with
  # no way to tell a staged copy from the installation's own file, the safe answer is to
  # leave it alone. Uninstall may orphan a file; it must never amputate an install.
  if [ -e "$RUNNER" ] && type heimdall_absolute_physical >/dev/null 2>&1 \
     && ! same_physical_file "$RUNNER_SRC" "$RUNNER"; then
    rm -f "$RUNNER" 2>/dev/null || true
  fi
  # Same rule for the staged receipt writer: reclaim OUR copy, never amputate the
  # installation's own file when the plugin tree and $HEIMDALL_HOME are one path.
  if [ -e "$LIVENESS" ] && type heimdall_absolute_physical >/dev/null 2>&1 \
     && ! same_physical_file "$LIVENESS_SRC" "$LIVENESS"; then
    rm -f "$LIVENESS" 2>/dev/null || true
  fi
  # The hmd-dream bundle and its recorded identity are always GENERATED, never a file the
  # user placed — unlike the runner/liveness copies above there is no same_physical_file
  # case to protect, so uninstall always removes both outright.
  rm -rf "$BUNDLE_APP" 2>/dev/null || true
  rm -f "$IDENT_FILE" 2>/dev/null || true
  # Reversibility extends to the ask: uninstall drops the marker recording that the
  # first-run permission block was shown, so a later re-install asks again from scratch.
  # `uninstall` is the documented undo, and an undo that leaves state behind is a leak.
  rm -f "${HEIMDALL_DREAM_PERMISSION_STATE:-$HEIMDALL_HOME/dream-permission.json}" \
    2>/dev/null || true
  if [ "$JSON" = 1 ]; then
    printf '{"installed":false,"loaded":false,"label":"%s","plist":"%s"}\n' "$LABEL" "$PLIST"
  else
    echo "uninstalled $LABEL (plist removed, agent unloaded)"
  fi
}

cmd_status() {
  local installed loaded regcmd regrunner regdream stale stale_path
  [ -f "$PLIST" ] && installed=true || installed=false
  if is_loaded; then loaded=true; else loaded=false; fi
  # A job pinned to a path that no longer exists is REGISTERED but DEAD: launchd will
  # keep listing it and will keep never running it. Surface that as its own state.
  # Three pinned paths are checked — the interpreter, the staged runner, and the dream
  # bin it execs.
  regcmd="$(registered_command)"
  regrunner="$(registered_runner)"
  regdream="$(registered_dream)"
  stale=false
  stale_path=""
  if [ "$installed" = true ]; then
    if [ -n "$regcmd" ] && [ ! -x "$regcmd" ]; then
      stale=true; stale_path="$regcmd"
    elif [ -n "$regrunner" ] && [ ! -x "$regrunner" ]; then
      stale=true; stale_path="$regrunner"
    elif [ -n "$regdream" ] && [ ! -x "$regdream" ]; then
      stale=true; stale_path="$regdream"
    fi
  fi
  if [ "$JSON" = 1 ]; then
    printf '{"installed":%s,"loaded":%s,"stale":%s,"label":"%s","plist":"%s","registered_command":"%s","registered_runner":"%s","registered_dream":"%s","stale_path":"%s","command":"%s --repo %s run --overnight","log":"%s"}\n' \
      "$installed" "$loaded" "$stale" "$LABEL" "$PLIST" "$(json_escape "$regcmd")" \
      "$(json_escape "$regrunner")" "$(json_escape "$regdream")" "$(json_escape "$stale_path")" "$DREAM" "$REPO" "$LOG"
  else
    if [ "$stale" = true ]; then
      echo "$LABEL: registered but DEAD — its command no longer exists"
    elif [ "$installed" = true ] && [ "$loaded" = true ]; then
      echo "$LABEL: registered (installed + loaded)"
    elif [ "$installed" = true ]; then
      echo "$LABEL: installed but NOT loaded"
    else
      echo "$LABEL: not installed"
    fi
    echo "  plist:   $PLIST"
    echo "  command: $DREAM --repo $REPO run --overnight"
    echo "  log:     $LOG"
    if [ "$stale" = true ]; then
      echo "  MISSING: a path this job is pinned to is gone: $stale_path"
      echo "           launchd still lists this job and will never run it. Re-register"
      echo "           from your MAIN checkout: heimdall-dream-schedule install"
    fi
  fi
}

# run-now — fire the SAME overnight run the schedule would, once, now (parity check &
# a way to prove the wiring without waiting for 03:00). Delegates to heimdall-dream.
cmd_run_now() {
  [ -x "$DREAM" ] || die "heimdall-dream not executable at $DREAM"
  local extra=()
  [ "$JSON" = 1 ] && extra+=(--json)
  exec "$DREAM" --repo "$REPO" run --overnight "${extra[@]}"
}

# ── dispatch ───────────────────────────────────────────────────────────────────
[ $# -ge 1 ] || { usage >&2; exit 2; }
CMD="$1"; shift
case "$CMD" in
  -h|--help) usage; exit 0 ;;
  install)   parse_args "$@"; cmd_install ;;
  uninstall) parse_args "$@"; cmd_uninstall ;;
  status)    parse_args "$@"; cmd_status ;;
  run-now)   parse_args "$@"; cmd_run_now ;;
  *) echo "error: unknown command: $CMD" >&2; usage >&2; exit 2 ;;
esac
