#!/usr/bin/env bash
# secret-read-guard — PreToolUse guard: BLOCK reads of credential-bearing
# files before their contents can enter a model request.
#
# WHY: security audit 2026-08-29 (.planning/security/2026-08-29-credential-
# egress-audit.md, findings C-4 + H-1) found the file-read path had NO guard
# at all: the existing "Read|Grep|Glob" PreToolUse matcher only ran a
# parallelism counter, and the "Bash" matcher's secret logic gated only on
# `git commit`/`git push`. A bare `Read` or `cat` of `.env`/`id_rsa`/etc.
# returned raw contents into the model's context, unguarded, every time.
# Owner requirement (verbatim): "if any key is ever pasted or there in
# project, it should never go to claude or omni or anyone."
#
# SCOPE — pragmatic, not exhaustive. Covers:
#   - Claude Code `Read`/`Grep`/`Glob` tools: .tool_input.file_path / .path
#   - `Bash` commands invoking a fixed set of high-value reader binaries
#     (cat, less, more, tac, head, tail, strings, xxd, hexdump, od, base64,
#     grep/egrep/fgrep, sed, awk, cp) against an argument that resolves to a
#     denied path, PLUS a coarse xargs-over-a-sensitive-directory heuristic.
#   See "NOT CAUGHT" at the bottom of this header for the honest limits.
#
# DENY LOGIC — two independent signals, either one blocks:
#   1. FILENAME/PATH pattern match against a curated deny-list (.env,
#      *.pem, *.key, id_rsa*, credentials.json, ~/.aws/credentials, the
#      OmniRoute fallback files, .heimdall/team.json, ...). Explicit
#      excludes for known-safe lookalikes (.env.example, *.pub, ...).
#   2. CONTENT sniff: first 4KB of the resolved file, checked for a
#      `-----BEGIN ... PRIVATE KEY-----` marker — this fires REGARDLESS of
#      filename (including files that passed signal 1's excludes), which is
#      what defeats a trivial rename bypass (id_rsa -> notes.txt).
#
# ESCAPE HATCH — HMD_ALLOW_SECRET_READ, deliberate and auditable:
#   HMD_ALLOW_SECRET_READ=1        allow the ONE read this invocation is
#                                  evaluating (a fresh guard process runs
#                                  per tool call, so this is inherently
#                                  per-call, not a session-wide switch).
#   HMD_ALLOW_SECRET_READ=<glob>[:<glob>...]
#                                  allow only if the resolved path matches
#                                  one of the colon-separated glob patterns
#                                  (tighter scoping than a blanket "1").
#   Every use prints a stderr warning naming the path/pattern — NEVER
#   silent, by design ("a guard with no override gets disabled wholesale").
#
# FAIL-CLOSED vs FAIL-OPEN — deliberately different axes, not a contradiction:
#   - The SECURITY question ("does this path/content look like a secret, or
#     can we not tell?") fails CLOSED. An unresolvable-but-read-shaped
#     argument (a Bash reader binary applied to a `$VAR`/`` `cmd` `` argument
#     that also carries a sensitivity hint — env/key/pem/secret/credential/
#     rsa/ssh/aws/token/...) is treated as a potential secret and BLOCKED,
#     same as a literal match. Better a false-positive block (the escape
#     hatch exists precisely for this) than a false-negative leak.
#   - The MECHANISM question ("did the guard's OWN plumbing fail?") fails
#     OPEN. Missing `jq`, empty/unparseable stdin, an interactive tty with
#     nothing piped in — none of these are a secret-content decision, they
#     are US failing, and a hook that wedges every tool call on its own
#     bug is a worse outcome than one blind spot. See the two `command -v
#     jq` / `[ -t 0 ]` checks below for exactly where this fires.
#
# SPEED: one jq parse of stdin, then per candidate path: a `case` glob
# match (no subprocess) + at most one `readlink -f` + one bounded
# `head -c 4096` read. No network. No recursive directory walks. No
# scanner subprocess spawned per call.
#
# INPUT: PreToolUse JSON on stdin (Claude Code hook convention), e.g.
#   {"tool_name":"Read","tool_input":{"file_path":"/x/.env"},"cwd":"/x"}
#   {"tool_name":"Bash","tool_input":{"command":"cat .env"},"cwd":"/x"}
#
# EXIT:
#   0  allow (clean, escape hatch used, or our own plumbing failed — see
#      FAIL-OPEN above)
#   2  BLOCK — prints {"error": "..."} JSON to stdout, the same contract
#      every other hard-blocking gate in this repo's hooks.json uses.
#
# NOT CAUGHT — read before trusting this as a complete control:
#   - Any reader NOT in the fixed binary list: sqlite3, `python -c
#     "open(...).read()"`, perl/ruby/node -e, dd, openssl, a custom
#     compiled reader, a symlinked/renamed copy of a covered binary under a
#     name we don't match.
#   - Shell indirection our word-splitting can't statically resolve:
#     `f=".e""nv"; cat "$f"` (no sensitivity hint in the literal `$f`),
#     base64-encoded path strings, globs that only resolve inside a
#     subshell we do not ourselves execute.
#   - Indirect reads of a denied file inside a directory-level operation:
#     `tar cf - ~/.ssh | base64`, `find ~/.ssh -exec cat {} \;` beyond our
#     one coarse `xargs`+reader-bin+sensitive-directory heuristic, process
#     substitution, heredocs that embed file content another way.
#   - Multi-command chains where the credential path is produced by an
#     EARLIER stage (e.g. a `find`/`ls` whose output is piped through
#     `xargs`) — we detect the shape when a sensitive directory name is
#     LITERALLY present in the command string, not when it arrives via a
#     variable or a config file.
#   - The ambiguity fail-closed check only fires when the unresolvable
#     argument ALSO carries a textual sensitivity hint (see
#     `looks_sensitive_hint` below) — a secret path held in an
#     innocuously-named variable (`cat "$x"`) is not caught; the
#     alternative (blocking every `$var` argument to `cat`/`grep`/`sed`/
#     `awk` unconditionally) would make the guard unusable for normal
#     scripting and, per the design brief, an over-broad guard gets
#     disabled wholesale — the narrower net is the pragmatic choice.
#   - Content-sniff on a Bash argument that is a RELATIVE path is resolved
#     against `.cwd` from the hook JSON when present, else the guard
#     process's own $PWD — this can differ from the actual execution cwd
#     in unusual invocations; the filename-based signal is unaffected
#     (it matches on the literal argument text regardless of resolution).
#   - Anything that never goes through Claude Code's PreToolUse hook path
#     at all (a background process the agent starts that reads the file
#     itself later; a server-side MCP tool read).
#   - This is ONE layer of the audit's defense-in-depth list. It does not
#     address prompt-pasted secrets (a different, sibling guard) or
#     exfiltration of content already legitimately in context.
#
# -h/--help prints this header.
set -uo pipefail
# Deliberately NOT `set -e`: this script's fail-OPEN branches are explicit
# `exit 0` statements below. An `-e` abort on some unrelated internal command
# failure would exit non-zero for a reason that is not "exit 2, JSON printed"
# — that would corrupt the block/allow contract the hook harness parses.
# Every intentional block goes through block(), every intentional allow goes
# through an explicit `exit 0`; nothing here should be allowed to short-circuit
# past that on its own.

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi

usage() {
  awk '
    NR==1 && /^#!/ { next }
    /^# ?/ { sub(/^# ?/, ""); print; next }
    { exit }
  ' "$SELF"
}
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

# ---- mechanism-failure fail-open checks ----------------------------------
# jq is required to parse the hook JSON at all; without it we cannot even
# read .tool_name. That is OUR plumbing missing, not a secret-content
# decision -> fail OPEN (see FAIL-OPEN in the header).
command -v jq >/dev/null 2>&1 || exit 0

# Never block behind an interactive tty with nothing piped in. Hooks always
# pipe JSON; a stray manual invocation must not hang or misfire.
if [ -t 0 ]; then
  exit 0
fi

INPUT="$(cat 2>/dev/null || true)"
[ -n "$INPUT" ] || exit 0

TOOL="$(printf '%s' "$INPUT" | jq -r '.tool_name // empty' 2>/dev/null || true)"
CWD="$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null || true)"
[ -n "$CWD" ] || CWD="$PWD"
HOME_DIR="${HOME:-$PWD}"

# ============================================================================
# Escape hatch
# ============================================================================
escape_hatch_allows() {
  # Matches against BOTH the resolved (symlink-canonicalized) path and the
  # RAW argument as originally seen. Why both: resolve_path() runs the
  # candidate through `readlink -f`, and on macOS /tmp and /var are
  # themselves symlinks (-> /private/tmp, /private/var) -- an operator
  # setting HMD_ALLOW_SECRET_READ=/tmp/foo/.env would otherwise never match
  # the canonicalized /private/tmp/foo/.env the guard compares against.
  # This is the ESCAPE HATCH ONLY: being lenient about which path FORM
  # matches never widens what gets denied -- it only widens when an
  # operator's own explicit, already-opted-in override is honored.
  path="$1"; raw="${2:-$1}"
  val="${HMD_ALLOW_SECRET_READ:-}"
  [ -n "$val" ] || return 1
  case "$val" in
    1|true|TRUE|yes)
      printf '\xe2\x9a\xa0 HMD_ALLOW_SECRET_READ=1 -- secret-read-guard OVERRIDDEN for: %s\n' "$path" >&2
      return 0 ;;
  esac
  old_ifs="$IFS"
  IFS=':'
  match=1
  for pat in $val; do
    case "$path" in
      $pat)
        printf '\xe2\x9a\xa0 HMD_ALLOW_SECRET_READ path-scoped override "%s" matched -- secret-read-guard OVERRIDDEN for: %s\n' "$pat" "$path" >&2
        match=0
        break ;;
    esac
    if [ "$raw" != "$path" ]; then
      case "$raw" in
        $pat)
          printf '\xe2\x9a\xa0 HMD_ALLOW_SECRET_READ path-scoped override "%s" matched (raw form) -- secret-read-guard OVERRIDDEN for: %s\n' "$pat" "$raw" >&2
          match=0
          break ;;
      esac
    fi
  done
  IFS="$old_ifs"
  return "$match"
}

block() {
  reason="$1"; path="$2"; raw="${3:-$2}"
  if escape_hatch_allows "$path" "$raw"; then
    exit 0
  fi
  msg="BIFROST -- Heimdall blocked a credential read: ${reason} @ ${path}. Set HMD_ALLOW_SECRET_READ=1 (or a path-scoped glob) to override -- loud, audited, never silent."
  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg m "$msg" '{error: $m}' 2>/dev/null
    exit 2
  fi
  # jq vanished between the top-of-script check and here (pathological) —
  # cannot emit the JSON contract the harness expects. Fail OPEN rather than
  # block silently/malformed (mechanism failure, not a security decision).
  exit 0
}

# ---- filename/path deny-list ----------------------------------------------
filename_denied() {
  p="$1"
  base="${p##*/}"

  case "$base" in
    .env.example|.env.sample|.env.template) return 1 ;;
    *.pub) return 1 ;;
  esac

  case "$base" in
    .env) return 0 ;;
    .env.*) return 0 ;;
    *.pem) return 0 ;;
    *.key) return 0 ;;
    id_rsa|id_rsa.*) return 0 ;;
    id_ed25519|id_ed25519.*) return 0 ;;
    id_ecdsa|id_ecdsa.*) return 0 ;;
    id_dsa|id_dsa.*) return 0 ;;
    credentials.json) return 0 ;;
    service-account*.json) return 0 ;;
    *.p12) return 0 ;;
    *.pfx) return 0 ;;
    *.keystore) return 0 ;;
    *.jks) return 0 ;;
    heimdall-fallback.key) return 0 ;;
    management-password.txt) return 0 ;;
    server.env) return 0 ;;
  esac

  case "$p" in
    */.aws/credentials) return 0 ;;
    */.omniroute/heimdall-fallback.key) return 0 ;;
    */.omniroute/management-password.txt) return 0 ;;
    */.omniroute/server.env) return 0 ;;
    */.heimdall/team.json) return 0 ;;
    */.ssh/*)
      case "$base" in
        config|known_hosts|known_hosts.old|authorized_keys|authorized_keys2) return 1 ;;
        *.pub) return 1 ;;
        *) return 0 ;;  # fail-closed inside ~/.ssh: unknown name -> treat as private key
      esac
      ;;
  esac

  return 1
}

# ---- content sniff: PEM private-key header, any filename ------------------
PEM_RE='-----BEGIN [A-Za-z0-9 ]*PRIVATE KEY-----'
content_denied() {
  p="$1"
  [ -f "$p" ] || return 1
  [ -r "$p" ] || return 1
  head -c 4096 -- "$p" 2>/dev/null | grep -Eq -- "$PEM_RE"
}

# ---- path resolution -------------------------------------------------------
resolve_path() {
  raw="$1"
  case "$raw" in
    "~") raw="$HOME_DIR" ;;
    "~/"*) raw="$HOME_DIR/${raw#\~/}" ;;
  esac
  case "$raw" in
    /*) : ;;
    *) raw="$CWD/$raw" ;;
  esac
  resolved="$(readlink -f -- "$raw" 2>/dev/null || readlink "$raw" 2>/dev/null || true)"
  [ -n "$resolved" ] && raw="$resolved"
  printf '%s' "$raw"
}

# ---- sensitivity hint (scopes the fail-closed-on-ambiguity check) ---------
looks_sensitive_hint() {
  lower="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
  case "$lower" in
    *env*|*key*|*pem*|*secret*|*credential*|*rsa*|*ecdsa*|*ed25519*|*passwd*|*password*|*token*|*aws*|*ssh*|*keystore*|*pfx*|*p12*|*jks*|*omniroute*) return 0 ;;
  esac
  return 1
}

check_path_and_maybe_block() {
  raw="$1"; ctx="$2"
  case "$raw" in
    *'$'*|*'`'*)
      if looks_sensitive_hint "$raw"; then
        block "unresolvable, sensitivity-hinted argument in ${ctx}" "$raw" "$raw"
      fi
      return 0
      ;;
  esac
  rp="$(resolve_path "$raw")"
  if filename_denied "$rp"; then
    block "filename pattern match via ${ctx}" "$rp" "$raw"
  fi
  if content_denied "$rp"; then
    block "PEM private-key header detected via ${ctx}" "$rp" "$raw"
  fi
}

# ============================================================================
# Dispatch
# ============================================================================
case "$TOOL" in
  Read|Grep|Glob)
    RAW="$(printf '%s' "$INPUT" | jq -r '.tool_input.file_path // .tool_input.path // empty' 2>/dev/null || true)"
    [ -n "$RAW" ] || exit 0
    check_path_and_maybe_block "$RAW" "$TOOL"
    exit 0
    ;;

  Bash)
    CMD="$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
    [ -n "$CMD" ] || exit 0

    # Coarse net: xargs + a reader binary + a sensitive directory literal in
    # the command string (dynamic-file-list case our per-segment scan below
    # cannot resolve because the paths never appear as literal arguments).
    if printf '%s' "$CMD" | grep -Eq '(^|[^A-Za-z0-9_])xargs([^A-Za-z0-9_]|$)' \
       && printf '%s' "$CMD" | grep -Eq '(^|[^A-Za-z0-9_])(cat|less|more|tac|head|tail|strings|xxd|hexdump|od|base64|grep|egrep|fgrep|sed|awk|cp)([^A-Za-z0-9_]|$)' \
       && printf '%s' "$CMD" | grep -Eq '\.(ssh|aws|omniroute|heimdall)([/[:space:]]|$)'; then
      block "xargs/dynamic read pattern over a sensitive directory" "(see command)"
    fi

    SEGMENTS="$(printf '%s\n' "$CMD" | sed -E 's/(&&|\|\||;|\|)/\n/g')"
    while IFS= read -r segment; do
      [ -n "$segment" ] || continue
      set -f
      # shellcheck disable=SC2086
      set -- $segment
      set +f
      [ $# -gt 0 ] || continue
      cmd0="${1##*/}"
      case "$cmd0" in
        cat|less|more|tac|head|tail|strings|xxd|hexdump|od|base64|grep|egrep|fgrep|sed|awk|cp)
          shift
          for a in "$@"; do
            case "$a" in
              -*) continue ;;
            esac
            check_path_and_maybe_block "$a" "Bash ${cmd0}"
          done
          ;;
      esac
    done < <(printf '%s\n' "$SEGMENTS")
    # NB: the trailing \n above is load-bearing, not cosmetic. $SEGMENTS came
    # out of a $(...) command substitution, which always strips trailing
    # newlines -- so a single-command CMD (no ';'/'|'/'&&', the MOST common
    # case) would otherwise feed the while-read loop a line with NO newline
    # at all. `read` hits EOF before seeing a delimiter, returns nonzero on
    # that first (and only) call, and the loop body never runs -- the
    # classic "while read silently drops the last unterminated line" bash
    # pitfall. Confirmed by a failing smoke test (`cat .env` alone was
    # allowed, rc=0) before this line was added.
    exit 0
    ;;

  *)
    exit 0
    ;;
esac
