#!/usr/bin/env bash
# heimdall-precheck-agent - the PreToolUse/Agent enforcement path (owns BOTH
# checks hooks/hooks.json used to run inline: the named-agent notice and the
# brief-adoption gate). Moved out of hooks.json into a real, bash -n'able,
# testable script for the same reason bin/heimdall-precheck-edit exists for
# Write|Edit: hooks.json is wiring, this is the logic.
#
# -- named-agent notice (unchanged behavior, advisory only) -----------------
# A `name:` on a spawn makes it MAILBOX-RESIDENT (never self-terminates, never
# returns a result to the spawn call - measured 0/43 named completed vs 59/66
# unnamed over 109 spawns in one session). This can never be more than a
# warning: `name:` has legitimate uses (a long-lived teammate collected via
# SendMessage), so it only ever prints to stderr. Set
# HEIMDALL_ALLOW_NAMED_AGENT=1 to silence it.
#
# -- brief-adoption gate (this is the mechanical upgrade) --------------------
# Was advisory-only: a printed suggestion to run heimdall-brief, silenceable,
# and measured to be ignored 100% of the time (0 real heimdall-brief
# invocations across ~40 hand-written oversized spawn prompts in one
# session). A warning is just a prompt delivered by a hook - it fails exactly
# like a prompt. Claude Code's PreToolUse contract can actually rewrite
# tool_input (hookSpecificOutput.updatedInput, schema-validated against the
# target tool and applied - confirmed against the installed CLI binary, not
# assumed), so this hook now BUILDS the brief for real and substitutes it,
# instead of asking the orchestrator to.
#
# What it can and cannot know: a hook only ever sees tool_input.prompt - free
# prose, not the symbols/files/capsules a hand-built brief would cite.
# Pulling those out of prose without guessing isn't possible from here
# (that's exactly the kind of guess heimdall-brief itself refuses to make),
# so this calls heimdall-brief with ONLY --task/--spec. That brief is
# thinner than a hand-built one, but it is not hollow-by-fabrication:
# heimdall-brief never invents refs it wasn't given, so omitting
# symbols/files is honest, not fake compliance - the whole failure mode this
# hook exists to replace.
#
# Exemptions (unchanged from the advisory version): subagent_type=fork, a
# prompt already carrying "=== DELTA BRIEF", a prompt at or under
# HEIMDALL_BRIEF_WORD_THRESHOLD (default 300) words, or
# HEIMDALL_ALLOW_LONG_BRIEF=1.
#
# The one real deny: heimdall-brief itself can only exit 0 or 3 when called
# with just --task/--spec (1/INCOMPLETE requires a symbol/file/capsule/
# invariants ref to be unresolved, and none are ever passed here, so it is
# structurally unreachable in this script). Exit 3/NON_VERIFIED means the
# protocol store itself could not be checked - not found empty, unreachable.
# Substituting in that case would silently claim a brief was verified when it
# was not, which is worse than the gap this hook closes, so THIS ONE CASE
# denies (exit 2, {"error": ...} on stdout+stderr, naming the exact command)
# instead.
#
# Everything else - no jq, no heimdall-brief binary, a malformed payload, any
# other heimdall-brief exit code - fails OPEN (exit 0, unchanged). A broken
# hook must never be the reason all work stops; only the one deliberate
# NON_VERIFIED branch above is allowed to block.
set -uo pipefail
# No `set -e`, on purpose: see "Everything else... fails OPEN" above. Under
# -e a single failed jq/wc call on an odd payload would kill the script with
# THAT command's own exit code, and since hooks.json pipes stdin straight
# into this script as its last, unguarded statement, an accidental nonzero
# here reads to Claude Code as a deny. The only deny this script may produce
# is the deliberate one below; every other path must reach `allow` on
# purpose, not by falling off a cliff.

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
BRIEF_BIN="$BIN_DIR/heimdall-brief"

INPUT="$(cat 2>/dev/null || true)"

# -- named-agent notice -------------------------------------------------------
if [ "${HEIMDALL_ALLOW_NAMED_AGENT:-}" != "1" ]; then
  TAIL="A named spawn goes MAILBOX-RESIDENT - the harness parks it to receive instructions via mailbox, so it never self-terminates and never returns a result to the spawn call. Do NOT await it (measured over 109 spawns in one session: 0 of 43 named ever completed, vs 59 of 66 unnamed) - collect its work another way. THE SPAWNER OWNS THE CLEANUP: call TaskStop on this agent once its work is done. TaskStop only reaches agents THIS session spawned, so a cross-session stop returns \"No task found with ID\". Find leaked ones with: bin/heimdall-agents orphans. If you did not want a mailbox, identify the work with description: instead of name: (convention R13). Set HEIMDALL_ALLOW_NAMED_AGENT=1 to silence this notice."
  if [ -z "$INPUT" ]; then
    printf '⚠️  BIFRÖST — Heimdall named-agent notice: the spawn payload was EMPTY, so a name: cannot be ruled out - warning rather than assuming this spawn is unnamed. %s\n' "$TAIL" >&2
  elif command -v jq >/dev/null 2>&1; then
    NAME="$(printf '%s' "$INPUT" | jq -r '.tool_input.name // empty' 2>/dev/null)"
    NAMERC=$?
    if [ "$NAMERC" -ne 0 ]; then
      printf '⚠️  BIFRÖST — Heimdall named-agent notice: the spawn payload could not be parsed, so a name: cannot be ruled out - warning rather than assuming this spawn is unnamed. %s\n' "$TAIL" >&2
    elif [ -n "$NAME" ]; then
      printf '⚠️  BIFRÖST — Heimdall named-agent notice: name: was set on the spawn. %s\n' "$TAIL" >&2
    fi
  fi
fi

# -- in-process agent concurrency cap (Task 3.1) -----------------------------
# WHY bin/agent-pool IS NOT REUSED HERE (read this before touching this
# section). The original design for this task
# (docs/superpowers/plans/2026-08-29-agent-fallback-coverage.md, Task 3.1)
# called for a bin/heimdall-agent-lease wrapper registering in-process spawns
# into the SAME ~/.heimdall/agent-pool.json ledger bin/session-fork's real
# subprocess forks share, released via a new hooks.json SubagentStop hook. A
# first attempt at exactly that shipped and was reverted after a measured
# production incident: an in-process Agent-tool spawn has no exec boundary
# (same architectural fact the adjudication fence below documents), so there
# is no real, liveness-checkable PID to pass to `agent-pool acquire`. Entries
# registered with pid=null skip agent-pool's dead-pid reap entirely
# (cmd_health_check's `if pid:` guard in bin/agent-pool is false for null),
# leaving only the 900s-default stale-idle reap as a backstop. Spawns arrived
# faster than that reap interval, so the SHARED pool's active count only
# ever grew: 10 phantom entries stuck "active" against max_agents=4, the
# statusline rendered them as permanently "working", and -- critically --
# every OTHER consumer of that same ledger broke too: `agent-pool wait`
# (bin/agent-pool cmd_wait) has its OWN 300s timeout, shorter than the 900s
# stale-idle threshold, so it hung its full 300s on every call while the
# phantom entries were outstanding -- which is what actually turned
# test/heimdall-maintain-loop.test.sh, heimdall-context-capsule and
# heimdall-watch-queue red. It also perturbed test/agent-name-gate.test.sh's
# section-scoped sed heuristic collaterally. Reverted in full; not repaired.
#
# The lesson: an agent with no PID must not occupy a slot in a ledger other
# subsystems trust for liveness, no matter how generous the TTL, because
# leak-vs-reap is a RACE and a shared, PID-liveness-checked pool is the wrong
# place to race it. So this section owns its OWN independent, self-expiring
# lease directory -- never agent-pool.json, never the agent-pool binary,
# never a hooks.json SubagentStop release (out of this task's file scope
# regardless) -- so nothing this section does can ever be observed by
# `agent-pool wait`, `should-scale`, the statusline, or bin/session-fork's
# real subprocess leases. The failure mode this section CAN produce is
# bounded to itself only: at worst it refuses (or briefly mis-counts) an
# in-process spawn -- it can never hang an unrelated consumer, because there
# is no shared file for one to wait on. This is option (a) of this task's
# decision list: count in-process agents without occupying agent-pool slots.
# (b) (register only with a verifiable pid) is unreachable by construction --
# there is no per-spawn OS pid an in-process subagent could ever supply --
# and (c) (report this as undoable) is unnecessary once (a) is available.
#
# NO RELEASE CALL, STATED PLAINLY: exactly like the shared pool's own gap,
# there is no exec boundary to hang an active release on, so a lease is
# NEVER actively freed -- only ever pruned by TTL, by whichever invocation of
# this hook happens to run next. This is the same trade the original plan
# accepted as its own fallback ("If U2 is REFUTED or UNMEASURABLE, Task 3.1
# falls back to TTL-only leasing, which its own spec already covers") --
# taken here from the start, since this section has no SubagentStop wiring
# to attempt an active release with in the first place.
#
# ANTI-GHOST: pruning runs FIRST, on every single invocation of this hook,
# before the count that decides allow/deny -- so an abandoned lease (a spawn
# that crashed, or simply finished with nothing to release it) can never
# survive longer than HEIMDALL_INPROC_AGENT_TTL past ITS OWN creation,
# regardless of how many later spawns arrive in the meantime or whether load
# ever "drains" (that load-dependent recovery is exactly what the incident
# above lacked -- leases arrived faster than the shared pool's reap
# interval, so it never caught up; here, every invocation prunes
# independently of arrival rate, so recovery time is bounded by wall clock,
# never by traffic).
#
# FAIL OPEN ON EVERYTHING except a confirmed at-or-over-capacity count -- the
# deliberate OPPOSITE of the adjudication fence directly below, which fails
# CLOSED because it answers a safety question (is this judge on a degraded
# model?). This section answers a resource-ceiling question (is there
# room?), and a ceiling that can wrongly refuse every future spawn is worse
# than no ceiling at all. So: missing jq, missing date, an
# uncreatable/uninspectable lease directory (e.g. a stray file already
# occupying that path), an unparsable lease (corrupt content is pruned as
# expired rather than trusted, so corruption biases toward ALLOW, never
# toward a phantom hold), and a hung filesystem (perl-alarm-bounded, same
# idiom the brief-adoption gate below already uses) all fall through to
# ALLOW with no exit reached. The only exit 2 in this section is a
# positively counted, in-range at-capacity reading.
#
# OPT-IN, NOT ON BY DEFAULT -- measured, not assumed. A default-on cap (max
# 10, matching bin/agent-pool's own default) was implemented first and run
# against this repo's own test/agent-fallback-adjudication.test.sh and
# test/agent-name-gate.test.sh, both of which fire many sequential
# precheck-agent invocations against ONE shared sandbox HOME within a
# single fast run. Every ALLOW stakes a lease that (correctly, by design
# above) only expires after HEIMDALL_INPROC_AGENT_TTL -- so within one
# sub-second test run none of those leases ever go stale, cumulative count
# crossed the default max partway through each suite, and later, unrelated
# assertions in BOTH suites turned red purely from this section's own
# bookkeeping (measured: 53/0 -> 46/7, 31/0 -> 23/8). That is not a
# test-harness quirk to work around: it is the SAME usage pattern this
# repo's own CLAUDE.md mandates ("2+ independent tasks -> spawn ALL agents
# in ONE message" / "launch parallel forks in one message"), which fires
# this hook 5-15+ times within a single turn -- far faster than any TTL
# measured in seconds could ever distinguish from a genuinely hung spawn.
# A concurrency cap with no release signal (there is none to wire, in or
# out of this task's scope) can only ever measure "spawns started within
# the last TTL", never "spawns still running" -- a RATE proxy standing in
# for a CONCURRENCY question. Defaulting it on would mean every routine
# batched fan-out in normal, encouraged use of this repo risked a false
# refusal. So: HEIMDALL_INPROC_AGENT_MAX is unset (disabled) unless an
# operator opts in explicitly -- the mechanism below is fully real and
# fully armed the moment it is set; this repo's own measured usage pattern
# is the reason it does not arm itself.
if command -v jq >/dev/null 2>&1 && command -v date >/dev/null 2>&1 && command -v bash >/dev/null 2>&1; then
  CAP_MAX="${HEIMDALL_INPROC_AGENT_MAX:-}"
  case "$CAP_MAX" in ''|*[!0-9]*) CAP_MAX="" ;; esac
  CAP_TTL="${HEIMDALL_INPROC_AGENT_TTL:-900}"
  case "$CAP_TTL" in ''|*[!0-9]*) CAP_TTL=900 ;; esac
  CAP_DIR="${HEIMDALL_HOME:-${HOME:-/tmp}/.heimdall}/inproc-agent-leases"

  if [ -n "$CAP_MAX" ]; then
    # cap_body: the ENTIRE prune -> count -> decide -> stake sequence, as one
    # function so it can be shipped whole into a guarded subshell below via
    # `declare -f` + `bash -c` -- one alarm bounds the whole sequence, not
    # each filesystem call individually, at zero added latency in the
    # success path (perl execs straight into it; no polling loop).
    cap_body() {
      local dir="$1" ttl="$2" max="$3" now f ts age count id
      mkdir -p "$dir" 2>/dev/null || { echo "OPEN:mkdir"; return 1; }
      now="$(date +%s 2>/dev/null)" || { echo "OPEN:date"; return 1; }
      case "$now" in ''|*[!0-9]*) echo "OPEN:date-bad"; return 1 ;; esac
      # Prune every stale/unparsable lease FIRST (anti-ghost self-heal),
      # before the count below ever runs -- see header.
      for f in "$dir"/lease-*; do
        [ -e "$f" ] || continue
        ts="$(cat "$f" 2>/dev/null)"
        case "$ts" in
          ''|*[!0-9]*) rm -f "$f" 2>/dev/null; continue ;;
        esac
        age=$(( now - ts ))
        if [ "$age" -gt "$ttl" ] || [ "$age" -lt 0 ]; then
          rm -f "$f" 2>/dev/null
        fi
      done
      count=0
      for f in "$dir"/lease-*; do
        [ -e "$f" ] || continue
        count=$((count+1))
      done
      if [ "$count" -ge "$max" ]; then
        echo "DENY:$count:$max"
        return 2
      fi
      # Stake a lease for THIS spawn before allowing it through, so the very
      # next invocation counts it. A failed write is ignored on purpose --
      # this spawn simply undercounts itself, which is the fail-open side.
      id="lease-$$-$now-${RANDOM:-0}"
      printf '%s' "$now" > "$dir/$id" 2>/dev/null
      echo "ALLOW:$((count+1)):$max"
      return 0
    }
    CAP_FNSRC="$(declare -f cap_body)"
    CAP_CALL='
cap_body "$@"'
    if command -v perl >/dev/null 2>&1; then
      CAP_OUT="$(perl -e 'alarm 3; exec @ARGV' -- bash -c "$CAP_FNSRC$CAP_CALL" _ "$CAP_DIR" "$CAP_TTL" "$CAP_MAX" 2>/dev/null)"
    else
      CAP_OUT="$(bash -c "$CAP_FNSRC$CAP_CALL" _ "$CAP_DIR" "$CAP_TTL" "$CAP_MAX" 2>/dev/null)"
    fi
    CAP_RC=$?
    if [ "$CAP_RC" -eq 2 ]; then
      CAP_COUNTS="${CAP_OUT#DENY:}"
      CAP_REASON="BIFROST - Heimdall in-process agent concurrency cap: ${CAP_COUNTS%%:*}/${CAP_COUNTS##*:} in-process Agent-tool spawns already outstanding (an independent lease count under $CAP_DIR -- never the shared bin/agent-pool ledger, so this cannot wedge agent-pool wait, should-scale, the statusline, or any subprocess lease). Resource ceiling, not a safety gate -- every lease self-expires after HEIMDALL_INPROC_AGENT_TTL=${CAP_TTL}s even though nothing here ever actively releases one (no exec boundary to hang a release on), so this cannot deadlock. Retry shortly, or raise the ceiling: HEIMDALL_INPROC_AGENT_MAX=<n>."
      CAP_JSON="$(jq -cn --arg r "$CAP_REASON" '{error: $r}' 2>/dev/null)"
      if [ -z "$CAP_JSON" ]; then
        CAP_JSON='{"error": "BIFROST - Heimdall in-process agent concurrency cap: at capacity; spawn refused (see stderr for detail)."}'
      fi
      printf '%s\n' "$CAP_JSON"
      printf '%s\n' "$CAP_REASON" >&2
      exit 2
    fi
    # CAP_RC 0 (allowed + leased) or anything else (1 = ambiguous/open path
    # from inside cap_body, or a perl-alarm signal-kill code) falls through
    # here on purpose -- no exit, no `else`: silence is allow.
  fi
fi

# -- adjudication fallback fence (Task 1.1; trigger fixed post-launch) ------
# D2 (docs/superpowers/plans/2026-08-29-agent-fallback-coverage.md §0.3): an
# in-process Agent-tool subagent has no exec boundary, so hmd_gate_exec
# (bin/lib/hmd-gate-endpoint.sh) cannot reach it -- if THIS session's own
# ANTHROPIC_BASE_URL is the live OmniRoute fallback endpoint, every in-process
# subagent silently inherits it, including hmd:reviewer/verifier/
# security-auditor. A judge on a degraded free-tier model emits confident
# FALSE GREENS.
#
# TRIGGER, FIXED: live orchestrator testing found a real hole the first
# version of this fence (and its own test suite) missed. That version
# re-queried `heimdall-fallback base-url` FRESH on every spawn and matched
# only when the fresh call positively re-confirmed a CURRENT ROUTE verdict.
# But ANTHROPIC_BASE_URL is set ONCE, at session launch, from whatever the
# gate said THEN, and never changes again for the rest of that session's
# life -- while a fresh call re-evaluates the gate live, right now. Once
# quota resets (or anything else the gate reads changes) mid-session, the
# fresh call starts returning WAIT (empty stdout, cmd_base_url's own
# non-ROUTE contract) even though the PARENT's inherited ANTHROPIC_BASE_URL
# still points at the gateway from launch -- so the fresh-match condition
# silently went false and this fence stopped firing for the rest of that
# session, exactly while the danger it exists to catch was still live. Fixed
# by keying the trigger on the INHERITED ENV VAR ITSELF (what actually routes
# an in-process subagent's calls) instead of any live re-verification of it,
# so the fence cannot go stale relative to the one thing it protects.
#
# WHY "ANY LOOPBACK", NOT "ONLY .heimdall/fallback.json's CONFIGURED
# ENDPOINT": that config is exactly the same kind of re-readable current
# state the fresh base-url call was -- it can be absent, rewritten, or point
# at a new port across an OmniRoute restart, so matching it would just move
# the identical staleness risk to a different file, not remove it. A
# loopback-shaped ANTHROPIC_BASE_URL (127.0.0.0/8, localhost, ::1) is never a
# legitimate destination for a real adjudication call no matter which port a
# gateway happens to be using this session, and api.anthropic.com (or unset)
# is never loopback -- so this stays precisely clear of the one false
# positive that matters (see the design-constraint bullet below). Fencing a
# non-OmniRoute local proxy that happens to also sit on loopback is accepted
# as the safe direction, same logic bin/lib/hmd-adjudication-set.sh's own
# header uses for over-matching a TYPE: a judge denied by mistake is a small
# cost, a judge that silently runs on a degraded free tier is the false
# green this project exists to prevent.
#
# This is the one deliberate deny in this file: it fires only when BOTH
# conditions below hold (fail-closed on the safety question) -- any inability
# to confirm either one -- no jq, no heimdall-fallback binary (meaning this
# repo has no fallback tooling installed at all, so there is no subsystem a
# loopback URL here could even be evidence of), a malformed payload, or a
# missing classification lib -- falls all the way through to the
# brief-adoption gate below unchanged (fail-open on the plumbing question).
# The disclosure half has only ONE dependency (the heimdall-fallback binary
# being installed + ANTHROPIC_BASE_URL looking like loopback) and fires
# regardless of bin/lib/hmd-adjudication-set.sh's presence -- only the DENY
# additionally needs that lib, since only the deny needs to classify a type.
# Runs independently of, and ahead of, the brief-adoption gate below: no
# variable computed here is read by it, and none of its variables are read
# here (the ADJ_ prefix keeps them from colliding by accident).
if [ -n "$INPUT" ] && command -v jq >/dev/null 2>&1; then
  ADJ_FALLBACK_BIN="$BIN_DIR/heimdall-fallback"
  ADJ_SET_LIB="$BIN_DIR/lib/hmd-adjudication-set.sh"
  if [ -x "$ADJ_FALLBACK_BIN" ]; then
    # -- env-loopback trigger (the fix) --
    # The env var itself, exactly as THIS process inherited it at spawn time
    # -- never a fresh re-query of anything. See header: this is the whole
    # fix. No perl/timeout wrapper needed any more either: a pure string
    # match on an already-inherited env var cannot hang or time out.
    ADJ_ENV_URL="${ANTHROPIC_BASE_URL:-}"
    case "$ADJ_ENV_URL" in
      http://127.*|https://127.*|http://localhost*|https://localhost*|http://\[::1\]*|https://\[::1\]*)
        ADJ_TRIGGERED=1 ;;
      *)
        ADJ_TRIGGERED=0 ;;
    esac
    # -- end env-loopback trigger --
    if [ "$ADJ_TRIGGERED" = 1 ]; then
      # Disclosure: ALWAYS, for every spawn that reaches this branch, never
      # silenceable -- no env var opts a caller out of being told its
      # judgment posture may have changed.
      printf 'BIFROST - Heimdall fallback-routing disclosure: this spawn inherits ANTHROPIC_BASE_URL=%s, a loopback address consistent with the OmniRoute fallback gateway, not api.anthropic.com. That endpoint may serve a free/no-auth-tier provider whose data-retention posture is not guaranteed to match api.anthropic.com. Generation may run on this path; judgment may not (see bin/lib/hmd-gate-endpoint.sh).\n' "$ADJ_ENV_URL" >&2

      if [ -f "$ADJ_SET_LIB" ] && . "$ADJ_SET_LIB" 2>/dev/null && command -v hmd_is_adjudication >/dev/null 2>&1; then
        ADJ_SATYPE="$(printf '%s' "$INPUT" | jq -r '.tool_input.subagent_type // empty' 2>/dev/null)" || ADJ_SATYPE=""
        if [ -n "$ADJ_SATYPE" ] && hmd_is_adjudication "$ADJ_SATYPE"; then
          ADJ_REASON="BIFROST - Heimdall adjudication deny: subagent_type '$ADJ_SATYPE' is an adjudication agent (it emits a verdict, score, pass/fail, or approval) and this session's ANTHROPIC_BASE_URL ($ADJ_ENV_URL) is a loopback address consistent with the live OmniRoute fallback gateway, not api.anthropic.com. A judge running on a degraded/free-tier model emits confident false greens, which this project exists to prevent -- so this spawn is refused outright rather than silently degraded. Remedies: (1) run this judge as a SUBPROCESS through hmd_gate_exec (bin/lib/hmd-gate-endpoint.sh) or bin/lib/hmd-route-claude with HMD_JUDGMENT=1, both of which pin the real provider and scrub every routing var; or (2) restart this session unrouted (fallback gate not at ROUTE) and re-spawn. This deny has no bypass flag."
          ADJ_JSON="$(jq -cn --arg r "$ADJ_REASON" '{error: $r}' 2>/dev/null)"
          if [ -z "$ADJ_JSON" ]; then
            ADJ_JSON='{"error": "BIFROST - Heimdall adjudication deny: an adjudication spawn was refused on a fallback-routed session (the reason text could not be JSON-encoded; see stderr for the full message)."}'
          fi
          printf '%s\n' "$ADJ_JSON"
          printf '%s\n' "$ADJ_REASON" >&2
          exit 2
        fi
      fi
    fi
  fi
fi

# -- coop native-spawn refusal fence -----------------------------------------
# coop (4th fallback state, beside off/auto/switch -- bin/heimdall-fallback
# header point 13) routes ONLY an explicit, hand-curated allowlist of
# subagent roles (`heimdall-fallback coop add/remove/list`) to the OmniRoute
# gateway, while the MAIN session never routes at all -- that asymmetry is
# coop's entire defining property. Per-role divergence is real, but only on
# ONE path: bin/lib/hmd-route-claude's generation branch threads
# HMD_AGENT_TYPE through `heimdall-route claude` -> `heimdall-fallback
# base-url` -> _routing_decision, and each headless `claude -p` spawn
# (bin/hmd-exec and its callers: session-fork, decompose, heimdall-drain,
# benchmark) is a fresh `exec` with its own env block -- so one such spawn
# CAN see the gateway while another, in the same repo at the same moment,
# sees api.anthropic.com.
#
# The Agent tool is a DIFFERENT mechanism and cannot do this. Every spawn
# that reaches this hook at all is, by construction, the in-process/native
# Task-tool path -- there is no other tool_name this file is wired to gate
# (see hooks/hooks.json). A native subagent shares this session's own
# process env wholesale (no exec boundary of its own -- the same fact the
# adjudication fence above already depends on); nothing in the documented
# PreToolUse contract (hookSpecificOutput.updatedInput rewrites tool_input
# fields only -- prompt, description, etc, never a per-child env block) or
# in the Agent tool's own parameter schema (description/isolation/mode/
# model/name/prompt/subagent_type/team_name -- no env field at all) gives a
# hook any way to hand one native child a different ANTHROPIC_BASE_URL than
# its sibling. So a coop-listed role spawned THIS way cannot actually route,
# no matter what bin/heimdall-fallback's config says -- it would silently
# inherit the unrouted main session's env and run on api.anthropic.com
# while the operator, having deliberately added it to the coop allowlist,
# reasonably believes it is on the gateway. Silently doing the wrong thing
# in a correct-looking way is worse than refusing outright: this fence
# refuses instead.
#
# A role that is NOT coop-listed (or is adjudication, or coop is not even
# the active state) needs no refusal -- it was always going to inherit the
# main session's own env and land on api.anthropic.com, which is exactly
# correct for it. So this only ever denies the one combination that is
# actually broken: state==coop AND this subagent_type would positively
# resolve to ROUTE if only the env divergence were possible -- never
# anything else.
#
# Verdict by delegation, not a second copy of the allowlist:
# `heimdall-fallback check --role <type>` runs the exact same
# run_preflight/_verdict/_coop_role_allowed chain cmd_base_url itself uses
# for a real routed spawn (that file's own words: "two independent copies
# of a routing decision is how a gate starts saying ROUTE while the real
# gate says REFUSE" -- applies here too). rc==0 (ROUTE) is the only thing
# that ever denies; REFUSE (not listed, is adjudication, or any other
# preflight check failing) or WAIT is always allowed through, matching
# what actually happens to its env either way.
#
# Cheap gate first: a raw on-disk `.state` read (`heimdall-fallback where`
# + a local jq parse -- no run_preflight, no DB query, no HTTP reachability
# probe) decides whether the heavier `check --role` call is worth paying
# for at all, so the overwhelmingly common case (coop never configured, or
# fallback tooling entirely absent) costs one cheap subprocess plus one
# local file read, nothing more. This can only ever OVER-trigger the
# heavier call relative to the fully-validated config (load_config's own
# corruption handling migrates an invalid state to 'off', never invents
# 'coop' from anything else -- see that function's docstring), so a
# mismatch here can never cause a wrong deny: the heavier, authoritative
# call is always what actually decides.
#
# Fails OPEN on every plumbing gap (missing jq, missing binary, unreadable/
# corrupt config, unresolvable subagent_type, a `check --role` call that
# errors) -- same direction the adjudication fence above takes, and for the
# same reason: the unsafe outcome of a broken fence here is "coop's routing
# silently doesn't happen for a listed role" (a strictly SMALLER harm than
# today, before this fence existed), never "the Agent tool stops working
# for every spawn on any machine where heimdall-fallback is momentarily
# unavailable." Only a POSITIVELY confirmed state==coop + ROUTE verdict
# ever denies.
if [ -n "$INPUT" ] && command -v jq >/dev/null 2>&1; then
  COOP_FALLBACK_BIN="$BIN_DIR/heimdall-fallback"
  if [ -x "$COOP_FALLBACK_BIN" ]; then
    COOP_CFG_PATH="$("$COOP_FALLBACK_BIN" --repo "$PWD" where 2>/dev/null)" || COOP_CFG_PATH=""
    if [ -n "$COOP_CFG_PATH" ] && [ -f "$COOP_CFG_PATH" ]; then
      COOP_STATE="$(jq -r '.state // empty' "$COOP_CFG_PATH" 2>/dev/null)" || COOP_STATE=""
      if [ "$COOP_STATE" = "coop" ]; then
        COOP_SATYPE="$(printf '%s' "$INPUT" | jq -r '.tool_input.subagent_type // empty' 2>/dev/null)" || COOP_SATYPE=""
        if [ -n "$COOP_SATYPE" ]; then
          if "$COOP_FALLBACK_BIN" --repo "$PWD" check --role "$COOP_SATYPE" >/dev/null 2>&1; then
            COOP_REASON="BIFROST - Heimdall coop deny: subagent_type '$COOP_SATYPE' is on the coop allowlist (heimdall-fallback coop list) and would ROUTE to the OmniRoute gateway -- but the Agent tool's native spawn mechanism shares this session's own process env wholesale and has no per-child env-injection point, so it cannot actually honor that routing. Spawning it this way would silently leave it on api.anthropic.com while coop's own config says it should be on the gateway. Remedy: dispatch this role through hmd's headless path instead (bin/hmd-exec / bin/session-fork, which set HMD_AGENT_TYPE on a genuinely separate exec'd process before bin/lib/hmd-route-claude ever runs) -- that path is where coop's per-role divergence actually works. This deny has no bypass flag."
            COOP_JSON="$(jq -cn --arg r "$COOP_REASON" '{error: $r}' 2>/dev/null)"
            if [ -z "$COOP_JSON" ]; then
              COOP_JSON='{"error": "BIFROST - Heimdall coop deny: a coop-listed role was refused on the native Agent-tool spawn path (the reason text could not be JSON-encoded; see stderr for the full message)."}'
            fi
            printf '%s\n' "$COOP_JSON"
            printf '%s\n' "$COOP_REASON" >&2
            exit 2
          fi
        fi
      fi
    fi
  fi
fi
# -- end coop native-spawn refusal fence --------------------------------------

# -- brief-adoption gate -------------------------------------------------------
allow() { exit 0; }

[ -n "$INPUT" ] || allow
command -v jq >/dev/null 2>&1 || allow

TOOL_INPUT="$(printf '%s' "$INPUT" | jq -c '.tool_input // {}' 2>/dev/null)" || TOOL_INPUT="{}"
PROMPT="$(printf '%s' "$TOOL_INPUT" | jq -r '.prompt // empty' 2>/dev/null)" || PROMPT=""
SATYPE="$(printf '%s' "$TOOL_INPUT" | jq -r '.subagent_type // empty' 2>/dev/null)" || SATYPE=""

[ "${HEIMDALL_ALLOW_LONG_BRIEF:-}" != "1" ] || allow
[ "$SATYPE" != "fork" ] || allow
[ -n "$PROMPT" ] || allow
case "$PROMPT" in
  "=== DELTA BRIEF"*) allow ;;
esac

WC="$(printf '%s' "$PROMPT" | wc -w | tr -d ' ')"
case "$WC" in ''|*[!0-9]*) allow ;; esac
THRESH="${HEIMDALL_BRIEF_WORD_THRESHOLD:-300}"
case "$THRESH" in ''|*[!0-9]*) THRESH=300 ;; esac
[ "$WC" -gt "$THRESH" ] || allow

[ -x "$BRIEF_BIN" ] || allow

TASK="brief-$(date +%s)-$$"
ERRFILE="$(mktemp 2>/dev/null || printf '/tmp/hmd-precheck-agent.%s' "$$")"
trap 'rm -f "$ERRFILE"' EXIT

if command -v perl >/dev/null 2>&1; then
  BRIEF_OUT="$(perl -e 'alarm 5; exec @ARGV' -- "$BRIEF_BIN" build --task "$TASK" --spec "$PROMPT" 2>"$ERRFILE")"
else
  BRIEF_OUT="$("$BRIEF_BIN" build --task "$TASK" --spec "$PROMPT" 2>"$ERRFILE")"
fi
BRIEF_RC=$?

case "$BRIEF_RC" in
  0)
    NEW_TOOL_INPUT="$(printf '%s' "$TOOL_INPUT" | jq -c --arg p "$BRIEF_OUT" '.prompt = $p' 2>/dev/null)" || allow
    [ -n "$NEW_TOOL_INPUT" ] || allow
    printf 'BIFROST - Heimdall brief-adoption notice: spawn prompt was %s words (over %s) with no heimdall-brief header - auto-built one via heimdall-brief (task %s) and substituted it into the spawn. The spawned agent should read its own === DELTA BRIEF header for the task id and report back via heimdall-task-result done --task %s --status pass|fail|partial --from <role> --what <text>. Set HEIMDALL_ALLOW_LONG_BRIEF=1 to opt a spawn out.\n' "$WC" "$THRESH" "$TASK" "$TASK" >&2
    jq -cn --argjson ti "$NEW_TOOL_INPUT" \
      '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "allow", updatedInput: $ti}}'
    exit 0
    ;;
  3)
    ERRTXT="$(cat "$ERRFILE" 2>/dev/null)"
    MSG="$(jq -cn --arg task "$TASK" --arg err "$ERRTXT" \
      '{error: ("BIFROST - Heimdall brief-adoption notice: spawn prompt has no heimdall-brief header, and heimdall-brief reports NON_VERIFIED for it - the protocol store could not be checked, not merely found empty. Substituting a brief here would claim context was verified when it was not, so this spawn is refused instead of silently let through. Run the exact command yourself: heimdall-brief build --task " + $task + " --spec <text> -- then fix the store (make .planning/protocol writable) and retry the spawn. --- " + $err)}' 2>/dev/null)"
    if [ -z "$MSG" ]; then
      MSG='{"error": "BIFROST - Heimdall brief-adoption notice: heimdall-brief reports NON_VERIFIED and the failure detail could not be JSON-encoded. Run heimdall-brief build --task <id> --spec <text> yourself to see it."}'
    fi
    printf '%s\n' "$MSG"
    printf '%s\n' "$MSG" >&2
    exit 2
    ;;
  *)
    allow
    ;;
esac
