#!/usr/bin/env bash
# heimdall-dream-bundle — build and inspect the hmd-dream code-signing identity.
#
# WHY THIS EXISTS.
#   A LaunchAgent's ProgramArguments[0], resolved through `#!/usr/bin/env bash` under
#   launchd's minimal PATH, is plain /bin/bash — a SHARED SYSTEM INTERPRETER. macOS keys a
#   Full Disk Access grant to the exact code identity asked, so granting it to /bin/bash
#   grants it to every bash script on the machine, forever. That is the broadest possible
#   grant heimdall-dream-permission can offer, and it offers it honestly, but "honestly
#   broad" is still broad. This tool builds a PRIVATE, single-purpose copy of bash, signed
#   under Heimdall's own identifier, so a grant can instead land on exactly one thing:
#   heimdall's own nightly job and nothing else that happens to also be bash.
#
# MEASURED, NOT ASSUMED.
#   A bare copy of /bin/bash does not run — it is Killed: 9 on exec, because Apple platform
#   binaries carry a flag that ties them to trust-cache validation at their ORIGINAL path.
#   Ad-hoc re-signing (`codesign --force -s -`) strips that flag; the result runs, bare or
#   inside a bundle. Signing the .app as a bundle additionally makes macOS display it by
#   NAME (CFBundleName / CFBundleDisplayName) instead of a raw path — this is what lets
#   Full Disk Access show a row literally named "hmd-dream". Two independent builds in
#   different directories, and a third with a forced different mtime, all produced the
#   BYTE-IDENTICAL CDHash: path and mtime do not affect the signature, only content does.
#   `spctl` rejects the ad-hoc signature ("Insufficient Context") — expected and
#   irrelevant, since launchd execs ProgramArguments directly and never consults Gatekeeper.
#
# DETERMINISM IS THE WHOLE POINT, AND IT IS FRAGILE ON PURPOSE.
#   Same bash bytes + the same fixed Info.plist bytes + the same identifier always produce
#   the same CDHash, which is what lets a grant survive an unrelated Heimdall update: a
#   rebuild that changes nothing real changes nothing signed. But if the SOURCE bash itself
#   changes (a macOS update), the new copy legitimately gets a NEW identity — and a Full
#   Disk Access grant keyed to the old one silently stops applying. That is not a bug this
#   tool can fix (TCC keys grants to identity by design) — it is a fact `build` records
#   every time (dream-identity.json: cdhash + previous_cdhash + changed) so
#   heimdall-dream-permission can detect the drift and ask again instead of assuming a past
#   grant holds forever.
#
# THIS NEVER TOUCHES TCC. It only produces and inspects a code-signed artifact — the same
# category of action as compiling a program. Whether Full Disk Access is ever granted to
# it is a human decision made in System Settings, handled entirely by
# heimdall-dream-permission.
#
# COMMANDS
#   build    [--out DIR] [--json]   (re)build the bundle at DIR/hmd-dream.app (default DIR:
#                                    $HEIMDALL_HOME/bin), sign it, record its identity
#   identity [--out DIR] [--json]   report the CURRENTLY installed bundle's identity,
#                                    recomputed live from disk — never trusted from a cache
#
# ENV
#   HEIMDALL_HOME               state dir (default $HOME/.heimdall)
#   HEIMDALL_DREAM_IDENTITY     identity record path (default $HEIMDALL_HOME/dream-identity.json)
#   HEIMDALL_DREAM_BUNDLE_BASH  source interpreter to copy+sign (default /bin/bash — a test
#                                seam only; the real bundle always ships whatever bash this
#                                machine actually has)
#
# EXIT
#   0  ok · 2  usage / unsupported platform / missing tool · 3  build failure

set -euo pipefail

SELF="$0"
IDENTIFIER="dev.runheimdall.hmd-dream"
BUNDLE_NAME="hmd-dream.app"
EXEC_NAME="hmd-dream"

HEIMDALL_HOME="${HEIMDALL_HOME:-$HOME/.heimdall}"
IDENT_FILE="${HEIMDALL_DREAM_IDENTITY:-$HEIMDALL_HOME/dream-identity.json}"
SRC_BASH="${HEIMDALL_DREAM_BUNDLE_BASH:-/bin/bash}"
DEFAULT_OUT="$HEIMDALL_HOME/bin"

usage() { sed -n '2,32p' "$SELF" | sed 's/^# \{0,1\}//'; }
die() { printf 'heimdall-dream-bundle: %s\n' "$1" >&2; exit "${2:-2}"; }

is_macos() { [ "$(uname -s)" = "Darwin" ]; }

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# read_field <file> <key> — same shape as heimdall-dream-permission's json_field, kept
# local rather than shared: each dream-* tool already carries its own small copy of this
# (see json_escape() drifting slightly between runner/schedule/permission already), and a
# tiny sed one-liner is not worth a cross-file dependency for a tool that must also work
# standalone.
read_field() {
  [ -f "$1" ] || return 0
  sed -n "s/^[[:space:]]*\"$2\"[[:space:]]*:[[:space:]]*\"\(.*\)\"[[:space:]]*,\{0,1\}[[:space:]]*\$/\1/p" \
    "$1" 2>/dev/null | head -1 || true
}

bundle_paths() { # bundle_paths <out-dir> — sets BUNDLE_DIR / BUNDLE_EXEC
  BUNDLE_DIR="$1/$BUNDLE_NAME"
  BUNDLE_EXEC="$BUNDLE_DIR/Contents/MacOS/$EXEC_NAME"
}

# THE FIXED, MINIMAL Info.plist. Nine keys — every one of them a constant, none of them a
# path or a timestamp — because determinism means the ONLY thing allowed to change the
# signed bytes between builds is the source bash itself. CFBundleName and
# CFBundleDisplayName are both set to the literal string "hmd-dream": LaunchServices
# prefers CFBundleDisplayName, falling back to CFBundleName, so setting both to the same
# value is what makes System Settings' Full Disk Access list show "hmd-dream" rather than
# a raw path — verified directly (PlistBuddy -c 'Print :CFBundleDisplayName') against a
# real build of this exact plist, not assumed from the key names.
info_plist_xml() {
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$EXEC_NAME</string>
	<key>CFBundleIdentifier</key>
	<string>$IDENTIFIER</string>
	<key>CFBundleName</key>
	<string>$EXEC_NAME</string>
	<key>CFBundleDisplayName</key>
	<string>$EXEC_NAME</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
EOF
}

# cdhash_of <path> — recompute LIVE from disk via codesign. Never read from a cache: the
# whole point of this tool is to notice when the on-disk artifact no longer matches what
# a past grant was made against, and a cached answer cannot do that.
cdhash_of() {
  command -v codesign >/dev/null 2>&1 || return 0
  codesign -dvvv "$1" 2>&1 | sed -n 's/^CDHash=//p' | head -1 || true
}

cmd_build() {
  local out="$DEFAULT_OUT" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out="${2:-}"; shift 2 ;;
      --json) json=1; shift ;;
      *) die "build: unknown argument: $1" ;;
    esac
  done
  is_macos || die "hmd-dream is a macOS code-signing artifact; this host is $(uname -s)"
  command -v codesign >/dev/null 2>&1 || die "codesign not found — cannot sign the bundle"
  [ -r "$SRC_BASH" ] || die "source interpreter unreadable: $SRC_BASH"

  bundle_paths "$out"
  local prev_cdhash=""
  if [ -f "$IDENT_FILE" ]; then
    prev_cdhash="$(read_field "$IDENT_FILE" cdhash)" || true
  fi

  mkdir -p "$BUNDLE_DIR/Contents/MacOS" || die "mkdir failed: $BUNDLE_DIR" 3
  cp "$SRC_BASH" "$BUNDLE_EXEC" || die "copy failed: $SRC_BASH -> $BUNDLE_EXEC" 3
  chmod 0755 "$BUNDLE_EXEC" || die "chmod failed: $BUNDLE_EXEC" 3
  info_plist_xml > "$BUNDLE_DIR/Contents/Info.plist" || die "plist write failed" 3

  local sign_err
  sign_err="$(mktemp "${TMPDIR:-/tmp}/hmd-dream-bundle-sign.XXXXXX" 2>/dev/null || printf '/dev/null')"
  if ! codesign --force -s - --identifier "$IDENTIFIER" "$BUNDLE_DIR" >/dev/null 2>"$sign_err"; then
    die "codesign failed: $(cat "$sign_err" 2>/dev/null)" 3
  fi
  rm -f "$sign_err" 2>/dev/null || true

  local cdhash
  cdhash="$(cdhash_of "$BUNDLE_DIR")" || true
  [ -n "$cdhash" ] || die "codesign succeeded but no CDHash could be read back" 3

  local changed="false"
  if [ -n "$prev_cdhash" ] && [ "$prev_cdhash" != "$cdhash" ]; then changed="true"; fi

  mkdir -p "$HEIMDALL_HOME" 2>/dev/null || true
  local tmp
  tmp="$IDENT_FILE.$$.tmp"
  cat > "$tmp" <<EOF
{
  "schema": 1,
  "identifier": "$(json_escape "$IDENTIFIER")",
  "path": "$(json_escape "$BUNDLE_DIR")",
  "executable": "$(json_escape "$BUNDLE_EXEC")",
  "display_name": "$(json_escape "$EXEC_NAME")",
  "cdhash": "$(json_escape "$cdhash")",
  "previous_cdhash": "$(json_escape "$prev_cdhash")",
  "changed": "$changed",
  "built_ts": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
  mv -f "$tmp" "$IDENT_FILE" 2>/dev/null || rm -f "$tmp" 2>/dev/null || true

  if [ "$json" = "1" ]; then
    cat <<EOF
{
  "ok": "true",
  "path": "$(json_escape "$BUNDLE_DIR")",
  "executable": "$(json_escape "$BUNDLE_EXEC")",
  "identifier": "$(json_escape "$IDENTIFIER")",
  "display_name": "$(json_escape "$EXEC_NAME")",
  "cdhash": "$(json_escape "$cdhash")",
  "previous_cdhash": "$(json_escape "$prev_cdhash")",
  "changed": "$changed"
}
EOF
  else
    echo "built: $BUNDLE_EXEC"
    echo "identifier: $IDENTIFIER"
    echo "display_name: $EXEC_NAME"
    echo "cdhash: $cdhash"
    if [ "$changed" = "true" ]; then
      echo "NOTE: identity changed since the last build (was $prev_cdhash)."
      echo "      A Full Disk Access grant made against the old binary no longer applies."
    fi
  fi
}

cmd_identity() {
  local out="$DEFAULT_OUT" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out="${2:-}"; shift 2 ;;
      --json) json=1; shift ;;
      *) die "identity: unknown argument: $1" ;;
    esac
  done
  bundle_paths "$out"
  if [ ! -x "$BUNDLE_EXEC" ]; then
    if [ "$json" = "1" ]; then
      printf '{\n  "exists": "false"\n}\n'
    else
      echo "not built: $BUNDLE_EXEC"
    fi
    return 1
  fi
  local cdhash
  cdhash="$(cdhash_of "$BUNDLE_DIR")" || true
  if [ "$json" = "1" ]; then
    cat <<EOF
{
  "exists": "true",
  "path": "$(json_escape "$BUNDLE_DIR")",
  "executable": "$(json_escape "$BUNDLE_EXEC")",
  "identifier": "$(json_escape "$IDENTIFIER")",
  "display_name": "$(json_escape "$EXEC_NAME")",
  "cdhash": "$(json_escape "${cdhash:-}")"
}
EOF
  else
    echo "path: $BUNDLE_DIR"
    echo "executable: $BUNDLE_EXEC"
    echo "identifier: $IDENTIFIER"
    echo "display_name: $EXEC_NAME"
    echo "cdhash: ${cdhash:-unknown}"
  fi
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
CMD="$1"; shift
case "$CMD" in
  -h|--help) usage; exit 0 ;;
  build)     cmd_build "$@" ;;
  identity)  cmd_identity "$@" ;;
  *) echo "error: unknown command: $CMD" >&2; usage >&2; exit 2 ;;
esac
