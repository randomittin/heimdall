#!/usr/bin/env python3
"""heimdall-receipt -- `hmd receipt`: verify, keygen, render, serve for runhmd.receipt/1 (RP3).

Thin launcher: the logic lives in bin/lib/runhmd_receipt_cli.py (and runhmd_receipt.py,
runhmd_receipt_site.py) so tests and `hmd attack --receipt` can import it. See
`hmd receipt --help` for flags and exit codes (0 ok, 1 invalid receipt, 2 usage or
configuration, 5 infrastructure).
"""
import os
import signal
import sys

if hasattr(signal, "SIGPIPE"):
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # `hmd receipt verify ... | head -1` ends quietly
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))

from runhmd_receipt_cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
