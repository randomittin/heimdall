#!/usr/bin/env bash
# bin/heimdall-stop-lint — run the project's REAL linter over this session's
# edited files at Stop, and make the lint gate reflect that run.
#
# WHY THIS EXISTS
# ---------------
# `heimdall-state check-quality-gates` reads `.quality_gates.lint_clean` — a
# boolean that, until this tool, was only ever flipped by hand
# (`heimdall-state mark-clean` sets it true without running anything). A gate
# whose green can be produced without evidence is not a gate; it is a claim.
# docs/analysis/2026-09-19-ecc-harness-gap-analysis.md ranked closing this
# gap #2: ECC (everything-claude-code) catches type/lint breakage on the very
# turn that introduced it by running linters per edit and again, batched, at
# Stop. ECC had to build an accumulator of edited paths to do that
# (post-edit-accumulator.js). hmd already has one — `bin/edit-tracker paths`
# lists every file the session's Write/Edit calls touched — so the missing
# piece is only the consumer.
#
# WHAT IT DOES
# ------------
#   1. `edit-tracker paths` → keep the ones that still exist as regular files
#      AND live inside --repo. Dropped: anything outside the repo (the Claude
#      scratchpad under $TMPDIR, /private/tmp/claude-*, another checkout, a
#      `..` escape) and, relative to the repo root, `.claude/worktrees/` (stale
#      agent worktrees), `.heimdall/` (generated hooks) and any `node_modules/`.
#      The test is repo-relative, never an absolute-path pattern, so a session
#      whose repo IS a worktree still lints its own files. The receipt's
#      `excluded` counts what was dropped.
#      Nothing edited (or everything excluded) → exit 0, print nothing.
#   2. Group by language on extension: shell (.sh/.bash), python (.py),
#      js/ts (.js/.jsx/.mjs/.cjs/.ts/.tsx).
#   3. Detect what the REPO already uses; never install anything:
#        shell   bash -n (always)  +  shellcheck -S <severity> -f json if on
#                PATH (default severity warning; see WHAT COUNTS AS A
#                SHELLCHECK FINDING below)
#        python  python3 -c ast.parse (always)  +  ruff check --output-format
#                json if on PATH AND the repo carries ruff.toml / .ruff.toml /
#                pyproject.toml
#        js/ts   biome lint --reporter=json  if biome.json(c) present and
#                       node_modules/.bin/biome (or PATH biome) exists
#                eslint if an eslint config is present and node_modules/.bin/
#                       eslint (or PATH eslint) exists; package.json
#                       scripts.lint naming "eslint"/"biome" is an accepted
#                       hint when the config file lives elsewhere. Runs
#                       `eslint --no-fix -f json -o <tmp> <file>`: json is core
#                       in ESLint 8 AND 9 (the unix formatter is gone in 9) and
#                       --output-file keeps Node's stderr noise out of the
#                       report. See ESLINT: FINDING vs TOOL ERROR below.
#                tsc    if tsconfig.json present and node_modules/.bin/tsc (or
#                       PATH tsc) exists — runs ONCE, project-wide, `--noEmit`;
#                       only diagnostics naming an edited file are counted
#      A group with NO usable checker is reported to stderr once and skipped.
#   4. Run each checker per file, print one compact line per file to stderr,
#      then a one-line total.
#   5. Record via `heimdall-state` (only when a state file already exists —
#      `hmd init` owns creating it):
#        .quality_gates.lint_clean      true  ⇔ every file checked, 0 findings,
#                                             the run complete
#                                       false ⇔ anything else: a finding, a
#                                       checker that failed to run (reason
#                                       tool-error), a timeout or an exhausted
#                                       budget (reason incomplete). A run that
#                                       reached no verdict must not leave an
#                                       earlier true standing: that drift let a
#                                       stale green (or a `mark-clean` hand
#                                       flip) pass the push gate on the
#                                       evidence of a run that checked nothing.
#        .quality_gates.lint_last_run   {at, files, checked, findings, tools,
#                                        complete, timeouts, tool_errors,
#                                        skipped, excluded, source, reason,
#                                        paths, + the shellcheck_severity in
#                                        force} — the receipt. `reason` is
#                                        clean | findings | tool-error |
#                                        incomplete; `paths` are the absolute
#                                        files the verdict covers, so the gate
#                                        can tell evidence that predates a
#                                        later edit of one of them. Additive
#                                        key; `set` creates it, nothing in the
#                                        schema enumerates quality_gates keys.
#      A run that reaches no file at all (nothing edited, everything excluded,
#      or only files of types with no checker) records NOTHING: no new evidence,
#      and it never refreshes an old verdict. The gate therefore does not take
#      a lint_clean=true as evidence by itself: `heimdall-state
#      check-quality-gates` re-reads lint_last_run and refuses a missing,
#      failing, incomplete, tool-error or stale (a covered file edited after
#      the run) receipt, and `mark-clean` can no longer set lint_clean true
#      without one.
#
# WHAT COUNTS AS A SHELLCHECK FINDING
# -----------------------------------
# CLAUDE.md defines the gate as "Lint clean (zero warnings)". The default
# threshold of shellcheck also counts info and style notes (SC2086 quoting,
# SC2001 sed-vs-parameter-expansion, ...), a stricter bar than the gate this
# tool feeds: a file with zero warnings still read lint_clean=false. So the
# tool runs `shellcheck -S warning` (error + warning) and
# HMD_STOP_LINT_SEVERITY moves the bar:
#   error | warning (default) | info | style
# Case-insensitive; info and style are the opt-in stricter runs. An unknown
# value falls back to warning and says so once on stderr (only when shellcheck
# is about to run). The threshold in force is written into the receipt as
# lint_last_run.shellcheck_severity, so a "clean" always names the bar it was
# measured against. bash -n, python ast and the other checkers are untouched.
# The existing info/style notes in the repo's own scripts are NOT cleaned up
# here; that is deferred work, and `HMD_STOP_LINT_SEVERITY=info` is how to see
# them.
#
# FINDING vs TOOL ERROR (every checker)
# -------------------------------------
# A non-zero exit is not a finding. ESLint exits 0 (clean), 1 (lint errors) or 2
# (config error / crash), and this tool used to read every non-zero exit as "N
# findings" through `-f unix`, which ESLint 9 removed: every call exited 2 and
# was counted as a finding, so a repo whose `eslint .` was clean read
# lint_clean=false and the push gate blocked. The other checkers had the same
# flaw, and their exit codes do not even agree on what non-zero means: the
# ShellCheck exit 1 is findings, 2 is a file it could not process, 3 and 4 are a
# bad flag or format; ruff 1 is findings, 2 a config error or bad flag, 101 a
# panic (a file it cannot read is an E902 entry in its report, not a lint
# problem); Biome exits 1 for findings AND for a config error.
# So every JSON checker (eslint -f json -o <tmp>, shellcheck -f json, ruff
# --output-format json, biome --reporter=json) is read the same way: exit 0 is
# clean, a timeout is its own non-verdict, and any other exit is a FINDING only
# when it is exit 1 AND the tool's own JSON report lists at least one problem
# (the report existing is what proves the tool finished linting; the problems
# are counted from it, never scraped from text). Anything else (exit 2 or more,
# a crash, a config error, an unsupported flag, a report that is unreadable or
# holds only the tool's own diagnostics, a missing binary or interpreter =
# exit 126/127) is a TOOL ERROR. The report is read from STDOUT (ESLint: from
# --output-file): ruff, biome and node warn on stderr, which a merged stream
# would corrupt. The checkers with no report draw the same line from what they
# have: bash -n (126/127 = could not start; any other non-zero is a syntax
# error), python3 ast.parse (exit 1 is a syntax error only when its output names
# a SyntaxError, IndentationError or TabError) and tsc (it type-checked only if
# it exited 0 or printed a diagnostic that names a file; anything else never got
# as far as checking). A TOOL ERROR is:
#   * reported loudly, per file, with the tool's own diagnostics
#   * counted in the receipt's tool_errors, never in findings
#   * the run is marked complete=false
#   * lint_clean is set FALSE, with receipt reason "tool-error". A tool that
#     could not run is no evidence of cleanliness, and leaving lint_clean as it
#     was let an EARLIER true (a stale run, or a `mark-clean` hand flip) survive
#     a run that checked nothing, so the push gate passed on old evidence. The
#     phantom-findings bug is not repeated: the failure is counted in
#     tool_errors, never in findings, and the reason says why. TRADE-OFF: a
#     linter that is broken (config error, crash, missing interpreter) now
#     BLOCKS the push until it is fixed, or explicitly and visibly waived:
#     HMD_LINT_WAIVER='<reason>' heimdall-state mark-clean (recorded in
#     .quality_gates.lint_waiver / lint_waiver_log, voided by the next lint
#     run). A timed-out checker or an exhausted budget is the same non-verdict
#     (reason "incomplete").
#
# ADVISORY, FAIL OPEN, ALWAYS EXIT 0
# ----------------------------------
# This is a Stop hook. A Stop hook that exits non-zero, hangs, or dies on its
# own plumbing turns a warning into a wedged session. So: every branch exits
# 0; a missing tracker, missing state file, unreadable file, absent linter,
# or crashed linter is at most one stderr line, never a failure. Findings are
# the signal; the exit code is not.
# Fail open is about the HOOK (it never wedges the session), not about the state
# it leaves: every run that reaches no verdict leaves lint_clean FALSE, never a
# stale true.
#
# BOUNDED RUNTIME
# ---------------
# Two layers, both the repo's perl-alarm idiom (macOS ships no `timeout`):
#   * per-invocation: each linter call runs under a perl alarm (fork + wait +
#     `alarm N`, exit 124 on expiry) with N = min(per-call cap, remaining
#     budget), so one hung tool cannot eat the whole budget. A timed-out call
#     is a NON-verdict: it is reported, counted in the receipt's `timeouts`,
#     and forces complete=false — it is never counted as "ok".
#   * whole run: `--budget S` (default 60) is tracked against wall clock;
#     once spent, remaining files are listed as "skipped (budget)" and the
#     receipt records complete=false. The hooks.json entry wraps the whole
#     tool in one more alarm as the last line of defence.
# perl absent → linters run unwrapped; the hook-level alarm still applies.
#
# NEVER TOUCHES THE OPERATOR'S REAL LEDGER IN TESTS
# -------------------------------------------------
# edit-tracker keys its ledger on $TMPDIR/heimdall-edits/$CLAUDE_CODE_SESSION_ID
# .log. test/heimdall-stop-lint.test.sh sets both to a private temp dir + a
# unique session id, so it can only ever read a ledger it wrote itself.
#
# SINCE THE LAST PUSH (--since-push)
# ----------------------------------
# The Stop hook lints only what `edit-tracker paths` lists: THIS session's own Write/Edit calls. Work a sub-agent did in its own
# worktree and that was merged into the branch is in no session's ledger, so the push gate had no lint evidence for it and the only
# way past was HMD_LINT_WAIVER. `--since-push` lints everything a push would ship instead:
#   files   = `git diff --name-only <base>..HEAD` + uncommitted changes (staged, unstaged, untracked and not ignored)
#   base    = @{u}, else origin/<branch>, else HEAD of the last full green sweep (receipts/last-full-green.json under
#             $HEIMDALL_HOME or <repo>/.heimdall, when it is an ancestor of HEAD), else none: every tracked file counts as unpushed
#   filter  = as on the Stop path: existing regular files inside --repo, never .claude/worktrees, .heimdall or node_modules
#   tools   = the same selection and severity rules as the Stop path
#   budget  = the same --budget / --per-call. Files past it are "skipped (budget)", the receipt is complete=false (reason
#             incomplete) and the push gate refuses it: a big diff needs a bigger --budget, never a waiver. The change list is
#             read with one git call and filtered without forking per path, so listing a huge diff costs no budget.
#   receipt = the usual fields plus mode ("since-push"; "tracked-edits" on the Stop path), base_sha, base_ref and scope: every
#             lintable-by-type file the run enumerated, whether or not a checker is installed for it.
#   A since-push run ALWAYS records a receipt, even when the diff holds nothing lintable (checked 0, paths [], clean): "nothing
#   lintable is about to be pushed" is the evidence a docs-only push needs, and without it that push needs a waiver. A run that
#   cannot list the diff records an incomplete receipt, never a vacuous clean one.
#   `heimdall-state check-quality-gates` re-derives the scope with `--since-push --list --upstream-only` and fails a receipt that
#   does not cover it (reason "uncovered", naming the file and this command); bin/heimdall-precheck-bash runs this mode itself
#   when the lint evidence is missing, stale or uncovered.
#   --list           print the lintable files the run would cover (absolute paths, one per line); run nothing, write nothing
#   --upstream-only  with --since-push: do nothing (an empty --list) unless @{u} or origin/<branch> resolves, i.e. a last push exists
#
# Usage:
#   heimdall-stop-lint --since-push [--list] [--upstream-only] [--repo DIR] [--budget SECONDS] [--per-call SECONDS] [--quiet]
#   heimdall-stop-lint [--repo DIR] [--budget SECONDS] [--per-call SECONDS]
#                      [--tracker PATH] [--quiet]
#   HEIMDALL_STATE_FILE overrides the state file (default <repo>/heimdall-
#   state.json, falling back to <repo>/superx-state.json, matching
#   bin/heimdall-state).
#   HMD_STOP_LINT_SEVERITY=error|warning|info|style sets the minimum shellcheck
#   severity that counts as a finding (default warning).

set -u

REPO="."
BUDGET=60
PER_CALL=20
TRACKER=""
QUIET=0
SINCE_PUSH=0
LIST_ONLY=0
UPSTREAM_ONLY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)     REPO="${2:-.}"; shift 2 ;;
    --since-push)    SINCE_PUSH=1; shift ;;
    --list)          LIST_ONLY=1; shift ;;
    --upstream-only) UPSTREAM_ONLY=1; shift ;;
    --budget)   BUDGET="${2:-60}"; shift 2 ;;
    --per-call) PER_CALL="${2:-20}"; shift 2 ;;
    --tracker)  TRACKER="${2:-}"; shift 2 ;;
    --quiet)    QUIET=1; shift ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) shift ;;
  esac
done

case "$BUDGET" in ''|*[!0-9]*) BUDGET=60 ;; esac
case "$PER_CALL" in ''|*[!0-9]*) PER_CALL=20 ;; esac
[ "$BUDGET" -lt 1 ] && BUDGET=1
[ "$PER_CALL" -lt 1 ] && PER_CALL=1

# Minimum shellcheck severity that counts as a finding (see the header). An
# unknown value is kept in SEVERITY_BAD so it can be said once, later, and only
# if shellcheck actually runs -- nothing edited must still print nothing.
SEVERITY_RAW="${HMD_STOP_LINT_SEVERITY:-warning}"
SEVERITY="$(printf '%s' "$SEVERITY_RAW" | tr '[:upper:]' '[:lower:]')"
SEVERITY_BAD=""
case "$SEVERITY" in
  error|warning|info|style) ;;
  *) SEVERITY_BAD="$SEVERITY_RAW"; SEVERITY="warning" ;;
esac

REPO_RAW="$(cd "$REPO" 2>/dev/null && pwd || echo "$REPO")"
REPO="$(cd "$REPO" 2>/dev/null && pwd -P || echo "$REPO")"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
[ -z "$TRACKER" ] && TRACKER="$HERE/edit-tracker"
STATE_TOOL="$HERE/heimdall-state"

# repo_relpath <abs-file> → prints the path relative to $REPO and returns 0 when
# the file is a lint target of THIS repo; returns 1 otherwise. The directory is
# resolved physically first (pwd -P), so a `..` escape, a symlinked spelling
# (macOS /var → /private/var) or a symlinked directory pointing outside cannot
# pass the prefix test. The exclusions are anchored at the repo root on purpose:
# an absolute "*/.claude/worktrees/*" pattern would also drop every file of a
# session whose repo IS a worktree.
repo_relpath() {
  local p="$1" dir rp
  dir="$(cd "${p%/*}/" 2>/dev/null && pwd -P)" || return 1
  p="$dir/${p##*/}"
  case "$p" in "$REPO"/*) rp="${p#"$REPO"/}" ;; *) return 1 ;; esac
  excluded_rel "$rp" && return 1
  printf '%s' "$rp"
}

# excluded_rel <repo-relative path> → true when it is not a lint target: stale agent worktrees, generated hooks, node_modules.
excluded_rel() { case "/$1" in /.claude/worktrees/*|/.heimdall/*|*/node_modules/*) return 0 ;; esac; return 1; }

# add_git_path <path relative to the git top> → the same rules as repo_relpath for a path git printed, applied textually: a work
# tree of thousands of changed paths cannot afford a subshell (cd + pwd -P) for each one, and git's own paths cannot escape the top.
add_git_path() {
  local abs="$TOP/$1" rp
  [ -f "$abs" ] || return 0
  case "$abs" in "$REPO"/*) rp="${abs#"$REPO"/}" ;; *) EXCLUDED=$((EXCLUDED + 1)); return 0 ;; esac
  if excluded_rel "$rp"; then EXCLUDED=$((EXCLUDED + 1)); else FILES+=("$REPO/$rp"); fi
}

TAG="[heimdall] stop-lint:"
say() { [ "$QUIET" -eq 1 ] && return 0; printf '%s %s\n' "$TAG" "$*" >&2; }

# ── 1. edited paths ──────────────────────────────────────────────────────────
MODE="tracked-edits"; BASE_SHA=""; BASE_REF=""; MODE_NOTE=""; ENUM_FAILED=0
FILES=()
EXCLUDED=0
if [ "$SINCE_PUSH" -eq 0 ]; then
  [ -x "$TRACKER" ] || exit 0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in /*) ;; *) p="$REPO/$p" ;; esac
    [ -f "$p" ] || continue
    if rp="$(repo_relpath "$p")"; then FILES+=("$REPO/$rp"); else EXCLUDED=$((EXCLUDED + 1)); fi
  done < <("$TRACKER" paths 2>/dev/null || true)
  [ "${#FILES[@]}" -gt 0 ] || exit 0
else
  # Everything a push would ship (see SINCE THE LAST PUSH in the header): the diff against what the remote already has, plus the
  # uncommitted work. The base is the first of @{u}, origin/<branch>, the last full green sweep's HEAD that resolves.
  MODE="since-push"
  TOP="$(git -C "$REPO" rev-parse --show-toplevel 2>/dev/null)" \
    || { say "--since-push needs a git work tree and $REPO is not one - nothing linted"; exit 0; }
  TOP="$(cd "$TOP" && pwd -P)"
  if BASE_SHA="$(git -C "$TOP" rev-parse --verify -q '@{u}^{commit}' 2>/dev/null)"; then BASE_REF='@{u}'
  elif BRANCH="$(git -C "$TOP" symbolic-ref --short -q HEAD 2>/dev/null)" && [ -n "$BRANCH" ] \
       && BASE_SHA="$(git -C "$TOP" rev-parse --verify -q "refs/remotes/origin/$BRANCH^{commit}" 2>/dev/null)"; then BASE_REF="origin/$BRANCH"
  elif [ "$UPSTREAM_ONLY" -eq 1 ]; then exit 0
  elif FG="${HEIMDALL_HOME:-$TOP/.heimdall}/receipts/last-full-green.json" && [ -f "$FG" ] && command -v jq >/dev/null 2>&1 \
       && BASE_SHA="$(jq -r '.head_sha // empty' "$FG" 2>/dev/null)" && [ -n "$BASE_SHA" ] \
       && git -C "$TOP" merge-base --is-ancestor "$BASE_SHA" HEAD 2>/dev/null; then BASE_REF="last-full-green"
  else BASE_SHA=""; BASE_REF="none"; fi
  MODE_NOTE="since-push (base ${BASE_REF}${BASE_SHA:+ ${BASE_SHA:0:9}}): "
  # One listing, three sources, NUL-separated and de-duplicated: committed since the base (every tracked file when no base is
  # known), staged + unstaged changes, and untracked files that are not ignored. A listing that fails is a run with no verdict.
  RAW="$(mktemp "${TMPDIR:-/tmp}/hmd-stop-lint-diff.XXXXXX" 2>/dev/null)" || RAW=""
  if [ -n "$RAW" ] && {
       if [ -n "$BASE_SHA" ]; then git -C "$TOP" diff --name-only --no-renames -z "$BASE_SHA" HEAD; else git -C "$TOP" ls-files -z; fi \
         && git -C "$TOP" diff --name-only --no-renames -z HEAD \
         && git -C "$TOP" ls-files -z --others --exclude-standard
     } > "$RAW" 2>/dev/null; then
    while IFS= read -r -d '' p; do add_git_path "$p"; done < <(sort -zu "$RAW")
  else
    ENUM_FAILED=1
    say "could not list what changed since the last push - the run has no verdict"
  fi
  [ -n "$RAW" ] && rm -f "$RAW"
fi

# ── 2. group by language ─────────────────────────────────────────────────────
SHELL_FILES=(); PY_FILES=(); JS_FILES=(); OTHER=0
for f in "${FILES[@]}"; do
  case "$f" in
    *.sh|*.bash)                         SHELL_FILES+=("$f") ;;
    *.py)                                PY_FILES+=("$f") ;;
    *.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx)   JS_FILES+=("$f") ;;
    *)
      # extensionless files with a bash/sh shebang are shell too (bin/ tools)
      if [[ "${f##*/}" != *.* ]] \
         && head -c 64 "$f" 2>/dev/null | head -1 | grep -qE '^#!.*\b(ba)?sh\b'; then
        SHELL_FILES+=("$f")
      elif head -c 64 "$f" 2>/dev/null | head -1 | grep -qE '^#!.*python'; then
        PY_FILES+=("$f")
      else
        OTHER=$((OTHER + 1))
      fi ;;
  esac
done

# The scope of a --since-push run: every file of a lintable TYPE in the diff, whether or not a checker for it is installed here (a
# receipt must not become unsatisfiable because a repo has no eslint). Recorded in the receipt as `scope`; --list prints it so the
# push gate can re-derive it with the very same code.
LINTABLE=()
for f in "${SHELL_FILES[@]:-}" "${PY_FILES[@]:-}" "${JS_FILES[@]:-}"; do [ -n "$f" ] && LINTABLE+=("$f"); done
if [ "$LIST_ONLY" -eq 1 ]; then
  [ "${#LINTABLE[@]}" -gt 0 ] && printf '%s\n' "${LINTABLE[@]}" | sort
  exit 0
fi

# ── 3. detect checkers (never install) ───────────────────────────────────────
HAVE_PERL=0; command -v perl >/dev/null 2>&1 && HAVE_PERL=1
# The receipt's `at` is when the run STARTED, not when it ended: the gate calls a covered
# file stale when it was modified after `at`, so a file edited WHILE this run was linting
# (after its checker had already read it) must read as newer than the evidence.
START_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
START_TS=$(date +%s)
remaining() { local now; now=$(date +%s); echo $(( BUDGET - (now - START_TS) )); }

# run_bounded <cmd...> → tool stdout in the file $RUN_OUT, stderr in $RUN_ERR, rc in RUN_RC.
# Output goes to a FILE, not a `$(...)` pipe, on purpose: a `$(...)` capture
# waits for the pipe to CLOSE, and a linter that forks a child (a `sh` wrapper
# around a real binary, a daemonised worker) leaves that child holding the
# pipe after the alarm kills the parent — measured 60s on a 3s budget before
# this was changed. A file has no reader to keep waiting; `wait` returns the
# moment the direct child dies. RUN_RC is set in THIS shell, not a subshell,
# which is the other reason this is not a `$(...)`.
RUN_RC=0
RUN_TIMEOUT=0
TIMEOUTS=0
TOOL_ERRORS=0
# stdout (a JSON checker's report) and stderr are kept in separate files: ruff,
# biome and node print warnings to stderr that would corrupt a merged stream.
RUN_OUT="$(mktemp "${TMPDIR:-/tmp}/hmd-stop-lint.XXXXXX" 2>/dev/null || echo /dev/null)"
RUN_ERR="$(mktemp "${TMPDIR:-/tmp}/hmd-stop-lint-err.XXXXXX" 2>/dev/null || echo /dev/null)"
# ESLint's --output-file target (see FINDING vs TOOL ERROR in the header)
ESLINT_JSON="$(mktemp "${TMPDIR:-/tmp}/hmd-stop-lint-eslint.XXXXXX" 2>/dev/null || echo /dev/null)"
trap 'rm -f "$RUN_OUT" "$RUN_ERR" "$ESLINT_JSON"' EXIT
run_bounded() {
  local rem cap
  rem=$(remaining)
  cap=$PER_CALL
  [ "$rem" -lt "$cap" ] && cap=$rem
  [ "$cap" -lt 1 ] && cap=1
  : > "$RUN_OUT" 2>/dev/null; : > "$RUN_ERR" 2>/dev/null
  # perl forks the tool and WAITS rather than exec-ing it: with a plain
  # `alarm N; exec @ARGV` the process bash owns dies by SIGALRM, and bash
  # prints "Alarm clock: 14" to the hook's stderr for every timeout (a
  # `( ... ) 2>/dev/null` wrapper does not help — bash exec-optimises a
  # single-command subshell into the command itself). Here perl catches the
  # alarm, TERMs then KILLs the child, and exits NORMALLY with 124 (GNU
  # timeout's code), so nothing the script owns ever dies by signal. A child
  # that dies by signal on its own is surfaced as 128+signo.
  if [ "$HAVE_PERL" -eq 1 ]; then
    perl -e '
      my $t = shift; my $pid = fork;
      if (!defined $pid) { exit 125 }
      if ($pid == 0) { exec @ARGV; exit 127 }
      local $SIG{ALRM} = sub { kill "TERM", $pid; select undef,undef,undef,0.2; kill "KILL", $pid; waitpid $pid, 0; exit 124 };
      alarm $t; waitpid $pid, 0; alarm 0;
      exit(($? & 127) ? 128 + ($? & 127) : ($? >> 8));
    ' "$cap" "$@" >"$RUN_OUT" 2>"$RUN_ERR" </dev/null
  else
    "$@" >"$RUN_OUT" 2>"$RUN_ERR" </dev/null
  fi
  RUN_RC=$?
  RUN_TIMEOUT=0
  if [ "$RUN_RC" -eq 124 ] || [ "$RUN_RC" -gt 128 ]; then RUN_TIMEOUT=1; TIMEOUTS=$((TIMEOUTS + 1)); fi
}
# run_in_repo <cmd...> → run_bounded with cwd = $REPO (RUN_RC still set here)
run_in_repo() {
  local prev; prev="$PWD"
  cd "$REPO" 2>/dev/null || { RUN_RC=1; RUN_TIMEOUT=0; : > "$RUN_OUT"; : > "$RUN_ERR"; return; }
  run_bounded "$@"
  cd "$prev" 2>/dev/null || true
}
tool_out() { cat "$RUN_OUT" "$RUN_ERR" 2>/dev/null; }
# What a tool said, for a tool-error report: its stdout (a JSON report squeezed
# onto one line: ruff pretty-prints, and the MAX_DETAIL_LINES cut would keep only
# the first few brackets of it) and then its stderr.
tool_report() { { jq -c . "$RUN_OUT" 2>/dev/null || cat "$RUN_OUT"; cat "$RUN_ERR"; } 2>/dev/null; }

# ESLint's `-f json` report, read from the --output-file target. A report that
# exists and parses as an array proves ESLint FINISHED a lint run (a crash or a
# config error never writes one). eslint_problems prints the problem count and
# fails when there is no usable report; eslint_lines lists the problems in the
# `path:line:col: message [Severity/rule]` shape the unix formatter had.
eslint_problems() {
  [ -s "$ESLINT_JSON" ] || return 1
  jq -e 'if type == "array" then [.[].messages | length] | add // 0 else empty end' "$ESLINT_JSON" 2>/dev/null
}
eslint_lines() {
  jq -r '.[] | .filePath as $f | .messages[] | "\($f):\(.line // 0):\(.column // 0): \(.message) [\(if .severity == 2 then "Error" else "Warning" end)/\(.ruleId // "parse")]"' "$ESLINT_JSON" 2>/dev/null
}

# The other JSON checkers print their report on STDOUT ($RUN_OUT). Each
# *_problems prints the number of lint problems in it and succeeds only when the
# report proves the tool FINISHED linting (a crash, a config error or a bad flag
# never prints one); each *_lines lists them as `path:line:col: message`.
sc_problems() { jq -e 'if type == "array" then length else empty end' "$RUN_OUT" 2>/dev/null; }
sc_lines() {
  jq -r '.[] | "\(.file):\(.line):\(.column): \(.level): \(.message) [SC\(.code)]"' "$RUN_OUT" 2>/dev/null
}
# ruff reports a file it cannot read as an E902 entry: the tool failing, not a lint problem.
ruff_problems() { jq -e 'if type == "array" then [.[] | select(.code != "E902")] | length else empty end' "$RUN_OUT" 2>/dev/null; }
ruff_lines() {
  jq -r '.[] | select(.code != "E902") | "\(.filename):\(.location.row // 0):\(.location.column // 0): \(.code // "syntax-error") \(.message)"' "$RUN_OUT" 2>/dev/null
}
# Biome's diagnostics also carry its own failures (internalError/io "No files were
# processed", configuration, ...): only the lint, parse, suppression, assist and
# plugin categories are problems in the linted file.
BIOME_JQ='def finding: select((.category // "") | test("^(lint|parse|suppressions|assist|plugin)(/|$)"));'
biome_problems() { jq -e "$BIOME_JQ"' if type == "object" and (.diagnostics | type) == "array" then [.diagnostics[] | finding] | length else empty end' "$RUN_OUT" 2>/dev/null; }
biome_lines() {
  jq -r "$BIOME_JQ"' .diagnostics[] | finding | "\(.location.path.file // "?"): \(.category) \(.description)"' "$RUN_OUT" 2>/dev/null
}

# classify_json <problems-fn> → CK=ok|timeout|findings|error (and CK_N, the
# problem count) for the run just made. See FINDING vs TOOL ERROR in the header:
# exit 0 is clean, a timeout is already a non-verdict, any other non-zero exit
# is a finding only when it is exit 1 AND the tool's JSON report lists problems.
CK=""; CK_N=0
classify_json() {
  CK_N=0
  if [ "$RUN_RC" -eq 0 ]; then CK=ok
  elif [ "$RUN_TIMEOUT" -eq 1 ]; then CK=timeout
  elif [ "$RUN_RC" -eq 1 ] && CK_N="$("$1")" && [ "$CK_N" -gt 0 ]; then CK=findings
  else CK=error; CK_N=0; fi
}

# tool_error <label> [exit-1 headline] → the checker never reached a verdict (could
# not start, config error, crash, unusable report): counted in tool_errors, never
# in findings, and the run becomes incomplete. Exit 1 normally means "findings",
# so the optional headline says why this one is not.
tool_error() {
  local body; body="$(tool_report)"
  [ "$RUN_RC" -eq 1 ] && [ -n "${2:-}" ] && body="$2${body:+$'\n'}$body"
  [ -n "$body" ] || body="$1 exited $RUN_RC and printed nothing"
  TOOL_ERRORS=$((TOOL_ERRORS + 1)); parts+=("$1 tool error (exit $RUN_RC)")
  detail="${detail}${detail:+$'\n'}$body"
}

# apply_verdict <label> <lines-fn> [exit-1 headline] → fold classify_json's
# verdict into this file's parts / fcount / detail.
apply_verdict() {
  case "$CK" in
    ok)       parts+=("$1 ok") ;;
    timeout)  parts+=("$1 timed out") ;;
    findings) fcount=$((fcount + CK_N)); parts+=("$1 $CK_N"); detail="${detail}${detail:+$'\n'}$("$2")" ;;
    *)        tool_error "$1" "${3:-$1 exited 1 without a readable JSON report}" ;;
  esac
}

# node tool resolution: repo-local first, PATH second, never npx-install
node_bin() {
  local name="$1"
  if [ -x "$REPO/node_modules/.bin/$name" ]; then
    printf '%s' "$REPO/node_modules/.bin/$name"
  elif command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
  fi
}

SHELLCHECK=""; command -v shellcheck >/dev/null 2>&1 && SHELLCHECK="$(command -v shellcheck)"

RUFF=""
if command -v ruff >/dev/null 2>&1; then
  for cfg in ruff.toml .ruff.toml pyproject.toml; do
    [ -f "$REPO/$cfg" ] && { RUFF="$(command -v ruff)"; break; }
  done
fi

PKG_LINT=""
if [ -f "$REPO/package.json" ] && command -v jq >/dev/null 2>&1; then
  PKG_LINT="$(jq -r '.scripts.lint // empty' "$REPO/package.json" 2>/dev/null || true)"
fi

BIOME=""
if [ -f "$REPO/biome.json" ] || [ -f "$REPO/biome.jsonc" ] || [[ "$PKG_LINT" == *biome* ]]; then
  BIOME="$(node_bin biome)"
fi

ESLINT=""
if [ -f "$REPO/eslint.config.js" ] || [ -f "$REPO/eslint.config.mjs" ] || [ -f "$REPO/eslint.config.cjs" ] \
   || [ -f "$REPO/eslint.config.ts" ] || ls "$REPO"/.eslintrc* >/dev/null 2>&1 || [[ "$PKG_LINT" == *eslint* ]]; then
  ESLINT="$(node_bin eslint)"
fi

TSC=""
if [ -f "$REPO/tsconfig.json" ]; then
  TSC="$(node_bin tsc)"
fi

TOOLS_USED=()
add_tool() { local t; for t in "${TOOLS_USED[@]:-}"; do [ "$t" = "$1" ] && return; done; TOOLS_USED+=("$1"); }

# ── 4. run ───────────────────────────────────────────────────────────────────
CHECKED=0
CHECKED_PATHS=()
FINDINGS=0
SKIPPED_BUDGET=0
MAX_DETAIL_LINES=6

# Strip the repo prefix for display. Both the physical path (pwd -P) and the
# as-given one are tried: macOS TMPDIR is /var/... → /private/var/..., and the
# tracker records whichever spelling the editing tool used.
rel() {
  case "$1" in
    "$REPO"/*)     printf '%s' "${1#"$REPO"/}" ;;
    "$REPO_RAW"/*) printf '%s' "${1#"$REPO_RAW"/}" ;;
    *)             printf '%s' "$1" ;;
  esac
}

# report <file> <summary> [detail-text]
report() {
  local f="$1" summary="$2" detail="${3:-}"
  say "$(rel "$f") — $summary"
  [ -n "$detail" ] || return 0
  [ "$QUIET" -eq 1 ] && return 0
  printf '%s\n' "$detail" | grep -v '^[[:space:]]*$' | head -n "$MAX_DETAIL_LINES" | sed 's/^/    /' >&2
}

budget_left() { [ "$(remaining)" -gt 0 ]; }

# --- shell -------------------------------------------------------------------
if [ -n "$SEVERITY_BAD" ] && [ -n "$SHELLCHECK" ] && [ "${#SHELL_FILES[@]}" -gt 0 ]; then
  say "unknown HMD_STOP_LINT_SEVERITY '$SEVERITY_BAD' (want error|warning|info|style) — using warning"
fi
for f in "${SHELL_FILES[@]:-}"; do
  [ -n "$f" ] || continue
  if ! budget_left; then SKIPPED_BUDGET=$((SKIPPED_BUDGET + 1)); report "$f" "skipped (budget)"; continue; fi
  parts=(); detail=""; fcount=0
  run_bounded bash -n "$f"; out="$(tool_out)"; add_tool "bash -n"
  if [ "$RUN_RC" -eq 0 ]; then parts+=("bash -n ok")
  elif [ "$RUN_TIMEOUT" -eq 1 ]; then parts+=("bash -n timed out")
  elif [ "$RUN_RC" -eq 126 ] || [ "$RUN_RC" -eq 127 ]; then tool_error "bash -n"  # could not start: no verdict on the file
  else fcount=$((fcount + 1)); parts+=("bash -n FAIL"); detail="$out"; fi
  if [ -n "$SHELLCHECK" ] && budget_left; then
    run_bounded "$SHELLCHECK" -S "$SEVERITY" -f json "$f"; add_tool shellcheck
    classify_json sc_problems; apply_verdict shellcheck sc_lines
  fi
  CHECKED=$((CHECKED + 1)); CHECKED_PATHS+=("$f"); FINDINGS=$((FINDINGS + fcount))
  report "$f" "$(IFS=,; echo "${parts[*]}" | sed 's/,/, /g')" "$detail"
done

# --- python ------------------------------------------------------------------
PY=""; command -v python3 >/dev/null 2>&1 && PY=python3
for f in "${PY_FILES[@]:-}"; do
  [ -n "$f" ] || continue
  if ! budget_left; then SKIPPED_BUDGET=$((SKIPPED_BUDGET + 1)); report "$f" "skipped (budget)"; continue; fi
  parts=(); detail=""; fcount=0
  if [ -n "$PY" ]; then
    run_bounded "$PY" -c 'import ast,sys; ast.parse(open(sys.argv[1],"rb").read(), sys.argv[1])' "$f"; out="$(tool_out)"; add_tool "python3 ast"
    if [ "$RUN_RC" -eq 0 ]; then parts+=("ast ok")
    elif [ "$RUN_TIMEOUT" -eq 1 ]; then parts+=("ast timed out")
    elif [ "$RUN_RC" -eq 1 ] && grep -qE '(Syntax|Indentation|Tab)Error:' <<<"$out"; then
      fcount=$((fcount + 1)); parts+=("ast FAIL"); detail="$(printf '%s\n' "$out" | grep -E 'SyntaxError|line [0-9]+' | tail -n 3)"; [ -z "$detail" ] && detail="$out"
    else tool_error ast "python3 exited 1 without a SyntaxError in its output"; fi
  fi
  if [ -n "$RUFF" ] && budget_left; then
    run_bounded "$RUFF" check --no-fix --output-format json "$f"; add_tool ruff
    classify_json ruff_problems; apply_verdict ruff ruff_lines
  fi
  if [ "${#parts[@]}" -eq 0 ]; then report "$f" "no python checker available"; continue; fi
  CHECKED=$((CHECKED + 1)); CHECKED_PATHS+=("$f"); FINDINGS=$((FINDINGS + fcount))
  report "$f" "$(IFS=,; echo "${parts[*]}" | sed 's/,/, /g')" "$detail"
done

# --- js / ts -----------------------------------------------------------------
if [ "${#JS_FILES[@]}" -gt 0 ]; then
  if [ -z "$BIOME" ] && [ -z "$ESLINT" ] && [ -z "$TSC" ]; then
    say "no js/ts linter found in $(rel "$REPO") (${#JS_FILES[@]} edited file(s) skipped; looked for biome, eslint, tsc — nothing installed)"
  else
    TSC_OUT=""; TSC_STATE=""; TSC_RC=0
    if [ -n "$TSC" ] && budget_left; then
      run_in_repo "$TSC" --noEmit -p tsconfig.json --pretty false; TSC_OUT="$(tool_out)"; add_tool tsc
      # tsc type-checked iff it exited 0 or printed a diagnostic that names a file;
      # anything else (a crash, a missing module or interpreter, a config error)
      # never got as far as checking, and must not read as "tsc ok" per file.
      if [ "$RUN_TIMEOUT" -eq 1 ]; then TSC_STATE=timeout; say "tsc timed out after ${PER_CALL}s — type results omitted"
      elif [ "$RUN_RC" -eq 0 ] || grep -qE '\([0-9]+,[0-9]+\): error TS[0-9]+' <<<"$TSC_OUT"; then TSC_STATE=ok
      else TSC_STATE=error; TSC_RC=$RUN_RC; parts=(); detail=""; tool_error tsc; report tsc "tool error (exit $RUN_RC)" "$detail"; fi
    fi
    for f in "${JS_FILES[@]}"; do
      if ! budget_left; then SKIPPED_BUDGET=$((SKIPPED_BUDGET + 1)); report "$f" "skipped (budget)"; continue; fi
      parts=(); detail=""; fcount=0
      if [ -n "$BIOME" ] && budget_left; then
        run_in_repo "$BIOME" lint --reporter=json "$f"; add_tool biome
        classify_json biome_problems; apply_verdict biome biome_lines
      fi
      if [ -n "$ESLINT" ] && budget_left; then
        : > "$ESLINT_JSON"  # the previous file's report must never be read as this one's
        run_in_repo "$ESLINT" --no-fix -f json -o "$ESLINT_JSON" "$f"; add_tool eslint
        classify_json eslint_problems; apply_verdict eslint eslint_lines "ESLint exited 1 without a readable JSON report"
      fi
      if [ "$TSC_STATE" = error ]; then parts+=("tsc tool error (exit $TSC_RC)")
      elif [ -n "$TSC" ]; then
        rf="$(rel "$f")"
        hits="$(printf '%s\n' "$TSC_OUT" | grep -F "$rf" | grep -E 'error TS[0-9]+')"
        if [ -n "$hits" ]; then n=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')
          fcount=$((fcount + n)); parts+=("tsc $n"); detail="${detail}${detail:+$'\n'}$hits"
        elif [ "$TSC_STATE" = timeout ]; then parts+=("tsc timed out")
        else parts+=("tsc ok"); fi
      fi
      if [ "${#parts[@]}" -eq 0 ]; then report "$f" "skipped (budget)"; SKIPPED_BUDGET=$((SKIPPED_BUDGET + 1)); continue; fi
      CHECKED=$((CHECKED + 1)); CHECKED_PATHS+=("$f"); FINDINGS=$((FINDINGS + fcount))
      report "$f" "$(IFS=,; echo "${parts[*]}" | sed 's/,/, /g')" "$detail"
    done
  fi
fi

[ "$OTHER" -gt 0 ] && say "$OTHER edited file(s) of other types not linted"

# A run is complete only if every file was reached AND every checker finished.
# A timed-out checker produced no verdict; counting it as "ok" would let a hung
# linter manufacture a green gate, which is the hand-flip this tool replaces.
COMPLETE=true
[ "$SKIPPED_BUDGET" -gt 0 ] && COMPLETE=false
[ "$TIMEOUTS" -gt 0 ] && COMPLETE=false
[ "$TOOL_ERRORS" -gt 0 ] && COMPLETE=false
[ "$ENUM_FAILED" -eq 1 ] && COMPLETE=false

if [ "$CHECKED" -gt 0 ] || [ "$SKIPPED_BUDGET" -gt 0 ] || [ "$MODE" = since-push ]; then
  verdict="clean"
  if [ "$FINDINGS" -gt 0 ]; then verdict="$FINDINGS finding(s)"
  elif [ "$TOOL_ERRORS" -gt 0 ]; then verdict="no findings"; fi
  extra=""; [ "$SKIPPED_BUDGET" -gt 0 ] && extra=", $SKIPPED_BUDGET skipped (budget ${BUDGET}s exhausted)"
  [ "$TIMEOUTS" -gt 0 ] && extra="$extra, $TIMEOUTS checker call(s) timed out (per-call cap ${PER_CALL}s) — verdict incomplete"
  [ "$TOOL_ERRORS" -gt 0 ] && extra="$extra, $TOOL_ERRORS checker call(s) failed to run (tool error, not lint findings) — verdict incomplete, lint_clean set false (reason tool-error)"
  if [ "$SKIPPED_BUDGET" -gt 0 ] && [ "$MODE" = since-push ]; then extra="$extra; re-run with a larger --budget (the push gate refuses an incomplete lint run)"; fi
  say "${MODE_NOTE}$CHECKED file(s) checked, $verdict$extra"
fi

# ── 5. record ────────────────────────────────────────────────────────────────
STATE="${HEIMDALL_STATE_FILE:-}"
if [ -z "$STATE" ]; then
  if [ -f "$REPO/heimdall-state.json" ]; then STATE="$REPO/heimdall-state.json"
  elif [ -f "$REPO/superx-state.json" ]; then STATE="$REPO/superx-state.json"; fi
fi

if [ -n "$STATE" ] && [ -f "$STATE" ] && [ -x "$STATE_TOOL" ] && command -v jq >/dev/null 2>&1 \
   && { [ "$CHECKED" -gt 0 ] || [ "$SKIPPED_BUDGET" -gt 0 ] || [ "$MODE" = since-push ]; }; then
  tools_json="$(printf '%s\n' "${TOOLS_USED[@]:-}" | grep -v '^$' | jq -R . | jq -sc .)"
  paths_json="$(printf '%s\n' "${CHECKED_PATHS[@]:-}" | grep -v '^$' | jq -R . | jq -sc .)"
  scope_json=null
  [ "$MODE" = since-push ] && scope_json="$(printf '%s\n' "${LINTABLE[@]:-}" | grep -v '^$' | jq -R . | jq -sc .)"
  # Why this run did or did not earn lint_clean. tool-error outranks findings: it is
  # the actionable label (a linter is broken) and the receipt still carries the
  # findings count next to it.
  REASON=clean
  if [ "$TOOL_ERRORS" -gt 0 ]; then REASON=tool-error
  elif [ "$FINDINGS" -gt 0 ]; then REASON=findings
  elif [ "$COMPLETE" != true ]; then REASON=incomplete; fi
  receipt="$(jq -nc \
    --arg at "$START_AT" \
    --argjson files "${#FILES[@]}" \
    --argjson checked "$CHECKED" \
    --argjson findings "$FINDINGS" \
    --argjson tools "$tools_json" \
    --argjson complete "$COMPLETE" \
    --argjson timeouts "$TIMEOUTS" \
    --argjson tool_errors "$TOOL_ERRORS" \
    --argjson skipped "$SKIPPED_BUDGET" \
    --argjson excluded "$EXCLUDED" \
    --arg shellcheck_severity "$SEVERITY" \
    --argjson paths "$paths_json" \
    --argjson scope "$scope_json" \
    --arg mode "$MODE" \
    --arg base_sha "$BASE_SHA" \
    --arg base_ref "$BASE_REF" \
    --arg reason "$REASON" \
    '{at:$at, files:$files, checked:$checked, findings:$findings, tools:$tools, complete:$complete, timeouts:$timeouts, tool_errors:$tool_errors, skipped:$skipped, excluded:$excluded, shellcheck_severity:$shellcheck_severity, reason:$reason, paths:$paths, mode:$mode, base_sha:(if $base_sha == "" then null else $base_sha end), base_ref:(if $base_ref == "" then null else $base_ref end), scope:$scope, source:"heimdall-stop-lint"}')"
  # Never let a state-tool hiccup (lock contention, malformed file) escape.
  HEIMDALL_STATE_FILE="$STATE" "$STATE_TOOL" set '.quality_gates.lint_last_run' "$receipt" >/dev/null 2>&1 || true
  # lint_clean is EARNED by a complete run with no findings and set false by every other
  # outcome: a finding, a checker that failed to run (reason tool-error), a timeout or an
  # exhausted budget (reason incomplete). Leaving it as it was on those let an earlier
  # true survive a run that reached no verdict, and the push gate passed on it.
  if [ "$REASON" = clean ]; then LINT_CLEAN=true; else LINT_CLEAN=false; fi
  HEIMDALL_STATE_FILE="$STATE" "$STATE_TOOL" set '.quality_gates.lint_clean' "$LINT_CLEAN" >/dev/null 2>&1 || true
fi

exit 0
