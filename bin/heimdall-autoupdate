#!/usr/bin/env bash
# heimdall-autoupdate — hmd keeps ITSELF current, safely, in the background.
#
# WHAT IT IS. The SessionStart hook calls `heimdall-autoupdate check`. We resolve the
# INSTALLED version vs the LATEST published release; if a real upgrade exists we re-run
# the LATEST tag's idempotent installer DETACHED (curl … | bash &) and return at once.
# install.sh updates the plugin files for the NEXT session — we do NOT hot-swap the
# CURRENTLY running session (see "THE SAFE-APPLY MODEL"). Auto-update is ON by default;
# the off switch is HEIMDALL_NO_AUTOUPDATE=1 or ${HOME}/.heimdall/no-autoupdate.
#
# THE SAFE-APPLY MODEL — why the current session is NEVER broken.
#   A running hmd session has already SOURCED its scripts; its behaviour is fixed for the
#   life of the process. We never edit, reload, or restart that live process. We only ask
#   the LATEST installer to refresh the on-disk plugin tree in the BACKGROUND. install.sh
#   is the ATOMIC unit of apply: it is idempotent (a re-run upgrades cleanly), it PRESERVES
#   user config (cp-endpoint.json + pki seeds survive a re-run), and a partial/aborted run
#   leaves the previous install intact (its own fetch step fails closed). So the worst case
#   is "no upgrade this time"; there is no half-applied state and no live-session breakage.
#   The upgrade simply takes effect the NEXT time `hmd` launches.
#
# SUBCOMMANDS (the SessionStart hook depends on `check` — keep the interface stable):
#   heimdall-autoupdate check      throttled, background, safe. Resolve installed vs latest;
#                                  if newer, background-apply; else no-op. ALWAYS exit 0 fast.
#   heimdall-autoupdate --force    ignore the throttle; check now (still background-applies).
#   heimdall-autoupdate update     MANUAL foreground update (the `hmd --update` path): resolve
#                                  installed vs latest, verify the signed release, and apply it
#                                  NOW in the foreground. Ignores throttle + auto-update opt-out
#                                  (the user explicitly asked). Loud + fail-closed + non-zero on
#                                  any refusal. Pins HEIMDALL_REF so the EXACT verified version
#                                  installs (never install.sh's stale DEFAULT_REF).
#   heimdall-autoupdate status     print installed + latest + whether an update is pending.
#                                  A read-only inspection — never applies.
#
# SAFETY CONTRACT.
#   * SIGNATURE-GATED apply: the downloaded install.sh is APPLIED only after its detached
#     minisign signature verifies against the IN-REPO public key (release/heimdall-signing.pub)
#     via bin/lib/heimdall-verify.sh. Missing verifier, missing/invalid/mismatched signature,
#     or a download failure ⇒ REFUSE + stay on current (fail-closed, loud). An unsigned or
#     tampered release can never reach `bash`. See SIGNING.md for the trust model + key rotation.
#   * NEVER blocks SessionStart: short network timeouts (~5s), the apply is detached.
#   * Offline / API-fail / parse-fail = SILENT no-op, exit 0. Offline is normal, not an error.
#   * Never partially applies (install.sh is the atomic unit); never downgrades; never
#     reinstalls the same version (apply iff latest > installed by SEMVER).
#   * NO auth — the repo is public; we NEVER send a token to GitHub.
#   * NEVER echoes or stores a secret. `set -uo pipefail`, never `set -x`.
#
# ENV / OVERRIDES (all HEIMDALL_*):
#   HEIMDALL_NO_AUTOUPDATE=1        opt out (also: ${HOME}/.heimdall/no-autoupdate file).
#   HEIMDALL_UPDATE_INTERVAL=86400  throttle window in seconds (default 24h).
#   HEIMDALL_LATEST_OVERRIDE=X.Y.Z  TEST seam: inject the "latest" version, skip the network.
#   HEIMDALL_INSTALLED_OVERRIDE=X.Y.Z  TEST seam: inject the "installed" version (skip git/manifest
#                                   resolution). Lets a test simulate a much-older install
#                                   (e.g. v2.0.5) climbing to the current release. Never used
#                                   in production — real installs resolve from the git tag.
#   HEIMDALL_AUTOUPDATE_DRYRUN=1    TEST seam: resolve + decide, but DON'T fetch/verify/detach
#                                   (logs "would-apply"). Decide-only. Never used in production.
#   HEIMDALL_SIGNING_PUBKEY=PATH    override the trust-root public key (default in-repo
#                                   release/heimdall-signing.pub). Rotation / test seam.
#   HEIMDALL_INSTALL_ARTIFACT=PATH  TEST seam: verify a LOCAL install.sh (skip the download).
#   HEIMDALL_INSTALL_SIG=PATH       TEST seam: the LOCAL detached signature to verify against.
#   HEIMDALL_VERIFY_ONLY=1          TEST seam: fetch/verify + decide, print "verified <v>",
#                                   but do NOT execute the installer.
#   HEIMDALL_HOME                   state home (stamp + log + opt-out file). Default ~/.heimdall.

set -uo pipefail

SELF="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$SELF" 2>/dev/null || readlink "$SELF" 2>/dev/null || echo "$SELF")"
fi
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$SELF_DIR/.." && pwd)"

# The GitHub repo (owner/name) the installer + manifest both point at. Public — NO auth.
REPO_SLUG="randomittin/heimdall"
RELEASES_API="https://api.github.com/repos/${REPO_SLUG}/releases/latest"
LSREMOTE_URL="https://github.com/${REPO_SLUG}"
INSTALL_RAW_BASE="https://raw.githubusercontent.com/${REPO_SLUG}"

# State home (stamp + log + opt-out file) — honors $HEIMDALL_HOME so a test/stranger can
# redirect it; defaults to the per-user ~/.heimdall (where presence + cache already live).
HMD_HOME="${HEIMDALL_HOME:-$HOME/.heimdall}"
STAMP="$HMD_HOME/.last-update-check"
OPT_OUT_FILE="$HMD_HOME/no-autoupdate"
LOG_FILE="$HMD_HOME/autoupdate.log"

INTERVAL="${HEIMDALL_UPDATE_INTERVAL:-86400}"   # default 24h between background checks.

# ── tiny helpers ───────────────────────────────────────────────────────────────

# One-line, secret-free outcome log (best-effort; never fails the caller).
log_line() {
  mkdir -p "$HMD_HOME" 2>/dev/null || return 0
  local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo '?')"
  printf '%s %s\n' "$ts" "$1" >> "$LOG_FILE" 2>/dev/null || true
}

# Strip a leading v and any suffix → a bare X.Y.Z (or '' if not clean semver).
norm_semver() {
  printf '%s' "${1:-}" \
    | sed -E 's/^[[:space:]]*v?([0-9]+\.[0-9]+\.[0-9]+).*/\1/' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true
}

# ── installed version (mirror bin/heimdall's heimdall_version resolution) ────────
# git tag (source of truth) → manifest fallback. Returns a bare X.Y.Z (no leading v),
# or '' if nothing resolves. Falls back to THIS repo's manifest when the plugin dir has
# no resolvable tag (e.g. a tarball install).
installed_version() {
  # TEST seam: an injected installed version short-circuits git/manifest resolution so a
  # test can simulate an arbitrary old install (v2.0.5) climbing. Normalised → bare X.Y.Z.
  local inj; inj="$(norm_semver "${HEIMDALL_INSTALLED_OVERRIDE:-}")"
  if [ -n "$inj" ]; then printf '%s' "$inj"; return 0; fi

  local ver=""
  if git -C "$PLUGIN_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    ver="$(git -C "$PLUGIN_DIR" describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true)"
    ver="$(norm_semver "$ver")"
  fi
  if [ -z "$ver" ]; then
    local manifest="$PLUGIN_DIR/.claude-plugin/plugin.json"
    if [ -f "$manifest" ]; then
      local raw=""
      if command -v jq >/dev/null 2>&1; then
        raw="$(jq -r '.version // empty' "$manifest" 2>/dev/null || true)"
      else
        raw="$(grep -oE '"version"[[:space:]]*:[[:space:]]*"[^"]+"' "$manifest" 2>/dev/null \
               | head -1 | sed -E 's/.*"([^"]+)".*/\1/')"
      fi
      ver="$(norm_semver "$raw")"
    fi
  fi
  printf '%s' "$ver"
}

# ── latest version ───────────────────────────────────────────────────────────────
# Resolution order:
#   1. HEIMDALL_LATEST_OVERRIDE (the TEST seam — never hits the network).
#   2. GitHub releases/latest → .tag_name (no auth; ~5s timeout).
#   3. git ls-remote --tags → highest semver (fallback when the API is unreachable).
# Prints a bare X.Y.Z, or '' if nothing resolves (caller treats '' as a clean no-op).
latest_version() {
  local override; override="$(norm_semver "${HEIMDALL_LATEST_OVERRIDE:-}")"
  if [ -n "$override" ]; then
    printf '%s' "$override"; return 0
  fi

  local tag=""
  # 2. Releases API. -f fails on HTTP errors, --max-time bounds the call so an
  # unreachable/slow API can never stall SessionStart. NO Authorization header.
  if command -v curl >/dev/null 2>&1; then
    local body
    body="$(curl -fsSL --max-time 5 -H 'Accept: application/vnd.github+json' \
              "$RELEASES_API" 2>/dev/null || true)"
    if [ -n "$body" ]; then
      if command -v jq >/dev/null 2>&1; then
        tag="$(printf '%s' "$body" | jq -r '.tag_name // empty' 2>/dev/null || true)"
      else
        tag="$(printf '%s' "$body" \
                | grep -oE '"tag_name"[[:space:]]*:[[:space:]]*"[^"]+"' \
                | head -1 | sed -E 's/.*"([^"]+)".*/\1/')"
      fi
    fi
  fi
  tag="$(norm_semver "$tag")"
  if [ -n "$tag" ]; then printf '%s' "$tag"; return 0; fi

  # 3. ls-remote fallback (no local mutation). Highest clean vMAJOR.MINOR.PATCH tag.
  if command -v git >/dev/null 2>&1; then
    local tags
    tags="$(GIT_TERMINAL_PROMPT=0 git ls-remote --tags --refs "$LSREMOTE_URL" 'v[0-9]*' 2>/dev/null \
              | sed -E 's#.*refs/tags/##' \
              | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true)"
    if [ -n "$tags" ]; then
      tag="$(printf '%s' "$tags" | sort -t. -k1.2,1n -k2,2n -k3,3n | tail -1)"
      tag="$(norm_semver "$tag")"
      [ -n "$tag" ] && { printf '%s' "$tag"; return 0; }
    fi
  fi
  printf ''
}

# ── semver compare ───────────────────────────────────────────────────────────────
# Echo "newer" iff $2 (latest) is strictly a greater version than $1 (installed);
# echo "same" otherwise (equal, downgrade, or either side unparseable). A malformed/
# empty version can NEVER trigger an apply — we only upgrade on a clean strict-greater.
semver_is_newer() {
  local installed; installed="$(norm_semver "$1")"
  local latest;    latest="$(norm_semver "$2")"
  [ -n "$installed" ] && [ -n "$latest" ] || { printf 'same'; return 0; }
  if command -v python3 >/dev/null 2>&1; then
    INST="$installed" LATE="$latest" python3 - <<'PYEOF'
import os
def parse(v): return tuple(int(x) for x in v.split('.'))
inst = parse(os.environ['INST']); late = parse(os.environ['LATE'])
print('newer' if late > inst else 'same')
PYEOF
    return 0
  fi
  # Pure-shell fallback (no python3): field-by-field numeric compare.
  local i1 i2 i3 l1 l2 l3
  IFS=. read -r i1 i2 i3 <<EOF
$installed
EOF
  IFS=. read -r l1 l2 l3 <<EOF
$latest
EOF
  if [ "$l1" -gt "$i1" ] 2>/dev/null \
     || { [ "$l1" -eq "$i1" ] && [ "$l2" -gt "$i2" ]; } 2>/dev/null \
     || { [ "$l1" -eq "$i1" ] && [ "$l2" -eq "$i2" ] && [ "$l3" -gt "$i3" ]; } 2>/dev/null; then
    printf 'newer'
  else
    printf 'same'
  fi
}

# ── throttle ───────────────────────────────────────────────────────────────────
# True (0) when a check ran within $INTERVAL seconds — skip this one. Stamp mtime is
# the clock; a missing/old stamp → not throttled. --force bypasses this entirely.
is_throttled() {
  [ -f "$STAMP" ] || return 1
  local now mtime age
  now="$(date +%s 2>/dev/null || echo 0)"
  mtime="$(stat -f %m "$STAMP" 2>/dev/null || stat -c %Y "$STAMP" 2>/dev/null || echo 0)"
  age=$(( now - mtime ))
  [ "$age" -ge 0 ] && [ "$age" -lt "$INTERVAL" ]
}

# Refresh the throttle stamp (a check ran). Best-effort.
touch_stamp() {
  mkdir -p "$HMD_HOME" 2>/dev/null || return 0
  : > "$STAMP" 2>/dev/null || true
}

# ── update-check cache (the SIGNAL the statusline + launcher notice consume) ─────
# The launcher's own cache writer (bin/heimdall check_for_update) is gated on an
# interactive TTY, so a headless SessionStart never refreshes it — the exact reason
# akshat/Madhavan had NO visible "you're behind" signal. This background `check` DOES
# run headless, so it publishes the same cache: a stale install SURFACES regardless of
# whether the user ever launches interactive `hmd`. We WRITE it; the statusline READS it.
#
# Schema + leading-v match bin/heimdall's _update_refresh_cache EXACTLY so a single
# consumer parses either writer's output:
#   {"checked_epoch":N,"installed":"vX.Y.Z","latest":"vA.B.C"}
# Atomic (temp + mv, so a concurrent reader never sees half a file). Best-effort:
# a write failure never fails the check (fail-open — the cache is advisory, not a gate).
write_update_cache() {
  local installed="$1" latest="$2"
  [ -n "$installed" ] && [ -n "$latest" ] || return 0
  mkdir -p "$HMD_HOME" 2>/dev/null || return 0
  local now; now="$(date +%s 2>/dev/null || echo 0)"
  local cache="$HMD_HOME/update-check.json"
  local tmp="${cache}.tmp.$$"
  # installed/latest are bare X.Y.Z here → prefix v to match the launcher's schema.
  printf '{"checked_epoch":%s,"installed":"v%s","latest":"v%s"}\n' \
    "$now" "$installed" "$latest" > "$tmp" 2>/dev/null \
    && mv -f "$tmp" "$cache" 2>/dev/null || rm -f "$tmp" 2>/dev/null || true
}

# ── opt-out ────────────────────────────────────────────────────────────────────
# Honored FIRST, before any work. Env switch OR the opt-out file → clean no-op.
opted_out() {
  [ "${HEIMDALL_NO_AUTOUPDATE:-0}" = "1" ] && return 0
  [ -f "$OPT_OUT_FILE" ] && return 0
  return 1
}

# A loud, user-facing refusal (stderr) so a blocked upgrade is never silent. SessionStart
# surfaces this line; the same fact is also written to the secret-free autoupdate.log.
_refuse_msg() {
  local latest="$1" reason="$2"
  printf 'heimdall: refusing auto-update to v%s — %s.\n' "$latest" "$reason" >&2
  printf 'heimdall: staying on the current, verified version (see SIGNING.md).\n' >&2
}

# ── re-assert the nightly /dream schedule after an update (self-heal) ────────────
# An upgrade can change the LaunchAgent plist FORMAT or the installed bin path; a
# stale/malformed plist would silently stop the nightly /dream. After the verified
# install.sh applies (which itself re-registers the schedule via its own install step),
# we RE-RUN the schedule installer here too — idempotent defense-in-depth so a
# plist-format/path change is healed and the nightly job keeps firing the CURRENT code.
#
# Gated EXACTLY like install.sh's schedule step (macOS + launchctl, honoring
# HEIMDALL_NO_DREAM_SCHEDULE) and BEST-EFFORT: it never changes the update's exit code.
# --repo + the schedule helper both resolve from $PLUGIN_DIR — the freshly-applied,
# stable installed tree — so the plist points at the always-current dream bin.
reassert_dream_schedule() {
  [ "${HEIMDALL_NO_DREAM_SCHEDULE:-0}" = "1" ] && return 0
  [ "$(uname -s 2>/dev/null)" = "Darwin" ] || return 0
  command -v launchctl >/dev/null 2>&1 || return 0
  local sched="$PLUGIN_DIR/bin/heimdall-dream-schedule"
  [ -x "$sched" ] || return 0
  if "$sched" install --repo "$PLUGIN_DIR" >/dev/null 2>&1; then
    log_line "dream-schedule re-asserted post-update (repo $PLUGIN_DIR)"
  else
    log_line "dream-schedule re-assert failed post-update — non-fatal"
  fi
  return 0
}

# ── apply (the atomic, detached, NEXT-session upgrade — SIGNATURE-GATED) ─────────
# Re-run the LATEST tag's idempotent installer DETACHED so it never blocks SessionStart —
# but ONLY after its install.sh signature verifies against the IN-REPO public key. This is
# the security boundary: a compromised release channel that swaps install.sh, or a release
# with no signature at all, is REFUSED and the client stays on its current, trusted version.
#
# Trust root = the LOCAL, already-installed release/heimdall-signing.pub (never a key fetched
# beside the artifact — that would let an attacker ship their own key). Fail-closed: missing
# verifier lib, missing/invalid/mismatched signature, or a download failure all REFUSE.
#
# The DRYRUN seam (decide-only, never used in production) stops short of BOTH verify and
# detach and logs would-apply — it exists purely so the offline autoupdate test can read the
# semver/opt-out/throttle DECISION without a network fetch or a real key.
apply_update() {
  local latest="$1"
  local from="${2:-}"                    # installed version (for the visible from→to log line)
  local ref="v${latest}"
  local span; span="v${from:-?} -> v${latest}"
  local url="${INSTALL_RAW_BASE}/${ref}/install.sh"
  local sig_url="https://github.com/${REPO_SLUG}/releases/download/${ref}/install.sh.minisig"
  local pubkey="${HEIMDALL_SIGNING_PUBKEY:-$PLUGIN_DIR/release/heimdall-signing.pub}"

  # Decide-only seam: no fetch, no verify, no exec (the autoupdate decision test).
  if [ "${HEIMDALL_AUTOUPDATE_DRYRUN:-0}" = "1" ] && [ "${HEIMDALL_VERIFY_ONLY:-0}" != "1" ]; then
    log_line "would-apply $latest via $url (dryrun)"
    return 0
  fi

  # Load the verifier library. It is the trust boundary — if it is absent we CANNOT verify,
  # so we refuse rather than apply unverified code.
  local verlib="$SELF_DIR/lib/heimdall-verify.sh"
  if [ ! -f "$verlib" ]; then
    log_line "refuse $latest verify-lib-missing ($verlib) — staying on current"
    _refuse_msg "$latest" "the signature-verification library is missing"
    return 1
  fi
  # shellcheck source=/dev/null
  . "$verlib" || { log_line "refuse $latest verify-lib-unloadable — staying on current"; _refuse_msg "$latest" "the signature verifier could not load"; return 1; }

  # Acquire the artifact + its detached signature. TEST seam: caller supplies local paths
  # (HEIMDALL_INSTALL_ARTIFACT / HEIMDALL_INSTALL_SIG) → no network.
  local artifact="${HEIMDALL_INSTALL_ARTIFACT:-}" sig="${HEIMDALL_INSTALL_SIG:-}" workdir=""
  if [ -z "$artifact" ]; then
    command -v curl >/dev/null 2>&1 || { log_line "apply-skip $latest no-curl"; _refuse_msg "$latest" "curl is required to download the release but is not installed"; return 1; }
    workdir="$(mktemp -d "${TMPDIR:-/tmp}/heimdall-apply.XXXXXX" 2>/dev/null)" \
      || { log_line "apply-skip $latest no-tmp"; _refuse_msg "$latest" "a temporary working directory could not be created"; return 1; }
    artifact="$workdir/install.sh"; sig="$workdir/install.sh.minisig"
    if ! curl -fsSL --max-time 30 "$url" -o "$artifact" 2>/dev/null; then
      rm -rf "$workdir"; log_line "refuse $latest download-failed ($url) — staying on current"
      _refuse_msg "$latest" "the release artifact could not be downloaded"; return 1
    fi
    # A missing signature asset is NOT a download error — it just fails verification below
    # (fail-closed: an unsigned release is refused, never applied).
    curl -fsSL --max-time 15 "$sig_url" -o "$sig" 2>/dev/null || true
  fi

  heimdall_verify_release "$artifact" "$sig" "$pubkey"
  local vrc=$?
  if [ "$vrc" -ne 0 ]; then
    local reason; reason="$(heimdall_verify_reason "$vrc")"
    log_line "refuse $latest signature rc=$vrc ($reason) — staying on current"
    _refuse_msg "$latest" "$reason"
    [ -n "$workdir" ] && rm -rf "$workdir"
    return 1
  fi
  log_line "verified $latest signature ok (pubkey $pubkey)"

  # Verify-only seam: prove the decision without executing anything (the signing test).
  if [ "${HEIMDALL_VERIFY_ONLY:-0}" = "1" ]; then
    printf 'verified %s\n' "$latest"
    [ -n "$workdir" ] && rm -rf "$workdir"
    return 0
  fi

  # Install the EXACT version we just resolved + verified — PIN HEIMDALL_REF=$ref so the
  # installer fetches THIS release, never its own baked DEFAULT_REF. Without this pin a stale
  # DEFAULT_REF (historically v2.0.5) silently DOWNGRADED every auto-update and re-triggered it
  # forever. The verified version is authoritative; install.sh's default is irrelevant here.

  # Foreground manual apply (the `hmd --update` / `heimdall-autoupdate update` path): run the
  # verified installer SYNCHRONOUSLY, streaming its output, and return its real exit code so the
  # caller can report success/failure LOUDLY. Never detached — the user is watching.
  if [ "${HEIMDALL_APPLY_FOREGROUND:-0}" = "1" ]; then
    log_line "auto-update: applying $span (foreground manual) — verified $ref"
    HEIMDALL_REF="$ref" bash "$artifact"
    local irc=$?
    # Post-apply: heal the nightly /dream LaunchAgent against a plist-format/path change.
    # Best-effort — never alters the install's exit code (irc).
    reassert_dream_schedule
    [ -n "$workdir" ] && rm -rf "$workdir"
    return "$irc"
  fi

  log_line "auto-update: applying $span (background; active on your next hmd launch) — verified $ref"
  # NB: the nightly /dream schedule is re-asserted for the BACKGROUND path by the applied
  # install.sh's OWN schedule step (it re-runs ensure_dream_schedule during this detached
  # install), so the plist self-heals to the current code without a fragile inline duplicate
  # here. The foreground `update` path calls reassert_dream_schedule directly (above).
  # Execute the EXACT bytes we verified (verify-then-run-same-file — no TOCTOU re-fetch).
  # Detached + fully backgrounded via setsid so it survives this process exiting and never
  # holds SessionStart open; the workdir is removed after the installer finishes.
  if command -v setsid >/dev/null 2>&1; then
    setsid env HEIMDALL_REF="$ref" bash -c "bash '$artifact' >>'$LOG_FILE' 2>&1; rm -rf '$workdir' 2>/dev/null" >/dev/null 2>&1 &
  else
    ( HEIMDALL_REF="$ref" bash "$artifact" >>"$LOG_FILE" 2>&1; rm -rf "$workdir" 2>/dev/null ) >/dev/null 2>&1 &
  fi
  disown 2>/dev/null || true
  return 0
}

# ── core: resolve installed vs latest, decide, maybe apply ──────────────────────
# Shared by `check` and `--force`. $1 = "force" to bypass the throttle. ALWAYS exit 0.
run_check() {
  local force="${1:-}"

  opted_out && { exit 0; }

  if [ "$force" != "force" ] && is_throttled; then
    exit 0   # checked recently — silent skip, no network.
  fi
  # A check is RUNNING → refresh the stamp now (even on a forced run) so the next
  # throttled check honors the window from this moment.
  touch_stamp

  local installed latest
  installed="$(installed_version)"
  latest="$(latest_version)"

  # Can't resolve either side (offline / parse-fail / no version) → clean no-op.
  if [ -z "$installed" ] || [ -z "$latest" ]; then
    log_line "check no-op (installed=${installed:-?} latest=${latest:-?})"
    exit 0
  fi

  # Publish the fresh installed/latest to the cache the statusline + launcher notice read —
  # BEFORE the apply decision, so a stale install SURFACES even when we don't/can't apply
  # (opt-in-signature refusal, no-curl, dryrun). This is the always-on visible-signal write.
  write_update_cache "$installed" "$latest"

  if [ "$(semver_is_newer "$installed" "$latest")" = "newer" ]; then
    apply_update "$latest" "$installed"
  else
    log_line "check current (installed=$installed latest=$latest)"
  fi
  exit 0
}

# ── status (read-only inspection — NEVER applies) ───────────────────────────────
cmd_status() {
  local installed latest pending
  installed="$(installed_version)"
  latest="$(latest_version)"
  if [ -n "$installed" ] && [ -n "$latest" ] \
     && [ "$(semver_is_newer "$installed" "$latest")" = "newer" ]; then
    pending="yes"
  else
    pending="no"
  fi
  printf 'installed: %s\n' "${installed:-unknown}"
  printf 'latest:    %s\n' "${latest:-unknown}"
  printf 'pending:   %s\n' "$pending"
  if opted_out; then
    printf 'autoupdate: off (opted out)\n'
  else
    printf 'autoupdate: on\n'
  fi
  exit 0
}

# ── update (MANUAL, foreground, LOUD, fail-closed) ───────────────────────────────
# The `hmd --update` path delegates here. Unlike the background `check`, this is an
# EXPLICIT user request: it ignores the throttle AND the auto-update opt-out (the user
# asked), resolves installed vs latest, and — iff newer — fetches, VERIFIES the release
# signature against the in-repo trust root, and applies it in the FOREGROUND so the user
# sees the result. Every failure is loud (stderr + non-zero exit); a tampered/unsigned
# release is REFUSED exactly like the background path (apply_update is the shared gate).
cmd_update() {
  local installed latest
  installed="$(installed_version)"
  latest="$(latest_version)"

  if [ -z "$latest" ]; then
    printf 'heimdall: could not determine the latest version (offline or GitHub unreachable).\n' >&2
    printf 'heimdall: staying on the current version — try again when you have a connection.\n' >&2
    exit 1
  fi
  if [ -z "$installed" ]; then
    printf 'heimdall: could not determine the installed version — cannot compare safely.\n' >&2
    exit 1
  fi

  if [ "$(semver_is_newer "$installed" "$latest")" != "newer" ]; then
    printf 'heimdall: already on the latest version (v%s).\n' "$installed"
    log_line "manual-update current (installed=$installed latest=$latest)"
    exit 0
  fi

  printf 'heimdall: updating v%s → v%s (verifying release signature)…\n' "$installed" "$latest"
  HEIMDALL_APPLY_FOREGROUND=1 apply_update "$latest" "$installed"
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    printf 'heimdall: ✔ updated to v%s — the new version is active on your next `hmd` launch.\n' "$latest"
    exit 0
  fi
  # apply_update already printed a loud, specific refusal reason to stderr.
  printf 'heimdall: ✗ update to v%s did NOT complete — you are still on v%s (see above / %s).\n' \
    "$latest" "$installed" "$LOG_FILE" >&2
  exit 1
}

# ── dispatch ─────────────────────────────────────────────────────────────────────
# TEST SEAM: let the acceptance harness `source` this updater to unit-test the pure
# helpers (reassert_dream_schedule, etc.) WITHOUT triggering the default `check` (which
# would hit the network). Unset in every production path — the SessionStart hook + `hmd
# --update` invoke this as a script, never sourced with this var — so behaviour is unchanged.
if [ -n "${HEIMDALL_AUTOUPDATE_SOURCE_ONLY:-}" ]; then
  return 0 2>/dev/null || exit 0
fi

SUB="${1:-check}"
case "$SUB" in
  check)        run_check ;;
  --force|force) run_check force ;;
  update)       cmd_update ;;
  status)       cmd_status ;;
  -h|--help|help)
    cat <<'USAGE'
heimdall-autoupdate — hmd keeps itself current, safely, in the background

  heimdall-autoupdate check      throttled background check; background-applies if newer (default)
  heimdall-autoupdate --force    ignore the throttle and check now (still background-applies)
  heimdall-autoupdate update     MANUAL foreground update: verify the signed release + apply now
  heimdall-autoupdate status     print installed + latest + whether an update is pending

Auto-update is ON by default. Opt out: HEIMDALL_NO_AUTOUPDATE=1 or a file at
${HOME}/.heimdall/no-autoupdate. Throttle window: HEIMDALL_UPDATE_INTERVAL (default 86400s).
Applies by re-running the latest release's idempotent install.sh detached — the upgrade
takes effect the NEXT session; the running session is never touched. Offline = clean no-op.
USAGE
    ;;
  *)
    echo "heimdall-autoupdate: unknown subcommand '$SUB' (try: check | --force | status)" >&2
    exit 2
    ;;
esac
