#!/usr/bin/env bash
# stack-pack — Detect a target project's stack(s) and resolve the knowledge packs
# that role agents (coder/architect/reviewer/...) should read at task start.
#
# Stack specialization ships as KNOWLEDGE PACKS loaded onto existing role agents,
# never as new role x stack agents. A pack is a Markdown file of conventions,
# directory layout, lint/test/build commands, acceptance-criteria templates, and
# failure patterns living at skills/stacks/<stack-id>/PACK.md inside the plugin
# (or in the installed pack of the stacks: see stacks_dir below).
#
# Layering (cold-start scaffold -> per-repo refinement):
#   1. Base pack    <stacks dir>/<id>/PACK.md    — generic scaffold: the installed pack of the stacks
#                   ($HEIMDALL_HOME/packs/stacks) when the machine lock pins exactly that build,
#                   else the plugin-shipped skills/stacks
#   2. Repo refine  .planning/skills/*.md        — learned, repo-specific overrides
# Agents read base packs first, then layer repo refinements on top.
set -euo pipefail

# Resolve this script's real directory so we can find sibling bin/ tools.
SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
# Plugin root: CLAUDE_PLUGIN_ROOT wins; else the parent of bin/.
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$BIN_DIR/.." && pwd)}"

usage() {
  cat <<'EOF'
Usage: stack-pack <command> [PATH]

Commands:
  detect [PATH]   Run stack-detect on PATH (default: cwd). Emits stack-detect JSON.
  load   [PATH]   Detect stacks in PATH, then print the pack file paths agents
                  should read: base packs first, then .planning/skills/ refinements.
  paths  [PATH]   Alias for load.
  --help          Show this help.

Resolution:
  Base packs are read from the installed pack of the stacks,
  $HEIMDALL_HOME/packs/stacks (default ~/.heimdall), when that pack is exactly the
  build the machine lock, $HEIMDALL_HOME/skills.lock, pins. In every other state
  (no pack, a changed file, no lock row, no python3) they are read from the
  bundled copy, silently, never as an error. The bundled copy resolves via
  CLAUDE_PLUGIN_ROOT (or the plugin dir containing this script) at:
  <plugin>/skills/stacks/<stack-id>/PACK.md
  Repo refinements come from <PATH>/.planning/skills/*.md and layer on top.
EOF
}

CMD="${1:-}"
case "$CMD" in
  --help|-h|"") usage; [ -z "$CMD" ] && exit 1 || exit 0 ;;
esac
shift || true

TARGET="${1:-.}"
DETECTOR="$BIN_DIR/stack-detect"

run_detect() {
  if [ -x "$DETECTOR" ]; then
    "$DETECTOR" "$TARGET"
  elif [ -f "$DETECTOR" ]; then
    bash "$DETECTOR" "$TARGET"
  else
    # Detector missing -> behave like an empty result rather than crashing.
    printf '{"stacks":[],"signals":[]}\n'
  fi
}

# Extract the "stacks" array from stack-detect JSON, one id per line.
parse_stacks() {
  local json="$1"
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$json" | jq -r '.stacks[]?' 2>/dev/null || true
  else
    # Fallback parser: pull the bracketed stacks array and split quoted tokens.
    printf '%s' "$json" \
      | sed -n 's/.*"stacks":\[\([^]]*\)\].*/\1/p' \
      | tr ',' '\n' \
      | sed -e 's/^[[:space:]]*"//' -e 's/"[[:space:]]*$//' \
      | grep -v '^$' || true
  fi
}

# Which copy of skills/stacks the base packs are read from: the installed pack,
# $HEIMDALL_HOME/packs/stacks, when it is exactly the build the machine lock pins,
# else the bundled <plugin>/skills/stacks. bin/lib/skills_packs.py decides, once for
# the whole directory (docs/superpowers/plans/2026-11-12-3x-lean-core.md T2.1, T3.1).
# INV-L5: every way a pack cannot be used (no pack, a changed byte, no lock row, no
# python3, a resolver that fails or answers anything but an absolute path) is the
# bundled copy, SILENTLY, never an error. A stack the chosen copy lacks has no base
# pack, as it never had one when the bundled copy lacked it.
stacks_dir() {
  local resolver="$BIN_DIR/lib/skills_packs.py" dir=""
  if [ -f "$resolver" ] && command -v python3 >/dev/null 2>&1; then
    dir="$(CLAUDE_PLUGIN_ROOT="$PLUGIN_ROOT" python3 -B -I -S "$resolver" resolve stacks 2>/dev/null)" || dir=""
  fi
  case "$dir" in
    /*) printf '%s\n' "$dir" ;;
    *) printf '%s\n' "$PLUGIN_ROOT/skills/stacks" ;;
  esac
}

case "$CMD" in
  detect)
    run_detect
    ;;

  load|paths)
    DETECT_JSON="$(run_detect)"
    found_any=0

    # 1. Base packs (cold-start scaffold): resolved at the first detected stack, so a
    #    tree with no stack signal never starts python.
    STACKS_DIR=""
    while IFS= read -r stack; do
      [ -n "$stack" ] || continue
      [ -n "$STACKS_DIR" ] || STACKS_DIR="$(stacks_dir)"
      pack="$STACKS_DIR/$stack/PACK.md"
      if [ -f "$pack" ]; then
        printf '%s\n' "$pack"
        found_any=1
      fi
    done <<EOF
$(parse_stacks "$DETECT_JSON")
EOF

    # 2. Repo-specific refinements (layered on top of base packs).
    REFINE_DIR="$TARGET/.planning/skills"
    if [ -d "$REFINE_DIR" ]; then
      for refine in "$REFINE_DIR"/*.md; do
        [ -f "$refine" ] || continue
        printf '%s\n' "$refine"
        found_any=1
      done
    fi

    # Nothing resolved: succeed quietly with no output (no pack is a valid state).
    [ "$found_any" -eq 1 ] || true
    ;;

  *)
    printf 'stack-pack: unknown command %q\n' "$CMD" >&2
    usage >&2
    exit 1
    ;;
esac
