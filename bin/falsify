#!/usr/bin/env bash
# falsify — the falsifiability harness (oracle-gate keystone).
#
# Proves a gate can actually go RED, operating ONLY on the gate's shipped
# fixtures. It NEVER touches a flagship implementation (impls are out of scope;
# they exist only at benchmark time). For a domain:
#
#   1. Run the gate's comparison against fixtures/golden/  -> MUST be GREEN.
#      (a gate that rejects its own golden is a false-RED and is itself broken.)
#   2. For each mutant in fixtures/mutants/, apply the named gate's comparison to
#      the mutant's corrupted output vs its correct reference -> the gate MUST go
#      RED (mutant KILLED). A mutant that stays GREEN = SURVIVED = the gate is
#      non-falsifiable for that defect.
#
# Falsifiability score = mutants killed / total, conditioned on golden passing.
# A P0 gate requires score 1.0.
#
# THE STRUCTURED SEAM (spec 2A):
#   falsify is a PURE ORCHESTRATOR over the typed gate contract. It does NOT
#   diff anything itself. For every check it invokes the domain's structured
#   entry point — `evals/oracles/<domain>/run.sh --input <fixture> --report
#   <tmp>` — and reads the TYPED report.json that run.sh writes. run.sh is the
#   SINGLE source of diff-truth (whole-output trade-sequence + book-state diff for
#   exchange-lob; per-instruction trace diff for emulator-gb). falsify reads
#   report.json.status and report.json.first_divergence from the structured
#   fields — it NEVER scrapes run.sh stdout. See evals/oracles/REPORT-CONTRACT.md.
#
#     golden -> run.sh --input <golden>  -> report.status MUST be "pass"  (false-RED check)
#     mutant -> run.sh --input <mutant>  -> report.status "fail" => KILLED (gate went red)
#                                           report.status "pass" => SURVIVED (false-green)
#
# THE FALSE-GREEN REGRESSION GUARD (tautological-concurrency):
#   Some mutants are not defect-INPUTS but tautological GATE constructions that
#   cannot fail by design (the raw-arm `Promise.all`-over-synchronous-`submit`
#   test). The manifest marks these `is_false_green_regression_guard: true`.
#   When such a construction is used AS the gate, a real defect SURVIVES — the
#   gate stays green when it must go red. THE GATE ITSELF (run.sh) must detect
#   the tautological construction and emit a `fail` report; falsify is a pure
#   orchestrator and NEVER short-circuits a guard. Guards are GATE-INVOKED exactly
#   like defect mutants: falsify runs `run.sh --input <guard-fixture>` and reads
#   report.json.status. status=="fail" => the gate correctly rejected the non-
#   falsifiable construction => the guard is KILLED, and falsify emits the literal
#   line `REJECTED: mutant survived` (the build-blocking reject contract). The
#   manifest flag only selects that contract WORDING — it does NOT decide the
#   verdict; run.sh does. If run.sh ever returns status=="pass" for a guard, the
#   gate failed to detect the tautology -> the guard SURVIVED -> score < 1.0,
#   nonzero exit. This reconciles the two acceptance contracts: `--assert-score
#   1.0` passes only when the gate actually detected every mutant (incl. the
#   guard) AND `--mutant tautological-concurrency` prints the exact reject line.
#
# Usage:
#   falsify <domain>                       run golden + all mutants, report score
#   falsify <domain> --assert-score <S>    exit 0 ONLY IF golden passes AND every
#                                          mutant is correctly handled (score>=S)
#   falsify <domain> --mutant <name>       run one named mutant fixture
#   -h, --help                             show help
#
# Exit codes: 0 = all assertions held; nonzero = golden failed, a mutant
# survived, score below target, or a usage/IO error.
set -euo pipefail

# ── Resolve paths ──
SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$BIN_DIR/.." && pwd)"
ORACLES_DIR="$PLUGIN_DIR/evals/oracles"

command -v jq >/dev/null 2>&1 || { echo "error: jq is required" >&2; exit 2; }

usage() { sed -n '2,56p' "$SELF"; }

# ── Args ──
DOMAIN=""
ASSERT_SCORE=""
ONE_MUTANT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --assert-score) ASSERT_SCORE="${2:?--assert-score needs a value (e.g. 1.0)}"; shift 2 ;;
    --mutant)       ONE_MUTANT="${2:?--mutant needs a name}"; shift 2 ;;
    -h|--help)      usage; exit 0 ;;
    --*)            echo "error: unknown flag: $1" >&2; usage >&2; exit 2 ;;
    *)
      if [ -z "$DOMAIN" ]; then DOMAIN="$1"; shift
      else echo "error: unexpected argument: $1" >&2; usage >&2; exit 2; fi
      ;;
  esac
done

[ -n "$DOMAIN" ] || { echo "error: <domain> is required" >&2; usage >&2; exit 2; }

DOMAIN_DIR="$ORACLES_DIR/$DOMAIN"
RUN_SH="$DOMAIN_DIR/run.sh"
MANIFEST="$DOMAIN_DIR/fixtures/mutants/manifest.json"
GOLDEN_DIR="$DOMAIN_DIR/fixtures/golden"
MUTANTS_DIR="$DOMAIN_DIR/fixtures/mutants"

[ -d "$DOMAIN_DIR" ]  || { echo "error: unknown domain: $DOMAIN (no $DOMAIN_DIR)" >&2; exit 2; }
[ -f "$RUN_SH" ]      || { echo "error: structured entry point missing: $RUN_SH" >&2; exit 2; }
[ -f "$MANIFEST" ]    || { echo "error: manifest missing: $MANIFEST" >&2; exit 2; }
[ -d "$GOLDEN_DIR" ]  || { echo "error: golden dir missing: $GOLDEN_DIR" >&2; exit 2; }
[ -d "$MUTANTS_DIR" ] || { echo "error: mutants dir missing: $MUTANTS_DIR" >&2; exit 2; }

if [ -n "$ASSERT_SCORE" ] && [ -n "$ONE_MUTANT" ]; then
  echo "error: --assert-score and --mutant are mutually exclusive" >&2
  exit 2
fi

GUARD_REJECT_LINE="REJECTED: mutant survived"

# Per-domain golden fixture path (the input run.sh grades for the false-RED check)
# and, where the gate diffs against a separate truth log, an INDEPENDENTLY-DERIVED
# truth file (R-2). For emulator-gb the truth MUST be passed to run.sh explicitly
# and MUST be a different file from the input — run.sh's default truth IS its input,
# so omitting --truth made the golden check an X-vs-X self-diff that could never go
# red. exchange-lob derives its serial-replay reference from the input's `orders`
# (reference/matcher.mjs), so it takes no separate truth file.
GOLDEN_TRUTH=""
case "$DOMAIN" in
  exchange-lob) GOLDEN_INPUT="$GOLDEN_DIR/order-stream.json" ;;
  emulator-gb)  GOLDEN_INPUT="$GOLDEN_DIR/trace.gbdoctor"
                GOLDEN_TRUTH="$GOLDEN_DIR/trace.truth.gbdoctor" ;;
  # ponytail-underdelivery: the golden INPUT is the fully-delivered candidate
  # implementation; the acceptance ORACLE is run.sh's internal default --truth
  # (fixtures/golden/acceptance.json), applied identically to golden and every
  # mutant, so NO separate GOLDEN_TRUTH is wired here. Input (the code) and truth
  # (the fixed expected-output table) are different KINDS of artifact — this is
  # not an X-vs-X self-comparison: a broken candidate fails the golden check
  # (proven by test/heimdall-underdelivery-guard.test.sh's corrupt-and-confirm).
  ponytail-underdelivery) GOLDEN_INPUT="$GOLDEN_DIR/candidate.mjs" ;;
  *) echo "error: no golden fixture wired for domain '$DOMAIN'" >&2; exit 2 ;;
esac

# ═══════════════════════════════════════════════════════════════════════════
#  The structured seam: invoke run.sh, read the typed report.json.
#  run.sh is the SINGLE source of diff-truth. falsify reads only the typed
#  fields (status, first_divergence) — never run.sh stdout.
# ═══════════════════════════════════════════════════════════════════════════

# Invoke the domain's run.sh against an input, capture report.json in a temp
# file, and echo the temp path. run.sh exits nonzero on a fail status (by
# contract) — that is EXPECTED for mutants, so we do not let it abort falsify.
# A run.sh usage/IO error (exit 2) produces no usable report -> caller detects
# the missing/invalid status and treats it as an error.
run_gate() {
  local input="$1" report
  report="$(mktemp)"
  # run.sh exit: 0=pass, 1=fail (both write a valid report), 2=IO/usage error.
  # When the domain ships a separate independently-derived truth log (emulator-gb,
  # R-2), forward it as --truth so the diff is input-vs-independent-truth, never the
  # X-vs-X self-diff run.sh's default truth would produce.
  if [ -n "$GOLDEN_TRUTH" ]; then
    bash "$RUN_SH" --input "$input" --truth "$GOLDEN_TRUTH" --report "$report" >/dev/null 2>&1 || true
  else
    bash "$RUN_SH" --input "$input" --report "$report" >/dev/null 2>&1 || true
  fi
  echo "$report"
}

# Read the typed `status` field from a report.json. Echoes pass|fail, or empty
# if the report is missing/unreadable/has no status (a contract violation).
report_status() {
  local report="$1"
  [ -s "$report" ] || { echo ""; return 0; }
  jq -r '.status // empty' "$report" 2>/dev/null || echo ""
}

# Render the typed `first_divergence` field (the kill pinpoint) from report.json
# for human-readable stdout. first_divergence is now a STRUCTURED object
# {file, step, expected, actual} (spec H-1) — flatten it to one line. null/absent
# prints a sentinel; a legacy string (older gate) is printed verbatim.
report_first_divergence() {
  local report="$1"
  jq -r '
    .first_divergence as $d
    | if $d == null then "(no first_divergence in report)"
      elif ($d | type) == "object"
      then "\($d.step): expected \($d.expected) actual \($d.actual)"
      else ($d | tostring) end
  ' "$report" 2>/dev/null || echo "(unreadable report)"
}

# ═══════════════════════════════════════════════════════════════════════════
#  Golden check + per-mutant kill check, both driven through run.sh + report.json.
#  kill_mutant returns:
#    0  -> mutant KILLED (gate correctly went RED, or false-green guard correctly
#          rejected as non-falsifiable)
#    1  -> mutant SURVIVED (gate stayed GREEN when it must have gone RED)
# ═══════════════════════════════════════════════════════════════════════════

golden_check() {
  # Run the domain's gate against its own golden fixture via run.sh and read the
  # typed status: it MUST be "pass". A "fail" means the gate is over-strict
  # (false-RED) and is itself broken.
  [ -f "$GOLDEN_INPUT" ] || { echo "  golden missing: $GOLDEN_INPUT" >&2; return 1; }
  echo "  golden: ${GOLDEN_INPUT#"$PLUGIN_DIR"/}"

  # R-2 falsifiability precondition: where a separate truth log is used, the truth
  # file MUST exist and MUST NOT be the input file. An X-vs-X comparison (truth path
  # == input path) can never go red, so it proves nothing — refuse to run it.
  if [ -n "$GOLDEN_TRUTH" ]; then
    [ -f "$GOLDEN_TRUTH" ] || { echo "  golden truth missing: $GOLDEN_TRUTH" >&2; return 1; }
    local in_abs truth_abs
    in_abs="$(cd "$(dirname "$GOLDEN_INPUT")" && pwd)/$(basename "$GOLDEN_INPUT")"
    truth_abs="$(cd "$(dirname "$GOLDEN_TRUTH")" && pwd)/$(basename "$GOLDEN_TRUTH")"
    if [ "$in_abs" = "$truth_abs" ]; then
      echo "  golden check is X-vs-X: --truth path equals --input path ($in_abs) — non-falsifiable, refusing" >&2
      return 1
    fi
    echo "  truth:  ${GOLDEN_TRUTH#"$PLUGIN_DIR"/} (independent derivation; input path != truth path)"
  fi

  local report status
  report="$(run_gate "$GOLDEN_INPUT")"
  status="$(report_status "$report")"
  rm -f "$report"
  if [ "$status" = "pass" ]; then
    echo "  golden GREEN: run.sh report.json status=pass (gate not over-strict)"
    return 0
  fi
  echo "  golden report.json status='${status:-<none>}' (expected pass) — gate is over-strict (false-RED)" >&2
  return 1
}

kill_mutant() {
  local name="$1"
  local file is_guard
  file="$(jq -r --arg n "$name" '.mutants[] | select(.name==$n) | .file' "$MANIFEST")"
  is_guard="$(jq -r --arg n "$name" \
    '.mutants[] | select(.name==$n) | (.is_false_green_regression_guard // false)' "$MANIFEST")"
  [ -n "$file" ] || { echo "  unknown mutant: $name" >&2; return 1; }
  local fixture="$MUTANTS_DIR/$file"
  [ -f "$fixture" ] || { echo "  mutant fixture missing: $fixture" >&2; return 1; }

  # GATE-INVOKED for EVERY mutant, defect-input or false-green guard alike. There
  # is NO short-circuit: falsify feeds the fixture to run.sh and reads the typed
  # status. run.sh is the single source of diff-truth — for a guard it must detect
  # the non-falsifiable construction itself and emit a `fail` report. The manifest
  # `is_guard` flag selects only the OUTPUT WORDING (the build-blocking reject
  # contract line vs the defect-kill pinpoint); it never decides the verdict.
  local report status
  report="$(run_gate "$fixture")"
  status="$(report_status "$report")"

  if [ "$status" = "fail" ]; then
    # Gate went RED on this mutant -> KILLED. The gate (run.sh) made this call.
    if [ "$is_guard" = "true" ]; then
      # False-green regression guard: the gate correctly detected the tautological
      # construction and rejected it as non-falsifiable. The build-blocking reject
      # contract line IS the kill for a guard.
      echo "  mutant '$name' is a false-green regression guard (tautological gate construction)"
      echo "  gate detected the non-falsifiable construction (report.json status=fail) and rejected it"
      echo "    first_divergence: $(report_first_divergence "$report")"
      echo "  $GUARD_REJECT_LINE"
    else
      # Real defect mutant: report the kill from the structured first_divergence
      # field (NOT scraped stdout).
      echo "  mutant '$name' KILLED: gate went RED (report.json status=fail)"
      echo "    first_divergence: $(report_first_divergence "$report")"
    fi
    rm -f "$report"
    return 0
  fi

  if [ "$status" = "pass" ]; then
    # Gate stayed GREEN on this mutant -> SURVIVED -> false-green. For a guard this
    # means run.sh failed to detect the tautological construction.
    rm -f "$report"
    if [ "$is_guard" = "true" ]; then
      echo "  mutant '$name' SURVIVED: gate did NOT detect the tautological construction (report.json status=pass) — the guard-detection is dead"
    fi
    echo "  $GUARD_REJECT_LINE"
    return 1
  fi

  # No usable status: run.sh produced no valid report (IO/usage error).
  rm -f "$report"
  echo "  mutant '$name' ERROR: run.sh produced no valid report.json status (got '${status:-<none>}')" >&2
  return 1
}

# All mutant names from the manifest, in declaration order.
all_mutants() { jq -r '.mutants[].name' "$MANIFEST"; }

# Count of false-green regression guards declared in the manifest. Guards are
# gate-invoked exactly like defect mutants; this is only for the score-line
# annotation that records they were NOT short-circuited.
guard_count() {
  jq -r '[.mutants[] | select(.is_false_green_regression_guard == true)] | length' "$MANIFEST"
}

# ═══════════════════════════════════════════════════════════════════════════
#  Modes
# ═══════════════════════════════════════════════════════════════════════════

# ── single-mutant mode ──
if [ -n "$ONE_MUTANT" ]; then
  echo "falsify $DOMAIN --mutant $ONE_MUTANT"
  if ! jq -e --arg n "$ONE_MUTANT" 'any(.mutants[]; .name==$n)' "$MANIFEST" >/dev/null; then
    echo "error: no mutant named '$ONE_MUTANT' in $MANIFEST" >&2
    exit 2
  fi
  if kill_mutant "$ONE_MUTANT"; then
    echo "RESULT: mutant '$ONE_MUTANT' correctly handled (killed / rejected as non-falsifiable)"
    exit 0
  else
    # kill_mutant already printed the literal `REJECTED: mutant survived` line.
    echo "RESULT: mutant '$ONE_MUTANT' SURVIVED — gate is non-falsifiable for this defect"
    exit 1
  fi
fi

# ── full sweep (default + --assert-score) ──
echo "falsify $DOMAIN — falsifiability sweep"
echo "manifest: ${MANIFEST#"$PLUGIN_DIR"/}"
echo "gate:     ${RUN_SH#"$PLUGIN_DIR"/} (structured report.json seam)"
echo ""
echo "[1] golden (gate MUST pass — false-RED check)"
golden_rc=0
golden_check || golden_rc=$?
echo ""

if [ "$golden_rc" -ne 0 ]; then
  echo "GOLDEN FAILED: the gate rejects its own known-correct golden fixture."
  echo "The gate is over-strict (false-RED) and is itself broken; score is undefined."
  echo "SCORE: 0/0 (golden precondition failed)"
  exit 1
fi

echo "[2] mutants (gate MUST reject each — false-GREEN check)"
total=0
killed=0
survived_names=()
while IFS= read -r m; do
  [ -n "$m" ] || continue
  total=$(( total + 1 ))
  echo "  --- mutant: $m ---"
  if kill_mutant "$m"; then
    killed=$(( killed + 1 ))
  else
    survived_names+=("$m")
  fi
done < <(all_mutants)
echo ""

if [ "$total" -eq 0 ]; then
  echo "error: no mutants declared in manifest" >&2
  exit 2
fi

# Score = killed / total, conditioned on golden passing.
score="$(awk -v k="$killed" -v t="$total" 'BEGIN { printf "%.4f", k / t }')"
# Annotate guards: they were gate-invoked (run.sh decided the verdict), not
# short-circuited by a manifest flag.
guards="$(guard_count)"
if [ "$guards" -gt 0 ]; then
  echo "SCORE: $killed/$total = $score (golden passing) (incl. $guards guard, gate-invoked)"
else
  echo "SCORE: $killed/$total = $score (golden passing)"
fi
if [ "${#survived_names[@]}" -gt 0 ]; then
  echo "SURVIVED: ${survived_names[*]}"
fi

# ── assertion ──
if [ -n "$ASSERT_SCORE" ]; then
  want="$(awk -v s="$ASSERT_SCORE" 'BEGIN { printf "%.4f", s }')"
  # PASS iff golden passed (already true here) AND no mutant survived AND score >= target.
  if [ "${#survived_names[@]}" -eq 0 ] \
     && awk -v sc="$score" -v w="$want" 'BEGIN { exit !(sc >= w) }'; then
    echo "ASSERT PASS: score $score >= target $ASSERT_SCORE (golden passed, no mutant survived)"
    exit 0
  fi
  echo "ASSERT FAIL: score $score < target $ASSERT_SCORE (or a mutant survived)"
  exit 1
fi

# default mode: nonzero if any mutant survived
[ "${#survived_names[@]}" -eq 0 ]
