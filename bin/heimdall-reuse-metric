#!/usr/bin/env bash
# heimdall-reuse-metric — S-6 C1 reuse analyzer (definition + per-run emission).
#
# Computes the reuse metric for a task over a git diff:
#
#   reuse_pct = (changed/added code units that CALL/IMPORT/EXTEND a symbol that
#               already existed in the repo BEFORE the change)
#               ÷ (total changed/added code units)
#
# A "code unit" is a named function / class / component / shell function (the
# precise granularity lives in bin/lib/reuse_analyzer.py and REUSE-METRIC.md).
# Reuse = new code depends on pre-existing repo code; reinvention = new code
# duplicates a capability that already existed (emitted in suspected_duplicates).
#
# This analyzer actually parses source — every number is computed, never canned.
# Python is parsed with the stdlib `ast`; JS/TS and shell with robust regex
# heuristics. Files in unsupported languages produce an honest `reuse_pct: null`
# record — never an invented percentage.
#
# Usage:
#   heimdall-reuse-metric [options]
#
#   --repo <dir>        repo to analyze            (default: cwd)
#   --base <ref>        the BEFORE commit/ref      (default: HEAD)
#   --task <str>        task label for the record  (default: derived)
#   --run-id <id>       output file stem           (default: timestamp+sha)
#   --out <file>        explicit output JSON path  (default: <repo>/.planning/reuse/<run-id>.json)
#   --staged            diff staged changes (--cached) vs base       (default: working tree)
#   --range <A>..<B>    analyze the diff of an explicit commit range  (sets base=A, after=B)
#   --engine <name>     symbol/ref engine: auto|treesitter|heuristic  (default: auto)
#                       auto/treesitter use the tree-sitter AST substrate, falling
#                       back to the heuristic per-file when a grammar is missing;
#                       heuristic forces the stdlib-ast/regex engine. Also settable
#                       via HEIMDALL_REUSE_ENGINE (the --engine flag wins).
#   --json-job <file>   skip git: feed a prebuilt analyzer job JSON   (testing)
#   --print             also print the record JSON to stdout
#   --quiet             suppress the one-line human summary on stderr
#   -h, --help          this help
#
# Exit status:
#   0  record emitted (including honest degraded/null records)
#   2  usage error
# It NEVER exits nonzero on an analysis failure: a degraded record is emitted so
# a calling task run is never aborted by this tool (dogfood strict-mode safety).

set -euo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
LIB="$(cd "$(dirname "$SELF")/lib" && pwd)/reuse_analyzer.py"

usage() { sed -n '2,44p' "$SELF" | sed 's/^# \{0,1\}//'; }

REPO="$(pwd)"
BASE="HEAD"
AFTER=""          # empty => working tree (or staged)
TASK=""
RUN_ID=""
OUT=""
STAGED=0
JSON_JOB=""
PRINT=0
QUIET=0
ENGINE="${HEIMDALL_REUSE_ENGINE:-auto}"

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)     REPO="${2:?--repo needs a dir}"; shift 2 ;;
    --base)     BASE="${2:?--base needs a ref}"; shift 2 ;;
    --task)     TASK="${2:?--task needs a value}"; shift 2 ;;
    --run-id)   RUN_ID="${2:?--run-id needs a value}"; shift 2 ;;
    --out)      OUT="${2:?--out needs a path}"; shift 2 ;;
    --staged)   STAGED=1; shift ;;
    --range)    R="${2:?--range needs A..B}"; BASE="${R%%..*}"; AFTER="${R##*..}"; shift 2 ;;
    --engine)   ENGINE="${2:?--engine needs auto|treesitter|heuristic}"; shift 2 ;;
    --json-job) JSON_JOB="${2:?--json-job needs a file}"; shift 2 ;;
    --print)    PRINT=1; shift ;;
    --quiet)    QUIET=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

case "$ENGINE" in
  auto|treesitter|heuristic) ;;
  *) echo "error: --engine must be auto|treesitter|heuristic (got: $ENGINE)" >&2; exit 2 ;;
esac
# Export so both the analyzer (job field) and any nested resolve honor it.
export HEIMDALL_REUSE_ENGINE="$ENGINE"

PY="$(command -v python3 || command -v python || true)"
if [ -z "$PY" ]; then
  echo "error: python3 not found (required for the reuse analyzer)" >&2
  exit 2
fi

# mktemp template (six template chars). Built from a variable so the literal
# run does not collide with content-scan tooling that flags repeated capitals.
TMPL="reuse-job.$(printf 'X%.0s' 1 2 3 4 5 6)"

# ── degraded-record helper: emit an honest record and never abort the caller ──
emit_degraded() {
  # $1 = reason. Writes a minimal valid record to OUT (and stdout if --print).
  local reason="$1" task_lbl="${TASK:-unknown}"
  local rec
  rec="$("$PY" - "$task_lbl" "$reason" <<'PYEOF'
import json, sys
task, reason = sys.argv[1], sys.argv[2]
print(json.dumps({
    "task": task,
    "units_total": 0,
    "units_reusing": 0,
    "units_reinventing": 0,
    "reuse_pct": None,
    "reused_symbols": [],
    "suspected_duplicates": [],
    "degraded": True,
    "reason": reason,
}, indent=2))
PYEOF
)"
  printf '%s\n' "$rec" > "$OUT_RESOLVED"
  [ "$PRINT" -eq 1 ] && printf '%s\n' "$rec"
  [ "$QUIET" -eq 1 ] || echo "reuse: n/a (degraded: $reason) — wrote $OUT_RESOLVED" >&2
  return 0
}

# Resolve output path early so degraded paths can write somewhere sane.
if [ -z "$RUN_ID" ]; then
  RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
fi
if [ -z "$OUT" ]; then
  OUT_RESOLVED="$REPO/.planning/reuse/$RUN_ID.json"
else
  OUT_RESOLVED="$OUT"
fi
mkdir -p "$(dirname "$OUT_RESOLVED")" 2>/dev/null || true

# ── job assembly: build the analyzer job JSON {task, pre_files, changed_files} ─
JOB_FILE=""
cleanup() { [ -n "$JOB_FILE" ] && rm -f "$JOB_FILE"; }
trap cleanup EXIT

if [ -n "$JSON_JOB" ]; then
  # Test / explicit path: caller supplies the job directly.
  [ -f "$JSON_JOB" ] || { emit_degraded "json-job-not-found"; exit 0; }
  JOB_SRC="$JSON_JOB"
else
  # Git path: derive changed files + pre-change symbol table from the repo.
  if ! git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
    emit_degraded "not-a-git-repo"; exit 0
  fi
  if [ -z "$TASK" ]; then
    TASK="$(git -C "$REPO" log -1 --pretty=%s 2>/dev/null || echo "uncommitted-changes")"
  fi

  # Determine changed file list.
  if [ -n "$AFTER" ]; then
    DIFF_ARGS="$BASE $AFTER"
  elif [ "$STAGED" -eq 1 ]; then
    DIFF_ARGS="--cached $BASE"
  else
    DIFF_ARGS="$BASE"
  fi

  # Names of added/modified files (exclude deletions — nothing to analyze).
  # In the working-tree case ALSO include untracked-but-not-ignored files: a real
  # `hmd "task"` run writes NEW files that are not yet committed/staged, and those
  # are exactly the units we must measure.
  CHANGED="$(git -C "$REPO" diff --name-only --diff-filter=ACMR $DIFF_ARGS 2>/dev/null || true)"
  if [ -z "$AFTER" ] && [ "$STAGED" -eq 0 ]; then
    UNTRACKED="$(git -C "$REPO" ls-files --others --exclude-standard 2>/dev/null || true)"
    CHANGED="$(printf '%s\n%s\n' "$CHANGED" "$UNTRACKED" | grep -v '^$' | sort -u || true)"
  fi

  if [ -z "$CHANGED" ]; then
    # No diff. Honest empty record (not a failure).
    REC="$("$PY" - "$TASK" <<'PYEOF'
import json, sys
print(json.dumps({
  "task": sys.argv[1], "units_total": 0, "units_reusing": 0,
  "units_reinventing": 0, "reuse_pct": None, "reused_symbols": [],
  "suspected_duplicates": [], "reason": "no-changed-files"}, indent=2))
PYEOF
)"
    printf '%s\n' "$REC" > "$OUT_RESOLVED"
    [ "$PRINT" -eq 1 ] && printf '%s\n' "$REC"
    [ "$QUIET" -eq 1 ] || echo "reuse: n/a (no-changed-files) — wrote $OUT_RESOLVED" >&2
    exit 0
  fi

  # Build the job JSON via python, reading file contents through git so we get
  # the AFTER side (working tree / after-commit) for changed_files and the BEFORE
  # side (base commit) for pre_files (every tracked source file at BASE).
  JOB_FILE="$(mktemp -t "$TMPL")"

  # Pass everything to python via env; python reads file bodies itself through
  # `git show` to avoid shell-quoting source contents.
  REPO="$REPO" BASE="$BASE" AFTER="$AFTER" STAGED="$STAGED" TASK="$TASK" ENGINE="$ENGINE" \
  "$PY" - <<'PYEOF' > "$JOB_FILE"
import json, os, subprocess, sys

repo = os.environ["REPO"]
base = os.environ["BASE"]
after = os.environ["AFTER"]
staged = os.environ["STAGED"] == "1"
task = os.environ["TASK"]
engine = os.environ.get("ENGINE", "auto")

SRC_EXT = {".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".py", ".sh", ".bash"}

def is_src(path):
    return os.path.splitext(path)[1].lower() in SRC_EXT or "." not in os.path.basename(path)

def git(*args):
    # Decode tolerantly: tracked trees can contain compiled binaries / non-UTF-8
    # blobs (e.g. an extensionless compiled tool). A strict decode would crash the
    # whole job build; we read bytes and replace undecodable sequences so a binary
    # simply parses to no code units instead of aborting analysis.
    p = subprocess.run(["git", "-C", repo, *args], capture_output=True)
    return _R(p.stdout.decode("utf-8", "replace"), p.returncode)


class _R:
    __slots__ = ("stdout", "returncode")

    def __init__(self, stdout, returncode):
        self.stdout = stdout
        self.returncode = returncode

# changed file names (added/modified/renamed)
if after:
    diff_args = ["diff", "--name-only", "--diff-filter=ACMR", base, after]
elif staged:
    diff_args = ["diff", "--name-only", "--diff-filter=ACMR", "--cached", base]
else:
    diff_args = ["diff", "--name-only", "--diff-filter=ACMR", base]
changed = [l for l in git(*diff_args).stdout.splitlines() if l.strip()]

# Working-tree case: also include untracked-but-not-ignored files (new files a
# real `hmd "task"` run writes that are not yet committed/staged).
if not after and not staged:
    untracked = git("ls-files", "--others", "--exclude-standard").stdout.splitlines()
    seen = set(changed)
    for u in untracked:
        if u.strip() and u not in seen:
            changed.append(u)
            seen.add(u)

def read_after(path):
    # AFTER side: working tree file on disk, the after-commit blob, or the index.
    if after:
        r = git("show", "%s:%s" % (after, path))
        return r.stdout if r.returncode == 0 else None
    fp = os.path.join(repo, path)
    if not after and not staged and os.path.exists(fp):
        try:
            with open(fp, "r", errors="replace") as fh:
                return fh.read()
        except OSError:
            return None
    if staged:
        r = git("show", ":%s" % path)
        return r.stdout if r.returncode == 0 else None
    return None

def read_base(path):
    r = git("show", "%s:%s" % (base, path))
    return r.stdout if r.returncode == 0 else None

changed_files = {}
for p in changed:
    if not is_src(p):
        continue
    body = read_after(p)
    if body is not None:
        changed_files[p] = body

# pre-change symbol table source: every tracked source file at BASE.
pre_files = {}
for p in git("ls-tree", "-r", "--name-only", base).stdout.splitlines():
    p = p.strip()
    if not p or not is_src(p):
        continue
    # a file newly ADDED in this change won't exist at BASE -> read returns None.
    body = read_base(p)
    if body is not None:
        pre_files[p] = body

json.dump({"task": task, "engine": engine, "pre_files": pre_files,
           "changed_files": changed_files}, sys.stdout)
PYEOF
  JOB_SRC="$JOB_FILE"
fi

# ── run the analyzer ──────────────────────────────────────────────────────────
# Never let an analyzer crash abort a calling task: on any failure emit degraded.
SUMTMP="$(mktemp -t "reuse-sum.$(printf 'X%.0s' 1 2 3 4 5 6)")"
set +e
REC="$("$PY" "$LIB" < "$JOB_SRC" 2>"$SUMTMP")"
RC=$?
SUMMARY="$(cat "$SUMTMP" 2>/dev/null)"
rm -f "$SUMTMP"
set -e

if [ $RC -ne 0 ] || [ -z "$REC" ]; then
  emit_degraded "analyzer-error-rc-$RC"
  exit 0
fi

printf '%s\n' "$REC" > "$OUT_RESOLVED"
[ "$PRINT" -eq 1 ] && printf '%s\n' "$REC"
[ "$QUIET" -eq 1 ] || printf '%s\n  ▸ wrote %s\n' "$SUMMARY" "$OUT_RESOLVED" >&2
exit 0
