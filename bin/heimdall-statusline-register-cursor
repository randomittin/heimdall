#!/usr/bin/env bash
# heimdall-statusline-register-cursor — wire the watchman HUD into Cursor CLI's
# OWN statusLine plug-in point. Cursor is a fully separate host from Claude Code:
# no plugin system, no SessionStart hook, no CLAUDE_PLUGIN_ROOT — so this is the
# Cursor-side sibling of bin/heimdall-statusline-register, never a replacement.
#
# THE REAL, CONFIRMED PLUG-IN POINT (not assumed — verified against Cursor's own
# docs before writing a line of this): ~/.cursor/cli-config.json carries a top-level
# `statusLine` key — {type:"command", command:<path>, padding, updateIntervalMs,
# timeoutMs} — documented at ~/.cursor/skills-cursor/statusline/SKILL.md. The width
# signal is DIFFERENT from Claude Code too: Cursor hands `render_width_chars` on the
# stdin JSON blob instead of exporting $COLUMNS — bin/heimdall-statusline already
# reads that field itself, so nothing downstream of this registrar needs to know
# which host is driving it.
#
# WHY A BARE ABSOLUTE PATH, no wrapper. bin/heimdall-statusline-register's Claude
# Code command is `bash -c '[ -x "<path>" ] && exec bash "<path>"; exit 0'` — a shell
# one-liner. That trick is UNAVAILABLE here: SKILL.md states the command is spawned
# via `child_process.spawn` with NO shell on Unix (shell-style-split into argv, never
# handed to /bin/sh). A `bash -c '...'` string would spawn a literal `bash` process
# whose FIRST argument is the two-word string `-c`+script only if spawn itself did
# shell-splitting of the whole command into argv — which it does, but there is then
# no shell alive to INTERPRET `[ -x ... ] && exec ...` inside that argv. So the value
# here is simply the resolved absolute path to bin/heimdall-statusline — the file
# Cursor spawns directly. No existence guard is possible from our side; a missing or
# non-executable target degrades exactly the way SKILL.md documents any failing
# statusLine command degrades ("previous text is kept") — Cursor's own contract,
# not ours to fake.
#
# TIMING VALUES — timeoutMs=3000, updateIntervalMs=3000 (both now explicit; before
# this, updateIntervalMs=2000 was explicit but timeoutMs was OMITTED, silently
# inheriting Cursor's own built-in default of 2000ms — SKILL.md's Configuration
# table: updateIntervalMs default 300ms/floor ">=300ms", timeoutMs default 2000ms,
# NEITHER field documents an upper clamp).
#
# WHY NOT LEAVE THE DEFAULTS ALONE: this repo's own regression test
# (test/heimdall-statusline-cursor-payload.test.sh, "TIMING" section) already
# encodes a budget for bin/heimdall-statusline of median<1000ms/max<2000ms — HALF
# of Cursor's 2000ms default timeout as the "safe" bar, the full 2000ms as the hard
# kill ceiling. A live measured regression put the real renderer at 2.35s-4.09s
# (median/max) — 2-4x over that budget — so Cursor's default 2000ms timeout was
# killing the bar on nearly every invocation. A sibling fix restores the renderer
# to budget; this bin's job is to register values that give a CORRECTLY FAST
# renderer real headroom above the 2000ms ceiling that budget already targets,
# without being raised far enough to quietly tolerate the CURRENT regression —
# 3000ms stays well under the observed 4.09s worst case, so an un-fixed or
# re-broken renderer still gets killed, never silently accommodated. 3000 = 1.5x
# Cursor's own 2000ms default, and sits exactly 1000ms (50%) above the codebase's
# own pre-existing 2000ms max-render ceiling — the SAME 2x safety-margin ratio
# that ceiling already uses relative to the median budget, just applied from the
# other side.
#
# WHY updateIntervalMs MOVES WITH timeoutMs, not independently: SKILL.md's
# "Testing" section names a SECOND, INDEPENDENT kill trigger — "If ... a new
# update arrives while the script is running, the in-flight process is killed" —
# firing on ANY invocation still alive when the next becomes eligible, REGARDLESS
# of timeoutMs. Had updateIntervalMs stayed at 2000 while timeoutMs rose to 3000,
# a renderer taking (say) 2.2s — comfortably inside the new 3000ms timeout budget —
# would still get superseded and killed at the 2000ms mark by this SECOND
# mechanism, making the raised timeoutMs headroom worthless. Keeping the two equal
# collapses both kill paths into one predictable one: a render either finishes
# inside 3000ms and displays, or is cleanly timeout-killed — never preempted early
# by a queued update racing ahead of its own budget.
#
# KILL-PATH SAFETY (verified empirically, not just by inspection — method and
# result recorded in test/heimdall-statusline-register-cursor.test.sh's own
# "KILL-PATH SAFETY" note): whichever value is registered, both of Cursor's kill
# triggers (timeout, or a superseding in-flight kill) land on the same non-zero-
# exit path, and SKILL.md's degrade-safely guarantee ("exits non-zero with empty
# stdout -> previous text kept") only holds if stdout is actually empty at the
# moment of death — a truncated ANSI escape on stdout could otherwise leave a
# user's terminal stuck in a partial color state. bin/heimdall-statusline (out of
# this bin's scope to edit) already guarantees this by construction: every exit
# path captures its full rendered string into a shell variable via command
# substitution first, then performs exactly ONE atomic `printf` of the complete
# string to real stdout as its last act before `exit 0` — there is no code path
# that writes partial output incrementally. Sending SIGALRM and SIGTERM at delays
# from 0.1s to 3s into a real, unmodified render of the real Cursor fixture
# (test/fixtures/cursor-real-payload.json) reproducibly landed EVERY kill-before-
# natural-completion at exactly 0 stdout bytes, non-zero exit — never a partial
# byte, never a dangling SGR. No wrapper is needed on the registration side for
# this; a bare absolute path (see above) is enough.
#
# SUBCOMMANDS:
#   heimdall-statusline-register-cursor [register]   idempotently wire `statusLine`
#         into ~/.cursor/cli-config.json. Prints ONE state word, ALWAYS exits 0.
#         Never clobbers a user's own custom statusLine.
#   heimdall-statusline-register-cursor status       read-only: print what it would do.
#   heimdall-statusline-register-cursor unregister   remove OUR statusLine entry (leaves
#         a foreign one untouched). Runs independently of opted_out()/ROOT resolution —
#         a removal must still work after uninstall, or after opting out post-hoc.
#
# STATE WORDS (printed on stdout):
#   registered     — wrote/refreshed our statusLine
#   current        — already canonical; nothing written
#   kept-custom    — the user has a non-heimdall statusLine; left untouched
#   skipped        — python3 unavailable, no resolvable root, opted out, or write failed
#   unregistered   — removed our statusLine entry (unregister only)
#   not-registered — nothing to remove: no file, or no statusLine key (unregister only)
#
# AUTO-INVOKED FROM `hmd init`, PLUS MANUAL. Cursor has no plugin system and no
# SessionStart-equivalent auto-run hook — its OWN separate `.cursor/hooks.json`
# schema (see ~/.cursor/skills-cursor/create-hook/SKILL.md) is unrelated to
# statusLine registration and hmd does not populate it. So `bin/heimdall-init`
# closes the gap itself: it detects Cursor CLI via `heimdall-ai-select detect`
# (cursor-cli.available) and calls `register` here ONLY when that is true — a
# machine that has never touched Cursor never gets a ~/.cursor/ written. This
# script still never self-bootstraps from INSIDE a Cursor session (no hook fires
# it) — every path into it is either `hmd init` or a human running it by hand,
# the same way you'd hand-configure any other Cursor CLI setting.
#
# SAFETY CONTRACT (mirrors bin/heimdall-statusline-register byte-for-byte):
#   * NEVER clobbers a user's OWN statusLine — writes only when the key is absent or
#     already points at bin/heimdall-statusline (refreshing a stale path).
#   * NEVER touches, logs, or prints any OTHER key in cli-config.json — that file can
#     carry Cursor account auth state (authInfo: email/userId/authId); only the
#     `statusLine` key is ever read or written, every sibling key round-trips as-is.
#   * Atomic, key-preserving edit (tmp + os.replace) — every other config key survives.
#   * Missing python3 / unresolvable root / write failure = clean no-op, exit 0.
#   * Opt out (either suppresses this registrar):
#       - the SHARED marker, honored by both registrars:
#         HEIMDALL_NO_STATUSLINE_REGISTER=1 or ${HOME}/.heimdall/no-statusline-register
#       - a CURSOR-ONLY marker, for a Claude-Code-yes/Cursor-no split:
#         HEIMDALL_NO_CURSOR_STATUSLINE_REGISTER=1 or
#         ${HOME}/.heimdall/no-cursor-statusline-register
#   * set -uo pipefail, never set -x, never echoes file content.
#
# OVERRIDES / TEST SEAMS:
#   --root <dir>              force the plugin root (else this bin's own location).
#   HEIMDALL_CURSOR_CLI_CONFIG   explicit cli-config.json path (default
#                                 $HOME/.cursor/cli-config.json). Tests MUST set this —
#                                 the real file can belong to a live authenticated
#                                 Cursor identity and must never be touched by a test.
set -uo pipefail

SUB="register"
FORCE_ROOT=""
while [ $# -gt 0 ]; do
  case "$1" in
    register|status|unregister) SUB="$1" ;;
    --root) shift; FORCE_ROOT="${1:-}" ;;
    --root=*) FORCE_ROOT="${1#--root=}" ;;
    *) : ;;   # tolerate unknown args
  esac
  shift
done

opted_out() {
  [ "${HEIMDALL_NO_STATUSLINE_REGISTER:-0}" = "1" ] && return 0
  [ -f "${HOME:-/nonexistent}/.heimdall/no-statusline-register" ] && return 0
  [ "${HEIMDALL_NO_CURSOR_STATUSLINE_REGISTER:-0}" = "1" ] && return 0
  [ -f "${HOME:-/nonexistent}/.heimdall/no-cursor-statusline-register" ] && return 0
  return 1
}

# Resolve the repo/plugin root to an ABSOLUTE path, dynamically, no hardcoded home:
#   1) --root <dir> (explicit — tests use this)
#   2) this bin's own location: <root>/bin/heimdall-statusline-register-cursor -> <root>
resolve_root() {
  local r bindir
  if [ -n "$FORCE_ROOT" ]; then printf '%s' "$FORCE_ROOT"; return 0; fi
  bindir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || return 1
  r="$(cd "$bindir/.." 2>/dev/null && pwd)" || return 1
  printf '%s' "$r"
}

CFG="${HEIMDALL_CURSOR_CLI_CONFIG:-$HOME/.cursor/cli-config.json}"

# unregister: removal must keep working even after the install that wrote the entry
# is gone, or after the opt-out markers were set post-registration — so it runs
# independently of opted_out()/ROOT, gated only on python3 (needed to safely touch
# JSON at all).
if [ "$SUB" = unregister ]; then
  command -v python3 >/dev/null 2>&1 || { printf 'skipped'; exit 0; }
  STATE="$(HMD_SL_CFG="$CFG" python3 - <<'PY' 2>/dev/null
import json, os, sys, tempfile

path = os.environ["HMD_SL_CFG"]
MARKER = "bin/heimdall-statusline"

if not os.path.exists(path):
    print("not-registered")
    sys.exit(0)

try:
    with open(path) as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        print("skipped")
        sys.exit(0)
except Exception:
    print("skipped")
    sys.exit(0)

cur = data.get("statusLine")
if cur is None:
    print("not-registered")
    sys.exit(0)

ours = isinstance(cur, dict) and MARKER in (cur.get("command") or "")
if not ours:
    print("kept-custom")
    sys.exit(0)

del data["statusLine"]

d = os.path.dirname(path) or "."
try:
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".cli-config.", suffix=".tmp")
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, path)
except Exception:
    try: os.unlink(tmp)
    except Exception: pass
    print("skipped")
    sys.exit(0)

print("unregistered")
PY
  )" || STATE="skipped"
  [ -z "$STATE" ] && STATE="skipped"
  printf '%s\n' "$STATE"
  if [ "$STATE" = unregistered ]; then
    printf '[heimdall] cursor statusline removed\n' >&2
  fi
  exit 0
fi

opted_out && { printf 'skipped'; exit 0; }
command -v python3 >/dev/null 2>&1 || { printf 'skipped'; exit 0; }

ROOT="$(resolve_root)"
if [ -z "$ROOT" ] || [ ! -x "$ROOT/bin/heimdall-statusline" ]; then
  printf 'skipped'; exit 0
fi

if [ "$SUB" = status ]; then
  HMD_SL_TARGET="$ROOT/bin/heimdall-statusline" HMD_SL_CFG="$CFG" python3 - <<'PY' 2>/dev/null || printf 'skipped'
import json, os
target = os.environ["HMD_SL_TARGET"]; path = os.environ["HMD_SL_CFG"]
MARKER = "bin/heimdall-statusline"
want = {"type": "command", "command": target, "padding": 0, "updateIntervalMs": 3000, "timeoutMs": 3000}
try:
    data = json.load(open(path))
    if not isinstance(data, dict): data = {}
except Exception:
    data = {}
sl = data.get("statusLine")
if isinstance(sl, dict) and MARKER not in (sl.get("command") or "") and sl.get("command"):
    print("kept-custom"); raise SystemExit
print("current" if sl == want else "would-register")
PY
  echo
  exit 0
fi

# ── register: idempotent, atomic, custom-preserving merge. Only the `statusLine`
# key is ever read or written; every sibling key (including a live `authInfo`) is
# round-tripped byte-for-byte via the same dict, never inspected or logged. ──
STATE="$(HMD_SL_TARGET="$ROOT/bin/heimdall-statusline" HMD_SL_CFG="$CFG" python3 - <<'PY' 2>/dev/null
import json, os, sys, tempfile

target = os.environ["HMD_SL_TARGET"]
path   = os.environ["HMD_SL_CFG"]
MARKER = "bin/heimdall-statusline"

want = {"type": "command", "command": target, "padding": 0, "updateIntervalMs": 3000, "timeoutMs": 3000}

try:
    with open(path) as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        data = {}
except Exception:
    data = {}

cur = data.get("statusLine")
ours = cur is None or (isinstance(cur, dict) and MARKER in (cur.get("command") or ""))

wrote = custom = False
if not ours:
    custom = True
elif cur != want:
    data["statusLine"] = want
    wrote = True

if wrote:
    d = os.path.dirname(path) or "."
    try:
        os.makedirs(d, exist_ok=True)
    except Exception:
        print("skipped"); sys.exit(0)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".cli-config.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(data, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, path)
    except Exception:
        try: os.unlink(tmp)
        except OSError: pass
        print("skipped"); sys.exit(0)

sl = data.get("statusLine")
if isinstance(sl, dict) and MARKER in (sl.get("command") or ""):
    print("registered" if wrote else "current")
elif custom:
    print("kept-custom")
else:
    print("skipped")
PY
)" || STATE="skipped"
[ -z "$STATE" ] && STATE="skipped"
printf '%s\n' "$STATE"
if [ "$STATE" = registered ]; then
  printf '[heimdall] cursor statusline activated — visible next session\n' >&2
fi
exit 0
