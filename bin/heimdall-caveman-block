#!/usr/bin/env bash
#
# heimdall-caveman-block — print the output-compression section of hmd's system
# preamble, describing the caveman level ACTUALLY IN FORCE.
#
# WHY THIS EXISTS
# hmd's preamble used to hardcode "CAVEMAN ULTRA (max compression, every
# response)". That was false on every session hmd has ever run. A preamble
# that ASSERTS a level it does not set is a claim with no mechanism behind
# it — precisely the false-declaration class this repo exists to catch,
# shipped inside hmd's own prompt.
#
# OWNERSHIP MOVED IN-HOUSE, 2026-08-30
# The level used to live in `.caveman-active`, written by an external caveman
# plugin's own mode-tracker hook when a human typed `/caveman lite|full|ultra`.
# hmd no longer installs that plugin at all (bin/heimdall's first_run_setup
# dropped the companion:caveman step — see CLAUDE.md "Token Efficiency") and
# now owns the level directly: bin/heimdall-caveman, backed by
# $HEIMDALL_HOME/caveman-level. `heimdall-caveman set lite|full|ultra` changes
# it; this file only ever READS it, via `heimdall-caveman rules`.
#
# This script therefore never reads `.caveman-active` any more — not even as
# a fallback. That exact file is the one observed to silently reset itself
# back to the default on session restart, with no warning (first-hand repro
# in bin/heimdall-caveman's own "DIVERGENCE / RESTART SAFETY" section).
# Reading it here would risk leaking a stale, silently-reset plugin value into
# the preamble underneath hmd's own correct, currently-configured one. There
# is exactly one source of truth now, and this file always defers to it.
#
# KNOWN, ACCEPTED REGRESSION: the old plugin also supported wenyan /
# wenyan-lite / wenyan-full / wenyan-ultra modes; bin/heimdall-caveman does
# not own those (see its own "SCOPE" header) and, since this file no longer
# reads the plugin's flag at all, a wenyan session is no longer specially
# named here either. That is a deliberate scope reduction that came with
# in-housing ownership, not an oversight.
#
# It is a separate executable so the text is TESTABLE. Inline in the launcher
# it could only be checked by grepping the launcher's source, which proves the
# string exists, not that the right string is produced for a given state.
#
# FAIL-OPEN: any unreadable/broken/empty state degrades to the no-level block
# below. Compression wording is a prompt nicety; refusing to launch hmd over
# it would be absurd.
#
# THE HONEST LIMIT (unchanged by this rewrite): this script injects text into
# a prompt. It cannot verify the model that reads it actually complies with
# it. Never upgrade this into an enforcement claim.
#
# Usage: heimdall-caveman-block          (level read from hmd's own state)
#        HEIMDALL_HOME=<dir> ...         (test fixtures isolate hmd's state)
set -uo pipefail

_dir="$(cd "$(dirname "$0")" && pwd 2>/dev/null || true)"
_cav="$_dir/heimdall-caveman"
if [ -n "$_dir" ] && [ -x "$_cav" ]; then
  rules="$("$_cav" rules 2>/dev/null || true)"
  if [ -n "$rules" ]; then
    printf '%s\n' "$rules"
    exit 0
  fi
fi

# Fully degraded path (heimdall-caveman itself missing/broken/empty output):
# say nothing about a specific level rather than guess one. An empty section
# is honest; an invented "ultra" is the bug this whole file was written to
# stop.
cat <<'NOLEVEL'
OUTPUT COMPRESSION (no caveman level set — these are hmd's own rules, and they claim no level):
Drop articles, filler, pleasantries, hedging, conjunctions. Fragments default. One word > phrase. Abbrev: DB, auth, cfg, req, res, fn, impl, mw, env, repo, PR, CI. Arrows for causality: X → Y.
Code + errors + paths: exact, unchanged.
Drop compression for: security warnings, irreversible ops.
NOLEVEL
exit 0
