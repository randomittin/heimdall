#!/usr/bin/env bash
# heimdall-selfscan — the SHARED push-integrity gate over Heimdall's OWN history.
#
# Two checks, ONE implementation (the single source of truth invoked by BOTH the
# native git pre-push hook installed by `hmd guard install` AND the Claude Code
# PreToolUse pre-push gate in hooks/hooks.json):
#
#   1. SECRETS (HISTORY) — gitleaks over the FULL history (`--log-opts=--all`,
#      every ref incl. tags). A push can publish tags (`git push --force --tags`),
#      so a secret on any ref must block. Zero findings required.
#   1b. SECRETS (WORKING TREE) — gitleaks `--no-git` over the PUSHABLE files as
#      they are on disk: tracked files at their working-tree content, plus
#      untracked-but-not-ignored ones. Disjoint from 1, not redundant: history
#      covers secrets committed and later removed; tree covers what is on disk
#      NOW. A .gitleaksignore entry is commit-scoped, so silencing a benign
#      historical fixture also hides the still-live on-disk copy from the history
#      walk — the tree pass is what sees it. Scoped to the pushable set on
#      purpose: a raw filesystem walk also reads .gitignored paths (the
#      developer's own .heimdall/team.json, stale agent worktrees), which no push
#      can carry, and blocking on those would train everyone to disable the gate.
#      Includes an anti-vacuous floor: a clean verdict over ~0 bytes is refused,
#      because a gate that read nothing certifies nothing.
#   2. IDENTITIES — the author AND committer email of every commit on every ref
#      (`git log --all --format='%ae%n%ce'`) must be a subset of the allowlist
#      {rj@runheimdall.dev, noreply@anthropic.com}. Any third identity is a hard
#      fail: an unrecognized author/committer in history must not leave the box.
#
# Why this exists: the existing bin/secret-scan guards the STAGED diff at commit
# time and the push RANGE — but agents (and humans) commit with `--no-verify`,
# which bypasses the pre-commit hook entirely. A planted demo secret reached this
# repo's history exactly that way. The pre-commit gate is therefore not the
# backstop; THIS is. heimdall-selfscan scans the repo's ENTIRE history as a
# blocking pre-push gate, so a secret or an unknown identity cannot leave the
# machine (see conventions.md R10).
#
# Scope: HEIMDALL's FULL git history (all refs, all commits) PLUS the pushable
# files as they stand on disk (tracked + untracked-not-ignored) — not just the
# staged diff (that is bin/secret-scan's job) and not just the push range, and
# never the .gitignored paths a push cannot carry.
#
# SCOPING — this gate polices HEIMDALL's repo, and ONLY heimdall's. It is wired
# via core.hooksPath set to a RELATIVE path, so the native pre-push hook fires in
# EVERY repo that inherits that git config — including unrelated projects. When
# this runs while pushing a DIFFERENT repo, it must NOT apply heimdall's identity
# allowlist / secret rules to that foreign repo. It stands down (exit 0): the
# foreign repo's own gates police the foreign repo. The check is tamper-proof:
# this script lives at <heimdall-top>/bin/heimdall-selfscan, so "is the repo I'm
# being run in actually heimdall?" reduces to "does the repo-top of the CWD equal
# the repo-top that contains THIS script?". A copied/renamed heimdall stays
# policed; an unrelated repo is left alone.
#
# Contract — no escape hatches:
#   - The .gitleaks.toml at the heimdall repo top is an ALLOWLIST, not an
#     ignore-everything: it extends the FULL default ruleset (useDefault=true)
#     and only allowlists heimdall's OWN secret-detection FIXTURES by path (the
#     secret-scan corpus, the demo's runtime sk_live_, the landmine test
#     strings). It is the SAME config bare `gitleaks detect` auto-discovers, so
#     the gate and a human's bare scan AGREE. A real secret in real code is still
#     caught. Suppressing a genuine finding still requires scrubbing history.
#   - gitleaks absent is a HARD block: a verification tool that cannot scan its
#     own history must not certify a push. Install it or the push is refused.
#   - The identity allowlist is intentionally hard-coded here, not configurable:
#     a configurable allowlist is an escape hatch.
#
# Success signal (so a silent `--no-verify` skip is detectable by ABSENCE):
#   on full success this prints ONE line to stderr:
#       guard: gitleaks=0 · identities=N/N allowlisted
#   The absence of that line on a push means the gate did not run.
#
# Exit codes:
#   0  clean — no secret in history OR the working tree, every identity
#      allowlisted, and the tree scan verifiably examined the tree
#   1  finding — a secret was detected in history or in the pushable working-tree
#      set, OR a non-allowlisted identity, OR the pushable set could not be
#      materialised, OR the tree scan examined too little to certify
#   2  gitleaks is absent (hard block; install message printed)
#
# Usage:
#   heimdall-selfscan        scan this repo's full history; nonzero on leak/absence

set -euo pipefail

# The ONLY allowed author/committer identities in Heimdall's history. Hard-coded
# on purpose — a configurable allowlist would be an escape hatch.
ALLOWED_IDENTITIES="rj@runheimdall.dev
noreply@anthropic.com"

# --- SCOPING: police HEIMDALL's repo, and ONLY heimdall's -------------------
# This script lives at <heimdall-top>/bin/heimdall-selfscan. The native pre-push
# hook is wired via a RELATIVE core.hooksPath, so it fires in every repo that
# inherits the config — including unrelated projects. We must scan THE HEIMDALL
# REPO (the one that contains this script), never the foreign repo that merely
# triggered the hook. If the repo we were invoked in is NOT the heimdall repo,
# stand down cleanly: that repo's own gates are responsible for it.
#
# Resolve the heimdall top from THIS script's own location (canonicalized), then
# compare it to the repo top of the CWD where the hook fired. Equal → this push
# IS heimdall, scan it. Different → foreign repo, exit 0 (do not block).
SELF_SRC="${BASH_SOURCE[0]}"
# Resolve a symlinked/relative invocation to a real path without readlink -f
# (absent on macOS): cd into the script's dir and pwd -P.
SELF_DIR="$(cd "$(dirname "$SELF_SRC")" && pwd -P)"
# The heimdall top is the parent of bin/ (this script is <top>/bin/<self>).
HEIMDALL_TOP="$(cd "$SELF_DIR/.." && pwd -P)"

# The repo top of wherever the hook actually fired (the push being performed).
CWD_TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$CWD_TOP" ]; then
  CWD_TOP="$(cd "$CWD_TOP" && pwd -P)"
fi

if [ "$CWD_TOP" != "$HEIMDALL_TOP" ]; then
  # Not the heimdall repo (or not a git repo at all). This gate does not police
  # foreign repos — stand down so an unrelated `git push` is not blocked on
  # heimdall's history, identities, or landmine lint.
  echo "guard: heimdall-selfscan not applicable here (not the heimdall repo) — standing down" >&2
  exit 0
fi

# From here on, every scan is anchored to $HEIMDALL_TOP, never the CWD, so the
# gate is identical no matter which subdir of heimdall the hook fired from.
GL_CONFIG="$HEIMDALL_TOP/.gitleaks.toml"

# --- gitleaks presence check (HARD block) ---------------------------------
if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'EOF'
BLOCKED: gitleaks is not installed and this is a HARD self-scan gate.
heimdall-selfscan scans Heimdall's OWN full history before every push; a
verification tool that cannot scan its own history must not certify a push.
Install it, then retry:

    brew install gitleaks

(or see https://github.com/gitleaks/gitleaks#installing)
EOF
  exit 2
fi

# --- scan the FULL history for secrets ------------------------------------
# `gitleaks detect --log-opts=--all` walks every commit on every ref. We anchor
# `--source` to the HEIMDALL top (never the CWD) and pass `--config` explicitly
# so this gate honors the SAME .gitleaks.toml allowlist that bare `gitleaks
# detect` auto-discovers — the two scans agree. The config extends the full
# default ruleset (useDefault=true); it only allowlists heimdall's OWN fixture
# files by path, so real secrets in real code are still caught.
SCAN_OUT=""
SCAN_RC=0
if [ -f "$GL_CONFIG" ]; then
  SCAN_OUT=$(gitleaks detect --source "$HEIMDALL_TOP" --config "$GL_CONFIG" --log-opts="--all" --no-banner 2>&1) && SCAN_RC=0 || SCAN_RC=$?
else
  # No config present: scan with the default ruleset, still anchored to the
  # heimdall top. (The shipped repo carries .gitleaks.toml; this branch only
  # covers a stripped checkout.)
  SCAN_OUT=$(gitleaks detect --source "$HEIMDALL_TOP" --log-opts="--all" --no-banner 2>&1) && SCAN_RC=0 || SCAN_RC=$?
fi

if [ "$SCAN_RC" -ne 0 ]; then
  # Nonzero from gitleaks == leak found (or a hard scan error). Show the finding.
  echo "BLOCKED: gitleaks detected a secret in Heimdall's OWN history." >&2
  echo "A credential anywhere in history blocks the push. Scrub it from history" >&2
  echo "(git filter-repo / BFG) — there is no allowlist for this gate." >&2
  echo "------------------------------------------------------------" >&2
  printf '%s\n' "$SCAN_OUT" >&2
  echo "------------------------------------------------------------" >&2
  exit 1
fi

# --- scan the WORKING TREE for secrets (--no-git) --------------------------
# A SECOND secret check, NOT a replacement for the history walk above. The two
# cover DISJOINT classes and neither subsumes the other:
#
#   history (--log-opts=--all) — every blob ever committed on any ref, including
#     a secret that was committed and later deleted. It cannot see a credential
#     that is on disk but not yet committed, and it re-reports a committed line
#     only against the commit that INTRODUCED it.
#   tree (--no-git) — the files as they exist on disk RIGHT NOW, staged or not.
#     It cannot see anything already scrubbed from the worktree but still
#     reachable in history.
#
# Why the gap was real: .gitleaksignore fingerprints are commit-scoped
# (commit:file:rule:line). Silencing one benign historical fixture there ALSO
# silences the still-live on-disk copy of that line from the history walk, since
# the walk only ever attributes it to the introducing commit. Tree-mode
# fingerprints are (file:rule:line) — a different namespace — so the on-disk copy
# gets judged on its own terms. Before this step, a credential sitting in a
# working-tree file could be wholly invisible to a gate that reported clean.
#
# SCOPE — exactly the files a push can carry, and nothing else.
# `gitleaks --no-git` walks the FILESYSTEM, which is strictly wider than the
# repo: it also reads untracked and .gitignored paths. Pointed at this repo that
# is not a stricter gate, it is a BROKEN one — it reports findings that are
# unpushable by construction (stale agent worktrees under .claude/, the
# developer's own .heimdall/team.json bearer credential, ignored scratch docs).
# A gate that blocks every push on a local credential the push cannot carry is
# the wolf-crying failure mode: it gets disabled within a day, and the real blind
# spot above reopens. So we scan the PUSHABLE SET instead:
#
#   git ls-files --cached            tracked files, read at their WORKING-TREE
#                                    content — so uncommitted edits are covered.
#   git ls-files --others            untracked but NOT ignored. Deliberately IN
#             --exclude-standard     scope: a brand-new file becomes pushable the
#                                    instant someone runs `git add .`, which is
#                                    the common flow. A credential in a new file
#                                    is exactly the class this pass exists for.
#   (excluded)                       .gitignored paths. Unpushable without an
#                                    explicit `git add -f`, which makes them
#                                    tracked — and therefore back in scope
#                                    automatically. No permanent blind spot.
#
# Why this and NOT a path allowlist in .gitleaks.toml: an allowlist is permanent
# and blinds the gate to a GENUINE credential later added at that path. This
# scope is derived from git's own notion of what a push carries, so it
# self-corrects — the moment a path becomes pushable, it is scanned.
#
# Why not simply ask the walker to honor .gitignore: this repo force-adds tracked
# files INSIDE ignored directories (docs/analysis/ is ignored, yet carries
# tracked files). A gitignore-respecting walk would silently skip those; the
# index does not. `git ls-files` is the only source of truth for "pushable".
#
# We materialise that set into a throwaway directory (preserving relative paths,
# so the PATH-scoped allowlists in .gitleaks.toml keep matching) and scan it.
# `-z` / `--null` keep paths with spaces or newlines intact. The filter drops
# index entries with no file on disk — a tracked file deleted from the worktree
# is an ordinary state, and tar would otherwise abort the whole gate on it.
TREE_TMP="$(mktemp -d)"
_selfscan_rm_treetmp() {
  if [ -n "${TREE_TMP:-}" ] && [ -d "${TREE_TMP:-}" ]; then
    rm -rf "$TREE_TMP" || :
  fi
}
# Arm the cleanup BEFORE anything that can fail, so there is no window in which
# the directory exists untracked. Covers EVERY exit path including interrupt: the
# EXIT trap preserves the script's own status (it never calls exit itself), and
# the signal traps re-exit with the conventional 128+signo so a Ctrl-C still
# reads as a Ctrl-C to the caller.
trap '_selfscan_rm_treetmp' EXIT
trap '_selfscan_rm_treetmp; exit 130' INT
trap '_selfscan_rm_treetmp; exit 143' TERM
trap '_selfscan_rm_treetmp; exit 129' HUP

# Canonicalize the same way HEIMDALL_TOP is resolved above, so the prefix we
# strip from finding paths matches exactly what gitleaks reports. The fallback
# keeps TREE_TMP non-empty on failure — an emptied TREE_TMP would slip past the
# cleanup guard above and strand the directory.
TREE_TMP="$(cd "$TREE_TMP" && pwd -P || printf '%s\n' "$TREE_TMP")"

MAT_RC=0
(
  cd "$HEIMDALL_TOP" || exit 1
  git ls-files -z --cached --others --exclude-standard \
  | while IFS= read -r -d '' f; do
      if [ -e "$f" ] || [ -L "$f" ]; then printf '%s\0' "$f"; fi
    done \
  | tar --null -T - -cf - \
  | tar -xf - -C "$TREE_TMP"
) || MAT_RC=$?

if [ "$MAT_RC" -ne 0 ]; then
  echo "BLOCKED: could not materialise Heimdall's pushable file set for the" >&2
  echo "working-tree scan (rc=$MAT_RC). The gate cannot build the surface it is" >&2
  echo "supposed to certify, so this push is refused rather than passed blind." >&2
  exit 1
fi

TREE_OUT=""
TREE_RC=0
if [ -f "$GL_CONFIG" ]; then
  TREE_OUT=$(gitleaks detect --source "$TREE_TMP" --config "$GL_CONFIG" --no-git --no-banner --no-color 2>&1) && TREE_RC=0 || TREE_RC=$?
else
  TREE_OUT=$(gitleaks detect --source "$TREE_TMP" --no-git --no-banner --no-color 2>&1) && TREE_RC=0 || TREE_RC=$?
fi

if [ "$TREE_RC" -ne 0 ]; then
  echo "BLOCKED: gitleaks detected a secret in Heimdall's WORKING TREE." >&2
  echo "This is the on-disk copy — the history scan above can be clean while a" >&2
  echo "credential sits in a tracked file. Remove the value from the file (for a" >&2
  echo "test fixture use the runtime-assembly / inert-sentinel convention in" >&2
  echo "docs/superpowers/specs/heimdall-fixture-secret-convention.md). Do NOT add" >&2
  echo "a fixture PATH to .gitleaks.toml — that blinds the gate to a real secret" >&2
  echo "later checked in beside it." >&2
  echo "Paths below are relative to the repo top ($HEIMDALL_TOP)." >&2
  echo "------------------------------------------------------------" >&2
  # Rewrite the scratch prefix back to repo-relative paths — a finding the reader
  # cannot locate in their own checkout is a finding they cannot fix.
  printf '%s\n' "$TREE_OUT" | sed "s|$TREE_TMP/||g" >&2
  echo "------------------------------------------------------------" >&2
  exit 1
fi

# ANTI-VACUOUS: a tree scan that examined nothing certifies nothing. gitleaks
# reports the volume it actually read ("scanned ~N bytes"); we parse that and
# refuse to accept a clean verdict over an empty scan. This is what catches the
# failure mode where --source resolves somewhere wrong/empty and the gate
# cheerfully reports 0 findings over 0 files.
#
# Scoping the scan to a materialised copy makes this floor MORE load-bearing, not
# less: a silently-empty materialisation (tar producing nothing, an ls-files that
# returned no paths) would otherwise hand gitleaks an empty directory and earn a
# confident "no leaks found". MAT_RC catches a LOUD failure; this floor catches
# the quiet one.
#
# The floor is a STRUCTURAL tripwire, not a size budget: heimdall's pushable set
# scans ~11 MB, so 100 KB sits ~100x below actual. It can only fire when the scan
# is pointed at the wrong place or the materialisation collapsed — never on
# ordinary growth or pruning of the repo.
TREE_MIN_BYTES=100000
TREE_BYTES="$(printf '%s\n' "$TREE_OUT" | sed -n 's/.*scanned ~\([0-9][0-9]*\) bytes.*/\1/p' | tail -1)"
if [ -z "$TREE_BYTES" ] || [ "$TREE_BYTES" -lt "$TREE_MIN_BYTES" ]; then
  echo "BLOCKED: the working-tree secret scan examined too little to certify" >&2
  echo "anything (bytes=${TREE_BYTES:-unparseable}, floor=${TREE_MIN_BYTES})." >&2
  echo "A gate reporting clean over a surface it never read is a vacuous gate." >&2
  echo "Check that gitleaks still reports 'scanned ~N bytes' and that the scan" >&2
  echo "source resolves to the heimdall tree ($HEIMDALL_TOP)." >&2
  echo "------------------------------------------------------------" >&2
  printf '%s\n' "$TREE_OUT" >&2
  echo "------------------------------------------------------------" >&2
  exit 1
fi

# --- identity allowlist over the FULL history -----------------------------
# Author AND committer email of every commit on every ref must be allowlisted.
# `sort -u` collapses to the DISTINCT identities present; any one not in the
# allowlist is a hard fail.
IDENTITIES="$(git -C "$HEIMDALL_TOP" log --all --format='%ae%n%ce' 2>/dev/null | sort -u | sed '/^$/d')"

total_count=0
allowed_count=0
bad_identities=""
while IFS= read -r ident; do
  [ -n "$ident" ] || continue
  total_count=$((total_count + 1))
  if printf '%s\n' "$ALLOWED_IDENTITIES" | grep -Fxq -- "$ident"; then
    allowed_count=$((allowed_count + 1))
  else
    bad_identities="${bad_identities}${bad_identities:+
}${ident}"
  fi
done <<EOF
$IDENTITIES
EOF

if [ -n "$bad_identities" ]; then
  echo "BLOCKED: non-allowlisted author/committer identity in Heimdall's history." >&2
  echo "Every commit's author AND committer email (over --all) must be one of:" >&2
  printf '%s\n' "$ALLOWED_IDENTITIES" | sed 's/^/  - /' >&2
  echo "Offending identities:" >&2
  printf '%s\n' "$bad_identities" | sed 's/^/  ✗ /' >&2
  echo "Rewrite the offending commits (git rebase / filter-repo) — there is no" >&2
  echo "allowlist override for this gate." >&2
  exit 1
fi

# --- strict-mode landmine lint over Heimdall's OWN shell scripts -----------
# Third blocking check (alongside secrets + identities): a static lint for the
# strict-mode (`set -euo pipefail`) silent-failure class that bit the v2.0.x
# launch — terminal `| head` SIGPIPE, same-line `local` self-reference, baked
# machine paths, non-TTY `read` hangs, source-after-self-delete. A landmine in
# the in-scope scripts must fail the push exactly the way a leaked secret does.
# Resolved RELATIVE to the repo top (no baked path — dogfooding class 3); falls
# back to a PATH lookup the same way the native pre-push hook resolves THIS
# script. An ABSENT linter is a hard block: a gate that cannot run must not
# certify a push.
LINT=""
if [ -x "$HEIMDALL_TOP/bin/heimdall-landmine-lint" ]; then
  LINT="$HEIMDALL_TOP/bin/heimdall-landmine-lint"
elif command -v heimdall-landmine-lint >/dev/null 2>&1; then
  LINT="$(command -v heimdall-landmine-lint)"
fi
if [ -z "$LINT" ]; then
  echo "BLOCKED: heimdall-landmine-lint not found — the strict-mode landmine gate" >&2
  echo "cannot run, so this push is refused. Restore bin/heimdall-landmine-lint." >&2
  exit 1
fi
LINT_OUT=""
LINT_RC=0
LINT_OUT="$("$LINT" 2>&1)" && LINT_RC=0 || LINT_RC=$?
if [ "$LINT_RC" -ne 0 ]; then
  echo "BLOCKED: heimdall-landmine-lint found a strict-mode landmine in Heimdall's" >&2
  echo "OWN shell scripts. A silent-failure landmine must not leave the machine —" >&2
  echo "guard it (|| true / \${var:-default} / [ -t 0 ] / reorder) before pushing." >&2
  echo "------------------------------------------------------------" >&2
  printf '%s\n' "$LINT_OUT" >&2
  echo "------------------------------------------------------------" >&2
  exit 1
fi

# --- success: emit the single detectable signal line ----------------------
# The leading `guard: gitleaks=0 · identities=N/N allowlisted` substring is the
# documented signal (bin/heimdall, hooks/git/pre-push) — extended, never reshaped.
# The tree byte count is printed so the anti-vacuous measurement is visible on
# every clean push: "0 findings" is only meaningful next to "over this much".
echo "guard: gitleaks=0 · identities=${allowed_count}/${total_count} allowlisted · landmines=0 · tree=0/${TREE_BYTES:-n/a}B" >&2
exit 0
