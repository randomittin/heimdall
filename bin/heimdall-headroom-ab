#!/usr/bin/env bash
# heimdall-headroom-ab — the receipt harness for a one-week Headroom A/B.
#
# Headroom is a local context-compression proxy that wraps the `claude` CLI. This
# harness answers ONE question with a publishable receipt: does wrapping sessions
# in Headroom degrade the quality signals only a gate system can produce?
#
# It snapshots the week's metrics BEFORE adopting Headroom and AFTER a week of
# use, then renders the comparison and computes a PRE-REGISTERED verdict.
#
# DEPEND, DON'T CLONE. This harness does NOT install, bundle, vendor or
# auto-install Headroom, and does NOT wrap anything. Headroom need not be present:
# it reads metrics, and the Headroom-sourced figures (tokens, $) are OPERATOR
# INPUT read off Headroom's own dashboard. Absent Headroom IS the "before" arm.
#
# THE PRE-REGISTERED RULE lives in `rule_text` below and is hashed, so a receipt
# proves the rule was not rewritten after the data landed. It is the executable
# form of the pre-registration published in
# launch-docs/log-compression-and-gates.md §"Pre-registration". Where the two
# could disagree, that post is authoritative and this tool is the bug.
#
# FOUR PRE-REGISTERED OUTCOMES — all four are publishable:
#   1. falsify survival is CATEGORICAL. A mutant surviving in arm B that dies in
#      arm A is a hard stop with NO confidence interval attached. `bin/falsify
#      <domain> --assert-score 1.0` reports PASS only when every mutant dies, so a
#      survivor is not a bad score — it is a broken gate, and a safety finding.
#   2. oracle pass-rate is STATISTICAL. Wilson score 95% interval per arm; the
#      arm B minus arm A difference gets a PAIRED BOOTSTRAP over tasks, 10,000
#      resamples, reported as a 95% interval. Degradation is declared only when
#      that interval lies ENTIRELY BELOW ZERO.
#   3. retry-count and time-to-green are LABELLED COST, never merged into a
#      correctness claim. They are reported and can never move the verdict.
#   4. UNDERPOWERED IS A RESULT. If the half-width of the pass-rate difference
#      interval exceeds the pre-committed +/-10pp threshold, the verdict is
#      `underpowered` — "this run could not tell" — and NEVER `keep`. An
#      underpowered null reported as "no degradation found" is the most common way
#      an honest A/B turns into an advertisement, and this tool refuses to do it.
#
# LABELLING CONVENTION — every figure carries exactly one provenance label:
#   measured     — read from a real signal in this repo (or run now, deterministically)
#   estimated    — derived by a stated estimator; ALWAYS carries its interval
#   unavailable  — no data. Rendered as `unavailable`, NEVER as 0. A 0 meaning "no
#                  data" is indistinguishable from a 0 meaning "it did not happen",
#                  and that ambiguity is exactly how a metric lies.
#
# METRIC PROVENANCE MAP
#   oracle_pass_rate    measured    bin/falsify golden check per oracle domain
#   falsify_survival    measured    bin/falsify mutant sweep (survived / total)
#   agent_deaths        measured    bin/heimdall-agents (failed+killed in window)
#   gate_retries        measured    .heimdall/gate-runs.jsonl deny records, if kept
#   time_to_green_mins  estimated   git fix-chain intervals, median + IQR
#   tokens_in/out,cost  measured    operator input, read off Headroom's dashboard
#
# Usage:
#   heimdall-headroom-ab preregister                 Print the verdict rule + rule_hash
#   heimdall-headroom-ab snapshot --arm before|after [opts]
#   heimdall-headroom-ab report  --before <f> --after <f>
#   heimdall-headroom-ab verdict --before <f> --after <f>   keep|unwrap|underpowered|indeterminate
#   heimdall-headroom-ab stats   --before <f> --after <f>   the raw statistics JSON
#   heimdall-headroom-ab -h|--help
#
# snapshot options:
#   --repo <dir>        Repo to measure (default: git toplevel, else cwd)
#   --out <path>        Where to write the snapshot JSON (default: stdout)
#   --window-days <n>   History window (default 7)
#   --tokens-in <n>     From Headroom's dashboard. Omitted -> unavailable, never 0.
#   --tokens-out <n>    From Headroom's dashboard.
#   --cost <usd>        From Headroom's dashboard.
#   --headroom-json <f> Read {tokens_in,tokens_out,cost_usd} from a JSON file instead.
#
# Read-only: this harness never writes to the measured repo, never calls the
# network, and never spends a token.
set -euo pipefail

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
FALSIFY="$BIN_DIR/falsify"
AGENTS="$BIN_DIR/heimdall-agents"

if [[ "${COLORTERM:-}" == "truecolor" || "${COLORTERM:-}" == "24bit" || "${TERM:-}" == *256color* ]]; then
  P='\033[38;2;224;86;160m'; C='\033[38;2;0;212;255m'; V='\033[38;2;155;89;182m'
  G='\033[38;2;78;204;163m'; D='\033[38;2;100;100;120m'; W='\033[38;2;255;200;80m'
else
  P='\033[35m'; C='\033[36m'; V='\033[34m'; G='\033[32m'; D='\033[37m'; W='\033[33m'
fi
B='\033[1m'; R='\033[0m'

command -v jq >/dev/null 2>&1 || { printf "error: jq is required\n" >&2; exit 2; }
command -v python3 >/dev/null 2>&1 \
  || { printf "error: python3 is required (Wilson + paired bootstrap)\n" >&2; exit 2; }

# Prints the header block as help. Walks comment lines until the first line of
# code, so adding or removing header lines can never desync the help text from
# the file (a fixed `sed -n '2,80p'` range silently truncates the moment it does).
usage() { awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 && !/^#/ { exit }' "$SELF"; }

# Below this n, an ESTIMATED context metric refuses to print an interval and says
# the sample is too small rather than manufacturing significance.
MIN_N_FOR_INTERVAL=20

# ── THE PRE-REGISTERED RULE ───────────────────────────────────────────────────
# Canonical text, hashed to prove the rule predates the data. Changing ONE byte
# changes rule_hash, so a receipt whose hash differs from the pre-registration is
# self-evidently a rule rewritten after seeing a disappointing result.
rule_text() {
  cat <<'RULE'
PRE-REGISTERED VERDICT RULE (Headroom one-week A/B) v2
Executable form of launch-docs/log-compression-and-gates.md §"Pre-registration".
That post is authoritative; where this rule and the post disagree, this is a bug.

Decision metrics (and ONLY these two):
  1. falsify survival — CATEGORICAL, never statistical.
     A mutant that survives in arm B and dies in arm A is a hard stop. No
     confidence interval is attached to a gate that failed to kill something it
     is contractually required to kill (`bin/falsify <domain> --assert-score 1.0`
     reports PASS only when every mutant dies). One such survivor and the finding
     is "compression broke the gate": a safety finding, not a performance one.
     The decision is on the SURVIVOR COUNT, not on a rate.
  2. oracle pass-rate — STATISTICAL.
     Per-arm rates carry a Wilson score 95% interval. The arm B minus arm A
     difference carries a PAIRED BOOTSTRAP over tasks, 10,000 resamples, fixed
     seed so a receipt reproduces, reported as a 95% interval. Degradation is
     declared ONLY when that interval lies ENTIRELY BELOW ZERO.
     Pairing is by task: a task that ran in only one arm is EXCLUDED and the
     exclusion is counted and reported.
     Degenerate-bootstrap guard, fixed here in advance: when there are ZERO
     discordant pairs the resampled interval collapses to zero width, which is an
     artefact of the resampling and not evidence of precision. In that case the
     interval is widened to the rule-of-three bound (+/- 3/n) and labelled as
     such, so a run with no disagreement can never masquerade as a precise null.

Verdict, resolved in this order:
  a. A decision metric unavailable in either arm       -> INDETERMINATE.
     Publish neither receipt. An absent measurement is NOT evidence of success
     and must never resolve to KEEP by default.
  b. Falsify survivors increased in arm B              -> UNWRAP (categorical).
  c. Pass-rate difference interval entirely below zero -> UNWRAP (statistical).
     Run `headroom unwrap claude` and publish the NEGATIVE receipt.
  d. Interval half-width greater than 10 percentage    -> UNDERPOWERED.
     points (the pre-committed power threshold)           "This run could not
     tell." Publish the underpowered result AS the finding. Never report an
     underpowered null as "no degradation found".
  e. Otherwise                                         -> KEEP.
     Neutral-or-better AND adequately powered. Keep the wrapper, publish the
     POSITIVE receipt.

A favourable result is held to the same standard: if gate outcomes IMPROVE in
arm B it gets the same interval, the same label and the same power check.

Non-decision metrics — gate retry-count, time-to-green, tokens, cost, agent
deaths — are LABELLED COST. They are reported for context and can NEVER alter
the verdict, and are never merged into a correctness claim. Time-to-green in
arm B carries the proxy's own latency, which is a real cost but not evidence
about the code.
RULE
}

rule_hash() {
  if command -v shasum >/dev/null 2>&1; then
    rule_text | shasum -a 256 | awk '{print substr($1,1,16)}'
  elif command -v sha256sum >/dev/null 2>&1; then
    rule_text | sha256sum | awk '{print substr($1,1,16)}'
  else
    printf 'nohash'
  fi
}

# ── Measurement: oracle pass-rate + falsify survival ──────────────────────────
# Runs bin/falsify over every oracle domain that ships mutant fixtures.
#   golden passes  <=> the SCORE line reads "(golden passing)"
#   killed/total    <=  "SCORE: k/t"
# The PER-DOMAIN records are what make the paired design possible: the bootstrap
# resamples over TASKS, so aggregate counts alone are not enough.
# A domain whose measurement ERRORS (timeout, missing runner) is counted in
# `errors` and excluded from both numerators AND denominators — it is a
# measurement failure, not a gate result, and folding it into either direction
# would silently move the headline number.
measure_oracles() {  # repo -> JSON {domains,golden_pass,mutants,survived,errors,per_task}
  local repo="$1" d dom out score k t gp
  local domains=0 golden_pass=0 mut_total=0 mut_killed=0 errors=0
  local per="[]"
  if [ -x "$FALSIFY" ] && [ -d "$repo/evals/oracles" ]; then
    for d in "$repo/evals/oracles"/*/; do
      [ -d "$d/fixtures/mutants" ] || continue
      dom="$(basename "$d")"
      set +e
      out="$(HEIMDALL_ORACLES_DIR="$repo/evals/oracles" \
             perl -e 'alarm 300; exec @ARGV' -- "$FALSIFY" "$dom" 2>&1)"
      set -e
      score="$(printf '%s' "$out" | sed -n 's/^SCORE:[[:space:]]*\([0-9][0-9]*\/[0-9][0-9]*\).*/\1/p' | head -1)"
      if [ -z "$score" ]; then errors=$((errors + 1)); continue; fi
      domains=$((domains + 1))
      k="${score%%/*}"; t="${score##*/}"
      gp=0
      if printf '%s' "$out" | grep -q '(golden passing)'; then
        gp=1
        golden_pass=$((golden_pass + 1))
        # Mutant counts are only meaningful when the golden precondition held;
        # falsify emits 0/0 otherwise, which would fake a perfect survival rate.
        mut_total=$((mut_total + t)); mut_killed=$((mut_killed + k))
      fi
      per="$(printf '%s' "$per" | jq -c \
        --arg dom "$dom" --argjson gp "$gp" --argjson t "$t" --argjson k "$k" \
        '. + [{domain:$dom, golden_pass:$gp,
               mutants:(if $gp==1 then $t else 0 end),
               survived:(if $gp==1 then ($t-$k) else 0 end)}]')"
    done
  fi
  jq -cn --argjson dm "$domains" --argjson gp "$golden_pass" \
         --argjson mt "$mut_total" --argjson mk "$mut_killed" --argjson er "$errors" \
         --argjson per "$per" \
    '{domains:$dm, golden_pass:$gp, mutants:$mt, survived:($mt-$mk), errors:$er, per_task:$per}'
}

# ── Measurement: agent deaths (truncation / API-error fatalities) ─────────────
# bin/heimdall-agents classifies real Claude Code subagent transcripts as
# failed|killed|done|live|working|mailbox|stale. failed+killed in window = deaths.
#
# WHY THE TRACKER AND NOT A GLOB OVER THE TASK DIR: a task dir holds one
# `<id>.output` per BACKGROUND TASK, and background *Bash* commands land there
# next to agent spawns. Bash task ids are `b…` plain files; agent ids are `a…`
# symlinks to a transcript. Counting `*.output` therefore counts shell commands
# as if they were agents — measured on this repo it over-counted 58 against the
# tracker's 44, and every one of the extra entries was a background shell
# command, which cannot die of truncation because it is not an agent. The tracker
# resolves transcripts, so it is the correct source and the glob is not.
#
# SCOPE CAVEAT, recorded in the snapshot so a receipt cannot hide it: the tracker
# enumerates the CURRENT session's task dir and subagents dir, keyed off the
# project slug derived from the working directory. Run from a git worktree it
# resolves a different slug and sees nothing. That is why an EMPTY list is
# `unavailable` (the tracker is BLIND here) and not a measured zero — a populated
# list with no failures IS a measured zero. Collapsing those two would be the
# exact ambiguity this harness exists to prevent.
measure_agent_deaths() {  # repo window_days -> JSON {value,provenance,n,reason}
  local repo="$1" days="$2" js cutoff total deaths
  cutoff=$((days * 86400))
  if [ ! -x "$AGENTS" ]; then
    jq -cn '{value:null, provenance:"unavailable", reason:"bin/heimdall-agents not present"}'
    return 0
  fi
  set +e
  js="$( cd "$repo" 2>/dev/null && perl -e 'alarm 120; exec @ARGV' -- "$AGENTS" list --json 2>/dev/null )"
  set -e
  if [ -z "$js" ] || ! printf '%s' "$js" | jq -e 'type=="array"' >/dev/null 2>&1; then
    jq -cn '{value:null, provenance:"unavailable", reason:"agent tracker returned no parseable list"}'
    return 0
  fi
  total="$(printf '%s' "$js" | jq -r 'length')"
  if [ "$total" -eq 0 ]; then
    jq -cn '{value:null, provenance:"unavailable", n:0,
             reason:"agent tracker resolved no transcripts for this working directory — blind, not zero (the project slug follows cwd, so a worktree resolves a different slug)"}'
    return 0
  fi
  deaths="$(printf '%s' "$js" | jq -r --argjson cut "$cutoff" \
    '[ .[] | select((.state=="failed" or .state=="killed") and (.age_secs <= $cut)) ] | length')"
  jq -cn --argjson v "$deaths" --argjson n "$total" \
    '{value:$v, provenance:"measured", n:$n,
      source:"bin/heimdall-agents list --json (state failed|killed within window)",
      scope:"current session + working-directory project slug, NOT the repo whole-history count"}'
}

# ── Measurement: gate retries ─────────────────────────────────────────────────
# bin/heimdall-gate-run persists ONLY the latest verdict to .heimdall/verdict.json
# (it overwrites), so a WINDOW count needs an append-only history log. Where a
# deployment keeps one (.heimdall/gate-runs.jsonl), we count its deny records;
# where it does not, this is `unavailable` with the reason stated — a single
# retained verdict cannot be honestly reported as a week's retry count.
measure_gate_retries() {  # repo window_days -> JSON
  local repo="$1" days="$2" log since n
  log="$repo/.heimdall/gate-runs.jsonl"
  if [ ! -f "$log" ]; then
    jq -cn '{value:null, provenance:"unavailable",
             reason:"no .heimdall/gate-runs.jsonl; heimdall-gate-run retains only the latest verdict.json"}'
    return 0
  fi
  since="$(date -u -v-"${days}"d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
           || date -u -d "${days} days ago" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "")"
  n="$(jq -s --arg since "$since" \
        '[ .[] | select(.verdict=="deny") | select($since=="" or (.ts // "") >= $since) ] | length' \
        "$log" 2>/dev/null || echo "")"
  if [ -z "$n" ]; then
    jq -cn '{value:null, provenance:"unavailable", reason:"gate-runs.jsonl unparseable"}'
    return 0
  fi
  jq -cn --argjson v "$n" \
    '{value:$v, provenance:"measured", source:".heimdall/gate-runs.jsonl deny records in window"}'
}

# ── Estimation: time-to-green ─────────────────────────────────────────────────
# ESTIMATOR (stated so it can be argued with): a "fix-chain" commit is one whose
# subject starts with fix|test|revert, or mentions a red-to-green event (false-
# green, regression, flake, retry, unbreak). Its elapsed time since the commit
# immediately before it approximates how long that red took to go green. We report
# the MEDIAN and the IQR as the interval. This is a PROXY over commit timestamps,
# not a stopwatch on the gate — hence `estimated`, never `measured`.
estimate_time_to_green() {  # repo window_days -> JSON
  local repo="$1" days="$2" log deltas rc
  log="$( git -C "$repo" log --since="${days} days ago" --pretty=format:'%ct%x09%s' 2>/dev/null )" || log=""
  if [ -z "$log" ]; then
    jq -cn '{value:null, provenance:"unavailable", n:0,
             reason:"no commits in window — nothing to estimate from"}'
    return 0
  fi
  # The subject array is `subj`, NOT `sub` — `sub` is a reserved awk builtin and
  # using it as an array name is a syntax error. That bug once made this estimator
  # die and report "no fix-chain commits": a CRASH disguised as an honest zero.
  # So awk's exit status is checked explicitly and a failed estimator reports
  # `unavailable` naming the failure — never an empty result passed off as no-data.
  set +e
  deltas="$( printf '%s\n' "$log" | awk -F'\t' '{ ct[NR]=$1; subj[NR]=$2 } END {
        for (i = NR - 1; i >= 1; i--) {           # log is newest-first; walk to oldest
          s = tolower(subj[i])
          if (s ~ /^(fix|test|revert)[(:]/ || s ~ /false-green|regression|flake|retry|unbreak/) {
            d = (ct[i] - ct[i+1]) / 60            # i+1 is the chronologically previous commit
            if (d >= 0) printf "%.4f\n", d
          }
        }
      }' )"
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    jq -cn --argjson rc "$rc" \
      '{value:null, provenance:"unavailable",
        reason:"fix-chain estimator failed (awk exit \($rc)) — reporting the failure, not a zero"}'
    return 0
  fi
  if [ -z "$deltas" ]; then
    jq -cn '{value:null, provenance:"unavailable", n:0,
             reason:"no fix-chain commits in window — nothing to estimate from"}'
    return 0
  fi
  printf '%s\n' "$deltas" | jq -s --argjson minn "$MIN_N_FOR_INTERVAL" '
    sort as $s | ($s|length) as $n
    | def q($p): $s[ (($n - 1) * $p) | floor ];
      { value: (if $n % 2 == 1 then $s[($n/2)|floor]
                else (($s[$n/2 - 1] + $s[$n/2]) / 2) end),
        provenance: "estimated", n: $n,
        estimator: "median elapsed time from the preceding commit to each fix-chain commit (git)",
        interval: (if $n >= $minn then {lo: q(0.25), hi: q(0.75), kind: "IQR"} else null end),
        interval_note: (if $n >= $minn then null
                        else "n<\($minn): too small for a defensible interval — none computed" end) }'
}

# ── Headroom-sourced figures: operator input ONLY. Never invented. ────────────
# The harness cannot see Headroom's dashboard, so it accepts these as input. Not
# supplied => unavailable. It will never render 0 to mean "I could not find out".
headroom_metric() {  # value label -> JSON
  local v="$1" label="$2"
  if [ -z "$v" ]; then
    jq -cn --arg l "$label" \
      '{value:null, provenance:"unavailable",
        reason:"not supplied — read \($l) off Headroom dashboard and pass it in"}'
  else
    jq -cn --argjson v "$v" --arg l "$label" \
      '{value:$v, provenance:"measured", source:"Headroom dashboard (operator-supplied)"}'
  fi
}

# ── snapshot ──────────────────────────────────────────────────────────────────
cmd_snapshot() {
  local arm="" repo="" out="" days=7 tin="" tout="" cost="" hjson="" n
  while [ $# -gt 0 ]; do
    case "$1" in
      --arm)           arm="${2:?--arm needs before|after}"; shift 2 ;;
      --repo)          repo="${2:?--repo needs a dir}"; shift 2 ;;
      --out)           out="${2:?--out needs a path}"; shift 2 ;;
      --window-days)   days="${2:?--window-days needs a number}"; shift 2 ;;
      --tokens-in)     tin="${2:?--tokens-in needs a number}"; shift 2 ;;
      --tokens-out)    tout="${2:?--tokens-out needs a number}"; shift 2 ;;
      --cost)          cost="${2:?--cost needs a number}"; shift 2 ;;
      --headroom-json) hjson="${2:?--headroom-json needs a path}"; shift 2 ;;
      *) printf "  ${P}x${R} unknown snapshot flag: %s\n" "$1" >&2; exit 2 ;;
    esac
  done
  case "$arm" in before|after) ;; *) printf "  ${P}x${R} --arm must be before|after\n" >&2; exit 2 ;; esac
  case "$days" in ''|*[!0-9]*) printf "  ${P}x${R} --window-days must be a positive integer\n" >&2; exit 2 ;; esac
  [ "$days" -gt 0 ] || { printf "  ${P}x${R} --window-days must be > 0\n" >&2; exit 2; }
  for n in "$tin" "$tout"; do
    case "$n" in ''|*[!0-9]*) [ -z "$n" ] || { printf "  ${P}x${R} token counts must be integers\n" >&2; exit 2; } ;; esac
  done
  if [ -n "$cost" ] && ! printf '%s' "$cost" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
    printf "  ${P}x${R} --cost must be a non-negative number\n" >&2; exit 2
  fi

  if [ -z "$repo" ]; then
    repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  fi
  [ -d "$repo" ] || { printf "  ${P}x${R} no such repo dir: %s\n" "$repo" >&2; exit 2; }
  # A receipt must name an absolute location — "." is not reproducible evidence.
  repo="$( cd "$repo" && pwd -P )"

  # A JSON file of Headroom figures is an alternative to the three flags.
  if [ -n "$hjson" ]; then
    [ -f "$hjson" ] || { printf "  ${P}x${R} no such --headroom-json: %s\n" "$hjson" >&2; exit 2; }
    jq -e . "$hjson" >/dev/null 2>&1 || { printf "  ${P}x${R} --headroom-json is not valid JSON\n" >&2; exit 2; }
    [ -n "$tin" ]  || tin="$(jq -r '.tokens_in  // empty' "$hjson")"
    [ -n "$tout" ] || tout="$(jq -r '.tokens_out // empty' "$hjson")"
    [ -n "$cost" ] || cost="$(jq -r '.cost_usd   // empty' "$hjson")"
  fi

  printf "  ${D}measuring %s arm over %s (window %sd) …${R}\n" "$arm" "$repo" "$days" >&2

  local orc deaths retries ttg
  orc="$(measure_oracles "$repo")"
  deaths="$(measure_agent_deaths "$repo" "$days")"
  retries="$(measure_gate_retries "$repo" "$days")"
  ttg="$(estimate_time_to_green "$repo" "$days")"

  local snap
  snap="$(jq -n \
    --arg arm "$arm" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg repo "$repo" --argjson days "$days" --arg rh "$(rule_hash)" \
    --argjson orc "$orc" --argjson deaths "$deaths" \
    --argjson retries "$retries" --argjson ttg "$ttg" \
    --argjson tin "$(headroom_metric "$tin" "tokens in")" \
    --argjson tout "$(headroom_metric "$tout" "tokens out")" \
    --argjson cost "$(headroom_metric "$cost" "spend in USD")" '
    # A denominator of zero cannot produce a rate — that is unavailable, not 0.0.
    def rate($num; $den): if $den == 0 then null else (($num / $den) * 10000 | round) / 10000 end;
    { schema:"heimdall-headroom-ab/v2", arm:$arm, ts:$ts, repo:$repo,
      window_days:$days, rule_hash:$rh,
      per_task: $orc.per_task,
      metrics: {
        oracle_pass_rate: (
          if $orc.domains == 0
          then {value:null, provenance:"unavailable", n:0,
                reason:"no oracle domain with mutant fixtures could be measured"}
          else {value: rate($orc.golden_pass; $orc.domains), provenance:"measured",
                n:$orc.domains, passed:$orc.golden_pass, errors:$orc.errors,
                source:"bin/falsify golden check per oracle domain"} end),
        falsify_survival: (
          if $orc.mutants == 0
          then {value:null, provenance:"unavailable", n:0,
                reason:"no mutant ran under a passing golden — no survival rate exists"}
          else {value: rate($orc.survived; $orc.mutants), provenance:"measured",
                n:$orc.mutants, survived:$orc.survived, errors:$orc.errors,
                source:"bin/falsify mutant sweep, survived/total (denominator matches falsify own SCORE line, guards included)"} end),
        agent_deaths: $deaths,
        gate_retries: $retries,
        time_to_green_mins: $ttg,
        tokens_in: $tin, tokens_out: $tout, cost_usd: $cost } }')"

  if [ -n "$out" ]; then
    printf '%s\n' "$snap" > "$out"
    printf "  ${G}ok${R} ${D}snapshot written: %s${R}\n" "$out" >&2
  else
    printf '%s\n' "$snap"
  fi
}

# ── the statistics: Wilson per arm, paired bootstrap on the difference ────────
# Deterministic: the bootstrap RNG is seeded with a fixed constant recorded in the
# output, so re-running over the same two snapshots reproduces every digit. A
# receipt whose numbers move between runs is not a receipt.
stats_py() {
  cat <<'PY'
import json, math, random, sys

Z = 1.959963984540054      # two-sided 95%
BOOT = 10000               # pre-registered resample count
SEED = 20260804            # fixed => reproducible receipt
POWER_HALFWIDTH = 0.10     # pre-registered +/- 10 percentage points


def wilson(k, n):
    """Wilson score interval — the pre-registered per-arm interval."""
    if n <= 0:
        return None
    p = k / n
    d = 1.0 + Z * Z / n
    centre = (p + Z * Z / (2 * n)) / d
    half = Z * math.sqrt(p * (1 - p) / n + Z * Z / (4 * n * n)) / d
    return {"lo": max(0.0, centre - half), "hi": min(1.0, centre + half),
            "kind": "Wilson 95%"}


def percentile(sorted_vals, q):
    n = len(sorted_vals)
    idx = int(math.floor(q * (n - 1)))
    return sorted_vals[max(0, min(n - 1, idx))]


def load(path):
    with open(path) as fh:
        return json.load(fh)


def main():
    before, after = load(sys.argv[1]), load(sys.argv[2])
    bt = {d["domain"]: d for d in (before.get("per_task") or [])}
    at = {d["domain"]: d for d in (after.get("per_task") or [])}

    shared = sorted(set(bt) & set(at))
    excluded = sorted(set(bt) ^ set(at))

    out = {
        "seed": SEED, "resamples": BOOT,
        "power_halfwidth_threshold": POWER_HALFWIDTH,
        "paired_tasks": len(shared),
        "excluded_tasks": excluded,
        "excluded_count": len(excluded),
    }

    if not shared:
        out["verdict"] = "indeterminate"
        out["reasons"] = [
            "no task ran in BOTH arms — a paired design needs paired tasks, and "
            "an absent measurement is not evidence of success"]
        print(json.dumps(out))
        return

    # ── CLAUSE (a): IS EACH DECISION METRIC ACTUALLY MEASURED IN BOTH ARMS? ──────────
    # The rule's first clause was PRINTED by `preregister` and never implemented. Only
    # one availability case was checked — "no task ran in both arms" — so an arm that
    # swept ZERO mutants sailed past every later clause and landed on KEEP, publishing a
    # POSITIVE receipt for a metric it never measured. Measured 2026-08-10: 30 paired
    # tasks, 300 mutants in arm A, 0 in arm B, verdict `keep`. The stats blob printed
    # `mutants_before: 300` beside `mutants_after: 0` and said keep anyway.
    #
    # The distinction that makes this narrow rather than paranoid: a zero that is
    # EXPLAINED by a measurement is available, a zero that is explained by nothing is
    # not. bin/falsify sweeps no mutants when the golden itself failed — that zero is a
    # measured consequence of a real result, and the degraded arm must still publish its
    # NEGATIVE receipt. Only a task that PASSED its golden and still swept nothing means
    # the falsifier did not run.
    def _oracle_avail(tbl, arm):
        missing = [d for d in shared if tbl[d].get("golden_pass") is None]
        if not missing:
            return {"available": True, "reason": None}
        return {"available": False, "reason":
                "oracle pass-rate was NOT MEASURED in %s: %d of %d shared task(s) carry "
                "no golden result (%s). An absent measurement is neither a pass nor a "
                "failure." % (arm, len(missing), len(shared), ", ".join(missing[:5]))}

    def _falsify_avail(tbl, arm):
        blind = [d for d in shared
                 if tbl[d].get("golden_pass") and not (tbl[d].get("mutants") or 0)]
        if not blind:
            return {"available": True, "reason": None}
        return {"available": False, "reason":
                "falsify survival was NOT MEASURED in %s: %d of %d shared task(s) passed "
                "their golden yet swept zero mutants (%s). The falsifier did not run, "
                "which is not the same as nothing surviving."
                % (arm, len(blind), len(shared), ", ".join(blind[:5]))}

    availability = {
        "oracle_pass_rate": {"before": _oracle_avail(bt, "arm A"),
                             "after":  _oracle_avail(at, "arm B")},
        "falsify_survival": {"before": _falsify_avail(bt, "arm A"),
                             "after":  _falsify_avail(at, "arm B")},
    }
    out["availability"] = availability
    unavailable = [e["reason"] for m in availability.values() for e in m.values()
                   if not e["available"]]

    # The survivor counts are assembled BEFORE the verdict branches, and with .get()
    # rather than [], so an indeterminate receipt still carries the evidence FOR its own
    # verdict. A receipt that drops `mutants_after: 0` deletes the very number that
    # proves the arm was blind.
    def _sum(tbl, key):
        return sum((tbl[d].get(key) or 0) for d in shared)
    out["falsify"] = {
        "survivors_before": _sum(bt, "survived"), "survivors_after": _sum(at, "survived"),
        "domains_worsened": [d for d in shared
                             if (at[d].get("survived") or 0) > (bt[d].get("survived") or 0)],
        "categorical_stop": _sum(at, "survived") > _sum(bt, "survived"),
        "mutants_before": _sum(bt, "mutants"), "mutants_after": _sum(at, "mutants"),
    }

    if unavailable:
        out["verdict"] = "indeterminate"
        out["reasons"] = unavailable + [
            "clause (a): a decision metric unavailable in either arm resolves to "
            "INDETERMINATE. Publish neither receipt. Re-run the missing arm, then re-grade."]
        print(json.dumps(out))
        return

    b_pass = [bt[d]["golden_pass"] for d in shared]
    a_pass = [at[d]["golden_pass"] for d in shared]
    n = len(shared)

    kb, ka = sum(b_pass), sum(a_pass)
    out["oracle"] = {
        "before": {"passed": kb, "n": n, "rate": kb / n, "interval": wilson(kb, n)},
        "after": {"passed": ka, "n": n, "rate": ka / n, "interval": wilson(ka, n)},
    }

    # Paired difference, arm B (after) minus arm A (before), resampled over TASKS.
    diffs = [a - b for a, b in zip(a_pass, b_pass)]
    observed = sum(diffs) / n
    discordant = sum(1 for d in diffs if d != 0)

    rnd = random.Random(SEED)
    resampled = []
    for _ in range(BOOT):
        total = 0
        for _ in range(n):
            total += diffs[rnd.randrange(n)]
        resampled.append(total / n)
    resampled.sort()
    lo, hi = percentile(resampled, 0.025), percentile(resampled, 0.975)

    degenerate = discordant == 0
    if degenerate:
        # Zero discordant pairs => every resample is identical => a zero-width
        # interval that reflects the resampling, not the evidence. The rule-of-
        # three bound is the pre-registered replacement.
        bound = 3.0 / n
        lo, hi = -bound, bound
        kind = ("rule-of-three (+/- 3/n): zero discordant pairs, so the paired "
                "bootstrap is degenerate and its zero-width interval would be an "
                "artefact, not precision")
    else:
        kind = "paired bootstrap 95%% (%d resamples over tasks, seed %d)" % (BOOT, SEED)

    half_width = (hi - lo) / 2.0
    degraded = hi < 0                      # interval ENTIRELY below zero
    underpowered = half_width > POWER_HALFWIDTH

    out["oracle"]["difference"] = {
        "observed": observed, "lo": lo, "hi": hi, "kind": kind,
        "half_width": half_width, "discordant_pairs": discordant,
        "degenerate_bootstrap": degenerate,
    }
    out["power"] = {
        "half_width": half_width, "threshold": POWER_HALFWIDTH,
        "underpowered": underpowered,
    }

    # Falsify survival — CATEGORICAL. Decided on the survivor COUNT.
    # already assembled above, before the availability branch — read it back rather than
    # recomputing, so the numbers on an indeterminate receipt and a graded one are by
    # construction the same numbers.
    sb = out["falsify"]["survivors_before"]
    sa = out["falsify"]["survivors_after"]
    worsened = out["falsify"]["domains_worsened"]
    categorical_stop = out["falsify"]["categorical_stop"]

    reasons = []
    if categorical_stop:
        verdict = "unwrap"
        reasons.append(
            "CATEGORICAL STOP: falsify survivors rose %d -> %d (%s). A mutant that "
            "survives in arm B and dies in arm A is a broken gate, not a bad score. "
            "No confidence interval applies."
            % (sb, sa, ", ".join(worsened) or "aggregate"))
    elif degraded:
        verdict = "unwrap"
        reasons.append(
            "oracle pass-rate degraded: the B-A difference interval "
            "[%.3f, %.3f] lies entirely below zero" % (lo, hi))
    elif underpowered:
        verdict = "underpowered"
        reasons.append(
            "UNDERPOWERED: the pass-rate difference interval half-width is %.1fpp, "
            "wider than the pre-committed +/-%.0fpp threshold. This run could not "
            "tell. Reporting that as a clean null is exactly how an honest A/B "
            "becomes an advertisement."
            % (half_width * 100, POWER_HALFWIDTH * 100))
        if degenerate:
            reasons.append(
                "the %d paired tasks produced zero discordant pairs, so the "
                "interval is the rule-of-three bound rather than a zero-width "
                "bootstrap artefact" % n)
    else:
        verdict = "keep"
        reasons.append(
            "neither decision metric degraded and the run is adequately powered: "
            "difference interval [%.3f, %.3f], half-width %.1fpp within the "
            "+/-%.0fpp threshold"
            % (lo, hi, half_width * 100, POWER_HALFWIDTH * 100))

    if excluded:
        reasons.append(
            "%d task(s) ran in only one arm and were EXCLUDED from the paired "
            "analysis: %s" % (len(excluded), ", ".join(excluded)))

    out["verdict"] = verdict
    out["reasons"] = reasons
    print(json.dumps(out))


main()
PY
}

compute_stats() {  # before.json after.json -> stats JSON
  stats_py | python3 - "$1" "$2"
}

require_snap() {  # path
  [ -f "$1" ] || { printf "  ${P}x${R} no such snapshot: %s\n" "$1" >&2; exit 2; }
  jq -e '.metrics' "$1" >/dev/null 2>&1 \
    || { printf "  ${P}x${R} not a heimdall-headroom-ab snapshot: %s\n" "$1" >&2; exit 2; }
}

parse_ba() {  # sets BEFORE_F / AFTER_F
  BEFORE_F=""; AFTER_F=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --before) BEFORE_F="${2:?--before needs a path}"; shift 2 ;;
      --after)  AFTER_F="${2:?--after needs a path}"; shift 2 ;;
      *) printf "  ${P}x${R} unknown flag: %s\n" "$1" >&2; exit 2 ;;
    esac
  done
  [ -n "$BEFORE_F" ] && [ -n "$AFTER_F" ] \
    || { printf "  ${P}x${R} need --before <f> --after <f>\n" >&2; exit 2; }
  require_snap "$BEFORE_F"; require_snap "$AFTER_F"
}

# ── rendering ─────────────────────────────────────────────────────────────────
# Renders ONE metric row. Every row ends in its provenance label; an estimate
# also carries its interval (or an explicit refusal to compute one). An
# unavailable figure renders the word `unavailable` and NO digits at all, so it
# can never be misread as a measured zero.
render_row() {  # key label unit better(higher|lower) pct(0|1)
  local key="$1" label="$2" unit="$3" better="$4" pct="$5"
  local row
  row="$(jq -n --slurpfile b "$BEFORE_F" --slurpfile a "$AFTER_F" \
    --arg k "$key" --arg unit "$unit" --arg better "$better" --argjson pct "$pct" '
    ($b[0].metrics[$k]) as $B | ($a[0].metrics[$k]) as $A
    | def fmt($m): if $m == null or $m.value == null then "unavailable"
                   elif $pct == 1 then "\((($m.value * 1000) | round) / 10)%"
                   else "\($m.value)\($unit)" end;
      def prov($m): if $m == null then "unavailable" else $m.provenance end;
      def iv($m): if $m == null or $m.interval == null then
                    (if $m != null and $m.interval_note != null then "  [\($m.interval_note)]" else "" end)
                  else "  [\($m.interval.kind) \((($m.interval.lo*10)|round)/10)–\((($m.interval.hi*10)|round)/10)]" end;
      (if $B == null or $A == null or $B.value == null or $A.value == null then null
       else ($A.value - $B.value) end) as $d
    | { before: fmt($B), after: fmt($A),
        delta: (if $d == null then "unavailable"
                elif $pct == 1 then "\(if $d > 0 then "+" else "" end)\((($d * 1000) | round) / 10)pp"
                else "\(if $d > 0 then "+" else "" end)\((($d * 100) | round) / 100)\($unit)" end),
        dir: (if $d == null or $d == 0 then "flat"
              elif ($better == "higher" and $d > 0) or ($better == "lower" and $d < 0) then "better"
              else "worse" end),
        prov: (if prov($B) == prov($A) then prov($B) else "\(prov($B))/\(prov($A))" end),
        iv: (iv($A)) }' )"
  local bv av dv dir prov ivt col
  bv="$(printf '%s' "$row" | jq -r '.before')"
  av="$(printf '%s' "$row" | jq -r '.after')"
  dv="$(printf '%s' "$row" | jq -r '.delta')"
  dir="$(printf '%s' "$row" | jq -r '.dir')"
  prov="$(printf '%s' "$row" | jq -r '.prov')"
  ivt="$(printf '%s' "$row" | jq -r '.iv')"
  case "$dir" in better) col="$G" ;; worse) col="$P" ;; *) col="$D" ;; esac
  printf "  %-22s %14s  %14s  ${col}%12s${R}  ${D}%s${R}${D}%s${R}\n" \
    "$label" "$bv" "$av" "$dv" "$prov" "$ivt"
}

cmd_report() {
  parse_ba "$@"
  local sj verdict rh_live rh_b rh_a underp reasons
  sj="$(compute_stats "$BEFORE_F" "$AFTER_F")"
  verdict="$(printf '%s' "$sj" | jq -r '.verdict')"
  # The report states the rule it ACTUALLY graded by (the live rule this binary
  # applies), not whatever an arm happens to have recorded — otherwise an arm
  # missing a hash would hide the grading rule behind "unknown". Each arm's
  # recorded hash is then checked AGAINST it, so a snapshot registered under a
  # different (or no) rule is called out rather than silently accepted.
  rh_live="$(rule_hash)"
  rh_b="$(jq -r '.rule_hash // "unregistered"' "$BEFORE_F")"
  rh_a="$(jq -r '.rule_hash // "unregistered"' "$AFTER_F")"

  printf "\n"
  printf "  ${P}${B}░▒▓█${R} ${C}${B}H E I M D A L L   ×   H E A D R O O M   A / B${R} ${P}${B}█▓▒░${R}\n"
  printf "  ${V}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}\n"
  printf "  ${D}arm A (before): %s${R}\n" "$(jq -r '"\(.ts)  \(.repo)  window \(.window_days)d"' "$BEFORE_F")"
  printf "  ${D}arm B (after ): %s${R}\n\n" "$(jq -r '"\(.ts)  \(.repo)  window \(.window_days)d"' "$AFTER_F")"

  printf "  %-22s %14s  %14s  %12s  %s\n" "METRIC" "ARM A" "ARM B" "DELTA" "PROVENANCE"
  printf "  %-22s %14s  %14s  %12s  %s\n" \
    "----------------------" "--------------" "--------------" "------------" "----------"

  printf "  ${B}decision metrics${R} ${D}(these and only these compute the verdict)${R}\n"
  render_row oracle_pass_rate   "oracle pass-rate"   ""      higher 1
  render_row falsify_survival   "falsify survival"   ""      lower  1
  printf "\n  ${B}labelled cost${R} ${D}(reported, NEVER merged into a correctness claim)${R}\n"
  render_row gate_retries       "gate retries"       ""      lower  0
  render_row time_to_green_mins "time-to-green"      " min"  lower  0
  render_row agent_deaths       "agent deaths"       ""      lower  0
  render_row tokens_in          "tokens in"          ""      lower  0
  render_row tokens_out         "tokens out"         ""      lower  0
  render_row cost_usd           "cost (USD)"         ""      lower  0

  # Reasons a figure is absent — printed so `unavailable` is never a shrug.
  reasons="$(jq -r '.metrics | to_entries[]
              | select(.value.provenance == "unavailable")
              | "    \(.key): \(.value.reason // "no reason recorded")"' "$AFTER_F" 2>/dev/null || true)"
  if [ -n "$reasons" ]; then
    printf "\n  ${D}why a figure is unavailable (never rendered as 0):${R}\n"
    printf '%s\n' "$reasons" | while IFS= read -r l; do printf "  ${D}%s${R}\n" "$l"; done
  fi

  # ── the statistics, exactly as pre-registered ───────────────────────────────
  printf "\n  ${B}oracle pass-rate — STATISTICAL${R} ${D}(Wilson per arm, paired bootstrap on the difference)${R}\n"
  if printf '%s' "$sj" | jq -e '.oracle' >/dev/null 2>&1; then
    printf '%s' "$sj" | jq -r '
      "    arm A: \(.oracle.before.passed)/\(.oracle.before.n) = \((.oracle.before.rate*1000|round)/10)%  [\(.oracle.before.interval.kind) \((.oracle.before.interval.lo*1000|round)/10)–\((.oracle.before.interval.hi*1000|round)/10)%]",
      "    arm B: \(.oracle.after.passed)/\(.oracle.after.n) = \((.oracle.after.rate*1000|round)/10)%  [\(.oracle.after.interval.kind) \((.oracle.after.interval.lo*1000|round)/10)–\((.oracle.after.interval.hi*1000|round)/10)%]",
      "    B − A: \((.oracle.difference.observed*1000|round)/10)pp   95% interval [\((.oracle.difference.lo*1000|round)/10), \((.oracle.difference.hi*1000|round)/10)]pp",
      "           \(.oracle.difference.kind)",
      "           discordant pairs: \(.oracle.difference.discordant_pairs) of \(.paired_tasks)"
    ' | while IFS= read -r l; do printf "  ${D}%s${R}\n" "$l"; done

    printf "\n  ${B}power check${R} ${D}(pre-committed ±10pp threshold — underpowered is a RESULT)${R}\n"
    underp="$(printf '%s' "$sj" | jq -r '.power.underpowered')"
    if [ "$underp" = "true" ]; then
      printf '%s' "$sj" | jq -r '"    half-width \((.power.half_width*1000|round)/10)pp > threshold \((.power.threshold*1000|round)/10)pp → UNDERPOWERED"' \
        | while IFS= read -r l; do printf "  ${W}%s${R}\n" "$l"; done
    else
      printf '%s' "$sj" | jq -r '"    half-width \((.power.half_width*1000|round)/10)pp ≤ threshold \((.power.threshold*1000|round)/10)pp → conclusive"' \
        | while IFS= read -r l; do printf "  ${G}%s${R}\n" "$l"; done
    fi
  elif [ "$(printf '%s' "$sj" | jq -r '.paired_tasks // 0')" = "0" ]; then
    printf "  ${W}    no paired tasks — the statistics could not be computed${R}\n"
  else
    # There ARE pairs; the statistics are withheld because a decision metric was never
    # measured. Saying "no paired tasks" here would explain the withholding with a
    # pairing failure that did not happen, and send whoever reads the receipt to fix the
    # wrong thing.
    printf "  ${W}    NOT MEASURED — statistics withheld: a decision metric is unavailable in an arm${R}\n"
    printf '%s' "$sj" | jq -r '[.availability // {} | .[] | to_entries[] | select(.value.available == false) | .value.reason] | .[]' 2>/dev/null \
      | while IFS= read -r l; do printf "  ${W}    %s${R}\n" "$l"; done
  fi

  printf "\n  ${B}falsify survival — CATEGORICAL${R} ${D}(no CI: --assert-score 1.0 semantics)${R}\n"
  if printf '%s' "$sj" | jq -e '.falsify' >/dev/null 2>&1; then
    printf '%s' "$sj" | jq -r '
      "    survivors  arm A: \(.falsify.survivors_before) of \(.falsify.mutants_before) mutants    arm B: \(.falsify.survivors_after) of \(.falsify.mutants_after)",
      "    a survivor in arm B that dies in arm A is a HARD STOP — a safety finding, not a score"
    ' | while IFS= read -r l; do printf "  ${D}%s${R}\n" "$l"; done
  fi

  printf "\n  ${B}pairing${R}\n"
  printf '%s' "$sj" | jq -r '"    paired tasks: \(.paired_tasks)    excluded (ran in one arm only): \(.excluded_count)"' \
    | while IFS= read -r l; do printf "  ${D}%s${R}\n" "$l"; done

  # ── the verdict ─────────────────────────────────────────────────────────────
  printf "\n  ${V}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}\n"
  printf "  ${B}PRE-REGISTERED VERDICT${R}  ${D}rule_hash: %s${R}\n" "$rh_live"
  if [ "$rh_b" != "$rh_live" ] || [ "$rh_a" != "$rh_live" ]; then
    printf "  ${P}${B}! RULE PROVENANCE${R} ${P}arm hashes (A=%s B=%s) do not both match the${R}\n" "$rh_b" "$rh_a"
    printf "  ${P}  rule applied here (%s) — an arm was registered under a different rule, or none.${R}\n" "$rh_live"
  fi
  printf '%s' "$sj" | jq -r '.reasons[]' \
    | while IFS= read -r l; do [ -n "$l" ] && printf "  ${D}· %s${R}\n" "$l"; done

  case "$verdict" in
    unwrap)
      printf "\n  ${P}${B}VERDICT: UNWRAP${R} ${P}— a decision metric degraded. Run:${R} ${B}headroom unwrap claude${R}\n"
      printf "  ${P}Publish the NEGATIVE receipt.${R} ${D}This is a real result, not a failure of the${R}\n"
      printf "  ${D}experiment: the pre-registered rule fired exactly as written, before the data${R}\n"
      printf "  ${D}existed. A negative receipt is as publishable as a positive one.${R}\n" ;;
    keep)
      printf "\n  ${G}${B}VERDICT: KEEP${R} ${G}— neither decision metric degraded, and the run is powered${R}\n"
      printf "  ${G}enough to say so. Keep the wrapper. Publish the POSITIVE receipt.${R}\n" ;;
    underpowered)
      printf "\n  ${W}${B}VERDICT: UNDERPOWERED${R} ${W}— this run could not tell.${R}\n"
      printf "  ${W}Publish the UNDERPOWERED result AS the finding${R} ${D}— not as a null. The interval${R}\n"
      printf "  ${D}is wider than the pre-committed ±10pp threshold, so declaring the two arms${R}\n"
      printf "  ${D}equivalent would be an unsupported claim. More paired tasks are needed.${R}\n" ;;
    *)
      printf "\n  ${W}${B}VERDICT: INDETERMINATE${R} ${W}— a decision metric is unavailable in an arm.${R}\n"
      printf "  ${W}Publish NEITHER receipt.${R} ${D}An absent measurement is not evidence of success${R}\n"
      printf "  ${D}and must never default to KEEP. Re-run the missing arm, then re-grade.${R}\n" ;;
  esac
  printf "\n  ${D}Labelling convention (measured vs estimated, intervals on counterfactuals)${R}\n"
  printf "  ${D}adopted from Headroom's own methodology — credit to Headroom.${R}\n\n"
}

cmd_verdict() {
  parse_ba "$@"
  # FAIL CLOSED. `compute_stats | jq -r .verdict` printed an EMPTY line whenever the
  # grader could not run at all — a snapshot that satisfies require_snap (which only
  # checks that `.metrics` exists) but whose per_task is not a list of task records
  # reaches the grader intact and dies there. A blank verdict is the worst output this
  # tool can emit: `$(… verdict …)` yields "", every comparison against it is false, and
  # the caller silently takes whichever branch it happened to write first. An
  # uncomputable comparison is INDETERMINATE, said out loud, with a nonzero exit so no
  # caller can mistake it for a graded run.
  local sj v
  sj="$(compute_stats "$BEFORE_F" "$AFTER_F" 2>/dev/null || true)"
  v="$(printf '%s' "$sj" | jq -r '.verdict // empty' 2>/dev/null || true)"
  if [ -z "$v" ]; then
    printf "  ${P}x${R} the comparison could not be computed — the arms did not yield a gradeable\n" >&2
    printf "     pair (a snapshot may be truncated or not carry per-task records). Reporting\n" >&2
    printf "     INDETERMINATE: an ungradeable run is never a pass.\n" >&2
    echo "indeterminate"
    return 3
  fi
  printf '%s\n' "$v"
}

cmd_stats() {
  parse_ba "$@"
  compute_stats "$BEFORE_F" "$AFTER_F" | jq .
}

# ── dispatch ──────────────────────────────────────────────────────────────────
[ $# -ge 1 ] || { usage; exit 0; }
case "$1" in
  -h|--help)   usage; exit 0 ;;
  preregister)
    shift
    printf "\n  ${B}PRE-REGISTERED VERDICT RULE${R} ${D}— written before the data, hashed so a receipt${R}\n"
    printf "  ${D}proves it was not rewritten afterwards.${R}\n\n"
    rule_text | while IFS= read -r l; do printf "  %s\n" "$l"; done
    printf "\n  ${B}rule_hash: %s${R}\n" "$(rule_hash)"
    printf "  ${D}Any edit to the rule changes this hash. A report whose rule_hash differs${R}\n"
    printf "  ${D}from this one was graded by a different rule — treat it as unregistered.${R}\n\n"
    ;;
  snapshot)  shift; cmd_snapshot "$@" ;;
  report)    shift; cmd_report   "$@" ;;
  verdict)   shift; cmd_verdict  "$@" ;;
  stats)     shift; cmd_stats    "$@" ;;
  *) printf "  ${P}x${R} unknown subcommand: ${B}%s${R}\n" "$1" >&2
     printf "  ${D}Run ${C}heimdall-headroom-ab --help${D} for usage.${R}\n" >&2
     exit 2 ;;
esac
