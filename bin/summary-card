#!/usr/bin/env bash
# summary-card — heimdall end-of-run summary card.
# Renders a truecolor ASCII box from .planning/STATE.md + heimdall-state.json + git log.
# Pure shell. No network, no model involvement. Missing data → "—", never crashes.
#
# Usage: summary-card [PROJECT_DIR]   (defaults to cwd)
set -uo pipefail

# ── --heartbeat verb: print the autopilot one-line receipt and exit ──
# Renders the maintainer autopilot heartbeat (from .planning/CHECKPOINT.md via
# bin/heimdall-maintain-loop). A missing loop bin / checkpoint yields a safe "—".
if [ "${1:-}" = "--heartbeat" ]; then
  shift
  HB_PROJECT="${1:-.}"
  HB_BINDIR="$(cd "$(dirname "$0")" && pwd)"
  if [ -x "$HB_BINDIR/heimdall-maintain-loop" ]; then
    "$HB_BINDIR/heimdall-maintain-loop" heartbeat --repo "$HB_PROJECT" 2>/dev/null || echo "autopilot: —"
  else
    echo "autopilot: —"
  fi
  exit 0
fi

# ── Arg parse: [--receipt] [PROJECT_DIR] (flag may precede OR follow the dir) ──
# Default mode is the existing end-of-run "card". `--receipt` renders the flagship
# Run Receipt — the single shareable proof artifact. Both accept a project dir.
MODE="card"
PROJECT="."
for _arg in "$@"; do
  case "$_arg" in
    --receipt) MODE="receipt" ;;
    -h|--help) MODE="help" ;;
    *) PROJECT="$_arg" ;;
  esac
done
if [ "$MODE" = "help" ]; then
  echo "usage: summary-card [--receipt] [PROJECT_DIR]"
  echo "  (no flag)   end-of-run summary card"
  echo "  --receipt   the Heimdall Run Receipt — one shareable proof artifact"
  exit 0
fi

# This script's bin/ dir + plugin root (for sibling emitters + sentinels/hmd-sigil.py).
_SELF_SC="${BASH_SOURCE[0]:-$0}"
BINDIR="$(cd "$(dirname "$_SELF_SC")" 2>/dev/null && pwd || echo .)"
ROOT="$(dirname "$BINDIR")"
PLANNING="$PROJECT/.planning"
STATE_MD="$PLANNING/STATE.md"
# Prefer heimdall-state.json; fall back to legacy superx-state.json (back-compat).
if [ -f "$PROJECT/heimdall-state.json" ]; then
  STATE_JSON="$PROJECT/heimdall-state.json"
elif [ -f "$PROJECT/superx-state.json" ]; then
  STATE_JSON="$PROJECT/superx-state.json"
else
  STATE_JSON="$PROJECT/heimdall-state.json"
fi

# ── Color detection (mirrors install.sh) ──
if [[ "${COLORTERM:-}" == "truecolor" || "${COLORTERM:-}" == "24bit" || "${TERM:-}" == *256color* ]]; then
  P='\033[38;2;224;86;160m'   # pink
  C='\033[38;2;0;212;255m'    # cyan
  G='\033[38;2;78;204;163m'   # green
  W='\033[38;2;255;200;80m'   # warm yellow
  RED='\033[38;2;255;95;110m' # red
  D='\033[38;2;100;100;120m'  # dim
elif [ -t 1 ] || [ -n "${TERM:-}" ]; then
  P='\033[35m'; C='\033[36m'; G='\033[32m'; W='\033[33m'; RED='\033[31m'; D='\033[37m'
else
  P=''; C=''; G=''; W=''; RED=''; D=''
fi
B='\033[1m'; R='\033[0m'

DASH="—"

# ── JSON reader (python3 → jq → defaults) ──
# Emits: tests lint dirty total limit  (space-separated)
read_state_json() {
  [ -f "$STATE_JSON" ] || { echo "- - - - -"; return; }
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$STATE_JSON" <<'PY' 2>/dev/null && return
import json, sys
try:
    s = json.load(open(sys.argv[1]))
except Exception:
    print("- - - - -"); sys.exit(0)
g = s.get("quality_gates", {}) or {}
b = s.get("budget", {}) or {}
def b2s(v): return "1" if v is True else ("0" if v is False else "-")
tot = b.get("total_tokens"); lim = b.get("token_limit")
print(b2s(g.get("tests_passing")), b2s(g.get("lint_clean")), b2s(g.get("dirty")),
      tot if isinstance(tot,(int,float)) else "-",
      lim if isinstance(lim,(int,float)) else "-")
PY
  fi
  if command -v jq >/dev/null 2>&1; then
    jq -r '
      def b2s: if .==true then "1" elif .==false then "0" else "-" end;
      [ (.quality_gates.tests_passing|b2s), (.quality_gates.lint_clean|b2s),
        (.quality_gates.dirty|b2s), (.budget.total_tokens // "-"),
        (.budget.token_limit // "-") ] | join(" ")
    ' "$STATE_JSON" 2>/dev/null && return
  fi
  echo "- - - - -"
}

read -r ST_TESTS ST_LINT ST_DIRTY ST_TOTAL ST_LIMIT <<<"$(read_state_json)"

# ── Bloat scorecard (H-2) — rendered PURELY from the bloat report.json ──
# Zero model tokens: this is hooks/shell reading the deterministic gate report.
# Format: "0 dead exports · 1.2% dup · LOC 0.9× est · −N lines after simplify".
# Each segment honestly shows "—" when its axis was skipped (tool absent), never
# a fake number. Returns an empty string if no bloat report exists yet.
BLOAT_REPORT=""
for cand in \
  "$PLANNING/spawns/reports/bloat.report.json" \
  "$PROJECT/.planning/spawns/reports/bloat.report.json"; do
  [ -f "$cand" ] && { BLOAT_REPORT="$cand"; break; }
done
read_bloat_line() {
  [ -n "$BLOAT_REPORT" ] && [ -f "$BLOAT_REPORT" ] || { echo ""; return; }
  command -v jq >/dev/null 2>&1 || { echo ""; return; }
  jq -r '
    .metrics as $m
    | ($m.dead_code // {})   as $d
    | ($m.duplication // {}) as $u
    | ($m.loc_budget // {})  as $l
    | (if ($d.status=="ran" or $d.status=="n/a") and ($d.new_unreferenced != null)
         then ($d.new_unreferenced|tostring) + " dead exports" else "— dead" end) as $seg_d
    | (if $u.status=="ran" and ($u.pct != null)
         then (($u.pct|tostring) + "% dup") else "—% dup" end) as $seg_u
    | (if $l.status=="ran" and ($l.ratio != null)
         then ("LOC " + ($l.ratio|tostring) + "× est")
         elif ($l.added != null) then ("LOC " + ($l.added|tostring) + " lines")
         else "LOC —" end) as $seg_l
    | (($m.simplification_delta_lines // 0)) as $sd
    | (if ($sd|tonumber) > 0 then "−" + ($sd|tostring) + " lines after simplify" else "" end) as $seg_s
    | ([$seg_d, $seg_u, $seg_l] + (if $seg_s=="" then [] else [$seg_s] end)) | join(" · ")
  ' "$BLOAT_REPORT" 2>/dev/null || echo ""
}
BLOAT_LINE="$(read_bloat_line)"
BLOAT_STATUS=""
if [ -n "$BLOAT_REPORT" ] && command -v jq >/dev/null 2>&1; then
  BLOAT_STATUS="$(jq -r '.status // ""' "$BLOAT_REPORT" 2>/dev/null || echo "")"
fi

# ── Task / phase name from STATE.md ──
TASK="$DASH"
if [ -f "$STATE_MD" ]; then
  # Prefer an explicit task_name/goal/title; else current_phase; else first H1.
  t=$(grep -m1 -iE '^(task_name|goal|title):' "$STATE_MD" 2>/dev/null | sed -E 's/^[^:]*: *//')
  [ -z "$t" ] && t=$(grep -m1 '^current_phase:' "$STATE_MD" 2>/dev/null | sed 's/current_phase: *//')
  [ -z "$t" ] && t=$(grep -m1 '^# ' "$STATE_MD" 2>/dev/null | sed 's/^# *//')
  [ -n "$t" ] && TASK="$t"
fi

# ── Phase ──
PHASE="$DASH"
if [ -f "$STATE_MD" ]; then
  p=$(grep -m1 '^current_phase:' "$STATE_MD" 2>/dev/null | sed 's/current_phase: *//')
  [ -n "$p" ] && PHASE="$p"
fi

# ── Waves completed (scan PLAN-*.md + SUMMARY-*) ──
WAVES="$DASH"
for plan in "$PLANNING"/PLAN-*.md; do
  [ -f "$plan" ] || continue
  phase_num=$(basename "$plan" | grep -oE '[0-9]+' | head -1)
  # Count both legacy "### Task:" headings and the structured "<task " blocks.
  total=$(grep -cE '^### Task:|<task[ >]' "$plan" 2>/dev/null | head -1 | tr -dc '0-9')
  [ -n "$total" ] || total=0
  done_count=0
  for summary in "$PLANNING"/SUMMARY-"$phase_num"-wave-*.md; do
    [ -f "$summary" ] || continue
    d=$(grep -c "| DONE |" "$summary" 2>/dev/null | head -1 | tr -dc '0-9'); [ -n "$d" ] || d=0
    done_count=$((done_count + d))
  done
  # If no SUMMARY rows but the plan has <done>true</done> blocks, count those.
  if [ "$done_count" -eq 0 ]; then
    d=$(grep -c '<done>true</done>' "$plan" 2>/dev/null | head -1 | tr -dc '0-9'); [ -n "$d" ] || d=0
    done_count="$d"
  fi
  WAVES="$done_count/$total"
  break
done

# ── Commits this session ──
# Boundary = most recent heimdall session-end checkpoint commit. Count commits
# AFTER it (i.e. work done since last session closed). If none found, count
# all commits reachable from HEAD (capped display).
# Match both the new 'heimdall:' prefix and the legacy 'superx:' one (back-compat).
COMMITS="$DASH"
if [ -d "$PROJECT/.git" ] || git -C "$PROJECT" rev-parse --git-dir >/dev/null 2>&1; then
  boundary=$(git -C "$PROJECT" log --grep='\(heimdall\|superx\): session-end checkpoint' \
              --format='%H' -n1 2>/dev/null || true)
  if [ -n "$boundary" ]; then
    c=$(git -C "$PROJECT" rev-list --count "${boundary}..HEAD" 2>/dev/null || echo "")
  else
    c=$(git -C "$PROJECT" rev-list --count HEAD 2>/dev/null || echo "")
  fi
  [ -n "$c" ] && COMMITS="$c"
fi

# ── Gate glyphs / labels ──
gate_label() { # value, ok-text, bad-text
  case "$1" in
    1) printf "%bPASS%b" "$G" "$R" ;;
    0) printf "%bFAIL%b" "$RED" "$R" ;;
    *) printf "%b%s%b" "$D" "$DASH" "$R" ;;
  esac
}
TESTS_LBL=$(gate_label "$ST_TESTS")
LINT_LBL=$(gate_label "$ST_LINT")
case "$ST_DIRTY" in
  1) DIRTY_LBL=$(printf "%bdirty ●%b" "$W" "$R") ;;
  0) DIRTY_LBL=$(printf "%bclean ○%b" "$G" "$R") ;;
  *) DIRTY_LBL=$(printf "%b%s%b" "$D" "$DASH" "$R") ;;
esac

# ── Token figures + raw-Claude-Code estimate ──
fmt_tokens() {
  awk -v n="$1" 'BEGIN{
    if (n=="-" ) { print "—"; exit }
    if (n+0 >= 1000000) printf "%.2fM", n/1000000;
    else if (n+0 >= 1000) printf "%.1fk", n/1000;
    else printf "%d", n;
  }'
}
if [ "$ST_TOTAL" != "-" ]; then
  SPENT=$(fmt_tokens "$ST_TOTAL")
  # Estimate of raw (non-heimdall) Claude Code usage at a ~4x efficiency baseline.
  EST_RAW=$(awk -v t="$ST_TOTAL" 'BEGIN{printf "%d", t/0.25}')
  EST_LBL=$(fmt_tokens "$EST_RAW")
else
  SPENT="$DASH"
  EST_LBL="$DASH"
fi

# ── Token-ledger line — the PROTOCOL's own measured delta (mechanism 6). ──
# Distinct from the budget tokens above: this is the per-run protocol message
# cost summed from .planning/protocol/ledger.jsonl, against the v1 baseline in
# baselines.json — the MEASURED, screenshotable savings claim. Honest "—" when
# the ledger is empty / jq is absent. Format: "measured 12.0k vs ~41.0k v1  (−71%)".
LEDGER_FILE="$PLANNING/protocol/ledger.jsonl"
BASELINE_FILE="$PLANNING/protocol/baselines.json"
LEDGER_LINE=""
if [ -f "$LEDGER_FILE" ] && command -v jq >/dev/null 2>&1; then
  measured=$(jq -s '[.[].tokens // 0] | add // 0' "$LEDGER_FILE" 2>/dev/null || echo 0)
  if [ "${measured:-0}" -gt 0 ] 2>/dev/null; then
    base=0
    if [ -f "$BASELINE_FILE" ]; then
      base=$(jq -r '[.baselines[]? // 0] | add // 0' "$BASELINE_FILE" 2>/dev/null || echo 0)
    fi
    m_lbl=$(fmt_tokens "$measured")
    if [ "${base:-0}" -gt 0 ] 2>/dev/null && [ "$base" -ge "$measured" ]; then
      b_lbl=$(fmt_tokens "$base")
      pct=$(awk -v b="$base" -v m="$measured" 'BEGIN{printf "%d", (b-m)*100/b}')
      LEDGER_LINE="measured ${m_lbl} vs ~${b_lbl} v1  (−${pct}%)"
    else
      LEDGER_LINE="measured ${m_lbl}  (no v1 baseline)"
    fi
  fi
fi

# ── Reel line — the run's shareable artifact (the distribution share-unit). ──
# Newest artifact under .planning/reels/ (prefer mp4 > gif > cast > txt). "—" when
# no reel was produced this run.
REEL_LINE=""
REEL_DIR="$PLANNING/reels"
if [ -d "$REEL_DIR" ]; then
  for ext in mp4 gif cast txt; do
    newest=$(ls -t "$REEL_DIR"/*."$ext" 2>/dev/null | head -1)
    if [ -n "$newest" ]; then
      REEL_LINE="$newest"
      break
    fi
  done
fi

# ── Autopilot heartbeat line — the maintainer loop's durable receipt (H-6). ──
# Rendered ONLY when a CHECKPOINT.md carries an autopilot block; a pure render of
# the last machine-readable header via bin/heimdall-maintain-loop. "—" otherwise.
HEARTBEAT_LINE=""
SC_BINDIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$PLANNING/CHECKPOINT.md" ] \
   && grep -q 'heimdall-autopilot' "$PLANNING/CHECKPOINT.md" 2>/dev/null \
   && [ -x "$SC_BINDIR/heimdall-maintain-loop" ]; then
  HEARTBEAT_LINE="$("$SC_BINDIR/heimdall-maintain-loop" heartbeat --repo "$PROJECT" 2>/dev/null || echo "")"
  # strip the leading "autopilot: " label — the row already names the axis.
  HEARTBEAT_LINE="${HEARTBEAT_LINE#autopilot: }"
  # a bare sentinel is not worth a row.
  case "$HEARTBEAT_LINE" in
    "no checkpoint yet"|"—"|"") HEARTBEAT_LINE="" ;;
  esac
fi

# ── Box rendering ──
# Fixed inner width; pad/truncate each line's visible text to fit.
WIDTH=54
hr() { # char
  local c="$1" out="" i
  for ((i=0; i<WIDTH; i++)); do out="${out}${c}"; done
  printf "%s" "$out"
}

# Print a content row: label (dim) + value, padded to WIDTH visible chars.
# Args: label, value-plain, value-colored
row() {
  local label="$1" vplain="$2" vcolored="$3"
  local left="  ${label} "
  # Visible length = left + vplain
  local vis=$(( ${#left} + ${#vplain} ))
  local pad=$(( WIDTH - vis ))
  [ "$pad" -lt 0 ] && pad=0
  local spaces=""; local i
  for ((i=0; i<pad; i++)); do spaces="${spaces} "; done
  printf "%b│%b%b%s%b%b%s%b│%b\n" \
    "$D" "$R" "$D" "$left" "$R" "$vcolored" "$spaces" "$D" "$R"
}

# Title row (centered-ish, bold pink)
title_row() {
  local txt="$1"
  local vis=$(( ${#txt} + 2 ))
  local pad=$(( WIDTH - vis ))
  [ "$pad" -lt 0 ] && pad=0
  local spaces=""; local i
  for ((i=0; i<pad; i++)); do spaces="${spaces} "; done
  printf "%b│%b %b%b%s%b%s %b│%b\n" "$D" "$R" "$B" "$P" "$txt" "$R" "$spaces" "$D" "$R"
}

# Truncate a plain string to a max visible width with ellipsis.
trunc() {
  local s="$1" max="$2"
  if [ "${#s}" -gt "$max" ]; then
    printf "%s…" "${s:0:$((max-1))}"
  else
    printf "%s" "$s"
  fi
}

TASK_T=$(trunc "$TASK" 44)
PHASE_T=$(trunc "$PHASE" 44)

# Compose value plains (for width math) and colored variants.
GATES_PLAIN="tests:$( [ "$ST_TESTS" = 1 ] && echo PASS || { [ "$ST_TESTS" = 0 ] && echo FAIL || echo "$DASH"; }) lint:$( [ "$ST_LINT" = 1 ] && echo PASS || { [ "$ST_LINT" = 0 ] && echo FAIL || echo "$DASH"; }) $( [ "$ST_DIRTY" = 1 ] && echo 'dirty ●' || { [ "$ST_DIRTY" = 0 ] && echo 'clean ○' || echo "$DASH"; })"
GATES_COLORED="${D}tests:${R}${TESTS_LBL} ${D}lint:${R}${LINT_LBL} ${DIRTY_LBL}"

TOKENS_PLAIN="${SPENT} spent  (vs ~${EST_LBL} raw-CC est.)"
TOKENS_COLORED="${C}${SPENT}${R} ${D}spent${R}  ${D}(vs ~${R}${W}${EST_LBL}${R} ${D}raw-CC est.)${R}"

# ══════════════════════════════════════════════════════════════════════════════
#  HEIMDALL RUN RECEIPT (`--receipt`) — the flagship shareable proof artifact.
#
#  One screenshot bundling a whole run's proof: swarm + every gate + leaner-code
#  + cost, sigil-branded. Every field is REAL-or-OMITTED — pulled live from the
#  deterministic emitters, never fabricated. A gate that FAILED renders ✗/red;
#  the receipt tells the truth about a bad run too. Reads files/JSON only — no
#  network, no model calls. Degrades to clean plain text in a pipe / CI.
#
#  Data seam (env override → real default): each source can be pinned via a
#  HEIMDALL_RECEIPT_* env var (used by the test-suite fixtures); with none set it
#  reads the production locations + sibling emitters.
# ══════════════════════════════════════════════════════════════════════════════

_PY_RCPT="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"

# Codepoint length of a plain string (visible columns; our glyphs are width-1).
rvis() { local s="$1"; printf "%s" "${#s}"; }
rsp()  { local n="$1" o="" i; for ((i=0;i<n;i++)); do o="$o "; done; printf "%s" "$o"; }

render_receipt() {
  # ── strict-tty colour gate: a pipe / CI / NO_COLOR / --plain → zero ANSI ──
  local rcolor=0
  if [ -t 1 ] && [ -z "${HEIMDALL_RECEIPT_PLAIN:-}" ] && [ -z "${NO_COLOR:-}" ] && [ -z "${CI:-}" ]; then
    rcolor=1
  fi
  local rP rC rG rW rRED rD rB rR
  if [ "$rcolor" = 1 ]; then
    rP='\033[38;2;224;86;160m'; rC='\033[38;2;0;212;255m'; rG='\033[38;2;78;204;163m'
    rW='\033[38;2;255;200;80m'; rRED='\033[38;2;255;95;110m'; rD='\033[38;2;120;120;140m'
    rB='\033[1m'; rR='\033[0m'
    if [[ "${COLORTERM:-}" != "truecolor" && "${COLORTERM:-}" != "24bit" && "${TERM:-}" != *256color* ]]; then
      rP='\033[35m'; rC='\033[36m'; rG='\033[32m'; rW='\033[33m'; rRED='\033[31m'; rD='\033[90m'
    fi
  else
    rP=''; rC=''; rG=''; rW=''; rRED=''; rD=''; rB=''; rR=''
  fi

  local VW=40           # value-field width (visible cols)
  local INNER=49        # cols between the ║ borders

  # ── identity / machine brand + corner sigil ──
  local seed who
  who="${HEIMDALL_RECEIPT_WHO:-}"
  if [ -z "$who" ]; then
    local u h
    u="$(id -un 2>/dev/null || whoami 2>/dev/null || echo user)"
    h="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)"
    h="$(printf '%s' "$h" | tr '[:upper:]' '[:lower:]')"
    who="${u}.${h}"
  fi
  who="$(trunc "$who" 14)"
  seed="${who%%.*}"
  local sigil_mark="◈" sigil_glyph="◈"
  if [ "$rcolor" = 1 ] && [ -n "$_PY_RCPT" ] && [ -f "$ROOT/sentinels/hmd-sigil.py" ]; then
    local g; g="$("$_PY_RCPT" "$ROOT/sentinels/hmd-sigil.py" --seed "$seed" --glyph 2>/dev/null | head -1)"
    [ -n "$g" ] && sigil_glyph="$g"
  fi

  # ══ ROW 1 · TASK ══
  local task_plain; task_plain="$(trunc "$TASK" "$VW")"
  local task_col="${rC}${task_plain}${rR}"

  # ══ ROW 2 · SWARM (agent-pool status) ══
  local pool_json="" swarm_plain="" swarm_col=""
  local psrc="${HEIMDALL_RECEIPT_POOL_JSON:-}"
  if [ -n "$psrc" ]; then
    [ -f "$psrc" ] && pool_json="$(cat "$psrc" 2>/dev/null)"
  elif [ -x "$BINDIR/agent-pool" ]; then
    pool_json="$("$BINDIR/agent-pool" status 2>/dev/null)"
  fi
  local swarm_raw=""
  if [ -n "$pool_json" ] && [ -n "$_PY_RCPT" ]; then
    swarm_raw="$(printf '%s' "$pool_json" | "$_PY_RCPT" -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print("0|"); sys.exit(0)
ag=d.get("agents",{}) or {}
roles={}; order=[]
for a in ag.values():
    t=a.get("type","?"); s=a.get("status","")
    if t not in roles: roles[t]="active"; order.append(t)
    if s=="done": roles[t]="done"
print(str(len(ag))+"|"+",".join("%s:%s"%(t,roles[t]) for t in order))
' 2>/dev/null)"
  fi
  local swarm_n="${swarm_raw%%|*}"; local swarm_roles="${swarm_raw#*|}"
  if [ -n "$swarm_raw" ] && [ "${swarm_n:-0}" -gt 0 ] 2>/dev/null; then
    swarm_plain="⟳${swarm_n} agents ▸ "
    swarm_col="${rC}⟳${swarm_n} agents${rR} ${rD}▸${rR} "
    local IFS_OLD="$IFS"; IFS=','
    local pair; for pair in $swarm_roles; do
      [ -n "$pair" ] || continue
      local rn="${pair%%:*}" rs="${pair#*:}" gl gc
      if [ "$rs" = "done" ]; then gl="✓"; gc="$rG"; else gl="⟳"; gc="$rW"; fi
      swarm_plain="${swarm_plain}${rn}${gl} "
      swarm_col="${swarm_col}${rD}${rn}${rR}${gc}${gl}${rR} "
    done
    IFS="$IFS_OLD"
    swarm_plain="${swarm_plain% }"
  else
    swarm_plain="n/a"; swarm_col="${rD}n/a${rR}"
  fi

  # ══ ROW 3 · GATES (falsify · corpus · stub) + gate-health for the Bifröst ══
  # Three-valued gate health, not two: a gate can be RED (ran, found a problem)
  # or UNVERIFIED (could not run at all). Conflating them is how a run that
  # checked NOTHING renders as a clean bill.
  local gates_red=0 gates_ran=0 gates_unverified=0
  # falsify — passing/total over evals/oracles/*/report.json
  local oradir="${HEIMDALL_RECEIPT_ORACLE_DIR:-$ROOT/evals/oracles}"
  local f_seg_p="" f_col="" f_pass=0 f_tot=0
  if [ -n "$_PY_RCPT" ] && [ -d "$oradir" ]; then
    local fr; fr="$("$_PY_RCPT" -c '
import json,sys,glob,os
d=sys.argv[1]; p=t=0
for r in sorted(glob.glob(os.path.join(d,"*","report.json"))):
    try: st=json.load(open(r)).get("status","")
    except Exception: continue
    t+=1
    if st=="pass": p+=1
print("%d %d"%(p,t))
' "$oradir" 2>/dev/null)"
    f_pass="${fr%% *}"; f_tot="${fr##* }"
  fi
  if [ "${f_tot:-0}" -gt 0 ] 2>/dev/null; then
    gates_ran=1
    local score; score="$(awk -v p="$f_pass" -v t="$f_tot" 'BEGIN{printf "%.1f", (t>0)?p/t:0}')"
    f_seg_p="falsify ${f_pass}/${f_tot}=${score}"
    if [ "$f_pass" -ge "$f_tot" ]; then f_col="${rG}${f_seg_p}${rR}"; else f_col="${rRED}${f_seg_p}✗${rR}"; f_seg_p="${f_seg_p}✗"; gates_red=1; fi
  else
    f_seg_p="falsify n/a"; f_col="${rD}${f_seg_p}${rR}"
  fi
  # corpus — X/Y caught from CORPUS-STATUS.md
  local cstat="${HEIMDALL_RECEIPT_CORPUS_STATUS:-$ROOT/evals/corpus/CORPUS-STATUS.md}"
  local c_seg_p="" c_col=""
  if [ -f "$cstat" ]; then
    local cxy; cxy="$(grep -oE '[0-9]+/[0-9]+ caught' "$cstat" 2>/dev/null | head -1)"
    cxy="${cxy% caught}"
    if [ -n "$cxy" ]; then
      gates_ran=1
      local cnum="${cxy%%/*}" cden="${cxy##*/}"
      c_seg_p="corpus ${cxy}"
      if [ "${cnum:-0}" -ge "${cden:-0}" ] 2>/dev/null; then c_col="${rG}${c_seg_p}${rR}"; else c_col="${rRED}${c_seg_p}✗${rR}"; c_seg_p="${c_seg_p}✗"; gates_red=1; fi
    fi
  fi
  [ -n "$c_seg_p" ] || { c_seg_p="corpus n/a"; c_col="${rD}${c_seg_p}${rR}"; }
  # stub — verify-edits --json. THREE verdicts, never two:
  #   NON_VERIFIED → the session edit ledger was absent, so nothing was checked.
  #                  Neither a pass nor a failure: "stub?" in warn colour, and it
  #                  CLOSES the Bifröst. Keyed on the VERDICT alone, so it stays
  #                  correct no matter what the payload's `warnings` field says.
  #   FAIL, or warnings>0 → verification ran and found a real problem: "stub✗", red.
  #   anything else       → verification ran and the edits check out: "stub✓", green.
  # "stub n/a" (dim) marks a DIFFERENT unverified mode: no verdict was obtained at
  # all — verify-edits absent, or its output unreadable. The label distinguishes
  # the mode; the VERDICT is the same as NON_VERIFIED, because both mean the gate
  # was never reached. Fail closed: "we could not run the verifier" must not
  # render as proof. Absent and unparseable are ONE fact and are not split — the
  # only --receipt caller is the SessionEnd hook (a real run); heimdall-demo and
  # heimdall-reel invoke the card WITHOUT --receipt, so no demo renders a Bifröst
  # row and none can be turned CLOSED by this.
  local sgate_json="" sg_src="${HEIMDALL_RECEIPT_STUB_JSON:-}"
  if [ -n "$sg_src" ]; then
    [ -f "$sg_src" ] && sgate_json="$(cat "$sg_src" 2>/dev/null)"
  elif [ -x "$BINDIR/verify-edits" ]; then
    sgate_json="$("$BINDIR/verify-edits" --json 2>/dev/null)"
  fi
  local nf_seg_p="" nf_col="" nf_parsed=""
  if [ -n "$sgate_json" ] && [ -n "$_PY_RCPT" ]; then
    nf_parsed="$(printf '%s' "$sgate_json" | "$_PY_RCPT" -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
print("%s %s"%(d.get("warnings",-1), d.get("verdict","")))
' 2>/dev/null)"
  fi
  if [ -n "$nf_parsed" ]; then
    local nf_warn="${nf_parsed%% *}" nf_verd="${nf_parsed##* }"
    if [ "$nf_verd" = "NON_VERIFIED" ]; then
      # Deliberately does NOT set gates_ran: this gate did not run.
      nf_seg_p="stub?"; nf_col="${rW}${nf_seg_p}${rR}"; gates_unverified=1
    else
      gates_ran=1
      if [ "$nf_verd" = "FAIL" ] || { [ "${nf_warn:-0}" -gt 0 ] 2>/dev/null; }; then
        nf_seg_p="stub✗"; nf_col="${rRED}${nf_seg_p}${rR}"; gates_red=1
      else
        nf_seg_p="stub✓"; nf_col="${rG}${nf_seg_p}${rR}"
      fi
    fi
  else
    # No verdict obtained → the gate did not run. Same standing as NON_VERIFIED.
    nf_seg_p="stub n/a"; nf_col="${rD}${nf_seg_p}${rR}"; gates_unverified=1
  fi
  local gates_plain="${f_seg_p} · ${c_seg_p} · ${nf_seg_p}"
  local gates_col="${f_col}${rD} · ${rR}${c_col}${rD} · ${rR}${nf_col}"

  # ══ ROW 4 · BIFRÖST — open only when every gate RAN and every one is green ══
  # Precedence: RED beats UNVERIFIED beats OPEN. Both closed states hold the run
  # back, but the copy says WHICH — "is red" (we checked, it's broken) is a
  # different fact from "could not verify" (we never got to check).
  local bi_plain bi_col bi_why
  if [ "$gates_red" = 1 ]; then
    bi_plain="✗ CLOSED — a gate is red, held back"
    bi_col="${rRED}${rB}✗ CLOSED${rR}${rRED} — a gate is red, held back${rR}"
  elif [ "$gates_unverified" = 1 ] || [ "$gates_ran" != 1 ]; then
    # The `gates_ran != 1` half is an invariant guard on the OPEN branch below:
    # a run in which not one gate ran is not "clean", it is unverified, and must
    # never fall through to OPEN. No current input reaches it — the stub gate is
    # unconditional and always sets gates_ran or gates_unverified — so it is
    # defence in depth, not a covered behaviour. It is a branch CONDITION rather
    # than a bare statement so the OPEN case is protected by construction.
    gates_unverified=1
    # Keep the distinction the old "no gates ran" copy carried: one gate of
    # several being unreachable is a different fact from none running at all.
    if [ "$gates_ran" = 1 ]; then bi_why="a gate could not verify"
    else                          bi_why="no gate could verify"; fi
    bi_plain="✗ CLOSED — ${bi_why}"
    bi_col="${rW}${rB}✗ CLOSED${rR}${rW} — ${bi_why}${rR}"
  else
    bi_plain="✓ OPEN — nothing shipped unproven"
    bi_col="${rG}${rB}✓ OPEN${rR}${rG} — nothing shipped unproven${rR}"
  fi

  # ══ ROW 5 · LEANER — LOC ladder delta (ponytail A/B) · reuse score ══
  local pony="${HEIMDALL_RECEIPT_PONYTAIL:-}"
  if [ -z "$pony" ]; then
    local pd="$ROOT/evals/ponytail-ab"
    if [ -d "$pd" ]; then
      pony="$(ls -t "$pd"/*.jsonl 2>/dev/null | grep -v 'schema.sample' | head -1)"
    fi
  fi
  local loc_seg=""
  if [ -n "$pony" ] && [ -f "$pony" ] && [ -n "$_PY_RCPT" ]; then
    local pct; pct="$("$_PY_RCPT" -c '
import json,sys
on=[];off=[]
for line in open(sys.argv[1]):
    line=line.strip()
    if not line: continue
    try: o=json.loads(line)
    except Exception: continue
    l=o.get("loc")
    if not isinstance(l,(int,float)): continue
    m=o.get("mode")
    (on if m=="on" else off if m=="off" else []).append(l)
if on and off:
    mon=sum(on)/len(on); moff=sum(off)/len(off)
    if moff>0: print("%d"%round((moff-mon)/moff*100)); sys.exit(0)
print("NA")
' "$pony" 2>/dev/null)"
    if [ -n "$pct" ] && [ "$pct" != "NA" ]; then
      if [ "$pct" -gt 0 ] 2>/dev/null; then loc_seg="−${pct}% LOC (ladder on)"
      elif [ "$pct" -lt 0 ] 2>/dev/null; then loc_seg="+$(( -pct ))% LOC (ladder on)"
      else loc_seg="±0% LOC (ladder on)"; fi
    fi
  fi
  local reuse_dir="${HEIMDALL_RECEIPT_REUSE_DIR:-$PROJECT/.planning/reuse}"
  local reuse_seg=""
  if [ -d "$reuse_dir" ] && [ -n "$_PY_RCPT" ]; then
    local rnew; rnew="$(ls -t "$reuse_dir"/*.json 2>/dev/null | head -1)"
    if [ -n "$rnew" ]; then
      local rp; rp="$("$_PY_RCPT" -c '
import json,sys
try: v=json.load(open(sys.argv[1])).get("reuse_pct")
except Exception: v=None
print(("%g"%v) if isinstance(v,(int,float)) else "NA")
' "$rnew" 2>/dev/null)"
      if [ -n "$rp" ] && [ "$rp" != "NA" ]; then reuse_seg="reuse ${rp}"; fi
    fi
  fi
  local lean_plain lean_col
  if [ -n "$loc_seg" ] && [ -n "$reuse_seg" ]; then
    lean_plain="${loc_seg} · ${reuse_seg}"
    lean_col="${rG}${loc_seg}${rR}${rD} · ${rR}${rC}${reuse_seg}${rR}"
  elif [ -n "$loc_seg" ]; then
    lean_plain="$loc_seg"; lean_col="${rG}${loc_seg}${rR}"
  elif [ -n "$reuse_seg" ]; then
    lean_plain="$reuse_seg"; lean_col="${rC}${reuse_seg}${rR}"
  else
    lean_plain="n/a"; lean_col="${rD}n/a${rR}"
  fi

  # ══ ROW 6 · COST — real tokens · HONEST vs-raw-CC (holdout: measured|est.|—) ══
  local tok="${HEIMDALL_RECEIPT_TOKENS:-$ST_TOTAL}" tokdisp
  if [ -z "$tok" ] || [ "$tok" = "-" ]; then
    tokdisp="—"
  else
    tokdisp="$(fmt_tokens "$tok" | sed 's/\.0k/k/; s/\.0M/M/')"
  fi
  # vs-raw-CC — SOURCED ONLY from heimdall-holdout figure. A counterfactual with
  # no control sample is NEVER a number: it renders blank (—) or a labeled est.
  local hj="${HEIMDALL_RECEIPT_HOLDOUT_JSON:-}" hjson=""
  if [ -n "$hj" ]; then
    [ -f "$hj" ] && hjson="$(cat "$hj" 2>/dev/null)"
  elif [ -x "$BINDIR/heimdall-holdout" ]; then
    hjson="$("$BINDIR/heimdall-holdout" figure 2>/dev/null)"
  fi
  local cc_src="none" cc_rendered="—"
  if [ -n "$hjson" ] && [ -n "$_PY_RCPT" ]; then
    local hparsed; hparsed="$(printf '%s' "$hjson" | "$_PY_RCPT" -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
print((d.get("cost_source") or "none"))
print(d.get("rendered") or "—")
' 2>/dev/null)"
    if [ -n "$hparsed" ]; then
      cc_src="$(printf '%s' "$hparsed" | sed -n '1p')"
      cc_rendered="$(printf '%s' "$hparsed" | sed -n '2p')"
      [ -n "$cc_rendered" ] || cc_rendered="—"
    fi
  fi
  local cc_slot cc_color
  case "$cc_src" in
    measured)  cc_slot="${cc_rendered} vs raw CC"; cc_color="$rG" ;;
    estimated) cc_slot="${cc_rendered} vs raw CC*"; cc_color="$rW" ;;
    *)         cc_slot="— vs raw CC*"; cc_color="$rD" ;;
  esac
  local cost_plain="${tokdisp} tok · ${cc_slot}"
  local cost_col="${rC}${tokdisp}${rR} ${rD}tok · ${rR}${cc_color}${cc_slot}${rR}"

  # ── box drawing ──
  local title="HEIMDALL RUN RECEIPT"
  local mid=$(( INNER - 2 - ${#title} - 1 - (${#who} + 5) ))
  [ "$mid" -lt 1 ] && mid=1
  local hfill=""; local i; for ((i=0;i<mid;i++)); do hfill="${hfill}═"; done
  local url="runheimdall.dev/proof"
  local ffill_n=$(( INNER - 3 - ${#url} - 1 )); [ "$ffill_n" -lt 1 ] && ffill_n=1
  local ffill=""; for ((i=0;i<ffill_n;i++)); do ffill="${ffill}═"; done

  printf "\n"
  if [ "$rcolor" = 1 ]; then
    printf "%b\n" "${rD}╔═ ${rB}${rP}${title}${rR}${rD} ${hfill} ${rR}${sigil_glyph}${rD} ${who} ═╗${rR}"
  else
    printf "%s\n" "╔═ ${title} ${hfill} ${sigil_mark} ${who} ═╗"
  fi
  rrow "TASK"    "$task_plain"  "$task_col"    "$rD" "$rR"
  rrow "SWARM"   "$swarm_plain" "$swarm_col"   "$rD" "$rR"
  rrow "GATES"   "$gates_plain" "$gates_col"   "$rD" "$rR"
  rrow "BIFRÖST" "$bi_plain"    "$bi_col"      "$rD" "$rR"
  rrow "LEANER"  "$lean_plain"  "$lean_col"    "$rD" "$rR"
  rrow "COST"    "$cost_plain"  "$cost_col"    "$rD" "$rR"
  if [ "$rcolor" = 1 ]; then
    printf "%b\n" "${rD}╚═ ${rC}${url}${rR}${rD} ${ffill}╝${rR}"
  else
    printf "%s\n" "╚═ ${url} ${ffill}╝"
  fi
  printf "\n"

  # Exit status carries the same vocabulary verify-edits uses one layer down, so
  # a scripted caller reads the receipt the way a human reads the Bifröst row:
  #   0 nothing held back · 1 a gate is RED · 2 a gate could NOT be verified.
  # The card always RENDERS (a non-zero here is a verdict, never a crash).
  [ "$gates_red" = 1 ] && return 1
  [ "$gates_unverified" = 1 ] && return 2
  return 0
}

# rrow LABEL PLAIN COLORED DIM RESET — one receipt content row, padded to width.
# Truncates an over-long value (dropping colour to keep the border aligned).
rrow() {
  local label="$1" plain="$2" colored="$3" rD="$4" rR="$5"
  local VW=40
  if [ "${#plain}" -gt "$VW" ]; then
    plain="$(trunc "$plain" "$VW")"; colored="$plain"
  fi
  local pad=$(( VW - ${#plain} )); [ "$pad" -lt 0 ] && pad=0
  local lpad=$(( 7 - ${#label} )); [ "$lpad" -lt 0 ] && lpad=0
  printf "%b\n" "${rD}║${rR} ${rD}${label}$(rsp "$lpad")${rR} ${colored}$(rsp "$pad")${rD}║${rR}"
}

if [ "$MODE" = "receipt" ]; then
  render_receipt
  exit $?
fi

printf "\n"
printf "%b┌%s┐%b\n" "$D" "$(hr "─")" "$R"
title_row "heimdall · run summary"
printf "%b├%s┤%b\n" "$D" "$(hr "─")" "$R"
row "task " "$TASK_T" "${C}${TASK_T}${R}"
row "phase" "$PHASE_T" "${C}${PHASE_T}${R}"
row "waves" "$WAVES" "${G}${WAVES}${R}"
row "commits" "$COMMITS" "${G}${COMMITS}${R}"
printf "%b├%s┤%b\n" "$D" "$(hr "─")" "$R"
row "gates" "$GATES_PLAIN" "$GATES_COLORED"
row "tokens" "$TOKENS_PLAIN" "$TOKENS_COLORED"
# ── Token-ledger row (H-5) — protocol's own measured delta, only when present ──
if [ -n "$LEDGER_LINE" ]; then
  LEDGER_T=$(trunc "$LEDGER_LINE" 44)
  row "ledger" "$LEDGER_T" "${W}${LEDGER_T}${R}"
fi
# ── Bloat row (H-2) — only when a bloat report exists; truncated to fit. ──
if [ -n "$BLOAT_LINE" ]; then
  BLOAT_T=$(trunc "$BLOAT_LINE" 44)
  case "$BLOAT_STATUS" in
    pass)    BLOAT_COLORED="${G}${BLOAT_T}${R}" ;;
    fail)    BLOAT_COLORED="${RED}${BLOAT_T}${R}" ;;
    skipped) BLOAT_COLORED="${D}${BLOAT_T}${R}" ;;
    *)       BLOAT_COLORED="${C}${BLOAT_T}${R}" ;;
  esac
  row "bloat" "$BLOAT_T" "$BLOAT_COLORED"
fi
# ── Reel row (H-5) — the shareable artifact path, only when a reel exists ──
if [ -n "$REEL_LINE" ]; then
  # Show a short relative-ish path (basename under reels/) to fit the box.
  REEL_SHORT="reels/$(basename "$REEL_LINE")"
  REEL_T=$(trunc "$REEL_SHORT" 44)
  row "reel" "$REEL_T" "${P}${REEL_T}${R}"
fi
# ── Autopilot row (H-6) — the maintainer loop heartbeat, only when checkpointed ──
if [ -n "$HEARTBEAT_LINE" ]; then
  HB_T=$(trunc "$HEARTBEAT_LINE" 44)
  row "autopilot" "$HB_T" "${C}${HB_T}${R}"
fi
printf "%b└%s┘%b\n" "$D" "$(hr "─")" "$R"
printf "\n"
