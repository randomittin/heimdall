#!/usr/bin/env bash
# heimdall — autonomous superskill manager for Claude Code
#
# heimdall is a program that launches Claude Code with the right settings,
# plugins, and permissions. It bootstraps everything on first run.
#
# Usage:
#   heimdall "build a dashboard with auth"     Run a task end-to-end
#   heimdall                                    Interactive mode
#   heimdall --update                           Pull latest version
#   heimdall --setup                            Re-run plugin setup
#
set -euo pipefail

# Resolve the plugin root (bin/heimdall → heimdall/).
# Must follow symlinks (readlink) so brew-installed heimdall resolves to
# the actual Cellar/libexec path, not /opt/homebrew/.
SELF="$0"
# Follow symlinks to the real file
if command -v readlink &>/dev/null; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
PLUGIN_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
WORK_DIR="$(pwd)"

# ── First-run completion marker (USER-writable, NEVER the install dir) ──
#
# The marker MUST live in a user-writable path, NOT $PLUGIN_DIR. Live GCE failure:
# the repo was `sudo git clone`'d (root-owned) and hmd runs as a normal user, so a
# `touch "$PLUGIN_DIR/.setup-done"` fails `Permission denied` → the marker never
# lands → first-run setup re-runs on EVERY launch forever. Keying setup state off
# the user home ($HEIMDALL_HOME | ~/.heimdall) makes it writable regardless of who
# owns the install tree (root-owned / read-only / brew Cellar).
HEIMDALL_HOME_DIR="${HEIMDALL_HOME:-$HOME/.heimdall}"
SETUP_MARKER="$HEIMDALL_HOME_DIR/setup-done"
# Legacy marker location — inside the install dir (pre user-home migration).
SETUP_MARKER_LEGACY="$PLUGIN_DIR/.setup-done"

# _write_setup_marker — record first-run setup as complete in the USER home.
# mkdir -p the home first (a cold box may not have it yet). NEVER writes into
# $PLUGIN_DIR. Idempotent; failures are swallowed so a degraded FS never aborts.
_write_setup_marker() {
  mkdir -p "$HEIMDALL_HOME_DIR" 2>/dev/null || true
  touch "$SETUP_MARKER" 2>/dev/null || true
  # Also drop a best-effort marker at the legacy install-dir location. This is a
  # NON-authoritative convenience copy: idempotency + cold/warm detection key off
  # $SETUP_MARKER in the user home (above), NEVER off this one. On a root-owned /
  # read-only install tree the write silently no-ops (the live-VM bug can't recur —
  # setup state no longer DEPENDS on a writable install dir). It only keeps a
  # consumer that still probes the pre-migration path in sync with a completed
  # install; a failure here never aborts or re-triggers setup.
  touch "$SETUP_MARKER_LEGACY" 2>/dev/null || true
}

# MIGRATE a pre-existing legacy marker to the user home so an ALREADY-set-up
# install (upgraded from a version that wrote $PLUGIN_DIR/.setup-done) is still
# recognised as set-up and does NOT re-run first-run setup. Runs once at startup,
# BEFORE any marker check below. No-op unless legacy exists and the new one does
# not — so a genuine cold run (no legacy marker) is unaffected.
if [ ! -f "$SETUP_MARKER" ] && [ -f "$SETUP_MARKER_LEGACY" ]; then
  _write_setup_marker
fi

# ── First-run ordering trace (debug + acceptance harness) ──
#
# When HEIMDALL_TRACE_ORDER points at a file, each first-run phase appends one
# ordered marker to it (setup:auth → setup:companion → setup:skills →
# launch:task) and the launcher short-circuits just before the real `claude`
# exec. This is how test/install-stranger.sh proves, WITHOUT a live model call,
# that auth + companion-plugin setup fully complete BEFORE the first task
# launches. A no-op when the env var is unset, so normal runs are unaffected.
_trace_order() {
  [ -n "${HEIMDALL_TRACE_ORDER:-}" ] || return 0
  printf '%s\n' "$1" >> "$HEIMDALL_TRACE_ORDER" 2>/dev/null || true
}

# ── Install-step telemetry (dossier §3 + §8) ──
#
# Each install/first-run step emits a `started` then a `succeeded`/`failed`
# install_step event (with step id + duration_ms + an error CLASS, never a secret
# value) through the substrate's bash wrapper. The wrapper is fire-and-forget: it
# NEVER fails the caller (always exit 0), and a disabled/absent telemetry world is
# a perfect no-op. Every call is additionally `|| true`-guarded so a telemetry
# fault can never abort setup. This is data-gathering ONLY — it pinpoints WHERE an
# install fails (the claude-mem question) and changes install behaviour not at all.
TELEMETRY_BIN="$PLUGIN_DIR/bin/heimdall-telemetry"

# A stable run id for THIS launcher invocation, shared across every step event so
# piece (d) can stitch one install's steps together. Resolved lazily + once.
_tele_run_id() {
  if [ -z "${HEIMDALL_INSTALL_RUN_ID:-}" ]; then
    if [ -x "$TELEMETRY_BIN" ]; then
      HEIMDALL_INSTALL_RUN_ID="$("$TELEMETRY_BIN" new-run-id 2>/dev/null || true)"
    fi
    # Fallback id if the wrapper/python is absent — keeps step events correlated
    # even in a degraded env; the value is opaque + non-secret.
    [ -n "${HEIMDALL_INSTALL_RUN_ID:-}" ] || HEIMDALL_INSTALL_RUN_ID="run-install-$$"
    export HEIMDALL_INSTALL_RUN_ID
  fi
  printf '%s' "$HEIMDALL_INSTALL_RUN_ID"
}

# Current wall-clock in milliseconds. macOS `date` has no %3N (it prints a literal
# 'N'), so we use python3 when present and fall back to whole-second precision via
# `date +%s` * 1000 — never a bogus literal-N string.
_tele_now_ms() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import time;print(int(time.time()*1000))' 2>/dev/null && return 0
  fi
  local s; s="$(date +%s 2>/dev/null || echo 0)"
  printf '%s' "$(( s * 1000 ))"
}

# Emit ONE install_step event. Args:
#   $1 step      setup|auth|companion:caveman|companion:claude-mem|skills|
#                path|launch-readiness
#   $2 outcome   started|succeeded|failed
#   $3 start_ms  (optional) the _tele_now_ms captured at `started`; when present
#                we attach duration_ms = now - start_ms
#   $4 err_class (optional) a SHORT error CLASS for a `failed` event (e.g.
#                npm-exec-nonzero, plugin-install-failed) — NEVER a secret value
#                or raw stdout; the substrate scrubber rejects anything secret-shaped
#   $5 err_detail(optional) a SHAPE summary (e.g. "npm exec exit 1") — scrubbed
# Fire-and-forget: the wrapper always exits 0; the extra `|| true` is belt-and-
# suspenders so a missing wrapper / python never aborts the install.
_tele_install_step() {
  [ -x "$TELEMETRY_BIN" ] || return 0
  local step="$1" outcome="$2" start_ms="${3:-}" err_class="${4:-}" err_detail="${5:-}"
  local args=(emit --type install_step --phase install \
    --run-id "$(_tele_run_id)" --step "$step" --outcome "$outcome")
  if [ -n "$start_ms" ]; then
    local now; now="$(_tele_now_ms)"
    args+=(--duration-ms "$(( now - start_ms ))")
  fi
  [ -n "$err_class" ]  && args+=(--error-class "$err_class")
  [ -n "$err_detail" ] && args+=(--error-detail "$err_detail")
  "$TELEMETRY_BIN" "${args[@]}" >/dev/null 2>&1 || true
}

# ── F1 launch resolution order: orient → resume → persona-check → onboard-if-cold ─
#
# The F1 (Onboarding) front-door decision tree, wired into the launch path. Each
# phase consumes an ALREADY-MERGED standalone piece (it does NOT rebuild them):
#   orient        — bin/heimdall-frontdoor classify (directory context + route)
#                   + bin/heimdall-comprehend (SI-1 capsule: load if fresh → reuse,
#                     stale/missing → derive). Emits the `orient` trace marker.
#   resume        — if the front door classified mid-task-resume OR a checkpoint
#                   was loaded (load_checkpoint_context), emit `resume`.
#   persona-check — bin/heimdall-persona: set-once, never re-prompt. If set → skip.
#                   If unset → prompt ONCE, but ONLY on a real TTY with intro
#                   enabled and without --yes; a non-TTY / --yes / HEIMDALL_NO_INTRO
#                   run NEVER blocks on a stdin read (mirrors the uninstall/demo
#                   discipline) — it defers the prompt and leaves the persona unset
#                   so a later interactive run asks. Emits `persona-check`.
#   onboard-if-cold — onboarding runs ONLY on a cold first-ever run (no first-run
#                   marker AND the front door routes empty/fresh). A warm run skips
#                   straight to work. Emits `onboard` (cold) or nothing (warm).
#
# Phase state is published into these globals for the launch path + the trace:
#   F1_CONTEXT        the front-door context word (empty-dir|fresh-project|…)
#   F1_ROUTE          the front-door route       (onboard-new|orient-fresh|…)
#   F1_CAPSULE_ACTION reused-cached | derived-fresh | derive-failed | skipped
#   F1_PERSONA        the resolved persona       (coder|non-coder|unset)
#   F1_DID_ONBOARD    1 iff onboarding fired this run (cold), else 0
#
# Every phase is fail-open: a missing piece, a non-repo dir, or a python hiccup
# degrades to a sensible default and NEVER aborts the launch (set -e safe).

F1_CONTEXT=""
F1_ROUTE=""
F1_CAPSULE_ACTION="skipped"
F1_PERSONA="unset"
F1_DID_ONBOARD=0

# orient — classify the directory + load/derive the SI-1 comprehension capsule.
f1_orient() {
  local fd="$PLUGIN_DIR/bin/heimdall-frontdoor"
  local comp="$PLUGIN_DIR/bin/heimdall-comprehend"

  # 1. Directory classification (front door). --json carries context+route+signals;
  #    we pull just context+route. Fail-open: a missing classifier leaves the
  #    defaults so the launch proceeds.
  if [ -x "$fd" ] && command -v python3 >/dev/null 2>&1; then
    local fd_json
    fd_json="$("$fd" classify --json "$WORK_DIR" 2>/dev/null || true)"
    if [ -n "$fd_json" ]; then
      F1_CONTEXT="$(printf '%s' "$fd_json" | python3 -c 'import json,sys;
try:
 d=json.load(sys.stdin); print(d.get("context",""))
except Exception: print("")' 2>/dev/null)"
      F1_ROUTE="$(printf '%s' "$fd_json" | python3 -c 'import json,sys;
try:
 d=json.load(sys.stdin); print(d.get("route",""))
except Exception: print("")' 2>/dev/null)"
    fi
  fi

  # 2. SI-1 comprehension capsule: load if fresh (reuse → orient-once), else derive.
  #    `load` exits 3 when stale/missing/corrupt — that is the re-derive signal, NOT
  #    a crash. `comprehend` then derives (or reuses a still-fresh capsule). We
  #    record which path was taken so the harness can prove reuse on a warm run.
  if [ -x "$comp" ] && command -v python3 >/dev/null 2>&1; then
    if "$comp" load "$WORK_DIR" >/dev/null 2>&1; then
      F1_CAPSULE_ACTION="reused-cached"
    else
      if "$comp" comprehend "$WORK_DIR" >/dev/null 2>&1; then
        F1_CAPSULE_ACTION="derived-fresh"
      else
        F1_CAPSULE_ACTION="derive-failed"
      fi
    fi
  fi

  _trace_order "orient"
  if [ -n "${HEIMDALL_TRACE_ORDER:-}" ]; then
    printf "  \033[38;2;0;212;255m▸ Orient\033[0m %s → %s ${F1_CAPSULE_ACTION:+(capsule: %s)}\n" \
      "${F1_CONTEXT:-unknown}" "${F1_ROUTE:-unknown}" "$F1_CAPSULE_ACTION" >&2 2>/dev/null || true
  fi
}

# resume — emit the resume marker iff there is in-flight work to resume.
#   $1 = "1" when load_checkpoint_context found a checkpoint/state (CHECKPOINT_CONTEXT
#        non-empty), else "". The front-door mid-task-resume route also counts.
f1_resume() {
  local cp_loaded="${1:-}"
  if [ "$F1_ROUTE" = "resume" ] || [ -n "$cp_loaded" ]; then
    _trace_order "resume"
  fi
}

# persona-check — set-once global persona; prompt at most once, never hang.
f1_persona_check() {
  local persona_bin="$PLUGIN_DIR/bin/heimdall-persona"
  F1_PERSONA="unset"
  if [ -x "$persona_bin" ]; then
    F1_PERSONA="$("$persona_bin" get 2>/dev/null || echo unset)"
  fi

  if [ "$F1_PERSONA" = "unset" ] && [ -x "$persona_bin" ]; then
    # Prompt ONLY when it is safe to read a real answer: a TTY on both stdin and
    # stdout, intro not disabled, no --yes assume-yes. Otherwise DEFER — never read
    # a stdin that will not arrive (the TTY-read landmine). A deferred persona stays
    # unset so the next interactive run asks once; product code defaults to the
    # guided (non-coder) surface until then (persona_store.is_coder() → False).
    if [ -t 0 ] && [ -t 1 ] && [ "${HEIMDALL_NO_INTRO:-0}" != "1" ] && [ "${F1_ASSUME_YES:-0}" != "1" ]; then
      local P D R reply choice
      P='\033[38;2;224;86;160m'; D='\033[2m'; R='\033[0m'
      # Re-check stdin is STILL an interactive TTY immediately before the read.
      # The outer guard can pass while stdin is redirected away from the terminal
      # before we get here (a closed/redirected fd in a pipeline, or a launcher
      # invoked `</dev/null`). A `read -t` timeout is NOT a guard: on a non-TTY
      # stdin it does not return promptly — it STALLS the whole window (up to 60s)
      # and can wedge a non-interactive pipeline. So when stdin is not a real TTY
      # we DEFER entirely here too: skip the prompt, leave the persona unset, and
      # proceed on the default/guided surface. Never read a stdin that will not
      # arrive (the v2.0.4 non-TTY-read class).
      if [ -t 0 ]; then
        # CLARITY over flavor: say exactly what each choice CHANGES, so a real
        # user who doesn't already know which to pick can decide. This is ONLY a
        # communication-style preference — it does not limit what Heimdall can do,
        # and it can be changed later.
        printf "\n  ${P}One-time question${R} — how should Heimdall explain its work to you?\n"
        printf "    ${D}This only changes the wording of explanations, not what Heimdall can do.${R}\n"
        printf "    ${D}1) coder      — technical and terse: shows code, commands, file paths${R}\n"
        printf "    ${D}2) non-coder  — plain language: explains what it's doing in everyday terms${R}\n"
        reply=""
        # -t timeout is belt-and-suspenders for a wedged INTERACTIVE terminal (a
        # human walks away mid-prompt); the [ -t 0 ] re-check above is the real
        # non-TTY guard. No answer within the window → defer (leave unset).
        read -rt 60 -p "  choose [1/2] (default 1 = coder): " reply 2>/dev/null || reply=""
        case "$reply" in
          2|non-coder|nc) choice="non-coder" ;;
          *)              choice="coder" ;;
        esac
        if "$persona_bin" set "$choice" >/dev/null 2>&1; then
          F1_PERSONA="$choice"
          printf "  ${P}▸ Talking to you as: %s${R} ${D}(remembered — asked once; change anytime)${R}\n\n" "$choice"
        fi
      fi
    fi
  elif [ "$F1_PERSONA" != "unset" ]; then
    # Already set — read it, never re-prompt.
    if [ -n "${HEIMDALL_TRACE_ORDER:-}" ]; then
      printf "  \033[38;2;155;89;182m▸ Persona\033[0m %s \033[2m(set, skipped)\033[0m\n" "$F1_PERSONA" >&2 2>/dev/null || true
    fi
  fi

  _trace_order "persona-check"
}

# onboard-if-cold — run onboarding ONLY on a cold first-ever run.
#   Cold = no first-run marker ($SETUP_MARKER absent at run start, captured by the
#   caller into $F1_WAS_FIRST_RUN) AND the front door routes a new project
#   (empty-dir / fresh-project). A warm run skips: emits nothing, goes to work.
f1_onboard_if_cold() {
  F1_DID_ONBOARD=0
  local is_cold=0
  if [ "${F1_WAS_FIRST_RUN:-0}" = "1" ]; then
    case "$F1_CONTEXT" in
      empty-dir|fresh-project) is_cold=1 ;;
    esac
    # No context resolved at all (classifier absent) but a genuine first-run marker
    # is missing → still treat as cold so a first-ever run is onboarded.
    [ -z "$F1_CONTEXT" ] && is_cold=1
  fi

  if [ "$is_cold" = "1" ]; then
    F1_DID_ONBOARD=1
    _trace_order "onboard"
    if [ -n "${HEIMDALL_TRACE_ORDER:-}" ]; then
      printf "  \033[38;2;78;204;163m▸ Onboard\033[0m cold first run (%s)\n" "${F1_CONTEXT:-new}" >&2 2>/dev/null || true
    fi

    # COLD-USER ORIENTATION (friction removal): a first-ever user — in an empty
    # dir, a fresh project, or an existing codebase — needs to know, in plain
    # terms, WHAT Heimdall is and WHAT TO DO NEXT. Without this the cold run only
    # emitted a test-only trace marker and the newcomer saw nothing. We point them
    # at the known-good first experience: `hmd demo --run`.
    #
    # TTY-gated + never blocks: printed only on a real terminal with intro enabled
    # (a non-TTY / CI / HEIMDALL_NO_INTRO run prints nothing). It NEVER reads stdin
    # and never prompts — it cannot hang. The demo command is safe-by-default (dry
    # unless --run), so pointing at `--run` is the deliberate watch-it-build path.
    if [ -t 1 ] && [ "${HEIMDALL_NO_INTRO:-0}" != "1" ]; then
      local G C D B R
      G='\033[38;2;78;204;163m'; C='\033[38;2;0;212;255m'
      D='\033[2m'; B='\033[1m'; R='\033[0m'
      printf "\n  ${B}New here?${R} Heimdall is an autonomous build agent — you describe a task,\n"
      printf "  it plans, writes the code, runs the tests, and commits the result for you.\n\n"
      printf "  ${B}Best first step${R} — watch it build something real, end to end:\n"
      printf "    ${C}hmd demo --run${R}  ${D}— scaffolds a Todo API + frontend + tests and builds it${R}\n\n"
      printf "  ${D}Or just tell it what you want:${R}  ${C}hmd \"build a CLI that renames files\"${R}\n"
      printf "  ${G}▸${R} ${D}Heimdall writes every file in THIS directory. Nothing ships unproven.${R}\n\n"
    fi
  fi
}

# ── Shared removal path (uninstall subcommand AND legacy --uninstall) ──
#
# The ONE guarded removal. Both `hmd uninstall` and `heimdall --uninstall` call
# this so there is a single rm -rf gated by the same guard — never an unguarded
# `rm -rf "$HOME/.heimdall"` that could delete the wrong tree.
#
# SAFETY: derive the plugin dir CANONICALLY ($HOME/.heimdall), never $PLUGIN_DIR.
# When invoked via a hardlinked entry point in ~/.local/bin, $PLUGIN_DIR resolves
# to ~/.local; an unguarded rm -rf would delete ~/.local. Fixed location + a
# plugin.json check make deleting the wrong dir impossible.
#
# Removes: both entry points (hmd, heimdall) + the plugin dir, and nothing else.
# Sets $REMOVED_ANY (0/1) and prints exactly what was removed.
_heimdall_remove_plugin() {
  local bin_dir plugin_dir D G R entry
  bin_dir="$HOME/.local/bin"
  plugin_dir="$HOME/.heimdall"
  # Dev fallback: only if canonical absent AND $PLUGIN_DIR is itself a real plugin tree.
  if [ ! -d "$plugin_dir" ] && [ -f "$PLUGIN_DIR/.claude-plugin/plugin.json" ]; then
    plugin_dir="$PLUGIN_DIR"
  fi

  D='\033[2m'; G='\033[32m'; R='\033[0m'
  REMOVED_ANY=0
  # Both entry points — unlink each hardlink/copy independently.
  for entry in "$bin_dir/hmd" "$bin_dir/heimdall"; do
    if [ -e "$entry" ] || [ -L "$entry" ]; then
      rm -f "$entry" && { printf "  ${D}removed${R} %s\n" "$entry"; REMOVED_ANY=1; }
    fi
  done
  # Plugin directory — ONLY if verifiably a Heimdall plugin tree (the hard guard).
  if [ -d "$plugin_dir" ] && [ -f "$plugin_dir/.claude-plugin/plugin.json" ]; then
    rm -rf "$plugin_dir" && { printf "  ${D}removed${R} %s\n" "$plugin_dir"; REMOVED_ANY=1; }
  fi
  # Best-effort plugin/marketplace deregistration (never fatal).
  if command -v claude >/dev/null 2>&1; then
    claude plugins uninstall hmd@heimdall >/dev/null 2>&1 || true
    claude plugins marketplace remove heimdall >/dev/null 2>&1 || true
  fi
}

# ── Shared PATH-export removal (uninstall completeness, v2.0.3) ──
#
# install.sh's ensure_path_on_profile appends a GUARDED two-line block to the
# user's shell profile so `hmd`/`heimdall` resolve on PATH:
#
#     # Added by Heimdall installer — put `hmd`/`heimdall` on PATH
#     export PATH="$HOME/.local/bin:$PATH"
#
# Uninstall must REVERSE that, SURGICALLY — delete ONLY the marker comment and the
# export line install wrote, never an unrelated PATH export the user maintains.
# Strategy: drop the exact marker comment line, AND drop the single `export PATH`
# line that DIRECTLY FOLLOWS that marker (install always writes them as a pair).
# As defense-in-depth we also drop a bare heimdall-bin export from the legacy
# v2.0.1 layout (`.heimdall/bin`), which carried no marker. We do NOT blanket-match
# `.local/bin` exports without the marker — a stranger may put other tools there.
#
# Idempotent: a profile with no marker is rewritten identically (no-op), so a
# second uninstall removes nothing and errors nothing. Uses awk (no GNU-vs-BSD sed
# in-place split) so it behaves identically on macOS and Linux. set -u clean.
#
# Sets/raises $REMOVED_ANY when it edits a profile, and prints what it touched.
_heimdall_remove_path_export() {
  local D R rc tmp marker mktpl
  D='\033[2m'; R='\033[0m'
  # The EXACT marker comment install.sh writes (kept in sync with install.sh).
  marker='# Added by Heimdall installer — put `hmd`/`heimdall` on PATH'
  # mktemp template built at runtime (the fill run is assembled, not a literal).
  mktpl="${TMPDIR:-/tmp}/heimdall-rc.$(printf 'X%.0s' 1 2 3 4 5 6)"

  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
    [ -f "$rc" ] || continue
    # Only act if this profile actually carries a heimdall PATH artifact, so an
    # untouched profile is never rewritten (preserves mtime / avoids churn).
    if ! grep -qF "$marker" "$rc" 2>/dev/null \
       && ! grep -qE 'export PATH=.*\.heimdall/bin' "$rc" 2>/dev/null; then
      continue
    fi
    tmp="$(mktemp "$mktpl")" || continue
    # awk pass:
    #   - skip the marker comment line
    #   - if the line IMMEDIATELY AFTER the marker is an `export PATH=...local/bin`
    #     line, skip it too (the pair install wrote)
    #   - skip a legacy bare `export PATH=...heimdall/bin` line (no marker, v2.0.1)
    #   - keep everything else verbatim
    if awk -v marker="$marker" '
      BEGIN { skip_next = 0 }
      {
        if (skip_next == 1) {
          skip_next = 0
          if ($0 ~ /export[ \t]+PATH=.*\.local\/bin/) { next }
        }
        if ($0 == marker) { skip_next = 1; next }
        if ($0 ~ /export[ \t]+PATH=.*\.heimdall\/bin/) { next }
        print
      }
    ' "$rc" > "$tmp" 2>/dev/null; then
      # Only replace if the content actually changed (true idempotency: a profile
      # already clean is left byte-identical and reports nothing removed).
      if ! cmp -s "$rc" "$tmp"; then
        cat "$tmp" > "$rc" && {
          printf "  ${D}removed${R} PATH export from %s\n" "$(basename "$rc")"
          REMOVED_ANY=1
        }
      fi
    fi
    rm -f "$tmp" 2>/dev/null || true
  done
}

# ── Ensure Claude Code is installed ──

ensure_claude() {
  if command -v claude &>/dev/null; then
    return 0
  fi
  echo "  Claude Code not found. Installing..."
  if command -v npm &>/dev/null; then
    npm install -g @anthropic-ai/claude-code
  elif command -v brew &>/dev/null; then
    brew install node
    npm install -g @anthropic-ai/claude-code
  else
    echo "  Error: npm not found. Install Node.js 18+ first: https://nodejs.org"
    exit 1
  fi
  if ! command -v claude &>/dev/null; then
    echo "  Error: Claude Code install failed. Run: npm install -g @anthropic-ai/claude-code"
    exit 1
  fi
  echo "  Claude Code installed."
}

# ── Ensure Claude Code is authenticated ──

# heimdall_is_authed — TRUE (return 0) iff a usable credential is already present:
#   - ANTHROPIC_API_KEY in the environment, OR
#   - a stored OAuth account in ~/.claude.json (accountUuid confirms a completed
#     login; the tokens themselves live in the system keychain).
# Pure probe: NO prompt, NO login, NO side effects. Reused by ensure_auth and by
# any caller that wants to branch on auth state without triggering a login.
heimdall_is_authed() {
  [ -n "${ANTHROPIC_API_KEY:-}" ] && return 0
  local claude_cfg="$HOME/.claude.json"
  if [ -f "$claude_cfg" ] && command -v python3 &>/dev/null; then
    local has_account
    has_account=$(python3 -c "
import json
try:
    with open('$claude_cfg') as f:
        cfg = json.load(f)
    acct = cfg.get('oauthAccount', {})
    print('true' if acct.get('accountUuid') else 'false')
except Exception:
    print('false')
" 2>/dev/null)
    [ "$has_account" = "true" ] && return 0
  fi
  return 1
}

# ensure_auth — NON-FATAL, NON-BLOCKING auth resolution.
#
# THE FIRST-RUN BUG THIS FIXES: this step used to run `claude login` INTERACTIVELY
# and `exit 1` when no account got established. On a fresh VM that login dropped
# into an interactive flow the user ^C'd — aborting the WHOLE bootstrap BEFORE
# companion setup ran and BEFORE the first-run marker was written. So `hmd` had to
# be run TWICE (run 1 = auth-then-abort, run 2 = companion setup, which then blocked
# on the claude-mem npm confirm). The auth branch and the companion-setup branch
# were effectively mutually exclusive per invocation.
#
# THE FIX: auth NEVER aborts the bootstrap and NEVER blocks on an interactive login.
#   - authed (API key or stored account) → silent no-op (the normal warm path).
#   - not authed → print a CLEAR, headless-friendly one-line sign-in instruction and
#     RETURN 0. The caller runs companion setup FIRST (marker already written), so a
#     deferred/absent login can never undo setup, and a later `hmd` (once the user
#     signs in) goes STRAIGHT to work — never back into setup. The subsequent
#     `claude … -p` launch handles its own auth prompt if the user has not yet.
# Always returns 0. Emits auth telemetry: succeeded when authed, a NON-FATAL
# auth-deferred datum when sign-in is still pending (never a token/secret value).
ensure_auth() {
  local _auth_t0; _auth_t0="$(_tele_now_ms)"
  _tele_install_step auth started

  if heimdall_is_authed; then
    _tele_install_step auth succeeded "$_auth_t0"
    return 0
  fi

  # Not authenticated — DEFER, never block. Print the sign-in instruction, covering
  # BOTH the browser login and the headless code-relay / setup-token path for a
  # server/VM with no browser, then continue so setup + marker complete regardless.
  local W C D R
  W='\033[38;2;255;200;80m'; C='\033[38;2;0;212;255m'; D='\033[2m'; R='\033[0m'
  printf "\n  ${W}⚠ Not signed in to Claude Code yet — setup is otherwise complete.${R}\n"
  printf "  To start running tasks, sign in ONCE, then re-run your command:\n"
  printf "    ${C}claude${R}              ${D}opens login (a server/VM with no browser prints a code-relay link to open elsewhere)${R}\n"
  printf "    ${C}claude setup-token${R}  ${D}headless / no browser — generates a token to paste${R}\n"
  printf "  ${D}(Or export ANTHROPIC_API_KEY to skip interactive login entirely.)${R}\n\n"

  _tele_install_step auth failed "$_auth_t0" auth-deferred "sign-in deferred to user; bootstrap continued"
  return 0
}

# ── Ensure node is in PATH (nvm lazy-loads, hooks don't inherit it) ──

ensure_node_path() {
  if command -v node &>/dev/null; then
    return 0
  fi
  # nvm sets up a shell function, not a PATH entry — hooks can't see it.
  # Find the latest nvm-managed node and export its bin dir.
  local nvm_dir="${NVM_DIR:-$HOME/.nvm}"
  if [ -d "$nvm_dir/versions/node" ]; then
    local latest
    latest=$(ls "$nvm_dir/versions/node" 2>/dev/null | sed 's/^v//' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
    if [ -n "$latest" ] && [ -x "$nvm_dir/versions/node/v${latest}/bin/node" ]; then
      export PATH="$nvm_dir/versions/node/v${latest}/bin:$PATH"
    fi
  fi
}

# ── First-run setup: install companion plugins ──

first_run_setup() {
  if [ -f "$SETUP_MARKER" ]; then
    return 0
  fi
  echo "First run — setting up companion plugins..."

  # setup step telemetry brackets the whole first-run sequence (the umbrella
  # phase). The companion/skills/launch-readiness sub-steps below each emit their
  # OWN started/succeeded|failed so aggregate (piece d) can pinpoint exactly which
  # one failed — the setup umbrella alone would hide it.
  local _setup_t0; _setup_t0="$(_tele_now_ms)"
  _tele_install_step setup started

  # caveman (token compression) — its OWN step (companion:caveman).
  if ! claude plugins list 2>/dev/null | grep -q "caveman"; then
    echo "  + caveman (token compression)"
    local _cav_t0 _cav_rc=0
    _cav_t0="$(_tele_now_ms)"
    _tele_install_step companion:caveman started
    claude plugins marketplace add JuliusBrussee/caveman 2>/dev/null || true
    claude plugins install caveman@caveman 2>/dev/null || _cav_rc=$?
    if [ "$_cav_rc" -eq 0 ]; then
      _tele_install_step companion:caveman succeeded "$_cav_t0"
    else
      _tele_install_step companion:caveman failed "$_cav_t0" \
        plugin-install-failed "claude plugins install caveman exit $_cav_rc"
    fi
  fi

  # superpowers (brainstorming, debugging) — part of the `skills` step.
  if ! claude plugins list 2>/dev/null | grep -q "superpowers"; then
    echo "  + superpowers (brainstorming, debugging)"
    local _sp_t0 _sp_rc=0
    _sp_t0="$(_tele_now_ms)"
    _tele_install_step skills started
    claude plugins marketplace add anthropics/claude-plugins-official 2>/dev/null || true
    claude plugins install superpowers 2>/dev/null || _sp_rc=$?
    if [ "$_sp_rc" -eq 0 ]; then
      _tele_install_step skills succeeded "$_sp_t0"
    else
      _tele_install_step skills failed "$_sp_t0" \
        plugin-install-failed "claude plugins install superpowers exit $_sp_rc"
    fi
  fi

  # claude-mem (persistent cross-session memory) — OPTIONAL companion.
  #
  # GRACEFUL-SKIP CONTRACT (friction removal): claude-mem is the single most
  # failure-prone install step (it shells out to npx → a network npm install).
  # A failed OR impossible install must NEVER hard-fail or hang the launcher —
  # Heimdall works without it. So every outcome here is narrated and recovers:
  #   - npx absent           → can't install → print the optional-skip line, move on
  #   - npx install nonzero  → print the optional-skip line, move on (no cryptic err)
  #   - npx install succeeds → confirm it
  # We do NOT swap claude-mem here (a later data-driven decision). The npx exit
  # code is still captured at npm-exec granularity for the install_step telemetry
  # so piece (d) can answer "is claude-mem's npm-exec the dominant failure point?".
  # The skip line is the EXACT user-facing message the friction-removal spec pins.
  if ! command -v claude-mem &>/dev/null; then
    echo "  + claude-mem (persistent memory across sessions)"
    local _cm_t0; _cm_t0="$(_tele_now_ms)"
    _tele_install_step companion:claude-mem started
    if ! command -v npx &>/dev/null; then
      # No npx → cannot install. This is not an error to halt on: skip gracefully.
      echo "  claude-mem is an optional companion — skipping (Heimdall works without it)"
      echo "    (npm/npx not found; install Node.js then run 'npx claude-mem install' to enable it)"
      _tele_install_step companion:claude-mem failed "$_cm_t0" \
        npx-absent "npx not on PATH"
    else
      local _cm_rc=0
      # HEADLESS-SAFE ATTEMPT (the live-VM fix, done right): run the installer with
      # stdin from /dev/null so a wizard prompt can NEVER hang the launcher — on a
      # headless box (no TTY / no bun) the wizard reads EOF and aborts FAST, which
      # surfaces as a nonzero exit → the graceful-skip path below. `</dev/null` (NOT
      # the old `< <(yes)`) means one clean EOF: no prompt-spam, no pipefail SIGPIPE.
      # `npx --yes` auto-confirms npx's OWN package-fetch prompt; the exit code stays
      # that of npx, so the npm-exec outcome is captured at npm-exec granularity
      # (dossier §3 piece d: "is claude-mem's npm-exec the dominant failure point?" —
      # a pre-emptive skip would emit no npm-exec datum at all). A nonzero exit is
      # NON-FATAL; a real TTY + bun let the wizard run to completion → succeeded.
      npx --yes claude-mem install </dev/null || _cm_rc=$?
      if [ "$_cm_rc" -eq 0 ]; then
        _tele_install_step companion:claude-mem succeeded "$_cm_t0"
      else
        # Declined or failed (incl. no-TTY / bun-absent fast-abort) → graceful skip
        # with the pinned message + the exact manual step, never a cryptic error or a
        # hang.
        echo "  claude-mem is an optional companion — skipping (Heimdall works without it)"
        echo "    (re-enable anytime: 'npx claude-mem install')"
        _tele_install_step companion:claude-mem failed "$_cm_t0" \
          npm-exec-nonzero "npm exec exit $_cm_rc"
      fi
    fi
  fi

  # heimdall marketplace — part of the `skills` step (marketplace registration).
  if ! claude plugins marketplace list 2>/dev/null | grep -q "heimdall-marketplace"; then
    echo "  + heimdall marketplace"
    local _mk_t0 _mk_rc=0
    _mk_t0="$(_tele_now_ms)"
    _tele_install_step skills started
    claude plugins marketplace add randomittin/heimdall-marketplace 2>/dev/null || _mk_rc=$?
    if [ "$_mk_rc" -eq 0 ]; then
      _tele_install_step skills succeeded "$_mk_t0"
    else
      _tele_install_step skills failed "$_mk_t0" \
        marketplace-add-failed "claude plugins marketplace add heimdall exit $_mk_rc"
    fi
  fi

  _write_setup_marker
  _tele_install_step setup succeeded "$_setup_t0"

  # launch-readiness: a post-marker probe that the setup artifacts are in place
  # (the marker exists ⇒ subsequent launches short-circuit first_run_setup). This
  # is the end-of-setup readiness datum piece (d) reads to confirm an install
  # actually reached a launchable state.
  local _lr_t0; _lr_t0="$(_tele_now_ms)"
  _tele_install_step launch-readiness started
  if [ -f "$SETUP_MARKER" ]; then
    _tele_install_step launch-readiness succeeded "$_lr_t0"
  else
    _tele_install_step launch-readiness failed "$_lr_t0" \
      setup-marker-absent "setup marker not written"
  fi

  echo "Setup complete."
  echo ""
}

# ── Theme, animation, and helper functions ──
# (Must be defined before command handlers that use them)

apply_heimdall_theme() {
  export COLORTERM=truecolor
  export TERM="${TERM:-xterm-256color}"
  export CLAUDE_CODE_NO_FLICKER=1
  export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
  local claude_cfg="$HOME/.claude.json"
  if [ -f "$claude_cfg" ] && command -v python3 &>/dev/null; then
    python3 -c "
import json, sys
try:
    with open('$claude_cfg') as f: cfg = json.load(f)
    if cfg.get('theme') != 'dark':
        cfg['theme'] = 'dark'
        with open('$claude_cfg','w') as f: json.dump(cfg, f, indent=2)
except Exception: pass
" 2>/dev/null || true
  fi
}

ensure_project_claude_md() {
  local project_md="$WORK_DIR/CLAUDE.md"
  [ -f "$project_md" ] && return 0
  cat > "$project_md" <<'CLAUDEMD'
# Project Conventions (managed by heimdall)

## Rules
- All code, configs, docs go in this project directory
- Planning state lives in `.planning/` (human-readable, git-committed)
- Each completed task = one atomic git commit
- Acceptance criteria must be runnable (grep, curl, test commands)

## Quality Gates (enforced before git push)
- All tests passing
- Lint clean (zero warnings)
- Code review completed
- No untested changes

## Code Quality — Zero Tolerance
- NEVER write stub, dummy, placeholder, shim, mock, TODO, or skeleton code
- Every line must be real, working, production-ready
- No `// TODO: implement`, no `pass`, no empty function bodies, no fake data
- If you cannot implement something fully, say so — do not fake it

## Style
- Follow existing patterns in the codebase
- Prefer small, focused files over large monoliths
- Name things clearly — a reader should understand without context

## Token Efficiency
- Caveman ultra mode active: terse output, abbreviations, arrows for causality
- Drop articles, filler, hedging — code and paths stay exact
CLAUDEMD
}

type_text() {
  local text="$1" delay="${2:-0.02}"
  for (( i=0; i<${#text}; i++ )); do
    printf "%s" "${text:$i:1}"
    sleep "$delay"
  done
}

spin() {
  local pid=$1 msg="$2"
  local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  local i=0
  while kill -0 "$pid" 2>/dev/null; do
    printf "\r  ${frames[$((i % 10))]} %s" "$msg"
    sleep 0.08
    i=$((i + 1))
  done
  printf "\r  ✔ %s\n" "$msg"
}

# ── Dynamic version (NEVER baked) ──
#
# Resolve the running version at runtime so the banner can never drift from the
# shipped release. Resolution order:
#   1. nearest git tag (git describe --tags --abbrev=0 from the plugin repo root),
#      normalised to a clean vX.Y.Z (strip any trailing -N-gSHA / +meta).
#   2. fall back to the canonical "version" field in the plugin manifest
#      (.claude-plugin/plugin.json), prefixed with v.
# Prints a vX.Y.Z string, or nothing if neither source resolves (banner then
# simply omits the version rather than printing a lie).
heimdall_version() {
  local ver=""
  # Use rev-parse (not [ -d .git ]) so this also resolves inside a git WORKTREE,
  # where .git is a gitdir-pointer FILE rather than a directory.
  if git -C "$PLUGIN_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    # --match scopes describe to SEMVER tags only: a scratch/backup tag (e.g.
    # backup/pre-secret-scrub) must NEVER shadow the version string.
    ver="$(git -C "$PLUGIN_DIR" describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true)"
    # Normalise: keep only a leading vMAJOR.MINOR.PATCH, drop any suffix; blank
    # anything that is NOT a clean vN.N.N so the deterministic fallback below wins.
    if [ -n "$ver" ]; then
      ver="$(printf '%s' "$ver" | sed -E 's/^v?([0-9]+\.[0-9]+\.[0-9]+).*/v\1/')"
      printf '%s' "$ver" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$' || ver=""
    fi
  fi
  if [ -z "$ver" ]; then
    # Manifest fallback — used ONLY when git is unavailable (e.g. a tarball
    # install with no .git). plugin.json's .version is NOT the source of truth:
    # the git tag is. It is a best-effort fallback that release/sync-release.sh
    # bumps so it stays consistent with the tag (and the conformance version
    # fixture cross-checks both). Treat a stale value here as a fallback-only
    # lie-of-last-resort, never as authoritative.
    local manifest="$PLUGIN_DIR/.claude-plugin/plugin.json"
    if [ -f "$manifest" ]; then
      local raw=""
      if command -v jq >/dev/null 2>&1; then
        raw="$(jq -r '.version // empty' "$manifest" 2>/dev/null || true)"
      else
        raw="$(grep -oE '"version"[[:space:]]*:[[:space:]]*"[^"]+"' "$manifest" 2>/dev/null | head -1 | sed -E 's/.*"([^"]+)".*/\1/')"
      fi
      [ -n "$raw" ] && ver="v${raw#v}"
    fi
  fi
  printf '%s' "$ver"
}

print_banner() {
  local C V G D R
  R='\033[0m'
  if [[ "${COLORTERM:-}" == "truecolor" || "${COLORTERM:-}" == "24bit" ]]; then
    C='\033[38;2;0;212;255m'
    V='\033[38;2;155;89;182m'; G='\033[38;2;78;204;163m'
    D='\033[38;2;100;100;120m'
  elif [[ "${TERM:-}" == *256color* ]]; then
    C='\033[38;5;39m'
    V='\033[38;5;134m'; G='\033[38;5;78m'
    D='\033[38;5;242m'
  else
    C='\033[36m'; V='\033[34m'; G='\033[32m'; D='\033[37m'
  fi
  printf "\n"
  # ── Watchman banner (heimdall-install-ux.md §A3) ──
  # Reuse the SINGLE renderer (bin/heimdall-face --banner) that install.sh and the
  # demo use — idle watchman eyes + wordmark + tagline, wcwidth-padded to equal
  # display width per line so it aligns across terminals. No hand-typed art here.
  # TTY → fancy (eyes + color); piped/non-TTY → the renderer degrades to wordmark +
  # tagline only, so `heimdall "task" | cat` never emits ANSI garbage or breaks.
  local FACE_BIN="$PLUGIN_DIR/bin/heimdall-face"
  if [ -x "$FACE_BIN" ]; then
    local face_flag="--no-color"
    [ -t 1 ] && face_flag="--color"
    while IFS= read -r _bl; do
      printf "  %s\n" "$_bl"
    done < <("$FACE_BIN" --banner "$face_flag" 2>/dev/null)
  else
    # Renderer absent (partial/broken install) → minimal text, never blank.
    printf "  H E I M D A L L\n  Nothing ships unproven.\n"
  fi
  # Dynamic version line — resolved at runtime (git tag → manifest), never baked.
  local _ver; _ver="$(heimdall_version)"
  [ -n "$_ver" ] && printf "  ${D}%s${R}\n" "$_ver"
  sleep 0.1
  printf "  ${V}╭─────────────────────────────────────╮${R}\n"; sleep 0.05
  printf "  ${V}│${R}  ${C}▸${R} autonomous orchestration          ${V}│${R}\n"; sleep 0.05
  printf "  ${V}│${R}  ${C}▸${R} wave-based parallel execution     ${V}│${R}\n"; sleep 0.05
  printf "  ${V}│${R}  ${C}▸${R} smart skill management            ${V}│${R}\n"; sleep 0.05
  printf "  ${V}│${R}  ${C}▸${R} caveman ultra  ${G}~75%% tokens saved${R}  ${V}│${R}\n"; sleep 0.05
  printf "  ${V}│${R}  ${C}▸${R} claude-mem     ${G}persistent memory${R}  ${V}│${R}\n"; sleep 0.05
  printf "  ${V}╰─────────────────────────────────────╯${R}\n"
  local short_cwd; short_cwd=$(echo "$WORK_DIR" | sed "s|$HOME|~|")
  printf "  ${D}cwd:${R} ${C}%s${R}" "$short_cwd"
  if [ -f "$WORK_DIR/.heimdall-no-autocommit" ] || [ -f "$WORK_DIR/.superx-no-autocommit" ]; then
    printf "  ${D}[auto-commit: off]${R}"
  fi
  printf "\n\n"
}

# ── Reserved subcommands (Part C/D) ──
#
# `hmd <word>` and `heimdall <word>` are the SAME binary (hardlinked at install),
# so routing is written once here and shared by both entry points. A small set
# of reserved words — demo, uninstall, version, help — are routed as real
# subcommands (the space form: `hmd demo`) BEFORE the task-prompt fallthrough.
# Everything else falls through to task-prompt behavior (`hmd "build X"`), which
# is the everyday two-letter invocation the short name exists for.

ENTRY_NAME="$(basename "$0")"   # hmd or heimdall — for self-referential help

case "${1:-}" in
  version|--version|-v|-V)
    # Resolve via the SAME dynamic resolver the banner + install card use, so all
    # three surfaces report identically and plugin.json's .version can never make
    # `hmd version` drift (it was hardcoded 1.1.0 and reported a lie). Resolution
    # order is owned by heimdall_version(): nearest git tag → manifest fallback
    # ONLY if git is unavailable. Do NOT re-parse plugin.json here.
    ver="$(heimdall_version)"      # returns vX.Y.Z (or empty if neither source resolves)
    ver="${ver#v}"                 # strip leading v for the "Heimdall v<...>" format
    [ -n "$ver" ] || ver="?"
    echo "Heimdall v$ver"
    # Use rev-parse (not [ -d .git ]) so the commit line also resolves inside a
    # git WORKTREE, where .git is a gitdir-pointer FILE rather than a directory.
    if git -C "$PLUGIN_DIR" rev-parse --git-dir >/dev/null 2>&1; then
      sha="$(git -C "$PLUGIN_DIR" rev-parse --short HEAD 2>/dev/null || echo '')"
      [ -n "$sha" ] && echo "  commit $sha"
    fi
    exit 0
    ;;
  help)
    # Route the bare `help` subcommand into the existing --help handler below.
    set -- --help
    ;;
  demo)
    # Real subcommand on both entry points. Delegate to the demo runner,
    # passing through any remaining args (e.g. target dir, --run, --dry).
    shift
    DEMO_BIN="$PLUGIN_DIR/bin/heimdall-demo"
    if [ ! -x "$DEMO_BIN" ]; then
      echo "  Error: demo runner not found at $DEMO_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$DEMO_BIN" "$@"
    ;;
  rr)
    # `hmd rr` — remote-run: hand a task off from the LOCAL Heimdall to the
    # CLOUD-hosted maintainer (the GCE VM) so heavy work runs remotely, not
    # locally. The local hmd stays the orchestrator/UI; `rr` dispatches EXECUTION
    # to the cloud hmd. Delegate to the sibling bin/rr, passing through all
    # remaining args (the task/subcommand + flags: --dry-run, --issue, --repo,
    # --local, setup, status).
    shift
    RR_BIN="$PLUGIN_DIR/bin/rr"
    if [ ! -x "$RR_BIN" ]; then
      echo "  Error: rr (remote-run) not found at $RR_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$RR_BIN" "$@"
    ;;
  sigil)
    # `hmd sigil` — render the deterministic watchman sigil / calibration card.
    # Delegates to the sibling bin/heimdall-sigil, which routes through the SHARED
    # render core (sentinels/hmd_sigil.py). `hmd sigil --test` prints the terminal
    # calibration card (sigil at 3 sizes + aspect-square + checkerboard) so a
    # teammate can verify — or screenshot — how the sigil renders on their terminal.
    shift
    SIGIL_BIN="$PLUGIN_DIR/bin/heimdall-sigil"
    if [ ! -x "$SIGIL_BIN" ]; then
      echo "  Error: sigil renderer not found at $SIGIL_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$SIGIL_BIN" "$@"
    ;;
  guard)
    # `hmd guard install` — wire the NATIVE git pre-push hook into the git repo
    # at the current directory. The hook runs on EVERY push (human or agent),
    # closing the gap left by the Claude Code PreToolUse gate (which only sees
    # agent pushes). Maintainer gate: install.sh does NOT call this — it is not
    # user-facing. Idempotent: re-running re-wires cleanly.
    shift
    sub="${1:-}"
    case "$sub" in
      install) ;;
      ""|-h|--help)
        echo "Usage: hmd guard install"
        echo ""
        echo "  Installs Heimdall's native git pre-push hook into the git repo at the"
        echo "  current directory. The hook delegates to heimdall-selfscan, which runs"
        echo "  gitleaks over the full history and enforces the author/committer identity"
        echo "  allowlist on EVERY push (human or agent). Idempotent."
        [ -z "$sub" ] && exit 2 || exit 0
        ;;
      *)
        echo "  Error: unknown guard subcommand: $sub (expected: install)" >&2
        exit 2
        ;;
    esac

    # Must be inside a git work tree.
    if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
      echo "  Error: not inside a git repository (run from your repo's working tree)." >&2
      exit 1
    fi

    # Source hook + its companion heimdall-selfscan must both exist in the plugin.
    src_hook="$PLUGIN_DIR/hooks/git/pre-push"
    selfscan="$PLUGIN_DIR/bin/heimdall-selfscan"
    if [ ! -f "$src_hook" ]; then
      echo "  Error: hook template not found at $src_hook" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    if [ ! -x "$selfscan" ]; then
      echo "  Error: heimdall-selfscan not found/executable at $selfscan" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi

    # Wire via core.hooksPath into a heimdall-managed dir, NOT .git/hooks — so a
    # later `.git/hooks` clobber (or a fresh clone re-init) cannot silently
    # disable the gate, and we never trample a user's existing hooks.
    #
    # RELOCATABLE: the value STORED in git config is the RELATIVE path
    # `.heimdall/git-hooks`. git resolves core.hooksPath relative to the working
    # tree root, so `mv`-ing or renaming the repo keeps the hook wired — an
    # absolute path would dangle the instant the repo moves. The hook body itself
    # resolves heimdall-selfscan at RUNTIME via `git rev-parse --show-toplevel`
    # (no baked absolute path), so the delegate target moves with the repo too.
    rel_hooks_dir=".heimdall/git-hooks"
    hooks_dir="$repo_root/$rel_hooks_dir"
    mkdir -p "$hooks_dir"
    dst_hook="$hooks_dir/pre-push"

    # Copy the hook verbatim — NO path is baked. The hook resolves the scanner at
    # runtime from the repo top, so it survives a repo move/rename.
    cp "$src_hook" "$dst_hook"
    chmod +x "$dst_hook"

    # RELATIVE on purpose (see above). Run from $repo_root so a stale absolute
    # value from a prior install is overwritten with the relocatable one.
    git -C "$repo_root" config core.hooksPath "$rel_hooks_dir"

    apply_heimdall_theme 2>/dev/null || true
    G='\033[32m'; D='\033[2m'; B='\033[1m'; R='\033[0m'
    printf "\n  ${B}Heimdall push guard installed${R}\n\n"
    printf "  ${G}✓${R} hook        %s\n" "$dst_hook"
    printf "  ${G}✓${R} delegates   %s ${D}(resolved at push time)${R}\n" "$repo_root/bin/heimdall-selfscan"
    printf "  ${G}✓${R} core.hooksPath = %s ${D}(relative → survives a repo move)${R}\n" "$rel_hooks_dir"
    printf "\n"
    printf "  ${D}Runs on EVERY push (human or agent): gitleaks full-history secret scan${R}\n"
    printf "  ${D}+ author/committer identity allowlist. A blocked push prints the reason;${R}\n"
    printf "  ${D}a clean push prints: guard: gitleaks=0 · identities=N/N allowlisted${R}\n\n"
    exit 0
    ;;
  uninstall)
    # Remove the plugin dir + BOTH entry points (hmd, heimdall) and nothing
    # else. This is on the success card, so it must exist. The guarded removal
    # lives in the shared _heimdall_remove_plugin (so it cannot drift to an
    # unguarded rm).
    #
    # CONFIRMATION DISCIPLINE (v2.0.4): a safety guard must NEVER hang. We mirror
    # the same non-TTY discipline install/demo/boot-animation use:
    #   --yes/-y           → proceed without prompting (CI, scripts, the harness)
    #   TTY, no --yes      → prompt [y/N] (a human can answer)
    #   NON-TTY, no --yes  → refuse cleanly: exit 2 with the --yes hint. NEVER
    #                        read from a stdin that will never arrive (that hangs).
    apply_heimdall_theme 2>/dev/null || true
    D='\033[2m'; G='\033[32m'; R='\033[0m'; B='\033[1m'
    printf "\n  ${B}Uninstalling Heimdall${R}\n\n"

    _uyes=0; for _a in "$@"; do { [ "$_a" = "--yes" ] || [ "$_a" = "-y" ]; } && _uyes=1; done
    if [ "$_uyes" -ne 1 ]; then
      if [ -t 0 ]; then
        read -p "  Remove heimdall from ~/.heimdall and PATH? [y/N] " _confirm
        if [[ "${_confirm:-n}" != [yY]* ]]; then
          printf "\n  ${D}Cancelled — nothing removed.${R}\n\n"
          exit 0
        fi
      else
        printf "  ${D}Non-interactive: pass --yes to confirm uninstall (refusing to prompt).${R}\n" >&2
        exit 2
      fi
    fi

    # ── Farewell (change #3, v2.0.3): the leaving watchman ──
    # Reuse the SINGLE sad frame (heimdall-face --frame sad) + a one-line goodbye —
    # NOT an animation loop, just one frame. TTY-gated: on a non-TTY/piped stdout we
    # emit no art (frame glyphs are garbage bytes through a pipe). Color honored
    # (NO_COLOR / --no-color → the renderer degrades to plain). HEIMDALL_NO_INTRO=1
    # also suppresses it (recordings / CI). Never fatal: a missing renderer is
    # silently skipped so uninstall always proceeds to the real removal below.
    if [ -t 1 ] && [ "${HEIMDALL_NO_INTRO:-0}" != "1" ] && [ -x "$PLUGIN_DIR/bin/heimdall-face" ]; then
      _face_flag="--no-color"
      { [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; } && _face_flag="--color"
      while IFS= read -r _fl; do
        printf "  %s\n" "$_fl"
      done < <("$PLUGIN_DIR/bin/heimdall-face" --frame sad "$_face_flag" 2>/dev/null)
      printf "  ${D}the watchman sleeps. it was good to keep watch with you.${R}\n\n"
    fi

    # Reverse install.sh's appended PATH export FIRST (the v2.0.2 gap: uninstall
    # removed the plugin + symlinks but left the profile PATH line behind).
    # ORDER IS LOAD-BEARING: when `hmd` is the ~/.local/bin symlink, readlink-f
    # resolves the running script to ~/.heimdall/bin/heimdall. _heimdall_remove_plugin
    # deletes ~/.heimdall — the script's own backing file — so a command AFTER it may
    # not be read from disk and silently never runs (that was the bug: PATH survived).
    # The PATH remover must run BEFORE plugin removal so it is guaranteed to execute.
    # (The --uninstall flag arm already orders it this way.)
    _heimdall_remove_path_export
    _heimdall_remove_plugin

    printf "\n"
    if [ "${REMOVED_ANY:-0}" -eq 1 ]; then
      printf "  ${G}✓${R} Heimdall removed. Nothing else was touched.\n"
      printf "  ${D}Open a new terminal for the PATH change to take effect.${R}\n"
    else
      printf "  ${D}Nothing to remove — Heimdall was not installed here.${R}\n"
    fi
    printf "  ${D}Reinstall anytime: curl -fsSL https://runheimdall.dev/install | bash${R}\n\n"
    exit 0
    ;;
  team)
    # Pass-through to heimdall-team (new/join/share/show and bare dispatch).
    # Bin dir resolved via $PLUGIN_DIR — same as demo/rr above, never hardcoded.
    shift
    TEAM_BIN="$PLUGIN_DIR/bin/heimdall-team"
    if [ ! -x "$TEAM_BIN" ]; then
      echo "  Error: heimdall-team not found at $TEAM_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$TEAM_BIN" "$@"
    ;;
  invite)
    # Pass-through to heimdall-invite (teammate join-link generator).
    shift
    INVITE_BIN="$PLUGIN_DIR/bin/heimdall-invite"
    if [ ! -x "$INVITE_BIN" ]; then
      echo "  Error: heimdall-invite not found at $INVITE_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$INVITE_BIN" "$@"
    ;;
  join)
    # `hmd join <secret>` — the teammate side of the viral loop: the ONE command a
    # teammate runs (or the tail of the invite one-liner) to land on the inviter's
    # team. Delegates to `heimdall-team join <thing>` — the secret rides this CLI's
    # own argv (the documented entry point), never re-exposed. Third of the three
    # user-facing commands (team / invite / join); everything else is internal.
    shift
    JOIN_BIN="$PLUGIN_DIR/bin/heimdall-team"
    if [ ! -x "$JOIN_BIN" ]; then
      echo "  Error: heimdall-team not found at $JOIN_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$JOIN_BIN" join "$@"
    ;;
  connect)
    # `hmd connect` — lazy, secret-safe capture of the team's Claude credential (and,
    # when resolvable, the GitHub App install). Replaces the multi-step rr connect
    # token-plumbing with a guided secure capture. Flags forwarded verbatim
    # (--inbox / --tab / --status / request).
    shift
    CONNECT_BIN="$PLUGIN_DIR/bin/heimdall-connect"
    if [ ! -x "$CONNECT_BIN" ]; then
      echo "  Error: heimdall-connect not found at $CONNECT_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$CONNECT_BIN" "$@"
    ;;
  presence)
    # Pass-through to heimdall-presence (off/on/on --global/on --no-files/
    # status/roster/beat/retire). All args/flags forwarded verbatim.
    shift
    PRESENCE_BIN="$PLUGIN_DIR/bin/heimdall-presence"
    if [ ! -x "$PRESENCE_BIN" ]; then
      echo "  Error: heimdall-presence not found at $PRESENCE_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$PRESENCE_BIN" "$@"
    ;;
  telemetry)
    # `hmd telemetry` — Pre-Merge Corpus (PMR) T0 consent + control surface
    # (status/on/off/hunks on|off/purge) + the internal emit/observe/scan/install-hook
    # the gate pipeline and post-commit hook call. Own namespace, client-side only —
    # the corpus clock starts AT launch. All args/flags forwarded verbatim.
    shift
    TELEMETRY_CORPUS_BIN="$PLUGIN_DIR/bin/heimdall-telemetry-corpus"
    if [ ! -x "$TELEMETRY_CORPUS_BIN" ]; then
      echo "  Error: heimdall-telemetry-corpus not found at $TELEMETRY_CORPUS_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$TELEMETRY_CORPUS_BIN" "$@"
    ;;
esac

# ── Command handlers ──

# --update: pull latest via git
if [[ "${1:-}" == "--update" ]]; then
  apply_heimdall_theme 2>/dev/null || true

  # Animated update banner
  P='\033[38;2;224;86;160m' C='\033[38;2;0;212;255m'
  V='\033[38;2;155;89;182m' G='\033[38;2;78;204;163m'
  D='\033[38;2;100;100;120m' W='\033[38;2;255;200;80m'
  B='\033[1m' R='\033[0m'

  printf "\n"
  printf "  ${P}${B}"
  type_text "░▒▓█" 0.03
  printf " "
  type_text "U P D A T I N G" 0.04
  printf " "
  type_text "█▓▒░" 0.03
  printf "${R}\n"
  printf "  ${V}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}\n\n"

  if [ -d "$PLUGIN_DIR/.git" ]; then
    local_hash=$(git -C "$PLUGIN_DIR" rev-parse HEAD 2>/dev/null)
    local_short="${local_hash:0:7}"

    # DEV-CHECKOUT GUARD: the auto-update below does `git reset --hard origin/main`,
    # which is safe for the canonical clean ~/.heimdall clone but would DESTROY a
    # dev/editable checkout that has local commits or uncommitted edits. If this
    # install can't be safely auto-updated, print the correct MANUAL step instead
    # of guessing — never silently clobber a contributor's working tree.
    dirty_tree=0
    [ -n "$(git -C "$PLUGIN_DIR" status --porcelain 2>/dev/null)" ] && dirty_tree=1
    ahead_count=$(git -C "$PLUGIN_DIR" rev-list origin/main..HEAD --count 2>/dev/null || echo 0)
    case "$ahead_count" in ''|*[!0-9]*) ahead_count=0 ;; esac
    if [ "$dirty_tree" -eq 1 ] || [ "$ahead_count" -gt 0 ]; then
      printf "  ${W}This looks like a development checkout${R} ${D}(%s)${R}\n" "$PLUGIN_DIR"
      [ "$dirty_tree" -eq 1 ]    && printf "    ${D}• uncommitted local changes present${R}\n"
      [ "$ahead_count" -gt 0 ]   && printf "    ${D}• %s local commit(s) ahead of origin/main${R}\n" "$ahead_count"
      printf "\n  ${B}Auto-update is disabled here${R} to avoid discarding your work.\n"
      printf "  Update manually:\n\n"
      printf "    ${C}cd %s && git pull --ff-only${R}\n" "$PLUGIN_DIR"
      printf "  ${D}or, for a clean reinstall of the released build:${R}\n"
      printf "    ${C}hmd --reinstall${R}\n\n"
      exit 0
    fi

    # Animated fetch
    printf "  ${D}[1/2]${R} ${B}Sync${R}\n"
    git -C "$PLUGIN_DIR" fetch origin main --force 2>/dev/null &
    spin $! "Fetching from origin..."
    git -C "$PLUGIN_DIR" fetch origin --force 2>/dev/null

    # Compare
    remote_hash=$(git -C "$PLUGIN_DIR" rev-parse origin/main 2>/dev/null)
    remote_short="${remote_hash:0:7}"

    if [ "$local_hash" != "$remote_hash" ]; then
      # Update available — apply it
      printf "\n  ${D}[2/2]${R} ${B}Apply${R}\n"
      git -C "$PLUGIN_DIR" reset --hard origin/main >/dev/null 2>&1 &
      spin $! "Applying ${local_short} → ${remote_short}..."

      new_hash=$(git -C "$PLUGIN_DIR" rev-parse HEAD 2>/dev/null)
      base=$(git -C "$PLUGIN_DIR" merge-base "$local_hash" "$new_hash" 2>/dev/null || echo "$local_hash")
      echo "$base" > "$PLUGIN_DIR/.last-update-from"
      changed=$(git -C "$PLUGIN_DIR" diff --name-only "$base".."$new_hash" 2>/dev/null | wc -l | tr -d ' ')

      printf "\n  ${V}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}\n"
      printf "  ${G}${B}✔ Updated${R}  ${D}%s files changed${R}\n" "$changed"
      printf "  ${V}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}\n\n"

      git -C "$PLUGIN_DIR" log --oneline "$base".."$new_hash" 2>/dev/null | head -12 | while IFS= read -r line; do
        msg="${line#* }"
        case "$msg" in
          feat:*|feat\(*) printf "  ${G}▸ NEW ${R} %s\n" "${msg#feat: }" ;;
          fix:*|fix\(*)   printf "  ${C}▸ FIX ${R} %s\n" "${msg#fix: }" ;;
          docs:*)          printf "  ${D}▸ DOC ${R} %s\n" "${msg#docs: }" ;;
          release:*)       printf "  ${W}▸ REL ${R} %s\n" "${msg#release: }" ;;
          *)               printf "  ${D}▸     ${R} %s\n" "$msg" ;;
        esac
        sleep 0.04
      done

      printf "\n"
      git -C "$PLUGIN_DIR" diff --stat "$base".."$new_hash" 2>/dev/null | tail -1 | while IFS= read -r line; do
        printf "   ${D}%s${R}\n" "$line"
      done
      printf "\n"

    else
      # No changes available
      printf "\n  ${V}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}\n"
      printf "  ${G}✔ Already on latest${R}  ${D}(%s)${R}\n" "$local_short"
      printf "  ${V}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}\n"

      if [ ! -f "$PLUGIN_DIR/.last-update-from" ]; then
        mk=$(git -C "$PLUGIN_DIR" log --oneline -10 2>/dev/null | tail -1 | cut -d' ' -f1)
        [ -n "$mk" ] && echo "$mk" > "$PLUGIN_DIR/.last-update-from"
      fi

      if [ -f "$PLUGIN_DIR/.last-update-from" ]; then
        last_from=$(cat "$PLUGIN_DIR/.last-update-from")
        count=$(git -C "$PLUGIN_DIR" log --oneline "$last_from"..HEAD 2>/dev/null | wc -l | tr -d ' ')
        if [ "${count:-0}" -gt 0 ]; then
          printf "\n  ${D}%s changes since install:${R}\n\n" "$count"
          git -C "$PLUGIN_DIR" log --oneline "$last_from"..HEAD 2>/dev/null | head -12 | while IFS= read -r line; do
            msg="${line#* }"
            case "$msg" in
              feat:*|feat\(*) printf "  ${G}▸ NEW ${R} %s\n" "${msg#feat: }" ;;
              fix:*|fix\(*)   printf "  ${C}▸ FIX ${R} %s\n" "${msg#fix: }" ;;
              docs:*)          printf "  ${D}▸ DOC ${R} %s\n" "${msg#docs: }" ;;
              release:*)       printf "  ${W}▸ REL ${R} %s\n" "${msg#release: }" ;;
              *)               printf "  ${D}▸     ${R} %s\n" "$msg" ;;
            esac
            sleep 0.03
          done
        fi
      fi
      printf "\n"
    fi
  else
    printf "  ${W}No git repo found. Reinstalling...${R}\n"
    exec bash -c 'cd "$HOME" && curl -fsSL https://raw.githubusercontent.com/randomittin/heimdall/main/install.sh | bash'
  fi
  exit 0
fi

# --reinstall: nuke and rebuild ~/.heimdall from scratch (fixes zombie states)
# Uses the curl installer instead of doing it inline — avoids the
# "script deletes itself mid-execution" problem.
if [[ "${1:-}" == "--reinstall" || "${1:-}" == "--fix" ]]; then
  apply_heimdall_theme 2>/dev/null || true
  printf "\n  \033[38;2;224;86;160m\033[1m░▒▓█ REINSTALLING █▓▒░\033[0m\n\n"
  printf "  This will wipe ~/.heimdall and re-clone from GitHub.\n"
  printf "  Your projects are NOT affected — only the heimdall tool itself.\n\n"
  # Zero-stdin contract (same as --uninstall): this wipes ~/.heimdall, so it must
  # never block on a confirm prompt when piped or in a non-interactive shell.
  # Parse --yes/-y; if stdin is NOT a TTY and --yes was not given, refuse rather
  # than hang on a read that no one will answer (the class-4 TTY-read landmine).
  _ri_yes=0
  for _a in "$@"; do { [ "$_a" = "--yes" ] || [ "$_a" = "-y" ]; } && _ri_yes=1; done
  if [ "$_ri_yes" -ne 1 ]; then
    if [ -t 0 ]; then
      read -p "  Proceed? [y/N] " confirm
      if [[ "${confirm:-n}" != [yY]* ]]; then
        echo "  Cancelled."
        exit 0
      fi
    else
      echo "heimdall --reinstall: non-interactive; pass --yes to confirm (refusing to prompt)." >&2
      exit 2
    fi
  fi
  printf "\n"
  # Remove old install and delegate to the curl installer.
  # cd $HOME first — if user is inside ~/.heimdall, deleting it makes
  # the cwd invalid and bash throws "getcwd: cannot access parent directories"
  rm -rf "$HOME/.heimdall"
  exec bash -c 'cd "$HOME" && curl -fsSL https://raw.githubusercontent.com/randomittin/heimdall/main/install.sh | bash'
fi

# --uninstall: remove heimdall completely (legacy flag; `hmd uninstall` is canonical)
if [[ "${1:-}" == "--uninstall" ]]; then
  # Zero-stdin contract: this must never block on a prompt when piped or in a
  # non-interactive shell. Parse --yes; if stdin is NOT a TTY and --yes was not
  # given, refuse rather than hang (exit 2 + one-line message).
  ASSUME_YES=0
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) ASSUME_YES=1; shift ;;
      *) shift ;;
    esac
  done
  if [ "$ASSUME_YES" -ne 1 ] && [ ! -t 0 ]; then
    echo "heimdall --uninstall: non-interactive; pass --yes to confirm (refusing to prompt)." >&2
    exit 2
  fi

  apply_heimdall_theme 2>/dev/null || true

  # Sad banner (reuse top-level color vars from print_banner's fallback chain)
  P='\033[38;2;224;86;160m' D='\033[38;2;100;100;120m'
  B='\033[1m' R='\033[0m'
  printf "\n"
  printf "  ${P}${B}"
  type_text "░▒▓█" 0.04
  printf " "
  type_text "G O O D B Y E" 0.06
  printf " "
  type_text "█▓▒░" 0.04
  printf "${R}\n\n"

  printf "  ${D}╭─────────────────────────────────────╮${R}\n"
  sleep 0.05
  printf "  ${D}│${R}  ${P}(╥_╥)${R}  we had a good run...        ${D}│${R}\n"
  sleep 0.05
  printf "  ${D}╰─────────────────────────────────────╯${R}\n\n"

  # Interactive confirm only on a TTY without --yes; --yes/non-TTY skips it.
  if [ "$ASSUME_YES" -ne 1 ]; then
    read -p "  Remove heimdall from ~/.heimdall and PATH? [y/N] " confirm
    if [[ "${confirm:-n}" != [yY]* ]]; then
      printf "\n  ${P}${B}(ᵔᴥᵔ)${R}  ${D}phew! welcome back.${R}\n\n"
      exit 0
    fi
  fi

  printf "\n"
  # Remove the heimdall PATH export via the SHARED surgical remover (matches the
  # marker + the `.local/bin` export install.sh actually writes, and the legacy
  # `.heimdall/bin` line) — so this arm and `hmd uninstall` reverse PATH the SAME
  # way. The old sed here only matched `.heimdall/bin`, never the v2.0.2 `.local/bin`
  # line, so the PATH export survived uninstall.
  _heimdall_remove_path_export
  # Legacy superx PATH lines (pre-heimdall installs) — narrowly matched, kept here
  # because the shared remover intentionally scopes to heimdall artifacts only.
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [ -f "$rc" ] && grep -qE 'superx.*autonomous|\.superx/bin' "$rc"; then
      sed -i '' '/superx.*autonomous/d;/\.superx\/bin/d' "$rc" 2>/dev/null || \
      sed -i '/superx.*autonomous/d;/\.superx\/bin/d' "$rc" 2>/dev/null || true
      printf "  ${D}×${R} legacy superx PATH entry removed from $(basename "$rc")\n"
    fi
  done
  sleep 0.1
  # Remove the plugin dir + entry points via the SHARED guarded path — never an
  # unguarded `rm -rf "$HOME/.heimdall"`. Same guard as `hmd uninstall`.
  _heimdall_remove_plugin
  sleep 0.1
  # Uninstall companion plugins — interactive only (TTY without --yes). In
  # --yes/non-TTY mode skip silently to honor the zero-stdin contract.
  if [ "$ASSUME_YES" -ne 1 ]; then
    read -p "  Also uninstall companion plugins (caveman, claude-mem)? [y/N] " plugins
    if [[ "${plugins:-n}" == [yY]* ]]; then
      claude plugins uninstall caveman 2>/dev/null && printf "  ${D}×${R} caveman removed\n" || true
      claude plugins uninstall superpowers 2>/dev/null && printf "  ${D}×${R} superpowers removed\n" || true
      claude plugins marketplace remove heimdall-marketplace 2>/dev/null && printf "  ${D}×${R} marketplace removed\n" || true
    fi
  fi

  printf "\n"
  printf "  ${D}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}\n"
  sleep 0.1
  printf "  ${D}heimdall uninstalled.${R}\n"
  printf "  ${D}Open a new terminal for PATH changes.${R}\n"
  sleep 0.1
  printf "\n"
  printf "  ${D}Want us back? Just run:${R}\n"
  printf "  ${P}curl -fsSL https://raw.githubusercontent.com/randomittin/heimdall/main/install.sh | bash${R}\n"
  printf "\n"
  printf "  ${D}(╥_╥)  bye bye...${R}\n\n"
  exit 0
fi

# --setup: re-run plugin installation
if [[ "${1:-}" == "--setup" ]]; then
  rm -f "$SETUP_MARKER" "$SETUP_MARKER_LEGACY"
  ensure_node_path
  ensure_claude
  first_run_setup
  ensure_auth
  exit 0
fi

# --resume: continue the last Claude session AND load .planning/ state
if [[ "${1:-}" == "--resume" || "${1:-}" == "-r" ]]; then
  ensure_node_path
  ensure_claude
  first_run_setup
  ensure_auth
  apply_heimdall_theme 2>/dev/null || true
  print_banner 2>/dev/null || true

  # Check for resumable state
  if [ -f "$WORK_DIR/.planning/STATE.md" ]; then
    echo "  ▸ Resuming from .planning/STATE.md"
  fi
  if [ -f "$WORK_DIR/heimdall-state.json" ]; then
    echo "  ▸ heimdall state loaded"
  fi

  # Restore active goal from state or checkpoint
  GOAL_CONDITION=""
  if [ -f "$WORK_DIR/heimdall-state.json" ]; then
    GOAL_CONDITION=$(python3 -c "
import json
try:
    with open('$WORK_DIR/heimdall-state.json') as f:
        s = json.load(f)
    cond = s.get('goal', {}).get('condition')
    if cond: print(cond)
except: pass
" 2>/dev/null)
  fi
  if [ -z "$GOAL_CONDITION" ] && [ -f "$WORK_DIR/.planning/settings.json" ]; then
    GOAL_CONDITION=$(python3 -c "
import json
try:
    with open('$WORK_DIR/.planning/settings.json') as f:
        s = json.load(f)
    cond = s.get('goal', {}).get('condition')
    if cond: print(cond)
except: pass
" 2>/dev/null)
  fi

  # Write preamble for resume
  RESUME_PREAMBLE_FILE=$(mktemp /tmp/heimdall-resume-XXXXXX)
  if [ -n "$GOAL_CONDITION" ]; then
    printf "heimdall resumed.\n\nRESTORE GOAL: A goal was active in the previous session. Restore it immediately:\n/goal %s\n\nThen read .planning/CHECKPOINT.md and continue working." "$GOAL_CONDITION" > "$RESUME_PREAMBLE_FILE"
    printf "  \033[38;2;224;86;160m▸ Goal restored\033[0m\n"
  else
    echo "${PREAMBLE:-heimdall resumed}" > "$RESUME_PREAMBLE_FILE"
  fi

  # Activate project-aware skills
  SKILL_MGR="$PLUGIN_DIR/bin/skill-manager"
  RESTORE_FILE=""
  if [ -x "$SKILL_MGR" ]; then
    "$SKILL_MGR" activate "$WORK_DIR"
    RESTORE_FILE=$("$SKILL_MGR" restore-file)
  fi

  cleanup_resume() {
    rm -f "$RESUME_PREAMBLE_FILE"
    [ -n "$RESTORE_FILE" ] && [ -x "$SKILL_MGR" ] && "$SKILL_MGR" restore "$RESTORE_FILE" 2>/dev/null
  }
  trap cleanup_resume EXIT

  claude --continue \
    --agent heimdall \
    $PERMISSION_FLAG \
    --model claude-opus-4-8 \
    --plugin-dir "$PLUGIN_DIR" \
    --append-system-prompt-file "$RESUME_PREAMBLE_FILE"
  exit $?
fi

# --team N: spawn N parallel claude workers in tmux panes
if [[ "${1:-}" == "--team" ]]; then
  ensure_node_path
  ensure_claude
  first_run_setup
  ensure_auth
  apply_heimdall_theme 2>/dev/null || true
  print_banner 2>/dev/null || true

  TEAM_SIZE="${2:-3}"
  shift 2 || shift 1
  TASK="${*:-}"

  if ! command -v tmux &>/dev/null; then
    echo "  tmux not found. Install: brew install tmux (macOS) / apt install tmux (Linux)"
    exit 1
  fi

  SESSION="heimdall-team-$$"
  echo "  Spawning $TEAM_SIZE workers in tmux session: $SESSION"

  tmux new-session -d -s "$SESSION" -n "lead"
  # Lead worker gets the task
  tmux send-keys -t "$SESSION:lead" "cd $WORK_DIR && claude --agent heimdall $PERMISSION_FLAG --model claude-opus-4-8 --plugin-dir $PLUGIN_DIR" Enter

  # Spawn additional worker panes
  for i in $(seq 2 "$TEAM_SIZE"); do
    tmux split-window -t "$SESSION" -h
    tmux send-keys -t "$SESSION" "cd $WORK_DIR && claude --agent heimdall $PERMISSION_FLAG --model claude-opus-4-8 --plugin-dir $PLUGIN_DIR" Enter
    tmux select-layout -t "$SESSION" tiled
  done

  if [ -n "$TASK" ]; then
    sleep 2
    tmux send-keys -t "$SESSION:lead.0" "$TASK" Enter
  fi

  echo "  Attach: tmux attach -t $SESSION"
  echo "  Detach: Ctrl+B then D"
  exec tmux attach -t "$SESSION"
fi

