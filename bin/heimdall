    ;;
  check)
    # Pass-through to bin/heimdall-check (F2 Checker — duplicate-shape checker,
    # commit-time; see that bin's own --help for --repo/--base/--tier/--attest/
    # --block). README's "Redum / conformance checker" row names this exact
