    fi
    exec "$REDUM_BIN" "$@"
    ;;
  authenticity-check)
    # Pass-through to bin/authenticity-check: publisher-trust scoring (0-100)
    # for an npm package, GitHub repo, or installed Claude Code plugin.
    # PARITY.md records this as "kept" from superx, and
    # skills/heimdall/SKILL.md tells agents to run it before recommending an
    # external package — but heimdall-deadcode classified it PROSE-ONLY: its
    # only caller was that SKILL.md sentence, which names the command but
    # invokes nothing. Before this arm existed, `hmd authenticity-check` fell
    # through to the goal-driven task prompt below instead of dispatching —
    # the same gap `report)`/`check)`/`redum)` above exist to close. Verified
    # end-to-end 2026-08-22 against real, live data: `npm chalk` and `github
    # cli/cli` both returned correctly scored JSON from the real npm registry
    # and GitHub API, so this is working functionality that lacked a path, not
    # scaffolding. All args forward verbatim, so a routed run and a direct bin
    # run are byte-identical.
    shift
    AUTHENTICITY_CHECK_BIN="$PLUGIN_DIR/bin/authenticity-check"
    if [ ! -x "$AUTHENTICITY_CHECK_BIN" ]; then
      echo "  Error: authenticity-check not found at $AUTHENTICITY_CHECK_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$AUTHENTICITY_CHECK_BIN" "$@"
    ;;
  queue)
    # Pass-through to bin/heimdall-queue (LOCAL continuous-intake work queue:
    # add/pick/complete/fail/reap/get/list/status/serve) with one carve-out:
    # `hmd queue drain` routes to the DISTINCT drainer bin/heimdall-drain instead
    # (heimdall-queue has no "drain" verb of its own — draining is a separate bin
    # on purpose). bin/lib/reachability-exemptions.tsv records both as a
    # "two-corpse chain" (heimdall-queue reachable only via heimdall-drain;
    # heimdall-drain triggered by no cron/hook/dispatcher arm) — that dates from
    # before this arm existed and is now stale on the "no path in" half; neither
    # bin is dead code, though: test/gate-judgment-uncompressed.test.sh Case 6
    # already names bin/heimdall-drain (with bin/falsify) as one of exactly two
    # real gate clients that must resolve every verdict through hmd_gate_exec —
    # load-bearing for that invariant regardless of operational trigger, per the
    # "load-bearing for a gate: WIRE, never DELETE" rule. Verified end-to-end
    # 2026-08-23 in a scratch HEIMDALL_HOME: add/pick/complete/get/reap on
    # heimdall-queue, and a full drain cycle (seeded queue -> priority-ordered
    # pick -> executed -> verdict resolved -> requeue-on-fail) on heimdall-drain,
    # both against synthetic local data only — no network, no real task run.
    # This arm gives both the graph-visible path they lacked, the same gap
    # `report-issue)` / `redum)` / `authenticity-check)` above exist to close.
    shift
    if [ "${1:-}" = "drain" ]; then
      shift
      DRAIN_BIN="$PLUGIN_DIR/bin/heimdall-drain"
      if [ ! -x "$DRAIN_BIN" ]; then
        echo "  Error: heimdall-drain not found at $DRAIN_BIN" >&2
        echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
        exit 1
      fi
      exec "$DRAIN_BIN" "$@"
    fi
    QUEUE_BIN="$PLUGIN_DIR/bin/heimdall-queue"
    if [ ! -x "$QUEUE_BIN" ]; then
      echo "  Error: heimdall-queue not found at $QUEUE_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$QUEUE_BIN" "$@"
    ;;
  quota-advisor)
    # Pass-through to bin/heimdall-quota-advisor: the honest, NEVER-AUTO-
    # SWITCHING advisor for a genuine Claude quota/session-limit exhaustion
    # (see that bin's own header for the OmniRoute safety boundary it
    # permanently enforces — it never wires OmniRoute's Tier-1 subscription-
    # reuse mode or its MITM decrypt mode, and never auto-switches a
    # provider). Before this arm existed, `hmd quota-advisor ...` fell
    # through to the goal-driven task prompt below instead of dispatching —
    # the same gap `report)`/`redum)`/`authenticity-check)`/`queue)` above
    # exist to close, and a live repro here is worse than most: it silently
    # spawned a real, non-interactive `claude -p` run instead of returning a
    # plain CLI error. All args forward verbatim, so a routed run and a
    # direct bin run are byte-identical.
    shift
    QUOTA_ADVISOR_BIN="$PLUGIN_DIR/bin/heimdall-quota-advisor"
    if [ ! -x "$QUOTA_ADVISOR_BIN" ]; then
      echo "  Error: heimdall-quota-advisor not found at $QUOTA_ADVISOR_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$QUOTA_ADVISOR_BIN" "$@"
    ;;
  delivery-audit)
    # Pass-through to bin/heimdall-delivery-audit (delivery-claim falsifier — makes
    # "queued"/"landed"/"running now" claims checkable: dead-on-arrival reachability
    # reuse of heimdall-deadcode, background-artifact staleness, and recorded-intent
    # lookup; see that bin's own --help for report/--json/artifact/intent). Added
    # after three measured overclaims in one session went uncaught until a human
    # noticed. All args forward verbatim, so a routed run and a direct bin run are
    # byte-identical.
    shift
    DELIVERY_AUDIT_BIN="$PLUGIN_DIR/bin/heimdall-delivery-audit"
    if [ ! -x "$DELIVERY_AUDIT_BIN" ]; then
      echo "  Error: heimdall-delivery-audit not found at $DELIVERY_AUDIT_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$DELIVERY_AUDIT_BIN" "$@"
    ;;
  wrap|unwrap)
    # §7 Pass-through to heimdall-wrap: ONE command that installs the Layer-0 git
    # hooks, writes the AGENTS.md fenced block, starts presence and launches the
    # configured tool — and one that reverses every byte of it. The verb itself is
    # part of the contract, so it is NOT shifted away: `hmd unwrap codex` reaches
    # the runner as `unwrap codex`. All flags forward verbatim (--always/--default/
    # --no-launch), so a routed run and a direct bin run behave identically.
    WRAP_BIN="$PLUGIN_DIR/bin/heimdall-wrap"
    if [ ! -x "$WRAP_BIN" ]; then
      echo "  Error: heimdall-wrap not found at $WRAP_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$WRAP_BIN" "$@"
    ;;
  '')
    # §7 EMPTY ARGS → wrap-and-launch the default tool.
    #
    # DISTINCT FROM THE UNKNOWN-TOKEN PATH, deliberately. An unknown token still
    # falls through to the Claude task prompt below — that fall-through is what
    # makes `hmd fix the login bug` work, and test/heimdall-cli-routing.test.sh §8
    # pins it. Only the EMPTY invocation means "set this repo up and start", so
    # only the empty invocation routes here. test/wrap-lifecycle.test.sh §8 asserts
    # both behaviours separately; collapsing either into the other goes RED.
    #
    # THE GUARD: heimdall-wrap launches `claude` by exec'ing THIS script back (it
    # owns model-tier resolution, the permission flags and the preamble). Without
    # HEIMDALL_WRAP_LAUNCHED that re-entry would route straight back into wrap —
    # the CLI-level twin of the shim's re-entry refusal.
    #
    # NEVER FATAL: a missing or non-executable runner falls through to the
    # interactive launch below, which is exactly the pre-§7 behaviour. This script
    # runs under `set -euo pipefail`, where a bare call to an absent helper exits
    # 127 and kills the whole launcher — so the guard is `[ -x ]`, never a bare call.
    if [ "${HEIMDALL_WRAP_LAUNCHED:-0}" = "1" ]; then
      # ONE HOP, THEN GONE. heimdall-wrap set this on the `exec` that re-entered
      # this script, so it lives in our environ and every process we go on to
      # launch — the claude session, and every `hmd` the user runs INSIDE it —
      # would inherit it. That turned a one-hop recursion guard into a permanent
      # kill switch: bare `hmd` in a wrapped session silently took the task
      # prompt instead of wrapping, on the entry point most people use for
      # everything. Consume it here, where it has just done its only job, so the
      # guard still stops the wrap→heimdall→wrap loop and stops nothing else.
      # `unset` drops it from the exported environment, not just this shell.
      unset HEIMDALL_WRAP_LAUNCHED
    else
      WRAP_BIN="$PLUGIN_DIR/bin/heimdall-wrap"
      if [ -x "$WRAP_BIN" ]; then
        exec "$WRAP_BIN" launch
      fi
    fi
    ;;
esac

fi
# ── end LIBRARY-ONLY MODE part 1 — dispatch skipped when sourced as a library ──

# ── Command handlers ──

# --update: pull latest via git.
# `update` (bare) is accepted as an alias because the staleness notice below
# advertises exactly that form — a user told to run `hmd update` must not land
# on the splash banner and conclude the update silently did nothing.
if [[ "${1:-}" == "--update" || "${1:-}" == "update" ]]; then
  apply_heimdall_theme 2>/dev/null || true

  # Animated update banner
  P='\033[38;2;224;86;160m' C='\033[38;2;0;212;255m'
  V='\033[38;2;155;89;182m' G='\033[38;2;78;204;163m'
  D='\033[38;2;100;100;120m' W='\033[38;2;255;200;80m'
  B='\033[1m' R='\033[0m'

  printf "\n"
  printf "  ${P}${B}"
  type_text "░▒▓█" 0.03
  printf " "
  type_text "U P D A T I N G" 0.04
  printf " "
  type_text "█▓▒░" 0.03
  printf "${R}\n"
  printf "  ${V}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}\n\n"

  # DEV-CHECKOUT GUARD: a contributor's editable clone (local commits or uncommitted
  # edits) must never be clobbered by an auto-update. If this is a dev checkout, print the
  # correct MANUAL step instead of guessing — never touch a contributor's working tree.
  if [ -d "$PLUGIN_DIR/.git" ]; then
    dirty_tree=0
    [ -n "$(git -C "$PLUGIN_DIR" status --porcelain 2>/dev/null)" ] && dirty_tree=1
    ahead_count=$(git -C "$PLUGIN_DIR" rev-list origin/main..HEAD --count 2>/dev/null || echo 0)
    case "$ahead_count" in ''|*[!0-9]*) ahead_count=0 ;; esac
    if [ "$dirty_tree" -eq 1 ] || [ "$ahead_count" -gt 0 ]; then
      printf "  ${W}This looks like a development checkout${R} ${D}(%s)${R}\n" "$PLUGIN_DIR"
      [ "$dirty_tree" -eq 1 ]    && printf "    ${D}• uncommitted local changes present${R}\n"
      [ "$ahead_count" -gt 0 ]   && printf "    ${D}• %s local commit(s) ahead of origin/main${R}\n" "$ahead_count"
      printf "\n  ${B}Auto-update is disabled here${R} to avoid discarding your work.\n"
      printf "  Update manually:\n\n"
      printf "    ${C}cd %s && git pull --ff-only${R}\n" "$PLUGIN_DIR"
      printf "  ${D}or, for a clean reinstall of the released build:${R}\n"
      printf "    ${C}hmd --reinstall${R}\n\n"
      # THE NIGHTLY /dream PERMISSION STILL GETS ASKED HERE — this branch exits without
      # ever reaching bin/heimdall-autoupdate, where the ask normally lives, and a dev
      # checkout is precisely the shape that needs it: a clone living in ~/Downloads is
      # unreadable to the 03:00 LaunchAgent, because a LaunchAgent carries no TCC grant.
      # Wiring only the updater would leave the one machine with the problem unasked on
      # every single update. --interactive-only is the helper's own tty gate: a human at
      # this terminal is asked here and now; a scripted `hmd --update` does nothing at all
      # and leaves the ask armed. Best-effort — it can never change this branch's exit 0.
      PERM="$PLUGIN_DIR/bin/heimdall-dream-permission"
      [ -x "$PERM" ] && { "$PERM" ask --repo "$PLUGIN_DIR" --interactive-only || true; }
      exit 0
    fi
  fi

  # SIGNED UPDATE (the teammate / released-install path). Delegate to the verifying updater:
  # it resolves installed vs latest, fetches the release, VERIFIES its minisign signature
  # against the in-repo trust root (release/heimdall-signing.pub), and applies ONLY on a
  # clean verify — refusing a tampered/unsigned release LOUDLY (fail-closed). This replaces
  # the old unsigned `git reset --hard origin/main`, which tracked the branch tip and skipped
  # verification entirely. The updater pins the resolved version so the EXACT release installs.
  AUTOUP="$PLUGIN_DIR/bin/heimdall-autoupdate"
  if [ -x "$AUTOUP" ]; then
    printf "  ${D}[1/1]${R} ${B}Verify & apply signed release${R}\n\n"
    "$AUTOUP" update
    exit $?
  fi

  # Fallback: the updater binary is missing (a broken/partial install). Re-run the canonical
  # installer, which itself fails closed on a bad fetch. Never silently no-op.
  printf "  ${W}Signed updater not found — reinstalling from the canonical installer…${R}\n"
  exec bash -c 'cd "$HOME" && curl -fsSL https://raw.githubusercontent.com/randomittin/heimdall/main/install.sh | bash'
fi

# --reinstall: nuke and rebuild ~/.heimdall from scratch (fixes zombie states)
# Uses the curl installer instead of doing it inline — avoids the
# "script deletes itself mid-execution" problem.
if [[ "${1:-}" == "--reinstall" || "${1:-}" == "--fix" ]]; then
  apply_heimdall_theme 2>/dev/null || true
  printf "\n  \033[38;2;224;86;160m\033[1m░▒▓█ REINSTALLING █▓▒░\033[0m\n\n"
  printf "  This will wipe ~/.heimdall and re-clone from GitHub.\n"
  printf "  Your projects are NOT affected — only the heimdall tool itself.\n\n"
  # Zero-stdin contract (same as --uninstall): this wipes ~/.heimdall, so it must
  # never block on a confirm prompt when piped or in a non-interactive shell.
  # Parse --yes/-y; if stdin is NOT a TTY and --yes was not given, refuse rather
  # than hang on a read that no one will answer (the class-4 TTY-read landmine).
  _ri_yes=0
  for _a in "$@"; do { [ "$_a" = "--yes" ] || [ "$_a" = "-y" ]; } && _ri_yes=1; done
  if [ "$_ri_yes" -ne 1 ]; then
    if [ -t 0 ]; then
      # Arrow-key confirm (↑/↓ + Enter, default No); guarded typed fallback.
      confirm=n
      if command -v hmd_confirm >/dev/null 2>&1; then
        hmd_confirm "  Proceed with reinstall (wipes ~/.heimdall)?" && confirm=y
      else
        read -p "  Proceed? [y/N] " confirm
      fi
      if [[ "${confirm:-n}" != [yY]* ]]; then
        echo "  Cancelled."
        exit 0
      fi
    else
      echo "heimdall --reinstall: non-interactive; pass --yes to confirm (refusing to prompt)." >&2
      exit 2
    fi
  fi
  printf "\n"
  # Remove old install and delegate to the curl installer.
  # cd $HOME first — if user is inside ~/.heimdall, deleting it makes
  # the cwd invalid and bash throws "getcwd: cannot access parent directories"
  rm -rf "$HOME/.heimdall"
  exec bash -c 'cd "$HOME" && curl -fsSL https://raw.githubusercontent.com/randomittin/heimdall/main/install.sh | bash'
fi

# --uninstall: remove heimdall completely (legacy flag; `hmd uninstall` is canonical)
if [[ "${1:-}" == "--uninstall" ]]; then
  # Zero-stdin contract: this must never block on a prompt when piped or in a
  # non-interactive shell. Parse --yes; if stdin is NOT a TTY and --yes was not
  # given, refuse rather than hang (exit 2 + one-line message).
  ASSUME_YES=0
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) ASSUME_YES=1; shift ;;
      *) shift ;;
    esac
  done
  if [ "$ASSUME_YES" -ne 1 ] && [ ! -t 0 ]; then
    echo "heimdall --uninstall: non-interactive; pass --yes to confirm (refusing to prompt)." >&2
    exit 2
  fi

  apply_heimdall_theme 2>/dev/null || true

  # Sad banner (reuse top-level color vars from print_banner's fallback chain)
  P='\033[38;2;224;86;160m' D='\033[38;2;100;100;120m'
  B='\033[1m' R='\033[0m'
  printf "\n"
  printf "  ${P}${B}"
  type_text "░▒▓█" 0.04
  printf " "
  type_text "G O O D B Y E" 0.06
  printf " "
  type_text "█▓▒░" 0.04
  printf "${R}\n\n"

  printf "  ${D}╭─────────────────────────────────────╮${R}\n"
  sleep 0.05
  printf "  ${D}│${R}  ${P}(╥_╥)${R}  we had a good run...        ${D}│${R}\n"
  sleep 0.05
  printf "  ${D}╰─────────────────────────────────────╯${R}\n\n"

  # Interactive confirm only on a TTY without --yes; --yes/non-TTY skips it.
  if [ "$ASSUME_YES" -ne 1 ]; then
    # Arrow-key confirm (↑/↓ + Enter, default No). Reachable only on a TTY (the
    # non-TTY-without-yes case already exited 2 above). Guarded typed fallback.
    confirm=n
    if command -v hmd_confirm >/dev/null 2>&1; then
      hmd_confirm "  Remove heimdall from ~/.heimdall and PATH?" && confirm=y
    else
      read -p "  Remove heimdall from ~/.heimdall and PATH? [y/N] " confirm
    fi
    if [[ "${confirm:-n}" != [yY]* ]]; then
      printf "\n  ${P}${B}(ᵔᴥᵔ)${R}  ${D}phew! welcome back.${R}\n\n"
      exit 0
    fi
  fi

  printf "\n"
  # Remove the heimdall PATH export via the SHARED surgical remover (matches the
  # marker + the `.local/bin` export install.sh actually writes, and the legacy
  # `.heimdall/bin` line) — so this arm and `hmd uninstall` reverse PATH the SAME
  # way. The old sed here only matched `.heimdall/bin`, never the v2.0.2 `.local/bin`
  # line, so the PATH export survived uninstall.
  _heimdall_remove_path_export
  # Legacy superx PATH lines (pre-heimdall installs) — narrowly matched, kept here
  # because the shared remover intentionally scopes to heimdall artifacts only.
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [ -f "$rc" ] && grep -qE 'superx.*autonomous|\.superx/bin' "$rc"; then
      sed -i '' '/superx.*autonomous/d;/\.superx\/bin/d' "$rc" 2>/dev/null || \
      sed -i '/superx.*autonomous/d;/\.superx\/bin/d' "$rc" 2>/dev/null || true
      printf "  ${D}×${R} legacy superx PATH entry removed from $(basename "$rc")\n"
    fi
  done
  # Reverse the two registrations that live OUTSIDE the install tree, via the same
  # shared removers `hmd uninstall` uses — and BEFORE the tree is deleted, since
  # the LaunchAgent removal delegates to a helper inside it. Both are self-guarding
  # (launchd is touched only for a proven real user; settings.json is spliced only
  # where install wrote).
  _heimdall_remove_dream_schedule
  _heimdall_remove_statusline
  sleep 0.1
  # Remove the plugin dir + entry points via the SHARED guarded path — never an
  # unguarded `rm -rf "$HOME/.heimdall"`. Same guard as `hmd uninstall`.
  _heimdall_remove_plugin
  sleep 0.1
  # Uninstall companion plugins — interactive only (TTY without --yes). In
  # --yes/non-TTY mode skip silently to honor the zero-stdin contract.
  if [ "$ASSUME_YES" -ne 1 ]; then
    # Arrow-key confirm (↑/↓ + Enter, default No); guarded typed fallback.
    plugins=n
    if command -v hmd_confirm >/dev/null 2>&1; then
      hmd_confirm "  Also uninstall companion plugins (caveman, claude-mem)?" && plugins=y
    else
      read -p "  Also uninstall companion plugins (caveman, claude-mem)? [y/N] " plugins
    fi
    if [[ "${plugins:-n}" == [yY]* ]]; then
      claude plugins uninstall caveman 2>/dev/null && printf "  ${D}×${R} caveman removed\n" || true
      claude plugins uninstall superpowers 2>/dev/null && printf "  ${D}×${R} superpowers removed\n" || true
      claude plugins marketplace remove heimdall-marketplace 2>/dev/null && printf "  ${D}×${R} marketplace removed\n" || true
    fi
  fi

  printf "\n"
  printf "  ${D}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}\n"
  sleep 0.1
  printf "  ${D}heimdall uninstalled.${R}\n"
  printf "  ${D}Open a new terminal for PATH changes.${R}\n"
  sleep 0.1
  printf "\n"
  printf "  ${D}Want us back? Just run:${R}\n"
  printf "  ${P}curl -fsSL https://raw.githubusercontent.com/randomittin/heimdall/main/install.sh | bash${R}\n"
  printf "\n"
  printf "  ${D}(╥_╥)  bye bye...${R}\n\n"
  exit 0
fi

# --setup: re-run plugin installation
if [[ "${1:-}" == "--setup" ]]; then
  rm -f "$SETUP_MARKER" "$SETUP_MARKER_LEGACY"
  ensure_node_path
  ensure_claude
  first_run_setup
  ensure_auth
  exit 0
fi

# --resume: continue the last Claude session AND load .planning/ state
if [[ "${1:-}" == "--resume" || "${1:-}" == "-r" ]]; then
  ensure_node_path
  ensure_claude
  first_run_setup
  ensure_auth
  apply_heimdall_theme 2>/dev/null || true
  print_banner 2>/dev/null || true

  # Check for resumable state
  if [ -f "$WORK_DIR/.planning/STATE.md" ]; then
    echo "  ▸ Resuming from .planning/STATE.md"
  fi
  if [ -f "$WORK_DIR/heimdall-state.json" ]; then
    echo "  ▸ heimdall state loaded"
  fi

  # Restore active goal from state or checkpoint
  GOAL_CONDITION=""
  if [ -f "$WORK_DIR/heimdall-state.json" ]; then
    GOAL_CONDITION=$(python3 -c "
import json
try:
    with open('$WORK_DIR/heimdall-state.json') as f:
        s = json.load(f)
    cond = s.get('goal', {}).get('condition')
    if cond: print(cond)
except: pass
" 2>/dev/null)
  fi
  if [ -z "$GOAL_CONDITION" ] && [ -f "$WORK_DIR/.planning/settings.json" ]; then
    GOAL_CONDITION=$(python3 -c "
import json
try:
    with open('$WORK_DIR/.planning/settings.json') as f:
        s = json.load(f)
    cond = s.get('goal', {}).get('condition')
    if cond: print(cond)
except: pass
" 2>/dev/null)
  fi

  # Write preamble for resume
  RESUME_PREAMBLE_FILE=$(mktemp /tmp/heimdall-resume-XXXXXX)
  if [ -n "$GOAL_CONDITION" ]; then
    printf "heimdall resumed.\n\nRESTORE GOAL: A goal was active in the previous session. Restore it immediately:\n/goal %s\n\nThen read .planning/CHECKPOINT.md and continue working." "$GOAL_CONDITION" > "$RESUME_PREAMBLE_FILE"
    printf "  \033[38;2;224;86;160m▸ Goal restored\033[0m\n"
  else
    echo "${PREAMBLE:-heimdall resumed}" > "$RESUME_PREAMBLE_FILE"
  fi

  # Activate project-aware skills
  SKILL_MGR="$PLUGIN_DIR/bin/skill-manager"
  RESTORE_FILE=""
  if [ -x "$SKILL_MGR" ]; then
    "$SKILL_MGR" activate "$WORK_DIR"
    RESTORE_FILE=$("$SKILL_MGR" restore-file)
  fi

  cleanup_resume() {
    rm -f "$RESUME_PREAMBLE_FILE"
    [ -n "$RESTORE_FILE" ] && [ -x "$SKILL_MGR" ] && "$SKILL_MGR" restore "$RESTORE_FILE" 2>/dev/null
  }
  trap cleanup_resume EXIT

  # Main Claude Code agent: never pinned (CLAUDE.md "Model routing" directive) —
  # a resumed session runs on the operator's own configured default, same as a
  # fresh launch (select_model() below), so no --model flag is passed here.
  claude --continue \
    --agent heimdall \
    $PERMISSION_FLAG \
    --plugin-dir "$PLUGIN_DIR" \
    --append-system-prompt-file "$RESUME_PREAMBLE_FILE"
  exit $?
fi

# --team N: spawn N parallel claude workers in tmux panes
if [[ "${1:-}" == "--team" ]]; then
  ensure_node_path
  ensure_claude
  first_run_setup
  ensure_auth
  apply_heimdall_theme 2>/dev/null || true
  print_banner 2>/dev/null || true

  TEAM_SIZE="${2:-3}"
  shift 2 || shift 1
  TASK="${*:-}"

  if ! command -v tmux &>/dev/null; then
    echo "  tmux not found. Install: brew install tmux (macOS) / apt install tmux (Linux)"
    exit 1
  fi

  SESSION="heimdall-team-$$"
  echo "  Spawning $TEAM_SIZE workers in tmux session: $SESSION"

  # Main Claude Code agent: never pinned (CLAUDE.md "Model routing" directive) —
  # each team pane is another instance of the heimdall persona, so it runs on
  # the operator's own configured default, exactly like a solo launch. No
  # --model flag here, same reasoning as select_model() below.
  tmux new-session -d -s "$SESSION" -n "lead"
  # Lead worker gets the task
  tmux send-keys -t "$SESSION:lead" "cd $WORK_DIR && claude --agent heimdall $PERMISSION_FLAG --plugin-dir $PLUGIN_DIR" Enter

  # Spawn additional worker panes
  for i in $(seq 2 "$TEAM_SIZE"); do
    tmux split-window -t "$SESSION" -h
    tmux send-keys -t "$SESSION" "cd $WORK_DIR && claude --agent heimdall $PERMISSION_FLAG --plugin-dir $PLUGIN_DIR" Enter
    tmux select-layout -t "$SESSION" tiled
  done

  if [ -n "$TASK" ]; then
    sleep 2
    tmux send-keys -t "$SESSION:lead.0" "$TASK" Enter
  fi

  echo "  Attach: tmux attach -t $SESSION"
  echo "  Detach: Ctrl+B then D"
  exec tmux attach -t "$SESSION"
fi

