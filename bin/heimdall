    # so a routed run and a direct bin run are byte-identical.
    shift
    CHECK_BIN="$PLUGIN_DIR/bin/heimdall-check"
    if [ ! -x "$CHECK_BIN" ]; then
      echo "  Error: heimdall-check not found at $CHECK_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$CHECK_BIN" "$@"
    ;;
  redum)
    # Pass-through to bin/heimdall-redum (F3 Redum — the redundancy solver;
    # see that bin's own --help for the `factor`/`gate` subcommands). README's
    # "Redum / conformance checker" row names this exact command; before this
    # arm existed, `hmd redum` fell through to the goal-driven task prompt
