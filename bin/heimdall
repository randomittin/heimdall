  echo "  heimdall --skip-checkpoint Start fresh, ignore last checkpoint/settings"
  echo "  heimdall --no-autocommit  Disable auto git commits for this project"
  echo "  heimdall --autocommit     Re-enable auto git commits"
  echo "  heimdall --skills         Manage skills + plugins (auto per-project)"
  echo "  heimdall --update         Pull latest heimdall from GitHub"
  echo "  heimdall --setup          Re-run first-time plugin setup"
  echo "  heimdall --team N \"task\"  Spawn N parallel Claude workers in tmux"
  echo "  heimdall --reinstall      Nuke and re-clone from GitHub (fixes zombie states)"
  echo "  heimdall --uninstall      Remove heimdall completely (add --yes for non-interactive)"
  echo "  heimdall --help           Show this help"
  echo ""
  echo "heimdall launches Claude Code with:"
  echo "  --dangerously-skip-permissions    full autonomy"
  echo "  --plugin-dir <heimdall>            heimdall agents + skills"
  echo "  --agent heimdall                   CTO-level orchestrator"
  echo "  + caveman (token compression)    ~65-75% savings"
  echo "  + superpowers (brainstorming)    design + debug skills"
