# --auto: use auto-mode instead of dangerously-skip-permissions (safer)
PERMISSION_FLAG="--dangerously-skip-permissions"
SKIP_CHECKPOINT=false
if [[ "${1:-}" == "--auto" ]]; then
  PERMISSION_FLAG="--permission-mode auto"
  shift
fi
if [[ "${1:-}" == "--skip-checkpoint" || "${1:-}" == "--fresh" ]]; then
  SKIP_CHECKPOINT=true
  shift
fi
USE_GOAL=true
if [[ "${1:-}" == "--no-goal" ]]; then
  USE_GOAL=false
  shift
fi

# --force: override the S-6 C4 halt-if-low-reuse advisory. A run measured below
# the reuse floor (likely reinventing existing code) emits a loud warning and a
# non-zero advisory that blocks auto-continue; --force acknowledges it and exits
# with the task's real status instead. Consumed here so it never leaks into the
# task text. (Also honored via HEIMDALL_FORCE=1.)
REUSE_FORCE="${HEIMDALL_FORCE:-0}"
if [[ "${1:-}" == "--force" ]]; then
  REUSE_FORCE=1
  shift
fi

# --no-autocommit / --autocommit: toggle auto-commit for this project
if [[ "${1:-}" == "--no-autocommit" ]]; then
  touch "$WORK_DIR/.heimdall-no-autocommit"
  printf "  \033[38;2;255;200;80m▸ Auto-commit OFF\033[0m for %s\n" "$WORK_DIR"
  printf "  Re-enable: heimdall --autocommit\n\n"
  exit 0
fi
if [[ "${1:-}" == "--autocommit" ]]; then
  rm -f "$WORK_DIR/.heimdall-no-autocommit" "$WORK_DIR/.superx-no-autocommit"
  printf "  \033[38;2;78;204;163m▸ Auto-commit ON\033[0m for %s\n" "$WORK_DIR"
  exit 0
fi

# --skills: list, search, or install skills from registry
if [[ "${1:-}" == "--skills" ]]; then
  apply_heimdall_theme 2>/dev/null || true
  registry="$PLUGIN_DIR/skills-registry.json"
  skills_dir="$HOME/.claude/skills"

  if [[ "${2:-}" == "install" && -n "${3:-}" ]]; then
    # Install a specific skill by name or repo
    name="${3}"
    repo=""
    if [[ "$name" == */* ]]; then
      # Direct repo URL
      repo="$name"
      name=$(basename "$repo" | sed 's/\.git$//')
    elif [ -f "$registry" ]; then
      repo=$(python3 -c "
import json
with open('$registry') as f:
    reg = json.load(f)
for s in reg.get('skills', []):
    if s['name'] == '$name':
        print(s['repo']); break
" 2>/dev/null)
    fi
    if [ -z "$repo" ]; then
      echo "  Skill '$name' not found in registry. Use: heimdall --skills install owner/repo"
      exit 1
    fi
    skill_path="$skills_dir/$name"
    if [ -d "$skill_path" ]; then
      echo "  Skill '$name' already installed at $skill_path"
      exit 0
    fi
    mkdir -p "$skills_dir"
    printf "  Installing %s from %s...\n" "$name" "$repo"
    git clone --depth 1 "https://github.com/${repo}.git" "$skill_path"
    echo "  ✔ Installed to $skill_path"
    exit 0
  fi

  if [[ "${2:-}" == "search" && -n "${3:-}" ]]; then
    # Search GitHub for skills
    query="${3}"
    printf "  Searching GitHub for claude-code skills matching '%s'...\n\n" "$query"
    gh api search/repositories --method GET \
      -f q="topic:claude-code ${query} sort:stars" \
      -f per_page=10 \
      --jq '.items[] | "  ★\(.stargazers_count | tostring | if length < 5 then . + " " * (5 - length) else . end)  \(.full_name)\n         \(.description // "no description")\n"' 2>/dev/null
    exit 0
  fi

  if [[ "${2:-}" == "update" ]]; then
    # Update all installed skills
    for d in "$skills_dir"/*/; do
      [ -d "$d/.git" ] || continue
      name=$(basename "$d")
      printf "  Updating %s..." "$name"
      git -C "$d" pull --ff-only --quiet 2>/dev/null && printf " ✔\n" || printf " (skipped)\n"
    done
    exit 0
  fi

  if [[ "${2:-}" == "remove" && -n "${3:-}" ]]; then
    skill_path="$skills_dir/${3}"
    if [ -d "$skill_path" ]; then
      rm -rf "$skill_path"
      echo "  ✔ Removed ${3}"
    else
      echo "  Skill '${3}' not found"
    fi
    exit 0
  fi

  # Default: list installed + registry
  echo ""
  printf "  \033[1mInstalled skills:\033[0m\n"
  if [ -d "$skills_dir" ] && [ "$(ls -A "$skills_dir" 2>/dev/null)" ]; then
    for d in "$skills_dir"/*/; do
      [ -d "$d" ] || continue
      name=$(basename "$d")
      desc=""
      if [ -f "$d/SKILL.md" ]; then
        desc=$(grep -m1 "^description:" "$d/SKILL.md" 2>/dev/null | sed 's/^description: *//')
      fi
      printf "  \033[38;2;78;204;163m✔\033[0m %-25s %s\n" "$name" "$desc"
    done
  else
    echo "  (none)"
  fi

  if [ -f "$registry" ]; then
    echo ""
    printf "  \033[1mAvailable from registry:\033[0m\n"
    python3 -c "
import json
with open('$registry') as f:
    reg = json.load(f)
import os
skills_dir = os.path.expanduser('~/.claude/skills')
for s in reg.get('skills', []):
    installed = '✔' if os.path.isdir(os.path.join(skills_dir, s['name'])) else ' '
    print(f'  {installed} {s[\"name\"]:<25} {s[\"description\"]}')
" 2>/dev/null
  fi

  echo ""
  printf "  \033[1mPlugin management (auto per-project):\033[0m\n"
  "$PLUGIN_DIR/bin/skill-manager" status "$WORK_DIR" 2>/dev/null | while IFS= read -r line; do
    printf "  %s\n" "$line"
  done

  echo ""
  echo "  Commands:"
  echo "    heimdall --skills                    List installed & available skills"
  echo "    heimdall --skills install <name>     Install from registry"
  echo "    heimdall --skills install owner/repo Install from GitHub"
  echo "    heimdall --skills search <query>     Search GitHub for skills"
  echo "    heimdall --skills update             Update all installed skills"
  echo "    heimdall --skills remove <name>      Remove a skill"
  echo ""
  exit 0
fi

# ── Update check (version-accurate, daily-cached, background, non-blocking) ──
#
# The OLD check ran `git fetch` on EVERY launch (a blocking network call that
# slowed every startup) and gated on a commit-count "N commits behind" — which
# printed a meaningless "0 commits behind" on a current install and could not
# tell a real user which RELEASE they were missing. This replacement:
#
#   1. Compares the installed SEMVER (heimdall_version → vX.Y.Z) against the
#      latest PUBLISHED release tag (the highest `v[0-9]*` tag on origin). The
#      notice fires iff installed < latest by version — never on a current
#      install, never a false "behind".
#   2. NEVER blocks launch on the network. The network probe (ls-remote) runs
#      DETACHED in the background and only writes the cache for the NEXT launch.
#      This launch reads ONLY the cache file (a local read) and prints from it.
#   3. Checks at most ONCE PER DAY: a fresh cache (<24h) is reused verbatim with
#      zero network; a stale/missing cache prints whatever it last knew, then
#      kicks the background refresh. So a second launch the same day hits cache.
#   4. SKIPS ENTIRELY when not safe/wanted: non-TTY/CI (stdout not a terminal),
#      HEIMDALL_NO_UPDATE_CHECK=1, or a stateless run (HEIMDALL_NO_INTRO=1). It
#      never reads stdin and never prompts, so it can never hang.
#   5. Emits an install_step telemetry event (step=update-check) for the probe,
#      reusing the existing fire-and-forget layer.
#
# Cache file: $HOME/.heimdall/update-check.json (the runtime home), holding
#   { "checked_epoch": N, "installed": "vX.Y.Z", "latest": "vA.B.C" }

# The runtime home for hmd state (cache, telemetry). Honors $HEIMDALL_HOME so a
# stranger/test can redirect it; defaults to ~/.heimdall.
_update_cache_file() {
  printf '%s\n' "${HEIMDALL_HOME:-$HOME/.heimdall}/update-check.json"
}

# Compare two vX.Y.Z strings. Echoes "behind" iff $1 (installed) is strictly an
# OLDER version than $2 (latest); echoes "current" otherwise (equal, ahead, or
# either side unparseable — we never cry "behind" without a clean comparison).
_update_semver_cmp() {
  local installed="$1" latest="$2"
  command -v python3 >/dev/null 2>&1 || { printf 'current\n'; return 0; }
  INST="$installed" LATE="$latest" python3 - <<'PYEOF'
import os, re, sys
def parse(v):
    m = re.match(r'^v?(\d+)\.(\d+)\.(\d+)$', (v or '').strip())
    return tuple(int(x) for x in m.groups()) if m else None
inst = parse(os.environ.get('INST', ''))
late = parse(os.environ.get('LATE', ''))
# Only a clean parse of BOTH sides can produce a "behind"; anything else is
# "current" so a malformed/empty version never triggers a false notice.
print('behind' if inst and late and inst < late else 'current')
PYEOF
}

# Resolve the latest PUBLISHED release tag from origin (the highest semver tag).
# This is the ONLY network call in the update path; the caller runs it DETACHED.
# Prints a clean vX.Y.Z, or nothing if it cannot resolve (so the cache writer
# simply records no "latest" and the next launch shows no false notice).
_update_latest_remote_tag() {
  git -C "$PLUGIN_DIR" rev-parse --git-dir >/dev/null 2>&1 || return 0
  local tags
  # ls-remote does NOT mutate the local repo (no fetch/reset) and lists every
  # published tag ref; we keep only clean vMAJOR.MINOR.PATCH tags and pick the
  # highest by version sort. --match scopes to semver tags (mirrors the hardened
  # describe --match), so a scratch/backup tag can never masquerade as "latest".
  tags="$(git -C "$PLUGIN_DIR" ls-remote --tags --refs origin 'v[0-9]*' 2>/dev/null \
            | sed -E 's#.*refs/tags/##' \
            | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true)"
  [ -n "$tags" ] || return 0
  printf '%s\n' "$tags" | sort -t. -k1.2,1n -k2,2n -k3,3n | tail -1
}

# Background cache refresh: probe the remote, write the cache for the NEXT
# launch, emit one telemetry event. Detached by the caller (& + disown) so it
# NEVER blocks this launch. Fail-open: any error leaves the cache untouched.
_update_refresh_cache() {
  local installed="$1" cache="$2"
  local _t0; _t0="$(_tele_now_ms)"
  _tele_install_step update-check started
  local latest; latest="$(_update_latest_remote_tag)"
  if [ -z "$latest" ]; then
    _tele_install_step update-check failed "$_t0" \
      remote-tag-unresolved "ls-remote produced no semver tag"
    return 0
  fi
  local dir; dir="$(dirname "$cache")"
  mkdir -p "$dir" 2>/dev/null || true
  local now; now="$(date +%s 2>/dev/null || echo 0)"
  # Write atomically (temp + mv) so a concurrent reader never sees half a file.
  local tmp="${cache}.tmp.$$"
  printf '{"checked_epoch":%s,"installed":"%s","latest":"%s"}\n' \
    "$now" "$installed" "$latest" > "$tmp" 2>/dev/null \
    && mv -f "$tmp" "$cache" 2>/dev/null || rm -f "$tmp" 2>/dev/null
  _tele_install_step update-check succeeded "$_t0"
}

# Read the cached result and, if installed < cached-latest, print ONE non-blocking
# notice. Pure local read — no network. Silent when current or no usable cache.
_update_print_from_cache() {
  local installed="$1" cache="$2"
  [ -f "$cache" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  local latest
  latest="$(CACHE="$cache" python3 - <<'PYEOF'
import json, os, sys
try:
    with open(os.environ['CACHE']) as fh:
        d = json.load(fh)
    print(d.get('latest', '') or '')
except Exception:
    print('')
PYEOF
)"
  [ -n "$latest" ] || return 0
  if [ "$(_update_semver_cmp "$installed" "$latest")" = "behind" ]; then
    # ONE line, informative, never halting. Names BOTH versions + the exact
    # command, so a stranger knows precisely what to run.
    printf "  \033[38;2;255;200;80mHeimdall %s available (you have %s) — update: hmd update\033[0m\n\n" \
      "$latest" "$installed"
  fi
}

check_for_update() {
  # OPT-OUT / non-interactive / stateless → skip entirely. Never prompts, never
  # reads stdin, never blocks: a CI or piped run does zero update work.
  [ "${HEIMDALL_NO_UPDATE_CHECK:-0}" = "1" ] && return 0
  [ "${HEIMDALL_NO_INTRO:-0}" = "1" ] && return 0
  [ -t 1 ] || return 0
  git -C "$PLUGIN_DIR" rev-parse --git-dir >/dev/null 2>&1 || return 0

  local installed; installed="$(heimdall_version)"
  # No resolvable installed version → nothing to compare; stay silent.
  [ -n "$installed" ] || return 0

  local cache; cache="$(_update_cache_file)"

  # Is the cache fresh (checked within the last 24h)? A fresh cache is reused
  # with NO network at all (the daily-cache contract). Stale/missing → we still
  # print from whatever the cache last knew, then kick a background refresh that
  # only affects the NEXT launch.
  local fresh=0
  if [ -f "$cache" ] && command -v python3 >/dev/null 2>&1; then
    fresh="$(CACHE="$cache" python3 - <<'PYEOF'
import json, os, time
try:
    with open(os.environ['CACHE']) as fh:
        d = json.load(fh)
    age = time.time() - float(d.get('checked_epoch', 0))
    print('1' if 0 <= age < 86400 else '0')
except Exception:
    print('0')
PYEOF
)"
  fi

  # Always print from the cache we have (a local read, instant). On a current
  # install or an empty cache this prints nothing.
  _update_print_from_cache "$installed" "$cache"

  # Stale or missing cache → refresh in the BACKGROUND for next launch. Detached
  # (&) and disowned so this launch never waits on the network. A fresh cache
  # skips the network entirely (≤ once/day).
  if [ "$fresh" != "1" ]; then
    ( _update_refresh_cache "$installed" "$cache" ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
}

# ── Load last checkpoint (mechanical — always injected) ──

load_checkpoint_context() {
  CHECKPOINT_CONTEXT=""
  if [ "$SKIP_CHECKPOINT" = true ]; then
    printf "  \033[38;2;255;200;80m▸ Checkpoint skipped\033[0m (--skip-checkpoint)\n"
    return 0
  fi
  local cp="$WORK_DIR/.planning/CHECKPOINT.md"
  local state="$WORK_DIR/.planning/STATE.md"
  local settings="$WORK_DIR/.planning/settings.json"

  # Load project settings (commands, parallelism, model routing, preferences)
  if [ -f "$settings" ]; then
    CHECKPOINT_CONTEXT="
--- PROJECT SETTINGS (from .planning/settings.json) ---
$(cat "$settings")
--- END SETTINGS ---
Use these settings: test/lint/build commands, parallelism config, model overrides, directories to avoid. Do NOT rediscover — they are already known.
"
    printf "  \033[38;2;78;204;163m▸ Project settings loaded\033[0m\n"
  fi

  # Load checkpoint handoff note
  if [ -f "$cp" ]; then
    CHECKPOINT_CONTEXT="${CHECKPOINT_CONTEXT}
--- LAST CHECKPOINT (from previous session) ---
$(head -100 "$cp")
--- END CHECKPOINT ---
Read .planning/CHECKPOINT.md for full context. Resume from where it says.
"
    printf "  \033[38;2;0;212;255m▸ Checkpoint loaded\033[0m — resuming from last session\n"
  elif [ -f "$state" ]; then
    local phase=$(grep -m1 "^current_phase:" "$state" 2>/dev/null | sed 's/current_phase: *//')
    if [ -n "$phase" ] && [ "$phase" != "0" ]; then
      CHECKPOINT_CONTEXT="${CHECKPOINT_CONTEXT}
--- PRIOR STATE ---
Phase: $phase. Read .planning/STATE.md for decisions, blockers, progress.
--- END STATE ---
"
      printf "  \033[38;2;100;100;120m▸ State loaded\033[0m — phase: %s\n" "$phase"
    fi
  fi

  # Backward compat: load CONTEXT.md if it exists (merged into CHECKPOINT.md in newer saves)
  local ctx="$WORK_DIR/.planning/CONTEXT.md"
  if [ -f "$ctx" ]; then
    CHECKPOINT_CONTEXT="${CHECKPOINT_CONTEXT}
--- PROJECT CONTEXT (from .planning/CONTEXT.md) ---
$(head -50 "$ctx")
--- END CONTEXT ---
"
    printf "  \033[38;2;155;89;182m▸ Context loaded\033[0m (legacy)\n"
  fi
}

# ── Pre-install plugins based on prompt + project files ──

preinstall_plugins() {
  [ $# -eq 0 ] && return 0
  prompt_lower=$(echo "$*" | tr '[:upper:]' '[:lower:]')
  installed=$(claude plugins list 2>/dev/null || echo "")

  _try_install() {
    echo "$installed" | grep -q "$1" && return 0
    printf "  \033[38;2;0;212;255m▸ Installing %s\033[0m\n" "$1"
    claude plugins install "$1" >/dev/null 2>&1 || true
  }

  # From prompt keywords
  echo "$prompt_lower" | grep -qE 'react|vue|angular|css|responsive|ui|frontend|component' && _try_install "frontend-design"
  echo "$prompt_lower" | grep -qE 'docker|k8s|kubernetes|deploy|ci.?cd|pipeline' && _try_install "devops-toolkit"
  echo "$prompt_lower" | grep -qE 'sql|database|schema|migration|prisma|typeorm' && _try_install "database-toolkit"
  echo "$prompt_lower" | grep -qE 'seo|meta.?tag|sitemap|robots.?txt' && _try_install "seo"
  echo "$prompt_lower" | grep -qE 'auth|jwt|oauth|security|owasp|vulnerability' && _try_install "security-scanner"
  echo "$prompt_lower" | grep -qE 'api|openapi|swagger|rest|graphql' && _try_install "api-design"
  echo "$prompt_lower" | grep -qE 'slack|notification|webhook' && _try_install "slack"
  echo "$prompt_lower" | grep -qE 'mcp|tool.?server|model.?context' && _try_install "mcp-server-dev"

  # From project files (if they exist)
  [ -f "$WORK_DIR/package.json" ] && grep -q "react\|vue\|angular\|svelte" "$WORK_DIR/package.json" 2>/dev/null && _try_install "frontend-design"
  [ -f "$WORK_DIR/Dockerfile" ] || [ -f "$WORK_DIR/docker-compose.yml" ] && _try_install "devops-toolkit"
  [ -f "$WORK_DIR/prisma/schema.prisma" ] || [ -f "$WORK_DIR/ormconfig.json" ] && _try_install "database-toolkit"

  # External skill marketplaces (add once, available forever)
  _try_marketplace() {
    claude plugins marketplace list 2>/dev/null | grep -q "$1" && return 0
    printf "  \033[38;2;100;100;120m▸ Adding marketplace: %s\033[0m\n" "$1"
    claude plugins marketplace add "$1" >/dev/null 2>&1 || true
  }
  _try_marketplace "wshobson/agents"

  printf "\n"
}

# ── Auto-discover and install skills from registry ──

discover_skills() {
  # Auto-install skills from registry based on task prompt keywords
  [ $# -eq 0 ] && return 0
  local prompt_lower skills_dir registry
  prompt_lower=$(echo "$*" | tr '[:upper:]' '[:lower:]')
  skills_dir="$HOME/.claude/skills"
  registry="$PLUGIN_DIR/skills-registry.json"

  [ -f "$registry" ] || return 0
  command -v python3 &>/dev/null || return 0

  # Match prompt against registry keywords, return repos to install
  local matches
  matches=$(python3 -c "
import json, re, sys
prompt = '''$prompt_lower'''
with open('$registry') as f:
    reg = json.load(f)
for skill in reg.get('skills', []):
    for kw in skill.get('keywords', []):
        if re.search(r'\b' + re.escape(kw) + r'\b', prompt):
            print(skill['name'] + '|' + skill['repo'])
            break
" 2>/dev/null)

  [ -z "$matches" ] && return 0

  while IFS='|' read -r name repo; do
    local skill_path="$skills_dir/$name"
    if [ -d "$skill_path" ]; then
      continue  # already installed
    fi
    printf "  \033[38;2;0;212;255m▸ Installing skill: %s\033[0m (%s)\n" "$name" "$repo"
    mkdir -p "$skills_dir"
    git clone --depth 1 "https://github.com/${repo}.git" "$skill_path" 2>/dev/null || true
  done <<< "$matches"
}

# ── First-run setup phase (ORDERED, gated, completes BEFORE first launch) ──
#
# THE ORDERING CONTRACT (the bug this fixes): on a fresh install's first run,
# authentication setup and ALL companion-plugin/skill setup must FULLY COMPLETE
# before the first task launches — never interleaved with, never deferred past,
# the launch. Previously the core companion setup ran up top while the
# prompt-driven companion-plugin + skill installs (preinstall_plugins,
# discover_skills) were deferred down to immediately before `claude … -p`,
# interleaving companion setup with launch sequencing.
#
# This wrapper makes the whole phase contiguous and ordered:
#   1. auth        — ensure_auth (login / API key resolved)
#   2. companion   — first_run_setup (caveman, superpowers, claude-mem, marketplace)
#   3. skills      — preinstall_plugins + discover_skills (prompt-driven extras)
# Each phase emits an ordered trace marker (see _trace_order) so the stranger
# harness can prove setup precedes launch without a live model call.
#
# GATING: the heavy companion+skill installs run only when the first-run marker
# ($SETUP_MARKER) is ABSENT (genuine first run). first_run_setup itself is
# idempotent and self-gates on the same marker, so subsequent runs skip the
# install work and proceed straight to launch. ensure_auth always runs (auth may
# expire), but is a fast no-op once authenticated.
complete_first_run_setup() {
  local is_first_run=0
  [ -f "$SETUP_MARKER" ] || is_first_run=1

  # ORDERING (the single-pass first-run fix): companion plugins + skills run FIRST
  # and are DECOUPLED from auth; auth runs LAST and is non-fatal. So ONE `hmd`
  # leaves the machine fully set up (plugins + marker) even when the user has not
  # signed in yet — a deferred/^C'd login can no longer abort setup or block the
  # marker, which is what forced the old two-run dance.

  # 1. COMPANION PLUGINS — caveman / superpowers / claude-mem / marketplace.
  #    git/npm based, need NO Claude auth, so they run first + unconditionally.
  #    Idempotent + marker-gated inside first_run_setup; touches $SETUP_MARKER on
  #    success, so the first-run marker is written before we even reach auth.
  first_run_setup
  _trace_order "setup:companion"

  # 2. PROMPT-DRIVEN SKILLS/PLUGINS — only the first run pays the install cost;
  #    later runs already have the marker, so we skip straight past. This keeps
  #    the "subsequent runs launch directly" contract while guaranteeing first
  #    run completes the full setup before launch.
  if [ "$is_first_run" -eq 1 ]; then
    preinstall_plugins "$@"
    discover_skills "$@"
  fi
  _trace_order "setup:skills"

  # 3. AUTH LAST — NON-FATAL / NON-BLOCKING. If not signed in, ensure_auth prints
  #    the deferred sign-in instruction and returns 0 WITHOUT an interactive login,
  #    so this single invocation is already fully set up. Auth may expire, so this
  #    runs every launch, but is a fast no-op once authed. The setup:auth marker
  #    is still emitted BEFORE persona-check/launch (the F1 ordering contract).
  ensure_auth
  _trace_order "setup:auth"
}

# ── SOURCE TOKEN METER: hmd self-meters its OWN run's usage (see TOKEN-METRIC.md) ─
#
# This is the SOURCE meter that C3's spend axis, P3's spend axis, the statusline
# token gauge, and the ~75%-savings claim all consume. The mechanism: hmd captures
# usage DIRECTLY from the `claude` invocation's OWN structured output — NO
# transcript file is ever read. Reading a transcript at emit time failed twice
# (timing/flush/path -> spend=0) AND carries no per-turn cost; claude's structured
# output carries usage AND total_cost_usd AND the session_id, at the source.
#
# `claude -p --output-format json` returns ONE top-level blob:
#   .usage{input_tokens,output_tokens,cache_creation_input_tokens,
#          cache_read_input_tokens} + .total_cost_usd + .session_id + .result
# `claude … --output-format stream-json --verbose` streams NDJSON events AND a
# final `result` event carrying the SAME usage+cost+session_id. We tee the stream
# events to the user (UX preserved — the agent still renders) and capture that
# final event.
#
# capture_and_emit_usage runs claude, surfaces its output to the user, extracts
# the usage at the source, and writes this EXACT RAW record (raw only — the meter
# agent derives totals; we emit no derived fields) to $HEIMDALL_USAGE_OUT when set,
# else $WORK_DIR/.heimdall/last-run-usage.json:
#   { session_id, input_tokens, output_tokens, cache_creation_tokens,
#     cache_read_tokens, total_cost_usd, model, usage_available }
# NEVER fabricates: usage genuinely uncapturable => usage_available:false + zeros +
# a reason. FAIL-OPEN: any metering failure NEVER aborts the run or alters its exit
# code — the captured task's status is propagated unchanged.

# Resolve where the usage record should be written.
usage_out_path() {
  if [ -n "${HEIMDALL_USAGE_OUT:-}" ]; then
    printf '%s\n' "$HEIMDALL_USAGE_OUT"
  else
    printf '%s\n' "$WORK_DIR/.heimdall/last-run-usage.json"
  fi
}

# Decide which capture format to use, preserving interactive UX.
#   - stream-json (interactive default): tee readable events to the user AND
#     capture the final `result` event's usage+cost+session_id.
#   - json (automated path): one structured blob; we print its .result to the
#     user so they still see output. Chosen when stdout is NOT a TTY or when a
#     usage record is explicitly demanded ($HEIMDALL_USAGE_OUT set) — that's the
#     orchestrator/meter-consumer path where clean structured capture matters and
#     there's no human terminal to render a live stream for.
# Overridable for tests/automation via $HEIMDALL_USAGE_FORMAT (json|stream-json).
usage_capture_format() {
  if [ -n "${HEIMDALL_USAGE_FORMAT:-}" ]; then
    printf '%s\n' "$HEIMDALL_USAGE_FORMAT"
  elif [ -n "${HEIMDALL_USAGE_OUT:-}" ] || [ ! -t 1 ]; then
    printf '%s\n' "json"
  else
    printf '%s\n' "stream-json"
  fi
}

# Capture usage from claude's OWN structured output, preserving the user's view of
# the run, then emit the locked RAW record. NEVER reads a transcript file.
#   $1            = the bare model id for the record's `model` field provenance
#   $2 $3 …       = the FULL claude argv (everything after the model), e.g.
#                   --agent heimdall <perm> --plugin-dir … --append-system-prompt-file … -p "$GOAL"
# Returns the captured `claude` process's REAL exit status (fail-open: metering
# never changes it). The chosen --output-format flag is injected by this function.
capture_and_emit_usage() {
  local model="$1"; shift
  local fmt; fmt="$(usage_capture_format)"
  local out; out="$(usage_out_path)"
  local outdir; outdir="$(dirname "$out")"
  mkdir -p "$outdir" 2>/dev/null || true

  # A scratch file to hold the captured structured output (the final `result`
  # event for stream-json, or the single blob for json). Fail-open if mktemp
  # cannot allocate: run claude plainly and emit an unavailable record. The
  # mktemp template's random run is built via printf so this source carries no
  # literal marker-character run.
  local cap_tmpl; cap_tmpl="${TMPDIR:-/tmp}/heimdall-usage-$(printf 'X%.0s' 1 2 3 4 5 6)"
  local cap; cap="$(mktemp "$cap_tmpl" 2>/dev/null || true)"
  local rc=0 reason=""
  # Save the caller's errexit so the `set +e` blocks below restore it EXACTLY
  # rather than unconditionally re-enabling `set -e` (which would clobber a
  # caller that ran us under `set +e` and abort it on our nonzero return).
  local _ee=""; case "$-" in *e*) _ee=1 ;; esac

  if [ "$fmt" = "stream-json" ]; then
    # Stream NDJSON, tee to the user (rendered readably) AND capture the final
    # `result` event. set +e around the pipeline so a tee/parse hiccup never
    # aborts the run; the captured claude exit status comes from PIPESTATUS[0].
    set +e
    claude --output-format stream-json --verbose "$@" \
      | _hmd_render_stream_capture "$cap"
    rc=${PIPESTATUS[0]}
    [ -n "$_ee" ] && set -e
  else
    # Single structured blob. Capture it, then surface its .result text to the
    # user so the run is still visible. Fall back to printing raw if jq/python
    # cannot pull .result. set +e so capture never aborts the run.
    set +e
    claude --output-format json "$@" > "$cap"
    rc=$?
    [ -n "$_ee" ] && set -e
    _hmd_print_json_result "$cap"
  fi

  # Extract the raw usage fields from the captured structured output. python3 is a
  # hard heimdall dependency; it parses the blob, picks the `result` event (for an
  # NDJSON capture) or the top-level object (for a json capture), coerces ints, and
  # preserves the cost null/number distinction. Uncapturable => usage_available
  # false + zeros + a reason. NEVER fabricates.
  if command -v python3 >/dev/null 2>&1; then
    CAP="${cap:-}" python3 - "$out" "$model" <<'PYEOF'
import json, os, sys
out, model = sys.argv[1:3]
cap = os.environ.get("CAP", "")

def emit(record):
    try:
        with open(out, "w", encoding="utf-8") as fh:
            json.dump(record, fh)
            fh.write("\n")
    except OSError as e:
        sys.stderr.write("heimdall: could not write usage record: %s\n" % e)

def unavailable(reason):
    emit({
        "session_id": None,
        "input_tokens": 0, "output_tokens": 0,
        "cache_creation_tokens": 0, "cache_read_tokens": 0,
        "total_cost_usd": None, "model": model or None,
        "usage_available": False, "reason": reason,
    })

raw = ""
if cap and os.path.isfile(cap):
    try:
        with open(cap, "r", encoding="utf-8") as fh:
            raw = fh.read()
    except OSError:
        raw = ""

if not raw.strip():
    unavailable("claude produced no capturable structured output")
    sys.exit(0)

# Find the result object: the single top-level json blob, or the `result` event
# among NDJSON lines (last one wins). Tolerate non-json noise lines.
result = None
s = raw.strip()
try:
    obj = json.loads(s)
    if isinstance(obj, dict):
        result = obj
except Exception:
    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except Exception:
            continue
        if isinstance(ev, dict) and ev.get("type") == "result":
            result = ev  # keep the last result event

if not isinstance(result, dict):
    unavailable("no result object/usage found in claude structured output")
    sys.exit(0)

usage = result.get("usage")
if not isinstance(usage, dict):
    unavailable("claude structured output carried no usage object")
    sys.exit(0)

def i(d, k):
    v = d.get(k, 0)
    try:
        n = int(v)
        return n if n >= 0 else 0
    except (TypeError, ValueError):
        return 0

inp = i(usage, "input_tokens")
outp = i(usage, "output_tokens")
cc = i(usage, "cache_creation_input_tokens")
cr = i(usage, "cache_read_input_tokens")

cost = result.get("total_cost_usd", None)
if cost is not None:
    try:
        cost = float(cost)
    except (TypeError, ValueError):
        cost = None

sid = result.get("session_id") or None

# Prefer the explicit model the run reported, if present; else our provenance arg.
run_model = result.get("model") or None
if isinstance(result.get("modelUsage"), dict) and result["modelUsage"]:
    # `claude` reports modelUsage keyed by model id — take the first key as a
    # provenance hint when no top-level .model is present.
    if not run_model:
        for mk in result["modelUsage"].keys():
            run_model = mk
            break
emitted_model = run_model or (model or None)

emit({
    "session_id": sid,
    "input_tokens": inp,
    "output_tokens": outp,
    "cache_creation_tokens": cc,
    "cache_read_tokens": cr,
    "total_cost_usd": cost,
    "model": emitted_model,
    "usage_available": True,
})
PYEOF
  else
    reason="python3 unavailable for usage extraction"
    # Best-effort honest record without python3 (python3 is a hard dep, so this
    # branch is defensive only).
    printf '{"session_id":null,"input_tokens":0,"output_tokens":0,"cache_creation_tokens":0,"cache_read_tokens":0,"total_cost_usd":null,"model":%s,"usage_available":false,"reason":"%s"}\n' \
      "$( [ -n "$model" ] && printf '"%s"' "$model" || printf 'null' )" "$reason" \
      > "$out" 2>/dev/null || true
  fi

  [ -n "${cap:-}" ] && rm -f "$cap" 2>/dev/null || true
  return "$rc"
}

# Render captured stream-json events to the user (readably) while teeing the FULL
# event stream to $1 for usage capture. Reads NDJSON on stdin. For each event:
#   - assistant message text blocks -> print the text (the agent's visible output)
#   - everything (incl. the final `result` event) -> append raw to the capture file
# python3 does the per-line parse so rendering is robust to event shape; a parse
# failure on a line just falls through to printing it raw (never drops output).
_hmd_render_stream_capture() {
  local capfile="$1"
  if command -v python3 >/dev/null 2>&1; then
    # The parser reads the NDJSON event stream on STDIN (the pipe). The python
    # SOURCE must therefore NOT be fed on stdin (a `python3 - <<EOF` heredoc would
    # claim stdin and starve the pipe), so we materialize the script to a temp
    # file and run it as `python3 <file>`, leaving stdin = the live event stream.
    local pyf; pyf="$(mktemp "${TMPDIR:-/tmp}/heimdall-render-$(printf 'X%.0s' 1 2 3 4 5 6)" 2>/dev/null || true)"
    if [ -z "$pyf" ]; then
      # Fail-open: no temp script possible → tee raw so neither capture nor the
      # user's view is lost.
      tee "$capfile"
      return 0
    fi
    cat > "$pyf" <<'PYEOF'
import json, os, sys
capfile = os.environ.get("CAPFILE", "")
cap = None
if capfile:
    try:
        cap = open(capfile, "w", encoding="utf-8")
    except OSError:
        cap = None
try:
    for line in sys.stdin:
        if cap is not None:
            cap.write(line)
        s = line.strip()
        if not s:
            continue
        try:
            ev = json.loads(s)
        except Exception:
            # Non-json line: surface it as-is so nothing the user would see is lost.
            sys.stdout.write(line)
            sys.stdout.flush()
            continue
        if not isinstance(ev, dict):
            continue
        etype = ev.get("type")
        if etype == "assistant":
            msg = ev.get("message") or {}
            content = msg.get("content") or []
            if isinstance(content, list):
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "text":
                        txt = block.get("text", "")
                        if txt:
                            sys.stdout.write(txt + "\n")
                            sys.stdout.flush()
        elif etype == "result":
            # The final result text the user expects to see at completion.
            txt = ev.get("result")
            if isinstance(txt, str) and txt:
                sys.stdout.write(txt + "\n")
                sys.stdout.flush()
finally:
    if cap is not None:
        try:
            cap.close()
        except Exception:
            sys.stderr.write("")
PYEOF
    CAPFILE="$capfile" python3 "$pyf"
    rm -f "$pyf" 2>/dev/null || true
  else
    # No python3: tee raw NDJSON to both the capture file and the user.
    tee "$capfile"
  fi
}

# Surface the .result text from a captured `--output-format json` blob to the user
# so an automated-format run is still visible. Falls back to the raw blob if the
# .result field cannot be extracted (never silently drops output).
_hmd_print_json_result() {
  local capfile="$1"
  [ -f "$capfile" ] || return 0
  if command -v python3 >/dev/null 2>&1; then
    CAPFILE="$capfile" python3 - <<'PYEOF'
import json, os, sys
capfile = os.environ.get("CAPFILE", "")
try:
    with open(capfile, "r", encoding="utf-8") as fh:
        raw = fh.read()
except OSError:
    sys.exit(0)
printed = False
s = raw.strip()
if s:
    try:
        obj = json.loads(s)
        if isinstance(obj, dict) and isinstance(obj.get("result"), str):
            sys.stdout.write(obj["result"] + "\n")
            printed = True
    except Exception:
        printed = False
if not printed and s:
    # Could not parse a .result — surface the raw capture so output isn't lost.
    sys.stdout.write(raw if raw.endswith("\n") else raw + "\n")
PYEOF
  else
    cat "$capfile"
  fi
}

# ── Main: ensure deps, then launch Claude ──

# LIBRARY-ONLY MODE: when HEIMDALL_LIB_ONLY=1 the script defines its functions
# and stops here WITHOUT running the bootstrap/launch path. This lets the
# acceptance harness source bin/heimdall and exercise individual functions (e.g.
# capture_and_emit_usage) in isolation, with NO setup side-effects and NO real
# `claude` call. A no-op for normal runs (the var is unset), so the launcher is
# unaffected. `return` works when sourced; the `|| exit 0` covers a direct run.
if [ -n "${HEIMDALL_LIB_ONLY:-}" ]; then
  return 0 2>/dev/null || exit 0
fi

ensure_node_path
ensure_claude

# ── F1 resolution order, phase 1: ORIENT ──────────────────────────────────────
# Classify the directory (front door) + load/derive the SI-1 comprehension capsule
# BEFORE setup, so the cold-vs-warm decision (onboard-if-cold) and the resume
# decision both have the directory context in hand. Capture whether this is a
# genuine cold first run NOW — before complete_first_run_setup touches the marker —
# so onboard-if-cold can tell a first-ever run from a warm one.
F1_WAS_FIRST_RUN=0
[ -f "$SETUP_MARKER" ] || F1_WAS_FIRST_RUN=1
f1_orient

# ORDERED FIRST-RUN SETUP: auth → companion plugins → skills, all completed here
# BEFORE the launch path below. Pass the task args so prompt-driven installs see
# the prompt. select_model still runs in the launch-prep block (it needs the
# checkpoint settings loaded just below) — it is launch CONFIG, not setup.
complete_first_run_setup "$@"
apply_heimdall_theme
ensure_project_claude_md
print_banner
check_for_update
load_checkpoint_context

# ── F1 resolution order, phases 2–4: RESUME → PERSONA-CHECK → ONBOARD-IF-COLD ──
# These run AFTER setup (auth+companion+skills) so the ORDERING CONTRACT holds:
# on a cold first run the full setup — INCLUDING the persona prompt — completes
# BEFORE the first task launches (the stranger-test bug). A warm run: resume fires
# if there is a checkpoint, persona is already set so persona-check is a no-op
# skip, and onboard-if-cold does nothing → straight to work.
#   - resume:  fires iff load_checkpoint_context loaded a checkpoint/state OR the
#     front door routed mid-task-resume.
#   - persona-check: set-once; prompts at most once, TTY-gated, never hangs.
#   - onboard-if-cold: only on a cold first-ever run (no marker + empty/fresh dir).
F1_ASSUME_YES=0
f1_resume "${CHECKPOINT_CONTEXT:+1}"
f1_persona_check
f1_onboard_if_cold

# Ensure git repo exists — coder agents use worktree isolation which requires git
if [ ! -d "$WORK_DIR/.git" ] && ! git -C "$WORK_DIR" rev-parse --git-dir &>/dev/null; then
  printf "  \033[38;2;0;212;255m▸ Initializing git repo\033[0m (required for agent worktree isolation)\n"
  git -C "$WORK_DIR" init -q
  git -C "$WORK_DIR" add -A 2>/dev/null
  git -C "$WORK_DIR" commit -q -m "initial commit (auto-created by heimdall)" --allow-empty --no-verify 2>/dev/null || true
fi

# Terse system preamble (caveman style to save tokens)
PREAMBLE="PROJECT: $WORK_DIR
Write ALL files here. Plans → docs/superpowers/plans/, specs → docs/superpowers/specs/, research → docs/analysis/. NEVER write to heimdall plugin dir.

INPUT: Need user input? End response with literal \`?\`. No input needed? Complete task, end with statement (no \`?\`).

POWERS: --dangerously-skip-permissions ON. Spawn Agent subprocesses (max 10 parallel via run_in_background). Use any Skill. Read/Write/Edit/Bash freely.

DELEGATION-FIRST RULE (most important rule in this entire prompt):
When user gives a task with 2+ independent parts, your FIRST response must be spawning parallel agents — NOT reading files. Agents read their own files. You are the CTO: you delegate, you don't investigate. \"I need to understand first\" is WRONG — agents understand for you. The ONLY reads you do yourself are quick lookups to identify WHICH agents to spawn (e.g. ls, grep for file names). Deep file reads = agent's job.

PARALLELISM IS MANDATORY — enforced at every level:
TOOL CALLS: If 2+ tool calls have no data dependency → send ALL in ONE message. Reading 4 files? ONE message, 4 Read calls. Writing 3 files? ONE message, 3 Write/Edit calls. Running independent commands? ONE message, multiple Bash calls. NEVER read files one-by-one when you could batch them. NEVER write files one-by-one when edits are independent.
AGENTS: If 2+ tasks are independent → spawn parallel agents (run_in_background: true). NO EXCEPTIONS.
PROJECTS: Task spans multiple repos → one agent per repo, parallel.
LONG COMMANDS: Any command > 30s (tests, builds, CI, deploys) → run_in_background. Continue other work.
MULTIPLE REQUESTS: User gave N requests → N agents, all parallel.
Violating parallelism is a bug. Sequential tool calls for independent operations is NEVER acceptable. Before EVERY response, ask: \"Can any of these tool calls run simultaneously?\" If yes → batch them.

MODEL ROUTING — when spawning subagents, select model per task:
- haiku: lint, format, rename, config, simple lookups (fast + cheap)
- sonnet: docs, tests, research, analysis, simple fixes (good enough)
- opus: ALL code writing, architecture, design, review, security, DB (quality non-negotiable)
On failure → escalate: haiku→sonnet→opus. Never retry same tier.
Check .planning/settings.json for project-specific overrides before spawning.

CONTINUATION: NEVER exit with tasks remaining. Run acceptance criteria before marking done. Run /hmd:save every 30 min or after each milestone — do NOT wait until context is full.

TIMELINES: NEVER estimate work in weeks or months. You are AI with parallel agents — human work-week cadence is meaningless. When presenting plans or phases:
1. First optimize plan for MAXIMUM parallelism (what can run simultaneously?)
2. Estimate actual AI execution wall-clock time AFTER parallelization (e.g. \"~2 hours with 8 parallel agents\" not \"Week 1-2\")
3. Break into dependency waves, not calendar periods
4. If phases have no dependency → they run simultaneously, not sequentially
\"Phase 0: Weeks 1-2\" is WRONG. \"Wave 0: ~90 min (4 parallel agents)\" is RIGHT.

GOAL-DRIVEN EXECUTION: After planning, ALWAYS set /goal with synthesized acceptance criteria. The /goal evaluator (Haiku) checks completion each turn — you keep working until it says done. After evaluator says done, spawn verifier agent for deep filesystem check. Two-tier: cheap evaluator + expensive verifier. Only one goal active at a time. Track via \`heimdall-state goal-set\`. On resume, restore with /goal. Use \`/goal clear\` to cancel. Fallback to manual loop if /goal unavailable.

SKILLS & PLUGINS — mid-session gap detection:
BEFORE starting work: run \`$PLUGIN_DIR/bin/discover-skills detect\` to check if task needs skills not yet installed.
DURING work: when you encounter ANY of these signals, STOP and check for missing skills:
- Reading React/Vue/Angular/CSS/Tailwind files → need ui-ux skill? Run: \`$PLUGIN_DIR/bin/discover-skills detect-file \"\$filepath\"\`
- Reading Godot/Unity/game files → need gamedev skill?
- Reading SEO/meta tags/sitemap → need SEO skill?
- Reading Dockerfile/k8s/CI → need devops skill?
- Reading SQL/ORM/migrations → need database skill?
- Reading OpenAPI/Swagger → need API design skill?
- Reading auth/JWT/OAuth → need security skill?
- Building diagrams/architecture docs → need mermaid skill?
- Task quality would benefit from a specialized skill you don't have → search for it
HOW TO CHECK: Run \`ls ~/.claude/skills/\` to see installed skills. Run \`$PLUGIN_DIR/bin/discover-skills search \"<domain>\"\` to find new ones. Run \`$PLUGIN_DIR/bin/discover-skills install <name-or-repo>\` to install.
ALSO install plugins: Read React/Vue/CSS → \`claude plugins install frontend-design\`. Read Dockerfile/k8s → \`claude plugins install devops-toolkit\`. Read SQL/ORM → \`claude plugins install database-toolkit\`.
NEVER proceed with suboptimal output when a skill exists that could improve quality. Finding and installing the right skill mid-session is ALWAYS worth the 10-second cost.
INVOKING SKILLS: Git-installed skills (in ~/.claude/skills/) appear in the Skill tool list by their name (NOT namespaced). Use \`Skill(ui-ux-pro-max)\` not \`Skill(superpowers:ui-ux-pro-max)\`. If a skill isn't in the list, check if it has SKILL.md — if not, read its CLAUDE.md directly via Read tool.

IMAGES: When user attaches images, classify EACH one:
- Design mockup/wireframe/UI spec → KEEP in context (reference throughout task)
- Bug screenshot/error/glitch → EXTRACT diagnosis as text, then NEVER pass image to subagents. Say what the bug is, then clear the image from context.
- Terminal output/docs/API response → EXTRACT text, drop image. Text is cheaper than pixels.
Bug images cost ~1000+ tokens each. Extract the info, drop the image. Only design references stay.

AGENT NAMESPACING (critical): all heimdall agents are namespaced — spawn with subagent_type \`heimdall:<name>\`, NEVER the bare name. \`heimdall:coder\` works; \`coder\` fails with \"Agent type 'coder' not found\".

YOUR CAPABILITIES (use all of these aggressively):
- 15 agents (spawn as heimdall:<name>): heimdall:architect, heimdall:planner, heimdall:wave-executor, heimdall:verifier, heimdall:coder, heimdall:design, heimdall:security-auditor, heimdall:database-architect, heimdall:incident-responder, heimdall:reviewer, heimdall:test-runner, heimdall:docs-writer, heimdall:lint-quality, heimdall:seeker, heimdall:fixer
- Wave execution: group tasks into dependency waves, max 10 parallel per wave, fresh context per wave
- Work-stealing: agent finishes early → steals dependency-free tasks from next wave
- Idle nudging: agent silent 60s → send continuation prompt
- Sentinel gate: factcheck claimed outputs vs actual files on disk before marking done
- Truth scoring: rate each task 0.0-1.0, phase fails if avg < 0.8
- Byzantine consensus: 10 parallel agents conflict → majority vote by criteria pass rate
- Skill extraction: after complex tasks → save patterns to .planning/skills/
- Reasoning bank: before starting → search .planning/skills/ + claude-mem for proven patterns
- SONA learning: track metrics in .planning/metrics.jsonl, adjust model routing every 10 tasks
- Governance: hierarchical (default) / democratic (trade-offs) / emergency (incidents)
- Tier 0: format, lint-fix, sort imports → run bash directly, skip LLM
- Magic keywords: ultrawork=max parallel, quick=skip planning, secure=security-first, incident=emergency, plan=plan-only, ship=end-to-end
- Seeker: pull pod logs → raise GitHub issues. Fixer: pick up issues → fix branch → PR
- /goal: set completion condition → Haiku evaluator checks each turn → autonomous until done. Use after planning.
- /hmd:save: checkpoint state for next session. /hmd:maintain: seek+fix pipeline
- /hmd:autocommit: toggle auto git commits
- Session forking: \`session-fork run <waves.json>\` spawns parallel \`claude -p\` processes, dependency-ordered waves, auto-collects results
- Shared memory: \`shared-memory set/get/lock/publish\` — SQLite WAL-mode store for cross-agent coordination (keys, locks, pub/sub)
- Agent pool: \`agent-pool init/acquire/release/should-scale\` — concurrency limiter with utilization-based scaling decisions
- Task decomposition: \`decompose \"<task>\"\` — breaks tasks into dependency-ordered waves before spawning agents

CODE QUALITY: NEVER write stub, dummy, placeholder, mock, TODO, or skeleton code. Every line must be real, working, production-ready. No \`// TODO: implement\`, no \`pass\`, no \`throw new Error('not implemented')\`, no empty function bodies, no fake data. If you can't implement something fully, say so — don't fake it.

AUTO-COMMIT (contextual): After completing ANY task that modifies files, auto-commit immediately unless \`.heimdall-no-autocommit\` exists. Do NOT ask — just commit. Rules:
- Write a real commit message describing WHAT changed and WHY (e.g. \"fix: OTP origin header corrected to match the auth service\")
- Use conventional commits: feat/fix/refactor/docs/chore prefix
- One commit per completed task (not per file)
- Stage only the files you changed (git add <specific files>, NOT git add -A)
- Use --no-verify to skip hooks (the hook-based checkpoint is a safety net, not the primary commit mechanism)
- Check for .heimdall-no-autocommit FIRST: \`[ -f .heimdall-no-autocommit ] && skip\`
- NEVER ask \"want me to commit?\" — just do it. The user enabled autocommit because they want it automatic.
- After committing, mention the commit hash in your response (one line, not a ceremony)

CAVEMAN ULTRA (max compression, every response):
Drop articles, filler, pleasantries, hedging, conjunctions. Fragments default. One word > phrase. Abbrev: DB, auth, cfg, req, res, fn, impl, mw, env, repo, PR, CI. Arrows for causality: X → Y.
Code + errors + paths: exact, unchanged.
Drop caveman for: security warnings, irreversible ops.
---
${CHECKPOINT_CONTEXT}
"

# ── Smart model selection (runs AFTER checkpoint load) ──

select_model() {
  MODEL_FLAG="--model claude-opus-4-8"
  MODEL_NAME="opus"

  # 1. Check project settings (loaded from checkpoint)
  settings="$WORK_DIR/.planning/settings.json"
  if [ -f "$settings" ] && command -v python3 &>/dev/null; then
    override=$(python3 -c "
import json
try:
    s = json.load(open('$settings'))
    m = s.get('model_routing', {}).get('default_code', '')
    if m: print(m)
except: pass
" 2>/dev/null)
    case "$override" in
      haiku)  MODEL_FLAG="--model claude-haiku-4-5"; MODEL_NAME="haiku (project override)" ;;
      sonnet) MODEL_FLAG="--model claude-sonnet-4-6"; MODEL_NAME="sonnet (project override)" ;;
      opus)   MODEL_FLAG="--model claude-opus-4-8"; MODEL_NAME="opus (project override)" ;;
    esac
  fi

  # 2. Detect task complexity from prompt (overrides project default)
  if [ $# -gt 0 ]; then
    prompt_lower=$(echo "$*" | tr '[:upper:]' '[:lower:]')
    if echo "$prompt_lower" | grep -qE '^(lint|format|fix typo|rename|bump version|update readme|fix import)'; then
      MODEL_FLAG="--model claude-sonnet-4-6"
      MODEL_NAME="sonnet (simple task)"
    elif echo "$prompt_lower" | grep -qE '(architect|design system|security audit|incident|migrate|refactor entire)'; then
      MODEL_FLAG="--model claude-opus-4-8"
      MODEL_NAME="opus (complex task)"
    fi
  fi

  printf "  \033[38;2;155;89;182m▸ Model:\033[0m %s\n" "$MODEL_NAME"
}

select_model "$@"

# Write preamble to temp file for --append-system-prompt-file
# (more reliable than inline for large preambles with special chars)
PREAMBLE_FILE=$(mktemp /tmp/heimdall-preamble-XXXXXX)
echo "$PREAMBLE" > "$PREAMBLE_FILE"

# Activate project-aware skill management (enable needed plugins, pause rest)
SKILL_MGR="$PLUGIN_DIR/bin/skill-manager"
RESTORE_FILE=""
if [ -x "$SKILL_MGR" ]; then
  "$SKILL_MGR" activate "$WORK_DIR"
  RESTORE_FILE=$("$SKILL_MGR" restore-file)
fi

cleanup() {
  rm -f "$PREAMBLE_FILE"
  [ -n "$RESTORE_FILE" ] && [ -x "$SKILL_MGR" ] && "$SKILL_MGR" restore "$RESTORE_FILE" 2>/dev/null
}
trap cleanup EXIT

# ── Launch boot animation (change #2, v2.0.3): the watchman wakes ──
#
# A QUICK wake-up arc played ONCE at the exec-claude handoff, just before the task
# launches — the same watchman frames the demo's narrate_wakeup plays (sleep →
# blink → idle → thinking → idle), reusing bin/heimdall-face --frame art (NO new
# frames authored here). It is a fast wake, not the full demo cadence: the frame
# holds are short so the SUM of sleeps stays ≤ ~1.5s and the task is never delayed
# more than ~1.5–2s on the default path.
#
# HARD GATES (mirror heimdall-face.md / the demo wake-up):
#   - non-TTY/piped stdout OR stdin → skip ENTIRELY (frames are garbage through a
#     pipe; a piped `hmd "task" | cat` emits zero animation bytes),
#   - HEIMDALL_NO_INTRO=1 → disabled entirely (recordings / CI),
#   - NO_COLOR / TERM=dumb → the frame renderer degrades to plain (no ANSI),
#   - ANY keypress during the arc → skips the REST immediately (read -t timeout).
# Never fatal: a missing renderer is silently skipped so the launch always proceeds.
narrate_launch_wakeup() {
  # Gate: real TTY on BOTH stdout and stdin, intro not disabled, renderer present.
  [ -t 1 ] || return 0
  [ -t 0 ] || return 0
  [ "${HEIMDALL_NO_INTRO:-0}" = "1" ] && return 0
  local face="$PLUGIN_DIR/bin/heimdall-face"
  [ -x "$face" ] || return 0

  # Color unless NO_COLOR/dumb (the frame renderer also self-disables, this just
  # avoids asking it to color a surface we know is plain).
  local face_flag="--no-color"
  { [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; } && face_flag="--color"

  local D C R; D='\033[2m'; C='\033[38;2;0;212;255m'; R='\033[0m'
  printf "\n  ${D}the watchman wakes…${R}  ${D}(press any key to skip)${R}\n\n"

  # Reuse the demo's exact frame SEQUENCE; faster per-frame holds for the launch
  # variant. Sum of holds = 0.30+0.18+0.28+0.30+0.22 = 1.28s (≤ ~1.5s cap).
  local frames="sleep blink idle thinking idle"
  local holds="0.30 0.18 0.28 0.30 0.22"
  local first=1 i=1 emo hold junk
  for emo in $frames; do
    hold="$(printf '%s\n' $holds | sed -n "${i}p")"
    # Repaint each 3-line frame in place after the first (cursor up 3 rows).
    [ "$first" -eq 1 ] || printf '\033[3A'
    first=0
    while IFS= read -r _fl; do
      printf '\033[2K  %s\n' "$_fl"
    done < <("$face" --frame "$emo" "$face_flag" 2>/dev/null)
    # Hold; any keypress within the hold window aborts the remaining frames and
    # settles on idle immediately (read -t is fractional-second on bash 3.2+).
    if read -rsn1 -t "$hold" junk 2>/dev/null; then
      printf '\033[3A'
      while IFS= read -r _fl; do
        printf '\033[2K  %s\n' "$_fl"
      done < <("$face" --frame idle "$face_flag" 2>/dev/null)
      break
    fi
    i=$((i+1))
  done
  printf "  ${C}▸${R} awake. ${D}watching your build.${R}\n\n"
}

# FIRST-RUN ORDERING CHECKPOINT: every setup phase (auth → companion → skills)
# has completed above. We are now at the task launch. Emit the launch marker and,
# in trace mode, short-circuit BEFORE the real `claude` exec so the harness can
# assert setup-precedes-launch without a live model call. Normal runs (no
# HEIMDALL_TRACE_ORDER) fall straight through to the launch below.
_trace_order "launch:task"
if [ -n "${HEIMDALL_TRACE_ORDER:-}" ]; then
  exit 0
fi

# Play the quick wake-up arc at the handoff (after the trace short-circuit, so the
# ordering harness never animates), then hand off to claude exactly as before.
narrate_launch_wakeup

# ── S-6 C1: reuse-metric emission (per-run, completion handler) ───────────────
#
# After a real `hmd "task"` run finishes, emit the reuse record over the work the
# run produced (every changed/added code unit since the PRE-RUN HEAD: committed
# commits + any uncommitted edits). Computes reuse_pct = units that CALL/IMPORT/
# EXTEND pre-existing repo code over total changed units. See REUSE-METRIC.md.
#
# HARD SAFETY (dogfood strict-mode): this NEVER aborts or alters the task's exit
# status. heimdall-reuse-metric is itself fail-open (degraded record, exit 0), and
# this wrapper additionally swallows any error so a broken analyzer can never turn
# a green task run red. Disable with HEIMDALL_NO_REUSE_METRIC=1.
# Set by emit_reuse_metric to the JSON record path it wrote (empty if no record
# was emitted — disabled, not a repo, tool missing). check_reuse_halt reads it.
REUSE_RECORD=""
emit_reuse_metric() {
  # $1 = pre-run base ref (HEAD captured before the task launched).
  local base="$1"
  REUSE_RECORD=""
  [ "${HEIMDALL_NO_REUSE_METRIC:-0}" = "1" ] && return 0
  local tool="$PLUGIN_DIR/bin/heimdall-reuse-metric"
  [ -x "$tool" ] || return 0
  git -C "$WORK_DIR" rev-parse --git-dir >/dev/null 2>&1 || return 0
  local run_id; run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  # --base is the pre-run HEAD so commits made DURING the run are diffed too;
  # untracked/uncommitted edits are folded in by the tool's working-tree path.
  "$tool" --repo "$WORK_DIR" --base "$base" \
          --task "$USER_TASK" --run-id "$run_id" 2>/dev/null || true
  local rec="$WORK_DIR/.planning/reuse/$run_id.json"
  [ -f "$rec" ] && REUSE_RECORD="$rec"
  return 0
}

# ── S-6 C4: halt-if-low-reuse rule (dogfood the thesis) ───────────────────────
#
# After the reuse record is emitted, inspect the MEASURED reuse. If the run is
# below the reuse floor (REUSE_HALT_THRESHOLD, default 0.30) it is likely
# REINVENTING existing repo code rather than building on it — the exact failure
# S-6 exists to refuse to ship silently. The signal:
#
#   Low reuse (X%) — likely reinventing existing code: [suspected_duplicates].
#   Inspect before proceeding.
#
# DECISION — hard-warn + require --force, NOT a true mid-completion halt. By the
# time this runs the task has already finished and may have committed work; a
# destructive abort would discard real output. Instead we emit a LOUD warning and
# return a non-zero ADVISORY (rc 7) that blocks auto-continue. Passing --force
# (or HEIMDALL_FORCE=1) acknowledges the warning and proceeds with the task's
# real exit status. Threshold + behavior documented in REUSE-METRIC.md.
#
# FAIL-OPEN, FAIL-LOUD contract:
#   - metric ERROR / degraded record / missing record  -> DO NOT halt (analysis
#     broke; never block a run because measurement failed).
#   - reuse_pct == null (unsupported language / no code units) -> DO NOT halt
#     (no signal is not the same as a low-reuse signal).
#   - reuse_pct is a real number >= threshold            -> DO NOT halt.
#   - reuse_pct is a real number  <  threshold            -> HALT-WARN (the only
#     case that fires: a genuine low-reuse MEASUREMENT).
#   - HEIMDALL_NO_REUSE_METRIC=1 / --force / HEIMDALL_FORCE=1 -> never halt.
#
# Returns 0 (proceed) or 7 (advisory: low reuse, not forced). Never aborts via
# set -e — the caller invokes it with its status captured.
REUSE_HALT_THRESHOLD="${HEIMDALL_REUSE_HALT_THRESHOLD:-0.30}"
check_reuse_halt() {
  [ "${HEIMDALL_NO_REUSE_METRIC:-0}" = "1" ] && return 0
  [ "$REUSE_FORCE" = "1" ] && return 0
  local rec="$REUSE_RECORD"
  [ -n "$rec" ] && [ -f "$rec" ] || return 0          # no record -> fail-open
  command -v python3 >/dev/null 2>&1 || return 0      # no parser -> fail-open

  # Parse the record with python3 (already a heimdall dependency). Emits one of:
  #   "ok"                       -> proceed (>= threshold, null, degraded, error)
  #   "LOW <pct_int> <dups>"     -> fire the halt-warn (real measurement < floor)
  local verdict
  verdict="$(python3 - "$rec" "$REUSE_HALT_THRESHOLD" <<'PYEOF'
import json, sys
try:
    with open(sys.argv[1]) as fh:
        rec = json.load(fh)
    thr = float(sys.argv[2])
except Exception:
    print("ok"); sys.exit(0)                 # unreadable record -> fail-open
# Degraded analysis never gates a run.
if rec.get("degraded"):
    print("ok"); sys.exit(0)
pct = rec.get("reuse_pct", None)
# null pct (unsupported language / no code units) is NOT a low-reuse signal.
if pct is None:
    print("ok"); sys.exit(0)
try:
    pct = float(pct)
except (TypeError, ValueError):
    print("ok"); sys.exit(0)                 # non-numeric -> fail-open
if pct >= thr:
    print("ok"); sys.exit(0)                 # measured at/above the floor
dups = rec.get("suspected_duplicates") or []
names = []
for d in dups:
    n = d.get("duplicates") if isinstance(d, dict) else None
    if n and n not in names:
        names.append(n)
print("LOW %d %s" % (round(pct * 100), ",".join(names) if names else "(none named)"))
PYEOF
)"

  case "$verdict" in
    LOW*)
      local pct_int dup_list
      pct_int="$(printf '%s' "$verdict" | cut -d' ' -f2)"
      dup_list="$(printf '%s' "$verdict" | cut -d' ' -f3-)"
      local Y O R
      Y='\033[38;2;255;200;80m'; O='\033[1m'; R='\033[0m'
      printf "\n  ${Y}${O}⚠ Low reuse (%s%%)${R} — likely reinventing existing code: ${Y}%s${R}.\n" \
        "$pct_int" "$dup_list" >&2
      printf "    Inspect before proceeding. Record: %s\n" "$rec" >&2
      printf "    Re-run with ${O}--force${R} (or HEIMDALL_FORCE=1) to proceed past this advisory.\n\n" >&2
      return 7
      ;;
    *)
      return 0
      ;;
  esac
}


# The bare model id (strip the leading "--model ") for the emitted record's `model`
# field — provenance for which model the metered run used.
RUN_MODEL="${MODEL_FLAG#--model }"

if [ $# -gt 0 ]; then
  # Non-interactive: wrap task in goal-driven execution
  USER_TASK="${*}"
  if [ "$USE_GOAL" = true ]; then
    GOAL_PROMPT="/goal ${USER_TASK} — fully implemented, all tests pass, lint clean, build succeeds, no TODO/stub/placeholder code in changed files

${USER_TASK}"
    printf "  \033[38;2;224;86;160m▸ Goal-driven mode\033[0m\n"
  else
    GOAL_PROMPT="$USER_TASK"
  fi

  # Snapshot HEAD before the run so the reuse metric diffs exactly the work the
  # task produces. Empty when WORK_DIR is not a git repo (metric self-skips).
  REUSE_BASE="$(git -C "$WORK_DIR" rev-parse HEAD 2>/dev/null || echo '')"

  # SOURCE METER + run: capture_and_emit_usage runs `claude` (injecting the right
  # --output-format), surfaces its output to the user (UX preserved — interactive
  # gets a tee'd stream-json render, the automated/usage-out path gets the json
  # blob's .result printed), captures usage DIRECTLY from claude's OWN structured
  # output, and emits the locked RAW record. It returns claude's REAL exit status;
  # metering is fail-open and never alters it. NO transcript file is read.
  set +e
  capture_and_emit_usage "$RUN_MODEL" \
    --agent heimdall \
    $PERMISSION_FLAG \
    $MODEL_FLAG \
    --plugin-dir "$PLUGIN_DIR" \
    --append-system-prompt-file "$PREAMBLE_FILE" \
    -p "$GOAL_PROMPT"
  TASK_RC=$?
  set -e

  # Completion handler: emit the reuse record over the run's changed files.
  [ -n "$REUSE_BASE" ] && emit_reuse_metric "$REUSE_BASE"

  # S-6 C4: halt-if-low-reuse advisory. Fail-open on any metric problem; fire a
  # loud warning + non-zero advisory ONLY on a genuine low-reuse measurement that
  # was not --force'd. When it fires we exit with the advisory code (7) so an
  # auto-continue loop stops and the reinvention is inspected; otherwise we exit
  # with the task's real status. Captured without aborting under set -e.
  set +e
  check_reuse_halt
  REUSE_HALT_RC=$?
  set -e
  if [ "$REUSE_HALT_RC" -eq 7 ]; then
    exit 7
  fi

  exit "$TASK_RC"
else
  # Interactive mode: preamble injected via system prompt file, Claude stays interactive
  claude \
    --agent heimdall \
    $PERMISSION_FLAG \
    $MODEL_FLAG \
    --plugin-dir "$PLUGIN_DIR" \
    --append-system-prompt-file "$PREAMBLE_FILE"
fi
