#!/usr/bin/env bash
# heimdall — autonomous superskill manager for Claude Code
#
# heimdall is a program that launches Claude Code with the right settings,
# plugins, and permissions. It bootstraps everything on first run.
#
# Usage:
#   heimdall "build a dashboard with auth"     Run a task end-to-end
#   heimdall                                    Interactive mode
#   heimdall --update                           Pull latest version
#   heimdall --setup                            Re-run plugin setup
#
set -euo pipefail

# Resolve the plugin root (bin/heimdall → heimdall/).
# Must follow symlinks (readlink) so brew-installed heimdall resolves to
# the actual Cellar/libexec path, not /opt/homebrew/.
SELF="$0"
# Follow symlinks to the real file
if command -v readlink &>/dev/null; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
PLUGIN_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
WORK_DIR="$(pwd)"

# Early default for PERMISSION_FLAG — same default the flag-parsing block at
# ~line 2806 sets unconditionally before its own --auto check. That block only
# runs on the default/no-recognized-flag launch path; early-exit branches like
# --resume and --team reference $PERMISSION_FLAG (unquoted, so it must at
# least be defined) before ever reaching line 2806, and under `set -u` a
# reference to an unset variable is fatal regardless of quoting. Setting the
# same default here — harmlessly re-set (to the same value, or overridden by
# --auto) once the default path reaches line 2806 — means no early-exit
# branch can crash on this var, without changing behaviour for any path that
# already worked.
PERMISSION_FLAG="--dangerously-skip-permissions"

# Arrow-key selection menu helper (bin/lib/select.sh) — powers every interactive
# prompt (the persona pick, the uninstall/reinstall confirms) with ↑/↓ + Enter
# selection, j/k aliases, clean Ctrl-C abort (always restores the terminal), and
# a hang-proof non-TTY fallback. Sourced best-effort: a missing lib degrades to
# the guarded typed-read fallbacks at each call site, never a crash.
if [ -f "$PLUGIN_DIR/bin/lib/select.sh" ]; then
  # shellcheck disable=SC1091
  . "$PLUGIN_DIR/bin/lib/select.sh" 2>/dev/null || true
fi

# Real-user detection (bin/lib/real-home.sh) — the fail-safe gate for the side effects
# $HOME cannot isolate (launchctl targets the GUI session domain, not a $HOME path).
# Shared with bin/heimdall-dream-schedule so the install and uninstall halves of the
# guard cannot drift. Sourced best-effort: an unreadable lib leaves the predicates
# undefined, which the _heimdall_* wrappers below read as "unsafe" → refuse.
if [ -f "$PLUGIN_DIR/bin/lib/real-home.sh" ]; then
  # shellcheck disable=SC1091
  . "$PLUGIN_DIR/bin/lib/real-home.sh" 2>/dev/null || true
fi

# ── First-run completion marker (USER-writable, NEVER the install dir) ──
#
# The marker MUST live in a user-writable path, NOT $PLUGIN_DIR. Live GCE failure:
# the repo was `sudo git clone`'d (root-owned) and hmd runs as a normal user, so a
# `touch "$PLUGIN_DIR/.setup-done"` fails `Permission denied` → the marker never
# lands → first-run setup re-runs on EVERY launch forever. Keying setup state off
# the user home ($HEIMDALL_HOME | ~/.heimdall) makes it writable regardless of who
# owns the install tree (root-owned / read-only / brew Cellar).
HEIMDALL_HOME_DIR="${HEIMDALL_HOME:-$HOME/.heimdall}"
SETUP_MARKER="$HEIMDALL_HOME_DIR/setup-done"
# Legacy marker location — inside the install dir (pre user-home migration).
SETUP_MARKER_LEGACY="$PLUGIN_DIR/.setup-done"

# ── Teardown guard: NOTHING may recreate the home dir during an uninstall ──
#
# THE BUG THIS CLOSES: the run-count bump (hmd_bump_run_count, far below) runs
# UNCONDITIONALLY in the preamble — BEFORE the subcommand `case` dispatches — so
# `hmd uninstall` re-created $HEIMDALL_HOME_DIR (holding a fresh .run-count) on its
# way in. Worse, the resurrected dir then DEFEATED _heimdall_remove_plugin's own
# plugin.json guard (dir present but not a plugin tree → removal skipped), so
# ~/.heimdall survived the uninstall and every subsequent one. Uninstall was never
# idempotent, and the leftover was invisible because the suite that proved it was
# not discovered by the runner (test/install-stranger.test.sh).
#
# THE SHAPE OF THE FIX: one flag, computed ONCE from the dispatch word, plus ONE
# function that is the only thing allowed to create the home dir. A NEW subcommand
# does not have to remember anything — it calls _heimdall_home_ensure like every
# other writer and inherits the guard for free. The only thing to keep in sync is
# the teardown verb list right here, which is a property of teardown itself, not of
# whatever subcommands get added later. Keyed on $1 BEFORE any shift, so it always
# sees the real invocation.
HEIMDALL_TEARDOWN=0
case "${1:-}" in
  uninstall|--uninstall) HEIMDALL_TEARDOWN=1 ;;
esac

# _heimdall_home_ensure — the ONE creator of $HEIMDALL_HOME_DIR.
# Returns 0 when the dir exists / was created; non-zero when it must NOT exist
# (teardown) or could not be created. Every caller guards with `|| return` / `|| true`,
# so a refusal is never fatal under `set -euo pipefail`.
_heimdall_home_ensure() {
  [ "${HEIMDALL_TEARDOWN:-0}" -eq 1 ] && return 1
  mkdir -p "$HEIMDALL_HOME_DIR" 2>/dev/null || return 1
  return 0
}

# _write_setup_marker — record first-run setup as complete in the USER home.
# mkdir -p the home first (a cold box may not have it yet). NEVER writes into
# $PLUGIN_DIR. Idempotent; failures are swallowed so a degraded FS never aborts.
_write_setup_marker() {
  # Routed through the ONE creator so a teardown never resurrects the home dir it
  # is about to remove — and so no setup marker is written on the way out.
  _heimdall_home_ensure || return 0
  touch "$SETUP_MARKER" 2>/dev/null || true
  # Also drop a best-effort marker at the legacy install-dir location. This is a
  # NON-authoritative convenience copy: idempotency + cold/warm detection key off
  # $SETUP_MARKER in the user home (above), NEVER off this one. On a root-owned /
  # read-only install tree the write silently no-ops (the live-VM bug can't recur —
  # setup state no longer DEPENDS on a writable install dir). It only keeps a
  # consumer that still probes the pre-migration path in sync with a completed
  # install; a failure here never aborts or re-triggers setup.
  touch "$SETUP_MARKER_LEGACY" 2>/dev/null || true
}

# MIGRATE a pre-existing legacy marker to the user home so an ALREADY-set-up
# install (upgraded from a version that wrote $PLUGIN_DIR/.setup-done) is still
# recognised as set-up and does NOT re-run first-run setup. Runs once at startup,
# BEFORE any marker check below. No-op unless legacy exists and the new one does
# not — so a genuine cold run (no legacy marker) is unaffected.
if [ ! -f "$SETUP_MARKER" ] && [ -f "$SETUP_MARKER_LEGACY" ]; then
  _write_setup_marker
fi

# ── First-run ordering trace (debug + acceptance harness) ──
#
# When HEIMDALL_TRACE_ORDER points at a file, each first-run phase appends one
# ordered marker to it (setup:auth → setup:companion → setup:skills →
# launch:task) and the launcher short-circuits just before the real `claude`
# exec. This is how test/install-stranger.test.sh proves, WITHOUT a live model call,
# that auth + companion-plugin setup fully complete BEFORE the first task
# launches. A no-op when the env var is unset, so normal runs are unaffected.
_trace_order() {
  [ -n "${HEIMDALL_TRACE_ORDER:-}" ] || return 0
  printf '%s\n' "$1" >> "$HEIMDALL_TRACE_ORDER" 2>/dev/null || true
}

# ── Model-tier resolution (never fatal) ──
#
# Prints the `--model` string for a tier. bin/heimdall-model-resolve floats each
# tier to the LATEST Claude of that generation and honours a HEIMDALL_MODEL_<TIER>
# pin; this wrapper is the SAFE way to call it.
#
# WHY THE WRAPPER: this script runs under `set -euo pipefail`, so a bare
# `$("$PLUGIN_DIR/bin/heimdall-model-resolve" opus)` inside an assignment aborts
# the ENTIRE launcher (exit 127) when the helper is missing or has lost its +x
# bit — a partial install bricked `hmd` instead of degrading. Every other
# launch-path helper here is already guarded ([ -x "$SKILL_MGR" ], [ -x "$face" ]);
# this makes the resolver match. When the helper is unavailable we print the bare
# tier alias, which is byte-identical to what the helper itself prints when no pin
# is set, since Claude Code maps opus/sonnet/haiku to the newest of that tier. A
# pin set via the environment is still honoured on the degraded path, so a bench
# run can never silently resolve to the wrong model.
#
# THE REFUSAL IS NOT A DEGRADATION: the resolver denies a non-ZDR tier (fable) in
# a repo that has not opted in. Falling back to the bare alias there would print
# exactly the tier the policy just forbade, so a nonzero resolver exit propagates
# instead of degrading, and its stderr is NOT swallowed. On the degraded path the
# repo policy cannot be evaluated at all, so the non-ZDR tier is denied outright —
# deny-by-default is the whole contract.
resolve_model() {
  local tier="$1" resolver="$PLUGIN_DIR/bin/heimdall-model-resolve" out="" rc=0
  if [ -x "$resolver" ]; then
    out="$("$resolver" "$tier")" || rc=$?
    if [ "$rc" -ne 0 ]; then
      printf 'heimdall: model tier %s refused by heimdall-model-resolve (exit %s)\n' \
        "'$tier'" "$rc" >&2
      return "$rc"
    fi
  else
    case "$tier" in
      opus)   out="${HEIMDALL_MODEL_OPUS:-}" ;;
      sonnet) out="${HEIMDALL_MODEL_SONNET:-}" ;;
      haiku)  out="${HEIMDALL_MODEL_HAIKU:-}" ;;
      fable)
        printf 'heimdall: REFUSED tier %s — non-ZDR, and heimdall-model-resolve is\n' \
          "'$tier'" >&2
        printf '  unavailable at %s, so repo policy cannot be evaluated. Denying by default.\n' \
          "$resolver" >&2
        return 3
        ;;
    esac
  fi
  printf '%s\n' "${out:-$tier}"
}

# ── Install-step telemetry (dossier §3 + §8) ──
#
# Each install/first-run step emits a `started` then a `succeeded`/`failed`
# install_step event (with step id + duration_ms + an error CLASS, never a secret
# value) through the substrate's bash wrapper. The wrapper is fire-and-forget: it
# NEVER fails the caller (always exit 0), and a disabled/absent telemetry world is
# a perfect no-op. Every call is additionally `|| true`-guarded so a telemetry
# fault can never abort setup. This is data-gathering ONLY — it pinpoints WHERE an
# install fails (the claude-mem question) and changes install behaviour not at all.
TELEMETRY_BIN="$PLUGIN_DIR/bin/heimdall-telemetry"

# A stable run id for THIS launcher invocation, shared across every step event so
# piece (d) can stitch one install's steps together. Resolved lazily + once.
_tele_run_id() {
  if [ -z "${HEIMDALL_INSTALL_RUN_ID:-}" ]; then
    if [ -x "$TELEMETRY_BIN" ]; then
      HEIMDALL_INSTALL_RUN_ID="$("$TELEMETRY_BIN" new-run-id 2>/dev/null || true)"
    fi
    # Fallback id if the wrapper/python is absent — keeps step events correlated
    # even in a degraded env; the value is opaque + non-secret.
    [ -n "${HEIMDALL_INSTALL_RUN_ID:-}" ] || HEIMDALL_INSTALL_RUN_ID="run-install-$$"
    export HEIMDALL_INSTALL_RUN_ID
  fi
  printf '%s' "$HEIMDALL_INSTALL_RUN_ID"
}

# Current wall-clock in milliseconds. macOS `date` has no %3N (it prints a literal
# 'N'), so we use python3 when present and fall back to whole-second precision via
# `date +%s` * 1000 — never a bogus literal-N string.
_tele_now_ms() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import time;print(int(time.time()*1000))' 2>/dev/null && return 0
  fi
  local s; s="$(date +%s 2>/dev/null || echo 0)"
  printf '%s' "$(( s * 1000 ))"
}

# Emit ONE install_step event. Args:
#   $1 step      setup|auth|companion:caveman|companion:claude-mem|skills|
#                path|launch-readiness
#   $2 outcome   started|succeeded|failed
#   $3 start_ms  (optional) the _tele_now_ms captured at `started`; when present
#                we attach duration_ms = now - start_ms
#   $4 err_class (optional) a SHORT error CLASS for a `failed` event (e.g.
#                npm-exec-nonzero, plugin-install-failed) — NEVER a secret value
#                or raw stdout; the substrate scrubber rejects anything secret-shaped
#   $5 err_detail(optional) a SHAPE summary (e.g. "npm exec exit 1") — scrubbed
# Fire-and-forget: the wrapper always exits 0; the extra `|| true` is belt-and-
# suspenders so a missing wrapper / python never aborts the install.
_tele_install_step() {
  [ -x "$TELEMETRY_BIN" ] || return 0
  local step="$1" outcome="$2" start_ms="${3:-}" err_class="${4:-}" err_detail="${5:-}"
  local args=(emit --type install_step --phase install \
    --run-id "$(_tele_run_id)" --step "$step" --outcome "$outcome")
  if [ -n "$start_ms" ]; then
    local now; now="$(_tele_now_ms)"
    args+=(--duration-ms "$(( now - start_ms ))")
  fi
  [ -n "$err_class" ]  && args+=(--error-class "$err_class")
  [ -n "$err_detail" ] && args+=(--error-detail "$err_detail")
  "$TELEMETRY_BIN" "${args[@]}" >/dev/null 2>&1 || true
}

# ── F1 launch resolution order: orient → resume → persona-check → onboard-if-cold ─
#
# The F1 (Onboarding) front-door decision tree, wired into the launch path. Each
# phase consumes an ALREADY-MERGED standalone piece (it does NOT rebuild them):
#   orient        — bin/heimdall-frontdoor classify (directory context + route)
#                   + bin/heimdall-comprehend (SI-1 capsule: load if fresh → reuse,
#                     stale/missing → derive). Emits the `orient` trace marker.
#   resume        — if the front door classified mid-task-resume OR a checkpoint
#                   was loaded (load_checkpoint_context), emit `resume`.
#   persona-check — bin/heimdall-persona: set-once, never re-prompt. If set → skip.
#                   If unset → prompt ONCE, but ONLY on a real TTY with intro
#                   enabled and without --yes; a non-TTY / --yes / HEIMDALL_NO_INTRO
#                   run NEVER blocks on a stdin read (mirrors the uninstall/demo
#                   discipline) — it defers the prompt and leaves the persona unset
#                   so a later interactive run asks. Emits `persona-check`.
#   onboard-if-cold — onboarding runs ONLY on a cold first-ever run (no first-run
#                   marker AND the front door routes empty/fresh). A warm run skips
#                   straight to work. Emits `onboard` (cold) or nothing (warm).
#
# Phase state is published into these globals for the launch path + the trace:
#   F1_CONTEXT        the front-door context word (empty-dir|fresh-project|…)
#   F1_ROUTE          the front-door route       (onboard-new|orient-fresh|…)
#   F1_CAPSULE_ACTION reused-cached | derived-fresh | derive-failed | skipped
#   F1_PERSONA        the resolved persona       (coder|non-coder|unset)
#   F1_DID_ONBOARD    1 iff onboarding fired this run (cold), else 0
#
# Every phase is fail-open: a missing piece, a non-repo dir, or a python hiccup
# degrades to a sensible default and NEVER aborts the launch (set -e safe).

F1_CONTEXT=""
F1_ROUTE=""
F1_CAPSULE_ACTION="skipped"
F1_PERSONA="unset"
F1_DID_ONBOARD=0

# orient — classify the directory + load/derive the SI-1 comprehension capsule.
f1_orient() {
  local fd="$PLUGIN_DIR/bin/heimdall-frontdoor"
  local comp="$PLUGIN_DIR/bin/heimdall-comprehend"

  # 1. Directory classification (front door). --json carries context+route+signals;
  #    we pull just context+route. Fail-open: a missing classifier leaves the
  #    defaults so the launch proceeds.
  if [ -x "$fd" ] && command -v python3 >/dev/null 2>&1; then
    local fd_json
    fd_json="$("$fd" classify --json "$WORK_DIR" 2>/dev/null || true)"
    if [ -n "$fd_json" ]; then
      F1_CONTEXT="$(printf '%s' "$fd_json" | python3 -c 'import json,sys;
try:
 d=json.load(sys.stdin); print(d.get("context",""))
except Exception: print("")' 2>/dev/null)"
      F1_ROUTE="$(printf '%s' "$fd_json" | python3 -c 'import json,sys;
try:
 d=json.load(sys.stdin); print(d.get("route",""))
except Exception: print("")' 2>/dev/null)"
    fi
  fi

  # 2. SI-1 comprehension capsule: load if fresh (reuse → orient-once), else derive.
  #    `load` exits 3 when stale/missing/corrupt — that is the re-derive signal, NOT
  #    a crash. `comprehend` then derives (or reuses a still-fresh capsule). We
  #    record which path was taken so the harness can prove reuse on a warm run.
  if [ -x "$comp" ] && command -v python3 >/dev/null 2>&1; then
    if "$comp" load "$WORK_DIR" >/dev/null 2>&1; then
      F1_CAPSULE_ACTION="reused-cached"
    else
      if "$comp" comprehend "$WORK_DIR" >/dev/null 2>&1; then
        F1_CAPSULE_ACTION="derived-fresh"
      else
        F1_CAPSULE_ACTION="derive-failed"
      fi
    fi
  fi

  _trace_order "orient"
  if [ -n "${HEIMDALL_TRACE_ORDER:-}" ]; then
    printf "  \033[38;2;0;212;255m▸ Orient\033[0m %s → %s ${F1_CAPSULE_ACTION:+(capsule: %s)}\n" \
      "${F1_CONTEXT:-unknown}" "${F1_ROUTE:-unknown}" "$F1_CAPSULE_ACTION" >&2 2>/dev/null || true
  fi
}

# resume — emit the resume marker iff there is in-flight work to resume.
#   $1 = "1" when load_checkpoint_context found a checkpoint/state (CHECKPOINT_CONTEXT
#        non-empty), else "". The front-door mid-task-resume route also counts.
f1_resume() {
  local cp_loaded="${1:-}"
  if [ "$F1_ROUTE" = "resume" ] || [ -n "$cp_loaded" ]; then
    _trace_order "resume"
  fi
}

# persona-check — set-once global persona; prompt at most once, never hang.
f1_persona_check() {
  local persona_bin="$PLUGIN_DIR/bin/heimdall-persona"
  F1_PERSONA="unset"
  if [ -x "$persona_bin" ]; then
    F1_PERSONA="$("$persona_bin" get 2>/dev/null || echo unset)"
  fi

  if [ "$F1_PERSONA" = "unset" ] && [ -x "$persona_bin" ]; then
    # Prompt ONLY when it is safe to read a real answer: a TTY on both stdin and
    # stdout, intro not disabled, no --yes assume-yes. Otherwise DEFER — never read
    # a stdin that will not arrive (the TTY-read landmine). A deferred persona stays
    # unset so the next interactive run asks once; product code defaults to the
    # guided (non-coder) surface until then (persona_store.is_coder() → False).
    if [ -t 0 ] && [ -t 1 ] && [ "${HEIMDALL_NO_INTRO:-0}" != "1" ] && [ "${F1_ASSUME_YES:-0}" != "1" ]; then
      local P D R choice
      P='\033[38;2;224;86;160m'; D='\033[2m'; R='\033[0m'
      # Re-check stdin is STILL an interactive TTY immediately before the read.
      # The outer guard can pass while stdin is redirected away from the terminal
      # before we get here (a closed/redirected fd in a pipeline, or a launcher
      # invoked `</dev/null`). A `read -t` timeout is NOT a guard: on a non-TTY
      # stdin it does not return promptly — it STALLS the whole window (up to 60s)
      # and can wedge a non-interactive pipeline. So when stdin is not a real TTY
      # we DEFER entirely here too: skip the prompt, leave the persona unset, and
      # proceed on the default/guided surface. Never read a stdin that will not
      # arrive (the v2.0.4 non-TTY-read class).
      if [ -t 0 ]; then
        # CLARITY over flavor: say exactly what each choice CHANGES, so a real
        # user who doesn't already know which to pick can decide. This is ONLY a
        # communication-style preference — it does not limit what Heimdall can do,
        # and it can be changed later.
        printf "\n  ${P}One-time question${R} — how should Heimdall explain its work to you?\n"
        printf "    ${D}This only changes the wording of explanations, not what Heimdall can do.${R}\n"
        # Arrow-key selection (↑/↓ + Enter; j/k aliases; Ctrl-C cancels and
        # restores the terminal). hmd_select renders the highlighted choice and
        # returns the picked index in HMD_SELECT_INDEX. It reads keys ONLY on a
        # real TTY (already guaranteed by the [ -t 0 ]/[ -t 1 ] guards above) and
        # can never hang on a non-TTY stream. If the helper is unavailable (a
        # partial install), DEFER — leave the persona unset for the next run
        # rather than reintroduce a typed-number read that could stall.
        choice=""
        if command -v hmd_select >/dev/null 2>&1; then
          hmd_select 0 "" \
            "coder      — technical and terse: shows code, commands, file paths" \
            "non-coder  — plain language: explains what it's doing in everyday terms"
          case "$HMD_SELECT_INDEX" in
            1) choice="non-coder" ;;
            *) choice="coder" ;;
          esac
        fi
        if [ -n "$choice" ] && "$persona_bin" set "$choice" >/dev/null 2>&1; then
          F1_PERSONA="$choice"
          printf "  ${P}▸ Talking to you as: %s${R} ${D}(remembered — asked once; change anytime)${R}\n\n" "$choice"
        fi
      fi
    fi
  elif [ "$F1_PERSONA" != "unset" ]; then
    # Already set — read it, never re-prompt.
    if [ -n "${HEIMDALL_TRACE_ORDER:-}" ]; then
      printf "  \033[38;2;155;89;182m▸ Persona\033[0m %s \033[2m(set, skipped)\033[0m\n" "$F1_PERSONA" >&2 2>/dev/null || true
    fi
  fi

  _trace_order "persona-check"
}

# onboard-if-cold — run onboarding ONLY on a cold first-ever run.
#   Cold = no first-run marker ($SETUP_MARKER absent at run start, captured by the
#   caller into $F1_WAS_FIRST_RUN) AND the front door routes a new project
#   (empty-dir / fresh-project). A warm run skips: emits nothing, goes to work.
f1_onboard_if_cold() {
  F1_DID_ONBOARD=0
  local is_cold=0
  if [ "${F1_WAS_FIRST_RUN:-0}" = "1" ]; then
    case "$F1_CONTEXT" in
      empty-dir|fresh-project) is_cold=1 ;;
    esac
    # No context resolved at all (classifier absent) but a genuine first-run marker
    # is missing → still treat as cold so a first-ever run is onboarded.
    [ -z "$F1_CONTEXT" ] && is_cold=1
  fi

  if [ "$is_cold" = "1" ]; then
    F1_DID_ONBOARD=1
    _trace_order "onboard"
    if [ -n "${HEIMDALL_TRACE_ORDER:-}" ]; then
      printf "  \033[38;2;78;204;163m▸ Onboard\033[0m cold first run (%s)\n" "${F1_CONTEXT:-new}" >&2 2>/dev/null || true
    fi

    # COLD-USER ORIENTATION (friction removal): a first-ever user — in an empty
    # dir, a fresh project, or an existing codebase — needs to know, in plain
    # terms, WHAT Heimdall is and WHAT TO DO NEXT. Without this the cold run only
    # emitted a test-only trace marker and the newcomer saw nothing. We point them
    # at the known-good first experience: `hmd demo --run`.
    #
    # TTY-gated + never blocks: printed only on a real terminal with intro enabled
    # (a non-TTY / CI / HEIMDALL_NO_INTRO run prints nothing). It NEVER reads stdin
    # and never prompts — it cannot hang. The demo command is safe-by-default (dry
    # unless --run), so pointing at `--run` is the deliberate watch-it-build path.
    if [ -t 1 ] && [ "${HEIMDALL_NO_INTRO:-0}" != "1" ]; then
      local G C D B R
      G='\033[38;2;78;204;163m'; C='\033[38;2;0;212;255m'
      D='\033[2m'; B='\033[1m'; R='\033[0m'
      printf "\n  ${B}New here?${R} Heimdall is an autonomous build agent — you describe a task,\n"
      printf "  it plans, writes the code, runs the tests, and commits the result for you.\n\n"
      printf "  ${B}Best first step${R} — watch it build something real, end to end:\n"
      printf "    ${C}hmd demo --run${R}  ${D}— scaffolds a Todo API + frontend + tests and builds it${R}\n\n"
      printf "  ${D}Or just tell it what you want:${R}  ${C}hmd \"build a CLI that renames files\"${R}\n"
      printf "  ${G}▸${R} ${D}Heimdall writes every file in THIS directory. Nothing ships unproven.${R}\n\n"
    fi
  fi
}

# ── Shared removal path (uninstall subcommand AND legacy --uninstall) ──
#
# The ONE guarded removal. Both `hmd uninstall` and `heimdall --uninstall` call
# this so there is a single rm -rf gated by the same guard — never an unguarded
# `rm -rf "$HOME/.heimdall"` that could delete the wrong tree.
#
# SAFETY: derive the plugin dir CANONICALLY ($HOME/.heimdall), never $PLUGIN_DIR.
# When invoked via a hardlinked entry point in ~/.local/bin, $PLUGIN_DIR resolves
# to ~/.local; an unguarded rm -rf would delete ~/.local. Fixed location + a
# plugin.json check make deleting the wrong dir impossible.
#
# ── Credential inventory (shared by both removal paths) ──
#
# Echoes the credential-bearing entries present directly under $1, one per line.
# These are the items whose loss is NOT always recoverable — a signing identity or a
# control-plane enrolment may have to be re-minted by a human. Everything else under
# the home is regenerated on next run and is safe to sweep.
_heimdall_credential_entries() {
  local dir="$1" name
  [ -d "$dir" ] || return 0
  for name in pki signing gh-app team.json cp-endpoint.json remote.json; do
    [ -e "$dir/$name" ] && printf '%s\n' "$dir/$name"
  done
  return 0
}

# ── State-home sweep (uninstall completeness, credential-safe) ──
#
# Removes Heimdall's GENERATED state from a STATE-ONLY $HOME/.heimdall — the
# git-clone layout, where the plugin tree lives elsewhere and the home holds only
# generated state. The wholesale plugin-tree branch below can never match it (no
# plugin.json), so before this it survived uninstall wholly untouched: run-count,
# logs, sigil cache, persona, caches, everything.
#
# CREDENTIALS ARE PRESERVED, NOT DELETED. Uninstalling a tool should not leave its
# scratch state behind, but it also must not silently destroy key material the user
# may still need. Preserved items are printed WITH their full path, so removing them
# stays an explicit, informed user action rather than a side effect of `uninstall`.
#
# NOT IN SCOPE — the per-repo team secret (<repo>/.heimdall/team.json): it lives
# inside the user's own repositories, never in $HOME, and uninstalling the tool must
# not reach into a project tree. Ditto $TMPDIR/heimdall-edits (the edit ledger): OS
# temp is self-cleaning and is shared with still-running sessions.
#
# Raises $REMOVED_ANY only when something was actually swept.
_heimdall_sweep_state_home() {
  local home_dir entry base kept swept D R
  D='\033[2m'; R='\033[0m'
  home_dir="$HOME/.heimdall"
  [ -d "$home_dir" ] || return 0
  kept=0; swept=0
  for entry in "$home_dir"/* "$home_dir"/.[!.]*; do
    [ -e "$entry" ] || continue          # unmatched glob stays literal — skip it
    base="${entry##*/}"
    case "$base" in
      pki|signing|gh-app|team.json|cp-endpoint.json|remote.json)
        kept=$((kept + 1))
        printf "  ${D}kept${R} %s ${D}(credential — delete it yourself if you want it gone)${R}\n" "$entry"
        ;;
      *)
        if rm -rf "$entry" 2>/dev/null; then swept=$((swept + 1)); fi
        ;;
    esac
  done
  if [ "$swept" -gt 0 ]; then
    printf "  ${D}removed${R} %s state item(s) from %s\n" "$swept" "$home_dir"
    REMOVED_ANY=1
  fi
  if [ "$kept" -eq 0 ]; then
    rmdir "$home_dir" 2>/dev/null || true     # reclaim only when nothing was preserved
  else
    printf "  ${D}kept${R} %s ${D}(holds %s credential item(s))${R}\n" "$home_dir" "$kept"
  fi
  return 0
}

# Removes: both entry points (hmd, heimdall) + the plugin dir, and nothing else.
# Sets $REMOVED_ANY (0/1) and prints exactly what was removed.
_heimdall_remove_plugin() {
  local bin_dir plugin_dir D G R entry
  bin_dir="$HOME/.local/bin"
  plugin_dir="$HOME/.heimdall"
  # Dev fallback: only if canonical absent AND $PLUGIN_DIR is itself a real plugin tree.
  if [ ! -d "$plugin_dir" ] && [ -f "$PLUGIN_DIR/.claude-plugin/plugin.json" ]; then
    plugin_dir="$PLUGIN_DIR"
  fi

  D='\033[2m'; G='\033[32m'; R='\033[0m'
  # ACCUMULATE, never reset. The steps that run BEFORE this one (PATH export,
  # nightly LaunchAgent, statusLine) may already have removed something; a reset
  # here would make the closing summary claim "Nothing to remove — Heimdall was
  # not installed here" on the very same run that just printed what it removed.
  REMOVED_ANY="${REMOVED_ANY:-0}"
  # Both entry points — unlink each hardlink/copy independently.
  for entry in "$bin_dir/hmd" "$bin_dir/heimdall"; do
    if [ -e "$entry" ] || [ -L "$entry" ]; then
      rm -f "$entry" && { printf "  ${D}removed${R} %s\n" "$entry"; REMOVED_ANY=1; }
    fi
  done
  # Plugin directory — ONLY if verifiably a Heimdall plugin tree (the hard guard)
  # AND ONLY at the canonical location install.sh actually writes. install.sh
  # hardcodes PLUGIN_DIR="$HOME/.heimdall", so a tree ANYWHERE ELSE is by
  # construction not an install — it is the user's own checkout. Deleting that
  # (uncommitted work and all) on `uninstall` is unrecoverable, so it is reported
  # and left alone. This branch was previously unreachable: the preamble run-count
  # bump always created $HOME/.heimdall first, so `[ ! -d "$plugin_dir" ]` never
  # held. Closing the resurrection bug makes it reachable, hence the explicit guard.
  if [ "$plugin_dir" = "$HOME/.heimdall" ] \
     && [ -d "$plugin_dir" ] && [ -f "$plugin_dir/.claude-plugin/plugin.json" ]; then
    # The canonical install dir is BOTH the program and its state, so removing it is
    # the uninstall — but name any credential going with it first, so the loss is
    # announced rather than silent. The user asked for exactly this directory.
    _heimdall_credential_entries "$plugin_dir" | while IFS= read -r _cred; do
      [ -n "$_cred" ] && printf "  ${D}removing credential${R} %s\n" "$_cred"
    done
    rm -rf "$plugin_dir" && { printf "  ${D}removed${R} %s\n" "$plugin_dir"; REMOVED_ANY=1; }
  elif [ "$plugin_dir" != "$HOME/.heimdall" ] && [ -d "$plugin_dir" ]; then
    printf "  ${D}kept${R} %s ${D}(your own checkout, not an install — delete it yourself)${R}\n" "$plugin_dir"
  fi
  # State-only $HOME/.heimdall — no plugin.json, so the branch above cannot match it.
  # No-op when the wholesale removal above already reclaimed the directory.
  if [ -d "$HOME/.heimdall" ]; then
    _heimdall_sweep_state_home
  fi
  # Best-effort plugin/marketplace deregistration (never fatal).
  if command -v claude >/dev/null 2>&1; then
    claude plugins uninstall hmd@heimdall >/dev/null 2>&1 || true
    claude plugins marketplace remove heimdall >/dev/null 2>&1 || true
  fi
}

# ── Shared PATH-export removal (uninstall completeness, v2.0.3) ──
#
# install.sh's ensure_path_on_profile appends a GUARDED two-line block to the
# user's shell profile so `hmd`/`heimdall` resolve on PATH:
#
#     # Added by Heimdall installer — put `hmd`/`heimdall` on PATH
#     export PATH="$HOME/.local/bin:$PATH"
#
# Uninstall must REVERSE that, SURGICALLY — delete ONLY the marker comment and the
# export line install wrote, never an unrelated PATH export the user maintains.
# Strategy: drop the exact marker comment line, AND drop the single `export PATH`
# line that DIRECTLY FOLLOWS that marker (install always writes them as a pair).
# As defense-in-depth we also drop a bare heimdall-bin export from the legacy
# v2.0.1 layout (`.heimdall/bin`), which carried no marker. We do NOT blanket-match
# `.local/bin` exports without the marker — a stranger may put other tools there.
#
# Idempotent: a profile with no marker is rewritten identically (no-op), so a
# second uninstall removes nothing and errors nothing. Uses awk (no GNU-vs-BSD sed
# in-place split) so it behaves identically on macOS and Linux. set -u clean.
#
# Sets/raises $REMOVED_ANY when it edits a profile, and prints what it touched.
_heimdall_remove_path_export() {
  local D R rc tmp marker mktpl
  D='\033[2m'; R='\033[0m'
  # The EXACT marker comment install.sh writes (kept in sync with install.sh).
  marker='# Added by Heimdall installer — put `hmd`/`heimdall` on PATH'
  # mktemp template built at runtime (the fill run is assembled, not a literal).
  mktpl="${TMPDIR:-/tmp}/heimdall-rc.$(printf 'X%.0s' 1 2 3 4 5 6)"

  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
    [ -f "$rc" ] || continue
    # Only act if this profile actually carries a heimdall PATH artifact, so an
    # untouched profile is never rewritten (preserves mtime / avoids churn).
    if ! grep -qF "$marker" "$rc" 2>/dev/null \
       && ! grep -qE 'export PATH=.*\.heimdall/bin' "$rc" 2>/dev/null; then
      continue
    fi
    tmp="$(mktemp "$mktpl")" || continue
    # awk pass:
    #   - skip the marker comment line
    #   - if the line IMMEDIATELY AFTER the marker is an `export PATH=...local/bin`
    #     line, skip it too (the pair install wrote)
    #   - skip a legacy bare `export PATH=...heimdall/bin` line (no marker, v2.0.1)
    #   - keep everything else verbatim
    if awk -v marker="$marker" '
      BEGIN { skip_next = 0 }
      {
        if (skip_next == 1) {
          skip_next = 0
          if ($0 ~ /export[ \t]+PATH=.*\.local\/bin/) { next }
        }
        if ($0 == marker) { skip_next = 1; next }
        if ($0 ~ /export[ \t]+PATH=.*\.heimdall\/bin/) { next }
        print
      }
    ' "$rc" > "$tmp" 2>/dev/null; then
      # Only replace if the content actually changed (true idempotency: a profile
      # already clean is left byte-identical and reports nothing removed).
      if ! cmp -s "$rc" "$tmp"; then
        cat "$tmp" > "$rc" && {
          printf "  ${D}removed${R} PATH export from %s\n" "$(basename "$rc")"
          REMOVED_ANY=1
        }
      fi
    fi
    rm -f "$tmp" 2>/dev/null || true
  done
}

# ── Real-user detection (fail-safe gate for side effects $HOME cannot isolate) ──
#
# Echoes the home directory of the user this process actually runs as, resolved
# from the PASSWD DATABASE (getpwuid) — a source $HOME cannot influence. Empty
# output means "could not determine", which every caller MUST treat as unsafe.
#
# HEIMDALL_REAL_HOME is the test seam, the same family as the LAUNCHCTL and
# HEIMDALL_LAUNCH_AGENTS_DIR seams bin/heimdall-dream-schedule already documents.
# It overrides only the RESOLVED passwd home, so the acceptance suite can drive the
# real-user branch under a throwaway HOME with launchctl stubbed. Setting it can
# never by itself reach a real domain: the launchd call still goes through
# $LAUNCHCTL and the plist still comes from $HEIMDALL_LAUNCH_AGENTS_DIR.
#
# THE IMPLEMENTATION LIVES IN bin/lib/real-home.sh, shared with the INSTALL side
# (bin/heimdall-dream-schedule, which registers + loads the very LaunchAgent this
# file removes). Both directions of one guard must give the same answer; two copies
# would drift, and a drifted guard is an unguarded one. These two wrappers keep the
# existing call sites and, crucially, keep the FAIL-SAFE contract when the lib is
# unreadable (a partial install): the resolver yields empty and the comparison is
# false, so every caller reads "unsafe" and refuses.
_heimdall_real_user_home() {
  type heimdall_real_user_home >/dev/null 2>&1 || { printf ''; return 0; }
  heimdall_real_user_home
}
_heimdall_same_dir() {
  type heimdall_same_dir >/dev/null 2>&1 || return 1
  heimdall_same_dir "${1:-}" "${2:-}"
}

# ── Nightly-LaunchAgent removal (uninstall completeness) ──
#
# install.sh's ensure_dream_schedule registers a per-user launchd LaunchAgent
# (label com.heimdall.dream) that fires the overnight /dream sweep at 03:00.
# Uninstall never reversed it, so the job OUTLIVED the install and kept firing
# nightly forever against a deleted tree. This reverses it.
#
# WHY THIS NEEDS A GUARD. launchctl does NOT resolve through $HOME — it targets the
# real logged-in user's GUI session domain (gui/<uid>). A throwaway HOME therefore
# does NOT isolate it, so an unguarded call here would let any harness or CI run
# that performs a real uninstall unload the DEVELOPER'S OWN live nightly agent.
# This step runs only when it can prove it is the real user in the real home.
#
# THE PROOF DOES NOT TRUST THE CALLER. _heimdall_real_user_home reads the passwd
# database independently of $HOME and we compare. A synthetic HOME self-identifies
# with zero cooperation from whoever spawned the run — a guard that required every
# future caller to remember an env var would fail the first time one forgot.
# HEIMDALL_NO_DREAM_SCHEDULE=1 remains the EXPLICIT opt-out (the same variable
# install.sh's ensure_dream_schedule honors, so a dev who declined the schedule at
# install never has launchd touched at uninstall either); the passwd comparison is
# the backstop for everyone who does not set it.
#
# FAIL SAFE at every unknown — not macOS, no resolvable passwd home, or any
# mismatch → launchd is not touched at all.
#
# NEVER SOMEONE ELSE'S JOB. Removal is pinned to the exact label com.heimdall.dream.
# The primary path delegates to bin/heimdall-dream-schedule, which OWNS that label
# and derives the plist path from it; the fallback below repeats the label only for
# a partial install whose helper is already gone. No wildcard, no directory scan.
#
# Raises $REMOVED_ANY only when a plist was actually removed.
_heimdall_remove_dream_schedule() {
  local D R label la_dir plist sched real had
  D='\033[2m'; R='\033[0m'
  label="com.heimdall.dream"
  la_dir="${HEIMDALL_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
  plist="$la_dir/$label.plist"

  # Explicit opt-out — the harness/CI switch, checked before anything else.
  [ "${HEIMDALL_NO_DREAM_SCHEDULE:-0}" = "1" ] && return 0
  # launchd is the macOS scheduler; nothing to reverse anywhere else.
  [ "$(uname -s 2>/dev/null)" = "Darwin" ] || return 0

  # Fail-safe sandbox gate.
  real="$(_heimdall_real_user_home)"
  if ! _heimdall_same_dir "$real" "$HOME"; then
    # Only say so when there is actually a plist here, so a sandbox with nothing
    # installed stays silent instead of reporting a job that never existed.
    if [ -e "$plist" ]; then
      printf "  ${D}kept${R} %s ${D}(synthetic HOME — refusing to touch the real launchd domain)${R}\n" "$plist"
    fi
    return 0
  fi

  had=0; [ -e "$plist" ] && had=1
  sched="$PLUGIN_DIR/bin/heimdall-dream-schedule"
  if [ -x "$sched" ]; then
    # The helper owns the label + plist path and is already an idempotent off
    # switch. --repo is pinned to $HOME so a deleted or unreadable cwd cannot make
    # its repo resolution fail. Env seams pass straight through.
    "$sched" uninstall --repo "$HOME" >/dev/null 2>&1 || true
  else
    # Partial install: the helper is gone but its LaunchAgent may not be.
    "${LAUNCHCTL:-launchctl}" unload -w "$plist" >/dev/null 2>&1 || true
    rm -f "$plist" 2>/dev/null || true
  fi
  if [ "$had" -eq 1 ] && [ ! -e "$plist" ]; then
    printf "  ${D}removed${R} %s ${D}(nightly /dream LaunchAgent)${R}\n" "$plist"
    REMOVED_ANY=1
  fi
  return 0
}

# ── Claude Code statusLine de-registration (uninstall completeness) ──
#
# install.sh's ensure_statusline_registered writes statusLine + subagentStatusLine
# into ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json pointing at scripts inside
# the install tree. Uninstall never reversed it, so after removal Claude Code was
# left pointing statusLine at a deleted script. This reverses exactly those keys.
#
# BYTE PRESERVATION. The file is a USER config that may hold anything else, so it is
# never re-serialized. The python below locates the byte SPAN of each top-level
# member using the stdlib's own JSON primitives (scanstring + raw_decode) and
# SPLICES those spans out; every surviving key keeps its original bytes, including
# hand-applied formatting. The spliced text is then re-parsed and compared against
# the expected object — if anything but the dropped keys moved, nothing is written.
#
# OURS-ONLY. The match uses the SAME markers install.sh matches on (its WANT table),
# so this removes precisely what install considered its own, including a stale path
# from an older install location, and leaves a user's own custom statusLine alone.
#
# HOSTILE-INPUT SAFE. Absent → no-op. Invalid JSON, unreadable, or a hand-edited
# shape we cannot splice → reported and LEFT UNTOUCHED, never rewritten and never
# deleted. A backup is taken before any write and its path is printed.
#
# Raises $REMOVED_ANY only when a key was actually removed.
# The splice itself, in its OWN function so the here-document sits at function
# level. bash 3.2 — the macOS system shell this must keep running under — cannot
# parse a here-document nested inside a command substitution, so the obvious
# `report="$(python3 - <<'PY' … PY)"` is a hard syntax error there. The caller
# captures this function's stdout instead.
#   $1     settings.json path
#   stdout one TAB-separated "<token>\t<detail>" line per outcome (see the
#          caller's case table); always exits 0 so a python failure degrades to an
#          empty report rather than aborting the uninstall.
_heimdall_statusline_splice() {
  HMD_SL_SETTINGS="$1" python3 - <<'PY' 2>/dev/null || true
import contextlib, json, os, shutil, sys, tempfile, time
from json.decoder import scanstring

path = os.environ["HMD_SL_SETTINGS"]
# The markers install.sh's ensure_statusline_registered matches on. Exact reversal:
# what install treated as ours is what uninstall removes.
MARKERS = [("statusLine", "hooks/statusline.sh"),
           ("subagentStatusLine", "subagent-statusline.sh")]
WS = " \t\n\r"


def say(tok, detail=""):
    sys.stdout.write("%s\t%s\n" % (tok, detail))


try:
    with open(path) as fh:
        raw = fh.read()
except Exception:
    say("unreadable", path); sys.exit(0)

try:
    data = json.loads(raw)
except Exception:
    say("invalid", path); sys.exit(0)
if not isinstance(data, dict):
    say("invalid", path); sys.exit(0)

drop = []
for key, marker in MARKERS:
    cur = data.get(key)
    if cur is None:
        continue
    if isinstance(cur, dict) and marker in (cur.get("command") or ""):
        drop.append(key)
    else:
        say("kept-custom", key)
if not drop:
    say("none", path); sys.exit(0)


def skip_ws(s, i):
    n = len(s)
    while i < n and s[i] in WS:
        i += 1
    return i


def top_members(s):
    """Byte spans of every top-level member, via the stdlib's own JSON scanners."""
    dec = json.JSONDecoder()
    out = []
    i = skip_ws(s, 0)
    if i >= len(s) or s[i] != "{":
        raise ValueError("top level is not an object")
    i = skip_ws(s, i + 1)
    if i < len(s) and s[i] == "}":
        return out
    while True:
        i = skip_ws(s, i)
        if i >= len(s) or s[i] != '"':
            raise ValueError("expected a member key")
        kstart = i
        key, i = scanstring(s, i + 1)
        i = skip_ws(s, i)
        if i >= len(s) or s[i] != ":":
            raise ValueError("expected ':' after key")
        i = skip_ws(s, i + 1)
        _, i = dec.raw_decode(s, i)
        out.append({"key": key, "start": kstart, "end": i})
        i = skip_ws(s, i)
        if i < len(s) and s[i] == ",":
            i = skip_ws(s, i + 1)
            continue
        if i < len(s) and s[i] == "}":
            return out
        raise ValueError("unterminated object")


try:
    members = top_members(raw)
except Exception:
    say("error", "could not locate the keys byte-exactly; left untouched"); sys.exit(0)

# Cut ranges chosen so every SURVIVING member keeps its exact original bytes.
# Dropped members are merged into maximal CONSECUTIVE RUNS before cutting — NOT
# reasoned about one member at a time — because a per-member version only looks
# one predecessor back, and undercounts exactly the layout install.sh always
# produces: statusLine + subagentStatusLine land as the trailing TWO members of
# the object. Per-member logic cut each of their own spans fine but never
# reached past the run to the dangling comma left by the SURVIVING member two
# positions back, so `json.loads(new)` failed the sanity check below and the
# splice bailed out to "left untouched" — meaning the keys quietly survived a
# real uninstall, and only got removed on a SECOND run after an unrelated
# rewrite (claude plugins uninstall) reordered the file and made them a
# single-member-at-a-time case again. Root cause lived here, not in whatever
# idempotency check calls this.
#   run followed by a surviving member -> cut through THAT member's key start
#     (takes the run's own text + the separating comma/whitespace with it)
#   run reaches the end, a predecessor survives -> cut from the predecessor's
#     end (takes the now-dangling comma before the run)
#   run has no neighbour on either side (whole object dropped) -> cut just the
#     run; unreachable today (the all-dropped branch below short-circuits
#     first), kept as a defensive fallback
# Cases are disjoint by construction, so applying them right-to-left never
# invalidates an earlier offset.
drop_idx = [n for n, m in enumerate(members) if m["key"] in drop]
cuts = []
i = 0
while i < len(drop_idx):
    j = i
    while j + 1 < len(drop_idx) and drop_idx[j + 1] == drop_idx[j] + 1:
        j += 1
    lo, hi = drop_idx[i], drop_idx[j]
    if hi + 1 < len(members):
        cuts.append((members[lo]["start"], members[hi + 1]["start"]))
    elif lo > 0:
        cuts.append((members[lo - 1]["end"], members[hi]["end"]))
    else:
        cuts.append((members[lo]["start"], members[hi]["end"]))
    i = j + 1

if [m for m in members if m["key"] not in drop]:
    new = raw
    for a, b in sorted(cuts, reverse=True):
        new = new[:a] + new[b:]
else:
    # Nothing else was in the file; an empty object is the honest result and there
    # are no unrelated bytes left to preserve. The file itself is never deleted.
    new = "{}\n"

expect = dict((k, v) for k, v in data.items() if k not in drop)
try:
    got = json.loads(new)
except Exception:
    say("error", "splice produced invalid JSON; left untouched"); sys.exit(0)
if got != expect:
    say("error", "splice would have changed unrelated keys; left untouched"); sys.exit(0)

stamp = time.strftime("%Y%m%d%H%M%S")
backup = "%s.heimdall-uninstall-%s.bak" % (path, stamp)
try:
    shutil.copy2(path, backup)
except Exception:
    say("error", "could not write a backup; left untouched"); sys.exit(0)

tmp = ""
try:
    mode = os.stat(path).st_mode & 0o7777
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".",
                               prefix=".settings.", suffix=".tmp")
    with os.fdopen(fd, "w") as fh:
        fh.write(new)
    os.chmod(tmp, mode)
    os.replace(tmp, path)
except Exception:
    if tmp:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
    say("error", "could not rewrite the file; left untouched (backup: %s)" % backup)
    sys.exit(0)

say("backup", backup)
for key in drop:
    say("removed", key)
PY
}

_heimdall_remove_statusline() {
  local D R cfg settings report tok detail
  D='\033[2m'; R='\033[0m'
  cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  settings="$cfg/settings.json"
  [ -f "$settings" ] || return 0

  if ! command -v python3 >/dev/null 2>&1; then
    # install.sh cannot register without python3 either, so normally there is
    # nothing here. If a registration IS present, say so rather than leave Claude
    # Code silently pointed at a script this uninstall is about to delete.
    if grep -q 'hooks/statusline.sh' "$settings" 2>/dev/null; then
      printf "  ${D}kept${R} %s ${D}(python3 unavailable — remove its heimdall statusLine entries by hand)${R}\n" "$settings"
    fi
    return 0
  fi

  report="$(_heimdall_statusline_splice "$settings")"

  while IFS=$'\t' read -r tok detail; do
    case "$tok" in
      removed)
        printf "  ${D}removed${R} %s ${D}from %s${R}\n" "$detail" "$settings"
        REMOVED_ANY=1 ;;
      backup)
        printf "  ${D}backup${R} %s\n" "$detail" ;;
      kept-custom)
        printf "  ${D}kept${R} %s ${D}in %s (yours, not heimdall's)${R}\n" "$detail" "$settings" ;;
      invalid)
        printf "  ${D}kept${R} %s ${D}(not valid JSON — left untouched; remove its heimdall statusLine entries by hand)${R}\n" "$detail" ;;
      unreadable)
        printf "  ${D}kept${R} %s ${D}(unreadable — left untouched)${R}\n" "$detail" ;;
      error)
        printf "  ${D}kept${R} %s ${D}(%s)${R}\n" "$settings" "$detail" ;;
    esac
  done <<EOF
$report
EOF
  return 0
}

# ── Ensure Claude Code is installed ──

ensure_claude() {
  if command -v claude &>/dev/null; then
    return 0
  fi
  echo "  Claude Code not found. Installing..."
  if command -v npm &>/dev/null; then
    npm install -g @anthropic-ai/claude-code
  elif command -v brew &>/dev/null; then
    brew install node
    npm install -g @anthropic-ai/claude-code
  else
    echo "  Error: npm not found. Install Node.js 18+ first: https://nodejs.org"
    exit 1
  fi
  if ! command -v claude &>/dev/null; then
    echo "  Error: Claude Code install failed. Run: npm install -g @anthropic-ai/claude-code"
    exit 1
  fi
  echo "  Claude Code installed."
}

# ── Ensure Claude Code is authenticated ──

# heimdall_is_authed — TRUE (return 0) iff a usable credential is already present:
#   - ANTHROPIC_API_KEY in the environment, OR
#   - a stored OAuth account in ~/.claude.json (accountUuid confirms a completed
#     login; the tokens themselves live in the system keychain).
# Pure probe: NO prompt, NO login, NO side effects. Reused by ensure_auth and by
# any caller that wants to branch on auth state without triggering a login.
heimdall_is_authed() {
  [ -n "${ANTHROPIC_API_KEY:-}" ] && return 0
  local claude_cfg="$HOME/.claude.json"
  if [ -f "$claude_cfg" ] && command -v python3 &>/dev/null; then
    local has_account
    has_account=$(python3 -c "
import json
try:
    with open('$claude_cfg') as f:
        cfg = json.load(f)
    acct = cfg.get('oauthAccount', {})
    print('true' if acct.get('accountUuid') else 'false')
except Exception:
    print('false')
" 2>/dev/null)
    [ "$has_account" = "true" ] && return 0
  fi
  return 1
}

# ensure_auth — NON-FATAL, NON-BLOCKING auth resolution.
#
# THE FIRST-RUN BUG THIS FIXES: this step used to run `claude login` INTERACTIVELY
# and `exit 1` when no account got established. On a fresh VM that login dropped
# into an interactive flow the user ^C'd — aborting the WHOLE bootstrap BEFORE
# companion setup ran and BEFORE the first-run marker was written. So `hmd` had to
# be run TWICE (run 1 = auth-then-abort, run 2 = companion setup, which then blocked
# on the claude-mem npm confirm). The auth branch and the companion-setup branch
# were effectively mutually exclusive per invocation.
#
# THE FIX: auth NEVER aborts the bootstrap and NEVER blocks on an interactive login.
#   - authed (API key or stored account) → silent no-op (the normal warm path).
#   - not authed → print a CLEAR, headless-friendly one-line sign-in instruction and
#     RETURN 0. The caller runs companion setup FIRST (marker already written), so a
#     deferred/absent login can never undo setup, and a later `hmd` (once the user
#     signs in) goes STRAIGHT to work — never back into setup. The subsequent
#     `claude … -p` launch handles its own auth prompt if the user has not yet.
# Always returns 0. Emits auth telemetry: succeeded when authed, a NON-FATAL
# auth-deferred datum when sign-in is still pending (never a token/secret value).
ensure_auth() {
  local _auth_t0; _auth_t0="$(_tele_now_ms)"
  _tele_install_step auth started

  if heimdall_is_authed; then
    _tele_install_step auth succeeded "$_auth_t0"
    return 0
  fi

  # Not authenticated — DEFER, never block. Print the sign-in instruction, covering
  # BOTH the browser login and the headless code-relay / setup-token path for a
  # server/VM with no browser, then continue so setup + marker complete regardless.
  local W C D R
  W='\033[38;2;255;200;80m'; C='\033[38;2;0;212;255m'; D='\033[2m'; R='\033[0m'
  printf "\n  ${W}⚠ Not signed in to Claude Code yet — setup is otherwise complete.${R}\n"
  printf "  To start running tasks, sign in ONCE, then re-run your command:\n"
  printf "    ${C}claude${R}              ${D}opens login (a server/VM with no browser prints a code-relay link to open elsewhere)${R}\n"
  printf "    ${C}claude setup-token${R}  ${D}headless / no browser — generates a token to paste${R}\n"
  printf "  ${D}(Or export ANTHROPIC_API_KEY to skip interactive login entirely.)${R}\n\n"

  _tele_install_step auth failed "$_auth_t0" auth-deferred "sign-in deferred to user; bootstrap continued"
  return 0
}

# ── Ensure node is in PATH (nvm lazy-loads, hooks don't inherit it) ──

ensure_node_path() {
  if command -v node &>/dev/null; then
    return 0
  fi
  # nvm sets up a shell function, not a PATH entry — hooks can't see it.
  # Find the latest nvm-managed node and export its bin dir.
  local nvm_dir="${NVM_DIR:-$HOME/.nvm}"
  if [ -d "$nvm_dir/versions/node" ]; then
    local latest
    latest=$(ls "$nvm_dir/versions/node" 2>/dev/null | sed 's/^v//' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
    if [ -n "$latest" ] && [ -x "$nvm_dir/versions/node/v${latest}/bin/node" ]; then
      export PATH="$nvm_dir/versions/node/v${latest}/bin:$PATH"
    fi
  fi
}

# ── First-run setup: install companion plugins ──

first_run_setup() {
  if [ -f "$SETUP_MARKER" ]; then
    return 0
  fi
  echo "First run — setting up companion plugins..."

  # setup step telemetry brackets the whole first-run sequence (the umbrella
  # phase). The companion/skills/launch-readiness sub-steps below each emit their
  # OWN started/succeeded|failed so aggregate (piece d) can pinpoint exactly which
  # one failed — the setup umbrella alone would hide it.
  local _setup_t0; _setup_t0="$(_tele_now_ms)"
  _tele_install_step setup started

  # caveman (token compression) — its OWN step (companion:caveman).
  if ! claude plugins list 2>/dev/null | grep -q "caveman"; then
    echo "  + caveman (token compression)"
    local _cav_t0 _cav_rc=0
    _cav_t0="$(_tele_now_ms)"
    _tele_install_step companion:caveman started
    claude plugins marketplace add JuliusBrussee/caveman 2>/dev/null || true
    claude plugins install caveman@caveman 2>/dev/null || _cav_rc=$?
    if [ "$_cav_rc" -eq 0 ]; then
      _tele_install_step companion:caveman succeeded "$_cav_t0"
    else
      _tele_install_step companion:caveman failed "$_cav_t0" \
        plugin-install-failed "claude plugins install caveman exit $_cav_rc"
    fi
  fi

  # superpowers (brainstorming, debugging) — part of the `skills` step.
  if ! claude plugins list 2>/dev/null | grep -q "superpowers"; then
    echo "  + superpowers (brainstorming, debugging)"
    local _sp_t0 _sp_rc=0
    _sp_t0="$(_tele_now_ms)"
    _tele_install_step skills started
    claude plugins marketplace add anthropics/claude-plugins-official 2>/dev/null || true
    claude plugins install superpowers 2>/dev/null || _sp_rc=$?
    if [ "$_sp_rc" -eq 0 ]; then
      _tele_install_step skills succeeded "$_sp_t0"
    else
      _tele_install_step skills failed "$_sp_t0" \
        plugin-install-failed "claude plugins install superpowers exit $_sp_rc"
    fi
  fi

  # claude-mem (persistent cross-session memory) — OPTIONAL companion.
  #
  # GRACEFUL-SKIP CONTRACT (friction removal): claude-mem is the single most
  # failure-prone install step (it shells out to npx → a network npm install).
  # A failed OR impossible install must NEVER hard-fail or hang the launcher —
  # Heimdall works without it. So every outcome here is narrated and recovers:
  #   - npx absent           → can't install → print the optional-skip line, move on
  #   - npx install nonzero  → print the optional-skip line, move on (no cryptic err)
  #   - npx install succeeds → confirm it
  # We do NOT swap claude-mem here (a later data-driven decision). The npx exit
  # code is still captured at npm-exec granularity for the install_step telemetry
  # so piece (d) can answer "is claude-mem's npm-exec the dominant failure point?".
  # The skip line is the EXACT user-facing message the friction-removal spec pins.
  if ! command -v claude-mem &>/dev/null; then
    echo "  + claude-mem (persistent memory across sessions)"
    local _cm_t0; _cm_t0="$(_tele_now_ms)"
    _tele_install_step companion:claude-mem started
    # TTY+BUN GATE (LIVE-VM #2 fix): claude-mem's `npx claude-mem install` is an
    # interactive multi-prompt wizard (email/IDE/runtime/provider/model) that ALSO
    # requires `bun`. On a headless box force-feeding stdin still ran the wizard and
    # aborted mid-way (`bun-missing-after-install`). So ATTEMPT the installer ONLY
    # when BOTH a real TTY (stdin AND stdout) AND bun are present; otherwise SKIP
    # cleanly WITHOUT ever launching it. This is the dominant first-run friction.
    if ! { [ -t 0 ] && [ -t 1 ]; } || ! command -v bun &>/dev/null; then
      # No interactive terminal and/or no bun → the wizard can't complete. Skip
      # without invoking the installer (never hang, never a cryptic mid-wizard abort).
      echo "  claude-mem is an optional companion — skipped (needs an interactive terminal + bun; Heimdall works without it)"
      echo "    (re-enable anytime in a terminal with bun installed: 'npx claude-mem install')"
      _tele_install_step companion:claude-mem skipped "$_cm_t0" \
        no-tty-or-bun "tty=$([ -t 0 ] && [ -t 1 ] && echo 1 || echo 0) bun=$(command -v bun >/dev/null 2>&1 && echo 1 || echo 0)"
    elif ! command -v npx &>/dev/null; then
      # No npx → cannot install. This is not an error to halt on: skip gracefully.
      echo "  claude-mem is an optional companion — skipped (Heimdall works without it)"
      echo "    (npm/npx not found; install Node.js then run 'npx claude-mem install' to enable it)"
      _tele_install_step companion:claude-mem failed "$_cm_t0" \
        npx-absent "npx not on PATH"
    else
      local _cm_rc=0
      # HEADLESS-SAFE ATTEMPT (the live-VM fix, done right): run the installer with
      # stdin from /dev/null so a wizard prompt can NEVER hang the launcher — on a
      # headless box (no TTY / no bun) the wizard reads EOF and aborts FAST, which
      # surfaces as a nonzero exit → the graceful-skip path below. `</dev/null` (NOT
      # the old `< <(yes)`) means one clean EOF: no prompt-spam, no pipefail SIGPIPE.
      # `npx --yes` auto-confirms npx's OWN package-fetch prompt; the exit code stays
      # that of npx, so the npm-exec outcome is captured at npm-exec granularity
      # (dossier §3 piece d: "is claude-mem's npm-exec the dominant failure point?" —
      # a pre-emptive skip would emit no npm-exec datum at all). A nonzero exit is
      # NON-FATAL; a real TTY + bun let the wizard run to completion → succeeded.
      npx --yes claude-mem install </dev/null || _cm_rc=$?
      if [ "$_cm_rc" -eq 0 ]; then
        _tele_install_step companion:claude-mem succeeded "$_cm_t0"
      else
        # Declined or failed (incl. no-TTY / bun-absent fast-abort) → graceful skip
        # with the pinned message + the exact manual step, never a cryptic error or a
        # hang.
        echo "  claude-mem is an optional companion — skipped (Heimdall works without it)"
        echo "    (re-enable anytime: 'npx claude-mem install')"
        _tele_install_step companion:claude-mem failed "$_cm_t0" \
          npm-exec-nonzero "npm exec exit $_cm_rc"
      fi
    fi
  fi

  # heimdall marketplace — part of the `skills` step (marketplace registration).
  if ! claude plugins marketplace list 2>/dev/null | grep -q "heimdall-marketplace"; then
    echo "  + heimdall marketplace"
    local _mk_t0 _mk_rc=0
    _mk_t0="$(_tele_now_ms)"
    _tele_install_step skills started
    claude plugins marketplace add randomittin/heimdall-marketplace 2>/dev/null || _mk_rc=$?
    if [ "$_mk_rc" -eq 0 ]; then
      _tele_install_step skills succeeded "$_mk_t0"
    else
      _tele_install_step skills failed "$_mk_t0" \
        marketplace-add-failed "claude plugins marketplace add heimdall exit $_mk_rc"
    fi
  fi

  _write_setup_marker
  _tele_install_step setup succeeded "$_setup_t0"

  # launch-readiness: a post-marker probe that the setup artifacts are in place
  # (the marker exists ⇒ subsequent launches short-circuit first_run_setup). This
  # is the end-of-setup readiness datum piece (d) reads to confirm an install
  # actually reached a launchable state.
  local _lr_t0; _lr_t0="$(_tele_now_ms)"
  _tele_install_step launch-readiness started
  if [ -f "$SETUP_MARKER" ]; then
    _tele_install_step launch-readiness succeeded "$_lr_t0"
  else
    _tele_install_step launch-readiness failed "$_lr_t0" \
      setup-marker-absent "setup marker not written"
  fi

  echo "Setup complete."
  echo ""
}

# ── Theme, animation, and helper functions ──
# (Must be defined before command handlers that use them)

apply_heimdall_theme() {
  export COLORTERM=truecolor
  export TERM="${TERM:-xterm-256color}"
  export CLAUDE_CODE_NO_FLICKER=1
  export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
  local claude_cfg="$HOME/.claude.json"
  if [ -f "$claude_cfg" ] && command -v python3 &>/dev/null; then
    python3 -c "
import json, sys
try:
    with open('$claude_cfg') as f: cfg = json.load(f)
    if cfg.get('theme') != 'dark':
        cfg['theme'] = 'dark'
        with open('$claude_cfg','w') as f: json.dump(cfg, f, indent=2)
except Exception: pass
" 2>/dev/null || true
  fi
}

ensure_project_claude_md() {
  local project_md="$WORK_DIR/CLAUDE.md"
  [ -f "$project_md" ] && return 0
  cat > "$project_md" <<'CLAUDEMD'
# Project Conventions (managed by heimdall)

## Rules
- All code, configs, docs go in this project directory
- Planning state lives in `.planning/` (human-readable, git-committed)
- Each completed task = one atomic git commit
- Acceptance criteria must be runnable (grep, curl, test commands)

## Quality Gates (enforced before git push)
- All tests passing
- Lint clean (zero warnings)
- Code review completed
- No untested changes

## Code Quality — Zero Tolerance
- NEVER write stub, dummy, placeholder, shim, mock, TODO, or skeleton code
- Every line must be real, working, production-ready
- No `// TODO: implement`, no `pass`, no empty function bodies, no fake data
- If you cannot implement something fully, say so — do not fake it

## Style
- Follow existing patterns in the codebase
- Prefer small, focused files over large monoliths
- Name things clearly — a reader should understand without context

## Token Efficiency
- Caveman compression active: terse output, abbreviations, arrows for causality
- Level is owned by hmd directly (`heimdall-caveman get|set|rules`), not by the caveman plugin — do not hardcode a level here; read it live
- Drop articles, filler, hedging — code and paths stay exact
CLAUDEMD
}

type_text() {
  local text="$1" delay="${2:-0.02}"
  for (( i=0; i<${#text}; i++ )); do
    printf "%s" "${text:$i:1}"
    sleep "$delay"
  done
}

# ── Loader color tier ─────────────────────────────────────────────────────────
# Resolve the shader-spinner's render tier, mirroring hmd_termcaps precedence but
# in pure bash (spin() is a hot foreground loop; no python per frame). Tiers:
#   truecolor | 256 | 16 : animated braille bar with a sweeping color band
#   mono                  : animated PLAIN braille, no color codes (no-color TTY)
#   none                  : no animation at all — used for a non-TTY stdout so we
#                           never spew \r frames into a pipe/file ("no garbage")
# Overrides (demo/test): HEIMDALL_SPIN_TIER forces a tier and bypasses the TTY
# check so frames can be captured headlessly; HEIMDALL_STATUSLINE_MODE is honored
# for consistency with the statusline.
_spin_tier() {
  local mode="${HEIMDALL_SPIN_TIER:-${HEIMDALL_STATUSLINE_MODE:-}}"
  case "$mode" in
    truecolor|256|16|mono|none) printf '%s' "$mode"; return;;
    ascii) printf 'mono'; return;;
  esac
  # non-TTY stdout → never animate (piped \r frames are garbage bytes)
  [ -t 1 ] || { printf 'none'; return; }
  # explicit no-color / dumb terminal → plain braille (animated, zero color codes)
  if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = "dumb" ]; then
    printf 'mono'; return
  fi
  # tmux/screen: 24-bit SGR is unreliable → cap at 256
  case "${TERM:-}" in screen*|tmux*) printf '256'; return;; esac
  [ -n "${TMUX:-}" ] && { printf '256'; return; }
  # an explicit truecolor advertisement is the strongest positive signal
  case "${COLORTERM:-}" in truecolor|24bit) printf 'truecolor'; return;; esac
  # Apple Terminal has no 24-bit path → 256
  [ "${TERM_PROGRAM:-}" = "Apple_Terminal" ] && { printf '256'; return; }
  case "${TERM:-}" in *256color*) printf '256'; return;; esac
  printf '16'   # any other real TERM → 16-color
}

# ── Shader-style spinner ───────────────────────────────────────────────────────
# Same contract as before: `spin <pid> <msg>` animates until <pid> exits, then
# prints "  ✔ <msg>". Instead of one glyph, it renders a short braille BAR whose
# glyph advances through the spin frames (the shimmer) while a bright color band
# sweeps left→right across it (the shader sweep). Degrades truecolor→256→16→mono;
# non-TTY skips animation entirely. Cursor is hidden during the sweep and always
# restored, and the line is cleared (\033[K) on stop.
spin() {
  local pid=$1 msg="$2"
  local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  local tier; tier="$(_spin_tier)"

  # non-TTY / disabled: wait quietly, emit the result line only (no \r, no ANSI).
  if [ "$tier" = "none" ]; then
    while kill -0 "$pid" 2>/dev/null; do sleep 0.08; done
    printf "  ✔ %s\n" "$msg"
    return
  fi

  local R=$'\033[0m'
  local W=10 span=14                 # bar cells; band travel incl. off-screen gap
  # truecolor endpoints: dim slate (off-band) → bright cyan-white (band center)
  local br0=70 bg0=70 bb0=110 br1=130 bg1=240 bb1=255
  local c256=(60 61 67 74 81 159)    # xterm-256 ramp, index by level 0..5
  local c16=($'\033[34m' $'\033[34m' $'\033[36m' $'\033[36m' $'\033[1;36m' $'\033[1;37m')
  local chk=""                       # per-tier green for the ✔ (never truecolor on 256/16)
  case "$tier" in
    truecolor) chk=$'\033[38;2;78;204;163m';;
    256)       chk=$'\033[38;5;78m';;
    16)        chk=$'\033[32m';;
  esac

  printf '\033[?25l'                  # hide cursor for a clean sweep
  local i=0
  while kill -0 "$pid" 2>/dev/null; do
    local glyph="${frames[$((i % 10))]}"
    local center=$(( i % span )) bar="" cell d lvl
    for (( cell=0; cell<W; cell++ )); do
      d=$(( cell - center )); [ $d -lt 0 ] && d=$(( -d ))
      case $d in 0) lvl=5;; 1) lvl=4;; 2) lvl=2;; 3) lvl=1;; *) lvl=0;; esac
      case "$tier" in
        truecolor)
          local rr=$(( br0 + (br1-br0)*lvl/5 ))
          local gg=$(( bg0 + (bg1-bg0)*lvl/5 ))
          local bb=$(( bb0 + (bb1-bb0)*lvl/5 ))
          bar+=$'\033[38;2;'"$rr;$gg;$bb"'m'"$glyph" ;;
        256) bar+=$'\033[38;5;'"${c256[$lvl]}"'m'"$glyph" ;;
        16)  bar+="${c16[$lvl]}$glyph" ;;
        mono) bar+="$glyph" ;;
      esac
    done
    if [ "$tier" = "mono" ]; then
      printf "\r  %s %s\033[K" "$bar" "$msg"
    else
      printf "\r  %s%s %s\033[K" "$bar" "$R" "$msg"
    fi
    sleep 0.08
    i=$(( i + 1 ))
  done

  # stop: rewrite line as the result, clear trailing sweep chars, restore cursor.
  if [ "$tier" = "mono" ]; then
    printf "\r  ✔ %s\033[K\n" "$msg"
  else
    printf "\r  %s✔%s %s\033[K\n" "$chk" "$R" "$msg"
  fi
  printf '\033[?25h'
}

# ── Dynamic version (NEVER baked) ──
#
# Resolve the running version at runtime so the banner can never drift from the
# shipped release. Resolution order:
#   1. nearest git tag (git describe --tags --abbrev=0 from the plugin repo root),
#      normalised to a clean vX.Y.Z (strip any trailing -N-gSHA / +meta).
#   2. fall back to the canonical "version" field in the plugin manifest
#      (.claude-plugin/plugin.json), prefixed with v.
# Prints a vX.Y.Z string, or nothing if neither source resolves (banner then
# simply omits the version rather than printing a lie).
heimdall_version() {
  local ver=""
  # Use rev-parse (not [ -d .git ]) so this also resolves inside a git WORKTREE,
  # where .git is a gitdir-pointer FILE rather than a directory.
  if git -C "$PLUGIN_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    # --match scopes describe to SEMVER tags only: a scratch/backup tag (e.g.
    # backup/pre-secret-scrub) must NEVER shadow the version string.
    ver="$(git -C "$PLUGIN_DIR" describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true)"
    # Normalise: keep only a leading vMAJOR.MINOR.PATCH, drop any suffix; blank
    # anything that is NOT a clean vN.N.N so the deterministic fallback below wins.
    if [ -n "$ver" ]; then
      ver="$(printf '%s' "$ver" | sed -E 's/^v?([0-9]+\.[0-9]+\.[0-9]+).*/v\1/')"
      printf '%s' "$ver" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$' || ver=""
    fi
  fi
  if [ -z "$ver" ]; then
    # Manifest fallback — used ONLY when git is unavailable (e.g. a tarball
    # install with no .git). plugin.json's .version is NOT the source of truth:
    # the git tag is. It is a best-effort fallback that release/sync-release.sh
    # bumps so it stays consistent with the tag (and the conformance version
    # fixture cross-checks both). Treat a stale value here as a fallback-only
    # lie-of-last-resort, never as authoritative.
    local manifest="$PLUGIN_DIR/.claude-plugin/plugin.json"
    if [ -f "$manifest" ]; then
      local raw=""
      if command -v jq >/dev/null 2>&1; then
        raw="$(jq -r '.version // empty' "$manifest" 2>/dev/null || true)"
      else
        raw="$(grep -oE '"version"[[:space:]]*:[[:space:]]*"[^"]+"' "$manifest" 2>/dev/null | head -1 | sed -E 's/.*"([^"]+)".*/\1/')"
      fi
      [ -n "$raw" ] && ver="v${raw#v}"
    fi
  fi
  printf '%s' "$ver"
}

# ── Banner version (plugin.json is the SINGLE SOURCE OF TRUTH) ──
#
# The startup BANNER must always match the SHIPPED release. The manifest
# (.claude-plugin/plugin.json) ships bundled WITH the release code, so it is the
# authoritative answer to "what code is this". A git tag, by contrast, can be
# STALE or MISSING in an INSTALLED plugin clone — a shallow/behind checkout whose
# nearest reachable tag lags the manifest. That is exactly how the banner drifted
# to a stale v2.0.18 while the shipped manifest already read 2.1.0 (heimdall_version
# resolves the git tag FIRST, so a behind-checkout tag shadowed the truth).
#
# So the BANNER reads the manifest FIRST and only falls back to the git-tag
# resolver when the manifest is unreadable (a tarball with no manifest) — never a
# hardcoded string. NOTE: `hmd version` deliberately keeps the OPPOSITE order (git
# tag = canonical release identity) via heimdall_version(); this resolver is
# banner-scoped on purpose, so the two do not conflict.
banner_version() {
  local ver="" raw="" manifest="$PLUGIN_DIR/.claude-plugin/plugin.json"
  if [ -f "$manifest" ]; then
    if command -v jq >/dev/null 2>&1; then
      raw="$(jq -r '.version // empty' "$manifest" 2>/dev/null || true)"
    else
      raw="$(grep -oE '"version"[[:space:]]*:[[:space:]]*"[^"]+"' "$manifest" 2>/dev/null | head -1 | sed -E 's/.*"([^"]+)".*/\1/')"
    fi
    [ -n "$raw" ] && ver="v${raw#v}"
  fi
  # Manifest unreadable → defer to the git-tag resolver so the banner still shows
  # something truthful rather than nothing.
  [ -z "$ver" ] && ver="$(heimdall_version)"
  printf '%s' "$ver"
}

print_banner() {
  local C V G D R
  R='\033[0m'
  if [[ "${COLORTERM:-}" == "truecolor" || "${COLORTERM:-}" == "24bit" ]]; then
    C='\033[38;2;0;212;255m'
    V='\033[38;2;155;89;182m'; G='\033[38;2;78;204;163m'
    D='\033[38;2;100;100;120m'
  elif [[ "${TERM:-}" == *256color* ]]; then
    C='\033[38;5;39m'
    V='\033[38;5;134m'; G='\033[38;5;78m'
    D='\033[38;5;242m'
  else
    C='\033[36m'; V='\033[34m'; G='\033[32m'; D='\033[37m'
  fi
  printf "\n"
  # ── Watchman banner (heimdall-install-ux.md §A3) ──
  # Reuse the SINGLE renderer (bin/heimdall-face --banner) that install.sh and the
  # demo use — idle watchman eyes + wordmark + tagline, wcwidth-padded to equal
  # display width per line so it aligns across terminals. No hand-typed art here.
  # TTY → fancy (eyes + color); piped/non-TTY → the renderer degrades to wordmark +
  # tagline only, so `heimdall "task" | cat` never emits ANSI garbage or breaks.
  local FACE_BIN="$PLUGIN_DIR/bin/heimdall-face"
  if [ -x "$FACE_BIN" ]; then
    local face_flag="--no-color"
    [ -t 1 ] && face_flag="--color"
    while IFS= read -r _bl; do
      printf "  %s\n" "$_bl"
    done < <("$FACE_BIN" --banner "$face_flag" 2>/dev/null)
  else
    # Renderer absent (partial/broken install) → minimal text, never blank.
    printf "  H E I M D A L L\n  Nothing ships unproven.\n"
  fi
  # Dynamic version line — resolved at runtime from the shipped manifest
  # (.claude-plugin/plugin.json) FIRST so the banner can never drift from the
  # shipped release; git-tag only as a manifest-unreadable fallback. Never baked.
  local _ver; _ver="$(banner_version)"
  [ -n "$_ver" ] && printf "  ${D}%s${R}\n" "$_ver"
  sleep 0.1
  printf "  ${V}╭─────────────────────────────────────╮${R}\n"; sleep 0.05
  printf "  ${V}│${R}  ${C}▸${R} autonomous orchestration          ${V}│${R}\n"; sleep 0.05
  printf "  ${V}│${R}  ${C}▸${R} wave-based parallel execution     ${V}│${R}\n"; sleep 0.05
  printf "  ${V}│${R}  ${C}▸${R} smart skill management            ${V}│${R}\n"; sleep 0.05
  printf "  ${V}│${R}  ${C}▸${R} caveman      ${G}terser output${R}      ${V}│${R}\n"; sleep 0.05
  printf "  ${V}│${R}  ${C}▸${R} claude-mem     ${G}persistent memory${R}  ${V}│${R}\n"; sleep 0.05
  printf "  ${V}╰─────────────────────────────────────╯${R}\n"
  local short_cwd; short_cwd=$(echo "$WORK_DIR" | sed "s|$HOME|~|")
  printf "  ${D}cwd:${R} ${C}%s${R}" "$short_cwd"
  if [ -f "$WORK_DIR/.heimdall-no-autocommit" ] || [ -f "$WORK_DIR/.superx-no-autocommit" ]; then
    printf "  ${D}[auto-commit: off]${R}"
  fi
  printf "\n\n"
}

# ── Reserved subcommands (Part C/D) ──
#
# `hmd <word>` and `heimdall <word>` are the SAME binary (hardlinked at install),
# so routing is written once here and shared by both entry points. A small set
# of reserved words — demo, uninstall, version, help — are routed as real
# subcommands (the space form: `hmd demo`) BEFORE the task-prompt fallthrough.
# Everything else falls through to task-prompt behavior (`hmd "build X"`), which
# is the everyday two-letter invocation the short name exists for.

ENTRY_NAME="$(basename "$0")"   # hmd or heimdall — for self-referential help

# ── run-count (unlock gamification for `hmd sigil`) ──────────────────────────
# No existing per-invocation dev counter exists (.planning/metrics.jsonl is per-REPO
# task-outcome records, not per-dev hmd runs), so a tiny counter file owns it. Bumped
# ONCE per hmd invocation; HEIMDALL_RUN_COUNTED makes it idempotent within one process
# tree (nested self-calls don't double-count). Never fails the caller.
HEIMDALL_RUN_COUNT_FILE="$HEIMDALL_HOME_DIR/.run-count"
# One-shot sigil-unlock reveal (FIX 1): the ≥5-run `hmd sigil` customization unlock
# is otherwise SILENT. `.unlock-pending` is armed on the first crossing into unlocked
# territory; the next session-close farewell prints the celebration ONCE and drops a
# `.unlock-shown` marker so it is never re-armed or repeated.
HEIMDALL_UNLOCK_PENDING_FILE="$HEIMDALL_HOME_DIR/.unlock-pending"
HEIMDALL_UNLOCK_SHOWN_FILE="$HEIMDALL_HOME_DIR/.unlock-shown"
hmd_run_count() {                     # echo the current count (0 when absent/garbage)
  local n=0
  [ -f "$HEIMDALL_RUN_COUNT_FILE" ] && n="$(cat "$HEIMDALL_RUN_COUNT_FILE" 2>/dev/null || echo 0)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  printf '%s' "$n"
}
hmd_bump_run_count() {
  [ -n "${HEIMDALL_RUN_COUNTED:-}" ] && return 0
  export HEIMDALL_RUN_COUNTED=1
  # Routed through the ONE creator. This call site IS the uninstall-resurrection
  # bug: it runs in the preamble on EVERY invocation, uninstall included.
  _heimdall_home_ensure || return 0
  local prev n; prev="$(hmd_run_count)"; n=$((prev + 1))
  printf '%s\n' "$n" > "$HEIMDALL_RUN_COUNT_FILE" 2>/dev/null || true
  # First crossing into the unlocked band (prev<5 -> n>=5): arm the one-shot reveal.
  # Guarded on the shown-marker so a manually-edited or re-crossed counter never re-arms.
  if [ "$prev" -lt 5 ] && [ "$n" -ge 5 ] && [ ! -f "$HEIMDALL_UNLOCK_SHOWN_FILE" ]; then
    : > "$HEIMDALL_UNLOCK_PENDING_FILE" 2>/dev/null || true
  fi
  return 0
}
# ── LIBRARY-ONLY MODE: RESOLVE THE FLAG ONCE, TRUTHILY ────────────────────────
# Both halves of library mode used to test the raw variable for EMPTINESS
# (-z here, -n at part 2). Emptiness is the wrong question for a boolean: it makes
# every non-empty value mean ON, so `HEIMDALL_LIB_ONLY=0` -- a caller explicitly
# turning the flag OFF -- turned it ON and silenced the entire CLI. `hmd version`
# then printed NOTHING and exited 0, and so did every other subcommand.
#
# That failure is invisible by construction, which is what makes it worth a named
# variable: no output, no error, exit 0. It is the same shape as the incident
# recorded below (hmd-emit-usage exiting 0 having asserted nothing), and anyone
# who exports HEIMDALL_LIB_ONLY=0 in a shell gets an `hmd` that silently does
# nothing at all. Resolve to a normalized 0/1 ONCE, here, and let both guards read
# the answer instead of re-deriving it differently at two sites ~2000 lines apart.
#
# Assigned unconditionally (never :-) so a stray HMD_LIB_ONLY in the caller's
# environment cannot decide this.
case "${HEIMDALL_LIB_ONLY:-}" in
  ''|0|no|NO|No|off|OFF|Off|false|FALSE|False) HMD_LIB_ONLY=0 ;;
  *)                                           HMD_LIB_ONLY=1 ;;
esac

# ── LIBRARY-ONLY MODE, part 1 of 2: SKIP THE LAUNCHER DISPATCH ────────────────
# The acceptance harness sources this file with HEIMDALL_LIB_ONLY=1 to exercise
# individual functions. `source` inherits the CALLER's positional parameters, so a
# harness that takes no arguments of its own arrives here with an EMPTY "$1" and
# lands on the `''` arm below — whose entire job is to `exec heimdall-wrap launch`,
# replacing the harness process outright.
#
# That is not hypothetical. test/hmd-emit-usage.test.sh ran ZERO of its assertions,
# printed no "N passed, M failed" line and still exited 0 — run-all.sh reported it
# UNPARSED, "counts UNKNOWN, not assumed pass" — while silently re-wrapping the repo
# on every board run.
#
# The stop-here guard cannot prevent this: it sits ~2000 lines BELOW, because the
# functions library mode exists to expose are defined after this dispatch. So
# library mode skips the run-count bump and the whole dispatch HERE, then stops at
# part 2 once those definitions have been read. Both halves are required; neither
# alone makes the documented "no setup side-effects" contract true.
if [ "$HMD_LIB_ONLY" = 0 ]; then

hmd_bump_run_count || true

case "${1:-}" in
  version|--version|-v|-V)
    # Resolve via the SAME dynamic resolver the banner + install card use, so all
    # three surfaces report identically and plugin.json's .version can never make
    # `hmd version` drift (it was hardcoded 1.1.0 and reported a lie). Resolution
    # order is owned by heimdall_version(): nearest git tag → manifest fallback
    # ONLY if git is unavailable. Do NOT re-parse plugin.json here.
    ver="$(heimdall_version)"      # returns vX.Y.Z (or empty if neither source resolves)
    ver="${ver#v}"                 # strip leading v for the "Heimdall v<...>" format
    [ -n "$ver" ] || ver="?"
    echo "Heimdall v$ver"
    # Use rev-parse (not [ -d .git ]) so the commit line also resolves inside a
    # git WORKTREE, where .git is a gitdir-pointer FILE rather than a directory.
    if git -C "$PLUGIN_DIR" rev-parse --git-dir >/dev/null 2>&1; then
      sha="$(git -C "$PLUGIN_DIR" rev-parse --short HEAD 2>/dev/null || echo '')"
      [ -n "$sha" ] && echo "  commit $sha"
    fi
    exit 0
    ;;
  help)
    # Route the bare `help` subcommand into the existing --help handler below.
    set -- --help
    ;;
  demo)
    # Real subcommand on both entry points. Delegate to the demo runner,
    # passing through any remaining args (e.g. target dir, --run, --dry).
    shift
    DEMO_BIN="$PLUGIN_DIR/bin/heimdall-demo"
    if [ ! -x "$DEMO_BIN" ]; then
      echo "  Error: demo runner not found at $DEMO_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$DEMO_BIN" "$@"
    ;;
  rr)
    # `hmd rr` — remote-run: hand a task off from the LOCAL Heimdall to the
    # CLOUD-hosted maintainer (the GCE VM) so heavy work runs remotely, not
    # locally. The local hmd stays the orchestrator/UI; `rr` dispatches EXECUTION
    # to the cloud hmd. Delegate to the sibling bin/rr, passing through all
    # remaining args (the task/subcommand + flags: --dry-run, --issue, --repo,
    # --local, setup, status).
    shift
    RR_BIN="$PLUGIN_DIR/bin/rr"
    if [ ! -x "$RR_BIN" ]; then
      echo "  Error: rr (remote-run) not found at $RR_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$RR_BIN" "$@"
    ;;
  sigil)
    # `hmd sigil` — render the deterministic watchman sigil / calibration card.
    # Delegates to the sibling bin/heimdall-sigil, which routes through the SHARED
    # render core (sentinels/hmd_sigil.py). `hmd sigil --test` prints the terminal
    # calibration card (sigil at 3 sizes + aspect-square + checkerboard) so a
    # teammate can verify — or screenshot — how the sigil renders on their terminal.
    shift
    SIGIL_BIN="$PLUGIN_DIR/bin/heimdall-sigil"
    SIGIL_PY="$PLUGIN_DIR/sentinels/hmd_sigil.py"
    HAID_BIN="$PLUGIN_DIR/bin/heimdall-haid"
    SIGIL_CHOICE_FILE="$HEIMDALL_HOME_DIR/sigil-choice"
    case "${1:-}" in
      ''|status|show)
        # `hmd sigil` — the dev's CURRENT hero + whether change is unlocked (≥5 runs).
        # Effective hero = an unlocked override, else the seed's auto-assigned hero
        # (real HAID → hero_for) as the render core resolves it. Unlock is earned
        # customization: change your sigil only after you've run hmd 5+ times.
        _haid="$("$HAID_BIN" current 2>/dev/null || true)"
        [ -n "$_haid" ] || _haid="${HEIMDALL_HAID:-haid:local}"
        _auto="$(python3 "$SIGIL_PY" --resolve "$_haid" 2>/dev/null || true)"
        [ -n "$_auto" ] || _auto="$(python3 "$SIGIL_PY" --hero-for "$_haid" 2>/dev/null || true)"
        _runs="$(hmd_run_count)"
        _override=""; [ -f "$SIGIL_CHOICE_FILE" ] && _override="$(cat "$SIGIL_CHOICE_FILE" 2>/dev/null || true)"
        if [ -n "$_override" ] && [ "$_runs" -ge 5 ]; then _current="$_override"; else _current="$_auto"; fi
        printf "  sigil: %s\n" "${_current:-<none>}"
        printf "  haid:  %s\n" "$_haid"
        if [ "$_runs" -ge 5 ]; then
          printf "  change unlocked (%s runs) — pick any: hmd sigil set <name>\n" "$_runs"
          printf "  heroes: %s\n" "$(python3 "$SIGIL_PY" --list-heroes 2>/dev/null | tr '\n' ' ')"
        else
          printf "  change locked — unlocks after 5 hmd runs (you have %s)\n" "$_runs"
        fi
        exit 0
        ;;
      set)
        # `hmd sigil set <name>` — persist a hero override, gated on the unlock.
        shift
        _name="${1:-}"
        _runs="$(hmd_run_count)"
        if [ -z "$_name" ]; then
          echo "  usage: hmd sigil set <name>" >&2
          echo "  heroes: $(python3 "$SIGIL_PY" --list-heroes 2>/dev/null | tr '\n' ' ')" >&2
          exit 2
        fi
        if [ "$_runs" -lt 5 ]; then
          echo "  sigil change unlocks after 5 hmd runs (you have $_runs)" >&2
          exit 1
        fi
        if ! python3 "$SIGIL_PY" --list-heroes 2>/dev/null | grep -qx -- "$_name"; then
          echo "  unknown hero: $_name" >&2
          echo "  pick one of: $(python3 "$SIGIL_PY" --list-heroes 2>/dev/null | tr '\n' ' ')" >&2
          exit 2
        fi
        _heimdall_home_ensure || true
        printf '%s\n' "$_name" > "$SIGIL_CHOICE_FILE"
        printf "  sigil set to %s (unlocked, %s runs)\n" "$_name" "$_runs"
        exit 0
        ;;
      *)
        # --test / --seed / --tier / --glyph / … → the shared render core (unchanged).
        if [ ! -x "$SIGIL_BIN" ]; then
          echo "  Error: sigil renderer not found at $SIGIL_BIN" >&2
          echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
          exit 1
        fi
        exec "$SIGIL_BIN" "$@"
        ;;
    esac
    ;;
  sigil-png)
    # `hmd sigil-png` — CRISP PNG render of the watchman sigil, for the image
    # surfaces (share-card avatar, presence wall). Delegates to bin/heimdall-sigil-png,
    # which routes through sentinels/hmd_sigil_png.py — reusing the SAME value→color
    # palette as the terminal sigil, so both surfaces agree hue-for-hue. Pure stdlib
    # (PNG via zlib/struct); deterministic (same sprite → byte-identical PNG).
    #   hmd sigil-png --seed <id|sprite> --out avatar.png [--scale N] [--emotion e]
    shift
    PNG_BIN="$PLUGIN_DIR/bin/heimdall-sigil-png"
    if [ ! -x "$PNG_BIN" ]; then
      echo "  Error: sigil PNG renderer not found at $PNG_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$PNG_BIN" "$@"
    ;;
  guard)
    # `hmd guard install` — wire the NATIVE git pre-push hook into the git repo
    # at the current directory. The hook runs on EVERY push (human or agent),
    # closing the gap left by the Claude Code PreToolUse gate (which only sees
    # agent pushes). Maintainer gate: install.sh does NOT call this — it is not
    # user-facing. Idempotent: re-running re-wires cleanly.
    shift
    sub="${1:-}"
    case "$sub" in
      install) ;;
      ""|-h|--help)
        echo "Usage: hmd guard install"
        echo ""
        echo "  Installs Heimdall's native git pre-push hook into the git repo at the"
        echo "  current directory. The hook delegates to heimdall-selfscan, which runs"
        echo "  gitleaks over the full history and enforces the author/committer identity"
        echo "  allowlist on EVERY push (human or agent). Idempotent."
        [ -z "$sub" ] && exit 2 || exit 0
        ;;
      *)
        echo "  Error: unknown guard subcommand: $sub (expected: install)" >&2
        exit 2
        ;;
    esac

    # Must be inside a git work tree.
    if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
      echo "  Error: not inside a git repository (run from your repo's working tree)." >&2
      exit 1
    fi

    # Source hook + its companion heimdall-selfscan must both exist in the plugin.
    src_hook="$PLUGIN_DIR/hooks/git/pre-push"
    selfscan="$PLUGIN_DIR/bin/heimdall-selfscan"
    if [ ! -f "$src_hook" ]; then
      echo "  Error: hook template not found at $src_hook" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    if [ ! -x "$selfscan" ]; then
      echo "  Error: heimdall-selfscan not found/executable at $selfscan" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi

    # Read whatever core.hooksPath is CURRENTLY set to (local scope). We must
    # never clobber a real custom hooksPath — only git's default (.git/hooks) or a
    # heimdall-managed value is safe to (re)wire.
    current_hp="$(git -C "$repo_root" config --local --get core.hooksPath 2>/dev/null || true)"

    # Is the current hooksPath just git's DEFAULT (unset, the relative `.git/hooks`,
    # or the absolute path git resolves that to — worktrees report it absolute) or
    # an already-heimdall-managed value? Those are safe to (re)wire; a genuine
    # custom dir is NOT and must be preserved. `git rev-parse --git-path hooks`
    # yields the exact default path in this checkout so the absolute form matches.
    default_hp="$(git -C "$repo_root" rev-parse --git-path hooks 2>/dev/null || true)"
    hp_safe_to_rewire=0
    case "$current_hp" in
      ""|".git/hooks"|"hooks/git"|".heimdall/git-hooks") hp_safe_to_rewire=1 ;;
    esac
    if [ -n "$default_hp" ] && [ "$current_hp" = "$default_hp" ]; then hp_safe_to_rewire=1; fi

    # Is $repo_root a heimdall CHECKOUT? Then the guard hook + scanner are already
    # version-controlled at hooks/git/pre-push + bin/heimdall-selfscan, so we wire
    # core.hooksPath straight at the TRACKED dir — no copy. A fresh clone that runs
    # `hmd guard install` is then guarded by files git already carries, and a
    # `.git` re-init can be re-wired by re-running this. For a NON-heimdall repo we
    # keep copying the hook into a heimdall-managed dir (the hook self-scopes and
    # stands down there anyway).
    apply_heimdall_theme 2>/dev/null || true
    G='\033[32m'; D='\033[2m'; B='\033[1m'; R='\033[0m'; Y='\033[33m'

    if [ -f "$repo_root/hooks/git/pre-push" ] && [ -x "$repo_root/bin/heimdall-selfscan" ]; then
      # ── heimdall checkout: wire the TRACKED hooks dir (relative, relocatable) ──
      rel_hooks_dir="hooks/git"
      dst_hook="$repo_root/$rel_hooks_dir/pre-push"
      if [ "$hp_safe_to_rewire" -eq 1 ]; then
          # Unset, git's default, or an already-heimdall-managed value — safe.
          git -C "$repo_root" config core.hooksPath "$rel_hooks_dir"
      else
          # A real custom hooksPath — DO NOT clobber it. Chain instead: preserve
          # any pre-existing pre-push as pre-push.local and drop a wrapper that
          # runs it first, then execs the tracked heimdall guard.
          custom_dir="$current_hp"
          case "$custom_dir" in /*) : ;; *) custom_dir="$repo_root/$custom_dir" ;; esac
          mkdir -p "$custom_dir"
          if [ -e "$custom_dir/pre-push" ] && ! grep -q "heimdall-guard-chain" "$custom_dir/pre-push" 2>/dev/null; then
            mv "$custom_dir/pre-push" "$custom_dir/pre-push.local"
          fi
          {
            echo "#!/usr/bin/env bash"
            echo "# heimdall-guard-chain: preserve the repo's existing pre-push, then run"
            echo "# heimdall's tracked guard. Installed because a custom core.hooksPath was"
            echo "# set — we did NOT clobber it."
            echo "set -euo pipefail"
            echo "REFS=\"\$(cat)\""
            echo "here=\"\$(cd \"\$(dirname \"\${BASH_SOURCE[0]}\")\" && pwd)\""
            echo "if [ -x \"\$here/pre-push.local\" ]; then printf '%s\\n' \"\$REFS\" | \"\$here/pre-push.local\" \"\$@\"; fi"
            echo "top=\"\$(git rev-parse --show-toplevel)\""
            echo "printf '%s\\n' \"\$REFS\" | exec \"\$top/hooks/git/pre-push\" \"\$@\""
          } > "$custom_dir/pre-push"
          chmod +x "$custom_dir/pre-push"
          dst_hook="$custom_dir/pre-push"
          rel_hooks_dir="$current_hp"
          printf "\n  ${Y}!${R} preserved your custom core.hooksPath (%s) — chained the guard in\n" "$current_hp"
      fi
    else
      # ── non-heimdall repo: copy the self-scoping hook into a managed dir ──
      rel_hooks_dir=".heimdall/git-hooks"
      hooks_dir="$repo_root/$rel_hooks_dir"
      mkdir -p "$hooks_dir"
      dst_hook="$hooks_dir/pre-push"
      cp "$src_hook" "$dst_hook"
      chmod +x "$dst_hook"
      if [ "$hp_safe_to_rewire" -eq 1 ]; then
          git -C "$repo_root" config core.hooksPath "$rel_hooks_dir"
      else
          printf "\n  ${Y}!${R} left your custom core.hooksPath (%s) untouched — copied the guard to %s\n" "$current_hp" "$rel_hooks_dir"
      fi
    fi

    printf "\n  ${B}Heimdall push guard installed${R}\n\n"
    printf "  ${G}✓${R} hook        %s\n" "$dst_hook"
    printf "  ${G}✓${R} identity    %s ${D}(push-range author+committer allowlist)${R}\n" "$repo_root/bin/heimdall-check-identities"
    printf "  ${G}✓${R} delegates   %s ${D}(full-history secret + identity + landmine)${R}\n" "$repo_root/bin/heimdall-selfscan"
    printf "  ${G}✓${R} core.hooksPath = %s ${D}(relative → survives a repo move)${R}\n" "$rel_hooks_dir"
    printf "\n"
    printf "  ${D}Runs on EVERY push (human or agent): a push-range identity allowlist${R}\n"
    printf "  ${D}(root-cause fix for the v2.2.0 R9 trip) + a full-history gitleaks secret${R}\n"
    printf "  ${D}scan + identity allowlist + landmine lint. A blocked push prints the reason;${R}\n"
    printf "  ${D}a clean push prints: guard: gitleaks=0 · identities=N/N allowlisted${R}\n"
    printf "  ${D}Emergency identity bypass (verify first): HEIMDALL_SKIP_ID_GUARD=1 git push${R}\n\n"
    exit 0
    ;;
  uninstall)
    # Remove the plugin dir + BOTH entry points (hmd, heimdall) and nothing
    # else. This is on the success card, so it must exist. The guarded removal
    # lives in the shared _heimdall_remove_plugin (so it cannot drift to an
    # unguarded rm).
    #
    # CONFIRMATION DISCIPLINE (v2.0.4): a safety guard must NEVER hang. We mirror
    # the same non-TTY discipline install/demo/boot-animation use:
    #   --yes/-y           → proceed without prompting (CI, scripts, the harness)
    #   TTY, no --yes      → prompt [y/N] (a human can answer)
    #   NON-TTY, no --yes  → refuse cleanly: exit 2 with the --yes hint. NEVER
    #                        read from a stdin that will never arrive (that hangs).
    apply_heimdall_theme 2>/dev/null || true
    D='\033[2m'; G='\033[32m'; R='\033[0m'; B='\033[1m'
    printf "\n  ${B}Uninstalling Heimdall${R}\n\n"

    _uyes=0; for _a in "$@"; do { [ "$_a" = "--yes" ] || [ "$_a" = "-y" ]; } && _uyes=1; done
    if [ "$_uyes" -ne 1 ]; then
      if [ -t 0 ]; then
        # Arrow-key confirm (↑/↓ + Enter, default No). Falls back to a guarded
        # typed [y/N] read only if the select helper is unavailable.
        _confirm=n
        if command -v hmd_confirm >/dev/null 2>&1; then
          hmd_confirm "  Remove heimdall from ~/.heimdall and PATH?" && _confirm=y
        else
          read -p "  Remove heimdall from ~/.heimdall and PATH? [y/N] " _confirm
        fi
        if [[ "${_confirm:-n}" != [yY]* ]]; then
          printf "\n  ${D}Cancelled — nothing removed.${R}\n\n"
          exit 0
        fi
      else
        printf "  ${D}Non-interactive: pass --yes to confirm uninstall (refusing to prompt).${R}\n" >&2
        exit 2
      fi
    fi

    # ── Farewell (change #3, v2.0.3): the leaving watchman ──
    # Reuse the SINGLE sad frame (heimdall-face --frame sad) + a one-line goodbye —
    # NOT an animation loop, just one frame. TTY-gated: on a non-TTY/piped stdout we
    # emit no art (frame glyphs are garbage bytes through a pipe). Color honored
    # (NO_COLOR / --no-color → the renderer degrades to plain). HEIMDALL_NO_INTRO=1
    # also suppresses it (recordings / CI). Never fatal: a missing renderer is
    # silently skipped so uninstall always proceeds to the real removal below.
    if [ -t 1 ] && [ "${HEIMDALL_NO_INTRO:-0}" != "1" ] && [ -x "$PLUGIN_DIR/bin/heimdall-face" ]; then
      _face_flag="--no-color"
      { [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; } && _face_flag="--color"
      while IFS= read -r _fl; do
        printf "  %s\n" "$_fl"
      done < <("$PLUGIN_DIR/bin/heimdall-face" --frame sad "$_face_flag" 2>/dev/null)
      printf "  ${D}the watchman sleeps. it was good to keep watch with you.${R}\n\n"
    fi

    # Reverse install.sh's appended PATH export FIRST (the v2.0.2 gap: uninstall
    # removed the plugin + symlinks but left the profile PATH line behind).
    # ORDER IS LOAD-BEARING: when `hmd` is the ~/.local/bin symlink, readlink-f
    # resolves the running script to ~/.heimdall/bin/heimdall. _heimdall_remove_plugin
    # deletes ~/.heimdall — the script's own backing file — so a command AFTER it may
    # not be read from disk and silently never runs (that was the bug: PATH survived).
    # The PATH remover must run BEFORE plugin removal so it is guaranteed to execute.
    # (The --uninstall flag arm already orders it this way.)
    # ORDER IS LOAD-BEARING for ALL of these, not just PATH: every step that
    # reverses something OUTSIDE the install tree must run before the tree itself
    # is deleted, because this script's own backing file lives inside it.
    #   · the nightly LaunchAgent's plist lives in ~/Library/LaunchAgents, and its
    #     removal delegates to $PLUGIN_DIR/bin/heimdall-dream-schedule — a helper
    #     _heimdall_remove_plugin is about to delete.
    #   · the statusLine registration lives in ~/.claude/settings.json and points
    #     INTO the tree, so it must be de-registered before the target vanishes.
    REMOVED_ANY=0
    _heimdall_remove_path_export
    _heimdall_remove_dream_schedule
    _heimdall_remove_statusline
    _heimdall_remove_plugin

    printf "\n"
    if [ "${REMOVED_ANY:-0}" -eq 1 ]; then
      printf "  ${G}✓${R} Heimdall removed. Nothing else was touched.\n"
      printf "  ${D}Open a new terminal for the PATH change to take effect.${R}\n"
    else
      printf "  ${D}Nothing to remove — Heimdall was not installed here.${R}\n"
    fi
    printf "  ${D}Reinstall anytime: curl -fsSL https://runheimdall.dev/install | bash${R}\n\n"
    exit 0
    ;;
  team)
    # Pass-through to heimdall-team (new/join/share/show and bare dispatch).
    # Bin dir resolved via $PLUGIN_DIR — same as demo/rr above, never hardcoded.
    shift
    TEAM_BIN="$PLUGIN_DIR/bin/heimdall-team"
    if [ ! -x "$TEAM_BIN" ]; then
      echo "  Error: heimdall-team not found at $TEAM_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$TEAM_BIN" "$@"
    ;;
  invite)
    # Pass-through to heimdall-invite (teammate join-link generator).
    shift
    INVITE_BIN="$PLUGIN_DIR/bin/heimdall-invite"
    if [ ! -x "$INVITE_BIN" ]; then
      echo "  Error: heimdall-invite not found at $INVITE_BIN" >&2
      echo "  Reinstall: curl -fsSL https://runheimdall.dev/install | bash" >&2
      exit 1
    fi
    exec "$INVITE_BIN" "$@"
    ;;
  join)
    # `hmd join <secret>` — the teammate side of the viral loop: the ONE command a
    # teammate runs (or the tail of the invite one-liner) to land on the inviter's
    # team. Delegates to `heimdall-team join <thing>` — the secret rides this CLI's
