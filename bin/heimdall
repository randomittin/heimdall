      exit 1
    fi
    # Δ6 funnel: record the `join` growth-loop stage (client-side, consent-gated,
    # fire-and-forget — never blocks or prints; the engine no-ops when off). Emitted
    # BEFORE the exec so the join hand-off still replaces this process.
    FUNNEL_BIN="$PLUGIN_DIR/bin/heimdall-funnel"
    [ -x "$FUNNEL_BIN" ] && ( "$FUNNEL_BIN" emit join --context cli >/dev/null 2>&1 & ) || true
    exec "$JOIN_BIN" join "$@"
    ;;
  connect)
    # `hmd connect` — lazy, secret-safe capture of the team's Claude credential (and,
