#!/usr/bin/env bash
# heimdall-agent-resume — durable, per-agent RESUME REPORTING for subagents that
# were interrupted mid-task (quota exhaustion being the measured, repeated
# cause: "Agent terminated early due to an API error: You've hit your session
# limit · resets ..." killed 5 agents at once on 2026-08-20; 4 of the 5 had zero
# commits and lost all reasoning). Answers, in one command: WHICH subagents were
# interrupted, WHAT they were doing, WHERE their worktree is, WHAT is already
# safely committed there (so it is never redone), and WHAT is still uncommitted
# (at risk). Assembles a resume payload ready to hand to SendMessage verbatim.
#
# THE HONEST BOUNDARY (read this before assuming more than it delivers) — the
# same boundary bin/heimdall-quota-resume documents, and it does not move here
# either: heimdall runs INSIDE a Claude Code session. A subagent that was
# killed cannot restart itself, and NOTHING running inside this tool can
# restart it either — resumption happens only when a LIVE orchestrator calls
# SendMessage to that agent's id, which only a live session can do. What this
# tool actually delivers: the durable per-agent record ALREADY WRITTEN by the
# harness at spawn time (every subagent gets a `<transcript>.meta.json`
# sidecar carrying agentType/worktreePath/worktreeBranch/description — see
# bin/heimdall-agents' header for the measured shapes) aggregated with
# git-plumbing facts about its worktree (via bin/heimdall-resume-brief, reused
# not reimplemented) into one report — so the NEXT orchestrator needs zero
# reconstruction, not zero action. It still has to read the report and issue
# the SendMessage calls itself.
#
# EXTENDS, DOES NOT COMPETE WITH:
#   bin/heimdall-agents        owns subagent discovery + state classification.
#                              `list`/`orphans --json` now ALSO carry
#                              agent_type/description/worktree_path/
#                              worktree_branch (see its _meta_extra/
#                              _rows_to_json). This tool adds a SEMANTIC filter
#                              ("genuinely interrupted, mid-task") on top and
#                              never re-derives the id -> transcript ->
#                              meta.json resolution heimdall-agents owns.
#   bin/heimdall-resume-brief  owns ahead/behind/dirty/touched-files for ONE
#                              worktree. Called per interrupted agent that has
#                              one; never reimplemented here.
#   bin/heimdall-quota-resume  owns the ORCHESTRATOR's own quota-stop record
#                              (QUOTA-STOP.json) and the classifier
#                              (bin/lib/quota_stop.py). Its resume-hint
#                              SessionStart hook calls THIS tool's
#                              `resume-hint` as a best-effort, independent
#                              second signal — see its cmd_resume_hint.
#   bin/heimdall-quota-advisor owns QUOTA-only options-advice (wait for
#                              reset / cheaper tier / BYOK / router-with-
#                              warning) once a stop is confirmed — a sibling
#                              consumer of the SAME quota_stop.py, invoked
#                              on-demand only, never from a hook. Not a cause
#                              classifier and not called from here.
#
# WHICH STATES COUNT AS "INTERRUPTED" (default: failed,killed,orphaned,hung) ──
#   failed/killed — the harness DID enqueue a <task-notification> before the
#                   agent died. Its <summary> text is the best evidence of
#                   WHY, and is fed through bin/lib/quota_stop.py (the SAME
#                   detect() bin/heimdall-quota-resume's own `record` calls)
#                   to mechanically flag whether this specific interruption
#                   looks like a quota stop.
#   orphaned      — NO notification ever arrived AND the owning session is
#                   gone: provably dead with nothing returned. The clearest
#                   "this needs a look" signal heimdall-agents has.
#   hung          — awaiting one tool result for >= HMD_AGENT_HUNG_SECS. This
#                   is plausibly a common quota-kill shape too: a subagent
#                   mid-tool-call when the session dies leaves a transcript
#                   whose last event is a tool_use, which heimdall-agents
#                   classifies `working`/`hung` — NEVER `orphaned` — regardless
#                   of whether the owning session is still alive (see its
#                   _awaiting_tool_result guard, checked BEFORE any liveness
#                   probe).
#   (mailbox/stale are heimdall-agents' own hygiene concern — a parked
#   teammate or an idle-but-alive agent is a DIFFERENT problem, not "was doing
#   real interruptible task work"; excluded from the default filter, override
#   with --states to include them.)
#
# QUOTA CLASSIFICATION HONESTY — read before trusting `quota.suspected`:
#   true  — a real anchor+reset-clause match was found in the harness's own
#           <task-notification><summary> text for this agent (failed/killed
#           only — that is the ONLY place this tool has CONFIRMED the raw
#           termination text is recoverable from disk; see the notif index in
#           bin/heimdall-agents' header for the measured shape).
#   false — a notification summary WAS found, and the classifier confidently
#           said it does not match the quota-stop pattern (a genuine failure,
#           not a retryable window — needs a human, not just a resume).
#   null  — NO signal available to judge from at all (this is the case for
#           EVERY orphaned/hung agent by definition — no notification was ever
#           enqueued for them — and for any failed/killed agent whose
#           notification could not be located). Reported as "unknown", never
#           guessed from state alone.
#
# CAUSE CLASSIFICATION — beyond quota: overloaded / network / context-overflow
#   / unknown. Quota is ONE of five interruption causes; "retry" means
#   something different for each, so `report`'s output also carries a
#   `.cause` object ({class, retry_now, action, attempts, max_attempts,
#   backoff_secs, attempts_exhausted}):
#     overloaded — Anthropic 529/overloaded_error (or a bare 429/rate-limit
#                  with no quota reset clause). Transient: retry_now=true,
#                  with a bounded, backed-off attempt count (see below).
#                  Vocabulary mirrors bin/lib/hmd-claude-retry.sh's own
#                  _hmd_is_overload_text — same signal, cited not re-derived.
#     quota      — exactly quota.suspected == true, above. retry_now=false;
#                  no second detector, no duplicated reset-time math.
#     network    — connection-reset/refused/timeout/DNS-failure vocabulary.
#                  Transient: retry_now=true, same bounded-attempt treatment
#                  as overloaded (and shares its attempt counter).
#     context_overflow — "prompt is too long" / "automatic compaction
#                  failed" / context-window text. retry_now=false: retrying
#                  the IDENTICAL prompt fails IDENTICALLY — this needs a
#                  narrower scope or a fresh agent, never a same-shape retry.
#                  Never counted against the retry-attempt cap.
#     unknown    — real termination text existed and matched none of the
#                  above: a possible genuine bug. retry_now=false, always —
#                  auto-retrying a real failure wastes tokens and hides it.
#   class is JSON null (not the string "unknown") when there is no text at
#   all to classify — the same null-vs-false honesty split as
#   quota.suspected above, for the identical reason (orphaned/hung agents
#   never had a notification to classify in the first place).
#
#   BOUNDED RETRY, PER WORKTREE — an unbounded backoff loop against a hard
#   outage is an infinite loop, so overloaded/network attempts are capped,
#   explicitly (default 5, HMD_AGENT_RESUME_MAX_ATTEMPTS). The counter lives
#   at <worktree>/.planning/RESUME-ATTEMPTS.json — same directory and same
#   gitignored-runtime-state contract as bin/heimdall-quota-resume's own
#   .planning/QUOTA-STOP.json (a repo without that gitignore convention will
#   see this file as an untracked/dirty entry in resume_brief — harmless,
#   same exposure QUOTA-STOP.json already has in the orchestrator's own
#   repo). Keyed by the worktree's OWN HEAD sha: a HEAD that has moved since
#   the last recorded attempt is real forward progress, so the count resets
#   to a fresh attempt 1 instead of compounding toward the cap forever. Only
#   incremented by `report` (a deliberate, about-to-act call) — never by the
#   cheap `resume-hint` SessionStart path. Fails OPEN on any git/fs error or
#   a missing/unrecorded worktree: attempts/max_attempts/backoff_secs/
#   attempts_exhausted all report JSON null (nothing to bound against) and
#   retry_now stays true — this is advisory bookkeeping, not a safety gate,
#   and must never block a legitimate retry recommendation on a filesystem
#   hiccup.
#
#   OVERLOAD -> PRESSURE, THE ONE OUTBOUND SIDE EFFECT — an `overloaded`
#   classification is the ONLY overload signal hmd has at all (it cannot read
#   the harness's HTTP responses; see bin/heimdall-pressure's own header).
#   `report` forwards exactly the FIRST `overloaded` classification at a given
#   worktree HEAD to `heimdall-pressure record --kind overloaded_error`,
#   reusing _resume_attempts_bump's own RESUME-ATTEMPTS.json as the
#   exactly-once marker: it fires only when the freshly-bumped `attempts`
#   equals 1 (this HEAD was never bumped before), so a repeated `report` call
#   for the SAME dead agent (a status refresh, a statusline poll, a human
#   re-running it) sees attempts>=2 and is skipped — one death, one event,
#   never more. A real NEW death after forward progress (a fresh commit
#   resets attempts to 1 — see BOUNDED RETRY above) legitimately records
#   again, because it IS a new overload observation. `network` STAYS
#   unwired too — but not for the reason once given here ("it would need
#   its own exactly-once marker": wrong, corrected below). The marker above
#   needs no new field to also serve `network`: one _classify_cause call
#   yields exactly one class, so a `cls == "network" && attempts == "1"`
#   gate would key off this SAME RESUME-ATTEMPTS.json marker without ever
#   colliding with the `overloaded` gate for the same death. The real
#   reason is signal quality, checked directly against
#   bin/lib/pressure_control.py: connection_reset and overloaded_error feed
#   the IDENTICAL AIMD window/threshold with no per-kind weighting (see its
#   record_event()). But where _OVERLOAD_RE (529/429/"overloaded") is
#   obtainable ONLY from a completed HTTP round-trip where the remote
#   server itself signals distress, _NETWORK_RE (econnreset/etimedout/
#   epipe/getaddrinfo/dns lookup failed/...) is exactly what the
#   OPERATOR's own wifi/VPN/laptop-sleep/local DNS resolver produces, with
#   no server involvement at all. hmd spawns up to 10 agents from ONE
#   machine over ONE shared network link, so a single local blip is
#   trivially likely to hit 3+ concurrent agents AT ONCE — satisfying
#   threshold()'s breach "for real" while carrying zero actual
#   API-capacity signal. That inverts what threshold=3 is meant to filter
#   (pressure_control.py's own docstring: real pressure correlates because
#   agents share a remote backend, not a local link) — a spurious throttle
#   off one wifi drop is worse than no signal, so `network` stays unwired
#   on purpose; see test/heimdall-agent-resume-pressure.test.sh for the
#   regression proof this cannot quietly flip. Fire-and-forget: heimdall-
#   pressure is contractually never-fail and is never called with --strict,
#   so its absence or failure can never change this tool's own exit code or
#   `.cause` output shape.
#
#   THE CEILING — same honesty as THE HONEST BOUNDARY above: this can tell
#   you which bucket an interruption falls in and whether retrying is worth
#   trying, with a bounded recommendation. It cannot itself retry anything —
#   no hook or script here can call SendMessage or respawn a dead subagent;
#   that is still a live orchestrator's action, same as everything else in
#   this file.
#
# USAGE
#   heimdall-agent-resume list   [--json] [--repo DIR] [--states s1,s2,...]
#   heimdall-agent-resume report [--json] [--repo DIR] [--states ...]
#                                [--base REF] [--id ID] [--run-tests]
#   heimdall-agent-resume resume-hint [--repo DIR]
#   heimdall-agent-resume help
#
# EXIT: 0 always for list/report/resume-hint (fail-closed, degraded, never
#       crashes — mirrors bin/heimdall-agents); 2 only on a real usage error.
#
# ENV (tests only; production leaves these unset)
#   All bin/heimdall-agents HMD_AGENT_* seams pass straight through unchanged —
#   this tool never re-implements discovery, it shells out to heimdall-agents.
#   HMD_AGENT_PROJECTS_DIR        same override, also used here directly to
#                                 locate parent-session transcripts for
#                                 <task-notification> summaries.
#   HEIMDALL_QUOTA_NOW_EPOCH,
#   HEIMDALL_QUOTA_SKEW_SECONDS   same seams bin/heimdall-quota-resume uses,
#                                 reused verbatim for the detect() calls here.
#   HMD_AGENT_RESUME_AGENTS_BIN   override path to heimdall-agents (tests)
#   HMD_AGENT_RESUME_BRIEF_BIN    override path to heimdall-resume-brief (tests)
#   HMD_AGENT_RESUME_PRESSURE_BIN override path to heimdall-pressure (tests) —
#                                 see "OVERLOAD -> PRESSURE" below.
#   HMD_AGENT_RESUME_MAX_ATTEMPTS       retry-recommendation cap per worktree
#                                       for overloaded/network causes
#                                       (default 5; see CAUSE CLASSIFICATION).
#   HMD_AGENT_RESUME_BACKOFF_BASE_SECS  backoff base seconds (default 2).
#   HMD_AGENT_RESUME_BACKOFF_CAP_SECS   backoff cap seconds (default 60).
set -uo pipefail

_AR_SELF="$0"
command -v readlink >/dev/null 2>&1 && \
  _AR_SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
AR_BIN_DIR="$(cd "$(dirname "$_AR_SELF")" 2>/dev/null && pwd)"
AR_LIB_DIR="$AR_BIN_DIR/lib"
AGENTS_BIN="${HMD_AGENT_RESUME_AGENTS_BIN:-$AR_BIN_DIR/heimdall-agents}"
BRIEF_BIN="${HMD_AGENT_RESUME_BRIEF_BIN:-$AR_BIN_DIR/heimdall-resume-brief}"
PRESSURE_BIN="${HMD_AGENT_RESUME_PRESSURE_BIN:-$AR_BIN_DIR/heimdall-pressure}"
AR_PY="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"

command -v jq >/dev/null 2>&1 || { echo "error: jq is required" >&2; exit 2; }

DEFAULT_STATES="failed,killed,orphaned,hung"

# Print the comment header, stopping at the first non-comment line — mirrors
# bin/heimdall-agents' usage() so the help text cannot drift out of sync with
# the file when the header changes length.
usage() { sed -n '2,${/^[^#]/q;p;}' "$0" | sed 's/^# \{0,1\}//'; }

# ── quota classification (reuses bin/lib/quota_stop.py — the SAME classifier
#    bin/heimdall-quota-resume's own `record` calls; never re-implemented) ────
_qar_now_epoch() { printf '%s' "${HEIMDALL_QUOTA_NOW_EPOCH:-$(date +%s 2>/dev/null || echo 0)}"; }
_qar_skew()      { printf '%s' "${HEIMDALL_QUOTA_SKEW_SECONDS:-120}"; }

# classify_text <text> -> JSON {suspected, reset_local, reset_tz, resolved,
# reset_epoch} on stdout. Never fails the caller: absent python3, absent text,
# or a non-match all degrade to a well-formed JSON object, never a crash.
_classify_text() {
  local text="$1"
  if [ -z "$AR_PY" ] || [ -z "$text" ] || [ ! -r "$AR_LIB_DIR/quota_stop.py" ]; then
    printf '%s' '{"suspected":null,"reset_local":null,"reset_tz":null,"resolved":null,"reset_epoch":null}'
    return 0
  fi
  local out cls
  out="$(printf '%s' "$text" | "$AR_PY" "$AR_LIB_DIR/quota_stop.py" detect \
          --now "$(_qar_now_epoch)" --skew "$(_qar_skew)" 2>/dev/null)"
  if [ -z "$out" ]; then
    printf '%s' '{"suspected":null,"reset_local":null,"reset_tz":null,"resolved":null,"reset_epoch":null}'
    return 0
  fi
  cls="$(printf '%s' "$out" | jq -r '.class' 2>/dev/null)"
  if [ "$cls" = "quota" ]; then
    printf '%s' "$out" | jq -c '{
      suspected: true,
      reset_local: (.reset_local // null),
      reset_tz: (.reset_tz // null),
      resolved: (.resolved // null),
      reset_epoch: (if (.reset_epoch // null) == null then null else (.reset_epoch|tonumber) end)
    }' 2>/dev/null && return 0
  fi
  printf '%s' '{"suspected":false,"reset_local":null,"reset_tz":null,"resolved":null,"reset_epoch":null}'
}

# ── cause classification (extends the quota-only classifier above with
#    overloaded/network/context-overflow detection + a bounded, per-worktree
#    retry recommendation — see the CAUSE CLASSIFICATION header section).
#    Reuses the quota verdict _classify_text already computed; never
#    re-invokes quota_stop.py a second time. Patterns mirror
#    bin/lib/hmd-claude-retry.sh's own _hmd_is_overload_text (529/overloaded/
#    429/rate-limit) — same vocabulary, cited not re-derived.
_OVERLOAD_RE='529|overloaded(_error)?|"overloaded"|too many requests|429|rate.?limit'
_NETWORK_RE='econnreset|etimedout|ehostunreach|enetunreach|epipe|connection reset|connection refused|socket hang up|network error|getaddrinfo|dns lookup failed'
_CTXOVERFLOW_RE='prompt is too long|context window|maximum context length|context length exceeded|automatic compaction failed|too many tokens'

# _resume_attempts_bump <worktree> <cause_class> -> prints the NEW attempt
# count (a bare integer, always) on stdout. Persists to
# <worktree>/.planning/RESUME-ATTEMPTS.json. Keyed by the worktree's OWN HEAD
# sha: a HEAD that has moved since the last recorded attempt is real forward
# progress, so the count resets to a fresh attempt 1 instead of compounding
# toward the cap forever. Fails OPEN on any git/fs error: prints 0 rather
# than ever blocking a legitimate retry recommendation on a filesystem
# hiccup — this is advisory bookkeeping, not a safety gate.
_resume_attempts_bump() {
  local wt="$1" cls="$2" f head prev_head prev_attempts new_attempts
  head="$(git -C "$wt" rev-parse HEAD 2>/dev/null || true)"
  [ -n "$head" ] || { echo 0; return 0; }
  f="$wt/.planning/RESUME-ATTEMPTS.json"

  prev_head=""; prev_attempts=0
  if [ -f "$f" ]; then
    prev_head="$(jq -r '.head_sha // ""' "$f" 2>/dev/null || true)"
    prev_attempts="$(jq -r '.attempts // 0' "$f" 2>/dev/null || echo 0)"
    [ -n "$prev_attempts" ] || prev_attempts=0
  fi

  if [ "$prev_head" = "$head" ]; then
    new_attempts=$((prev_attempts + 1))
  else
    new_attempts=1
  fi

  if mkdir -p "$wt/.planning" 2>/dev/null; then
    jq -n --arg h "$head" --argjson a "$new_attempts" --arg c "$cls" \
      '{head_sha:$h, attempts:$a, cause_class:$c}' > "$f.tmp.$$" 2>/dev/null \
      && mv "$f.tmp.$$" "$f" 2>/dev/null || rm -f "$f.tmp.$$" 2>/dev/null
  fi
  echo "$new_attempts"
}

# _classify_cause <text> <quota_suspected: "true"|"false"|"null"> <worktree>
# -> JSON {class, retry_now, action, attempts, max_attempts, backoff_secs,
# attempts_exhausted} on stdout. class is JSON null (not the string
# "unknown") when there is no text at all to classify from — mirrors
# quota.suspected's null-vs-false honesty distinction exactly (see QUOTA
# CLASSIFICATION HONESTY above). retry_now is false for every class except a
# not-yet-exhausted overloaded/network.
_classify_cause() {
  local text="$1" quota_suspected="$2" wt="$3"
  local max base cap
  max="${HMD_AGENT_RESUME_MAX_ATTEMPTS:-5}"
  base="${HMD_AGENT_RESUME_BACKOFF_BASE_SECS:-2}"
  cap="${HMD_AGENT_RESUME_BACKOFF_CAP_SECS:-60}"

  if [ -z "$text" ]; then
    jq -n '{class:null, retry_now:false,
      action:"no termination text available to classify (orphaned/hung — session ended without a notification); inspect manually",
      attempts:null, max_attempts:null, backoff_secs:null, attempts_exhausted:null}'
    return 0
  fi

  if [ "$quota_suspected" = "true" ]; then
    jq -n '{class:"quota", retry_now:false,
      action:"do not retry now — wait for the reset time above (see heimdall-quota-resume status / heimdall-quota-advisor status)",
      attempts:null, max_attempts:null, backoff_secs:null, attempts_exhausted:null}'
    return 0
  fi

  local cls
  if printf '%s' "$text" | grep -qiE "$_CTXOVERFLOW_RE" 2>/dev/null; then
    cls="context_overflow"
  elif printf '%s' "$text" | grep -qiE "$_OVERLOAD_RE" 2>/dev/null; then
    cls="overloaded"
  elif printf '%s' "$text" | grep -qiE "$_NETWORK_RE" 2>/dev/null; then
    cls="network"
  else
    cls="unknown"
  fi

  case "$cls" in
    context_overflow)
      jq -n '{class:"context_overflow", retry_now:false,
        action:"do not retry as-is — the identical prompt will overflow again; resume with a narrower scope or a fresh agent",
        attempts:null, max_attempts:null, backoff_secs:null, attempts_exhausted:null}'
      ;;
    unknown)
      jq -n '{class:"unknown", retry_now:false,
        action:"no transient-failure signal found — treat as a possible genuine failure and review manually; do not auto-retry",
        attempts:null, max_attempts:null, backoff_secs:null, attempts_exhausted:null}'
      ;;
    overloaded|network)
      if [ -n "$wt" ] && _worktree_exists "$wt"; then
        local attempts exhausted retry action shift_n backoff
        attempts="$(_resume_attempts_bump "$wt" "$cls")"
        [ -n "$attempts" ] || attempts=0
        if [ "$attempts" -gt "$max" ] 2>/dev/null; then
          exhausted="true"; retry="false"; backoff=0
          action="retry budget exhausted (${attempts}/${max} attempts on this worktree with no forward progress) — escalate to a human instead of retrying again"
        else
          exhausted="false"; retry="true"
          shift_n=0; [ "$attempts" -gt 1 ] && shift_n=$((attempts - 1))
          [ "$shift_n" -gt 20 ] && shift_n=20
          backoff=$(( base * (1 << shift_n) )); [ "$backoff" -gt "$cap" ] && backoff="$cap"
          action="transient $cls — safe to retry now (attempt ${attempts}/${max}, ~${backoff}s exponential backoff+jitter)"
        fi
        jq -n --arg c "$cls" --argjson rn "$retry" --arg a "$action" \
              --argjson att "$attempts" --argjson mx "$max" --argjson bo "$backoff" --argjson ex "$exhausted" \
          '{class:$c, retry_now:$rn, action:$a, attempts:$att, max_attempts:$mx, backoff_secs:$bo, attempts_exhausted:$ex}'
      else
        jq -n --arg c "$cls" \
          '{class:$c, retry_now:true,
            action:"transient (no worktree recorded for this agent, so retry attempts are not bounded here — exercise judgment)",
            attempts:null, max_attempts:null, backoff_secs:null, attempts_exhausted:null}'
      fi
      ;;
  esac
}

# _record_pressure_if_fresh_overload <cause_json> <repo> — the ONE outbound
# side effect this tool has: forwards an `overloaded` cause classification to
# `heimdall-pressure record`, so the AIMD spawn-pressure controller
# (bin/lib/pressure_control.py) sees the only overload signal hmd actually
# has. See "OVERLOAD -> PRESSURE" in the header for the exactly-once design:
# fires only when the cause's own `.attempts` is exactly 1 — the fresh/first
# bump of _resume_attempts_bump's RESUME-ATTEMPTS.json at this worktree's
# current HEAD — so a repeated `report` call for the SAME dead agent never
# double-records. `attempts` is JSON null whenever there was no worktree to
# key a durable marker off of (see _classify_cause's `else` branch above);
# null != "1", so that case is silently skipped rather than guessed at — no
# marker, no record, exactly as the exactly-once contract demands.
#
# Fire-and-forget: never writes to stdout (so it can never corrupt the cause
# JSON _classify_cause already produced), never allowed to affect this tool's
# own exit code, and never passes --strict — heimdall-pressure is
# contractually never-fail, and its absence or failure must stay invisible to
# every caller of `report`.
_record_pressure_if_fresh_overload() {
  local cause_json="$1" repo="$2" cls attempts
  cls="$(printf '%s' "$cause_json" | jq -r '.class' 2>/dev/null)"
  [ "$cls" = "overloaded" ] || return 0
  attempts="$(printf '%s' "$cause_json" | jq -r '.attempts' 2>/dev/null)"
  [ "$attempts" = "1" ] || return 0
  [ -x "$PRESSURE_BIN" ] || return 0
  # --repo is a GLOBAL flag on heimdall-pressure's own parser (added to the
  # top-level ArgumentParser before add_subparsers()) — it MUST precede the
  # subcommand name. `record --kind K --repo D` is rejected by argparse as
  # "unrecognized arguments" (the record subparser only knows --kind/
  # --source), which the never-fail contract below swallows silently. Argument
  # ORDER here is load-bearing, not stylistic — see
  # test/heimdall-agent-resume-pressure.test.sh for the regression proof.
  "$PRESSURE_BIN" --repo "$repo" record --kind overloaded_error --source agent-resume >/dev/null 2>&1 || true
  return 0
}

# Pull the LAST <summary>…</summary> for a specific task-id out of a set of
# parent-session transcript files. Mirrors bin/heimdall-agents'
# build_notif_index grep+perl idiom exactly (same tool, same no-/s rationale:
# JSONL escapes real newlines, so a whole notification block is one physical
# line — see that file's header for the measured evidence).
_notif_summary_for() {
  local id="$1" files="$2"
  [ -n "$files" ] || return 0
  # shellcheck disable=SC2086
  grep -hF '<task-notification>' $files 2>/dev/null \
    | AR_ID="$id" perl -ne 'while(m{<task-id>([^<]+)</task-id>.*?<summary>(.*?)</summary>}g){ print "$2\n" if $1 eq $ENV{AR_ID}; }' 2>/dev/null \
    | tail -1
}

# ── worktree-path resolution safety (bin/lib/real-home.sh's own caution: a
#    recorded worktreePath may have been reaped since spawn) ─────────────────
_worktree_exists() {
  local p="$1"
  [ -n "$p" ] && [ -d "$p" ] && git -C "$p" rev-parse --git-dir >/dev/null 2>&1
}

# ── the interrupted-agent inventory: heimdall-agents list --json, filtered ───
_interrupted_json() {
  local repo="$1" states="$2" all
  all="$(HMD_AGENT_CWD="$repo" "$AGENTS_BIN" list --json 2>/dev/null)"
  [ -n "$all" ] || { echo '[]'; return 0; }
  # NOTE the `("," + .state + ",") as $needle |` binding: `.state` MUST be read
  # while `.` is still the per-row object. Writing the naive
  # `$states | contains("," + .state + ",")` instead pipes $states into
  # contains() FIRST, which rebinds `.` to $states (a string) for the
  # argument expression too -- so `.state` is then evaluated against that
  # string and jq raises "Cannot index string with string state" on every
  # single row, unconditionally. Bind the needle from the row's `.` BEFORE
  # switching context to $states.
  printf '%s' "$all" | jq -c --arg states ",$states," \
    '[ .[] | select(("," + .state + ",") as $needle | $states | contains($needle)) ]'
}

cmd_list() {
  local as_json="" repo="$PWD" states="$DEFAULT_STATES"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift ;;
      --repo) repo="$2"; shift 2 ;;
      --states) states="$2"; shift 2 ;;
      *) echo "heimdall-agent-resume: unknown arg: $1" >&2; return 2 ;;
    esac
  done
  repo="$(cd "$repo" 2>/dev/null && pwd)" || repo="$PWD"

  local rows n
  rows="$(_interrupted_json "$repo" "$states")"
  if [ -n "$as_json" ]; then
    printf '%s\n' "$rows"
    return 0
  fi
  n="$(printf '%s' "$rows" | jq 'length' 2>/dev/null)"
  [ -n "$n" ] || n=0
  if [ "$n" -eq 0 ]; then
    echo "no interrupted subagents (states checked: $states)"
    return 0
  fi
  printf '%-30s %-9s %8s  %s\n' "SUBAGENT" "STATE" "AGE(s)" "DESCRIPTION"
  printf '%s\n' "$rows" | jq -r '.[] | [.id, .state, (.age_secs|tostring), (.description // "-")] | @tsv' \
    | while IFS=$'\t' read -r id state age desc; do
        printf '%-30s %-9s %8s  %s\n' "$id" "$state" "$age" "$desc"
      done
}

# Build ONE resume-brief JSON (or a well-formed "unavailable" shape) for a
# worktree path. Guarded internally as well as at the call site so this stays
# correct if ever called on its own.
_brief_json() {
  local wt="$1" base="$2" run_tests="$3"
  if ! _worktree_exists "$wt"; then
    jq -n '{available:false, reason:"worktree path missing or not a git repo (may have been reaped)"}'
    return 0
  fi
  if [ ! -x "$BRIEF_BIN" ]; then
    jq -n '{available:false, reason:"bin/heimdall-resume-brief not found or not executable"}'
    return 0
  fi
  local args out rc
  args=("$wt" --base "$base" --json)
  [ "$run_tests" = "1" ] && args+=(--run-tests)
  out="$("$BRIEF_BIN" "${args[@]}" 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ] || ! printf '%s' "$out" | jq -e . >/dev/null 2>&1; then
    jq -n --arg err "$out" '{available:false, reason:("heimdall-resume-brief failed: " + $err)}'
    return 0
  fi
  printf '%s' "$out" | jq -c '{available:true} + .'
}

# Human-readable, SendMessage-ready payload for one enriched agent JSON object
# (id/state/description/agent_type/worktree_path/worktree_branch + quota +
# resume_brief, as assembled by cmd_report). Reads the object on stdin.
_payload_for() {
  jq -r '
    def yn(x): if x == null then "unknown" elif x then "yes" else "no" end;
    ("Agent " + .id + " (" + (.agent_type // "unknown type") + ") — interrupted, last known state: " + .state) as $hdr |
    ("Task: " + (.description // "no description recorded")) as $task |
    ("Quota exhaustion suspected: " + yn(.quota.suspected) +
      (if .quota.suspected == true and .quota.reset_local != null
       then " (resets " + .quota.reset_local + " " + (.quota.reset_tz // "") + ")"
       else "" end)) as $quota |
    ("Cause: " + (.cause.class // "none (orphaned/hung, no notification text)") + " — " + .cause.action) as $cause |
    (if .worktree_path == null then
       "No isolated worktree recorded for this agent (not spawned with worktree isolation)."
     elif (.resume_brief == null) then
       "Worktree: " + .worktree_path + " (no resume-brief available)"
     elif (.resume_brief.available == false) then
       "Worktree: " + .worktree_path + " — " + .resume_brief.reason
     else
       "Worktree: " + .worktree_path + " (branch " + (.worktree_branch // "?") + ")\n" +
       (.resume_brief.ahead_of_base|tostring) + " commit(s) already committed ahead of " +
         (.resume_brief.base // "base") + " — DO NOT REDO these.\n" +
       (.resume_brief.dirty|tostring) + " uncommitted file(s)" +
       (if .resume_brief.dirty > 0
        then " — AT RISK if this worktree is discarded: " + (.resume_brief.dirty_files | join(", "))
        else " (clean)" end)
     end) as $wt |
    $hdr + "\n" + $task + "\n" + $quota + "\n" + $cause + "\n" + $wt + "\n" +
    "Resume from this state — do not restart from scratch."
  '
}

cmd_report() {
  local as_json="" repo="$PWD" states="$DEFAULT_STATES" base="main" only_id="" run_tests="0"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift ;;
      --repo) repo="$2"; shift 2 ;;
      --states) states="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --id) only_id="$2"; shift 2 ;;
      --run-tests) run_tests="1"; shift ;;
      *) echo "heimdall-agent-resume: unknown arg: $1" >&2; return 2 ;;
    esac
  done
  repo="$(cd "$repo" 2>/dev/null && pwd)" || repo="$PWD"

  local rows n
  rows="$(_interrupted_json "$repo" "$states")"
  if [ -n "$only_id" ]; then
    rows="$(printf '%s' "$rows" | jq -c --arg id "$only_id" '[ .[] | select(.id == $id) ]')"
  fi
  n="$(printf '%s' "$rows" | jq 'length' 2>/dev/null)"; [ -n "$n" ] || n=0

  if [ "$n" -eq 0 ]; then
    if [ -n "$as_json" ]; then echo '[]'; else echo "no interrupted subagents (states checked: $states)"; fi
    return 0
  fi

  # Every parent-session transcript under this repo's Claude-projects slug —
  # where a <task-notification><summary> for a failed/killed agent would live.
  # Mirrors bin/heimdall-agents' own _slug_for_cwd exactly (same substitution).
  local proj_dir slug_now parents="" f
  proj_dir="${HMD_AGENT_PROJECTS_DIR:-${HOME:-}/.claude/projects}"
  slug_now="${repo//[^A-Za-z0-9]/-}"
  if [ -d "$proj_dir/$slug_now" ]; then
    for f in "$proj_dir/$slug_now"/*.jsonl; do
      [ -f "$f" ] && parents="$parents $f"
    done
  fi

  local combined_all="" obj id wt qtext qjson qsuspected cause brief combined payload
  while IFS= read -r obj; do
    [ -n "$obj" ] || continue
    id="$(printf '%s' "$obj" | jq -r '.id')"
    wt="$(printf '%s' "$obj" | jq -r '.worktree_path // ""')"

    qtext="$(_notif_summary_for "$id" "$parents")"
    qjson="$(_classify_text "$qtext")"
    qsuspected="$(printf '%s' "$qjson" | jq -r '.suspected')"
    cause="$(_classify_cause "$qtext" "$qsuspected" "$wt")"
    _record_pressure_if_fresh_overload "$cause" "$repo"

    if [ -n "$wt" ] && _worktree_exists "$wt"; then
      brief="$(_brief_json "$wt" "$base" "$run_tests")"
    elif [ -n "$wt" ]; then
      brief='{"available":false,"reason":"worktree path recorded but no longer exists on disk (likely reaped)"}'
    else
      brief='null'
    fi

    combined="$(jq -n --argjson base "$obj" --argjson quota "$qjson" --argjson brief "$brief" --argjson cause "$cause" \
      '$base + {quota: $quota, resume_brief: $brief, cause: $cause}')"
    payload="$(printf '%s' "$combined" | _payload_for)"
    combined="$(printf '%s' "$combined" | jq -c --arg payload "$payload" '. + {payload: $payload}')"
    combined_all="$combined_all$combined"$'\n'
  done < <(printf '%s' "$rows" | jq -c '.[]')

  local out
  out="$(printf '%s' "$combined_all" | jq -s '.')"

  if [ -n "$as_json" ]; then
    printf '%s\n' "$out"
    return 0
  fi

  echo "=== $n interrupted subagent(s) — resume payload(s) below, ready for SendMessage ==="
  echo
  printf '%s' "$out" | jq -r '[.[].payload] | join("\n\n----------------------------------------\n\n")'
}

# resume-hint — mirrors bin/heimdall-quota-resume's own contract (and, before
# it, bin/heimdall-maintain-loop's): print NOTHING unless there is something
# genuinely actionable. Cheap when clean (one heimdall-agents list --json call
# + a length check) — this is the SessionStart hot path.
cmd_resume_hint() {
  local repo="$PWD"
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  repo="$(cd "$repo" 2>/dev/null && pwd)" || return 0

  local rows n
  rows="$(_interrupted_json "$repo" "$DEFAULT_STATES")"
  n="$(printf '%s' "$rows" | jq 'length' 2>/dev/null)"; [ -n "$n" ] || n=0
  [ "$n" -gt 0 ] || return 0

  echo "[heimdall] $n INTERRUPTED SUBAGENT(S) found from a prior session on this repo:"
  printf '%s' "$rows" | jq -r '.[] | "  • " + .id + "  [" + .state + "]  " + (.description // "no description")' 2>/dev/null
  echo "  Full resume payload (git state, safe-to-skip commits, dirty files):"
  echo "    heimdall-agent-resume report --repo \"$repo\""
  echo "  That report also classifies WHY each one stopped (quota/overloaded/network/context-limit/unknown) — an unknown cause is never auto-retried."
  echo "  Once handled, silence an entry: heimdall-agents reap"
  return 0
}

main() {
  local sub="${1:-}"
  case "$sub" in
    list)        shift; cmd_list "$@" ;;
    report)      shift; cmd_report "$@" ;;
    resume-hint) shift; cmd_resume_hint "$@" ;;
    -h|--help|help|'') usage ;;
    *) echo "error: unknown subcommand: $sub" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
