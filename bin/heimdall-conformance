#!/usr/bin/env bash
#
# heimdall-conformance — EXECUTABLE CHECKS FOR THE RULES WE ALREADY WROTE DOWN.
#
# WHY THIS FILE EXISTS
# --------------------
# In this repo a rule without a falsifier is a comment. Three exhibits from a
# single session, all the same class:
#
#   * the token-frugal brief was built in June and wired to nothing for two
#     months — every spawn kept pasting the plan, and nothing noticed
#   * a fail-open ⚠ observation sat known-and-unfixed for three days
#   * checkpoints silently dropped fields, with no self-check to say so
#
# None of those were unknown. All three were WRITTEN DOWN as rules. What was
# missing in every case was a thing that goes RED. So this binary turns the
# protocol rules that CAN be checked mechanically into checks, and the honesty
# rule (from the frugal brief itself) covers the rest:
#
#     "a protocol that can't be checked gets a line saying so rather than
#      silent exemption."
#
# `inventory` is that line. It enumerates EVERY normative rule in the source
# documents and gives each one a verdict — CHECKED (naming the suite that
# enforces it) or UNCHECKABLE (stating why). A rule may never be simply absent.
#
# THE CHECKS
#   commit-per-unit   an ABANDONED dirty agent worktree = work that was never
#                     committed. A LIVE one is an agent mid-keystroke and is
#                     never a violation.
#   brief-routing     every doc that instructs an Agent spawn must route the
#                     child's context through `heimdall-brief`, never the plan.
#   gate-runs-once    two full-gate runs with no edit between them is pure
#                     waste (the full gate costs ~1374s).
#   gates-at-end      the first full-gate run of a session must come AFTER some
#                     work. Gating an unchanged tree proves nothing.
#   suite-runs-once   the same single suite (`bash test/<name>.test.sh`) run 3+
#                     times with no edit between the runs. Operator rule,
#                     2026-10-08: "test once, at the end" — one solo re-run (2
#                     runs) is the allowance for a load-caused failure, the
#                     third is waste.
#   sweep-staled-by-merge  a full-gate run completed GREEN, then a merge/commit of
#                     non-hook-owned work landed before the next push, then ANOTHER
#                     full-gate run started: the first sweep was wasted by an unbatched
#                     merge. Operator directive, 2026-10-11 ("batch before you sweep":
#                     merge every pending agent result FIRST, then run ONE sweep).
#   sweeps-overlap    two full-gate runs whose start/end intervals overlap — a second
#                     sweep started while the first was still running.
#
# FAIL-CLOSED, ALWAYS
# Repo rule: "gates must fail closed: an unreachable verifier is NON_VERIFIED,
# never OPEN; an empty scan fails loudly, never passes". Every check here exits
# 3 when it found nothing to inspect. A check that scans zero units and reports
# "clean" is how a green-but-blind gate is born, and this file is the direct
# response to three of those.
#
# EXITS
#   0  conformant — real units inspected, no violations
#   1  violation(s) found
#   2  usage error / missing dependency
#   3  NON_VERIFIED — nothing to inspect, or a source could not be read
#
# THIS TOOL NEVER MUTATES ANYTHING. commit-per-unit REPORTS dirty worktrees; it
# does not clean them. Several agent worktrees are live agent-memory homes and
# deleting one destroys work in flight.
#
# ENV (all scan roots are overridable so the suites can drive real fixtures)
#   HMD_CONF_REPO         repo root to scan            (default: this bin's ..)
#   HMD_CONF_WORKTREES    agent worktree dir           (default: $REPO/.claude/worktrees)
#   HMD_CONF_TRANSCRIPT   session transcript .jsonl    (default: newest for this repo)
#   HMD_CONF_UNDER_GATE   force the run-all self-check on(1)/off(0)
#   plus every knob of bin/lib/session-liveness.sh (HMD_AGENT_*, HMD_NOW)

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Resolve to the MAIN checkout, not whatever worktree we were launched from.
# Agent worktrees live under the main tree's .claude/worktrees, and the Claude
# session transcript is keyed to the main tree's path — so a run from inside an
# agent worktree must still inspect the project, or every check would report
# NON_VERIFIED for the exact agents it is meant to police.
_main_worktree() {
  local here="$1" gd cd_
  gd="$(git -C "$here" rev-parse --git-dir 2>/dev/null)" || { printf '%s' "$here"; return 0; }
  cd_="$(git -C "$here" rev-parse --git-common-dir 2>/dev/null)" || { printf '%s' "$here"; return 0; }
  if [ "$gd" = "$cd_" ]; then
    git -C "$here" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$here"
  else
    # A linked worktree: the common dir is the main checkout's .git
    ( cd "$here" && cd "$(dirname "$cd_")" && pwd )
  fi
}
REPO="${HMD_CONF_REPO:-$(_main_worktree "$(cd "$SELF_DIR/.." && pwd)")}"

# Liveness is SHARED, never re-derived here. bin/heimdall-agents answers the
# same "is this session alive?" question for reaping, and two copies of that
# answer would drift — the exact failure PROTOCOL.md cites brief-core.sh for.
# shellcheck source=lib/session-liveness.sh
. "$SELF_DIR/lib/session-liveness.sh"

command -v jq >/dev/null 2>&1 || { printf 'heimdall-conformance: jq is required\n' >&2; exit 2; }

WORKTREES="${HMD_CONF_WORKTREES:-$REPO/.claude/worktrees}"

# ── output helpers ────────────────────────────────────────────────────────────
VIOLATIONS=0
viol() { printf 'VIOLATION\t%s\n' "$1"; VIOLATIONS=$((VIOLATIONS + 1)); }
okline() { printf 'OK\t%s\n' "$1"; }
note() { printf 'NOTE\t%s\n' "$1"; }
nonverified() { printf 'NON_VERIFIED\t%s\n' "$1" >&2; exit 3; }

# ═════════════════════════════════════════════════════════════════════════════
# CHECK 1 — agents-commit-per-unit
# ═════════════════════════════════════════════════════════════════════════════
# CLAUDE.md: "Each completed task = one atomic git commit."
# .planning/conventions.md R3: "Worktree agents must commit in-worktree;
# uncommitted files are destroyed on cleanup."
#
# The whole difficulty is telling an ABANDONED worktree from a BUSY one. An
# agent that is still typing has uncommitted files by definition and flagging
# it is a false accusation — and a check that cries wolf gets muted, which is
# how gates die. So liveness decides, and liveness fails toward ALIVE.
check_commit_per_unit() {
  [ -d "$WORKTREES" ] || nonverified "commit-per-unit: no worktree root at $WORKTREES"

  local d id dirty live total=0 inspected=0 t age now
  now="$(hmd_live_now)"

  for d in "$WORKTREES"/agent-*; do
    [ -d "$d" ] || continue
    total=$((total + 1))
    # A directory that is not a git worktree is not evidence about commits.
    git -C "$d" rev-parse --git-dir >/dev/null 2>&1 || continue
    inspected=$((inspected + 1))

    id="$(basename "$d")"; id="${id#agent-}"
    dirty="$(git -C "$d" status --porcelain 2>/dev/null | grep -c '[^[:space:]]')"
    [ "${dirty:-0}" -gt 0 ] || continue

    t="$(hmd_subagent_transcript "$id")"
    if [ -n "$t" ]; then
      age=$(( ( now - $(hmd_live_mtime "$t") ) / 60 ))
    else
      age=-1
    fi

    if hmd_subagent_is_alive "$id"; then
      okline "live agent mid-work, not a violation	$id	dirty=$dirty	idle_min=$age"
    else
      viol "uncommitted work in an abandoned worktree	$id	dirty=$dirty	idle_min=$age"
    fi
  done

  # ANTI-VACUOUS. Zero worktrees inspected means this run proved nothing about
  # commit discipline. Reporting "clean" there is the vacuous green we are here
  # to prevent, so it is NON_VERIFIED instead.
  [ "$inspected" -gt 0 ] || nonverified "commit-per-unit: 0 git worktrees under $WORKTREES ($total dir(s) seen) — nothing inspected"
  note "commit-per-unit inspected $inspected worktree(s)"
}

# ═════════════════════════════════════════════════════════════════════════════
# CHECK 2 — spawns-route-through-the-frugal-brief
# ═════════════════════════════════════════════════════════════════════════════
# PROTOCOL.md: a spawned agent's brief is "task spec + referenced symbol
# entries + hydrated capsule closure + an invariants ref" and NEVER "the plan,
# prior conversation, or restated criteria".
#
# The set of spawn-instruction docs is DISCOVERED, not listed. A hardcoded list
# is exactly how the brief stayed unwired for two months: three files named it,
# the check passed, and every other spawn path was invisible to the check. Any
# file that teaches an Agent spawn must also teach the brief, or it is a spawn
# path that bypasses the brief and this goes RED.
BRIEF_SPAWN_MARK='subagent_type'
BRIEF_MARK='heimdall-brief'
check_brief_routing() {
  local scanroots="agents skills commands" f n hits=0 root
  local found=0

  for root in $scanroots; do
    [ -d "$REPO/$root" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      found=$((found + 1))
      n="$(grep -c "$BRIEF_MARK" "$REPO/$f" 2>/dev/null)"
      if [ "${n:-0}" -gt 0 ]; then
        okline "spawn doc routes through the brief	$f	refs=$n"
      else
        viol "spawn doc bypasses the frugal brief	$f	refs=0"
        hits=$((hits + 1))
      fi
    done <<EOF
$(cd "$REPO" && grep -rl "$BRIEF_SPAWN_MARK" "$root" 2>/dev/null | sort)
EOF
  done

  # ANTI-VACUOUS. Finding zero spawn-instruction docs in a repo whose whole
  # orchestration model is spawning means the detector broke, not that the repo
  # became clean.
  [ "$found" -gt 0 ] || nonverified "brief-routing: 0 spawn-instruction docs matched '$BRIEF_SPAWN_MARK' under $REPO — detector is blind"
  note "brief-routing inspected $found spawn-instruction doc(s)"
}

# ═════════════════════════════════════════════════════════════════════════════
# THE SESSION TRANSCRIPT CLASSIFIER  (shared by checks 3 to 7)
# ═════════════════════════════════════════════════════════════════════════════
# Ground truth for "what did this session actually do" is the Claude Code
# transcript: ~/.claude/projects/<slug>/<session>.jsonl, one JSON object per
# line. We classify seven event kinds and ignore everything else:
#
#   GATE    a Bash tool_use whose command runs the FULL gate (test/run-all.sh
#           with no --filter). A filtered run is a targeted re-run, not the
#           1374s full gate, and must not count.
#   SUITE   a Bash tool_use running ONE suite (`bash test/<name>.test.sh`), one
#           event per suite invoked — a single call may run several (`a && b`).
#           The detail is the canonical `test/<name>.test.sh`, so every spelling
#           of one suite (absolute path, ./, nohup/time/env wrappers) is a single
#           identity. `test/run-all.sh` is GATE, never a suite.
#   MUTATE  a Write/Edit/NotebookEdit tool_use — i.e. actual work. Its 4th column says
#           whether the path is hook-owned (`hook`: under .planning/ or .heimdall/,
#           written and committed by hooks) or real work (`work`).
#   MERGE   a Bash `git merge|commit|cherry-pick|pull|rebase|am|revert` in command
#           position — the integration that stales a green sweep. A `git commit` is
#           spared when every `git add` in the SAME call stages only hook-owned paths.
#   PUSH    a Bash `git push` (or `release/ship.sh`, which pushes): it closes the batch.
#   RESULT  a tool_result (ts, tool_use id, ok|error, bg task id) — where a FOREGROUND run
#           ends. An ack ("Command running in background with ID: x") names the task in
#           the last column and is NOT an end; its run is a background run even when the
#           call never set run_in_background (the harness auto-backgrounds long ones).
#   NOTIFY  a background task's <task-notification> (ts, task id, tool_use id, ok|error;
#           ok = status completed with no non-zero exit code) — where a BACKGROUND run
#           ends. Newer harnesses name only the TASK in it, so the ack's task id is the
#           join key. A TaskStop/KillShell call is a NOTIFY too (error): a stopped run
#           is over.
# GATE rows also carry the tool_use id, fg|bg, and whether the gate was the LAST command
# of its call (1/0): RESULT/NOTIFY are joined to them by id, and the exit status can only
# be read as the gate's own when nothing follows it in the call.
#
# Parsing is done entirely in jq. Shelling the command string out to grep would
# reintroduce the /bin/sh echo-escape trap that test/gate-echo-parser-guard.sh
# exists to prevent; jq never leaves JSON, so an escaped newline stays escaped.
#
# The command string is split on shell separators FIRST, so a gate invocation is
# only counted when `test/run-all.sh` sits in COMMAND POSITION. Validated
# against a real 14-invocation session with zero false positives: `pgrep -f
# run-all.sh`, `wc -l test/run-all.sh`, and a python string literal that merely
# CONTAINED "bash test/run-all.sh" were all correctly excluded.
#
# A suite run is read the same way: `test/<name>.test.sh` in command position,
# behind bash/sh/zsh or executed directly, after the same wrappers. `suite_of`
# also strips bare `VAR=value` prefixes (the gate classifier only knows the
# `env VAR=value` form). Flags are deliberately NOT skipped: `bash -n x.test.sh`
# is a syntax check, not a run, and counting it would cry wolf — a missed
# `bash -x` run is the cheaper error. Only a name of [A-Za-z0-9._-] is a suite,
# and `test/run-all.sh` carries no `.test.sh` suffix, so the full gate can never
# be mistaken for one.
_classify_program() {
  cat <<'JQ'
def segments:
  [splits("(;|&&|\\|\\||\\||\n)")] | map(sub("^\\s+";"") | sub("\\s+$";""));
def unwrap:
  sub("^nohup\\s+";"") | sub("^time\\s+";"")
  | sub("^timeout\\s+[0-9]+\\s+";"")
  | sub("^(env\\s+[A-Za-z_][A-Za-z0-9_]*=\\S*\\s+)+";"")
  | sub("^&\\s*";"") | sub("^\\s+";"");
def is_full_gate:
  unwrap as $s
  | (($s | test("^(bash|sh|zsh)\\s+[^ ]*test/run-all\\.sh(\\s|$)"))
     or ($s | test("^\\.?/?[^ ]*test/run-all\\.sh(\\s|$)")))
    and ($s | test("--filter") | not);
def suite_of:
  unwrap
  | sub("^([A-Za-z_][A-Za-z0-9_]*=\\S*\\s+)+";"")
  | capture("^(?:(?:bash|sh|zsh)\\s+|(?:\\./)?)(?:\\S*/)?test/(?<name>[A-Za-z0-9._-]+)\\.test\\.sh(?:\\s|$|[<>&])")
  | "test/\(.name).test.sh";
# `git [-C dir] <sub> <rest>` in command position -> {sub, rest, line}; nothing otherwise.
def git_cmd:
  . as $seg | unwrap | sub("^([A-Za-z_][A-Za-z0-9_]*=\\S*\\s+)+";"")
  | capture("^git(?:\\s+-[Cc]\\s+\\S+)*\\s+(?<sub>[a-z][a-z-]*)(?:\\s+(?<rest>.*))?$")
  | .rest = (.rest // "") | .line = $seg;
# Hooks write and commit these themselves (journal, state, receipts): never real work.
def hook_path: test("(^|/)\\.(planning|heimdall)/");
# Does EVERY `git add` in this call stage only hook-owned paths? (no `git add` at all: false)
def call_hook_only($segs):
  [$segs[] | git_cmd | select(.sub == "add") | .rest | [splits("\\s+")][]
   | select(length > 0 and (startswith("-") | not))]
  | length > 0 and all(hook_path);
def git_row($ts; $hook_only):
  git_cmd
  | if .sub == "push" then
      select(.rest | test("(^|\\s)(--dry-run|-n)(\\s|$)") | not)
      | [$ts, "PUSH", .line[0:100]]
    elif (.sub | IN("merge", "cherry-pick", "pull", "rebase", "am", "revert")) then
      select(.rest | test("(^|\\s)--(abort|quit|dry-run)(\\s|$)") | not)
      | [$ts, "MERGE", .line[0:100]]
    elif .sub == "commit" then
      select(.rest | test("(^|\\s)--dry-run(\\s|$)") | not)
      | select(($hook_only and (.rest | test("(^|\\s)(-[a-zA-Z]*a[a-zA-Z]*|--all)(\\s|$)") | not)) | not)
      | [$ts, "MERGE", .line[0:100]]
    else empty end;
# release/ship.sh pushes: it closes the batch exactly as `git push` does.
def ship_row($ts):
  select(unwrap | test("^((bash|sh|zsh)\\s+)?(\\./)?[^ ]*release/ship\\.sh(\\s|$)"))
  | [$ts, "PUSH", .[0:100]];
def assistant_rows:
  select(.type == "assistant") | .timestamp as $ts
  | .message.content[]? | select(.type == "tool_use")
  | (.id // "") as $id
  | (if (.input.run_in_background // false) == true then "bg" else "fg" end) as $mode
  | if .name == "Bash" then
      ((.input.command // "") | segments | map(select(length > 0))) as $segs
      | call_hook_only($segs) as $hook_only
      | ($segs | length) as $n
      | ($segs | to_entries[]) as $e
      | $e.value as $seg
      | (($seg | select(is_full_gate)
          | [$ts, "GATE", (.[0:100]), $id, $mode, (if $e.key == $n - 1 then "1" else "0" end)]),
         ($seg | suite_of | [$ts, "SUITE", .]),
         ($seg | git_row($ts; $hook_only)),
         ($seg | ship_row($ts)))
    elif (.name == "Write" or .name == "Edit" or .name == "NotebookEdit") then
      ((.input.file_path // "?") | tostring) as $p
      | [$ts, "MUTATE", $p, (if ($p | hook_path) then "hook" else "work" end)]
    elif (.name == "TaskStop" or .name == "KillShell") then
      [$ts, "NOTIFY", (.input.task_id // .input.shell_id // ""), "", "error"]
    else empty end;
def user_rows:
  select(.type == "user") | .timestamp as $ts
  | ((.message.content | arrays | .[] | select(type == "object" and .type == "tool_result")
      | (if (.content | type) == "string" then .content
         elif (.content | type) == "array" then ([.content[] | objects | .text? | strings] | join(""))
         else "" end) as $body
      | [$ts, "RESULT", (.tool_use_id // ""), (if .is_error == true then "error" else "ok" end),
         (($body | capture("Command running in background with ID: (?<t>[A-Za-z0-9_-]+)") | .t) // "")]),
     (((.message.content | strings),
       (.message.content | arrays | .[] | select(type == "object" and .type == "text") | .text | strings))
      | select(test("<task-notification>"))
      | ((capture("<task-id>(?<t>[^<]+)</task-id>") | .t) // "") as $task
      | ((capture("<tool-use-id>(?<u>[^<]+)</tool-use-id>") | .u) // "") as $use
      | select($task != "" or $use != "")
      | [$ts, "NOTIFY", $task, $use,
         (if test("<status>completed</status>") and (test("exit code [1-9]") | not) then "ok" else "error" end)]));
(assistant_rows, user_rows) | @tsv
JQ
}

# Resolve the transcript to read. Explicit override wins; otherwise the newest
# top-level transcript for THIS repo's project slug.
_resolve_transcript() {
  if [ -n "${HMD_CONF_TRANSCRIPT:-}" ]; then printf '%s' "$HMD_CONF_TRANSCRIPT"; return 0; fi
  local slug dir best="" best_mt=-1 f mt
  slug="$(hmd_live_slug_for_cwd "$REPO")"
  dir="$HMD_LIVE_PROJECTS/$slug"
  for f in "$dir"/*.jsonl; do
    [ -f "$f" ] || continue
    mt="$(hmd_live_mtime "$f")"
    if [ "$mt" -gt "$best_mt" ] 2>/dev/null; then best_mt="$mt"; best="$f"; fi
  done
  printf '%s' "$best"
}

# Emit the classified event stream (ts \t kind \t detail), oldest first.
_events() {
  local t prog rc
  t="$(_resolve_transcript)"
  [ -n "$t" ] || return 3
  [ -r "$t" ] || return 3
  prog="$(mktemp "${TMPDIR:-/tmp}/hmdconf.XXXXXX")"
  _classify_program >"$prog"
  jq -r -f "$prog" "$t" 2>/dev/null
  rc=$?
  rm -f "$prog"
  return $rc
}

# Is this process running underneath a full-gate run? Used as a self-check: if
# we are demonstrably inside `test/run-all.sh` and the parser reports zero gate
# invocations, the parser is broken — and a broken parser reports "no duplicate
# gate runs" forever. This makes the detector verify itself against ground
# truth on every single full-gate run.
_under_full_gate() {
  case "${HMD_CONF_UNDER_GATE:-}" in 1) return 0 ;; 0) return 1 ;; esac
  local pid="$$" depth=0 line
  while [ "$depth" -lt 12 ]; do
    line="$(ps -o ppid=,command= -p "$pid" 2>/dev/null)"
    [ -n "$line" ] || return 1
    case "$line" in *run-all.sh*) return 0 ;; esac
    pid="$(printf '%s' "$line" | awk '{print $1}')"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ] || return 1
    depth=$((depth + 1))
  done
  return 1
}

# Shared load: fills EV (the event stream) or exits 3.
#   $1  event kinds that count as "something to inspect"    (default GATE|MUTATE)
#   $2  how those kinds read in the NON_VERIFIED message    (default gate/edit)
#   $3  event kinds kept in EV for the check to read    (default GATE|MUTATE|SUITE — all
#       the older checks ever saw; the count above is taken BEFORE this filter)
# A check is judged only on the kinds IT reads. The full-gate checks keep the
# default so SUITE events they never look at cannot fill their anti-vacuous count:
# a transcript of nothing but suite runs says nothing about gate discipline.
EV=""
_load_events() {
  local kinds="${1:-GATE|MUTATE}" label="${2:-gate/edit}" keep="${3:-GATE|MUTATE|SUITE}" t n
  t="$(_resolve_transcript)"
  [ -n "$t" ] || nonverified "no session transcript found for $REPO (set HMD_CONF_TRANSCRIPT)"
  [ -r "$t" ] || nonverified "session transcript is unreadable: $t"
  EV="$(_events)" || nonverified "could not parse session transcript: $t"
  n="$(printf '%s\n' "$EV" | awk -F'\t' -v k="^($kinds)\$" '$2 ~ k { c++ } END { print c + 0 }')"
  EV="$(printf '%s\n' "$EV" | awk -F'\t' -v k="^($keep)\$" '$2 ~ k')"
  # An empty classification is NOT a clean session. It means we learned nothing
  # about gate discipline from this transcript.
  [ "${n:-0}" -gt 0 ] || nonverified "session transcript yielded 0 $label events: $t"
  note "transcript $t"
}

_selfcheck_detector() {
  local gates="$1"
  if _under_full_gate && [ "$gates" -eq 0 ]; then
    viol "detector self-check: running under test/run-all.sh but the parser saw 0 full-gate invocations — the classifier is blind, so every green verdict from it is meaningless"
  fi
}

# ═════════════════════════════════════════════════════════════════════════════
# CHECK 3 — full-gate-runs-once
# ═════════════════════════════════════════════════════════════════════════════
# House rule: the full gate runs ONCE, after the work. `bash test/run-all.sh`
# costs 1374s measured, so a second run over an unchanged tree burns ~23 min to
# recompute a verdict already on screen.
#
# The rule is NOT "count > 1". A long session legitimately gates several
# separate units of work, and a check that goes permanently red on any long
# session gets disabled — which is the disease, not the cure. The honest reading
# of "runs once, after the work" is: two gate runs with NO EDIT BETWEEN THEM.
# That is unambiguous waste, and it is what actually happened 7 times today.
check_gate_runs_once() {
  _load_events
  local ts kind detail pending="" gates=0 dupes=0
  while IFS=$'\t' read -r ts kind detail; do
    [ -n "${kind:-}" ] || continue
    if [ "$kind" = "GATE" ]; then
      gates=$((gates + 1))
      if [ -n "$pending" ]; then
        viol "duplicate full-gate run with no edit between	first=$pending	second=$ts"
        dupes=$((dupes + 1))
      fi
      pending="$ts"
    elif [ "$kind" = "MUTATE" ]; then
      pending=""
    fi
  done <<EOF
$EV
EOF
  _selfcheck_detector "$gates"
  [ "$dupes" -gt 0 ] || okline "no back-to-back full-gate run	gate_runs=$gates"
  note "gate-runs-once saw $gates full-gate invocation(s)"
}

# ═════════════════════════════════════════════════════════════════════════════
# CHECK 4 — gates-at-end
# ═════════════════════════════════════════════════════════════════════════════
# Gates run AFTER the work. A full-gate run before the session has edited
# anything is a verdict about the previous commit, not about this session — it
# consumes the full 1374s to tell you something you already knew.
check_gates_at_end() {
  _load_events
  local ts kind detail seen_mutate=0 gates=0 early=0
  while IFS=$'\t' read -r ts kind detail; do
    [ -n "${kind:-}" ] || continue
    if [ "$kind" = "MUTATE" ]; then
      seen_mutate=1
    elif [ "$kind" = "GATE" ]; then
      gates=$((gates + 1))
      if [ "$seen_mutate" -eq 0 ]; then
        viol "full gate ran before any edit in this session	at=$ts"
        early=$((early + 1))
      fi
    fi
  done <<EOF
$EV
EOF
  _selfcheck_detector "$gates"
  [ "$early" -gt 0 ] || okline "every full-gate run followed real work	gate_runs=$gates"
  note "gates-at-end saw $gates full-gate invocation(s)"
}

# ═════════════════════════════════════════════════════════════════════════════
# CHECK 5 — suite-runs-once
# ═════════════════════════════════════════════════════════════════════════════
# Operator rule (2026-10-08): test ONCE, at the end. Running one suite again over
# a tree nobody edited recomputes a verdict already on screen — the waste of check
# 3, one suite at a time instead of the full gate.
#
# The rule is NOT "ran it twice". A suite that failed because the machine was
# loaded deserves ONE solo re-run, and a check that flags it gets muted, which is
# how gates die. So two runs are allowed — the run and its one re-run — and the
# THIRD run with no edit between is the violation: the failure was not load, and
# running a deterministic suite again cannot change its answer.
#
# Counted per suite. A Write/Edit/NotebookEdit resets EVERY suite's count: the
# tree changed, so every earlier verdict is stale and the next run is new
# information. A streak is reported once, when it ends (the next edit, or the end
# of the transcript), with its full run count. A Bash call running several suites
# counts each of them.
#
# Edits made THROUGH Bash (sed -i, a heredoc, tee) are not MUTATE events — the same
# tool-call-only discipline as checks 3 and 4, which keeps this check out of the
# business of guessing at shell. A re-run after a Bash-made edit therefore reads as
# "no edit between"; edit with Edit/Write and the count resets as intended.
#
# usage() and the header say "3+": keep them in step with this number.
SUITE_RUNS_ALLOWED=2
check_suite_runs_once() {
  _load_events 'GATE|MUTATE|SUITE' 'gate/edit/suite'
  local rows tag a b c d total=0 flagged=0
  rows="$(printf '%s\n' "$EV" | awk -F'\t' -v allowed="$SUITE_RUNS_ALLOWED" '
    function ts(x) { return x == "" ? "?" : x }
    function emit_streak(   i, s) {
      for (i = 1; i <= k; i++) {
        s = order[i]
        if (runs[s] > allowed) printf "V\t%s\t%d\t%s\t%s\n", s, runs[s], first[s], last[s]
      }
      split("", runs); k = 0
    }
    $2 == "SUITE" {
      s = $3; total++
      if (!(s in runs)) { order[++k] = s; first[s] = ts($1) }
      runs[s]++; last[s] = ts($1)
    }
    $2 == "MUTATE" { emit_streak() }
    END { emit_streak(); printf "T\t%d\n", total }
  ')" || nonverified "suite-runs-once: could not count suite runs (awk failed) — no verdict"
  while IFS=$'\t' read -r tag a b c d; do
    case "$tag" in
      V) viol "suite run more than $SUITE_RUNS_ALLOWED times with no edit between	suite=$a	runs=$b	first=$c	last=$d"
         flagged=$((flagged + 1)) ;;
      T) total="$a" ;;
    esac
  done <<EOF
$rows
EOF
  [ "$flagged" -gt 0 ] || okline "no suite run more than $SUITE_RUNS_ALLOWED times with no edit between	suite_runs=$total"
  note "suite-runs-once saw $total suite invocation(s)"
}

# ═════════════════════════════════════════════════════════════════════════════
# CHECK 6 — sweep-staled-by-merge
# ═════════════════════════════════════════════════════════════════════════════
# Operator directive (2026-10-11): "batch before you sweep". Collect every pending
# agent result, merge them ALL, then run ONE sweep — never merge anything between a
# green sweep and its push. Measured the same day: ~9 full sweeps of ~70 minutes,
# because agent fixes were merged one at a time and every merge staled the last green
# receipt.
#
# The pattern: a full-gate run COMPLETES GREEN -> a MERGE (git merge/commit/cherry-pick/
# pull/rebase/am/revert, in command position) lands before any PUSH -> ANOTHER
# full-gate run starts. The first sweep was spent for nothing.
#
# What does NOT count, so the check cannot cry wolf (a check that cries wolf gets muted):
#   * a RED sweep. Fix, merge the fix, re-sweep is the sanctioned flow ("a failing suite
#     gets fixed and the fix rides the next batch"). Green means the foreground
#     tool_result is not an error, or the background task-notification says completed
#     with no non-zero exit code; a run whose outcome is not on the record is not green.
#   * a PUSH (git push, release/ship.sh): it closes the batch, so a later merge belongs
#     to the next one.
#   * hook-owned files. .planning/ and .heimdall/ are written and committed by hooks
#     (journal, state, receipts): a commit whose every `git add` in the same call names
#     only those, and a Write/Edit under them, never stale a sweep. A commit whose
#     staged paths cannot be seen (no `git add` in the call, or `-a`) is treated as work.
#   * a real Write/Edit after the merge: the edit independently required the new sweep,
#     so the re-sweep is not blamed on the merge (the same reading as gate-runs-once).
#
# LIMIT, stated plainly: "green" is the exit status the harness reports for the CALL. When
# the sweep is the last command of its call that is the gate's own status (green_exit=gate).
# When commands follow it (`; echo "exit $?"; tail ...`) the status is theirs and can mask
# a red sweep, so the violation says green_exit=call and wants a human glance before it is
# believed. Run the sweep as the last command of its call for an exact verdict.
#
# Row order in the append-only transcript is the clock, so the verdict is arithmetic on
# order and never parses a timestamp. A merge DURING a sweep is not examined here — only
# merges that land after a sweep completed green.
check_sweep_staled_by_merge() {
  _load_events 'GATE|MUTATE' 'gate/edit' 'GATE|MUTATE|MERGE|PUSH|RESULT|NOTIFY'
  local rows tag a b c gates=0 flagged=0
  rows="$(printf '%s\n' "$EV" | awk -F'\t' '
    function ts(x) { return x == "" ? "?" : x }
    function gate_of(kind, a, b) {
      if (kind == "RESULT") return (a in mode) ? a : ""
      if (b != "" && (b in mode)) return b
      return (a in task2gate) ? task2gate[a] : ""
    }
    function ends(kind, g) { return g != "" && ((kind == "RESULT" && mode[g] == "fg") || (kind == "NOTIFY" && mode[g] == "bg")) }
    function reset() { green = 0; staled = 0 }
    $2 == "GATE" {
      gates++
      if (green && staled) { printf "V\t%s\t%s\t%s\t%s\n", green_at, staled_at, ts($1), green_exit }
      reset()
      mode[$4] = $5; last[$4] = $6; started[$4] = ts($1)
    }
    $2 == "RESULT" && ($3 in mode) && $5 != "" { mode[$3] = "bg"; task2gate[$5] = $3 }
    $2 == "RESULT" || $2 == "NOTIFY" {
      g = gate_of($2, $3, $4); out = ($2 == "RESULT") ? $4 : $5
      if (ends($2, g)) {
        if (out == "ok") { green = 1; green_at = started[g]; green_exit = (last[g] == 1 ? "gate" : "call"); staled = 0 } else { reset() }
      }
    }
    $2 == "MERGE" && green && !staled { staled = 1; staled_at = ts($1) }
    $2 == "MUTATE" && $4 != "hook" { reset() }
    $2 == "PUSH" { reset() }
    END { printf "T\t%d\n", gates }
  ')" || nonverified "sweep-staled-by-merge: could not read the sweep history (awk failed) — no verdict"
  while IFS=$'\t' read -r tag a b c d; do
    case "$tag" in
      V) viol "a green sweep was staled by a merge/commit before the next sweep — merge every pending result FIRST, then sweep ONCE	green=$a	merge=$b	next_gate=$c	green_exit=$d"
         flagged=$((flagged + 1)) ;;
      T) gates="$a" ;;
    esac
  done <<EOF
$rows
EOF
  _selfcheck_detector "$gates"
  [ "$flagged" -gt 0 ] || okline "no green sweep was staled by a merge before the next sweep	gate_runs=$gates"
  note "sweep-staled-by-merge saw $gates full-gate invocation(s)"
}

# ═════════════════════════════════════════════════════════════════════════════
# CHECK 7 — sweeps-overlap
# ═════════════════════════════════════════════════════════════════════════════
# "Never start a second sweep while one runs." Two overlapping full-gate runs grade a
# tree neither one owns and spend two half hours on one verdict — measured 2026-10-11,
# when two sweeps ran at once.
#
# Each run is an interval read from the transcript. It STARTS at its tool_use; it ENDS
# at its tool_result when it ran in the foreground and at its task-notification when it
# ran in the background — the immediate "Command running in background" tool_result is
# only an ack and is NOT the end. Row order is the clock, so two runs overlap when the
# second STARTS before the first has ENDED; that also catches two foreground runs issued
# in ONE message (both tool_uses precede both results).
#
# A background run that never reported back is still running as far as the record shows,
# so a sweep started after it overlaps it (first_ended=never). A FOREGROUND run with no
# recorded result cannot be judged and is never an accusation: the harness always returns
# a foreground tool_result, so its absence means the record is cut, not that the run was
# still going.
check_sweeps_overlap() {
  _load_events 'GATE|MUTATE' 'gate/edit' 'GATE|RESULT|NOTIFY'
  local rows tag a b c gates=0 flagged=0
  rows="$(printf '%s\n' "$EV" | awk -F'\t' '
    function ts(x) { return x == "" ? "?" : x }
    function gate_of(kind, a, b) {
      if (kind == "RESULT") return (a in id2n) ? id2n[a] : 0
      if (b != "" && (b in id2n)) return id2n[b]
      return (a in task2n) ? task2n[a] : 0
    }
    function ends(kind, n) { return n > 0 && ((kind == "RESULT" && mode[n] == "fg") || (kind == "NOTIFY" && mode[n] == "bg")) }
    $2 == "GATE" {
      gates++
      for (j = 1; j < gates; j++) if (!ended[j] && !reported[j]) { cand++; cj[cand] = j; ck[cand] = gates; reported[j] = 1 }
      id2n[$4] = gates; mode[gates] = $5; st[gates] = ts($1)
    }
    $2 == "RESULT" && ($3 in id2n) && $5 != "" { mode[id2n[$3]] = "bg"; task2n[$5] = id2n[$3] }
    $2 == "RESULT" || $2 == "NOTIFY" {
      n = gate_of($2, $3, $4)
      if (ends($2, n) && !ended[n]) { ended[n] = 1; en[n] = ts($1) }
    }
    END {
      for (i = 1; i <= cand; i++) {
        j = cj[i]; k = ck[i]
        if (mode[j] == "fg" && !ended[j]) continue
        printf "V\t%s\t%s\t%s\n", st[j], st[k], (ended[j] ? en[j] : "never")
      }
      printf "T\t%d\n", gates
    }
  ')" || nonverified "sweeps-overlap: could not read the sweep history (awk failed) — no verdict"
  while IFS=$'\t' read -r tag a b c; do
    case "$tag" in
      V) viol "a second full-gate run started while the first was still running — never start a sweep while one runs	first=$a	second=$b	first_ended=$c"
         flagged=$((flagged + 1)) ;;
      T) gates="$a" ;;
    esac
  done <<EOF
$rows
EOF
  _selfcheck_detector "$gates"
  [ "$flagged" -gt 0 ] || okline "no two full-gate runs overlapped	gate_runs=$gates"
  note "sweeps-overlap saw $gates full-gate invocation(s)"
}

# ═════════════════════════════════════════════════════════════════════════════
# inventory — THE HONESTY LINE
# ═════════════════════════════════════════════════════════════════════════════
# See bin/lib/rule-inventory.sh for the extractor and the classification rules.
# shellcheck source=lib/rule-inventory.sh
. "$SELF_DIR/lib/rule-inventory.sh"

usage() {
  cat >&2 <<'USAGE'
usage: heimdall-conformance <check>

checks
  commit-per-unit   abandoned dirty agent worktrees (live ones are never flagged)
  brief-routing     every spawn-instruction doc routes through heimdall-brief
  gate-runs-once    two full-gate runs with no edit between them
  gates-at-end      a full-gate run before any work in the session
  suite-runs-once   one suite run 3+ times with no edit between (one solo re-run is allowed)
  sweep-staled-by-merge  a green full-gate run, a merge/commit of real work before the next push, then another full-gate run
  sweeps-overlap    a second full-gate run started while the first was still running
  all               all seven, aggregated

inventory
  inventory         print every normative rule with a CHECKED/UNCHECKABLE verdict
  inventory --write regenerate the committed inventory artifact

exits: 0 conformant · 1 violation(s) · 2 usage/dependency · 3 NON_VERIFIED
USAGE
  exit 2
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    commit-per-unit) check_commit_per_unit ;;
    brief-routing)   check_brief_routing ;;
    gate-runs-once)  check_gate_runs_once ;;
    gates-at-end)    check_gates_at_end ;;
    suite-runs-once) check_suite_runs_once ;;
    sweep-staled-by-merge) check_sweep_staled_by_merge ;;
    sweeps-overlap)  check_sweeps_overlap ;;
    all)
      check_commit_per_unit
      check_brief_routing
      check_gate_runs_once
      check_gates_at_end
      check_suite_runs_once
      check_sweep_staled_by_merge
      check_sweeps_overlap
      ;;
    inventory)       shift; rule_inventory "$@"; return $? ;;
    ''|-h|--help)    usage ;;
    *)               printf 'heimdall-conformance: unknown check %s\n' "$cmd" >&2; usage ;;
  esac
  [ "$VIOLATIONS" -eq 0 ] || return 1
  return 0
}

main "$@"
