#!/usr/bin/env bash
# designmatch — match a Claude Design HTML canonical to a React Native app
# to ≥95% visual parity. CLI dispatcher for the designmatch skill.
#
# Subcommands:
#   init <canonical-source> [--app-dir <path>] [--target <rel>] [--force]
#                 — one-shot bootstrap. Copies visual-qa.ts into the RN
#                   app, writes default state.vqa.json, registers the
#                   canonical source (URL or local path), updates
#                   .gitignore, and prints the wiring snippet.
#   wire          — app-side only (skip canonical setup). Same as init
#                   without the canonical source arg.
#   render <src> --out <png> [--state <json>] [--screen <name>] [--wait <ms|sel>]
#                 — Playwright canonical render at 1080x2444.
#   diff <canonical.png> <native.png> --out-dir <dir> [--threshold <n>]
#                 — pixelmatch + SSIM + composite triptych.
#   iterate <ScreenName> [--platform android|ios] [--device <id>]
#                 — per-screen loop: render + capture + diff + open.
#   action-types  — print sample ACTION_TYPES map for visual-qa.ts.
#   help          — this text.
#
# canonical-source forms:
#   - https://... URL (e.g. Claude Design link) → registered for lazy fetch
#   - /path/to/dir → copied wholesale into .designmatch/canonical/
#   - /path/to/file.html → copied as the canonical entry

set -euo pipefail

SELF="$0"
if command -v readlink &>/dev/null; then
  SELF=$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$BIN_DIR/.." && pwd)"
SKILL_DIR="$PLUGIN_DIR/skills/designmatch"
ASSET_VQA="$SKILL_DIR/assets/visual-qa.ts"
SCRIPT_RENDER="$SKILL_DIR/scripts/render-canonical.js"
SCRIPT_DIFF="$SKILL_DIR/scripts/visual-diff.js"
SCRIPT_ITERATE="$SKILL_DIR/scripts/iterate-screen.sh"
SCRIPT_FETCH="$SKILL_DIR/scripts/fetch-canonical.js"
# WEB path — device-free candidate render + parity receipt (kills adb/xcrun).
SCRIPT_RENDER_WEB="$SKILL_DIR/scripts/render-web-candidate.js"
SCRIPT_EMIT_PARITY="$SKILL_DIR/scripts/emit-parity.js"

# designmatch v2 regenerate pipeline — sibling helper CLIs (RELOCATABLE, no baked
# path). The regen path consumes the ALREADY-MERGED hash-log + behavioral-diff and
# the language-pluggable target seam; it reuses the EXISTING visual-diff harness
# ($SCRIPT_DIFF) for the visual half of the dual-gate.
BIN_REGEN_LOG="$BIN_DIR/designmatch-regen-log"
BIN_BEHAVIORAL_DIFF="$BIN_DIR/designmatch-behavioral-diff"
BIN_TARGET="$BIN_DIR/designmatch-target"

red()    { printf "\033[31m%s\033[0m" "$*"; }
green()  { printf "\033[32m%s\033[0m" "$*"; }
cyan()   { printf "\033[36m%s\033[0m" "$*"; }
dim()    { printf "\033[2m%s\033[0m" "$*"; }
die()    { echo "$(red "✗") $*" >&2; exit 1; }
ok()     { echo "$(green "✓") $*"; }
info()   { echo "$(cyan "▸") $*"; }

usage() {
  cat <<EOF
designmatch — match Claude Design HTML canonical to React Native at ≥95% visual parity.

Usage:
  designmatch init <canonical-source> [--app-dir <path>] [--target <rel>] [--force]
                                      [--no-fetch] [--port-all] [--headed]
  designmatch wire [--app-dir <path>] [--target <rel>] [--force]
  designmatch fetch [--app-dir <path>] [--force] [--headed]
  designmatch port <ScreenName> [--app-dir <path>] [--out <path>] [--guide-only] [--no-guide]
  designmatch port-all [--app-dir <path>] [--out-dir src/screens] [--force] [--no-guide]
  designmatch render <src> --out <png> [--state <json>] [--screen <n>] [--wait <ms|sel>]
  designmatch diff <canonical.png> <native.png> --out-dir <dir> [--threshold <n>]
  designmatch iterate <ScreenName> [--platform android|ios] [--device <id>]
  designmatch regen <Screen> --canonical <file> [--old <file>] [--out <file>]
                    [--migrated <file>] [--target rn] [--ledger <path>]
                    [--canonical-png <png>] [--native-png <png>] [--visual-result pass|fail]
  designmatch regen-all [--app-dir <path>] [--target rn] [--ledger <path>]
  designmatch regen-gate <Screen> --migrated <file> [--tmp-dir <dir>] [--canonical <file>]
                    [--canonical-png <png>] [--native-png <png>] [--visual-result pass|fail]
  designmatch web <Screen> --canonical <App.html>
                    (--candidate-url <url> | --candidate-html <file> | --candidate-png <png>)
                    [--canonical-png <png>] [--state <json>] [--out-dir <dir>]
                    [--app-dir <path>] [--min <n>] [--wait <ms|sel>]
  designmatch ci [--min <n>] [--parity <file>] [--app-dir <path>]
  designmatch action-types
  designmatch help

designmatch WEB — device-free parity (no adb/xcrun):
  `web` Playwright-renders BOTH the canonical AND the CANDIDATE (a running web/
  Storybook URL or a static HTML build), diffs them with the EXISTING SSIM/
  pixelmatch harness, and emits a parity RECEIPT: .designmatch/parity.json +
  parity-badge.svg (drop into a README/PR) + the composite triptych. One command
  on any web repo. `ci --min 0.95` reads the receipt and BLOCKS a PR below the
  bar ("PR blocked: 87% parity < 95%"); missing deps → honest skip, never a
  fabricated pass. Every number is real (from the actual diff).

designmatch v2 — REGENERATE (don't retrofit):
  regen detects a changed design (hash-log), QUARANTINES the old component to tmp
  (moved, never deleted — the sole behavior source), GENERATES a fresh component
  in the target language (RN) via the language seam, you MIGRATE behavior back in,
  then a DUAL-GATE (visual SSIM≥0.95/pixelDiff≤5% AND behavioral-diff K=0 with
  honest coverage) releases the old file from tmp. Old leaves tmp ONLY on both.

Quick start — URL in, ready-to-translate out:
  designmatch init "https://api.anthropic.com/v1/design/h/HASH?open_file=App.html" \\
    --app-dir ./ --port-all
  # → 1) copies visual-qa.ts + state.vqa.json + .gitignore
  # → 2) Playwright-fetches the bundle to .designmatch/canonical/
  # → 3) ports every screen-*.jsx to src/screens/<Name>.tsx with TRANSLATION GUIDE
  # → 4) prints wiring snippet for App.tsx

  # Then translate each src/screens/<Name>.tsx top-down per the GUIDE and:
  designmatch iterate Home --platform android --device emulator-5554

Auth: if the canonical URL is behind login, add --headed to launch a
visible Chromium for interactive auth (fetch picks up after sign-in).
EOF
}

# Default Visual-QA seed (matches skills/designmatch SPEC).
default_state_json() {
  cat <<'JSON'
{
  "user": {
    "kycStatus": "verified",
    "phone_verified": true,
    "iso": "GBR",
    "name": "Visual QA"
  },
  "recipient": {
    "id": "vqa-r1",
    "name": "Test Recipient",
    "country": "IND",
    "phone": "+919999900000"
  },
  "bonus": {
    "balance": 1000,
    "ledger": [],
    "applyCapPct": 50
  },
  "transfer": {
    "sendingCountry": "GBR",
    "receivingCountry": "IND"
  }
}
JSON
}

# Resolve a sensible target path for visual-qa.ts inside an RN app.
resolve_target() {
  local app_dir="$1"
  if [ -d "$app_dir/src/lib" ];      then echo "src/lib/visual-qa.ts"
  elif [ -d "$app_dir/src/utils" ];  then echo "src/utils/visual-qa.ts"
  elif [ -d "$app_dir/src" ];        then echo "src/visual-qa.ts"
  elif [ -d "$app_dir/app" ];        then echo "app/visual-qa.ts"
  else                                    echo "visual-qa.ts"
  fi
}

# Validate RN project root (must have package.json with react-native dep).
validate_rn_app() {
  local app_dir="$1"
  [ -f "$app_dir/package.json" ] || die "no package.json in $app_dir — pass --app-dir <rn-project-root>"
  if ! grep -q '"react-native"' "$app_dir/package.json"; then
    echo "$(red "!") react-native not declared in $app_dir/package.json — proceeding anyway" >&2
  fi
}

# Copy visual-qa.ts into the app and write state.vqa.json. Shared by init + wire.
do_app_side() {
  local app_dir="$1" target_rel="$2" force="$3"
  local target_abs="$app_dir/$target_rel"

  if [ -e "$target_abs" ] && [ "$force" -eq 0 ]; then
    die "exists: $target_abs (use --force to overwrite)"
  fi

  mkdir -p "$(dirname "$target_abs")"
  cp "$ASSET_VQA" "$target_abs"
  ok "wrote $target_rel"

  mkdir -p "$app_dir/.designmatch/canonical" "$app_dir/.designmatch/screens"
  if [ ! -f "$app_dir/.designmatch/state.vqa.json" ] || [ "$force" -eq 1 ]; then
    default_state_json > "$app_dir/.designmatch/state.vqa.json"
    ok "wrote .designmatch/state.vqa.json"
  else
    info "kept existing .designmatch/state.vqa.json (use --force to overwrite)"
  fi

  # Update .gitignore (idempotent).
  local gi="$app_dir/.gitignore"
  if [ ! -f "$gi" ] || ! grep -q '^\.designmatch/canonical' "$gi"; then
    {
      [ -f "$gi" ] && tail -c1 "$gi" | read -r _ || true
      echo ""
      echo "# designmatch — canonical bundle + per-screen captures (regenerated)"
      echo ".designmatch/canonical/"
      echo ".designmatch/screens/"
    } >> "$gi"
    ok "updated .gitignore"
  fi
}

# Register canonical source (URL or local path) in .designmatch/config.json.
register_canonical() {
  local app_dir="$1" source="$2"
  local kind=""
  local stored=""
  local ts; ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  if [[ "$source" =~ ^https?:// ]]; then
    kind="url"
    stored="$source"
    ok "registered canonical URL"
    info "fetched lazily by Playwright at render time"
  elif [ -d "$source" ]; then
    kind="local-dir"
    cp -R "$source"/* "$app_dir/.designmatch/canonical/" 2>/dev/null || true
    stored=".designmatch/canonical"
    ok "copied canonical bundle from $source"
  elif [ -f "$source" ]; then
    kind="local-file"
    local html_name; html_name=$(basename "$source")
    cp "$source" "$app_dir/.designmatch/canonical/$html_name"
    # Also copy sibling files if it's part of a bundle (best-effort).
    local src_dir; src_dir=$(dirname "$source")
    for ext in jsx js css png svg; do
      cp "$src_dir"/*."$ext" "$app_dir/.designmatch/canonical/" 2>/dev/null || true
    done
    stored=".designmatch/canonical/$html_name"
    ok "copied canonical HTML: $html_name"
  else
    die "canonical-source not found: $source"
  fi

  cat > "$app_dir/.designmatch/config.json" <<JSON
{
  "canonical_source": "$stored",
  "kind": "$kind",
  "registered_at": "$ts",
  "viewport": { "width": 1080, "height": 2444, "deviceScaleFactor": 1 }
}
JSON
}

print_wiring() {
  local target_rel="$1"
  local import_path
  import_path=$(printf '%s' "$target_rel" | sed 's|\.ts$||; s|^src/|./src/|')
  cat <<EOF

──────────── WIRING ────────────
Add to your App.tsx (or root component):

  import {
    primeVisualQaFlag, applyVisualQaState, overrideFeatureFlags,
    useVqaLongPressDetector, toggleVqaAndRestart, VqaBadge,
  } from '$import_path';
  import RNRestart from 'react-native-restart';

  // At boot, before createStore:
  await primeVisualQaFlag();
  const store = createStore(...);
  applyVisualQaState(store.dispatch);
  const isFeatureEnabled = overrideFeatureFlags(originalIsFeatureEnabled);

  // In AppLogo component:
  const { onPress } = useVqaLongPressDetector(() => toggleVqaAndRestart(RNRestart));
  <Pressable onPress={onPress}>...</Pressable>

  // In root layout (inside SafeAreaProvider):
  <VqaBadge />

──────────── NEXT ────────────
1. Edit $target_rel → set ACTION_TYPES to match your reducers
   (run \`designmatch action-types\` for a starter)
2. Install peer deps if missing:
   npm i @react-native-async-storage/async-storage react-native-restart
3. Iterate a screen:
   designmatch iterate <ScreenName> --platform android --device <id>
EOF
}

cmd_init() {
  [ $# -gt 0 ] || die "init requires <canonical-source>. Run \`designmatch help\`."
  local source="$1"; shift

  local app_dir="$PWD"
  local target=""
  local force=0
  local no_fetch=0
  local port_all=0
  local headed=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-dir)  app_dir="$2"; shift 2 ;;
      --target)   target="$2"; shift 2 ;;
      --force)    force=1; shift ;;
      --no-fetch) no_fetch=1; shift ;;
      --port-all) port_all=1; shift ;;
      --headed)   headed=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  app_dir="$(cd "$app_dir" && pwd)"
  validate_rn_app "$app_dir"
  [ -z "$target" ] && target=$(resolve_target "$app_dir")

  do_app_side "$app_dir" "$target" "$force"
  register_canonical "$app_dir" "$source"

  # Auto-fetch URL canonicals unless --no-fetch.
  local cfg="$app_dir/.designmatch/config.json"
  local kind_now
  kind_now=$(python3 -c "import json; print(json.load(open('$cfg')).get('kind',''))" 2>/dev/null || echo "")
  if [ "$kind_now" = "url" ] && [ "$no_fetch" -eq 0 ]; then
    local fetch_args=(--app-dir "$app_dir")
    [ "$headed" -eq 1 ] && fetch_args+=(--headed)
    cmd_fetch "${fetch_args[@]}" || die "fetch failed — pass --no-fetch to skip, or --headed for interactive auth"
  fi

  # Auto-port every screen if --port-all.
  if [ "$port_all" -eq 1 ]; then
    local pa_args=(--app-dir "$app_dir")
    [ "$force" -eq 1 ] && pa_args+=(--force)
    cmd_port_all "${pa_args[@]}"
  fi

  print_wiring "$target"
}

cmd_wire() {
  local app_dir="$PWD"
  local target=""
  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-dir) app_dir="$2"; shift 2 ;;
      --target)  target="$2"; shift 2 ;;
      --force)   force=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  app_dir="$(cd "$app_dir" && pwd)"
  validate_rn_app "$app_dir"
  [ -z "$target" ] && target=$(resolve_target "$app_dir")

  do_app_side "$app_dir" "$target" "$force"
  print_wiring "$target"
}

cmd_render() {
  command -v node >/dev/null || die "node required for render"
  [ -f "$SCRIPT_RENDER" ] || die "missing $SCRIPT_RENDER"
  exec node "$SCRIPT_RENDER" "$@"
}

cmd_diff() {
  command -v node >/dev/null || die "node required for diff"
  [ -f "$SCRIPT_DIFF" ] || die "missing $SCRIPT_DIFF"
  exec node "$SCRIPT_DIFF" "$@"
}

cmd_iterate() {
  [ -f "$SCRIPT_ITERATE" ] || die "missing $SCRIPT_ITERATE"
  exec bash "$SCRIPT_ITERATE" "$@"
}

cmd_action_types() {
  cat <<'TS'
// Sample ACTION_TYPES — paste into visual-qa.ts and edit to match your reducers.
// The names on the right are action `type` strings your reducers handle.
export const ACTION_TYPES = {
  USER_SET:                 'user/set',
  RECIPIENT_ADD:            'recipient/add',
  RECIPIENT_SELECT:         'recipient/setSelected',
  BONUS_SET:                'bonus/set',
  TRANSFER_SET_COUNTRIES:   'transfer/setCountries',
} as const;
TS
}

cmd_fetch() {
  local app_dir="$PWD"
  local headed=0
  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-dir) app_dir="$2"; shift 2 ;;
      --headed)  headed=1; shift ;;
      --force)   force=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  app_dir="$(cd "$app_dir" && pwd)"
  local cfg="$app_dir/.designmatch/config.json"
  [ -f "$cfg" ] || die "no .designmatch/config.json — run \`designmatch init <url>\` first"

  command -v node >/dev/null || die "node required for fetch"
  command -v python3 >/dev/null || die "python3 required for config IO"
  [ -f "$SCRIPT_FETCH" ] || die "missing $SCRIPT_FETCH"

  local kind url
  kind=$(python3 -c "import json; print(json.load(open('$cfg')).get('kind',''))" 2>/dev/null || echo "")
  url=$(python3 -c "import json; print(json.load(open('$cfg')).get('canonical_source',''))" 2>/dev/null || echo "")

  if [ "$kind" != "url" ]; then
    if [ "$force" -eq 0 ]; then
      info "canonical already local (kind=$kind) — pass --force to re-fetch"
      return 0
    fi
    url=$(python3 -c "import json; print(json.load(open('$cfg')).get('original_url',''))" 2>/dev/null || echo "")
    [ -n "$url" ] || die "cannot re-fetch: no original_url stored in config"
  fi

  local out_dir="$app_dir/.designmatch/canonical"
  mkdir -p "$out_dir"

  local fetch_args=(--url "$url" --out-dir "$out_dir")
  [ "$headed" -eq 1 ] && fetch_args+=(--headed)

  info "fetching canonical bundle (Playwright)"
  node "$SCRIPT_FETCH" "${fetch_args[@]}" >/dev/null \
    || die "fetch failed — try \`designmatch fetch --headed\` for interactive auth, or save the bundle manually and re-init with the local path"

  # Promote config: url → local-dir, preserve original URL for re-fetch.
  local ts; ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  python3 - "$cfg" "$ts" <<'PY'
import json, sys
p, ts = sys.argv[1], sys.argv[2]
c = json.load(open(p))
if not c.get("original_url"):
    c["original_url"] = c.get("canonical_source", "")
c["canonical_source"] = ".designmatch/canonical"
c["kind"] = "local-dir"
c["fetched_at"] = ts
json.dump(c, open(p, "w"), indent=2)
PY

  ok "fetched canonical → .designmatch/canonical/ (kind: url → local-dir)"
}

cmd_port_all() {
  local app_dir="$PWD"
  local out_dir="src/screens"
  local force=0
  local no_guide=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-dir)  app_dir="$2"; shift 2 ;;
      --out-dir)  out_dir="$2"; shift 2 ;;
      --force)    force=1; shift ;;
      --no-guide) no_guide=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  app_dir="$(cd "$app_dir" && pwd)"
  local cfg="$app_dir/.designmatch/config.json"
  [ -f "$cfg" ] || die "no .designmatch/config.json — run \`designmatch init <url>\` first"

  command -v python3 >/dev/null || die "python3 required"
  local kind canonical_source
  kind=$(python3 -c "import json; print(json.load(open('$cfg')).get('kind',''))" 2>/dev/null || echo "")
  canonical_source=$(python3 -c "import json; print(json.load(open('$cfg')).get('canonical_source',''))" 2>/dev/null || echo "")

  if [ "$kind" = "url" ]; then
    info "canonical is URL — auto-fetching first"
    cmd_fetch --app-dir "$app_dir" || die "auto-fetch failed"
    kind=$(python3 -c "import json; print(json.load(open('$cfg')).get('kind',''))" 2>/dev/null || echo "")
    canonical_source=$(python3 -c "import json; print(json.load(open('$cfg')).get('canonical_source',''))" 2>/dev/null || echo "")
  fi

  local canonical_dir=""
  case "$kind" in
    local-dir)  canonical_dir="$app_dir/$canonical_source" ;;
    local-file) canonical_dir="$(dirname "$app_dir/$canonical_source")" ;;
    *) die "cannot port-all: unknown kind \"$kind\"" ;;
  esac
  [ -d "$canonical_dir" ] || die "canonical dir not found: $canonical_dir"

  local out_abs="$app_dir/$out_dir"
  mkdir -p "$out_abs"

  local files
  files=$(find "$canonical_dir" -maxdepth 4 -type f \
    \( -iname 'screen-*.jsx' -o -iname 'screen-*.tsx' \
       -o -iname '*Screen.jsx' -o -iname '*Screen.tsx' \) 2>/dev/null)

  [ -n "$files" ] || die "no screen sources found under $canonical_dir (looked for screen-*.{jsx,tsx} and *Screen.{jsx,tsx})"

  local count=0 skipped=0 failed=0
  while IFS= read -r src; do
    [ -n "$src" ] || continue
    local base name target
    base=$(basename "$src")
    name="${base%.*}"          # strip ext
    name="${name#screen-}"     # strip leading screen-
    name="${name%Screen}"      # strip trailing Screen
    name="$(printf '%s' "${name:0:1}" | tr '[:lower:]' '[:upper:]')${name:1}"

    target="$out_abs/$name.tsx"
    if [ -e "$target" ] && [ "$force" -eq 0 ]; then
      info "skip $name (exists; use --force to overwrite)"
      skipped=$((skipped + 1))
      continue
    fi

    local port_args=("$name" --app-dir "$app_dir" --out "$target")
    [ "$no_guide" -eq 1 ] && port_args+=(--no-guide)
    if ( cmd_port "${port_args[@]}" ) >/dev/null 2>&1; then
      ok "ported $base → ${target#$app_dir/}"
      count=$((count + 1))
    else
      info "fail $name (port error)"
      failed=$((failed + 1))
    fi
  done <<< "$files"

  echo ""
  ok "port-all: $count ported, $skipped skipped, $failed failed → $out_dir/"
  info "next: translate each $out_dir/*.tsx top-down per TRANSLATION GUIDE, then \`designmatch iterate <Screen>\`"
}

# Web JSX → React Native translation guide. Prepended to ported source so
# the translation step has the idiom map inline.
print_translation_guide() {
  cat <<'GUIDE'
// ════════════════════════════════════════════════════════════════════
// designmatch TRANSLATION GUIDE — web JSX → React Native
// ════════════════════════════════════════════════════════════════════
// Methodology: port the source, do NOT eyeball pixels. PNG is the
// verification gate; the JSX below is the spec. Translate top-down,
// then `designmatch iterate <Screen>` to verify with the diff harness.
//
// IDIOM MAP
//
//   Element / attribute (web)    →  React Native
//   ──────────────────────────────────────────────
//   <div>                        →  <View>
//   <span> <p> <h1>..<h6>        →  <Text>
//   <img src=>                   →  <Image source={{ uri }} />
//   <button onClick=>            →  <Pressable onPress=>
//   <a href=>                    →  <Pressable onPress={() => Linking.openURL()}>
//   <input>                      →  <TextInput>
//   <svg>...</svg>               →  react-native-svg primitives
//
//   className="..."              →  style={s.<name>} via StyleSheet.create
//   Tailwind classes             →  resolve each class to RN style props
//   style={{ padding: 16 }}      →  style={{ padding: normalize(16) }}
//   px values                    →  normalize(n) — always-on
//
//   display: flex                →  default; RN root is column!
//   flex-row                     →  flexDirection: 'row'
//   justify-content              →  justifyContent
//   align-items                  →  alignItems
//   gap: N                       →  gap: normalize(N)  (RN ≥ 0.71)
//
//   font-weight: 600/700/800     →  Platform.OS === 'android'
//                                     ? { fontFamily: 'Family-Bold' }
//                                     : { fontWeight: '600' }
//                                   (see anti-pattern #2)
//   font-family                  →  fontFamily: '<RN-registered-name>'
//
//   onClick / onChange           →  onPress / onChangeText (TextInput)
//   onMouseEnter / hover         →  no equivalent — drop or use Pressable
//   onScroll                     →  onScroll on ScrollView/FlatList
//
//   position: absolute           →  same
//   z-index                      →  zIndex + elevation (Android)
//
//   useState / useEffect         →  unchanged (React-shared)
//   document / window            →  remove or replace with RN APIs
//   localStorage                 →  AsyncStorage
//
// STRUCTURAL RULES (from designmatch SKILL.md, must hold):
//   • Wrap all px values in normalize() — no literal px in StyleSheet.
//   • <Text> default font is body — headings MUST specify display family.
//   • Single safe-area: Screen wrapper OR inner container, never both.
//   • Header: native stack header OR in-screen PushHeader, never both.
//
// PROCESS:
//   1. Read the canonical source below verbatim.
//   2. Translate top-down. Keep variable names + structure identical.
//   3. Replace web idioms with RN per the map above.
//   4. Save to your screen file, then:
//        designmatch iterate <ScreenName> --platform android --device <id>
//   5. PNG diff is the verification gate. Refine until SSIM ≥ 0.95
//      OR pixel-diff ≤ 5%.
//
// ════════════════════════════════════════════════════════════════════
GUIDE
}

cmd_port() {
  local screen=""
  local app_dir="$PWD"
  local out=""
  local guide_only=0
  local no_guide=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-dir)    app_dir="$2"; shift 2 ;;
      --out)        out="$2"; shift 2 ;;
      --guide-only) guide_only=1; shift ;;
      --no-guide)   no_guide=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *)  [ -z "$screen" ] && { screen="$1"; shift; } || die "unexpected arg: $1" ;;
    esac
  done

  if [ "$guide_only" -eq 1 ]; then
    print_translation_guide
    exit 0
  fi

  [ -n "$screen" ] || die "port requires <ScreenName>. Run \`designmatch help\`."

  app_dir="$(cd "$app_dir" && pwd)"
  local cfg="$app_dir/.designmatch/config.json"
  [ -f "$cfg" ] || die "no .designmatch/config.json — run \`designmatch init\` first"

  command -v python3 >/dev/null || die "python3 required to read config.json"
  local kind canonical_source
  kind=$(python3 -c "import json,sys; print(json.load(open('$cfg')).get('kind',''))" 2>/dev/null || echo "")
  canonical_source=$(python3 -c "import json,sys; print(json.load(open('$cfg')).get('canonical_source',''))" 2>/dev/null || echo "")

  # Auto-fetch URL canonicals transparently — port should "just work" on URLs.
  if [ "$kind" = "url" ]; then
    info "canonical is URL — auto-fetching first"
    cmd_fetch --app-dir "$app_dir" || die "auto-fetch failed — try \`designmatch fetch --headed\` for interactive auth"
    kind=$(python3 -c "import json; print(json.load(open('$cfg')).get('kind',''))" 2>/dev/null || echo "")
    canonical_source=$(python3 -c "import json; print(json.load(open('$cfg')).get('canonical_source',''))" 2>/dev/null || echo "")
  fi

  local canonical_dir=""
  case "$kind" in
    local-dir)
      canonical_dir="$app_dir/$canonical_source" ;;
    local-file)
      canonical_dir="$(dirname "$app_dir/$canonical_source")" ;;
    url)
      die "fetch did not complete (kind still url) — check fetch output above" ;;
    *)
      die "unknown canonical kind: \"$kind\" in $cfg" ;;
  esac

  [ -d "$canonical_dir" ] || die "canonical dir not found: $canonical_dir"

  # Resolve source file — try common patterns first, then case-insensitive find.
  local found=""
  for pat in \
    "screen-${screen}.jsx" "screen-${screen}.tsx" \
    "${screen}Screen.jsx" "${screen}Screen.tsx" \
    "${screen}.jsx" "${screen}.tsx" \
    "Screen${screen}.jsx" "Screen${screen}.tsx"; do
    if [ -f "$canonical_dir/$pat" ]; then found="$canonical_dir/$pat"; break; fi
  done
  if [ -z "$found" ]; then
    found=$(find "$canonical_dir" -maxdepth 4 -type f \( -iname "*${screen}*.jsx" -o -iname "*${screen}*.tsx" -o -iname "*${screen}*.js" \) 2>/dev/null | head -1)
  fi
  [ -n "$found" ] && [ -f "$found" ] || die "no source matching screen \"$screen\" under $canonical_dir"

  emit_port() {
    [ "$no_guide" -eq 0 ] && print_translation_guide
    echo ""
    echo "// ─── canonical source: $(basename "$found") ───"
    cat "$found"
  }

  if [ -n "$out" ]; then
    mkdir -p "$(dirname "$out")"
    emit_port > "$out"
    ok "ported $(basename "$found") → $out"
    info "next: translate idioms per guide, then \`designmatch iterate $screen\` to verify"
  else
    emit_port
  fi
}

# ═══════════════════════════════════════════════════════════════════════════
# designmatch v2 — REGENERATE pipeline (regenerate, don't retrofit)
# ═══════════════════════════════════════════════════════════════════════════
# Flow (per the v2 spec):
#   changed? → quarantine old → generate fresh (seam) → migrate → DUAL-GATE → release
#
#   a. hash-log `changed <Screen> <canonical>`: exit 1 (unchanged) ⇒ NO-OP (never
#      churn an unmoved design). Only exit 0 (changed/new) proceeds.
#   b. QUARANTINE the old component FIRST: MOVE (never delete) to
#      .designmatch/tmp/<Screen>.<ts>/ + a manifest (what/why/when). The old file
#      is the SOLE behavior source — it must survive until migration is PROVEN.
#   c. GENERATE a fresh component in the target language (RN) from the canonical
#      via the language seam — a NEW file, never by editing the old.
#   d. MIGRATE behavior (handlers/state/API/nav/effects/props) from the
#      quarantined old into the fresh. (Migration is agent/structured-port; the
#      GATE below is what proves it — this pipeline does NOT fake it.)
#   e. DUAL-GATE: the old file leaves tmp ONLY when BOTH pass —
#        (visual)     existing SSIM≥0.95 OR pixelDiff≤5% harness, AND
#        (behavioral) behavioral-diff K==0 with HONEST coverage (low-confidence
#                     parse never yields a false green).
#      On pass: release (rm from tmp) + hash-log `record` (advance gate + stamp
#      provenance). NEVER release on visual-alone.
#
# Helpers below keep every path GUARDED and every exit code CAPTURED (landmine-
# clean). The regen funcs take explicit flags so the deterministic test can drive
# the whole pipeline without a live RN app / emulator.

# Resolve the per-app .designmatch dir (default: <app-dir>/.designmatch).
regen_designmatch_dir() {
  local app_dir="$1"
  echo "$app_dir/.designmatch"
}

# Quarantine the old component: MOVE it (never delete) into a timestamped tmp
# holding dir, and write a manifest of what/why/when. Echoes the tmp dir path on
# stdout. The old file MUST be gone from its original place afterwards (moved) and
# present under tmp (recoverable).
regen_quarantine() {
  # regen_quarantine <dm_dir> <screen> <old_file> <canonical> <reason>
  local dm_dir="$1" screen="$2" old_file="$3" canonical="$4" reason="$5"
  local ts; ts=$(date -u +"%Y%m%dT%H%M%SZ")
  local tmp_dir="$dm_dir/tmp/$screen.$ts"
  mkdir -p "$tmp_dir"

  local base; base=$(basename "$old_file")
  local dest="$tmp_dir/$base"
  # MOVE — the cardinal rule. Never `rm` the old file here.
  mv "$old_file" "$dest"

  local now; now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  cat > "$tmp_dir/manifest.json" <<JSON
{
  "screen": "$screen",
  "quarantined_file": "$base",
  "original_path": "$old_file",
  "canonical_path": "$canonical",
  "reason": "$reason",
  "quarantined_at": "$now",
  "released": false,
  "dual_gate": { "visual": null, "behavioral": null }
}
JSON

  # Append a per-app quarantine ledger line (jsonl) so multiple screens accrue an
  # auditable trail of what is/was quarantined and why.
  mkdir -p "$dm_dir/tmp"
  printf '{"screen":"%s","tmp_dir":"%s","original_path":"%s","reason":"%s","quarantined_at":"%s"}\n' \
    "$screen" "$tmp_dir" "$old_file" "$reason" "$now" >> "$dm_dir/tmp/manifest.jsonl"

  echo "$tmp_dir"
}

# Update a key in a quarantine manifest.json (visual/behavioral verdict, release).
regen_manifest_set() {
  # regen_manifest_set <manifest.json> <jq-style python kv assignment script>
  local manifest="$1" pyset="$2"
  command -v python3 >/dev/null || return 0
  python3 - "$manifest" "$pyset" <<'PY' 2>/dev/null || true
import json, sys
path, expr = sys.argv[1], sys.argv[2]
try:
    with open(path) as fh:
        m = json.load(fh)
except Exception:
    sys.exit(0)
# expr is "a.b=value" lines separated by ';'
for assign in expr.split(";"):
    assign = assign.strip()
    if not assign or "=" not in assign:
        continue
    key, val = assign.split("=", 1)
    val = val.strip()
    if val == "true":
        v = True
    elif val == "false":
        v = False
    elif val == "null":
        v = None
    else:
        try:
            v = json.loads(val)
        except Exception:
            v = val
    node = m
    parts = key.strip().split(".")
    for p in parts[:-1]:
        node = node.setdefault(p, {})
    node[parts[-1]] = v
with open(path, "w") as fh:
    json.dump(m, fh, indent=2)
PY
}

# VISUAL half of the dual-gate. Reuses the EXISTING visual-diff harness
# ($SCRIPT_DIFF / skills/designmatch/scripts/visual-diff.js: SSIM≥0.95 OR
# pixelDiff≤5%). Returns 0 = visual pass, 1 = visual fail.
#   --canonical-png/--native-png → real harness run (exit code is the verdict).
#   --visual-result pass|fail    → inject the verdict (deterministic test seam;
#                                  the harness's own metrics.json `pass` is the
#                                  contract being injected — the behavioral gate
#                                  is NEVER injected, it is always real).
regen_visual_gate() {
  # regen_visual_gate <canonical_png> <native_png> <out_dir> <inject>
  local canonical_png="$1" native_png="$2" out_dir="$3" inject="$4"

  if [ -n "$inject" ]; then
    case "$inject" in
      pass) info "visual gate: injected PASS (test seam — harness contract: SSIM≥0.95 OR pixelDiff≤5%)"; return 0 ;;
      fail) info "visual gate: injected FAIL (test seam)"; return 1 ;;
      *) die "invalid --visual-result: $inject (want pass|fail)" ;;
    esac
  fi

  command -v node >/dev/null || die "node required for the visual gate (visual-diff harness)"
  [ -f "$SCRIPT_DIFF" ] || die "missing visual harness: $SCRIPT_DIFF"
  [ -f "$canonical_png" ] || die "visual gate: canonical png not found: $canonical_png"
  [ -f "$native_png" ] || die "visual gate: native png not found: $native_png"
  mkdir -p "$out_dir"

  # Capture the harness exit code (0=pass, 1=fail) without aborting under set -e.
  set +e
  node "$SCRIPT_DIFF" --canonical "$canonical_png" --native "$native_png" --out-dir "$out_dir" >/dev/null 2>&1
  local rc=$?
  set -e
  return "$rc"
}

# BEHAVIORAL half of the dual-gate — ALWAYS REAL (never injected). Runs the merged
# behavioral-diff over (quarantined-old, migrated-new): K==0 to pass, AND honest
# coverage (a low-confidence parse is NOT a confident green → blocked/warned).
# Echoes the record JSON on stdout (caller surfaces coverage). Returns:
#   0 = behavioral pass (K==0 and confident),  1 = blocked (K>0 OR low-confidence).
regen_behavioral_gate() {
  # regen_behavioral_gate <old_file> <new_file>  (echoes record JSON; rc 0/1)
  local old_file="$1" new_file="$2"
  [ -x "$BIN_BEHAVIORAL_DIFF" ] || { echo "designmatch: behavioral-diff CLI missing at $BIN_BEHAVIORAL_DIFF" >&2; return 1; }

  set +e
  local record
  record="$("$BIN_BEHAVIORAL_DIFF" "$old_file" "$new_file" --quiet)"
  local bd_rc=$?
  set -e

  # bd_rc: 0 clean (K==0), 3 blocked (K>0), 2 usage. Map usage to blocked.
  printf '%s\n' "$record"

  if [ "$bd_rc" -eq 2 ]; then
    echo "designmatch: behavioral-diff usage error" >&2
    return 1
  fi

  # Honest coverage: a low-confidence parse is a FALSE GREEN if we let K==0 pass.
  # Block on low_confidence even when K==0.
  local low_conf="false"
  if command -v python3 >/dev/null; then
    low_conf="$(printf '%s' "$record" | python3 -c 'import json,sys
try:
    r=json.load(sys.stdin)
    print("true" if r.get("low_confidence") else "false")
except Exception:
    print("true")' 2>/dev/null || echo "true")"
  fi

  if [ "$bd_rc" -eq 0 ] && [ "$low_conf" = "false" ]; then
    return 0
  fi
  return 1
}

# Surface the behavioral record's coverage honestly to the user.
regen_print_coverage() {
  # regen_print_coverage <record-json>
  local record="$1"
  command -v python3 >/dev/null || { echo "$record"; return 0; }
  printf '%s' "$record" | python3 -c 'import json,sys
try:
    r=json.load(sys.stdin)
except Exception:
    print("coverage: <unparseable behavioral record>"); sys.exit(0)
print("coverage: %d/%d behavioral units present-and-wired (%.1f%%); K=%d unmatched; backend=%s; parse_confidence=%.3f%s" % (
    r.get("present_and_wired",0), r.get("extracted",0), r.get("coverage_pct",0.0),
    r.get("unmatched",0), r.get("backend","?"), r.get("parse_confidence",0.0),
    "  [LOW-CONFIDENCE — not a confident green]" if r.get("low_confidence") else ""))
for u in r.get("unmatched_units", []):
    print("  UNMATCHED %s:%s — %s" % (u.get("category"), u.get("key"), u.get("reason")))' 2>/dev/null || echo "$record"
}

# The dual-gate decision + release. The old file (under tmp) leaves tmp ONLY when
# BOTH the visual gate AND the behavioral gate pass. On pass: rm the quarantined
# old file (release), mark the manifest released, and hash-log `record` to advance
# the gate + stamp provenance. On any fail: the old file STAYS in tmp (recoverable).
regen_dual_gate_release() {
  # regen_dual_gate_release <ledger> <screen> <canonical> <new_path> <tmp_dir> \
  #                         <old_in_tmp> <visual_rc> <behavioral_rc>
  local ledger="$1" screen="$2" canonical="$3" new_path="$4" tmp_dir="$5"
  local old_in_tmp="$6" visual_rc="$7" behavioral_rc="$8"
  local manifest="$tmp_dir/manifest.json"

  regen_manifest_set "$manifest" \
    "dual_gate.visual=$([ "$visual_rc" -eq 0 ] && echo true || echo false);dual_gate.behavioral=$([ "$behavioral_rc" -eq 0 ] && echo true || echo false)"

  if [ "$visual_rc" -ne 0 ] || [ "$behavioral_rc" -ne 0 ]; then
    local why=""
    [ "$visual_rc" -ne 0 ] && why="visual"
    [ "$behavioral_rc" -ne 0 ] && why="${why:+$why+}behavioral"
    echo "$(red "✗") dual-gate BLOCKED ($why failed) — old file STAYS in tmp (recoverable): $old_in_tmp" >&2
    info "fix the migration, then re-run \`designmatch regen-gate $screen\` to re-evaluate"
    return 1
  fi

  # BOTH passed → release the old file from tmp. It is no longer the sole behavior
  # source (the migration is proven), so removing it now is safe.
  rm -f "$old_in_tmp"
  regen_manifest_set "$manifest" "released=true"
  ok "dual-gate PASSED (visual ✓ + behavioral ✓) — old file released from tmp: $old_in_tmp"

  # Advance the change-detection gate + stamp provenance.
  set +e
  "$BIN_REGEN_LOG" --ledger "$ledger" record "$screen" "$canonical" "$new_path" >/dev/null 2>&1
  local rec_rc=$?
  set -e
  if [ "$rec_rc" -eq 0 ]; then
    ok "hash-log recorded provenance: $screen ← $(basename "$canonical") → $new_path"
  else
    echo "$(red "!") hash-log record failed (rc=$rec_rc) — gate not advanced" >&2
    return 1
  fi
  return 0
}

# regen-gate — run JUST the dual-gate over an already-quarantined old + a migrated
# new component (used after the migration step, or to re-evaluate a previously
# blocked screen). The old file is found inside its tmp dir.
cmd_regen_gate() {
  local screen="" app_dir="$PWD" ledger="" canonical="" tmp_dir="" migrated=""
  local canonical_png="" native_png="" visual_inject=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-dir)        app_dir="$2"; shift 2 ;;
      --ledger)         ledger="$2"; shift 2 ;;
      --canonical)      canonical="$2"; shift 2 ;;
      --tmp-dir)        tmp_dir="$2"; shift 2 ;;
      --migrated)       migrated="$2"; shift 2 ;;
      --canonical-png)  canonical_png="$2"; shift 2 ;;
      --native-png)     native_png="$2"; shift 2 ;;
      --visual-result)  visual_inject="$2"; shift 2 ;;
      -*) die "unknown flag: $1" ;;
      *)  [ -z "$screen" ] && { screen="$1"; shift; } || die "unexpected arg: $1" ;;
    esac
  done
  [ -n "$screen" ] || die "regen-gate requires <Screen>"
  app_dir="$(cd "$app_dir" && pwd)"
  local dm_dir; dm_dir="$(regen_designmatch_dir "$app_dir")"
  [ -n "$ledger" ] || ledger="$dm_dir/regen-log.json"

  # Resolve tmp_dir: explicit, else the most recent for this screen.
  if [ -z "$tmp_dir" ]; then
    tmp_dir="$(find "$dm_dir/tmp" -maxdepth 1 -type d -name "$screen.*" 2>/dev/null | sort | tail -1 || true)"
  fi
  [ -n "$tmp_dir" ] && [ -d "$tmp_dir" ] || die "no quarantine tmp dir for screen \"$screen\" under $dm_dir/tmp"
  local manifest="$tmp_dir/manifest.json"
  [ -f "$manifest" ] || die "no manifest in $tmp_dir"

  # The quarantined old file = the non-manifest file in tmp_dir.
  local old_in_tmp
  old_in_tmp="$(find "$tmp_dir" -maxdepth 1 -type f ! -name 'manifest.json' 2>/dev/null | head -1 || true)"
  [ -n "$old_in_tmp" ] && [ -f "$old_in_tmp" ] \
    || die "no quarantined old file in $tmp_dir (already released? — old file is gone, gate cannot re-run)"

  [ -n "$migrated" ] || die "regen-gate requires --migrated <file> (the migrated new component to verify)"
  [ -f "$migrated" ] || die "migrated component not found: $migrated"
  [ -n "$canonical" ] || canonical="$(python3 -c "import json;print(json.load(open('$manifest')).get('canonical_path',''))" 2>/dev/null || true)"

  _regen_run_dual_gate "$ledger" "$screen" "$canonical" "$migrated" "$tmp_dir" "$old_in_tmp" \
    "$canonical_png" "$native_png" "$visual_inject"
}

# Shared dual-gate driver: runs behavioral (real) + visual (real or injected),
# prints honest coverage, then releases-or-blocks. Returns the dual-gate rc.
_regen_run_dual_gate() {
  local ledger="$1" screen="$2" canonical="$3" migrated="$4" tmp_dir="$5" old_in_tmp="$6"
  local canonical_png="$7" native_png="$8" visual_inject="$9"

  info "behavioral gate (REAL): behavioral-diff over (quarantined-old, migrated-new)"
  set +e
  local record
  record="$(regen_behavioral_gate "$old_in_tmp" "$migrated")"
  local behavioral_rc=$?
  set -e
  # The record JSON is the last line group; surface coverage honestly.
  regen_print_coverage "$record"

  info "visual gate: existing SSIM/pixelmatch harness (reused)"
  set +e
  regen_visual_gate "$canonical_png" "$native_png" "$tmp_dir/visual" "$visual_inject"
  local visual_rc=$?
  set -e

  set +e
  regen_dual_gate_release "$ledger" "$screen" "$canonical" "$migrated" "$tmp_dir" \
    "$old_in_tmp" "$visual_rc" "$behavioral_rc"
  local gate_rc=$?
  set -e
  return "$gate_rc"
}

# regen — the full per-screen pipeline: changed? → quarantine → generate → (migrate)
# → dual-gate → release. Flags let the deterministic test drive it end-to-end.
cmd_regen() {
  local screen="" app_dir="$PWD" ledger="" canonical="" old="" out="" target="rn"
  local migrated="" canonical_png="" native_png="" visual_inject="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-dir)        app_dir="$2"; shift 2 ;;
      --ledger)         ledger="$2"; shift 2 ;;
      --canonical)      canonical="$2"; shift 2 ;;
      --old)            old="$2"; shift 2 ;;
      --out)            out="$2"; shift 2 ;;
      --target)         target="$2"; shift 2 ;;
      --migrated)       migrated="$2"; shift 2 ;;
      --canonical-png)  canonical_png="$2"; shift 2 ;;
      --native-png)     native_png="$2"; shift 2 ;;
      --visual-result)  visual_inject="$2"; shift 2 ;;
      --force)          force=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *)  [ -z "$screen" ] && { screen="$1"; shift; } || die "unexpected arg: $1" ;;
    esac
  done
  [ -n "$screen" ] || die "regen requires <Screen>. Run \`designmatch help\`."
  app_dir="$(cd "$app_dir" && pwd)"
  local dm_dir; dm_dir="$(regen_designmatch_dir "$app_dir")"
  mkdir -p "$dm_dir"
  [ -n "$ledger" ] || ledger="$dm_dir/regen-log.json"
  [ -n "$canonical" ] || die "regen requires --canonical <file> (the design source of record)"
  [ -f "$canonical" ] || die "canonical not found: $canonical"

  # a. CHANGE DETECTION — hash-log gate. exit 1 (unchanged) ⇒ NO-OP.
  set +e
  local changed_out
  changed_out="$("$BIN_REGEN_LOG" --ledger "$ledger" changed "$screen" "$canonical" 2>&1)"
  local changed_rc=$?
  set -e
  if [ "$changed_rc" -eq 1 ] && [ "$force" -eq 0 ]; then
    ok "no-op: $screen design unchanged (hash-log) — NOT regenerating (no churn)"
    return 0
  elif [ "$changed_rc" -ne 0 ] && [ "$changed_rc" -ne 1 ]; then
    die "hash-log changed failed (rc=$changed_rc): $changed_out"
  fi
  info "$screen design CHANGED (or new) → regenerating"

  # b. QUARANTINE the old component FIRST (move, never delete) — if one exists.
  local tmp_dir="" old_in_tmp=""
  if [ -n "$old" ] && [ -f "$old" ]; then
    tmp_dir="$(regen_quarantine "$dm_dir" "$screen" "$old" "$canonical" "regenerated from changed canonical $(basename "$canonical")")"
    old_in_tmp="$(find "$tmp_dir" -maxdepth 1 -type f ! -name 'manifest.json' 2>/dev/null | head -1)"
    ok "quarantined old component → $old_in_tmp (MOVED, not deleted — recoverable)"
  else
    info "no existing old component (--old) — fresh screen, nothing to quarantine"
  fi

  # c. GENERATE fresh in the target language (RN) from the canonical via the seam.
  [ -n "$out" ] || out="$app_dir/src/screens/$screen.$("$BIN_TARGET" ext "$target")"
  mkdir -p "$(dirname "$out")"
  set +e
  "$BIN_TARGET" generate "$target" "$screen" "$canonical" --out "$out" 2>/dev/null
  local gen_rc=$?
  set -e
  [ "$gen_rc" -eq 0 ] || die "generate failed (target=$target, rc=$gen_rc)"
  ok "generated fresh $target component (behavior-free) → $out"

  # d. MIGRATE — re-attach behavior from the quarantined old into the fresh. The
  # migration mechanism is agent/structured-port and produces a migrated file; the
  # pipeline does NOT fake it. If a migrated file is supplied (--migrated), we
  # proceed straight to the dual-gate against it; otherwise we stop here and hand
  # off to the migration step (the old file stays safely in tmp meanwhile).
  if [ -z "$migrated" ]; then
    info "migration step: port handlers/state/API/nav/effects/props from the quarantined"
    info "old into $out, then run: designmatch regen-gate $screen --migrated <file> ..."
    if [ -n "$old_in_tmp" ]; then
      info "old (behavior source) recoverable at: $old_in_tmp — STAYS until dual-gate passes"
    fi
    return 0
  fi
  [ -f "$migrated" ] || die "migrated component not found: $migrated"

  # e. DUAL-GATE → release. Old file leaves tmp ONLY on visual AND behavioral pass.
  if [ -z "$old_in_tmp" ]; then
    # Fresh screen with no prior behavior: nothing to gate against / release. Just
    # record provenance so the gate advances.
    set +e
    "$BIN_REGEN_LOG" --ledger "$ledger" record "$screen" "$canonical" "$migrated" >/dev/null 2>&1
    set -e
    ok "fresh screen finalized + provenance recorded (no old component to gate)"
    return 0
  fi

  _regen_run_dual_gate "$ledger" "$screen" "$canonical" "$migrated" "$tmp_dir" "$old_in_tmp" \
    "$canonical_png" "$native_png" "$visual_inject"
}

# regen-all — regenerate every screen whose design changed. Pairs each canonical
# with its old component + migrated component by NAME convention under app-dir
# (canonical: .designmatch/canonical/<Screen>.canonical.jsx; old:
# src/screens/<Screen>.tsx). Unchanged screens are no-ops (hash-log gates each).
cmd_regen_all() {
  local app_dir="$PWD" ledger="" target="rn" visual_inject=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-dir)       app_dir="$2"; shift 2 ;;
      --ledger)        ledger="$2"; shift 2 ;;
      --target)        target="$2"; shift 2 ;;
      --visual-result) visual_inject="$2"; shift 2 ;;
      -*) die "unknown flag: $1" ;;
      *) die "unexpected arg: $1" ;;
    esac
  done
  app_dir="$(cd "$app_dir" && pwd)"
  local dm_dir; dm_dir="$(regen_designmatch_dir "$app_dir")"
  local canon_dir="$dm_dir/canonical"
  [ -d "$canon_dir" ] || die "no canonical dir: $canon_dir"

  local canons
  canons=$(find "$canon_dir" -maxdepth 2 -type f \( -iname '*.canonical.jsx' -o -iname '*.canonical.tsx' \) 2>/dev/null || true)
  [ -n "$canons" ] || die "no canonicals (*.canonical.jsx) under $canon_dir"

  local count=0 noop=0
  while IFS= read -r canon; do
    [ -n "$canon" ] || continue
    local base name
    base=$(basename "$canon")
    name="${base%.canonical.*}"
    local old="$app_dir/src/screens/$name.tsx"
    local regen_args=("$name" --app-dir "$app_dir" --canonical "$canon" --target "$target")
    [ -n "$ledger" ] && regen_args+=(--ledger "$ledger")
    [ -f "$old" ] && regen_args+=(--old "$old")
    [ -n "$visual_inject" ] && regen_args+=(--visual-result "$visual_inject")
    info "regen-all: $name"
    set +e
    cmd_regen "${regen_args[@]}"
    set -e
    count=$((count + 1))
  done <<< "$canons"
  ok "regen-all: processed $count screen(s) (unchanged screens were no-ops via the hash-log)"
}

# ═══════════════════════════════════════════════════════════════════════════
# designmatch WEB — device-free candidate capture + parity-score receipt + CI gate
# ═══════════════════════════════════════════════════════════════════════════
# Kills the setup wall: the candidate no longer needs a real device (adb/xcrun).
# Both canonical and candidate are Playwright-rendered HTML, diffed by the EXISTING
# SSIM/pixelmatch harness (unchanged math + triptych compositor), and the result
# is stamped as a drop-in receipt. Every number is real; a run that cannot compute
# a real parity SKIPS honestly and writes nothing (never a fabricated pass).

# Do the visual-diff harness deps (pixelmatch/pngjs/ssim.js/sharp) resolve from
# the scripts dir? They are only needed to COMPUTE parity — absence → honest skip.
web_visual_deps_ok() {
  command -v node >/dev/null 2>&1 || return 1
  ( cd "$SKILL_DIR/scripts" && node -e "require('pixelmatch');require('pngjs');require('ssim.js');require('sharp')" >/dev/null 2>&1 )
}

cmd_web() {
  local screen="" app_dir="$PWD" canonical="" candidate_url="" candidate_html=""
  local candidate_png="" canonical_png="" state="" out_dir="" min="0.95" wait=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-dir)        app_dir="$2"; shift 2 ;;
      --canonical)      canonical="$2"; shift 2 ;;
      --candidate-url)  candidate_url="$2"; shift 2 ;;
      --candidate-html) candidate_html="$2"; shift 2 ;;
      --candidate-png)  candidate_png="$2"; shift 2 ;;
      --canonical-png)  canonical_png="$2"; shift 2 ;;
      --state)          state="$2"; shift 2 ;;
      --out-dir)        out_dir="$2"; shift 2 ;;
      --min)            min="$2"; shift 2 ;;
      --wait)           wait="$2"; shift 2 ;;
      -*) die "unknown flag: $1" ;;
      *)  [ -z "$screen" ] && { screen="$1"; shift; } || die "unexpected arg: $1" ;;
    esac
  done
  [ -n "$screen" ] || die "web requires <Screen>. Run \`designmatch help\`."
  app_dir="$(cd "$app_dir" && pwd)"
  local dm_dir="$app_dir/.designmatch"
  [ -n "$out_dir" ] || out_dir="$dm_dir/$screen"
  mkdir -p "$out_dir" "$dm_dir"

  command -v node >/dev/null || die "node required for the web path"

  # A candidate source is mandatory — this is what replaces the device screenshot.
  if [ -z "$candidate_png" ] && [ -z "$candidate_url" ] && [ -z "$candidate_html" ]; then
    die "web requires a candidate: --candidate-url <url> | --candidate-html <file> | --candidate-png <png>"
  fi

  # Resolve the CANONICAL png (render from HTML unless a png is supplied).
  local canonical_png_final="$out_dir/canonical.png"
  if [ -n "$canonical_png" ]; then
    [ -f "$canonical_png" ] || die "canonical png not found: $canonical_png"
    canonical_png_final="$canonical_png"
  else
    [ -n "$canonical" ] || die "web requires --canonical <App.html> (or --canonical-png <png>)"
    [ -f "$canonical" ] || die "canonical not found: $canonical"
    [ -f "$SCRIPT_RENDER" ] || die "missing $SCRIPT_RENDER"
    local state_file="$state"
    if [ -z "$state_file" ]; then
      state_file="$out_dir/state.web.json"
      default_state_json > "$state_file"
    fi
    info "rendering canonical (Playwright, device-free)"
    if ! node "$SCRIPT_RENDER" --html "$canonical" --state "$state_file" --screen "$screen" --out "$canonical_png_final" >/dev/null 2>&1; then
      echo "$(red "!") canonical render SKIPPED — Playwright unavailable or render failed."
      info "install-hint: npm i playwright   (then re-run) — no parity fabricated"
      return 0
    fi
  fi

  # Resolve the CANDIDATE png (render from URL/HTML unless a png is supplied).
  local candidate_png_final="$out_dir/candidate.png"
  if [ -n "$candidate_png" ]; then
    [ -f "$candidate_png" ] || die "candidate png not found: $candidate_png"
    candidate_png_final="$candidate_png"
  else
    [ -f "$SCRIPT_RENDER_WEB" ] || die "missing $SCRIPT_RENDER_WEB"
    local rw_args=(--out "$candidate_png_final" --screen "$screen")
    [ -n "$state" ] && rw_args+=(--state "$state")
    [ -n "$wait" ] && rw_args+=(--wait "$wait")
    if [ -n "$candidate_url" ]; then
      rw_args+=(--url "$candidate_url")
    else
      rw_args+=(--html "$candidate_html")
    fi
    info "rendering candidate (Playwright, no adb/xcrun)"
    if ! node "$SCRIPT_RENDER_WEB" "${rw_args[@]}" >/dev/null 2>&1; then
      echo "$(red "!") candidate render SKIPPED — Playwright unavailable or render failed."
      info "install-hint: npm i playwright   (then re-run) — no parity fabricated"
      return 0
    fi
  fi

  # Parity computation needs the SSIM/pixelmatch harness deps. Absent → honest
  # skip: clear install hint, NO parity.json written (never a fabricated pass).
  if ! web_visual_deps_ok; then
    echo "$(red "!") parity computation SKIPPED — visual harness deps missing."
    info "install-hint: npm i pixelmatch pngjs ssim.js sharp   (then re-run)"
    info "candidate + canonical PNGs are at: $out_dir (no parity.json fabricated)"
    return 0
  fi

  # Diff with the EXISTING harness (unchanged math + triptych compositor).
  [ -f "$SCRIPT_DIFF" ] || die "missing visual harness: $SCRIPT_DIFF"
  set +e
  node "$SCRIPT_DIFF" --canonical "$canonical_png_final" --native "$candidate_png_final" --out-dir "$out_dir" >/dev/null 2>&1
  local diff_rc=$?
  set -e
  [ -f "$out_dir/metrics.json" ] || die "visual harness produced no metrics.json (rc=$diff_rc)"

  # Emit the receipt from the REAL metrics (parity.json + badge + triptych link).
  [ -f "$SCRIPT_EMIT_PARITY" ] || die "missing $SCRIPT_EMIT_PARITY"
  node "$SCRIPT_EMIT_PARITY" --metrics "$out_dir/metrics.json" --out-dir "$dm_dir" \
    --screen "$screen" --min "$min" --triptych "$out_dir/composite.png" \
    || die "emit-parity failed"

  ok "parity receipt: $dm_dir/parity.json + $dm_dir/parity-badge.svg"
  info "triptych: $out_dir/composite.png"
  return 0
}

# designmatch ci — the CI gate over the parity receipt. Reads .designmatch/
# parity.json and BLOCKS (nonzero) when SSIM parity < --min, PASSES (0) above,
# and HONEST-SKIPS (0) when there is no receipt to gate (never fabricates one).
cmd_ci() {
  local app_dir="$PWD" min="0.95" parity=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --app-dir) app_dir="$2"; shift 2 ;;
      --min)     min="$2"; shift 2 ;;
      --parity)  parity="$2"; shift 2 ;;
      -*) die "unknown flag: $1" ;;
      *) die "unexpected arg: $1" ;;
    esac
  done
  app_dir="$(cd "$app_dir" && pwd)"
  [ -n "$parity" ] || parity="$app_dir/.designmatch/parity.json"

  command -v python3 >/dev/null || die "python3 required to read the parity receipt"

  if [ ! -f "$parity" ]; then
    echo "$(cyan "▸") designmatch ci: no parity receipt at $parity — nothing to gate. SKIPPED."
    info "run \`designmatch web <Screen> ...\` first to produce a parity.json (no pass fabricated)."
    return 0
  fi

  local ssim
  ssim=$(python3 -c "import json; print(json.load(open('$parity')).get('ssim',''))" 2>/dev/null || echo "")
  [ -n "$ssim" ] || die "parity receipt has no ssim: $parity"

  local verdict parity_pct min_pct
  verdict=$(python3 -c "print('pass' if float('$ssim')>=float('$min') else 'fail')" 2>/dev/null || echo "err")
  parity_pct=$(python3 -c "print(round(float('$ssim')*100))" 2>/dev/null || echo "?")
  min_pct=$(python3 -c "print(round(float('$min')*100))" 2>/dev/null || echo "?")

  if [ "$verdict" = "pass" ]; then
    ok "design parity OK: ${parity_pct}% ≥ ${min_pct}% (SSIM) — $parity"
    return 0
  elif [ "$verdict" = "fail" ]; then
    echo "$(red "✗") PR blocked: ${parity_pct}% parity < ${min_pct}% — design parity below the CI gate ($parity)" >&2
    exit 1
  else
    die "could not evaluate parity verdict (ssim=$ssim min=$min)"
  fi
}

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift || true
  case "$cmd" in
    init)          cmd_init "$@" ;;
    wire)          cmd_wire "$@" ;;
    fetch)         cmd_fetch "$@" ;;
    port)          cmd_port "$@" ;;
    port-all)      cmd_port_all "$@" ;;
    render)        cmd_render "$@" ;;
    diff)          cmd_diff "$@" ;;
    iterate)       cmd_iterate "$@" ;;
    web)           cmd_web "$@" ;;
    ci)            cmd_ci "$@" ;;
    regen)         cmd_regen "$@" ;;
    regen-all)     cmd_regen_all "$@" ;;
    regen-gate)    cmd_regen_gate "$@" ;;
    action-types)  cmd_action_types ;;
    help|-h|--help) usage ;;
    *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
  esac
}

main "$@"
