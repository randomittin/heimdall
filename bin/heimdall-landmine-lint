#!/usr/bin/env bash
# heimdall-landmine-lint — strict-mode shell landmine detector (FAILS CLOSED).
#
# Across the v2.0.x launch, a recurring class of silent-failure bugs bit
# Heimdall's own shell scripts: strict-mode (`set -euo pipefail`) semantics
# interacting with an edge case to fail invisibly. Each was caught by a harness
# assertion AFTER it bit a stranger. This linter catches the CLASS at the gate,
# so the NEXT one fails the push instead of freezing a stranger's terminal.
#
# It is the shell analogue of the gitleaks self-scan: a blocking pre-push check
# over Heimdall's OWN scripts. It is wired into bin/heimdall-selfscan, so a
# landmine fails `git push` exactly the way a leaked secret does.
#
# Scope (resolved RELATIVE to the repo top — no baked paths, dogfooding class 3):
#   bin/heimdall, bin/heimdall-*, install.sh, hooks/*.sh, release/*.sh
#
# Landmine classes (each finding prints  file:line  CLASS  snippet  → fix-hint):
#   1 SIGPIPE        a terminal `| head`/`| head -c N` inside $(...)/assignment,
#                    in a set -e/pipefail script, WITHOUT a trailing `|| true`
#                    (or `|| echo …`) guard. The demo-abort class.
#   2 UNGUARDED-VAR  the same-line `local a="$1" b="$a/…"` trap (RHS expanded
#                    before the local exists → unbound under set -u). High
#                    confidence only; class 2 is best-effort by design.
#   3 BAKED-PATH     a machine-specific absolute literal (/Users/<u>, /home/<u>,
#                    bare /superx) in code — breaks relocation.
#   4 TTY-READ       an interactive PROMPT `read` (`read -p`, `read -rt N -p`, a
#                    bare `read VAR` soliciting a human answer) from inherited
#                    stdin with no `[ -t 0 ]` TTY guard and no `--yes`/-y refusal
#                    gate. A `-t N` TIMEOUT is NOT a sufficient guard — a 60s
#                    stall PER CALL is still a non-TTY hang in spirit and blocks
#                    CI. The uninstall-hang AND F1-launcher-persona class.
#   5 ORDER-DESTROY  a `_heimdall_remove_plugin`-style self-deletion followed by a
#                    `source`/`.` of a file under the just-deleted tree. Heuristic;
#                    documented known-hard (see README block below).
#
# Classes 2 and 5 are intentionally HIGH-CONFIDENCE-ONLY: a noisy linter gets
# disabled and is worse than none. We prefer under-flagging on 2/5 (with the
# limits documented here) over false positives on the already-guarded tree.
#
# Exit codes:
#   0  clean — no landmine found
#   1  one or more landmines found (details printed to stdout)
#   2  usage / cannot resolve scope
#
# Usage:
#   heimdall-landmine-lint                 scan the repo this script lives in
#   heimdall-landmine-lint --root DIR      scan DIR instead (used by the fixture)
#   heimdall-landmine-lint FILE [FILE…]    scan explicit files (used by the fixture)

set -euo pipefail

# ── Resolve the repo root (RELOCATABLE — no baked path) ───────────────────────
ROOT=""
declare -a EXPLICIT_FILES=()
while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="${2:-}"; shift 2 ;;
    -h|--help)
      sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    --) shift; while [ $# -gt 0 ]; do EXPLICIT_FILES+=("$1"); shift; done ;;
    -*) echo "heimdall-landmine-lint: unknown option: $1" >&2; exit 2 ;;
    *)  EXPLICIT_FILES+=("$1"); shift ;;
  esac
done

if [ "${#EXPLICIT_FILES[@]}" -eq 0 ]; then
  if [ -z "$ROOT" ]; then
    # The scanner lives at <repo>/bin/heimdall-landmine-lint. Resolve <repo> from
    # the script's own location first (works even outside a git checkout), then
    # fall back to the git top. Never bake an absolute path.
    _self="$0"
    case "$_self" in
      */*) : ;;
      *) _self="$(command -v "$_self" 2>/dev/null || echo "$_self")" ;;
    esac
    _bindir="$(cd "$(dirname "$_self")" 2>/dev/null && pwd)"
    ROOT="$(cd "$_bindir/.." 2>/dev/null && pwd)"
    if [ -z "$ROOT" ] || [ ! -d "$ROOT/bin" ]; then
      ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    fi
  fi
  if [ -z "$ROOT" ] || [ ! -d "$ROOT" ]; then
    echo "heimdall-landmine-lint: cannot resolve repo root (pass --root DIR)" >&2
    exit 2
  fi
fi

# ── Build the in-scope file list ──────────────────────────────────────────────
declare -a FILES=()
if [ "${#EXPLICIT_FILES[@]}" -gt 0 ]; then
  FILES=("${EXPLICIT_FILES[@]}")
else
  # bin/heimdall and every bin/heimdall-* component, install.sh, hooks/*.sh,
  # release/*.sh — but NEVER this linter itself (its comments name every pattern
  # it hunts for; scanning itself would be a guaranteed false positive).
  _self_real="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$f" ] || continue
    _f_real="$(cd "$(dirname "$f")" 2>/dev/null && pwd)/$(basename "$f")"
    [ "$_f_real" = "$_self_real" ] && continue
    FILES+=("$f")
  done <<EOF
$( {
    [ -f "$ROOT/bin/heimdall" ] && echo "$ROOT/bin/heimdall"
    for g in "$ROOT"/bin/heimdall-*; do [ -f "$g" ] && echo "$g"; done
    [ -f "$ROOT/install.sh" ] && echo "$ROOT/install.sh"
    for g in "$ROOT"/hooks/*.sh; do [ -f "$g" ] && echo "$g"; done
    for g in "$ROOT"/release/*.sh; do [ -f "$g" ] && echo "$g"; done
  } )
EOF
fi

if [ "${#FILES[@]}" -eq 0 ]; then
  echo "heimdall-landmine-lint: no in-scope files found under ${ROOT:-explicit list}" >&2
  exit 2
fi

# ── Finding accumulator ───────────────────────────────────────────────────────
FINDINGS=0
emit() {
  # emit FILE LINE CLASS SNIPPET FIXHINT
  local file="$1" line="$2" class="$3" snip="$4" hint="$5"
  # Trim the snippet of leading whitespace and clamp length for readability.
  snip="${snip#"${snip%%[![:space:]]*}"}"
  if [ "${#snip}" -gt 90 ]; then snip="${snip:0:87}..."; fi
  printf '%s:%s  %s  %s  → %s\n' "$file" "$line" "$class" "$snip" "$hint"
  FINDINGS=$((FINDINGS + 1))
}

# A line is "code-ish" (worth scanning) when its first non-blank char is not `#`.
# This is a cheap comment filter; it deliberately does NOT try to strip trailing
# inline comments (that needs a real parser) — the per-class matchers are written
# to tolerate that by anchoring on the dangerous construct itself.
is_comment() {
  case "${1#"${1%%[![:space:]]*}"}" in
    '#'*) return 0 ;;
    *)    return 1 ;;
  esac
}

# ── PER-LINE MATCHING IS BASH-NATIVE, NOT `printf | grep` ─────────────────────
# This linter is a BLOCKING pre-push gate: every push pays its full cost, and the
# harness runs it four times (once directly, three times through the pre-push hook).
# It used to match every hot line with `printf '%s' "$line" | grep -qE …`, i.e. two
# fork+exec per test. Over the 38,665 in-scope lines that is ~15,000 processes, and
# at macOS's ~1.5ms fork/exec that WAS the entire runtime: 26s wall-clock solo,
# stretching to 83s when the test board oversubscribes the box under --jobs 6.
#
# `[[ $s =~ $re ]]` uses the SAME POSIX ERE engine (regcomp/regexec) that `grep -E`
# does, on the same single line, with the same `^`/`$` anchoring — so the verdicts
# are identical while the process count drops to zero. Every regex below is the
# verbatim pattern its `grep -qE` used, hoisted to a constant so it is compiled
# from a variable (bash 3.2 requires an UNQUOTED right-hand side for `=~`, and a
# variable is the portable way to spell that).
#
# The `\b`-bearing patterns in scan_unguarded_var were once held back from this treatment on
# the theory that moving them would change a verdict, because BSD sed's `\b` is NOT a word
# boundary (measured: `s/^.*\bdir=//` leaves `local dir="$1" sub="$dir/.heimdall"` untouched —
# BSD reads it as a LITERAL `b`, confirmed by `s/.*\b(local|declare)[[:space:]]+//` turning
# `blocal dir="$1"` into `dir="$1"`). That premise was backwards. `sed -E` and bash's `=~`
# BOTH compile through the platform's libc regcomp, so `\b` means the SAME thing to both on
# any given host — a literal `b` on BSD, a word boundary on glibc. Moving them does not reach
# a DIFFERENT engine; it reaches the SAME engine without the fork. Equivalence is not argued
# from that alone, it is MEASURED: old vs new findings are diffed over the whole shipped tree
# and over a 1106-line corpus of every real `local`/`declare` line in it plus adversarial
# `b`-adjacency shapes, which is the only way a `\b` change could show up.
#
# This block was ~50% of total runtime (35.9s of 71s profiled). It paid ~15 fork/exec PER
# candidate line — one subshell+sed for the body, one per NAME for `after`, one per name for
# `deref`, one grep per name, `sort -u`, plus a heredoc temp file per line — and the tree's
# growth pushed the real-tree scan past the 60s budget the harness enforces.
_RE_SIGPIPE_HEAD='\|[[:space:]]*head([[:space:]]+-[cn][[:space:]]*[0-9]+)?[[:space:]]*(\)|`|;|$)'
_RE_SIGPIPE_GUARD='head[^|]*\|\|[[:space:]]*(true|:|echo)'
_RE_NAME_ASSIGN='[A-Za-z_][A-Za-z0-9_]*='
# The `local`/`declare` keyword plus any short-flag cluster — the prefix the body sed stripped.
_RE_LOCAL_KEYWORD='.*\b(local|declare)[[:space:]]+(-[A-Za-z]+[[:space:]]+)*'
_RE_HOME_LITERAL='/(Users|home)/[A-Za-z][A-Za-z0-9._-]+'
_RE_BARE_SUPERX='(^|[^A-Za-z0-9._/])/superx([/"'"'"' ]|$)'
_RE_DQ_STRING='"[^"]*"'
_RE_SQ_STRING="'[^']*'"
_RE_READ_WORD='(^|[;&|({]|then|else|do)[[:space:]]*read([[:space:]]|$)'
# `local`/`declare` as a COMMAND WORD. The substring test this replaced fired on the
# word "local" inside ordinary prose in a quoted string ("… every worktree and local
# branch is merged …"), which the name/deref walk below then read as a declaration.
# Stripping quoted content instead is NOT an option here: the trap this class exists to
# catch (`local a="$b" b=1`) lives INSIDE a double-quoted RHS, so blanking strings would
# blind the rule. Requiring the keyword to open a command keeps both halves honest.
_RE_LOCAL_WORD='(^|[;&|({]|then|else|do)[[:space:]]*(local|declare)([[:space:]]|$)'
# A heredoc OPENER and the delimiter it names: `<<EOF`, `<<-EOF`, `<<'EOF'`, `<<"EOF"`.
# The `[^<]`/`^` prefix is what keeps `<<<` (a herestring, not a heredoc) out.
_RE_HEREDOC_OPEN="(^|[^<])<<-?[[:space:]]*[\"']?([A-Za-z_][A-Za-z0-9_]*)"
_RE_PROMPT_FLAG='(^|[[:space:]])-[A-Za-z]*p([[:space:]]|$)'
_RE_KEYPRESS_FLAG='(^|[[:space:]])-[A-Za-z]*[sn][A-Za-z0-9]*([[:space:]]|$)'
_RE_TTY_GUARD='\[\[?[[:space:]]+!?[[:space:]]*-t[[:space:]]+0[[:space:]]'
_RE_YES_GATE='(ASSUME_YES|_uyes|--yes|-y)'
_RE_TTY_TEST='(!?[[:space:]]*-t[[:space:]]+0)'
# `\b` is spelled out here ON PURPOSE. macOS `grep -E` honours `\b` as a word
# boundary, but bash's `=~` compiles through libc regcomp, which treats it as a
# literal `b` — so a verbatim '_heimdall_remove_plugin\b' silently stops matching
# and drops the whole class-5 finding. `([^A-Za-z0-9_]|$)` is the boundary the
# preceding word char implies, and it restored the byte-identical finding set.
_RE_REMOVE_PLUGIN='_heimdall_remove_plugin([^A-Za-z0-9_]|$)'
_RE_RM_SELF='rm[[:space:]]+-rf[[:space:]]+"?\$(\{)?(0|PLUGIN_DIR|HEIMDALL_HOME)'
_RE_RM_DOTHEIMDALL='rm[[:space:]]+-rf[[:space:]].*\$HOME/\.heimdall'
_RE_SOURCE_VERB='(^|[;&]|then|do|else)[[:space:]]*(source|\.)[[:space:]]+'
_RE_SOURCE_TARGET='\$(\{)?(PLUGIN_DIR|HEIMDALL_HOME|HOME)|\.heimdall|\$0'

# Delete every match of $2 from $1 without forking sed — `s/RE//g` semantics exactly.
# "Exactly" is load-bearing: sed resumes scanning AFTER each match and never re-reads
# text it has already passed, so the text on either side of a removal is never allowed
# to join up and form a new match. This walks the string the same way, carrying the
# already-scanned prefix in `kept`, because class 2 now feeds it a caller-built pattern
# over arbitrary source rather than only the two quote patterns whose shape used to make
# a restart-from-the-start loop coincidentally equivalent.
# $2 must be UNANCHORED: the seek uses the first LITERAL occurrence of the matched text,
# which is the match position only when an earlier occurrence would itself have matched.
# The result lands in the global STRIPPED rather than on stdout — a `$(…)` capture would
# fork a subshell per line and reintroduce exactly the cost being removed.
STRIPPED=""
strip_matches() {
  local s="$1" re="$2" m kept=""
  while [[ $s =~ $re ]]; do
    m="${BASH_REMATCH[0]}"
    # A zero-width match cannot advance the cursor; sed leaves the remainder verbatim.
    [ -n "$m" ] || break
    kept="$kept${s%%"$m"*}"
    s="${s#*"$m"}"
  done
  STRIPPED="$kept$s"
}

# Does this file run under strict mode (set -e and/or pipefail)? Class 1 only
# bites when the pipeline's nonzero status can abort the script.
file_is_strict() {
  grep -qE '^[[:space:]]*set[[:space:]]+-[a-z]*e[a-z]*' "$1" 2>/dev/null && return 0
  grep -qE '^[[:space:]]*set[[:space:]]+-o[[:space:]]+pipefail' "$1" 2>/dev/null && return 0
  grep -qE '^[[:space:]]*set[[:space:]]+-[a-z]*o[a-z]*[[:space:]]+pipefail' "$1" 2>/dev/null && return 0
  return 1
}

# Returns 0 if the file is a shell script (bash/sh shebang or no shebang), 1 if it is
# a non-shell interpreter (Python, Ruby, Node, Perl) whose syntax doesn't share the
# landmine classes. This prevents false positives on Python files in bin/ that happen
# to contain the word "read" or "/Users/..." in comments or string literals.
file_is_shell() {
  local first; first="$(head -1 "$1" 2>/dev/null || true)"
  case "$first" in
    '#!/'*python*|'#!/'*ruby*|'#!/'*node*|'#!/'*perl*) return 1 ;;
    *) return 0 ;;
  esac
}

# ── CLASS 1 — SIGPIPE: terminal `| head` inside $(...) / assignment, unguarded ─
# The bug: `x="$(… | head -c N)"` in a set -e/pipefail script. `head` closes the
# pipe after N bytes → upstream gets SIGPIPE → nonzero pipeline → set -e aborts.
# We flag only the HIGH-CONFIDENCE shape:
#   * the line contains a command substitution `$(` (or is a bare `x=$(…` assign),
#   * `head` (with or without `-c`/`-n`) is the LAST stage of a pipe on that line
#     (i.e. immediately followed by `)` / EOL / `;` — its downstream closes),
#   * there is NO `|| true` / `|| echo` / `|| :` guard after the head stage.
# A `… | head | sed …` (head not terminal) is NOT flagged: head's downstream
# keeps reading, so no early close at the substitution boundary.
scan_sigpipe() {
  local file="$1" line lineno=0
  file_is_strict "$file" || return 0
  # Fast bail: no command substitution in this file — nothing to scan.
  grep -qE '\$\(|`' "$file" 2>/dev/null || return 0
  while IFS= read -r line; do
    lineno=$((lineno + 1))
    is_comment "$line" && continue
    # Must be inside a command substitution / assignment context.
    case "$line" in
      *'$('*|*'`'*) : ;;
      *) continue ;;
    esac
    # Cheap literal pre-filter: the class is defined by a terminal `head` stage, so
    # a line without the substring `head` can never match the regex below. This is
    # a strict subset test — it removes the regex call for ~97% of lines and cannot
    # change a verdict.
    case "$line" in *head*) : ;; *) continue ;; esac
    # Find a `head` that is the terminal stage of a pipe: `| head [...]` followed
    # only by optional close-paren/backtick/semicolon/whitespace to EOL.
    # head with a byte/line cap is the canonical early-closer.
    if [[ $line =~ $_RE_SIGPIPE_HEAD ]]; then
      # Guarded if a `|| true` / `|| :` / `|| echo` appears AFTER the head stage.
      if [[ $line =~ $_RE_SIGPIPE_GUARD ]]; then
        continue
      fi
      emit "$file" "$lineno" "1-SIGPIPE" "$line" \
        "terminal '| head' in \$(…) under set -e/pipefail closes the pipe → SIGPIPE aborts; append '|| true'"
    fi
  done < "$file"
}

# ── CLASS 2 — UNGUARDED-VAR: same-line local self-reference (set -u trap) ──────
# The bug: `local dir="$1" hooks="$dir/.heimdall"` — bash expands the WHOLE rhs
# of the `local` before any of the names exist, so `$dir` resolves to the OUTER
# scope (or unbound under set -u). High-confidence pattern: a `local`/`declare`
# that assigns a name AND, later on the SAME line, dereferences that same name.
# This is the only class-2 shape we flag (best-effort by design; documented).
scan_unguarded_var() {
  local file="$1" line lineno=0
  # Fast bail: no local/declare in this file.
  grep -qE '\blocal\b|\bdeclare\b' "$file" 2>/dev/null || return 0
  while IFS= read -r line; do
    lineno=$((lineno + 1))
    is_comment "$line" && continue
    # Cheap substring gate first (skips the regex for the vast majority of lines),
    # then the command-word test that decides. Prose containing the word "local"
    # inside a string passes the substring gate and is rejected here.
    case "$line" in
      *local\ *|*declare\ *|*'	'local\ *) : ;;
      *) continue ;;
    esac
    [[ $line =~ $_RE_LOCAL_WORD ]] || continue
    # Cheap literal pre-filter: the emit below requires a `$name` DEREFERENCE, so a
    # declaration line with no `$` on it anywhere cannot produce a finding. Strict
    # subset test — it cannot change a verdict, and it skips the sed/grep pipeline
    # for the majority of `local` lines (plain `local i` / `local a b c` forms).
    case "$line" in *'$'*) : ;; *) continue ;; esac
    # Pull the declaration body after the `local`/`declare` keyword, then TRUNCATE
    # at the first `;` — the `local` statement ends there. Bash expands only the
    # RHS of the local itself before the names exist; a `$name` deref in a LATER
    # statement on the same line (`local x=1; use $x`) is NOT the trap (x already
    # exists by then). Truncating at `;` is what keeps this high-confidence.
    local body
    if [[ $line =~ $_RE_LOCAL_KEYWORD ]]; then
      # `.*` anchors the match at offset 0, so sed's leftmost-longest replacement is a
      # PREFIX removal and `${line#…}` reproduces it byte for byte. No match => sed left
      # the line alone, which on BSD (literal `b`) is the overwhelmingly common case.
      body="${line#"${BASH_REMATCH[0]}"}"
    else
      body="$line"
    fi
    body="${body%%;*}"
    # Collect names assigned in the statement: tokens of the form  NAME=
    # Bash-native equivalent of `grep -oE '[A-Za-z_][A-Za-z0-9_]*=' | sed 's/=$//'`:
    # `=~` yields the LEFTMOST match, and any earlier literal occurrence of that same
    # token would itself have matched earlier — so cutting the scan cursor at the
    # first literal occurrence lands exactly where grep -o's next scan would resume.
    local names raw nm_tok ncount rest
    raw=""; ncount=0; rest="$body"
    while [[ $rest =~ $_RE_NAME_ASSIGN ]]; do
      nm_tok="${BASH_REMATCH[0]}"
      raw="$raw${nm_tok%=}
"
      ncount=$((ncount + 1))
      rest="${rest#*"$nm_tok"}"
    done
    [ "$ncount" -gt 0 ] || continue
    # `sort -u` decided both dedupe AND the order the names are tried in, which picks
    # which name the hint names. Keep the real sort whenever that can matter; a single
    # name sorts to itself, so skip the fork in the overwhelmingly common case.
    if [ "$ncount" -gt 1 ]; then
      names="$(printf '%s' "$raw" | sort -u)"
    else
      names="$raw"
    fi
    [ -n "$names" ] || continue
    # Walk the newline-separated names in-shell. A `while read … <<EOF` heredoc would
    # spill a temp file to disk for EVERY candidate line, which on this tree is over a
    # thousand file creations per scan and four scans per push.
    local nm pending="$names"
    while [ -n "$pending" ]; do
      nm="${pending%%$'\n'*}"
      if [ "$nm" = "$pending" ]; then pending=""; else pending="${pending#*$'\n'}"; fi
      [ -n "$nm" ] || continue
      # The trap fires when `$nm` is dereferenced in the RHS of the SAME local —
      # i.e. AFTER this name's own `nm=` but still inside the local statement.
      # Take the body from this name's assignment to the next assignment and look
      # for a deref of nm there; strip the `nm=` itself so the assignment LHS
      # never counts as a use.
      # `nm` came out of $_RE_NAME_ASSIGN, so it is [A-Za-z_][A-Za-z0-9_]* — no regex
      # metacharacter can reach these patterns from the scanned source.
      local after deref re_after re_deref
      re_after="^.*\\b${nm}="
      if [[ $body =~ $re_after ]]; then
        after="${body#"${BASH_REMATCH[0]}"}"
      else
        after="$body"
      fi
      strip_matches "$after" "\\b${nm}="; deref="$STRIPPED"
      re_deref="\\\$\\{?${nm}([^A-Za-z0-9_]|\\})"
      if [[ $deref =~ $re_deref ]]; then
        emit "$file" "$lineno" "2-UNGUARDED-VAR" "$line" \
          "'\$${nm}' is dereferenced in the same 'local' that declares it (RHS expands before the local exists → unbound under set -u); split into two statements"
        break
      fi
    done
  done < "$file"
}

# ── CLASS 3 — BAKED-PATH: machine-specific absolute literal ───────────────────
# The bug: hardcoded /Users/…, /home/…, or a bare absolute /superx where a
# ${VAR:-default} (or $HOME-relative) path belonged → broke when dirs moved.
# We flag ONLY machine-specific absolutes that pin to a user's home or the old
# product dir. We do NOT flag `$HOME/.heimdall` (relocatable per-user) nor the
# `${HEIMDALL_HOME:-$HOME/.heimdall}` guarded form, and we skip sed/grep DELETE
# patterns that match LEGACY paths for removal (`/\.superx\/bin/d`).
scan_baked_path() {
  local file="$1" line lineno=0
  file_is_shell "$file" || return 0
  # Fast bail: no home-literal or /superx path anywhere in this file.
  grep -qE '/(Users|home)/[A-Za-z]|/superx' "$file" 2>/dev/null || return 0
  while IFS= read -r line; do
    lineno=$((lineno + 1))
    is_comment "$line" && continue
    # Fast pre-filter: skip lines without a path-like substring.
    case "$line" in
      */Users/*|*/home/*|*/superx*) : ;;
      *) continue ;;
    esac
    # Skip lines whose absolute literal lives inside a sed/grep address that is
    # matching a LEGACY path for deletion/substitution (not a path the script
    # depends on). Heuristic: a `/…/d` or `s/…/` sed verb on the line plus the
    # superx token preceded by `.` (i.e. `.superx`, the dotdir, not `/superx`).
    case "$line" in
      *sed\ *|*grep\ *) _is_sed=1 ;;
      *) _is_sed=0 ;;
    esac
    # /Users/<name>/  or  /home/<name>/  — a real per-machine home literal.
    if [[ $line =~ $_RE_HOME_LITERAL ]]; then
      emit "$file" "$lineno" "3-BAKED-PATH" "$line" \
        "machine-specific absolute home literal — use \$HOME or a \${VAR:-default} so the script stays relocatable"
      continue
    fi
    # bare /superx as an ABSOLUTE path segment (not `.superx`, not in a sed
    # delete of a legacy line). The old product root that broke on rename.
    if [[ $line =~ $_RE_BARE_SUPERX ]]; then
      if [ "$_is_sed" = 1 ]; then continue; fi
      emit "$file" "$lineno" "3-BAKED-PATH" "$line" \
        "bare absolute '/superx' (the old product root) — use a \${VAR:-default} relocatable path"
    fi
  done < "$file"
}

# ── CLASS 4 — TTY-READ: interactive PROMPT read with no TTY/--yes guard ────────
# The bug: an interactive PROMPT `read` (`read -p "…?"`, `read -rt 60 -p "…"`, or a
# bare `read VAR` soliciting a human answer) that, on a non-TTY stdin (piped
# install, CI, the F1 launch path), blocks the run. The F1 launcher rewrite added
# `read -rt 60 -p "choose [1/2]…"`; the old class-4 rule SKIPPED any `read -t N`
# as "guarded", so a 60s-stall-per-call prompt sailed through — the exact class
# this rule exists to catch. So:
#   * TIMEOUT IS NOT A GUARD. A `-t N` read still hangs/stalls non-interactively
#     (60s per invocation; in CI it dead-stalls every call). A timeout-only prompt
#     is FLAGGED unless it is also `[ -t 0 ]`-guarded. The ONLY sufficient guards
#     are a `[ -t 0 ]` TTY check or a `--yes`/-y refusal gate around the read.
# Safe forms we must NOT flag (the discriminator: a STREAM/loop read of file/pipe
# content vs an interactive PROMPT read asking a human):
#   * `read … <…` / `read … <<<…` / `read … <<EOF` (reads from a file/herestring),
#   * `… | while … read …` and `done < <(…)` (reads a pipe, never the terminal),
#   * `while IFS= read -r line` frame/stream loops (consume a piped/process-sub
#     stream, never the terminal — bin/heimdall's face-render loops),
#   * a keypress POLL: `read -rsn1 -t … junk` (a `-s`/-n silent/char read with NO
#     `-p` prompt — waits for "any key", does not solicit a typed answer),
#   * a PROMPT read guarded by `[ -t 0 ]` (or a `--yes`/-y refusal) in its scope.
# We flag an interactive PROMPT read (a `-p` flag in any cluster — `-p`/`-rp`/
# `-rt N -p` — OR a bare `read [VAR…]` with no stream redirect and no `-s`/-n
# keypress flags) from INHERITED stdin lacking a `[ -t 0 ]`/`--yes` guard.
scan_tty_read() {
  local file="$1"
  # Skip non-shell files (Python, Ruby, etc.) — their syntax doesn't share the TTY-READ
  # class, and Python comments containing "(read …)" produce false positives.
  file_is_shell "$file" || return 0
  # Fast bail: no 'read' keyword anywhere in this file — nothing to scan.
  grep -qE '\bread\b' "$file" 2>/dev/null || return 0
  local -a lines=()
  local l
  while IFS= read -r l; do lines+=("$l"); done < "$file"
  local n="${#lines[@]}" i
  # Heredoc BODY is data, not code. A usage block (`cat <<EOF … read --subsystem NAME …`)
  # documents a subcommand named `read`; without this the help text is read as an
  # interactive prompt and the push is blocked on a line that never executes.
  local hd_delim="" trimmed
  for (( i=0; i<n; i++ )); do
    line="${lines[$i]}"
    local lineno=$((i + 1))
    if [ -n "$hd_delim" ]; then
      # `<<-` strips leading TABS from the terminator; comparing the trimmed line
      # closes both forms and costs nothing on the plain `<<` case.
      trimmed="${line#"${line%%[![:space:]]*}"}"
      [ "$trimmed" = "$hd_delim" ] && hd_delim=""
      continue
    fi
    if [[ $line =~ $_RE_HEREDOC_OPEN ]]; then
      hd_delim="${BASH_REMATCH[2]}"
    fi
    is_comment "$line" && continue
    # Fast pre-filter: skip lines with no 'read' substring at all. This avoids the
    # sed subprocess for ~95% of lines, the main source of per-file overhead.
    case "$line" in *read*) : ;; *) continue ;; esac
    # Strip double- and single-quoted string CONTENT so the word "read" inside a
    # message ("… read claims first …") is never mistaken for the read command.
    local bare
    strip_matches "$line" "$_RE_DQ_STRING"; bare="$STRIPPED"
    strip_matches "$bare" "$_RE_SQ_STRING"; bare="$STRIPPED"
    # Must contain a `read` command word (start of line or after ;/&&/|| / `(`).
    [[ $bare =~ $_RE_READ_WORD ]] || continue
    # Skip `read` that pulls from a pipe/file/herestring/process-sub (not stdin):
    #   trailing `< …`, `<<< …`, `<<EOF`, or the line is the body of `… | while`.
    case "$bare" in
      *'<<<'*|*'<<'*|*'< '*|*'<('*) continue ;;
      *'<'*) continue ;;
    esac
    # A `read` consuming a pipe: the `while … read` whose stdin is a pipe. If the
    # SAME line has a `|` before the `read`, it is not the terminal-stdin hang.
    case "$bare" in
      *'|'*read*) continue ;;
    esac
    # ── Interactive-PROMPT discriminator ──────────────────────────────────────
    # Only an interactive PROMPT read can wedge a human-answer wait. A `-t N`
    # TIMEOUT is deliberately NOT treated as a guard here (a 60s stall per call is
    # still a non-TTY hang and dead-stalls CI) — the F1 `read -rt 60 -p` is exactly
    # the prompt the old `-t`-skip let through. Two prompt shapes:
    #   (a) a `-p` PROMPT flag in any short-flag cluster — `-p`, `-rp`, `-sp`, and
    #       the F1 `-rt 60 -p` (separate `-p` token). Detected by a `-…p` cluster
    #       token (a `-` then flag letters ending in `p`).
    #   (b) a BARE prompt read — `read VAR` / `read` / `read -r VAR` with no stream
    #       redirect (already filtered above) and no `-s`/-n keypress flags. This
    #       still reads inherited stdin for a typed answer → hangs on a non-TTY.
    # A keypress POLL (`-rsn1`, `-s`, `-n` with NO `-p`) is NOT a prompt: it waits
    # for "any key" (animation-skip), reads into a throwaway, never solicits an
    # answer. We exempt it so the face-render polls in bin/heimdall stay clean.
    _is_prompt=0
    if [[ $bare =~ $_RE_PROMPT_FLAG ]]; then
      _is_prompt=1                                   # (a) explicit -p prompt cluster
    elif [[ $bare =~ $_RE_KEYPRESS_FLAG ]]; then
      _is_prompt=0                                   # keypress poll (-s/-n, no -p) → not a prompt
    else
      _is_prompt=1                                   # (b) bare read soliciting an answer
    fi
    [ "$_is_prompt" -eq 1 ] || continue
    # Guard search: scan UPWARD to the enclosing scope start (a column-0 `if … then`,
    # a `funcname() {`, or a closing `fi`/`}`), looking for either a `[ -t 0 ]`
    # TTY check or a `--yes`/-y refusal gate that exits/returns when stdin is not a
    # TTY. This covers the canonical uninstall pattern where the refusal sits at the
    # top of the arm and every later `read` in that arm is reachable only with --yes
    # OR a real TTY. Scoping to the enclosing block (not a fixed line window) avoids
    # both false positives (missed far guard) and reaching across unrelated blocks.
    local guarded=0 j
    for (( j=i-1; j>=0; j-- )); do
      local prev="${lines[$j]}"
      # A comment line is never a guard — and a comment that DESCRIBES the guard
      # (e.g. "… no [ -t 0 ] guard") must not be mistaken for one.
      is_comment "$prev" && continue
      # Enclosing-scope start / boundary at column 0 → stop searching above it,
      # but inspect the boundary line itself first (an `if [ -t 0 ]; then` guard
      # lives on that boundary line).
      if [[ $prev =~ $_RE_TTY_GUARD ]]; then guarded=1; break; fi
      if [[ $prev =~ $_RE_YES_GATE ]] && [[ $prev =~ $_RE_TTY_TEST ]]; then guarded=1; break; fi
      case "$prev" in
        # Boundary: a NEW arm/function opening at column 0 means we've left the
        # current scope going up — stop (the guard, if any, must be inside it).
        'if [['*'== "--'*) break ;;
        [A-Za-z_]*'() {'|[A-Za-z_]*'(){'|[A-Za-z_]*'() {'*) break ;;
      esac
    done
    [ "$guarded" -eq 1 ] && continue
    emit "$file" "$lineno" "4-TTY-READ" "$line" \
      "interactive PROMPT 'read' from inherited stdin with no '[ -t 0 ]' / --yes guard (a '-t N' timeout is NOT a guard — it still stalls every non-TTY call) → hangs/stalls on a non-TTY stdin; gate it with '[ -t 0 ]'"
  done
}

# ── CLASS 5 — ORDER-DESTROY: source/. of a file under a just-deleted tree ──────
# The bug class: a script deletes its own plugin dir / $0 backing file and then
# references a function or sources a file that no longer exists on disk. Full
# static detection is HARD (control flow, indirect deletes) — documented as a
# known-hard heuristic. We flag the HIGH-CONFIDENCE shape only: after a line that
# calls `_heimdall_remove_plugin` (or `rm -rf "$0"`/`rm -rf "$PLUGIN_DIR"`/
# `rm -rf "$HOME/.heimdall"`), a LATER line in the SAME scope SOURCES a file
# (`source X` / `. X`) whose path is under the deleted tree (plugin dir / $HOME/
# .heimdall). A plain external command after the delete is NOT flagged (that was
# the correctly-ordered v2.0.x fix).
scan_order_destroy() {
  local file="$1"
  # Fast bail: no self-destruction pattern anywhere in this file.
  grep -qE '_heimdall_remove_plugin|rm -rf' "$file" 2>/dev/null || return 0
  local -a lines=()
  local l
  while IFS= read -r l; do lines+=("$l"); done < "$file"
  local n="${#lines[@]}" i
  for (( i=0; i<n; i++ )); do
    line="${lines[$i]}"
    is_comment "$line" && continue
    # Fast pre-filter: skip lines that cannot be self-destruction patterns.
    case "$line" in
      *'_heimdall_remove_plugin'*|*'rm -rf'*) : ;;
      *) continue ;;
    esac
    # A self-destruction line.
    local destroyed=0
    [[ $line =~ $_RE_REMOVE_PLUGIN ]]    && destroyed=1
    [[ $line =~ $_RE_RM_SELF ]]         && destroyed=1
    [[ $line =~ $_RE_RM_DOTHEIMDALL ]]  && destroyed=1
    [ "$destroyed" -eq 1 ] || continue
    # Scan forward in the same scope for a source/. of a file under the tree.
    # Stop at the next function definition boundary `}` at column 0 (end of scope).
    local j
    for (( j=i+1; j<n; j++ )); do
      local nxt="${lines[$j]}"
      case "$nxt" in
        '}'*) break ;;            # end of the enclosing function — scope closed
      esac
      is_comment "$nxt" && continue
      # `source FILE` or `. FILE` where FILE references the deleted tree.
      if [[ $nxt =~ $_RE_SOURCE_VERB ]] && [[ $nxt =~ $_RE_SOURCE_TARGET ]]; then
        emit "$file" "$((j + 1))" "5-ORDER-DESTROY" "$nxt" \
          "sources a file under a tree deleted at line $((i + 1)) (self-destruct then re-source) → the file is gone; move the source BEFORE the delete"
      fi
    done
  done
}

# ── Run every detector over every in-scope file ───────────────────────────────
for f in "${FILES[@]}"; do
  scan_sigpipe        "$f"
  scan_unguarded_var  "$f"
  scan_baked_path     "$f"
  scan_tty_read       "$f"
  scan_order_destroy  "$f"
done

if [ "$FINDINGS" -gt 0 ]; then
  echo "" >&2
  echo "heimdall-landmine-lint: ${FINDINGS} landmine(s) found — push BLOCKED." >&2
  echo "Each must be guarded (|| true / \${var:-default} / [ -t 0 ] / reordered) or it" >&2
  echo "is a silent-failure waiting to bite a stranger. See conventions.md (landmine rule)." >&2
  exit 1
fi

echo "heimdall-landmine-lint: clean — no strict-mode landmines in ${#FILES[@]} in-scope script(s)." >&2
exit 0
