#!/usr/bin/env bash
# rr — remote-run: hand a task off from the LOCAL Heimdall to the CLOUD-hosted
# maintainer (the GCE VM) so heavy work runs remotely, not locally. The local
# `hmd` stays the orchestrator/UI; `rr` dispatches EXECUTION to the cloud hmd.
#
# THE HANDOFF (default VM mode):
#   1. FILE the task as a durable, auditable maintainer ISSUE (the maintainer's
#      native queue): `gh issue create --repo <R> --label maintainer ...`. The
#      resulting PR links back to it. Idempotent — an identical OPEN issue is
#      REUSED, never re-filed.
#   2. HAND OFF to the cloud executor — SSH to the configured VM and run the
#      maintainer THERE, detached, so `rr` returns fast:
#        gcloud compute ssh <vm> --zone <z> --project <p> --tunnel-through-iap \
#          --command "export PATH=/opt/heimdall/bin:\$PATH;
#                     export HEIMDALL_MAINTAINER_RUNNER=hybrid HEIMDALL_JOB_RUNNER=subprocess;
#                     nohup heimdall-maintain-loop run --repo <clone-dir> --max <N> \
#                       >> \$HOME/.heimdall/rr.log 2>&1 &"
#      The VM already holds its own claude + gh + bot creds — `rr` NEVER passes a
#      secret over argv or logs one. The bot OPENS PRs on heimdall/* branches; a
#      human merges (unchanged).
#   3. REPORT — the issue URL, "dispatched to <vm>", and how to watch it.
#
# SUBCOMMANDS:
#   rr setup --vm <name> --zone <z> --project <p> [--repo <default>] [--mode vm]
#         Write ~/.heimdall/remote.json (the VM cloud target). No secret is ever stored.
#   rr setup --mode control-plane [--endpoint <url>] [--enroll-token <t>] [--repo <default>]
#         Write ~/.heimdall/remote.json {mode:control-plane}; with --endpoint, also
#         update the shared ~/.heimdall/cp-endpoint.json {url, enroll_token?}. The
#         enroll token is the ONLY secret and lives 0600 in cp-endpoint.json — never argv'd back.
#   rr "<task>" [--repo <owner/repo>] [--max N] [--dry-run]
#         File the maintainer issue (idempotent) + dispatch to the cloud executor.
#   rr "<task>" --mode control-plane [--repo <owner/repo>] [--dry-run]
#         SIGN + POST the task to the CP's public ENQUEUE-ONLY route POST /rr-task.
#   rr connect [--gh-app-installation-id <id>] [--repo <owner/repo>] [--api-key] [--dry-run]
#         LAST-MILE tenant onboarding: SIGN + register, for THIS device's team (team_id
#         derived SERVER-SIDE from the signed binding, INV-1), the two things the CP
#         worker consumes at dispatch — (a) the team's BYO Claude credential (from
#         $CLAUDE_CODE_OAUTH_TOKEN / $ANTHROPIC_API_KEY, else prompted with `read -rs`,
#         hidden) -> POST /team/cred (write-only, never read back / logged), and (b) the
#         GitHub App installation_id + repo -> POST /team/install. The secret rides the
#         ENV to python, NEVER argv/log. --dry-run prints the plan with the secret REDACTED.
#   rr --issue <N> [--repo R] [--max N] [--dry-run]
#         Skip filing; dispatch the maintainer to DRAIN an existing issue.
#   rr status [--repo R] [--dry-run]
#         Recent dispatches + open maintainer PRs (gh pr list) + the remote rr.log tail.
#   rr --local [...]
#         FALLBACK: run heimdall-maintain-loop LOCALLY (clearly noted — not cloud).
#
# FLAGS: --repo <owner/repo> · --max <N> (default 3) · --mode vm|control-plane ·
#        --vm/--zone/--project (vm setup or per-call override) · --endpoint <url> ·
#        --enroll-token <t> (control-plane setup) · --gh-app-installation-id <id> (connect) ·
#        --api-key (connect: force the api_key cred kind) · --dry-run · --local · -h/--help.
#        --dry-run everywhere PRINTS the plan (gh+ssh, or the signed POST /rr-task
#        / /team/cred / /team/install body) and executes nothing (no creds/network needed).
#
# MODES:
#   vm             (default MVP) — SSH to the VM, run the maintainer there.
#   control-plane  (alt) — instead of SSH, SIGN the task with the per-dev Ed25519 key
#                  (the SAME one heimdall-presence bootstraps + persists 0600) and POST
#                  it to the CP's public ENQUEUE-ONLY route `POST /rr-task`. team_id is
#                  derived SERVER-SIDE from the signed binding (INV-1) — the client sends
#                  NO team_id and holds no cred beyond its own signing seed. A human's
#                  GitHub App turns the drained task into a PR.
#
# Exit status: 0 ok · 2 usage error · 1 fail-closed (no remote / missing tool).
set -euo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
BINDIR="$(dirname "$SELF")"
REMOTE_JSON="$HOME/.heimdall/remote.json"
DISPATCH_LOG="$HOME/.heimdall/rr-dispatch.log"
LIB="$BINDIR/lib"                                   # the shipped cp_auth Ed25519 signer lives here.
CP_ENDPOINT_JSON="$HOME/.heimdall/cp-endpoint.json" # the CP {url, enroll_token} — SAME file heimdall-presence reads.
# Shipped DEFAULT public-surface URL (lowest precedence — the config/flag/env override it).
# The CP URL is NOT a secret (a public Cloud Run endpoint), so it is baked in — same default
# heimdall-presence ships, so a dev needs ZERO url config; only the enroll TOKEN is distributed.
DEFAULT_CP_URL="https://heimdall-cp-public-203927696193.us-central1.run.app"

PY="$(command -v python3 || command -v python || true)"

# ── house-style helpers (mirrors deploy/gce/provision-maintainer-vm.sh) ────────
say()  { printf '\033[36m▸ %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit "${2:-1}"; }
# plan: print a command line in --dry-run (a $-prefixed grey line); NEVER a secret.
plan() { printf '  \033[90m$ %s\033[0m\n' "$*"; }

usage() { sed -n '2,60p' "$SELF" | sed 's/^# \{0,1\}//'; }

# validate a repo slug (owner/name, no shell metacharacters) — same gate provision uses.
valid_repo() { printf '%s' "$1" | grep -qE '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'; }

# derive_title — a deterministic, single-line, ≤72-char title from the task body
# (deterministic so the idempotency lookup is stable across runs).
derive_title() {
  local t="$1"
  t="${t%%$'\n'*}"
  t="$(printf '%s' "$t" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  if [ "${#t}" -gt 72 ]; then t="${t:0:69}..."; fi
  printf '%s' "$t"
}

# ── arg parse (subcommand may lead; flags in any order) ────────────────────────
CMD=""            # setup | status | "" (task/dispatch flow)
TASK=""
ISSUE=""
REPO_OVERRIDE=""
MAXN=""
MODE_OVERRIDE=""
VM_OVERRIDE=""
ZONE_OVERRIDE=""
PROJECT_OVERRIDE=""
ENDPOINT_OVERRIDE=""       # control-plane: the CP public-surface URL (setup / per-call).
ENROLL_TOKEN_OVERRIDE=""   # control-plane: the bootstrap enroll token (setup-only).
CONNECT_INSTALL_ID=""      # connect: the GitHub App installation_id to register (POST /team/install).
FORCE_API_KEY=0            # connect: force the api_key cred kind (default = oauth_token / setup-token).
DRY=0
LOCAL=0

case "${1:-}" in
  setup|status|connect) CMD="$1"; shift ;;
  -h|--help)    usage; exit 0 ;;
esac

while [ $# -gt 0 ]; do case "$1" in
  --dry-run)   DRY=1;                    shift ;;
  --local)     LOCAL=1;                  shift ;;
  --issue)     ISSUE="${2:?--issue needs N}";       shift 2 ;;
  --repo)      REPO_OVERRIDE="${2:?--repo needs owner/repo}"; shift 2 ;;
  --max)       MAXN="${2:?--max needs N}";          shift 2 ;;
  --mode)      MODE_OVERRIDE="${2:?--mode needs vm|control-plane}"; shift 2 ;;
  --vm)        VM_OVERRIDE="${2:?--vm needs name}"; shift 2 ;;
  --zone)      ZONE_OVERRIDE="${2:?--zone needs zone}";       shift 2 ;;
  --project)   PROJECT_OVERRIDE="${2:?--project needs id}";   shift 2 ;;
  --endpoint)  ENDPOINT_OVERRIDE="${2:?--endpoint needs a url}";       shift 2 ;;
  --enroll-token) ENROLL_TOKEN_OVERRIDE="${2:?--enroll-token needs a value}"; shift 2 ;;
  --gh-app-installation-id) CONNECT_INSTALL_ID="${2:?--gh-app-installation-id needs a numeric id}"; shift 2 ;;
  --api-key)   FORCE_API_KEY=1;          shift ;;
  -h|--help)   usage; exit 0 ;;
  --)          shift; break ;;
  -*)          die "unknown flag: $1 (see: rr --help)" 2 ;;
  *)           if [ -z "$TASK" ]; then TASK="$1"; else TASK="$TASK $1"; fi; shift ;;
esac; done

# ── remote-target resolution ───────────────────────────────────────────────────
# Built-in defaults mirror deploy/gce/provision-maintainer-vm.sh so a --dry-run
# plan is printable WITHOUT a configured remote; a REAL cloud dispatch still
# requires remote.json (fail-closed — never SSH a guessed VM with real creds).
REMOTE_CONFIGURED=0
CFG_VM="heimdall-maintainer-vm"
CFG_ZONE="us-central1-a"
CFG_PROJECT="heimdall-cp-prod"
CFG_REPO="randomittin/heimdall"
CFG_MODE="vm"

load_remote() {
  [ -f "$REMOTE_JSON" ] || return 1
  [ -n "$PY" ] || die "python3 required to read $REMOTE_JSON"
  local vals
  vals="$("$PY" - "$REMOTE_JSON" <<'PYEOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
def g(k, dv=""):
    v = d.get(k)
    return str(v) if v is not None else dv
for _v in (g("vm"), g("zone"), g("project"), g("repo"), g("mode", "vm")):
    print(_v)
PYEOF
)" || return 1
  # Read each field on its OWN line with `IFS= read` so EMPTY fields are preserved
  # POSITIONALLY. A single tab-joined line + `IFS=$'\t' read` would COLLAPSE leading/
  # adjacent empties (tab is IFS-whitespace): in control-plane mode vm/zone/project
  # are "", so repo shifted into r_vm and mode into r_zone — silently dropping
  # mode=control-plane and making a bare `rr "<task>"` fall through to the VM path.
  { IFS= read -r r_vm
    IFS= read -r r_zone
    IFS= read -r r_project
    IFS= read -r r_repo
    IFS= read -r r_mode
  } <<<"$vals"
  [ -n "$r_vm" ]      && CFG_VM="$r_vm"
  [ -n "$r_zone" ]    && CFG_ZONE="$r_zone"
  [ -n "$r_project" ] && CFG_PROJECT="$r_project"
  [ -n "$r_repo" ]    && CFG_REPO="$r_repo"
  [ -n "$r_mode" ]    && CFG_MODE="$r_mode"
  REMOTE_CONFIGURED=1
  return 0
}

load_remote || true

# apply per-call overrides on top of remote.json / defaults.
[ -n "$REPO_OVERRIDE" ]    && CFG_REPO="$REPO_OVERRIDE"
[ -n "$MODE_OVERRIDE" ]    && CFG_MODE="$MODE_OVERRIDE"
[ -n "$VM_OVERRIDE" ]      && CFG_VM="$VM_OVERRIDE"
[ -n "$ZONE_OVERRIDE" ]    && CFG_ZONE="$ZONE_OVERRIDE"
[ -n "$PROJECT_OVERRIDE" ] && CFG_PROJECT="$PROJECT_OVERRIDE"
[ -z "$MAXN" ] && MAXN="3"
printf '%s' "$MAXN" | grep -qE '^[0-9]+$' || die "--max must be a non-negative integer (got: $MAXN)" 2

# ── SETUP — write ~/.heimdall/remote.json (the cloud target; no secret) ────────
do_setup() {
  local mode="${MODE_OVERRIDE:-vm}"
  case "$mode" in vm|control-plane) ;; *) die "--mode must be vm|control-plane (got: $mode)" 2 ;; esac
  # control-plane targets the signed public enqueue route, not a VM — it needs no
  # vm/zone/project (only an optional --endpoint + --enroll-token for the CP wire).
  if [ "$mode" = control-plane ]; then do_setup_cp; return; fi
  [ -n "$VM_OVERRIDE" ]      || die "setup needs --vm <name>" 2
  [ -n "$ZONE_OVERRIDE" ]    || die "setup needs --zone <zone>" 2
  [ -n "$PROJECT_OVERRIDE" ] || die "setup needs --project <id>" 2
  local repo="${REPO_OVERRIDE:-}"
  [ -z "$repo" ] || valid_repo "$repo" || die "--repo must be owner/name (got: $repo)" 2
  [ -n "$PY" ] || die "python3 required to write remote.json"

  if [ "$DRY" = 1 ]; then
    say "dry-run: would write $REMOTE_JSON:"
    plan "vm=$VM_OVERRIDE zone=$ZONE_OVERRIDE project=$PROJECT_OVERRIDE repo=${repo:-<none>} mode=$mode"
    warn "dry-run: nothing written."
    return 0
  fi

  mkdir -p "$HOME/.heimdall"; chmod 700 "$HOME/.heimdall" 2>/dev/null || true
  VM="$VM_OVERRIDE" ZONE="$ZONE_OVERRIDE" PROJECT="$PROJECT_OVERRIDE" \
  REPO="$repo" MODE="$mode" DEST="$REMOTE_JSON" "$PY" - <<'PYEOF'
import json, os
dest = os.environ["DEST"]
cfg = {
    "vm": os.environ["VM"],
    "zone": os.environ["ZONE"],
    "project": os.environ["PROJECT"],
    "repo": os.environ.get("REPO") or "",
    "mode": os.environ.get("MODE") or "vm",
}
with open(dest, "w") as f:
    json.dump(cfg, f, indent=2, sort_keys=True)
    f.write("\n")
PYEOF
  # remote.json holds NO secret by construction, but keep it owner-only anyway.
  chmod 600 "$REMOTE_JSON" 2>/dev/null || true
  say "wrote $REMOTE_JSON (cloud target: vm=$VM_OVERRIDE zone=$ZONE_OVERRIDE project=$PROJECT_OVERRIDE mode=$mode)"
  say "next: rr \"<task>\" --dry-run   # preview the local→cloud handoff plan"
}

# ── SETUP (control-plane) — remote.json {mode:control-plane, repo} + optional CP wire ──
# The control-plane target is the signed public enqueue route, not a VM: no
# vm/zone/project. When --endpoint is given we (also) update the SHARED CP config
# ~/.heimdall/cp-endpoint.json that heimdall-presence reads, MERGING url (and the
# enroll_token when --enroll-token is given) into it — existing keys are preserved.
# NO secret lands in remote.json; the enroll token lives ONLY in the 0600 cp-endpoint.json
# and is NEVER echoed (passed to python via the ENV, never argv-logged/printed).
do_setup_cp() {
  local repo="${REPO_OVERRIDE:-}"
  [ -z "$repo" ] || valid_repo "$repo" || die "--repo must be owner/name (got: $repo)" 2
  [ -n "$PY" ] || die "python3 required to write remote.json"
  local endpoint="$ENDPOINT_OVERRIDE"
  local tok="${ENROLL_TOKEN_OVERRIDE:-${RR_ENROLL_TOKEN:-}}"

  if [ "$DRY" = 1 ]; then
    say "dry-run: would write $REMOTE_JSON (mode=control-plane repo=${repo:-<none>}):"
    plan "mode=control-plane repo=${repo:-<none>}"
    if [ -n "$endpoint" ]; then
      say "dry-run: would update $CP_ENDPOINT_JSON:"
      plan "url=$endpoint${tok:+ enroll_token=<redacted>}"
    fi
    warn "dry-run: nothing written."
    return 0
  fi

  mkdir -p "$HOME/.heimdall"; chmod 700 "$HOME/.heimdall" 2>/dev/null || true
  REPO="$repo" DEST="$REMOTE_JSON" "$PY" - <<'PYEOF'
import json, os
cfg = {"vm": "", "zone": "", "project": "",
       "repo": os.environ.get("REPO") or "", "mode": "control-plane"}
with open(os.environ["DEST"], "w") as f:
    json.dump(cfg, f, indent=2, sort_keys=True)
    f.write("\n")
PYEOF
  chmod 600 "$REMOTE_JSON" 2>/dev/null || true
  say "wrote $REMOTE_JSON (control-plane target: repo=${repo:-<none>})"

  if [ -n "$endpoint" ]; then
    # MERGE {url, enroll_token?} into the shared CP config, preserving other keys.
    CP_URL="$endpoint" CP_TOKEN="$tok" DEST="$CP_ENDPOINT_JSON" "$PY" - <<'PYEOF'
import json, os
dest = os.environ["DEST"]
try:
    with open(dest) as f:
        cfg = json.load(f)
    if not isinstance(cfg, dict):
        cfg = {}
except Exception:
    cfg = {}
cfg["url"] = os.environ["CP_URL"]
tok = os.environ.get("CP_TOKEN") or ""
if tok:
    cfg["enroll_token"] = tok   # a secret — persisted 0600 below, NEVER echoed.
with open(dest, "w") as f:
    json.dump(cfg, f, indent=2, sort_keys=True)
    f.write("\n")
PYEOF
    chmod 600 "$CP_ENDPOINT_JSON" 2>/dev/null || true
    say "updated $CP_ENDPOINT_JSON (url set${tok:+, enroll token stored 0600 — not shown})"
  fi
  say "next: rr \"<task>\" --mode control-plane --dry-run   # preview the signed enqueue plan"
}

# ── FILE the maintainer issue (idempotent) ─────────────────────────────────────
# Sets ISSUE_REF (a human "#N"/URL) for the report. In --dry-run it PRINTS the
# plan and touches nothing.
ISSUE_REF=""
file_issue() {
  [ -n "$TASK" ] || die "no task given — usage: rr \"<task>\" [--repo R]" 2
  local title body
  title="$(derive_title "$TASK")"
  body="$TASK

## Acceptance
- [ ] Change implemented; the project's tests pass
- [ ] Lint clean (zero warnings)
- [ ] PR opened on a heimdall/* branch, linking this issue

_Filed by \`rr\` (remote-run) for the cloud maintainer. The bot opens the PR; a human merges._"

  if [ "$DRY" = 1 ]; then
    say "would file the maintainer issue (idempotent — an identical OPEN issue is reused):"
    plan "gh issue list --repo $CFG_REPO --label maintainer --state open --json number,title --limit 100  # dedup by title"
    plan "gh issue create --repo $CFG_REPO --label maintainer --title \"$title\" --body <task + acceptance>"
    ISSUE_REF="(dry-run: not filed)"
    return 0
  fi

  command -v gh >/dev/null 2>&1 || die "gh not found — install the GitHub CLI (https://cli.github.com)"
  gh auth status >/dev/null 2>&1 || die "gh not authenticated — run: gh auth login"
  valid_repo "$CFG_REPO" || die "invalid repo slug: $CFG_REPO (set --repo owner/name)" 2

  # idempotency: reuse an OPEN maintainer issue with the exact same title.
  local existing listing
  listing="$(gh issue list --repo "$CFG_REPO" --label maintainer --state open \
             --json number,title --limit 100 2>/dev/null || echo '[]')"
  existing="$(RR_TITLE="$title" RR_LISTING="$listing" "$PY" - <<'PYEOF'
import json, os, sys
raw = os.environ.get("RR_LISTING", "")
try:
    data = json.loads(raw) if raw.strip() else []
except Exception:
    data = []
t = os.environ["RR_TITLE"]
for it in data:
    if it.get("title") == t:
        print(it.get("number"))
        break
PYEOF
)"
  if [ -n "$existing" ]; then
    ISSUE_REF="#$existing"
    say "reusing existing OPEN maintainer issue $ISSUE_REF (idempotent — not re-filed)"
    return 0
  fi

  local url
  url="$(gh issue create --repo "$CFG_REPO" --label maintainer \
         --title "$title" --body "$body")"
  ISSUE_REF="$url"
  say "filed maintainer issue: $url"
}

# ── DISPATCH to the cloud executor ─────────────────────────────────────────────
# The remote command: put /opt/heimdall/bin on PATH, pin the hybrid runner +
# subprocess job runner, and run a bounded maintain-loop cycle DETACHED (nohup &)
# so ssh — and `rr` — return fast. $HOME/$PATH stay literal (expand on the VM).
build_remote_cmd() {
  local clone_dir="\$HOME/heimdall-work/${CFG_REPO##*/}"
  printf '%s' "export PATH=/opt/heimdall/bin:\$PATH; export HEIMDALL_MAINTAINER_RUNNER=hybrid HEIMDALL_JOB_RUNNER=subprocess; mkdir -p \$HOME/.heimdall; nohup heimdall-maintain-loop run --repo $clone_dir --max $MAXN >> \$HOME/.heimdall/rr.log 2>&1 &"
}

dispatch_vm() {
  local remote_cmd; remote_cmd="$(build_remote_cmd)"
  local capsule="$BINDIR/heimdall-context-capsule"
  if [ "$DRY" = 1 ]; then
    # capsule-ship-over-SSH is VM-MODE ONLY. In control-plane mode the capsule rides
    # the signed POST body (dispatch_cp builds it as an API field) — NEVER SSH/scp.
    if [ "$CFG_MODE" = vm ] && [ "${RR_NO_CONTEXT:-0}" != 1 ] && [ -x "$capsule" ]; then
      plan "$capsule ship --vm $CFG_VM --zone $CFG_ZONE --project $CFG_PROJECT --repo $CFG_REPO   # ship session context so the cloud bot has continuity"
    fi
    say "would hand off to the cloud executor (SSH to $CFG_VM, run the maintainer there, detached):"
    plan "gcloud compute ssh $CFG_VM --zone $CFG_ZONE --project $CFG_PROJECT --tunnel-through-iap --command \"$remote_cmd\""
    return 0
  fi
  command -v gcloud >/dev/null 2>&1 || die "gcloud not found — install the Google Cloud SDK (https://cloud.google.com/sdk)"
  # Ship the LOCAL session context capsule so the cloud maintainer has continuity
  # (secret-scrubbed by the capsule; maintain-loop --context auto-detects it). Best-effort:
  # a capsule failure must NOT block the dispatch. Opt out with RR_NO_CONTEXT=1.
  # VM-MODE ONLY: control-plane never SSHes — its capsule rides the signed API body.
  if [ "$CFG_MODE" = vm ] && [ "${RR_NO_CONTEXT:-0}" != 1 ] && [ -x "$capsule" ]; then
    say "shipping local session context to $CFG_VM (continuity for the cloud bot)"
    "$capsule" ship --vm "$CFG_VM" --zone "$CFG_ZONE" --project "$CFG_PROJECT" --repo "$CFG_REPO" \
      || warn "context capsule ship failed (non-fatal — the bot runs without local context)"
  fi
  say "dispatching to $CFG_VM ($CFG_ZONE / $CFG_PROJECT) — maintainer runs on the VM, detached"
  gcloud compute ssh "$CFG_VM" --zone "$CFG_ZONE" --project "$CFG_PROJECT" \
    --tunnel-through-iap --command "$remote_cmd"
  printf '%s\tvm=%s\trepo=%s\tissue=%s\tmax=%s\n' \
    "$(date -u +%FT%TZ)" "$CFG_VM" "$CFG_REPO" "${ISSUE_REF:-?}" "$MAXN" >> "$DISPATCH_LOG"
}

# ── CONTROL-PLANE mode — the SIGNED, ENQUEUE-ONLY public-surface client ────────
# Instead of SSHing a VM, `rr --mode control-plane` SIGNS a bounded task with the
# per-dev Ed25519 key and POSTs it to the CP's public route `POST /rr-task`. The
# route is ENQUEUE-ONLY: it writes ONE bounded, secret-scrubbed DATA row to the
# CALLER'S OWN team queue (team_id is derived SERVER-SIDE from the signed binding,
# INV-1) and stops — it dispatches NOTHING and reads NO cred. A human's GitHub App
# turns the drained task into a PR.
#
# The signing key + enroll binding are the SAME ones heimdall-presence bootstraps
# and persists (0600 ${HOME}/.heimdall/pki/<haid>.seed), so enrolling once serves
# both. This client REUSES the shipped cp_auth signer over urllib exactly as
# heimdall-presence does — Ed25519 is NEVER re-implemented — and the seed/enroll
# secret cross bash→python via the ENVIRONMENT/heredoc ONLY, never argv (argv
# shows in `ps`) and never a log.

# resolve_cp_wire — sets CP_URL, CP_HAID, CP_SEED_FILE from the SAME sources
# heimdall-presence uses (flag/env > cp-endpoint.json > shipped default; identity
# from heimdall-identity/heimdall-haid; the per-(machine,haid) 0600 seed path).
CP_URL=""; CP_HAID=""; CP_SEED_FILE=""
resolve_cp_wire() {
  # URL precedence: --endpoint > $HEIMDALL_CP_URL/$BASE_URL > cp-endpoint.json .url > default.
  local cfg_url=""
  if [ -n "$PY" ] && [ -f "$CP_ENDPOINT_JSON" ]; then
    cfg_url="$("$PY" - "$CP_ENDPOINT_JSON" 2>/dev/null <<'PYEOF' || true
import json, sys
try:
    print((json.load(open(sys.argv[1])).get("url") or ""))
except Exception:
    print("")
PYEOF
)"
  fi
  CP_URL="$ENDPOINT_OVERRIDE"
  [ -n "$CP_URL" ] || CP_URL="${HEIMDALL_CP_URL:-${BASE_URL:-}}"
  [ -n "$CP_URL" ] || CP_URL="$cfg_url"
  [ -n "$CP_URL" ] || CP_URL="$DEFAULT_CP_URL"

  # identity: $HMD_HAID > heimdall-identity current > heimdall-haid current (as presence resolves it).
  CP_HAID="${HMD_HAID:-}"
  if [ -z "$CP_HAID" ] && [ -x "$BINDIR/heimdall-identity" ]; then
    CP_HAID="$("$BINDIR/heimdall-identity" current 2>/dev/null || true)"
  fi
  if [ -z "$CP_HAID" ] && [ -x "$BINDIR/heimdall-haid" ]; then
    CP_HAID="$("$BINDIR/heimdall-haid" current 2>/dev/null || true)"
  fi

  # the per-(machine,haid) 0600 seed path — the SAME slug/layout heimdall-presence persists.
  if [ -n "${HOME:-}" ] && [ -n "$CP_HAID" ]; then
    local slug; slug="$(printf '%s' "$CP_HAID" | tr '/:' '__')"
    CP_SEED_FILE="$HOME/.heimdall/pki/$slug.seed"
  fi
}

# dispatch_cp — sign + POST the bounded task (+context capsule) to POST /rr-task.
dispatch_cp() {
  [ -n "$TASK" ] || die "no task given — usage: rr \"<task>\" --mode control-plane" 2
  resolve_cp_wire
  local capsule="$BINDIR/heimdall-context-capsule"

  if [ "$DRY" = 1 ]; then
    # Build the EXACT client payload (no seed/network needed) so the plan shows the
    # real, bounded body — its context is a marker here (the capsule is only run on a
    # REAL dispatch, so a dry-run executes nothing). The body carries NO team_id.
    local body_json
    body_json="$(CP_TASK="$TASK" \
                 CP_CONTEXT="<context-capsule: secret-scrubbed, up to 8000 chars>" \
                 RR_CP_DUMP_BODY=1 cp_client_py)"
    say "would SIGN + POST the task to the control-plane ENQUEUE-ONLY route (no VM, no GitHub issue):"
    plan "ensure enrolled: $BINDIR/heimdall-presence beat   # bootstraps the 0600 Ed25519 key + /enroll if absent (seed: ${CP_SEED_FILE:-<haid-derived>})"
    plan "POST $CP_URL/rr-task   body=$body_json   # SIGNED X-Heimdall-Signature over canonical_message(POST,/rr-task,body)"
    say "INV-1: team_id is derived SERVER-SIDE from the signed binding — the client sends NO team_id."
    say "watch: the PR will appear on $CFG_REPO via your GitHub App once the CP task is drained."
    return 0
  fi

  [ -n "$PY" ] || die "python3 required for the control-plane client"
  [ -f "$LIB/cp_auth.py" ] || die "cp_auth signer not found at $LIB (broken install)"
  [ -n "$CP_HAID" ] || die "no Heimdall identity resolved — enroll first: run \`heimdall-presence beat\` (or set \$HMD_HAID)"

  # ensure enrolled: reuse heimdall-presence's bootstrap enroll path (keygen → POST
  # /enroll → persist the 0600 seed) so this device holds a signing key bound to its
  # team. Best-effort + idempotent — a already-enrolled device is a no-op.
  if [ -z "$CP_SEED_FILE" ] || [ ! -f "$CP_SEED_FILE" ]; then
    if [ -x "$BINDIR/heimdall-presence" ]; then
      say "enrolling this device with the control plane (first use)…"
      "$BINDIR/heimdall-presence" beat >/dev/null 2>&1 || true
    fi
  fi
  [ -n "$CP_SEED_FILE" ] && [ -f "$CP_SEED_FILE" ] \
    || die "not enrolled — no signing key at ${CP_SEED_FILE:-<haid-derived>}. Enroll first: run \`heimdall-presence beat\` (needs a reachable CP + the enroll token)"

  # build the context capsule (bounded, ALREADY secret-scrubbed by the capsule). Best-effort:
  # a capsule failure must NOT block the enqueue. Opt out with RR_NO_CONTEXT=1.
  local ctx=""
  if [ "${RR_NO_CONTEXT:-0}" != 1 ] && [ -x "$capsule" ]; then
    ctx="$("$capsule" build --repo "$CFG_REPO" 2>/dev/null || true)"
  fi

  say "signing + posting the task to the control plane ($CP_URL/rr-task)…"
  local resp kind a b added
  resp="$(CP_TASK="$TASK" CP_CONTEXT="$ctx" cp_client_py)"
  IFS=$'\t' read -r kind a b added <<<"$resp"
  case "$kind" in
    OK)
      say "task ENQUEUED to the control plane — id: ${a:-?}  (team: ${b:-server-derived}, INV-1)"
      # An idempotent no-op: the identical scrubbed text is already queued/in-flight/done,
      # so nothing new was enqueued. Say so LOUD — a stranger re-running the same task
      # (seeing no PR yet) must not mistake a dedup for a fresh submission.
      if [ "$added" = false ]; then
        say "note: identical task already processed (id ${a:-?}) — reword the task to submit a fresh one"
      fi
      say "watch: the PR will appear on $CFG_REPO via your GitHub App once the task is drained."
      printf '%s\tcontrol-plane\trepo=%s\tid=%s\tteam=%s\n' \
        "$(date -u +%FT%TZ)" "$CFG_REPO" "${a:-?}" "${b:-?}" >> "$DISPATCH_LOG"
      ;;
    HTTP)
      case "$a" in
        401) die "signature REJECTED (401) — this device's key isn't recognized. Re-enroll: heimdall-presence beat" ;;
        403) die "repo NOT covered / no team (403) — this device isn't bound to a team that covers $CFG_REPO" ;;
        422) die "task refused (422) — the enqueue rejected the payload (${b:-bounds/scrub})" ;;
        429) die "rate limited (429) — too many tasks too fast; retry shortly" ;;
        *)   die "control-plane refused the task (HTTP $a): ${b:-}" ;;
      esac
      ;;
    ERR)
      case "$a" in
        no_seed) die "not enrolled — no usable signing key. Enroll first: run \`heimdall-presence beat\`" ;;
        connect) die "could not reach the control plane at $CP_URL (offline / DNS / TLS). Check the endpoint + your network." ;;
        *)       die "control-plane client error (${a:-unknown})" ;;
      esac
      ;;
    *) die "control-plane client returned an unexpected result: $resp" ;;
  esac
}

# cp_client_py — the signed-HTTP client, mirroring heimdall-presence's run_client:
# it REUSES the shipped cp_auth signer over urllib. Inputs cross via the ENV ONLY
# (CP_URL/CP_HAID/CP_SEED_FILE/CP_TASK/CP_CONTEXT + LIB) — NEVER argv. It builds the
# bounded body {text, context?, nonce, ts} (NO team_id — INV-1), signs
# canonical_message(POST,/rr-task,body), and POSTs. With RR_CP_DUMP_BODY set it
# prints the literal body JSON and stops BEFORE any seed read / network (the dry-run
# plan uses this). Emits one tab-record: `OK\t<id>\t<team_id>\t<added>` on 2xx (added is
# `true` for a fresh enqueue, `false` for an idempotent dedup no-op, `` when unknown),
# `HTTP\t<code>\t<err>` on an HTTP refusal, or `ERR\t<reason>` on no-seed/transport fault.
cp_client_py() {
  LIB="$LIB" CP_URL="$CP_URL" CP_HAID="$CP_HAID" CP_SEED_FILE="$CP_SEED_FILE" \
  "$PY" - <<'PYEOF'
import json, os, secrets, sys, time
import urllib.error, urllib.request

# Build the bounded client body FIRST — {text, context?, nonce, ts}. NO team_id: the
# server derives the team from the signed binding (INV-1). context is trimmed to a
# sane cap so an oversized capsule can never bloat a queue row (INV-5; the server
# also scrubs+trims). nonce+ts ride INSIDE the signed body so the replay-nonce gate
# can prove this is a LIVE, first-use enqueue.
ctx = os.environ.get("CP_CONTEXT") or ""
if len(ctx) > 8000:
    ctx = ctx[:8000]
body_obj = {"text": os.environ.get("CP_TASK") or "",
            "nonce": secrets.token_hex(16), "ts": int(time.time())}
if ctx:
    body_obj["context"] = ctx
body = json.dumps(body_obj).encode("utf-8")

if os.environ.get("RR_CP_DUMP_BODY"):
    # dry-run: show the LITERAL payload; no seed read, no network.
    sys.stdout.write(body.decode("utf-8"))
    sys.exit(0)

# Read the persisted 0600 seed HERE (in-process) so the seed bytes never touch
# bash/argv — only the seed-file PATH crossed from the shell.
try:
    with open(os.environ["CP_SEED_FILE"], "r", encoding="utf-8") as fh:
        seed = fh.read().strip()
except OSError:
    sys.stdout.write("ERR\tno_seed"); sys.exit(0)
if not seed:
    sys.stdout.write("ERR\tno_seed"); sys.exit(0)

sys.path.insert(0, os.environ["LIB"])
import cp_auth as K  # the SHIPPED Ed25519 signer — never re-implemented.

BASE = os.environ["CP_URL"].rstrip("/")
path = "/rr-task"
req = urllib.request.Request(BASE + path, data=body, method="POST")
req.add_header("Content-Type", "application/json")
req.add_header("X-Heimdall-HAID", os.environ["CP_HAID"])
req.add_header("X-Heimdall-Signature", K.sign(seed, K.canonical_message("POST", path, body)))
try:
    with urllib.request.urlopen(req, timeout=15) as resp:
        raw = resp.read()
        d = json.loads(raw) if raw else {}
        # `added` distinguishes a FRESH enqueue (true) from an idempotent dedup no-op
        # (false — the same scrubbed text is already queued/in-flight/done). The server
        # reports it verbatim; emit it as a 4th field so the caller can surface the
        # "already processed" notice. Missing/unknown -> "" (no notice claimed).
        added = d.get("added")
        added_s = "true" if added is True else ("false" if added is False else "")
        sys.stdout.write("OK\t%s\t%s\t%s" % (d.get("id") or "", d.get("team_id") or "", added_s))
except urllib.error.HTTPError as exc:
    raw = exc.read()
    try:
        d = json.loads(raw) if raw else {}
    except Exception:
        d = {}
    sys.stdout.write("HTTP\t%d\t%s" % (exc.code, d.get("error") or ""))
except Exception:  # noqa: BLE001 — any transport/TLS/DNS fault is a connect failure.
    sys.stdout.write("ERR\tconnect")
PYEOF
}

# ── CONNECT — the SIGNED, team-scoped TENANT ONBOARDING client (last-mile) ──────
# `rr connect` registers, for the caller's OWN team (team_id derived SERVER-SIDE from
# the signed binding, INV-1 — the client sends NO team_id), the two things the CP
# worker consumes at dispatch: (a) the team's BYO Claude credential -> POST /team/cred,
# and (b) the team's GitHub App installation -> POST /team/install. Both are SIGNED with
# the per-dev Ed25519 key (the SAME one heimdall-presence bootstraps + persists 0600),
# reusing the shipped cp_auth signer over urllib — Ed25519 is NEVER re-implemented.
#
# THE SECRET (the Claude token) is read from $CLAUDE_CODE_OAUTH_TOKEN / $ANTHROPIC_API_KEY,
# else prompted with `read -rs` (input hidden, not echoed). It crosses bash->python via the
# ENVIRONMENT ONLY — NEVER argv (argv shows in `ps`) and NEVER a log. --dry-run prints the
# signed-POST plan with the secret REDACTED and runs nothing (no seed read, no network).
do_connect() {
  resolve_cp_wire
  local repo="${REPO_OVERRIDE:-$CFG_REPO}"
  [ -z "$repo" ] || valid_repo "$repo" || die "--repo must be owner/name (got: $repo)" 2
  if [ -n "$CONNECT_INSTALL_ID" ]; then
    printf '%s' "$CONNECT_INSTALL_ID" | grep -qE '^[0-9]+$' \
      || die "--gh-app-installation-id must be a positive integer (got: $CONNECT_INSTALL_ID)" 2
  fi
  # the cred kind for the plan/POST: api_key iff forced OR only ANTHROPIC_API_KEY is set.
  local cred_kind="oauth_token"
  if [ "$FORCE_API_KEY" = 1 ]; then
    cred_kind="api_key"
  elif [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    cred_kind="api_key"
  fi

  if [ "$DRY" = 1 ]; then
    local cred_body install_body
    cred_body="$(CP_REG_PATH=/team/cred CP_REG_KIND="$cred_kind" RR_CP_DUMP_BODY=1 cp_register_py)"
    say "would SIGN + POST the tenant credential to the onboarding route (write-only, never read back):"
    plan "ensure enrolled: $BINDIR/heimdall-presence beat   # bootstraps the 0600 Ed25519 key + /enroll if absent (seed: ${CP_SEED_FILE:-<haid-derived>})"
    plan "POST $CP_URL/team/cred   body=$cred_body   # SIGNED; secret REDACTED here + sent via env, NEVER argv/log; team_id server-derived (INV-1)"
    if [ -n "$CONNECT_INSTALL_ID" ]; then
      install_body="$(CP_REG_PATH=/team/install CP_INSTALL_ID="$CONNECT_INSTALL_ID" CP_INSTALL_REPO="$repo" RR_CP_DUMP_BODY=1 cp_register_py)"
      say "would SIGN + POST the GitHub App installation (installation_id + repo — NON-secret):"
      plan "POST $CP_URL/team/install   body=$install_body   # SIGNED; team_id server-derived (INV-1)"
    else
      warn "no --gh-app-installation-id given — skipping /team/install (add it to bind your repo)."
    fi
    say "INV-1: team_id is derived SERVER-SIDE from the signed binding — the client sends NO team_id."
    warn "dry-run: nothing sent."
    return 0
  fi

  [ -n "$PY" ] || die "python3 required for the control-plane onboarding client"
  [ -f "$LIB/cp_auth.py" ] || die "cp_auth signer not found at $LIB (broken install)"
  [ -n "$CP_HAID" ] || die "no Heimdall identity resolved — enroll first: run \`heimdall-presence beat\` (or set \$HMD_HAID)"

  # ensure enrolled (the SAME bootstrap path dispatch_cp uses): keygen -> /enroll -> 0600 seed.
  if [ -z "$CP_SEED_FILE" ] || [ ! -f "$CP_SEED_FILE" ]; then
    if [ -x "$BINDIR/heimdall-presence" ]; then
      say "enrolling this device with the control plane (first use)…"
      "$BINDIR/heimdall-presence" beat >/dev/null 2>&1 || true
    fi
  fi
  [ -n "$CP_SEED_FILE" ] && [ -f "$CP_SEED_FILE" ] \
    || die "not enrolled — no signing key at ${CP_SEED_FILE:-<haid-derived>}. Enroll first: run \`heimdall-presence beat\`"

  # resolve the cred secret — env first, else prompt hidden. NEVER echoed; crosses to python via env.
  local cred_secret=""
  if [ "$cred_kind" = oauth_token ] && [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    cred_secret="$CLAUDE_CODE_OAUTH_TOKEN"; say "using CLAUDE_CODE_OAUTH_TOKEN from the environment (oauth_token)"
  elif [ "$cred_kind" = api_key ] && [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    cred_secret="$ANTHROPIC_API_KEY"; say "using ANTHROPIC_API_KEY from the environment (api_key)"
  else
    local label="Claude OAuth token (run: claude setup-token)"
    [ "$cred_kind" = api_key ] && label="Anthropic API key"
    printf '%s' "Paste your $label (input hidden, not echoed): " >&2
    read -rs cred_secret || true; printf '\n' >&2
  fi
  [ -n "$cred_secret" ] || die "no credential provided — set CLAUDE_CODE_OAUTH_TOKEN / ANTHROPIC_API_KEY or paste when prompted"

  # BUG #23 — SANITIZE + VALIDATE the Claude cred at the CLIENT boundary before it is ever
  # signed/posted. `claude setup-token` prints a DECORATED interactive UI (ANSI escape
  # sequences + a "Welcome to Claude Code" / "Your OAuth token:" banner + the authorize URL),
  # so `export CLAUDE_CODE_OAUTH_TOKEN="$(claude setup-token)"` captures the whole ~2199-char
  # decorated dump, NOT the clean token. Stored as-is, `claude` gets `Bearer <ansi junk>` ->
  # "Header has invalid value" -> interactive fallback -> GATE_FAILED, 0 files. Strip ANSI/
  # control, collapse whitespace, EXTRACT the one sk-ant-oat…/sk-ant-api… token by shape.
  # Zero / junk / two distinct tokens -> REFUSE (never post a non-clean value). The secret
  # crosses to python via the ENV ONLY (never argv/log); nothing of the token is printed.
  local clean_secret
  clean_secret="$(RR_RAW_SECRET="$cred_secret" cp_extract_token_py)"
  if [ -z "$clean_secret" ]; then
    unset cred_secret
    die "the token looks wrong — paste ONLY the sk-ant-oat… value from \`claude setup-token\` (the token itself, not the whole decorated output)"
  fi
  cred_secret="$clean_secret"; unset clean_secret   # use the CLEAN extracted single token.

  say "signing + posting the tenant credential to the control plane ($CP_URL/team/cred)…"
  local resp kind a b
  resp="$(CP_REG_PATH=/team/cred CP_REG_KIND="$cred_kind" CP_CRED_SECRET="$cred_secret" cp_register_py)"
  unset cred_secret   # drop the secret from the shell as soon as the env-scoped call returns.
  IFS=$'\t' read -r kind a b <<<"$resp"
  case "$kind" in
    OK)  say "credential STORED for your team (kind: ${a:-?}, team: ${b:-server-derived}, INV-1) — never echoed/logged" ;;
    HTTP)
      case "$a" in
        401) die "signature REJECTED (401) — this device's key isn't recognized. Re-enroll: heimdall-presence beat" ;;
        403) die "no team (403) — this device isn't bound to a team. Enroll first: heimdall-presence beat" ;;
        422) die "credential refused (422): ${b:-bad kind/secret}" ;;
        429) die "rate limited (429) — too many registrations too fast; retry shortly" ;;
        *)   die "control-plane refused the credential (HTTP $a): ${b:-}" ;;
      esac ;;
    ERR)
      case "$a" in
        no_seed) die "not enrolled — no usable signing key. Enroll first: heimdall-presence beat" ;;
        connect) die "could not reach the control plane at $CP_URL (offline / DNS / TLS)" ;;
        *)       die "control-plane client error (${a:-unknown})" ;;
      esac ;;
    *) die "control-plane client returned an unexpected result: $resp" ;;
  esac

  # (b) register the GitHub App installation when an id was given.
  if [ -n "$CONNECT_INSTALL_ID" ]; then
    [ -n "$repo" ] || die "an installation needs a repo — pass --repo owner/name" 2
    say "registering your GitHub App installation ($CP_URL/team/install)…"
    local iresp ikind ia ib
    iresp="$(CP_REG_PATH=/team/install CP_INSTALL_ID="$CONNECT_INSTALL_ID" CP_INSTALL_REPO="$repo" cp_register_py)"
    IFS=$'\t' read -r ikind ia ib <<<"$iresp"
    case "$ikind" in
      OK)  say "installation STORED (installation_id: ${ia:-$CONNECT_INSTALL_ID}, repo: $repo, team: ${ib:-server-derived})" ;;
      HTTP)
        case "$ia" in
          401) die "signature REJECTED (401) on /team/install — re-enroll: heimdall-presence beat" ;;
          403) die "no team (403) on /team/install — enroll first: heimdall-presence beat" ;;
          422) die "installation refused (422): ${ib:-bad installation_id/repo}" ;;
          429) die "rate limited (429) on /team/install — retry shortly" ;;
          *)   die "control-plane refused the installation (HTTP $ia): ${ib:-}" ;;
        esac ;;
      ERR) die "control-plane client error on /team/install (${ia:-unknown})" ;;
      *)   die "control-plane client returned an unexpected result: $iresp" ;;
    esac
    say "connected — your team now has a cred + install. Try: rr \"fix issue #1\" --mode control-plane --repo $repo"
  else
    say "credential set. Add --gh-app-installation-id <id> --repo owner/name to also bind your repo."
  fi
}

# cp_register_py — the signed-HTTP onboarding client (mirrors cp_client_py): REUSES the shipped
# cp_auth signer over urllib. Inputs cross via the ENV ONLY (CP_URL/CP_HAID/CP_SEED_FILE/CP_REG_PATH
# + the per-route fields) — NEVER argv. For /team/cred the body is {kind, secret, nonce, ts} (the
# secret from CP_CRED_SECRET, env-only); for /team/install it is {installation_id, repos, nonce, ts}.
# With RR_CP_DUMP_BODY set it prints the body JSON — with the secret REDACTED — and stops BEFORE any
# seed read / network (the dry-run plan uses this). Emits one tab-record: `OK\t<a>\t<team_id>` on 2xx
# (a = kind for cred, installation_id for install), `HTTP\t<code>\t<err>` on an HTTP refusal, or
# `ERR\t<reason>` on no-seed/transport.
# cp_extract_token_py — SANITIZE + EXTRACT the clean Claude token from RR_RAW_SECRET (bug #23).
# Reuses the SHIPPED claude_cred oracle (the SAME shape grammar the server enforces). The raw
# value crosses via the ENV ONLY (never argv). Prints the ONE clean sk-ant-oat…/sk-ant-api…
# token on success, or NOTHING (empty) when zero / junk / ambiguous — so the caller refuses.
# Nothing of the token is otherwise emitted (no log/echo/repr).
cp_extract_token_py() {
  LIB="$LIB" "$PY" - <<'PYEOF'
import os, sys
sys.path.insert(0, os.environ["LIB"])
import claude_cred
tok = claude_cred.extract_claude_token(os.environ.get("RR_RAW_SECRET") or "")
if tok:
    sys.stdout.write(tok)
PYEOF
}

cp_register_py() {
  LIB="$LIB" CP_URL="$CP_URL" CP_HAID="$CP_HAID" CP_SEED_FILE="$CP_SEED_FILE" \
  "$PY" - <<'PYEOF'
import json, os, secrets, sys, time
import urllib.error, urllib.request

path = os.environ.get("CP_REG_PATH") or ""
nonce = secrets.token_hex(16); ts = int(time.time())

if path == "/team/cred":
    kind = os.environ.get("CP_REG_KIND") or "oauth_token"
    if os.environ.get("RR_CP_DUMP_BODY"):
        # dry-run: REDACT the secret; no seed read, no network.
        sys.stdout.write(json.dumps({"kind": kind, "secret": "<redacted>",
                                     "nonce": nonce, "ts": ts})); sys.exit(0)
    body_obj = {"kind": kind, "secret": os.environ.get("CP_CRED_SECRET") or "",
                "nonce": nonce, "ts": ts}
elif path == "/team/install":
    repo = os.environ.get("CP_INSTALL_REPO") or ""
    body_obj = {"installation_id": os.environ.get("CP_INSTALL_ID") or "",
                "repos": [repo] if repo else [], "nonce": nonce, "ts": ts}
    if os.environ.get("RR_CP_DUMP_BODY"):
        sys.stdout.write(json.dumps(body_obj)); sys.exit(0)
else:
    sys.stdout.write("ERR\tbad_path"); sys.exit(0)

body = json.dumps(body_obj).encode("utf-8")

# Read the persisted 0600 seed HERE (in-process) so the seed bytes never touch bash/argv —
# only the seed-file PATH crossed from the shell.
try:
    with open(os.environ["CP_SEED_FILE"], "r", encoding="utf-8") as fh:
        seed = fh.read().strip()
except OSError:
    sys.stdout.write("ERR\tno_seed"); sys.exit(0)
if not seed:
    sys.stdout.write("ERR\tno_seed"); sys.exit(0)

sys.path.insert(0, os.environ["LIB"])
import cp_auth as K  # the SHIPPED Ed25519 signer — never re-implemented.

BASE = os.environ["CP_URL"].rstrip("/")
req = urllib.request.Request(BASE + path, data=body, method="POST")
req.add_header("Content-Type", "application/json")
req.add_header("X-Heimdall-HAID", os.environ["CP_HAID"])
req.add_header("X-Heimdall-Signature", K.sign(seed, K.canonical_message("POST", path, body)))
try:
    with urllib.request.urlopen(req, timeout=15) as resp:
        raw = resp.read()
        d = json.loads(raw) if raw else {}
        a = (d.get("kind") if path == "/team/cred" else d.get("installation_id")) or ""
        sys.stdout.write("OK\t%s\t%s" % (a, d.get("team_id") or ""))
except urllib.error.HTTPError as exc:
    raw = exc.read()
    try:
        d = json.loads(raw) if raw else {}
    except Exception:
        d = {}
    sys.stdout.write("HTTP\t%d\t%s" % (exc.code, d.get("error") or ""))
except Exception:  # noqa: BLE001 — any transport/TLS/DNS fault is a connect failure.
    sys.stdout.write("ERR\tconnect")
PYEOF
}

dispatch_cloud() {
  # fail-closed: a REAL cloud dispatch needs a configured target — never SSH a
  # guessed VM with the operator's live creds.
  if [ "$DRY" != 1 ] && [ "$REMOTE_CONFIGURED" != 1 ]; then
    die "no remote target configured — run: rr setup --vm <name> --zone <z> --project <p> [--repo <default>]"
  fi
  case "$CFG_MODE" in
    vm)             dispatch_vm ;;
    control-plane)  dispatch_cp ;;
    *)              die "unknown mode '$CFG_MODE' (expected vm|control-plane)" 2 ;;
  esac
}

# ── LOCAL fallback — run heimdall-maintain-loop on THIS box (clearly not cloud) ─
dispatch_local() {
  local loop="$BINDIR/heimdall-maintain-loop"
  # local --repo is a working DIRECTORY (a path override) or the current dir.
  local repo_dir="."
  [ -n "$REPO_OVERRIDE" ] && repo_dir="$REPO_OVERRIDE"
  warn "running LOCAL, not cloud (no cloud dispatch — this box does the work)"
  local cmd="HEIMDALL_MAINTAINER_RUNNER=hybrid HEIMDALL_JOB_RUNNER=subprocess $loop run --repo $repo_dir --max $MAXN"
  if [ "$DRY" = 1 ]; then
    say "would run the maintainer LOCALLY (fallback — not the cloud VM):"
    plan "$cmd"
    return 0
  fi
  [ -x "$loop" ] || die "local maintain-loop not found at $loop"
  say "running maintainer LOCALLY on this box (repo=$repo_dir, max=$MAXN)"
  HEIMDALL_MAINTAINER_RUNNER=hybrid HEIMDALL_JOB_RUNNER=subprocess \
    "$loop" run --repo "$repo_dir" --max "$MAXN"
}

# ── STATUS (control-plane) — the ACTIONABLE per-task read for CP mode ──────────
# The CP's per-team queue is NOT publicly readable — there is no public task-status
# route (the enqueue-only public surface deliberately exposes NO queue read; a
# team-scoped state read would be a new signed GFE-safe route + read primitive +
# isolation gate, materially more than a drop-in and NOT part of the shipped surface).
# So `rr status [<task-id>]` prints the ACTIONABLE fallback: the task id (when given),
# the server-derived team note, the exact `gh pr list` that shows the PR the drain
# opens, and the drain-cycle explanation (incl. the `rr connect` prerequisite) so a
# user knows WHERE the result appears and WHY it might not have yet.
do_status_cp() {
  say "recent rr dispatches:"
  if [ -s "$DISPATCH_LOG" ]; then
    tail -n 10 "$DISPATCH_LOG" | sed 's/^/    /'
  else
    printf '    (none yet)\n'
  fi

  [ -n "$TASK" ] && say "task id: $TASK"
  say "team: server-derived from your enrolled identity (INV-1 — the client holds no team_id)"
  say "the control plane's per-team queue is NOT publicly readable; a drained task becomes a PR on $CFG_REPO."

  say "watch for the PR the drain opens:"
  if [ "$DRY" = 1 ]; then
    plan "gh pr list --repo $CFG_REPO --state open"
  elif command -v gh >/dev/null 2>&1; then
    gh pr list --repo "$CFG_REPO" --state open 2>/dev/null | sed 's/^/    /' || true
  else
    plan "gh pr list --repo $CFG_REPO --state open   # install gh: https://cli.github.com"
  fi

  say "drain cycle: rr signs + enqueues your task → the gated worker (holding your team's Claude cred + GitHub App install) drains the queue and opens the PR as the App → a human merges."
  say "no PR yet? ensure you ran \`rr connect\` — it registers your team's cred + App install; without it the task enqueues but STRANDS (no install to open the PR)."
}

# ── STATUS — recent dispatches + open maintainer PRs + the remote log tail ─────
do_status() {
  # control-plane mode has no VM / SSH log to tail — its status is the per-task read.
  if [ "$CFG_MODE" = control-plane ]; then
    do_status_cp
    return 0
  fi

  say "recent rr dispatches:"
  if [ -s "$DISPATCH_LOG" ]; then
    tail -n 10 "$DISPATCH_LOG" | sed 's/^/    /'
  else
    printf '    (none yet)\n'
  fi

  say "open maintainer PRs:"
  if [ "$DRY" = 1 ]; then
    plan "gh pr list --repo $CFG_REPO --label maintainer --state open"
  elif command -v gh >/dev/null 2>&1; then
    gh pr list --repo "$CFG_REPO" --label maintainer --state open 2>/dev/null | sed 's/^/    /' || true
  else
    warn "gh not found — skipping the PR list"
  fi

  say "remote maintainer log (rr.log tail on $CFG_VM):"
  if [ "$DRY" = 1 ]; then
    plan "gcloud compute ssh $CFG_VM --zone $CFG_ZONE --project $CFG_PROJECT --tunnel-through-iap --command \"tail -n 20 \$HOME/.heimdall/rr.log\""
  elif [ "$REMOTE_CONFIGURED" = 1 ] && [ "$CFG_MODE" = vm ] && command -v gcloud >/dev/null 2>&1; then
    gcloud compute ssh "$CFG_VM" --zone "$CFG_ZONE" --project "$CFG_PROJECT" \
      --tunnel-through-iap --command "tail -n 20 \$HOME/.heimdall/rr.log 2>/dev/null || echo '(no remote log yet)'" \
      2>/dev/null | sed 's/^/    /' || warn "could not reach the VM (is it up + IAP authorized?)"
  else
    printf '    (configure a vm-mode remote to tail the cloud log — rr setup ...)\n'
  fi
}

# ── main flow (task/issue → file + dispatch) ───────────────────────────────────
main_dispatch() {
  if [ "$LOCAL" = 1 ]; then
    dispatch_local
    return 0
  fi

  # control-plane: the SIGNED enqueue IS the intake — no GitHub issue is filed (the
  # CP queue is the maintainer's native queue here). Dispatch straight to the signed
  # POST /rr-task client; it self-guards (enroll-first, dry-run, clear HTTP errors).
  if [ "$CFG_MODE" = control-plane ]; then
    dispatch_cp
    return 0
  fi

  # fail-closed BEFORE filing: a real cloud dispatch with no configured target
  # must not leave a filed issue behind.
  if [ "$DRY" != 1 ] && [ "$REMOTE_CONFIGURED" != 1 ]; then
    die "no remote target configured — run: rr setup --vm <name> --zone <z> --project <p> [--repo <default>]"
  fi

  if [ -n "$ISSUE" ]; then
    printf '%s' "$ISSUE" | grep -qE '^[0-9]+$' || die "--issue must be a number (got: $ISSUE)" 2
    ISSUE_REF="#$ISSUE"
    say "dispatching maintainer to drain existing issue $ISSUE_REF"
  else
    file_issue
  fi

  dispatch_cloud

  echo
  say "handoff complete — issue: ${ISSUE_REF:-?} · dispatched to: $([ "$CFG_MODE" = vm ] && echo "$CFG_VM" || echo control-plane)"
  say "watch it:  rr status   ·   gh pr list --repo $CFG_REPO --label maintainer"
}

case "$CMD" in
  setup)   do_setup ;;
  status)  do_status ;;
  connect) do_connect ;;
  "")      main_dispatch ;;
  *)       die "unknown subcommand: $CMD" 2 ;;
esac
exit 0
