#!/usr/bin/env bash
# skill-manager — project-aware plugin lifecycle for heimdall
# Enables plugins needed for current project, disables the rest.
# State stored in ~/.claude/settings.json under enabledPlugins.
#
# RESTORE FILES. `activate` records what it paused in a restore file and `restore` undoes exactly
# that. The two are separate processes, so they must agree on the file's path WITHOUT sharing a
# pid: the path is a pure function of an OWNER (the launcher's pid), printed by `restore-file`,
# and the caller hands it to both halves. It used to be built from this script's own `$$`, so
# every call named a different file, `restore` found nothing and the skills were never restored.
# The state logic lives in bin/lib/skill_restore.py (restore format, recovery of the files of
# launchers that died, locking).
set -eo pipefail

SELF="$0"
if command -v readlink &>/dev/null; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
PLUGIN_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
# Prefer heimdall-skills.json; fall back to legacy superx-skills.json (back-compat).
CONFIG="$PLUGIN_DIR/heimdall-skills.json"
[ -f "$CONFIG" ] || [ ! -f "$PLUGIN_DIR/superx-skills.json" ] || CONFIG="$PLUGIN_DIR/superx-skills.json"
SETTINGS="$HOME/.claude/settings.json"
STATE_PY="$PLUGIN_DIR/bin/lib/skill_restore.py"
# One <owner-pid>.json per launch, in a private per-user dir: the recovery of a dead launcher's
# file applies its contents to settings.json, so it must not live where another local user can
# plant one (/tmp), and it must outlast a reboot after a crash.
RESTORE_DIR="${HEIMDALL_HOME:-$HOME/.heimdall}/skill-restore"

# restore_path OWNER-PID — the restore file of that owner. Pure: every call, in any process, agrees.
restore_path() {
  printf '%s/%s.json\n' "$RESTORE_DIR" "$1"
}

G='\033[38;2;78;204;163m'
D='\033[38;2;100;100;120m'
C='\033[38;2;0;212;255m'
P='\033[38;2;224;86;160m'
R='\033[0m'

# cmd_activate [dir] [restore-file] — pause what the project does not need; the undo goes to
# restore-file (default: the one owned by the calling process).
cmd_activate() {
  local project_dir="${1:-.}" restore_file="${2:-}"
  [ -n "$restore_file" ] || restore_file="$(restore_path "$PPID")"

  [ -f "$CONFIG" ] || return 0
  [ -f "$SETTINGS" ] || return 0
  [ -f "$STATE_PY" ] || return 0
  command -v python3 &>/dev/null || return 0

  python3 "$STATE_PY" activate "$CONFIG" "$SETTINGS" "$project_dir" "$restore_file" "$RESTORE_DIR"
}

# cmd_restore [restore-file] — undo that activation (default: the file owned by the calling process).
cmd_restore() {
  local restore_file="${1:-}"
  [ -n "$restore_file" ] || restore_file="$(restore_path "$PPID")"

  [ -f "$restore_file" ] || return 0
  [ -f "$SETTINGS" ] || return 0
  [ -f "$STATE_PY" ] || return 0
  command -v python3 &>/dev/null || return 0

  python3 "$STATE_PY" restore "$SETTINGS" "$restore_file" "$RESTORE_DIR"
}

# cmd_restore_file [owner-pid] — print the restore file for an owner (default: the calling process).
cmd_restore_file() {
  local owner="${1:-$PPID}"
  case "$owner" in
    ''|*[!0-9]*|0*)
      echo "skill-manager: restore-file: the owner must be a positive pid, got '$owner'" >&2
      return 2 ;;
  esac
  restore_path "$owner"
}

cmd_status() {
  local project_dir="${1:-.}"

  [ -f "$CONFIG" ] || { echo "No config: $CONFIG"; return 1; }
  command -v python3 &>/dev/null || { echo "python3 required"; return 1; }

  python3 <<PYEOF
import json, glob, os

config_path = "$CONFIG"
settings_path = "$SETTINGS"
project_dir = "$project_dir"

with open(config_path) as f:
    config = json.load(f)

enabled = {}
if os.path.exists(settings_path):
    with open(settings_path) as f:
        enabled = json.load(f).get("enabledPlugins", {})

print("PERMANENT:")
for p in config.get("permanent", []):
    state = "on" if enabled.get(p, True) else "OFF"
    print(f"  {state}  {p}")

print()
print("DETECTED:")
for rule_name, rule in config.get("detection", {}).items():
    patterns = rule.get("files", [])
    matched = False
    for pattern in patterns:
        if glob.glob(os.path.join(project_dir, pattern)) or \
           glob.glob(os.path.join(project_dir, "*", pattern)) or \
           glob.glob(os.path.join(project_dir, "src", "**", pattern), recursive=True):
            matched = True
            break
    mark = "✔" if matched else "·"
    plugins = rule.get("plugins", [])
    states = []
    for p in plugins:
        s = "on" if enabled.get(p, True) else "off"
        states.append(f"{p}({s})")
    print(f"  {mark} {rule_name}: {', '.join(states)}")

print()
print("ON-DEMAND:")
for p in config.get("on_demand", []):
    state = "on" if enabled.get(p, True) else "off"
    print(f"  {state}  {p}")
PYEOF
}

cmd_print_summary() {
  local result="$1"
  local status active paused on off
  IFS='|' read -r status active paused on off <<< "$result"

  if [ "$status" = "CHANGED" ]; then
    printf "  ${G}▸${R} Skills: ${C}%s active${R}, ${D}%s paused${R}\n" "$active" "$paused"
    if [ -n "$on" ]; then
      printf "  ${D}  + %s${R}\n" "$(echo "$on" | tr ',' ' ')"
    fi
    if [ -n "$off" ]; then
      printf "  ${D}  − %s${R}\n" "$(echo "$off" | tr ',' ' ')"
    fi
  else
    printf "  ${G}▸${R} Skills: ${C}%s active${R}, ${D}%s paused${R}\n" "$active" "$paused"
  fi
}

case "${1:-}" in
  activate)
    result=$(cmd_activate "${2:-.}" "${3:-}")
    # Nothing to activate (no settings, no config, no python, no place for the undo): say nothing,
    # rather than a "Skills:  active,  paused" line with the numbers missing.
    [ -z "$result" ] || cmd_print_summary "$result"
    ;;
  activate-quiet)
    cmd_activate "${2:-.}" "${3:-}" > /dev/null
    ;;
  restore)
    cmd_restore "${2:-}"
    ;;
  status)
    cmd_status "${2:-.}"
    ;;
  restore-file)
    cmd_restore_file "${2:-}"
    ;;
  *)
    echo "Usage: skill-manager {activate|restore|restore-file|status} [args]"
    echo ""
    echo "  activate [dir] [restore-file]  Enable project-needed plugins, disable rest;"
    echo "                                 the undo is recorded in restore-file"
    echo "  restore [restore-file]         Undo that activation (only what it changed)"
    echo "  restore-file [owner-pid]       Print the restore file of an owner (default: the caller)"
    echo "  status [dir]                   Show which plugins would be active"
    ;;
esac
