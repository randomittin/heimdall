#!/usr/bin/env bash
# heimdall-gate-surface — TEAM MODE P2 (Shared Gate Surface): the git-backed
# verdict record. "The team sees what is PROVEN and what is BLOCKED."
#
# This is the verification differentiator fused into team mode. It EXTENDS P1's
# activity record (bin/heimdall-activity) — it does NOT build a parallel system.
# P1 answers "who is working where"; P2 answers "what is PROVEN where". The team
# view (bin/heimdall-who team --gates) JOINs the two: each active dev's task +
# their gate verdict.
#
# THE SOURCE OF THE VERDICT (never synthesized): SI-2's per-commit attestation
# (bin/heimdall-attest → bin/lib/attestation.py) records each task's gate evidence
# with REAL exit codes. `evidence.all_passed` is the honest verdict — a boolean
# over the actual exit codes of the acceptance/test/build commands the emitter
# RAN. P2 reads that recorded verdict; it NEVER manufactures a "probably fine".
#
# WHY A REPUBLISH IS NEEDED: SI-2's store (.heimdall/attestations/) is GITIGNORED
# runtime state, so a sibling checkout can NOT read another dev's attestation
# directly. P2 republishes a SECRET-FREE verdict SUMMARY into the git-tracked
# ledger so siblings can read it across checkouts (git is the shared substrate,
# same as P1's activity store). One file per HAID:
#   .planning/ledger/verdicts/{haid-slug}.json — one writer per file →
#   conflict-free git merges (the exact pattern claims/ + activity/ use).
#
# WHAT IS PUBLISHED (secret-free by construction): gate NAMES, each gate's
# pass/fail, the overall verdict (PROVEN | BLOCKED | PENDING), and a receipt LOC
# (e.g. cards.ts:5) — NEVER code, NEVER stdout/stderr, NEVER a secret. The SI-2
# evidence carries a stdout_tail that may hold output; P2 DROPS it and copies only
# the scrubbed command label + a derived source loc. Every field passes the same
# secret-by-construction scrub bin/lib/telemetry._scrub uses (bound + gitleaks
# high-signal reject), so a credential can never enter the git-tracked record.
#
# THE VERDICT (honest — real exit codes, no fabrication):
#   PROVEN  ✓  evidence ran AND every gate passed (all_passed == true)
#   BLOCKED ⛔  evidence ran AND a gate failed (names the gate + loc)
#   PENDING ·  no evidence ran yet (no gate command was recorded) — NEVER an
#              invented pass. An unproven change is honestly "pending".
#
# Solo / feature-off: with HEIMDALL_TEAM=off (or 0/false/no/disabled) `publish`
# is a graceful no-op (exit 0, no record written); read views show nothing new —
# byte-identical to a no-team world. Opt-in, lazy, graceful.
#
# Usage:
#   heimdall-gate-surface publish [--id <attest-id>] [--attest <file>]
#                                 [--repo <dir>] [--haid <h>] [--task <ref>]
#                                 [--ttl <min>]
#                                   read SI-2's recorded verdict for THIS
#                                   instance + republish a secret-free summary
#                                   into the git-tracked verdicts/ store.
#   heimdall-gate-surface retract [--haid <h>]   drop this instance's verdict
#   heimdall-gate-surface list [--json]          all sibling verdicts (TTL-filtered)
#   heimdall-gate-surface show [--haid <h>] [--json]   one instance's verdict
#   heimdall-gate-surface reap                   remove every TTL-expired verdict
#   -h, --help
#
# Conventions (match bin/heimdall-activity — pure bash + jq + python3, bash 3.2):
#   - jq required; absence is a hard exit 2. python3 used only to read SI-2.
#   - all writes atomic (mktemp + mv) under an mkdir-based lock.
#   - deterministic, human-readable output for auditability.
#
# Exit: 0 ok; 2 usage/IO error; 3 no SI-2 attestation found to publish.
set -euo pipefail

# ── Path resolution (mirrors bin/heimdall-activity) ──────────────────────────
SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$BIN_DIR/.." && pwd)"
PLANNING_DIR="${HEIMDALL_PLANNING_DIR:-$PLUGIN_DIR/.planning}"
LEDGER_DIR="$PLANNING_DIR/ledger"
VERDICTS_DIR="$LEDGER_DIR/verdicts"
DECISIONS_FILE="$LEDGER_DIR/decisions.md"
LOCK_FILE="$VERDICTS_DIR.lock"
LOCK_TIMEOUT=10
HAID_BIN="$BIN_DIR/heimdall-haid"
ATTEST_BIN="$BIN_DIR/heimdall-attest"
DEFAULT_TTL=30

command -v jq >/dev/null 2>&1 || { echo "error: jq is required" >&2; exit 2; }
PY="$(command -v python3 || command -v python || true)"

usage() { sed -n '2,70p' "$SELF" | sed 's/^# \{0,1\}//'; }
ts() { date -u +%FT%TZ; }
now_epoch() { date +%s; }

# ── Feature flag — solo/off is byte-identical to today (mirrors activity) ─────
team_enabled() {
  local flag
  flag="$(printf '%s' "${HEIMDALL_TEAM:-}" | tr '[:upper:]' '[:lower:]')"
  case "$flag" in
    off|0|false|no|disabled) return 1 ;;
    *) return 0 ;;
  esac
}

# Parse ISO8601 UTC → epoch (portable; identical helper to heimdall-activity).
iso_to_epoch() {
  local iso="$1" e
  e="$(date -u -d "$iso" +%s 2>/dev/null || true)"
  [ -n "$e" ] && { printf '%s' "$e"; return 0; }
  e="$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$iso" +%s 2>/dev/null || true)"
  [ -n "$e" ] && { printf '%s' "$e"; return 0; }
  jq -rn --arg t "$iso" '($t | fromdateiso8601?) // empty' 2>/dev/null || true
}

# ── Locking (mkdir-based; mirrors heimdall-activity) ─────────────────────────
acquire_lock() {
  local attempts=0
  while ! mkdir "$LOCK_FILE" 2>/dev/null; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge "$LOCK_TIMEOUT" ]; then
      if [ -d "$LOCK_FILE" ]; then
        local age
        age=$(( $(date +%s) - $(stat -f %m "$LOCK_FILE" 2>/dev/null || stat -c %Y "$LOCK_FILE" 2>/dev/null || echo 0) ))
        if [ "$age" -gt 30 ]; then
          echo "Breaking stale lock (${age}s old)" >&2
          rmdir "$LOCK_FILE" 2>/dev/null || true
          mkdir "$LOCK_FILE" 2>/dev/null && return 0
        fi
      fi
      echo "error: could not acquire lock on $VERDICTS_DIR after ${LOCK_TIMEOUT}s" >&2
      exit 2
    fi
    sleep 1
  done
}
release_lock() { rmdir "$LOCK_FILE" 2>/dev/null || true; }

ensure_dirs() { mkdir -p "$VERDICTS_DIR"; }

atomic_write() {
  local dest="$1" tmp template
  template="${TMPDIR:-/tmp}/verdict.$(printf 'X%.0s' 1 2 3 4 5 6)"
  tmp="$(mktemp "$template")"
  cat > "$tmp"
  mv -f "$tmp" "$dest"
}

# ── Identity (mirrors heimdall-activity) ─────────────────────────────────────
current_haid() {
  if [ -n "${HEIMDALL_HAID:-}" ]; then
    printf '%s' "$HEIMDALL_HAID"
    return 0
  fi
  [ -x "$HAID_BIN" ] || { echo "error: heimdall-haid not found at $HAID_BIN" >&2; exit 2; }
  "$HAID_BIN" current
}
haid_human() { printf '%s' "$1" | sed -E 's/^haid:([a-z0-9-]+)\..*/\1/'; }
haid_slug()  { printf '%s' "$1" | tr '/:' '__'; }
record_path() { printf '%s/%s.json' "$VERDICTS_DIR" "$(haid_slug "$1")"; }

# ── Secret-by-construction scrub (mirrors telemetry._scrub + activity) ───────
# Every value copied from SI-2 into the git-tracked record passes this. A value
# over the bound, or matching a gitleaks high-signal pattern, or shaped like an
# assigned credential, is SCRUBBED to a redaction token (never written verbatim).
# The republish copies only gate NAMES + locs + verdicts — but we defence-in-depth
# scrub each so a secret smuggled into a gate command/loc cannot reach the store.
SCRUB_MAX=120
SCRUB_REDACT="[redacted]"
secret_shaped() {
  local v="$1"
  [ "${#v}" -gt "$SCRUB_MAX" ] && return 0
  printf '%s' "$v" | grep -Eiq '(token|secret|password|passwd|pwd|api[_-]?key|apikey|access[_-]?key|auth|bearer|credential|private[_-]?key)[[:space:]]*[=:][[:space:]]*[^[:space:]]{16,}' && return 0
  printf '%s' "$v" | grep -Eq 'ghp_[A-Za-z0-9]{36}' && return 0
  printf '%s' "$v" | grep -Eq 'gh[oprsu]_[A-Za-z0-9]{36}' && return 0
  printf '%s' "$v" | grep -Eq 'AKIA[0-9A-Z]{16}' && return 0
  printf '%s' "$v" | grep -Eq 'sk_(live|test)_[A-Za-z0-9]{16,}' && return 0
  printf '%s' "$v" | grep -Eq 'xox[baprs]-[A-Za-z0-9-]{10,}' && return 0
  printf '%s' "$v" | grep -Eq -- '-----BEGIN[ A-Z]*PRIVATE KEY-----' && return 0
  printf '%s' "$v" | grep -Eq 'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}' && return 0
  return 1
}
# scrub_value <value> → echoes the value, or the redaction token if secret-shaped.
# Unlike heimdall-activity's reject-the-whole-publish (the user typed the field),
# here the source is an auto-derived SI-2 summary, so we redact the single field
# and keep the verdict useful — the secret still never reaches the store.
scrub_value() {
  local v="$1"
  if secret_shaped "$v"; then printf '%s' "$SCRUB_REDACT"; else printf '%s' "$v"; fi
}

# ── Liveness (mirrors heimdall-activity record_active) ───────────────────────
record_active() {
  local f="$1" hb ttl hb_e exp now
  [ -f "$f" ] || return 1
  hb="$(jq -r '.heartbeat // empty' "$f" 2>/dev/null || true)"
  ttl="$(jq -r '.ttl_minutes // 30' "$f" 2>/dev/null || echo 30)"
  [ -n "$hb" ] || return 1
  hb_e="$(iso_to_epoch "$hb")"
  [ -n "$hb_e" ] || return 1
  exp=$(( hb_e + ttl * 60 ))
  now="$(now_epoch)"
  [ "$now" -lt "$exp" ]
}

note_decision() {
  local title="$1" body="$2"
  mkdir -p "$LEDGER_DIR"
  {
    printf '\n## %s — %s\n\n' "$(ts)" "$title"
    printf '%s\n' "$body"
  } >> "$DECISIONS_FILE"
}

reap_expired() {
  local f haid verdict
  [ -d "$VERDICTS_DIR" ] || return 0
  for f in "$VERDICTS_DIR"/*.json; do
    [ -e "$f" ] || continue
    if ! record_active "$f"; then
      haid="$(jq -r '.haid // "unknown"' "$f" 2>/dev/null || echo unknown)"
      verdict="$(jq -r '.verdict // "unknown"' "$f" 2>/dev/null || echo unknown)"
      rm -f "$f"
      note_decision "verdict age-out (TTL/heartbeat expired)" \
        "Gate verdict for \`$haid\` (verdict \`$verdict\`) exceeded its TTL / heartbeat window and was aged out by \`heimdall-gate-surface reap\`. The instance is treated as exited/crashed."
    fi
  done
  return 0
}

# ── Read SI-2 attestation JSON for an id/file → the secret-free summary ───────
# Resolves the SI-2 record (explicit --attest file, or --id via heimdall-attest
# get, or the newest record in the store). Emits a SECRET-FREE verdict-summary
# JSON on stdout (no stdout_tail, no code) for the publisher to wrap. Exit 3 if
# no attestation can be found. python3 does the field extraction (no secrets pass
# through — only verdict/gate-name/loc), bash then scrubs each surviving string.
extract_summary() {
  local repo="$1" attest_file="$2" attest_id="$3" raw=""
  if [ -n "$attest_file" ]; then
    [ -f "$attest_file" ] || { echo "error: --attest file not found: $attest_file" >&2; exit 2; }
    raw="$(cat "$attest_file")"
  elif [ -x "$ATTEST_BIN" ]; then
    if [ -n "$attest_id" ]; then
      raw="$("$ATTEST_BIN" get "$attest_id" --repo "$repo" 2>/dev/null || true)"
    else
      local newest
      newest="$("$ATTEST_BIN" list --repo "$repo" 2>/dev/null | head -n 1 || true)"
      [ -n "$newest" ] && raw="$("$ATTEST_BIN" get "$newest" --repo "$repo" 2>/dev/null || true)"
    fi
  fi
  [ -n "$raw" ] || return 3
  [ -n "$PY" ] || { echo "error: python3 not found (required to read SI-2 attestation)" >&2; exit 2; }
  # Python derives the verdict + per-gate name/ok + a receipt loc, DROPPING
  # stdout_tail/code bodies. A failing gate's loc is the first changed public
  # symbol's source loc (path-basename:line) from contracts.surface, else the
  # first changed file. This is identity + location ONLY — never code.
  # The SI-2 record is passed via env (ATTEST_RAW), NOT stdin: a heredoc-fed python
  # already owns stdin, so the record must travel out-of-band.
  ATTEST_RAW="$raw" "$PY" - <<'PYEOF'
import json, os, sys
try:
    rec = json.loads(os.environ.get("ATTEST_RAW", ""))
except Exception:
    print("{}"); sys.exit(0)

ev = rec.get("evidence", {}) or {}
checks = ev.get("checks", []) or []
ran = ev.get("ran", len(checks))
all_passed = bool(ev.get("all_passed"))

# Verdict from the REAL recorded evidence — never synthesized.
if not checks or ran == 0:
    verdict = "PENDING"
elif all_passed:
    verdict = "PROVEN"
else:
    verdict = "BLOCKED"

# A receipt loc: first changed public symbol's basename:line (contracts.surface
# carries the symbol; its by_file span gives the line), else first changed file.
def first_loc():
    contracts = rec.get("contracts", {}) or {}
    by_file = contracts.get("by_file", []) or []
    for bf in by_file:
        path = bf.get("path")
        for s in (bf.get("symbols") or []):
            span = s.get("span")
            if path and isinstance(span, list) and span:
                line = span[0]
                try:
                    line = int(line)
                except Exception:
                    continue
                return "%s:%d" % (os.path.basename(path), line)
    claims = rec.get("claims", {}) or {}
    files = claims.get("files", []) or []
    if files:
        return os.path.basename(files[0].get("path", "")) or None
    return None

loc = first_loc()

# Per-gate summary: NAME (the command label) + ok, NO stdout_tail / no code body.
# A gate "name" is the bare command (first token sequence), bounded — the scrub
# in bash redacts anything secret-shaped after this.
gates = []
failing = []
for c in checks:
    cmd = (c.get("cmd") or "").strip()
    ok = bool(c.get("ok"))
    name = cmd.split(" ")[0] if cmd else "gate"
    gates.append({"name": name, "ok": ok, "cmd": cmd})
    if not ok:
        failing.append(name)

out = {
    "verdict": verdict,
    "gates_total": len(gates),
    "gates_passed": sum(1 for g in gates if g["ok"]),
    "gates_failed": sum(1 for g in gates if not g["ok"]),
    "gates": gates,
    "failing_gates": failing,
    "loc": loc,
    "task": rec.get("task") or "",
    "commit": rec.get("commit") or "",
    "schema": rec.get("schema") or "",
}
print(json.dumps(out))
PYEOF
}

# ── Subcommands ──────────────────────────────────────────────────────────────
[ $# -ge 1 ] || { echo "error: a subcommand is required" >&2; usage >&2; exit 2; }
cmd="$1"; shift || true

case "$cmd" in
  -h|--help)
    usage; exit 0 ;;

  publish)
    if ! team_enabled; then
      echo "team mode off (HEIMDALL_TEAM) — gate verdict publish is a no-op"
      exit 0
    fi
    attest_id=""; attest_file=""; repo="$PLUGIN_DIR"; haid_override=""; task_override=""; ttl="$DEFAULT_TTL"
    while [ $# -gt 0 ]; do
      case "$1" in
        --id)     attest_id="${2:?--id needs a value}"; shift 2 ;;
        --attest) attest_file="${2:?--attest needs a file}"; shift 2 ;;
        --repo)   repo="${2:?--repo needs a dir}"; shift 2 ;;
        --haid)   haid_override="${2:?--haid needs a value}"; shift 2 ;;
        --task)   task_override="${2:?--task needs a value}"; shift 2 ;;
        --ttl)    ttl="${2:?--ttl needs a value}"; shift 2 ;;
        -*) echo "error: unknown flag: $1" >&2; exit 2 ;;
        *)  echo "error: unexpected argument: $1" >&2; exit 2 ;;
      esac
    done
    case "$ttl" in (*[!0-9]*|'') echo "error: --ttl must be a positive integer (minutes)" >&2; exit 2 ;; esac
    [ "$ttl" -ge 1 ] || { echo "error: --ttl must be >= 1" >&2; exit 2; }

    # Read SI-2's RECORDED verdict (the source of truth). Exit 3 if none found —
    # we never fabricate a verdict for a task with no attestation.
    set +e
    summary="$(extract_summary "$repo" "$attest_file" "$attest_id")"
    ex=$?
    set -e
    if [ "$ex" -eq 3 ] || [ -z "$summary" ]; then
      echo "error: no SI-2 attestation found to publish (run heimdall-attest emit first, or pass --attest <file>)" >&2
      exit 3
    fi
    [ "$ex" -eq 0 ] || exit "$ex"

    if [ -n "$haid_override" ]; then haid="$haid_override"; else haid="$(current_haid)"; fi
    human="$(haid_human "$haid")"

    verdict="$(printf '%s' "$summary" | jq -r '.verdict // "PENDING"')"
    loc_raw="$(printf '%s' "$summary" | jq -r '.loc // empty')"
    task_raw="$task_override"; [ -n "$task_raw" ] || task_raw="$(printf '%s' "$summary" | jq -r '.task // empty')"
    commit_raw="$(printf '%s' "$summary" | jq -r '.commit // empty')"

    # Scrub every free-ish string before it enters the git-tracked record.
    loc="$(scrub_value "$loc_raw")"
    task="$(scrub_value "$task_raw")"
    commit="$(scrub_value "$commit_raw")"

    # Scrub each gate name (defence in depth) and rebuild the gates array WITHOUT
    # the raw cmd/stdout — only {name, ok}. failing_gates names are scrubbed too.
    gates_json="$(printf '%s' "$summary" | jq -c '[.gates[]? | {name:.name, ok:.ok}]')"
    scrubbed_gates='[]'
    gn_count="$(printf '%s' "$gates_json" | jq 'length')"
    i=0
    while [ "$i" -lt "$gn_count" ]; do
      gname="$(printf '%s' "$gates_json" | jq -r ".[$i].name")"
      gok="$(printf '%s' "$gates_json" | jq -r ".[$i].ok")"
      gname_s="$(scrub_value "$gname")"
      scrubbed_gates="$(printf '%s' "$scrubbed_gates" | jq -c --arg n "$gname_s" --argjson ok "$gok" '. + [{name:$n, ok:$ok}]')"
      i=$((i + 1))
    done

    # failing gate names (scrubbed) — the receipt's "which gate" for BLOCKED.
    failing_json="$(printf '%s' "$summary" | jq -c '.failing_gates // []')"
    scrubbed_failing='[]'
    fn_count="$(printf '%s' "$failing_json" | jq 'length')"
    i=0
    while [ "$i" -lt "$fn_count" ]; do
      fname="$(printf '%s' "$failing_json" | jq -r ".[$i]")"
      fname_s="$(scrub_value "$fname")"
      scrubbed_failing="$(printf '%s' "$scrubbed_failing" | jq -c --arg n "$fname_s" '. + [$n]')"
      i=$((i + 1))
    done

    gtotal="$(printf '%s' "$summary" | jq -r '.gates_total // 0')"
    gpassed="$(printf '%s' "$summary" | jq -r '.gates_passed // 0')"
    gfailed="$(printf '%s' "$summary" | jq -r '.gates_failed // 0')"

    ensure_dirs
    acquire_lock; trap release_lock EXIT
    reap_expired

    now="$(ts)"
    jq -n \
      --arg haid "$haid" --arg human "$human" \
      --arg verdict "$verdict" --arg task "$task" --arg commit "$commit" \
      --arg loc "$loc" --arg now "$now" --argjson ttl "$ttl" \
      --argjson gates "$scrubbed_gates" --argjson failing "$scrubbed_failing" \
      --argjson gtotal "$gtotal" --argjson gpassed "$gpassed" --argjson gfailed "$gfailed" \
      '{haid:$haid, human:$human, verdict:$verdict, task:$task, commit:$commit,
        gates_total:$gtotal, gates_passed:$gpassed, gates_failed:$gfailed,
        gates:$gates, failing_gates:$failing, loc:(if $loc=="" then null else $loc end),
        heartbeat:$now, ttl_minutes:$ttl}' \
      | atomic_write "$(record_path "$haid")"
    release_lock; trap - EXIT
    echo "published gate verdict for $haid: $verdict (${gpassed}/${gtotal} gates passed, ttl ${ttl}m)"
    ;;

  retract)
    haid=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --haid) haid="${2:?--haid needs a value}"; shift 2 ;;
        *) echo "error: unknown flag: $1" >&2; exit 2 ;;
      esac
    done
    [ -n "$haid" ] || haid="$(current_haid)"
    ensure_dirs
    acquire_lock; trap release_lock EXIT
    f="$(record_path "$haid")"
    if [ -f "$f" ]; then
      rm -f "$f"
      release_lock; trap - EXIT
      echo "retracted gate verdict for $haid"
    else
      release_lock; trap - EXIT
      echo "no gate verdict for $haid"
    fi
    ;;

  list)
    as_json=""
    [ "${1:-}" = "--json" ] && as_json=1
    ensure_dirs
    files=()
    for f in "$VERDICTS_DIR"/*.json; do
      [ -e "$f" ] || continue
      record_active "$f" && files+=("$f")
    done
    if [ -n "$as_json" ]; then
      if [ "${#files[@]}" -eq 0 ]; then echo '[]'; else jq -s '.' "${files[@]}"; fi
      exit 0
    fi
    if [ "${#files[@]}" -eq 0 ]; then echo "(no active team gate verdicts)"; exit 0; fi
    echo "TEAM GATE VERDICTS (${#files[@]})"
    jq -r '
      def sym: if .verdict=="PROVEN" then "✓" elif .verdict=="BLOCKED" then "⛔" else "·" end;
      "  \(.human): \(.task) \(.verdict) \(sym)"
      + (if .verdict=="PROVEN" then " (\(.gates_passed) gates)"
         elif .verdict=="BLOCKED" then " (\((.failing_gates // []) | join(", "))\(if .loc then ", \(.loc)" else "" end))"
         else "" end)' "${files[@]}"
    ;;

  show)
    haid=""; as_json=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --haid) haid="${2:?--haid needs a value}"; shift 2 ;;
        --json) as_json=1; shift ;;
        *) echo "error: unknown flag: $1" >&2; exit 2 ;;
      esac
    done
    [ -n "$haid" ] || haid="$(current_haid)"
    ensure_dirs
    f="$(record_path "$haid")"
    if [ ! -f "$f" ]; then
      [ -n "$as_json" ] && echo 'null' || echo "no gate verdict for $haid"
      exit 0
    fi
    if [ -n "$as_json" ]; then jq '.' "$f"; else
      jq -r '"haid: \(.haid)\nhuman: \(.human)\nverdict: \(.verdict)\ntask: \(.task)\ngates: \(.gates_passed)/\(.gates_total) passed"
        + (if .loc then "\nloc: \(.loc)" else "" end)
        + (if (.failing_gates // []) | length > 0 then "\nfailing: " + (.failing_gates | join(", ")) else "" end)' "$f"
    fi
    ;;

  reap)
    ensure_dirs
    acquire_lock; trap release_lock EXIT
    before=0
    for f in "$VERDICTS_DIR"/*.json; do [ -e "$f" ] && before=$((before + 1)); done
    reap_expired
    after=0
    for f in "$VERDICTS_DIR"/*.json; do [ -e "$f" ] && after=$((after + 1)); done
    release_lock; trap - EXIT
    echo "aged out $((before - after)) expired verdict(s); $after active verdict(s) remain"
    ;;

  *)
    echo "error: unknown subcommand: $cmd" >&2
    usage >&2
    exit 2 ;;
esac
