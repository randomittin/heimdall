#!/usr/bin/env bash
# heimdall-s6-sweep — S-6 Component 3 popular-10 cold generalization sweep RUNNER.
#
# The spend-gated, capped, staged HARNESS that runs the S-6 C3 breadth proof:
# for each repo in a manifest, cold-clone it, run `hmd "<task>"` against it,
# measure REUSE over the run's diff (bin/heimdall-reuse-metric), capture
# WORKING-OUTPUT evidence by running the repo's own baseline_cmd (regression) and
# the task's assertion_cmd (behavior) and recording PASS/FAIL with the QUOTED
# output (runnable evidence, NEVER the agent's self-report — R7); a task PASSES
# only when BOTH commands exit 0. It records the task's token spend, enforces a
# HARD spend
# cap (fail-closed), and is SAFE-BY-DEFAULT: with no mode flag it only DRY-RUNS.
#
# This harness does NOT decide the verdict — it produces HONEST numbers. A low
# reuse distribution is surfaced PROMINENTLY as the finding, never massaged.
#
# ── Manifest schema (consumed; emitted later by the C3 proposal agent into
#    docs/superpowers/specs/heimdall-S6-C3-repos.json) ──────────────────────────
#   A JSON ARRAY; each entry:
#     repo_url                 (string)  clone source
#     sha                      (string)  EXACT commit to check out (the audit's
#                                        deterministic pin — see SHA pinning below)
#     lang                     (string)  primary language (for the plan table)
#     license                  (string)  must be permissive — reported, not enforced
#     task_prompt              (string)  the realistic task handed to `hmd`
#     reused_symbols_expected  (array)   symbols a competent solution should reuse
#     baseline_cmd             (string)  the repo's OWN test/build — the regression
#                                        signal (exit 0 = the suite still passes)
#     assertion_cmd            (string)  a runnable task-specific check — exit 0 iff
#                                        the requested behavior is correct
#   repo_url, sha, task_prompt, baseline_cmd and assertion_cmd are REQUIRED; a
#   missing one is a hard usage error (exit 2) — we never sweep a half-specified
#   manifest. Both commands are DEFINED manifest commands (like a Makefile target),
#   run via `bash -c`; we NEVER `eval` a free-prose acceptance description.
#
# ── SHA pinning (the audit's root-cause fix) ──────────────────────────────────
#   A --depth 1 clone of a URL yields only HEAD, which DRIFTS over time — features
#   the probe assumes ABSENT may already have shipped, turning a real task into a
#   no-op and defeating the entire audit. So the runner does NOT trust HEAD: after
#   cloning it FETCHES + CHECKS OUT the manifest's exact `sha`, then ASSERTS
#   `git rev-parse HEAD == sha`. A manifest entry with NO `sha` is exactly the bug
#   that was fixed, so it is rejected fail-closed. The resolved SHA is recorded in
#   every per-repo result (provenance: the report proves which commit each result
#   came from).
#
# ── Staging (safe-by-default, like `hmd bench`) ───────────────────────────────
#   (no flags) / --dry-run   Validate manifest + PRINT the plan + per-task spend
#                            ESTIMATE. No clone, no hmd, no spend. (DEFAULT.)
#   --limit N                Run only the first N repos (the dry-1-2 stage).
#   --confirm-full           REQUIRED to run ALL entries (or more than --limit).
#                            Without it a full sweep aborts — it can never run the
#                            whole popular-10 unattended by accident.
#   --cap N                  HARD token cap across the sweep (default 600000).
#                            FAIL-CLOSED: before each task, if projected cumulative
#                            spend would exceed the cap, abort cleanly with a
#                            PARTIAL report. The cap is never blown.
#   --run-id ID              Report file stem (default: timestamp).
#
# ── Test seams (the ONLY mocking; used by test/s6-sweep.test.sh to stay free) ─
#   --clone-cmd CMD          Override the clone step: `CMD <repo_url> <dest>`.
#   --hmd-cmd CMD            Override the agent run: `CMD <repo_dir> <task_prompt>`;
#                            HEIMDALL_USAGE_OUT is exported into it so a fake hmd
#                            can write a known emitted usage record deterministically.
#   --spend-cmd CMD          Override the token-spend source: `CMD` echoes an int.
#   None of these are used in a real RJ-gated sweep; the defaults clone with git,
#   run the real `hmd` (which self-meters its OWN run's usage AT THE SOURCE and
#   writes the emitted record to HEIMDALL_USAGE_OUT — set before the run), and read
#   spend by normalizing THAT emitted record via bin/heimdall-tokens — the GENERAL
#   model-token meter — (total_tokens = input+output+cache_creation+cache_read).
#   The transcript-glob (`heimdall-tokens session --cwd`) source is REMOVED: it
#   guessed where/when a transcript landed and failed twice with spend=0. The full
#   breakdown is recorded per repo (token_usage); the fail-closed cap enforces on
#   total_tokens.
#
# ── Output ────────────────────────────────────────────────────────────────────
#   Machine-readable .planning/s6-sweep/<run-id>.json — per repo: reuse_pct,
#   working_output{pass,evidence}, token_spend — plus a human summary table
#   (reuse-% distribution, working-output rate, total spend). Reported honestly,
#   low numbers included.
#
# Exit: 0 clean (incl. dry-run); 2 usage / malformed manifest; nonzero when a real
#       sweep aborts on the cap or the --confirm-full gate (fail-closed).
set -euo pipefail

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$BIN_DIR/.." && pwd)"
METRIC="$BIN_DIR/heimdall-reuse-metric"
OUT_DIR="${HEIMDALL_PLANNING_DIR:-$PLUGIN_DIR/.planning}/s6-sweep"

# ── Colors (truecolor with plain fallback, matching the other bins) ───────────
if [ "${COLORTERM:-}" = "truecolor" ] || [ "${COLORTERM:-}" = "24bit" ] || case "${TERM:-}" in *256color*) true ;; *) false ;; esac; then
  P='\033[38;2;224;86;160m'; C='\033[38;2;0;212;255m'; G='\033[38;2;78;204;163m'
  W='\033[38;2;255;200;80m'; D='\033[38;2;100;100;120m'
else
  P='\033[35m'; C='\033[36m'; G='\033[32m'; W='\033[33m'; D='\033[37m'
fi
B='\033[1m'; R='\033[0m'

usage() { sed -n '2,82p' "$SELF" | sed 's/^# \{0,1\}//'; }

# ── Defaults ──────────────────────────────────────────────────────────────────
MANIFEST=""
MODE="dry"            # dry | run
LIMIT=""              # empty => all entries
CONFIRM_FULL=0
CAP=600000
RUN_ID=""
CLONE_CMD=""
HMD_CMD=""
SPEND_CMD=""

while [ $# -gt 0 ]; do
  case "$1" in
    --manifest)     MANIFEST="${2:?--manifest needs a file}"; shift 2 ;;
    --dry-run|--dry) MODE="dry"; shift ;;
    --confirm-full) CONFIRM_FULL=1; MODE="run"; shift ;;
    --limit)        LIMIT="${2:?--limit needs N}"; MODE="run"; shift 2 ;;
    --cap)          CAP="${2:?--cap needs N}"; shift 2 ;;
    --run-id)       RUN_ID="${2:?--run-id needs a value}"; shift 2 ;;
    --clone-cmd)    CLONE_CMD="${2:?--clone-cmd needs a command}"; shift 2 ;;
    --hmd-cmd)      HMD_CMD="${2:?--hmd-cmd needs a command}"; shift 2 ;;
    --spend-cmd)    SPEND_CMD="${2:?--spend-cmd needs a command}"; shift 2 ;;
    -h|--help)      usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo "error: jq is required" >&2; exit 2; }
[ -n "$MANIFEST" ] || { echo "error: --manifest is required" >&2; usage >&2; exit 2; }

# ── stdin manifest ('-') — the spec-adapter glue ──────────────────────────────
# `heimdall-s6-manifest spec.json | heimdall-s6-sweep --manifest -` lets the C3
# spec flow straight into the runner. The runner makes MANY jq passes over the
# manifest, but a pipe can be read only once, so we copy '-' into a temp regular
# file up front; every downstream pass then sees an ordinary file and the existing
# (file-path) contract is unchanged. Cleaned up on exit.
if [ "$MANIFEST" = "-" ]; then
  STDIN_MANIFEST="$(mktemp -t s6-sweep-manifest)"
  trap 'rm -f "$STDIN_MANIFEST"' EXIT
  cat - > "$STDIN_MANIFEST"
  MANIFEST="$STDIN_MANIFEST"
fi
[ -f "$MANIFEST" ] || { echo "error: manifest not found: $MANIFEST" >&2; exit 2; }
[ -x "$METRIC" ] || { echo "error: reuse metric not executable at $METRIC" >&2; exit 2; }

case "$CAP" in (*[!0-9]*|'') echo "error: --cap must be a non-negative integer" >&2; exit 2 ;; esac
if [ -n "$LIMIT" ]; then
  case "$LIMIT" in (*[!0-9]*|'') echo "error: --limit must be a non-negative integer" >&2; exit 2 ;; esac
fi

# ── Validate the manifest shape (a half-specified manifest is a hard error) ───
if ! jq -e 'type == "array" and length > 0' "$MANIFEST" >/dev/null 2>&1; then
  echo "error: manifest must be a non-empty JSON array of repo entries" >&2
  exit 2
fi
# Every entry must carry the five REQUIRED fields (repo_url, sha, task_prompt,
# baseline_cmd, assertion_cmd) as non-empty strings. jq returns the index of the
# first bad one. `sha` is REQUIRED fail-closed: a pinless entry would silently
# clone HEAD — the exact drift bug the audit fixed — so we refuse to sweep without
# it. baseline_cmd + assertion_cmd are the two runnable acceptance commands; an
# entry missing either is fail-closed the same way (we cannot prove the behavior).
BAD_IDX="$(jq -r '
  [ to_entries[]
    | select(
        ((.value.repo_url // "")       | type != "string" or . == "")
        or ((.value.sha // "")           | type != "string" or . == "")
        or ((.value.task_prompt // "")   | type != "string" or . == "")
        or ((.value.baseline_cmd // "")  | type != "string" or . == "")
        or ((.value.assertion_cmd // "") | type != "string" or . == "")
      )
    | .key ] | (.[0] // "ok")
' "$MANIFEST")"
if [ "$BAD_IDX" != "ok" ]; then
  echo "error: manifest entry $BAD_IDX is missing a required field (repo_url, sha, task_prompt, baseline_cmd, assertion_cmd)" >&2
  echo "       a pinless entry would silently clone HEAD — the drift bug the SHA pin fixes (fail-closed)." >&2
  exit 2
fi

TOTAL_ENTRIES="$(jq 'length' "$MANIFEST")"

# Effective number of entries to act on (--limit clamps; empty => all).
if [ -n "$LIMIT" ] && [ "$LIMIT" -lt "$TOTAL_ENTRIES" ]; then
  N_EFFECTIVE="$LIMIT"
else
  N_EFFECTIVE="$TOTAL_ENTRIES"
fi

# Per-task spend ESTIMATE for the dry-run plan: the cap divided evenly across all
# entries, an honest "if the budget were shared equally" figure — the cap is the
# real bound, this is only a planning estimate.
EST_PER_TASK=$(( CAP / TOTAL_ENTRIES ))

# ─────────────────────────────────────────────────────────────────────────────
# DRY-RUN — validate + print the plan + per-task spend estimate. Spend NOTHING.
# ─────────────────────────────────────────────────────────────────────────────
if [ "$MODE" = "dry" ]; then
  printf "${P}${B}heimdall-s6-sweep${R} — ${B}DRY-RUN${R} (no clone, no hmd, no spend)\n"
  printf "  manifest : %s\n" "$MANIFEST"
  printf "  entries  : %s   ${D}(spend cap %s tokens, fail-closed)${R}\n" "$TOTAL_ENTRIES" "$CAP"
  printf "  estimate : ~%s tokens/task ${D}(cap / entries — planning figure only)${R}\n\n" "$EST_PER_TASK"
  printf "  ${B}%-3s %-24s %-10s %-6s %-9s %-11s %s${R}\n" "#" "repo_url" "sha" "lang" "license" "est_tokens" "task"
  i=0
  while [ "$i" -lt "$TOTAL_ENTRIES" ]; do
    url="$(jq -r ".[$i].repo_url" "$MANIFEST")"
    sha="$(jq -r ".[$i].sha" "$MANIFEST")"
    lang="$(jq -r ".[$i].lang // \"?\"" "$MANIFEST")"
    lic="$(jq -r ".[$i].license // \"?\"" "$MANIFEST")"
    task="$(jq -r ".[$i].task_prompt" "$MANIFEST")"
    # short url + short sha + short task for the table
    surl="$url"; [ "${#surl}" -gt 23 ] && surl="...${surl: -20}"
    ssha="${sha:0:9}"
    stask="$task"; [ "${#stask}" -gt 40 ] && stask="${stask:0:37}..."
    marker=" "
    [ "$i" -lt "$N_EFFECTIVE" ] && marker="${G}▸${R}"
    printf "  ${marker}%-3s %-24s %-10s %-6s %-9s %-11s %s\n" "$((i+1))" "$surl" "$ssha" "$lang" "$lic" "$EST_PER_TASK" "$stask"
    i=$((i+1))
  done
  echo
  if [ -n "$LIMIT" ]; then
    printf "  plan: run the first ${B}%s${R} of %s repos (the staged dry-1-2 slice).\n" "$N_EFFECTIVE" "$TOTAL_ENTRIES"
  else
    printf "  plan: a full sweep would run all ${B}%s${R} repos.\n" "$TOTAL_ENTRIES"
  fi
  printf "  ${W}to run for real:${R} re-invoke WITHOUT --dry-run; a FULL sweep additionally requires ${B}--confirm-full${R}.\n"
  printf "  ${D}nothing was cloned, no model was called, zero tokens spent.${R}\n"
  exit 0
fi

# ─────────────────────────────────────────────────────────────────────────────
# REAL RUN — gated. A full sweep (acting on ALL entries) demands --confirm-full.
# ─────────────────────────────────────────────────────────────────────────────
if [ "$N_EFFECTIVE" -ge "$TOTAL_ENTRIES" ] && [ "$CONFIRM_FULL" -ne 1 ]; then
  echo "error: a FULL sweep over all $TOTAL_ENTRIES repos requires --confirm-full" >&2
  echo "       (use --limit N to run a smaller staged slice, or --dry-run to preview)" >&2
  echo "       refusing to sweep the whole set unattended." >&2
  exit 3
fi

[ -n "$RUN_ID" ] || RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
mkdir -p "$OUT_DIR"
REPORT="$OUT_DIR/$RUN_ID.json"
WORK_ROOT="$(mktemp -d -t "s6-sweep.$(printf 'X%.0s' 1 2 3 4 5 6)")"
cleanup() { rm -rf "$WORK_ROOT"; }
trap cleanup EXIT

# ── clone step: injected --clone-cmd, else a real shallow git clone ───────────
# Clones the repo CONTENT only; the exact pinned commit is landed by checkout_sha
# below. A --depth 1 clone of a URL gives just HEAD, so the SHA may not yet be in
# the local object store — checkout_sha fetches it explicitly before checkout.
do_clone() {
  # $1 repo_url ; $2 dest
  if [ -n "$CLONE_CMD" ]; then
    $CLONE_CMD "$1" "$2"
  else
    git clone --filter=blob:none --no-checkout "$1" "$2"
  fi
}

# ── SHA checkout (the audit's deterministic pin) — ALWAYS real, never mocked ───
# After the repo is cloned, land the EXACT pinned commit and PROVE it:
#   1. fetch the sha explicitly (a shallow/no-checkout clone may not have it yet),
#   2. check it out (detached HEAD at the pin),
#   3. assert `git rev-parse HEAD == sha` — fail-closed if it drifts.
# Echoes the resolved HEAD sha on success; returns nonzero on any failure so the
# caller records a checkout-failed result instead of sweeping the wrong commit.
checkout_sha() {
  # $1 repo_dir ; $2 sha
  local dir="$1" sha="$2" head=""
  # Try a targeted fetch first (works for shallow clones lacking the object); if
  # the remote refuses by-sha fetch, fall back to an unshallow fetch of all refs.
  if ! git -C "$dir" fetch --depth 1 origin "$sha" >/dev/null 2>&1; then
    git -C "$dir" fetch --unshallow >/dev/null 2>&1 \
      || git -C "$dir" fetch --all --tags >/dev/null 2>&1 || true
  fi
  git -C "$dir" checkout --quiet --detach "$sha" >/dev/null 2>&1 \
    || git -C "$dir" checkout --quiet "$sha" >/dev/null 2>&1 \
    || return 1
  head="$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo "")"
  [ "$head" = "$sha" ] || return 1   # fail-closed: HEAD MUST equal the pin
  printf '%s\n' "$head"
}

# ── agent run: injected --hmd-cmd, else the real `hmd "<task>"` in the repo ────
# $3 is the per-repo usage-out path. We export HEIMDALL_USAGE_OUT so the run emits
# its OWN usage record there AT THE SOURCE (hmd self-meters its session_id+usage;
# see TOKEN-METRIC.md). The injected --hmd-cmd test seam also sees the env var, so
# a fake hmd can write a known emitted record to it deterministically.
do_hmd() {
  # $1 repo_dir ; $2 task_prompt ; $3 usage_out path
  if [ -n "$HMD_CMD" ]; then
    HEIMDALL_USAGE_OUT="$3" $HMD_CMD "$1" "$2"
  else
    ( cd "$1" && HEIMDALL_USAGE_OUT="$3" "$BIN_DIR/hmd" "$2" )
  fi
}

# ── token spend: injected --spend-cmd, else the REAL model-token usage of the run,
# read from the EMITTED usage record hmd wrote AT THE SOURCE.
#
# The default source is bin/heimdall-tokens (the GENERAL token-accounting meter,
# also consumed by P3, the statusline gauge, and the ~75%-savings claim — NOT a
# C3-only path). The mechanism: BEFORE do_hmd, the caller sets HEIMDALL_USAGE_OUT
# to a per-repo temp path; the run self-meters its OWN session usage and writes the
# locked record there (no transcript glob — the broken mechanism that failed twice
# with spend=0 is GONE). do_token_record then normalizes THAT emitted record via
# `heimdall-tokens emitted <file>`. The cap figure (do_spend) is the record's
# total_tokens (input+output+cache_creation+cache_read — full consumption,
# conservative). The FULL breakdown is recorded in the per-repo result for
# provenance (real measured spend, never 0). Fail OPEN: a missing/malformed emitted
# record degrades to a zeros record (the meter's contract), never aborting the
# sweep.
#
# do_token_record echoes a JSON record (the meter's normalized emitted record, or a
# synthetic one wrapping an injected --spend-cmd integer so the report still
# carries provenance under the deterministic test seam).
do_token_record() {
  # $1 usage-out path (where this run emitted its own usage record)
  if [ -n "$SPEND_CMD" ]; then
    # Test seam: --spend-cmd echoes an integer. Wrap it into a record so the
    # report's full breakdown is well-formed (total_tokens == the injected int).
    local injected
    injected="$($SPEND_CMD 2>/dev/null || echo 0)"
    case "$injected" in (*[!0-9]*|'') injected=0 ;; esac
    jq -cn --argjson t "$injected" \
      '{input_tokens:0, output_tokens:0, cache_creation_tokens:0,
        cache_read_tokens:0, total_tokens:$t, turns:0, session_id:null,
        total_cost_usd:null, note:"spend injected via --spend-cmd (test seam)"}'
  elif [ -x "$BIN_DIR/heimdall-tokens" ]; then
    # the run's REAL token usage from the EMITTED record it wrote at the source
    # (fail-open: the meter emits a degraded zeros record on any problem, so this
    # never aborts).
    "$BIN_DIR/heimdall-tokens" emitted "$1" 2>/dev/null \
      || echo '{"total_tokens":0,"error":"heimdall-tokens invocation failed"}'
  else
    echo '{"total_tokens":0,"error":"heimdall-tokens not available"}'
  fi
}

# The cap-enforced spend figure: the token record's total_tokens (fail-closed cap
# is checked on this). Degrades to 0 if the record lacks a numeric total_tokens.
do_spend() {
  # $1 token-record JSON
  printf '%s' "$1" | jq -r '.total_tokens // 0' 2>/dev/null || echo 0
}

# ── clamp a captured command's output so a noisy suite cannot bloat the report ─
# Keeps the head + tail and marks the elision; short output passes through whole.
clamp_evidence() {
  local s="$1"
  if [ "${#s}" -gt 2000 ]; then
    printf '%s' "${s:0:1000}"$'\n...[truncated]...\n'"${s: -900}"
  else
    printf '%s' "$s"
  fi
}

# results accumulate as a JSON array file (one object appended per task).
RESULTS_FILE="$WORK_ROOT/results.jsonl"
: > "$RESULTS_FILE"
TOTAL_SPEND=0
RAN=0
ABORTED=false
ABORT_REASON=""

printf "${P}${B}heimdall-s6-sweep${R} — running ${B}%s${R} of %s repos ${D}(cap %s, fail-closed)${R}\n" \
  "$N_EFFECTIVE" "$TOTAL_ENTRIES" "$CAP" >&2

i=0
while [ "$i" -lt "$N_EFFECTIVE" ]; do
  url="$(jq -r ".[$i].repo_url" "$MANIFEST")"
  sha="$(jq -r ".[$i].sha" "$MANIFEST")"
  task="$(jq -r ".[$i].task_prompt" "$MANIFEST")"
  baseline="$(jq -r ".[$i].baseline_cmd" "$MANIFEST")"
  assertion="$(jq -r ".[$i].assertion_cmd" "$MANIFEST")"
  expect="$(jq -c ".[$i].reused_symbols_expected // []" "$MANIFEST")"

  # ── HARD CAP, FAIL-CLOSED: before starting, project this task's spend against
  #    the remaining budget. If we cannot afford even the per-task estimate,
  #    abort cleanly with a partial report — never start a task that blows it. ──
  PROJECTED=$(( TOTAL_SPEND + EST_PER_TASK ))
  if [ "$PROJECTED" -gt "$CAP" ]; then
    ABORTED=true
    ABORT_REASON="projected spend $PROJECTED would exceed cap $CAP before task $((i+1))"
    printf "  ${W}CAP REACHED${R} — %s. Aborting with a partial report.\n" "$ABORT_REASON" >&2
    break
  fi

  printf "  ${C}[%s/%s]${R} %s\n" "$((i+1))" "$N_EFFECTIVE" "$url" >&2

  DEST="$WORK_ROOT/repo-$i"
  CLONE_RC=0
  do_clone "$url" "$DEST" >/dev/null 2>&1 || CLONE_RC=$?
  if [ "$CLONE_RC" -ne 0 ] || [ ! -d "$DEST/.git" ]; then
    jq -cn --arg url "$url" --arg sha "$sha" --arg task "$task" \
       '{repo_url:$url, pinned_sha:$sha, resolved_sha:null,
         task:$task, status:"clone-failed", reuse_pct:null,
         reused_symbols:[], working_output:{pass:false, evidence:"clone failed"},
         token_spend:0}' >> "$RESULTS_FILE"
    i=$((i+1)); continue
  fi

  # ── CHECK OUT THE EXACT PINNED SHA (fail-closed) ──
  # The audit's deterministic pin: we sweep the commit the manifest names, NOT the
  # clone's drifting HEAD. checkout_sha fetches + checks out the sha and asserts
  # `git rev-parse HEAD == sha`; on any failure we record checkout-failed and skip
  # — sweeping the wrong commit would defeat the pin (and the audit).
  RESOLVED_SHA=""
  if ! RESOLVED_SHA="$(checkout_sha "$DEST" "$sha")"; then
    printf "      ${W}CHECKOUT FAILED${R} — could not land pinned sha %s (skipping)\n" "$sha" >&2
    jq -cn --arg url "$url" --arg sha "$sha" --arg task "$task" \
       '{repo_url:$url, pinned_sha:$sha, resolved_sha:null,
         task:$task, status:"checkout-failed", reuse_pct:null,
         reused_symbols:[],
         working_output:{pass:false, evidence:("could not check out pinned sha " + $sha)},
         token_spend:0}' >> "$RESULTS_FILE"
    i=$((i+1)); continue
  fi
  printf "      ${D}pinned sha checked out: %s${R}\n" "$RESOLVED_SHA" >&2

  # snapshot HEAD before the run so the metric diffs the run's changes only.
  # (This is now the PINNED commit, asserted above to equal the manifest sha.)
  BASE="$(git -C "$DEST" rev-parse HEAD 2>/dev/null || echo "")"

  # ── run the agent against the cold repo ──
  # Per-repo usage-out path: the run self-meters its OWN usage AT THE SOURCE and
  # writes the emitted record here (set BEFORE the run, read after — no glob).
  USAGE_OUT="$WORK_ROOT/usage-$i.json"
  do_hmd "$DEST" "$task" "$USAGE_OUT" >/dev/null 2>&1 || true

  # ── measure REUSE over the run's diff (real metric, never canned) ──
  RID="${RUN_ID}-repo$i"
  REUSE_JSON="$DEST/.planning/reuse/$RID.json"
  if [ -n "$BASE" ]; then
    "$METRIC" --repo "$DEST" --base "$BASE" --task "$task" --run-id "$RID" --quiet >/dev/null 2>&1 || true
  fi
  if [ -f "$REUSE_JSON" ]; then
    REUSE_PCT="$(jq -c '.reuse_pct' "$REUSE_JSON")"
    REUSE_SYMS="$(jq -c '[.reused_symbols[]?.symbol]' "$REUSE_JSON")"
  else
    REUSE_PCT="null"; REUSE_SYMS="[]"
  fi

  # ── WORKING-OUTPUT EVIDENCE: run the repo's OWN baseline_cmd (regression) then
  #    the task's assertion_cmd (behavior), capturing each exit status + QUOTED
  #    output. These are DEFINED manifest commands (like a Makefile target), run
  #    via `bash -c` in the cloned repo — NOT an `eval` of a free-prose acceptance
  #    description (the v2 landmine). This is runnable evidence (R7): we trust the
  #    commands' exit codes, NEVER the agent's self-report. A task PASSES only when
  #    BOTH the baseline AND the assertion exit 0. ──
  BASELINE_OUT="$( ( cd "$DEST" && bash -c "$baseline" ) 2>&1 )" && BASELINE_RC=0 || BASELINE_RC=$?
  if [ "$BASELINE_RC" -eq 0 ]; then BASELINE_PASS=true; else BASELINE_PASS=false; fi
  ASSERTION_OUT="$( ( cd "$DEST" && bash -c "$assertion" ) 2>&1 )" && ASSERTION_RC=0 || ASSERTION_RC=$?
  if [ "$ASSERTION_RC" -eq 0 ]; then ASSERTION_PASS=true; else ASSERTION_PASS=false; fi
  if [ "$BASELINE_PASS" = true ] && [ "$ASSERTION_PASS" = true ]; then WO_PASS=true; else WO_PASS=false; fi
  # quoted evidence of BOTH commands, clamped so a noisy suite cannot bloat the
  # report. Each half is clamped independently, then labelled.
  EVIDENCE="baseline_cmd (exit $BASELINE_RC):"$'\n'"$(clamp_evidence "$BASELINE_OUT")"$'\n'"assertion_cmd (exit $ASSERTION_RC):"$'\n'"$(clamp_evidence "$ASSERTION_OUT")"

  # ── token spend for this task: the REAL model-token usage of the run ──
  # do_token_record reads the EMITTED usage record this run wrote at the source
  # (USAGE_OUT, set before do_hmd — no transcript glob) and returns the FULL
  # breakdown; do_spend pulls total_tokens as the cap figure
  # (input+output+cache_creation+cache_read — full consumption, conservative). The
  # whole record is recorded for provenance so the report shows REAL measured
  # spend, never 0. Both fail OPEN (degraded zeros record), never aborting.
  TOKEN_REC="$(do_token_record "$USAGE_OUT" 2>/dev/null || echo '{"total_tokens":0,"error":"token record unavailable"}')"
  printf '%s' "$TOKEN_REC" | jq -e . >/dev/null 2>&1 \
    || TOKEN_REC='{"total_tokens":0,"error":"token record was not valid JSON"}'
  SPEND="$(do_spend "$TOKEN_REC" 2>/dev/null || echo 0)"
  case "$SPEND" in (*[!0-9]*|'') SPEND=0 ;; esac
  TOTAL_SPEND=$(( TOTAL_SPEND + SPEND ))
  RAN=$(( RAN + 1 ))

  jq -cn \
     --arg url "$url" --arg sha "$sha" --arg resolved "$RESOLVED_SHA" \
     --arg task "$task" --arg baseline "$baseline" --arg assertion "$assertion" \
     --argjson reuse "$REUSE_PCT" --argjson syms "$REUSE_SYMS" \
     --argjson expect "$expect" \
     --argjson wopass "$WO_PASS" --arg ev "$EVIDENCE" \
     --argjson basepass "$BASELINE_PASS" --arg baserc "$BASELINE_RC" \
     --argjson asrtpass "$ASSERTION_PASS" --arg asrtrc "$ASSERTION_RC" \
     --argjson spend "$SPEND" --argjson tokens "$TOKEN_REC" \
     '{repo_url:$url, pinned_sha:$sha, resolved_sha:$resolved,
       task:$task, status:"ran",
       reuse_pct:$reuse, reused_symbols:$syms, reused_symbols_expected:$expect,
       working_output:{pass:$wopass,
                       baseline_pass:$basepass, baseline_exit:($baserc|tonumber), baseline_cmd:$baseline,
                       assertion_pass:$asrtpass, assertion_exit:($asrtrc|tonumber), assertion_cmd:$assertion,
                       evidence:$ev},
       token_spend:$spend, token_usage:$tokens}' >> "$RESULTS_FILE"

  printf "      reuse=%s  working_output=%s  spend=%s  ${D}(cum %s/%s)${R}\n" \
    "$REUSE_PCT" "$([ "$WO_PASS" = true ] && echo PASS || echo FAIL)" "$SPEND" "$TOTAL_SPEND" "$CAP" >&2

  i=$((i+1))
done

# ── assemble the machine-readable report ──────────────────────────────────────
RESULTS_ARR="$(jq -s '.' "$RESULTS_FILE")"

# reuse distribution + working-output rate over the tasks that actually ran.
DIST="$(printf '%s' "$RESULTS_ARR" | jq -c '
  [ .[] | select(.status=="ran") ] as $ran
  | { ran: ($ran | length),
      working_output_pass: ([ $ran[] | select(.working_output.pass==true) ] | length),
      reuse_measured:      [ $ran[] | select(.reuse_pct != null) | .reuse_pct ] }
  | .working_output_rate = (if .ran>0 then (.working_output_pass / .ran) else null end)
  | .reuse_median = (if (.reuse_measured|length)>0
       then (.reuse_measured | sort | .[ (length/2|floor) ]) else null end)
  | .reuse_min = (.reuse_measured | min)
  | .reuse_max = (.reuse_measured | max)
')"

jq -n \
  --arg run_id "$RUN_ID" --arg ts "$(date -u +%FT%TZ)" --arg manifest "$MANIFEST" \
  --argjson cap "$CAP" --argjson total_spend "$TOTAL_SPEND" \
  --argjson total_entries "$TOTAL_ENTRIES" --argjson n_effective "$N_EFFECTIVE" \
  --argjson ran "$RAN" --argjson aborted "$ABORTED" --arg abort_reason "$ABORT_REASON" \
  --argjson results "$RESULTS_ARR" --argjson dist "$DIST" \
  '{run_id:$run_id, ts:$ts, manifest:$manifest,
    cap:$cap, total_token_spend:$total_spend,
    total_entries:$total_entries, n_effective:$n_effective, ran:$ran,
    aborted:$aborted, abort_reason:$abort_reason,
    distribution:$dist, results:$results}' > "$REPORT"

# ── human summary table — honest, low numbers surfaced prominently ────────────
echo >&2
printf "${P}${B}S-6 C3 sweep summary${R}  ${D}(run %s)${R}\n" "$RUN_ID" >&2
printf "  ran            : %s of %s entries\n" "$RAN" "$TOTAL_ENTRIES" >&2
WO_RATE="$(printf '%s' "$DIST" | jq -r '.working_output_rate // "n/a"')"
WO_PASS_N="$(printf '%s' "$DIST" | jq -r '.working_output_pass')"
RMED="$(printf '%s' "$DIST" | jq -r '.reuse_median // "n/a"')"
RMIN="$(printf '%s' "$DIST" | jq -r '.reuse_min // "n/a"')"
RMAX="$(printf '%s' "$DIST" | jq -r '.reuse_max // "n/a"')"
printf "  working output : %s/%s passed  ${D}(runnable evidence, not self-report)${R}\n" "$WO_PASS_N" "$RAN" >&2
printf "  reuse %%        : median ${B}%s${R}  (min %s, max %s)\n" "$RMED" "$RMIN" "$RMAX" >&2
printf "  total spend    : %s / %s tokens cap\n" "$TOTAL_SPEND" "$CAP" >&2
# surface every per-task reuse number so a low distribution cannot hide.
printf "  per-repo reuse : " >&2
printf '%s' "$RESULTS_ARR" | jq -r '[.[] | select(.status=="ran") | (.reuse_pct // "null")|tostring] | join("  ")' >&2
printf "  report         : %s\n" "$REPORT" >&2

if [ "$ABORTED" = true ]; then
  printf "  ${W}ABORTED (fail-closed): %s${R}\n" "$ABORT_REASON" >&2
  echo "  partial report written above. Re-run with a higher --cap to continue." >&2
  exit 4
fi
exit 0
