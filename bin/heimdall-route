#!/usr/bin/env bash
# heimdall-route — run a coding tool THROUGH the Headroom chain, and change nothing else.
#
#   hmd route claude [args…]   ensure the proxy, then exec `claude` with
#                              ANTHROPIC_BASE_URL pointed at it.
#   hmd route --url            print the base URL (empty when not routed) — the
#                              seam a shell function or an editor launch config uses.
#   hmd route --status         one line: am I routed right now, and why.
#
# ── WHY THIS EXISTS, MEASURED ────────────────────────────────────────────────────────
# The chain was reachable from exactly one place: `hmd wrap <tool>`, which also installs
# Layer-0 git hooks, writes the AGENTS.md fenced block and starts presence. Those are
# the right side effects for adopting a repo and the wrong ones for "I just want my
# sessions compressed", so a user who launches `claude` directly gets no proxy at all.
#
# What that cost, on this machine, over 2026-08-11..19: 140 distinct Claude Code session
# ids appear in Headroom's logs against 403 session transcripts that existed in the same
# window — roughly a third of sessions routed. The proxy was not the problem: of the
# 15,605 request records in those logs, 90.8% carried cache_read > 0 and 42.1% carried
# tok_saved > 0, and lifetime savings stand at $17,386.56 (cache) + $43.00 (compression)
# over 43,780 requests. Coverage was the problem, and this file is the coverage fix.
#
# ── WHAT IT DOES NOT DO ─────────────────────────────────────────────────────────────
# It does not wrap. No git hooks, no AGENTS.md fence, no presence beat, no snapshot, no
# repo bytes touched — so it is safe to put on EVERY launch, in any directory, including
# ones that are not git repos at all. `hmd wrap` remains the deliberate, reversible,
# per-repo act it always was; this is the launch-time routing half on its own.
#
# It sets ANTHROPIC_BASE_URL on ONE child, and on the fallback path ONLY (see FALLBACK
# PRECEDENCE below) also ANTHROPIC_AUTH_TOKEN, read from a 0600 file the operator minted
# — because OmniRoute enforces requireLogin on its inference surface, so a routed child
# without a token gets 401 and the fallback is decorative. That token is dropped again on
# any launch that is NOT routed to the fallback, so a bearer credential for a local
# gateway can never ride along to api.anthropic.com. This paragraph used to read "ONE
# variable on ONE child"; that stopped being true when the fallback path landed, and a
# header asserting a narrower blast radius than the code has is worse than no header.
# HTTPS_PROXY / ALL_PROXY are still never set here, for the reason
# bin/lib/hmd-headroom-chain.sh states at length — they
# would route the control plane, enrollment, presence and team traffic through a
# rewriter, and that is how a compression proxy becomes a man-in-the-middle on signed
# bytes. Judgment is unaffected: hmd_gate_exec scrubs ANTHROPIC_BASE_URL and the whole
# HEADROOM_* namespace before any verdict-producing execution.
#
# ── FAIL-OPEN, AND SAID OUT LOUD ────────────────────────────────────────────────────
# Every failure lands on "launch the tool unproxied", never on "do not launch". A
# compression proxy that can stop a session from starting is worse than no compression.
# And routing is never silent: routed or not, the reason goes to stderr, because a proxy
# the user cannot see is precisely what this project refuses to ship.
set -uo pipefail

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$BIN_DIR/.." && pwd)"

if [ -t 2 ]; then G='\033[32m'; D='\033[90m'; R='\033[0m'; else G=''; D=''; R=''; fi

usage() {
  cat <<'EOF'
  hmd route — run a coding tool through the Headroom chain, and change nothing else.

    hmd route <tool> [args…]   ensure the proxy, exec <tool> with ANTHROPIC_BASE_URL set
    hmd route --url            print the base URL (nothing when not routed)
    hmd route --status         one line: routed or not, and why
    hmd route -h | --help      this text

  Unlike `hmd wrap`, this installs nothing and touches no repo bytes — it is safe on
  every launch, in any directory. Shell integration:

    claude() { command hmd route claude "$@"; }      # zsh/bash, in your rc file

  Failure always degrades to launching the tool unproxied, and always says why.
EOF
}

# The chain is a library; sourcing it defines functions and routes nothing.
# shellcheck source=lib/hmd-headroom-chain.sh
if [ -r "$BIN_DIR/lib/hmd-headroom-chain.sh" ]; then
  . "$BIN_DIR/lib/hmd-headroom-chain.sh"
fi

chain_available() { type hmd_headroom_chain >/dev/null 2>&1; }

# route_now — run the chain once, leaving its answer in the two globals the chain owns:
# HMD_HEADROOM_BASE_URL on success, HMD_HEADROOM_WHY always. Returns the chain's status.
#
# IT DELIBERATELY PRINTS NOTHING. An earlier version printed the URL so callers could
# write `url="$(route_url)"` — which runs the function in a command-substitution SUBSHELL,
# where the chain's assignment to HMD_HEADROOM_WHY dies with that subshell. The result
# was a refusal with no reason on stderr: the user saw an unexplained loss of
# compression, which is exactly the silence this file's disclosure rule exists to
# prevent. test/heimdall-route.test.sh guarantee 3 is what caught it.
route_now() {
  chain_available || { HMD_HEADROOM_WHY="the headroom chain library is missing from this install"; return 1; }
  hmd_headroom_chain "$PLUGIN_DIR"
}

case "${1:-}" in
  -h|--help|help|'')
    usage; exit 0 ;;
  --url)
    # The fallback gate outranks headroom on a real launch, so --url must answer for the
    # same destination a launch would use -- otherwise a shell function or editor config
    # built on `hmd route --url` points somewhere the actual session does not go.
    if command -v heimdall-fallback >/dev/null 2>&1; then
      _fb="$(heimdall-fallback --repo "$PWD" base-url 2>/dev/null || true)"
      case "$_fb" in
        http://127.0.0.1:*|http://localhost:*) printf '%s\n' "$_fb"; exit 0 ;;
      esac
    fi
    if route_now; then printf '%s\n' "$HMD_HEADROOM_BASE_URL"; exit 0; fi
    printf '%s\n' "${HMD_HEADROOM_WHY:-no reason reported}" >&2
    exit 1 ;;
  --status)
    if command -v heimdall-fallback >/dev/null 2>&1; then
      _fb="$(heimdall-fallback --repo "$PWD" base-url 2>/dev/null || true)"
      case "$_fb" in
        http://127.0.0.1:*|http://localhost:*)
          printf 'ROUTED TO FALLBACK — OmniRoute at %s; headroom compression is OFF while the fallback gate says ROUTE\n' "$_fb"
          exit 0 ;;
      esac
    fi
    if chain_available; then hmd_headroom_report "$PLUGIN_DIR"; printf '\n'
    else printf 'NOT ROUTED — the headroom chain library is missing from this install\n'; fi
    exit 0 ;;
  -*)
    printf '  unknown flag: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac

TOOL="$1"; shift

# The tool is resolved with `command -v` from a NON-interactive shell, so the shell
# function a user installs for integration (`claude() { hmd route claude "$@"; }`) is
# not in scope here and cannot recurse into this script.
REAL="$(command -v "$TOOL" 2>/dev/null || true)"
if [ -z "$REAL" ]; then
  printf '  %s is not installed (not found on PATH)\n' "$TOOL" >&2
  exit 127
fi

# ── FALLBACK PRECEDENCE ──────────────────────────────────────────────────────────────
# Headroom and the OmniRoute fallback gate both re-point ANTHROPIC_BASE_URL, so they are
# mutually exclusive on any one launch. When the gate says ROUTE, the gate WINS and
# compression is dropped for that session. Two reasons, and neither is a preference:
#
#   1. ROUTE only ever happens because the operator's Claude capacity is gone. A
#      compressed request to a provider that cannot be reached is worth nothing; an
#      uncompressed request to one that can is worth the whole session. Degraded-but-
#      running beats optimized-but-dead.
#   2. Headroom compresses on the way OUT and the PROVIDER receives the compressed form
#      — nothing decodes it before the model reads it (bin/lib/hmd-headroom-chain.sh
#      states this at length). Fallback targets are OmniRoute's free/no-auth tier, i.e.
#      markedly weaker models than Claude. Handing a weaker model a compressed prompt is
#      the worst moment to be spending its comprehension on decompression.
#
# Chaining (claude -> headroom -> omni) was the alternative and is deliberately NOT done:
# the chain pins HMD_HEADROOM_UPSTREAM to https://api.anthropic.com and REFUSES a proxy
# pointing anywhere else, and that refusal is a measured invariant ("no new destination"
# is verified from the running process, not asserted). Widening it to admit a second
# destination would trade a real security property for a compression saving on the one
# code path where compression matters least.
#
# The decision is NOT re-derived here. `heimdall-fallback base-url` runs the identical
# preflight `check` runs and prints a URL only on ROUTE — two copies of a routing
# decision is how a wrapper starts routing while the gate says REFUSE. Absent gate,
# absent config, any non-ROUTE verdict, any internal error: stdout is empty, this block
# does nothing, and the Headroom path below runs exactly as it did before.
FALLBACK_URL=""
FALLBACK_TOKEN_FILE=""
if command -v heimdall-fallback >/dev/null 2>&1; then
  FALLBACK_URL="$(heimdall-fallback --repo "$PWD" base-url 2>/dev/null || true)"
  case "$FALLBACK_URL" in
    http://127.0.0.1:*|http://localhost:*|http://'['::1']':*) ;;
    *) FALLBACK_URL="" ;;   # never export anything that is not a loopback URL
  esac
fi

if [ -n "$FALLBACK_URL" ]; then
  FALLBACK_TOKEN_FILE="$(heimdall-fallback --repo "$PWD" token-file 2>/dev/null || true)"
  if [ -n "$FALLBACK_TOKEN_FILE" ] && [ -r "$FALLBACK_TOKEN_FILE" ]; then
    # Read into the child's env only. Never echoed, never logged, never in argv.
    ANTHROPIC_AUTH_TOKEN="$(cat "$FALLBACK_TOKEN_FILE")"
    export ANTHROPIC_AUTH_TOKEN
  fi
  printf "  ${G}✓${R} ${D}fallback: generation routed to OmniRoute at %s — headroom compression is OFF for this session (hmd fallback check)${R}\n" \
    "$FALLBACK_URL" >&2
  # Pin the model when the operator has not. Without this, an unattended `auto`
  # launch could only ever emit bare claude-* ids — which is precisely what the
  # gate's anthropic_model_pinned check refuses to route with, so `auto` was
  # structurally unable to fire in a normal session. The gate itself supplies the
  # id (`heimdall-fallback model`), which refuses anything unprefixed or pointing
  # at claude/claude-web, so this can never pin Tier-1. An operator-set
  # ANTHROPIC_MODEL is never overridden.
  if [ -z "${ANTHROPIC_MODEL:-}" ]; then
    _fbmodel="$(heimdall-fallback --repo "$PWD" model 2>/dev/null || true)"
    if [ -n "$_fbmodel" ]; then
      export ANTHROPIC_MODEL="$_fbmodel"
      printf "  ${D}· fallback: pinned ANTHROPIC_MODEL=%s (hmd fallback model)${R}\n" "$_fbmodel" >&2
    else
      printf "  ${D}· fallback: ANTHROPIC_MODEL is not set and no fallback_model is configured — OmniRoute will receive bare claude-* ids${R}\n" >&2
    fi
    unset _fbmodel
  fi
  export ANTHROPIC_BASE_URL="$FALLBACK_URL"
  exec "$REAL" "$@"
fi

# Not routing to the fallback. If a gateway token is sitting in the environment (an outer
# shell that WAS routed, a manual export), it must not ride along to api.anthropic.com:
# it is a bearer credential for a different service and Anthropic is not its audience.
# Compared against the token file's own contents so only that exact value is dropped —
# an operator's real Anthropic token in the same variable is left untouched.
if command -v heimdall-fallback >/dev/null 2>&1 && [ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]; then
  _tf="$(heimdall-fallback --repo "$PWD" token-file 2>/dev/null || true)"
  if [ -n "$_tf" ] && [ -r "$_tf" ] && [ "$ANTHROPIC_AUTH_TOKEN" = "$(cat "$_tf")" ]; then
    unset ANTHROPIC_AUTH_TOKEN
    printf "  ${D}· fallback: dropped the OmniRoute gateway token from this unrouted launch (wrong audience)${R}\n" >&2
  fi
  unset _tf
fi

if route_now && [ -n "${HMD_HEADROOM_BASE_URL:-}" ]; then
  printf "  ${G}✓${R} ${D}headroom: generation routed via %s — judgment is not (hmd route --status)${R}\n" \
    "$HMD_HEADROOM_BASE_URL" >&2
  export ANTHROPIC_BASE_URL="$HMD_HEADROOM_BASE_URL"
else
  printf "  ${D}· headroom: not routing — %s${R}\n" "${HMD_HEADROOM_WHY:-no reason reported}" >&2
  # FAIL-OPEN means "launch anyway", never "launch anyway, still routed". Without this,
  # a value the child would otherwise inherit ambiently (a previous manual export, an
  # outer shell already routed by its own `hmd route` invocation, a stale session) rides
  # along even though this exact launch was just disclosed as unrouted — the "not
  # routing" line above would be false for that child. This script owns ANTHROPIC_BASE_URL
  # on the child in BOTH directions: sets it when routed, clears it when not. Caught by
  # test/heimdall-route.test.sh guarantee 5 running under this repo's own routed shell.
  unset ANTHROPIC_BASE_URL
fi

exec "$REAL" "$@"
