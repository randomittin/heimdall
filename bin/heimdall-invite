#!/usr/bin/env bash
# heimdall-invite — the TEAM-JOIN viral loop: print a teammate's ONE-COMMAND join.
#
# WHAT IT IS. The growth-loop primitive behind the statusline wall tease ("invite
# your team · hmd invite"). A dev runs `heimdall-invite` and gets a ready-to-share
# one-liner that drops a teammate straight onto THIS repo's team — the canonical
# curl|bash installer with this team's control-plane URL + TEAM SECRET inlined:
#
#   ( set -o pipefail; f="$(mktemp …)" \
#     && curl -fsSL --proto '=https' https://raw.githubusercontent.com/<repo>/<ref>/install.sh -o "$f" \
#     && HEIMDALL_CP_URL='<url>' HEIMDALL_TEAM_SECRET='<secret>' bash "$f"; r=$?; rm -f "$f"; exit $r )
#
# The installer is fetched to a temp file THEN run (never `curl … | bash`): a 404
# makes curl exit non-zero and bash never runs — a broken/unpublished ref fails
# LOUDLY instead of piping an empty body into a silent no-op. The secret rides ONLY
# the env of the bash invocation; the downloaded file carries NO secret.
#
# The teammate pastes that ONE line; install.sh consumes HEIMDALL_TEAM_SECRET into
# their <repo>/.heimdall/team.json (0600) + HEIMDALL_CP_URL into their global
# ~/.heimdall/cp-endpoint.json, and presence auto-enrolls them into THIS team on
# their first session (the secret rides the X-Heimdall-Team-Secret header once at
# enroll). The wall recruits the team.
#
# WHERE THE WIRE COMES FROM. The TEAM SECRET is per-repo: it resolves from this
# repo's <repo>/.heimdall/team.json (the SAME file bin/heimdall-presence and
# bin/heimdall-team read), NOT the global cp-endpoint.json (a dev may be on
# different teams in different repos). The control-plane URL is GLOBAL + NOT secret:
# it resolves from the dev's ~/.heimdall/cp-endpoint.json `url`, else the shipped
# public default (so a dev who only ran `heimdall-team new` can still invite). The
# install repo comes from plugin.json. The ref is resolved to the HIGHEST tag
# actually PUBLISHED on origin (git ls-remote — never the local VERSION or a
# local-only tag that hasn't been pushed), else origin's `main` when offline;
# HEIMDALL_REF pins explicitly but is still verified against origin. Before
# printing, the resulting raw URL is probed (HTTP) and, if it does NOT resolve,
# heimdall-invite REFUSES loudly (exit 3) rather than hand a teammate a silent-404
# join. HEIMDALL_TEAM_DIR overrides the team.json dir (tests / non-git trees).
#
# SECURITY — the team secret IS a secret. It is this team's bearer capability,
# deliberately shared with a teammate, so heimdall-invite PRINTS it to the terminal
# (stdout) ONLY. It is NEVER written to a tracked/committed file, a log, or anything
# in the repo, and NEVER passed in the argv of another command (argv shows in `ps` +
# can be logged) — the secret crosses only this process's variables and the final
# stdout write. A "⚠ contains your team secret" caveat prints above the join so the
# dev knows what they are sharing. (gitleaks/secret-scan stays clean: no literal.)
#
# NON-TTY REFUSAL. This command's entire job is to print a live bearer secret, so
# it refuses to do that for a caller that cannot plausibly be a human reading a
# screen: when stdout is not a terminal (piped, redirected, or captured by an
# agent harness — `[ -t 1 ]` is false), it prints what the command does and how a
# human at a terminal gets the join, then exits 4 — the secret itself is withheld.
# Pass --yes-print-secret to override for legitimate non-interactive use (CI,
# scripted enrollment); the override is a deliberate flag ONLY, never inferable
# from an env var that might already be set in the caller's environment. A human
# at a real TTY sees NO change in behavior (same one-liner, same exit 0), but
# still gets a one-line reminder: this is a live bearer credential — anyone who
# can read your screen or scrollback can join your team.
#
# CLEAN DEGRADE. No team configured for this repo -> a helpful "run heimdall-team
# new" message and exit 0 (never a traceback). `--qr` renders a scannable QR of the
# join ONLY if `qrencode` is present; it degrades silently when absent.
#
# Usage:
#   heimdall-invite               print the one-command team-join for a teammate
#   heimdall-invite --qr          also render a QR of the join (needs `qrencode`)
#   heimdall-invite --yes-print-secret
#                                 print even when stdout is not a TTY (CI /
#                                 scripted enrollment — a deliberate opt-in)
#   -h | --help                   this help
#
# Exit: 0 on the happy + degrade paths (offline/unconfigured is normal); 2 on a bad
# flag; 3 when the resolved install ref does NOT resolve on origin (refuses to
# print a silent-404 join — the owner must push/tag/publish first); 4 when stdout
# is not a TTY and --yes-print-secret was not passed (refuses to print a live
# secret to a non-human caller).
set -uo pipefail

# ── resolve this script's own dir (RELOCATABLE — symlink-followed, no baked path).
SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)"
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$BIN_DIR/.." 2>/dev/null && pwd)}"
MANIFEST="$PLUGIN_ROOT/.claude-plugin/plugin.json"

# The shipped public-surface CP URL (NOT a secret) — sourced from the SINGLE source of truth
# (lib/cp-consent.sh) that bin/heimdall-presence also reads, so the literal lives in ONE place
# and a dev needs ZERO url config to invite. (Invite is an explicit "grow my team" action, so
# it is NOT consent-gated — it always uses the canonical default to build the join one-liner.)
# shellcheck source=lib/cp-consent.sh
[ -f "$BIN_DIR/lib/cp-consent.sh" ] && . "$BIN_DIR/lib/cp-consent.sh"
DEFAULT_CP_URL="${HEIMDALL_DEFAULT_CP_URL:-}"

usage() { sed -n '2,46p' "$SELF" | sed 's/^# \{0,1\}//'; }

# ── argv ───────────────────────────────────────────────────────────────────────
WANT_QR=""
YES_PRINT_SECRET=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)          usage; exit 0 ;;
    --qr)               WANT_QR=1; shift ;;
    --yes-print-secret) YES_PRINT_SECRET=1; shift ;;
    *) echo "heimdall-invite: unexpected argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

PY="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"

# ── helpful "no team configured" message (degrade path — always exit 0) ─────────
no_team() {
  cat <<'MSG'
heimdall-invite: no team is configured for this repo yet, so there is nothing to
invite a teammate to.

Mint one (writes <repo>/.heimdall/team.json, 0600, gitignored):

    heimdall-team new

Then re-run `heimdall-invite` to get a one-command join to share with your team.
(heimdall-presence also auto-mints a solo team on your first session.)
MSG
  exit 0
}

# ── resolve the per-repo TEAM SECRET from <repo>/.heimdall/team.json ────────────
repo_root() { git rev-parse --show-toplevel 2>/dev/null || pwd; }
TEAM_DIR="${HEIMDALL_TEAM_DIR:-$(repo_root)/.heimdall}"
TEAM_FILE="$TEAM_DIR/team.json"
[ -f "$TEAM_FILE" ] || no_team

# The secret is read into a VARIABLE only; it never crosses argv. Prefer python3
# (matches heimdall-presence/heimdall-team), then jq, then a grep fallback.
read_team_secret() {
  if [ -n "$PY" ]; then
    HMD_INV_TEAM="$TEAM_FILE" "$PY" - <<'PYEOF' 2>/dev/null
import json, os, sys
try:
    d = json.load(open(os.environ["HMD_INV_TEAM"]))
    s = d.get("team_secret")
    sys.stdout.write(s if isinstance(s, str) else "")
except Exception:
    sys.stdout.write("")
PYEOF
  elif command -v jq >/dev/null 2>&1; then
    jq -r '.team_secret // "" | tostring' "$TEAM_FILE" 2>/dev/null || true
  else
    grep -oE '"team_secret"[[:space:]]*:[[:space:]]*"[^"]*"' "$TEAM_FILE" 2>/dev/null \
      | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true
  fi
}

SECRET="$(read_team_secret)"
[ -n "$SECRET" ] || no_team   # a team.json with no secret is not an invitable team.

# ── refuse to print a live bearer secret to a caller that is not a human at a
# terminal. House style for the primitive: `[ -t 1 ]` (bin/heimdall-team,
# bin/heimdall-demo, bin/heimdall, bin/lib/select.sh all gate the same way).
# --yes-print-secret is the ONLY override — a deliberate flag, never inferable
# from an env var that could already be set in the caller's environment (see the
# argv loop above: YES_PRINT_SECRET is unconditionally reset to "" there, so an
# ambient env var of the same name cannot leak through). Placed right after
# SECRET resolves (before any network/ref-resolution work) so the refusal is
# instant and the --qr path is covered too (it only ever runs after this point).
# The no-team degrade path above already returned, so by the time this runs
# there IS a live secret to protect.
refuse_nontty() {
  cat >&2 <<MSG
heimdall-invite: REFUSING to print your live team secret — stdout is not a
terminal, so this looks like a script, an agent, or CI reading it, not a human
at a screen. This command's entire job is to print a bearer credential
(HEIMDALL_TEAM_SECRET); handing it to a non-interactive caller with no
confirmation is how a secret ends up in a log or a transcript nobody meant to
write it to.

Run this at an interactive terminal to get the join one-liner:

    heimdall-invite

If this really is a deliberate, non-interactive use (CI, scripted enrollment),
opt in explicitly:

    heimdall-invite --yes-print-secret
MSG
  exit 4
}
[ -t 1 ] || [ -n "$YES_PRINT_SECRET" ] || refuse_nontty

# ── resolve the GLOBAL control-plane URL (not secret) from ~/.heimdall/cp-endpoint.json
read_cfg_url() {
  local cfg="${HOME:-}/.heimdall/cp-endpoint.json"
  [ -n "${HOME:-}" ] && [ -f "$cfg" ] || { printf ''; return 0; }
  if [ -n "$PY" ]; then
    HMD_INV_CFG="$cfg" "$PY" - <<'PYEOF' 2>/dev/null
import json, os, sys
try:
    sys.stdout.write(str(json.load(open(os.environ["HMD_INV_CFG"])).get("url") or ""))
except Exception:
    sys.stdout.write("")
PYEOF
  elif command -v jq >/dev/null 2>&1; then
    jq -r '.url // "" | tostring' "$cfg" 2>/dev/null || true
  else
    grep -oE '"url"[[:space:]]*:[[:space:]]*"[^"]*"' "$cfg" 2>/dev/null \
      | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' || true
  fi
}

URL="$(read_cfg_url)"
[ -n "$URL" ] || URL="$DEFAULT_CP_URL"   # the public default — url is not a secret.

# ── resolve the install repo slug (owner/name) + ref, mirroring the README/
# install.sh one-liner. NEITHER touches the secret (no secret ever enters argv). ─
resolve_repo_slug() {
  local raw=""
  if [ -f "$MANIFEST" ]; then
    if command -v jq >/dev/null 2>&1; then
      raw="$(jq -r '.repository // .homepage // ""' "$MANIFEST" 2>/dev/null || true)"
    elif [ -n "$PY" ]; then
      raw="$(HMD_INV_CFG="$MANIFEST" "$PY" - <<'PYEOF' 2>/dev/null
import json, os, sys
try:
    d = json.load(open(os.environ["HMD_INV_CFG"]))
    sys.stdout.write(str(d.get("repository") or d.get("homepage") or ""))
except Exception:
    sys.stdout.write("")
PYEOF
)"
    fi
  fi
  # github.com/<owner>/<name>(.git) -> owner/name ; fall back to the canonical slug.
  local slug
  slug="$(printf '%s' "$raw" \
    | sed -E -e 's#^[a-z]+\+?[a-z]*://##' -e 's#^git@##' \
             -e 's#github\.com[:/]##' -e 's#\.git$##' -e 's#/$##')"
  case "$slug" in
    */*) printf '%s' "$slug" ;;
    *)   printf 'randomittin/heimdall' ;;
  esac
}

# ── published-ref resolution. The join MUST pin a ref that actually EXISTS on
# origin — else the teammate's `curl` 404s and they silently never install. We
# resolve to the highest tag PUBLISHED on origin (git ls-remote), NOT the local
# VERSION / a local-only tag (which may be bumped in prep but unpushed); offline /
# no-tags we fall back to origin's canonical `main`. HEIMDALL_REF still lets a dev
# pin, but the pin is verified against origin below. Test seams (network-free):
# HEIMDALL_INVITE_PUBLISHED_TAGS / HEIMDALL_INVITE_PUBLISHED_BRANCHES stand in for
# the ls-remote listings; HEIMDALL_INVITE_ASSUME_HTTP stands in for the raw-URL
# HTTP probe; HEIMDALL_INVITE_REMOTE overrides the remote name (default origin). ─
REMOTE="${HEIMDALL_INVITE_REMOTE:-origin}"

published_tags() {
  if [ -n "${HEIMDALL_INVITE_PUBLISHED_TAGS:-}" ]; then
    printf '%s\n' $HEIMDALL_INVITE_PUBLISHED_TAGS
    return 0
  fi
  git -C "$PLUGIN_ROOT" ls-remote --tags "$REMOTE" 2>/dev/null \
    | sed 's#.*refs/tags/##' | grep -vE '\^\{\}$'
}

highest_published_tag() {
  published_tags | grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1
}

ref_on_origin() {   # 0 iff $1 is a PUBLISHED tag OR a branch that exists on origin
  local ref="$1"
  published_tags | grep -qxF "$ref" && return 0
  if [ -n "${HEIMDALL_INVITE_PUBLISHED_BRANCHES:-}" ]; then
    printf '%s\n' $HEIMDALL_INVITE_PUBLISHED_BRANCHES | grep -qxF "$ref" && return 0
    return 1
  fi
  git -C "$PLUGIN_ROOT" ls-remote --heads "$REMOTE" "$ref" 2>/dev/null | grep -q . && return 0
  return 1
}

# Resolve REF + whether it is CONFIRMED to exist on origin.
REF=""; CONFIRMED=0
if [ -n "${HEIMDALL_REF:-}" ]; then
  REF="$HEIMDALL_REF"                         # an explicit pin — still verified below.
  if ref_on_origin "$REF"; then CONFIRMED=1; else CONFIRMED=0; fi
else
  REF="$(highest_published_tag)"
  if [ -n "$REF" ]; then
    CONFIRMED=1                               # came straight from origin's tag list.
  else
    REF="main"; CONFIRMED=1                   # offline / no tags -> origin's canonical branch.
  fi
fi

REPO_SLUG="$(resolve_repo_slug)"
INSTALL_URL="https://raw.githubusercontent.com/$REPO_SLUG/$REF/install.sh"

# ── verify the join actually resolves before we hand it to a teammate. Primary
# gate: the ref must exist on origin. Defense in depth: the raw URL must return
# HTTP 200 (a real non-200 like 404 blocks; a transport error offline does not
# falsely block, since origin-confirmation already vouched for the ref). ─────────
LAST_HTTP=""
verify_install_url() {
  local url="$1" code
  if [ -n "${HEIMDALL_INVITE_ASSUME_HTTP:-}" ]; then
    code="$HEIMDALL_INVITE_ASSUME_HTTP"
  elif command -v curl >/dev/null 2>&1; then
    code="$(curl -sS --proto '=https' -o /dev/null -w '%{http_code}' --max-time 12 "$url" 2>/dev/null || printf '000')"
  else
    code="200"                                # no probe available; origin-confirmation gated REF.
  fi
  LAST_HTTP="$code"
  case "$code" in
    200|000) return 0 ;;                      # resolves, or a transport error we won't block on.
    *)       return 1 ;;                      # a real HTTP status (e.g. 404) -> broken -> block.
  esac
}

refuse() {
  # $1 = short reason. Loud, to STDERR, non-zero exit — never a silent broken join.
  cat >&2 <<MSG
heimdall-invite: REFUSING to print a join — the install URL does not resolve on origin.

    $INSTALL_URL
    ref: $REF  ($1)

A teammate pasting a join pinned to an unpublished ref would SILENTLY fail to
install (curl 404 -> nothing runs) and never join your team. Fix the ref first:

  • Push your release + tag so the ref exists on origin:
        git push "$REMOTE" HEAD --follow-tags
  • Or invite against an already-published ref (a tag or branch on origin):
        HEIMDALL_REF=<published-tag-or-main> heimdall-invite

Then re-run heimdall-invite.
MSG
  exit 3
}

[ "$CONFIRMED" -eq 1 ] || refuse "ref not found on origin '$REMOTE'"
verify_install_url "$INSTALL_URL" || refuse "raw URL returned HTTP $LAST_HTTP"

# ── build the join one-liner. The URL is team-specific but NOT secret; the SECRET
# IS — both are inlined ONLY into this string, written ONLY to stdout below. The
# installer is downloaded to a mktemp file then run (`bash "$f"`), so a fetch
# failure (404) yields a non-zero curl and NO bash run — never the old `| bash`
# that swallowed an empty 404 body into a silent no-op. The secret rides ONLY the
# env of the bash invocation; the downloaded file (install.sh) carries NO secret.
# The subshell keeps the trailing `exit` from closing a teammate's interactive
# shell. Every runtime $var (f, ?, r, TMPDIR) is left literal for the teammate's
# shell; only the URL + CP url + secret are interpolated (printf %s). ────────────
JOIN_FMT='( set -o pipefail; f="$(mktemp "${TMPDIR:-/tmp}/heimdall-install.XXXXXXXX")" && curl -fsSL --proto '\''=https'\'' %s -o "$f" && HEIMDALL_CP_URL='\''%s'\'' HEIMDALL_TEAM_SECRET='\''%s'\'' bash "$f"; r=$?; rm -f "$f"; exit $r )'
JOIN="$(printf "$JOIN_FMT" "$INSTALL_URL" "$URL" "$SECRET")"
printf 'Share this ONE command with a teammate to put them on your team:\n\n'
printf '\xe2\x9a\xa0 contains your team secret — share only with teammates\n\n'
printf '\xe2\x9a\xa0 this is a LIVE bearer credential — anyone who can read your screen or scrollback can join your team\n\n'
printf '%s\n' "$JOIN"

# ── optional QR of the join. Only if `qrencode` is present; degrade silently when
# absent. The join is piped via STDIN (printf is a shell builtin) so the secret
# NEVER appears in qrencode's argv (which `ps` would expose). ────────────────────
if [ -n "$WANT_QR" ] && command -v qrencode >/dev/null 2>&1; then
  printf '\n'
  printf '%s' "$JOIN" | qrencode -t ANSIUTF8 2>/dev/null || true
fi

# ── Δ6 funnel: record the `invite_sent` growth-loop stage (client-side, consent-
#    gated, fire-and-forget). Emitted ONLY on the success path (an invite was
#    actually generated), never on the no-team degrade above. Zero-content: the
#    engine carries only the coded stage + a HASHED team key — never the secret.
FUNNEL_BIN="$BIN_DIR/heimdall-funnel"
[ -x "$FUNNEL_BIN" ] && ( "$FUNNEL_BIN" emit invite_sent --context cli >/dev/null 2>&1 & ) || true

exit 0
