#!/usr/bin/env bash
# heimdall-precheck-bash — the PreToolUse/Bash enforcement chain (git-guard
# self-heal, commit secret gate, and the whole `git push` gate stack: quality
# gates, push-range secret gate, full-history self-scan, native-hook dedup,
# oracle falsifiability, corpus regression, parallelism-tracker). Moved out of
# hooks/hooks.json into a real script for the same reason bin/heimdall-precheck-edit
# and bin/heimdall-precheck-agent exist: hooks.json is wiring, this is the logic.
#
# WHY THE EXTRACTION (2026-09-19, ECC harness gap analysis item #3 (iv)):
#   - The chain lived as ONE ~5,000-char shell string embedded in a JSON value.
#     A JSON string cannot be `bash -n`-checked, shellcheck'd, or unit-tested in
#     place — every edit was verified only by running the whole hook, and only
#     on the paths that edit happened to exercise. ECC's single largest issue
#     class is hooks misfiring in someone's environment (#240, #264, #1435,
#     #1548, #1590, #3062); a hook you cannot syntax-check is exactly how that
#     class is manufactured. Here it is a file: `bash -n` it, run
#     test/heimdall-precheck-bash.test.sh against it, read it with line numbers.
#   - hooks/hooks.json shrinks to the same one-liner shape the other two
#     precheck hooks use (read stdin, resolve PLUGIN, pipe the payload in), so
#     the per-hook fingerprint/kill-switch work in the same item has a stable,
#     short command string to fingerprint.
#
# ZERO LOGIC CHANGE. The body below is the hooks.json string, verbatim, split
# at its top-level `; ` boundaries and indented — nothing added, removed or
# reordered. test/heimdall-precheck-bash.test.sh proves it: for every branch of
# the chain it runs the historical inline string (bash -c) and this script under
# one identical environment and asserts byte-identical stdout, stderr, exit code
# and even the `bash -x` execution trace. Anything that changes the chain's
# behaviour belongs in a SEPARATE commit against this file, with that test
# updated on purpose.
#
# CONTRACT (inline form + the two 2026-10-11 deltas marked below the -h guard):
#   stdin   the PreToolUse JSON payload; `.tool_input.command` is the Bash
#           command about to run. An empty or malformed payload is treated as an
#           empty command (jq's own parse error goes to stderr, nothing blocks).
#   stdout  ONLY a `{"error": "BLOCKED: ..."}` JSON object, and only on a deny.
#           (Plus whatever parallelism-tracker prints — its stderr is folded into
#           stdout by the trailing `2>&1`, exactly as the inline did.)
#   stderr  every advisory: gate verdicts, "UNAVAILABLE" notices, the native-hook
#           delegation line, falsify/corpus output, and a copy of every deny verdict.
#   exit 2  DENY — a gate failed (secret in staged diff, quality gate rc 2, push
#           secret gate, self-scan, non-falsifiable oracle, corpus regression).
#   exit 0  everything else, including "gate never evaluated" (the quality-gate
#           verdict UNAVAILABLE branch warns and allows, as before).
#
# ENV honoured (HMD_SKIP et al. unchanged; CLAUDE_PLUGIN_ROOT's fallback changed):
#   CLAUDE_PLUGIN_ROOT  plugin root; unset -> this script's own bin/.. (NEVER the cwd repo).
#   HMD_SKIP            the NATIVE pre-push hook's own bypass. It does NOT bypass
#                       this layer: `HMD_SKIP=1` only prevents the dedup guard from
#                       DELEGATING the oracle+corpus gates to .heimdall/hooks/pre-push,
#                       so this layer runs them inline instead. Widening HMD_SKIP to
#                       reach here would be a silent gate weakening — see
#                       test/pre-push-gate-dedup.test.sh case 4.
#   SECRET_SCAN_REQUIRE is SET (=1) by this script for the push-range scan.
#   Anything the delegated bins read (HMD_GIT_GUARD_PGREP, HEIMDALL_HOME, ...)
#   passes straight through.
#   HMD_KILL_GUARD     off, 0, false or no (any case) turns the kill guard off: none of it runs and nothing is printed.
#                       Unset or any other value leaves it ON. Only that guard: every other gate still runs. An env switch,
#                       not `heimdall-hooks disable`: the guard sits in this chain, a LOCKED hooks.json group.
#
# Deliberately NO `set -e`, `set -u` or `pipefail`: the inline string ran under
# Claude Code's plain `sh -c`/`bash -c` defaults, and its logic depends on them —
# `QGOUT=$(...); QGRC=$?` must survive a nonzero, and `printf | grep -q` must not
# turn a SIGPIPE'd printf into a false gate verdict under pipefail.
#
# -h, --help   print this header (the hook never passes arguments).
case "${1:-}" in
  -h|--help) sed -n '2,66p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# SINCE THE EXTRACTION — four deliberate deltas from the historical inline chain
# (2026-10-11, "precheck never blocks silently in another repo"; then "never execute the session's
# repo"; 2026-10-13, "each repo's own checks, not heimdall's"). test/heimdall-precheck-bash.test.sh
# cases 17, 21 and 24-29 pin the first three, test/heimdall-push-gate-per-repo.test.sh the fourth;
# every other branch is still byte-identical to the inline string.
#
#   1. deny(): a deny states its verdict on stderr TOO. Claude Code surfaces ONLY stderr for an
#      exit-2 hook and ignores stdout, so the stdout-only verdict surfaced as "hook error ... No
#      stderr output" — a blocked `git push` with no stated reason (seen live from a session whose cwd
#      was another repo with failing quality gates of its own). stdout is unchanged for anything that
#      parses it. Same dual emit as bin/heimdall-precheck-agent and the Write|Edit stub gate.
#   2. PLUGIN: with CLAUDE_PLUGIN_ROOT unset, the root is where THIS script lives, not the cwd's git
#      toplevel. This script is only ever run as <root>/bin/heimdall-precheck-bash, so its own location
#      is the one answer that cannot name a foreign repo; the cwd fallback pointed every gate bin (and
#      the trailing parallelism-tracker) at a repo with no bin/.
#
#   3. PUSH MATCHER: the push gate used to be armed by `^git\s+push` alone, so every other way of typing
#      the same push walked past the quality, secret, self-scan, oracle and corpus gates: `git -C <dir>
#      push`, `x && git push`, `; git push`, `FOO=1 git push`, `(git push)`, `sudo git push`,
#      `/usr/bin/git push`, `bash -c "git push"`. It now matches `git` as a COMMAND WORD: at the start of
#      a line, after ; & | ( { ` $( ! then/do/else, after env assignments and wrapper words (sudo, doas, command,
#      env, exec, time, timeout, nohup, nice, ionice, setsid, stdbuf, caffeinate, builtin, xargs, each with
#      its options and their values: env -u NAME, nice -n 5, sudo -u user, timeout -k 5 30), or as the first word
#      of a `sh -c`/`eval` string. The command word may be a path, quoted or escaped (/usr/bin/git, "git", \git),
#      and an assignment value or an option value is one whole shell word (quotes, backslash escapes, $( ), ${ },
#      backticks: FOO=$(echo a b) git push and git -C My\ Dir push are pushes, `git push` is one too); then
#      git's global options (-C <dir>, -c k=v, --git-dir[=]<dir>, --no-pager, ...) and then `push` as a
#      whole word (so `git pushd` is not a push). Text that only MENTIONS a push (`echo "git push"`,
#      `grep -rn "git push" docs/`, a commit message) and other subcommands (`git stash push`) stay
#      unmatched: a push gate that fired on prose would cost a full gate run per grep. Indirection no regex
#      can see (`$GIT push`, a script piped into a shell, `eval git push`, a here-string, `bash --norc -c ...`)
#      is the native pre-push hook's job (core.hooksPath). test/heimdall-push-gate-per-repo.test.sh section E pins the forms.
#   4. PER-REPO TEST/LINT GATE: the quality gate (`heimdall-state check-quality-gates`: the state
#      booleans, the lint receipt and heimdall's sweep receipt) used to run in the session's cwd for ANY
#      push, so a push of another repository was held to heimdall's own sweep: the site, with six gates of
#      its own, was blocked for lacking a receipt only heimdall's test/run-all.sh can write. The hook now
#      asks bin/lib/hmd_push_target.py which repositories the command pushes (cwd, `git -C <dir>`,
#      `cd <dir> && ...`, subshells, wrappers, `sh -c`) and gives each the gate its class owes:
#        sweep        a commit pushed (or its upstream) has test/run-all.sh naming last-sweep.json (heimdall's
#                     own regime): the old gate, unchanged and fail-closed, now run INSIDE that repository (a
#                     push of repo B no longer answers to repo A's state, and a cwd in a subdirectory reads
#                     the toplevel's state);
#        repo-checks  a commit pushed has .heimdall/repo-checks.json, the repo's own checks: pass ONLY on a
#                     green, current, clean-tree receipt (bin/heimdall-repo-checks status). Read, never
#                     re-run: a hook must not execute what a repository says to execute. Stale, red, dirty,
#                     missing, mismatched, invalid or an absent runner all block, naming the runner command;
#        unmanaged    anything else: one WARNING line on stderr, the push goes on.
#      The class is read from the COMMITS (HEAD, its upstream, origin, the refspecs named), never the work
#      tree, and the strictest wins: an uncommitted marker edit changes nothing, and a pushed commit that
#      drops the marker cannot downgrade a repo whose upstream still has it. The marker is the sweep WRITER
#      in tracked code, never its receipt, so deleting a receipt cannot downgrade a repo. A command the
#      resolver does not understand EXACTLY (see its docstring: a dynamic or conditional cd, eval, sh -c,
#      xargs, aliases, sourced or piped scripts, ...) is uncertain, and then every repo involved gets the
#      sweep gate (a repository that declares checks also keeps owing its receipt, for commits nobody can
#      list), and a strict gate that was never evaluated blocks: only an exactly understood command may end
#      in the warning. The receipt is graded for the commit the push SENDS (each refspec source resolved, HEAD
#      for a bare push; --all, --mirror, --tags, a wildcard or push configuration that picks the refs cannot
#      be tied to it). A resolver that cannot answer (it times out, crashes, or is missing) is never a reason to
#      grade ONE repository: the strict gate runs against the session's cwd, the payload's cwd and every -C / cd /
#      --git-dir / --work-tree directory the parser had reached (it prints those itself when it fails), and the push
#      is blocked unless all of them pass; a class this does not know is the sweep gate. The git directory and work
#      tree the resolver resolved TOGETHER ride in the row and go to every stage: `status --git-dir` (the receipt
#      lookup) and the old gate's call (GIT_DIR and GIT_WORK_TREE exported around it); a gate directory that cannot
#      be entered blocks. The change only ever narrows a gate to the repository pushed. NOT relaxed, and still reading the CWD repo
#      as they always did: the push-range secret scan, the full-history self-scan and the oracle and corpus
#      stages below (and, earlier in the chain, the commit secret scan, git-guard and the kill guard).
deny() { printf '%s' "$1"; printf '%s\n' "$1" >&2; exit 2; }

INPUT=$(cat)
CMD=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty')
PLUGIN="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)}"
SCAN="$PLUGIN/bin/secret-scan"
GITGUARD="$PLUGIN/bin/heimdall-git-guard"
if [ -x "$GITGUARD" ] && printf '%s\n' "$CMD" | grep -qE '(^|[;&|]|[[:space:]])git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+(add|commit|merge|rebase|stash|cherry-pick|revert|am|apply|pull)([[:space:]]|$)'; then
  "$GITGUARD"
fi
if printf '%s\n' "$CMD" | grep -qE '(^|[;&|]\s*)git\s+commit'; then
  if [ -x "$SCAN" ]; then
    if ! OUT=$("$SCAN" 2>&1); then
      ESC=$(printf '%s' "$OUT" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
      deny "$(printf '{"error": "BLOCKED: secret detected in staged changes by gitleaks. A credential must never enter history. Remove it from the staged diff before committing. --- %s"}' "$ESC")"
    else
      printf '%s\n' "$OUT" >&2
    fi
  fi
fi
SQ="'"
GP_VAL='([^[:space:]"'"$SQ"'`$\\]|\\.|\$\([^)]*\)|\$\{[^}]*\}|\$|`[^`]*`|"[^"]*"|'"$SQ"'[^'"$SQ"']*'"$SQ"')*'
GP_START='(^|[;&|({`!]|\$\(|(^|[[:space:]])(then|do|else|elif)[[:space:]]|(sh|bash|zsh|dash|ksh)[[:space:]]+(-[A-Za-z]+[[:space:]]+)*-[A-Za-z]*c[[:space:]]+["'"$SQ"']|eval[[:space:]]+["'"$SQ"'])[[:space:]]*'
GP_OPTV='(-[^[:space:]]+[[:space:]]+('"$GP_VAL"'[[:space:]]+)?)*'
GP_PRE='([A-Za-z_][A-Za-z0-9_]*='"$GP_VAL"'[[:space:]]+|(sudo|doas|command|env|exec|time|nohup|nice|ionice|setsid|stdbuf|caffeinate|builtin|xargs)[[:space:]]+'"$GP_OPTV"'|timeout[[:space:]]+'"$GP_OPTV"'[0-9.]+[smhd]?[[:space:]]+)*'
GP_OPT='([[:space:]]+(-[Cc][[:space:]]+'"$GP_VAL"'|--(git-dir|work-tree|namespace|super-prefix|config-env)[[:space:]]+'"$GP_VAL"'|--?[A-Za-z][A-Za-z-]*(='"$GP_VAL"')?))*'
GP_GIT='("([^"[:space:]]*/)?git"|'"$SQ"'([^'"$SQ"'[:space:]]*/)?git'"$SQ"'|\\?([^[:space:]]*/)?git)'
GP_RE="${GP_START}${GP_PRE}${GP_GIT}${GP_OPT}[[:space:]]+push([[:space:]]|\$|[;&|)}\"${SQ}\`])"
# KILLS BY NAME OR BY A COMPUTED PID are denied (2026-10-12 16:29Z incident). A sub-agent debugging its own temp-repo test ran
# `pkill -f heimdall-relay-client`; the pattern matched EVERY relay client on the machine -- the operator's two live phone
# clients and the routine's -- and a client answers SIGTERM by revoking its phone pairing, so both phones were unpaired. A text
# match on the name is walked around by quoting, a character class, a partial pattern, a variable, a looked-up pid, xargs,
# sh -c or env/command/exec, so bin/lib/hmd_kill_guard.py reads the command the way a shell does and denies pkill/killall of
# any pattern and kill of anything that is not a literal pid (its docstring has the rule).
#
# BEST-EFFORT DEFENSE IN DEPTH, NOT A SECURITY BOUNDARY: no text guard on shell is complete (bash grammar is larger than any
# lexer here, and a verb can be built at run time). The protection that does not depend on reading shell is that a stray
# signal must not be able to unpair a phone (a design decision still open with the operator).
#
# FAILS CLOSED. The guard runs for any command that mentions kill or fuser, in any case, once quotes and backslashes are
# removed (so p''kill and PKILL are still caught; starting python is not free). Only `ok` with exit 0 passes: exit 3 denies with
# the guard's reason, and ANYTHING else -- a crash, no output, python3 or the helper missing -- denies too, because a guard that
# could not answer has not cleared the command. The quotes are removed with tr, not ${CMD//[...]/}: bash's pattern
# substitution is quadratic and took minutes on a 100 KB command. Its own xtrace lines (GP_KILL_*, one tr, one case) are
# dropped by equiv() in test/heimdall-precheck-bash.test.sh; test/hmd-server-kill-guard.test.sh pins the rest.
# OPT-OUT (2026-10-13): HMD_KILL_GUARD=off, 0, false or no (any case) turns this guard off for an operator who finds it too broad (it
# denies every pkill and killall). None of it runs then -- not the tr below, not python3, not the helper -- and nothing is printed.
# Unset, empty or any other value leaves it ON, so a typo cannot silently remove it, and it switches off THIS guard only: the commit
# secret gate and the push gates still run. It is an environment switch and not `heimdall-hooks disable <id>` on purpose: that tool
# names one hooks.json group, this guard sits inside bash-gate-chain, which is LOCKED because it also carries the secret and push
# gates, and a metadata entry with no live group fails `heimdall-hooks check`. The deny below tells the user about the switch.
case ${HMD_KILL_GUARD:-} in
  [Oo][Ff][Ff]|0|[Ff][Aa][Ll][Ss][Ee]|[Nn][Oo]) GP_KILL_NORM= ;;
  *) GP_KILL_NORM=$(tr -d "'\"\\\\" <<<"$CMD") ;;
esac
case $GP_KILL_NORM in
  *[Kk][Ii][Ll][Ll]*|*[Ff][Uu][Ss][Ee][Rr]*)
    GP_KILL_WHY=$(python3 -I -S "$PLUGIN/bin/lib/hmd_kill_guard.py" <<<"$CMD" 2>/dev/null)
    GP_KILL_RC=$?
    case $GP_KILL_RC:$GP_KILL_WHY in
      0:ok) ;;
      *)
        [ "$GP_KILL_RC" = 3 ] || GP_KILL_WHY="the guard itself failed (exit $GP_KILL_RC) or said nothing, so this command could not be checked"
        GP_KILL_ESC=$(printf '%s' "$GP_KILL_WHY" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
        # shellcheck disable=SC2016  # the deny message quotes $! literally
        deny "$(printf '{"error": "BLOCKED: hmd kill guard: %s. A kill by name or by a computed pid can hit EVERY heimdall-relay-client, heimdall-app and hmd-ui on this machine, including the operator live phone relay clients, and SIGTERM makes a client revoke its phone pairing (2026-10-12 16:29Z: one pkill -f heimdall-relay-client unpaired two live phones). Read the pid first (pgrep -fl, ps, lsof -ti) and kill the literal number of a process you started: kill 4242, or kill $! right after starting it in the background. Reap leftovers of temp repos with heimdall-gc uis, which only ever selects orphans whose --repo is gone or a temp dir. Ending a real client is the operator job: hmd app disconnect. This guard is best-effort defense in depth, not a security boundary. If it is too broad for you, turn it off with HMD_KILL_GUARD=off (0, false or no also work) in the environment Claude Code runs in; nothing else in this hook is affected."}' "$GP_KILL_ESC")" ;;
    esac ;;
esac
if printf '%s\n' "$CMD" | grep -qE "$GP_RE"; then
  HSTATE="$PLUGIN/bin/heimdall-state"
  [ -x "$HSTATE" ] || HSTATE=heimdall-state
  SLINT="$PLUGIN/bin/heimdall-stop-lint"
  # PER-REPO TEST/LINT GATE (delta 4 in the header above): one gate per repository this command pushes, chosen by the class
  # bin/lib/hmd_push_target.py gives it -- sweep (heimdall's own regime: the quality gate below, unchanged, run in THAT repository),
  # repo-checks (its own declared checks: a green, current, clean-tree receipt, read here, never re-run) or unmanaged (one warning,
  # the push goes on). No answer from the resolver, or a class this does not know, is the sweep gate on the cwd: it only ever narrows.
  # The payload's cwd (the shell's own) is where the resolver starts reading paths from; without one it is this process's cwd.
  PG_HOME="$PWD"
  PG_BASE=$(jq -r '.cwd // empty' <<<"$INPUT" 2>/dev/null)
  PG_PLAN=$(python3 -I -S "$PLUGIN/bin/lib/hmd_push_target.py" "$PG_BASE" <<<"$CMD" 2>/dev/null)
  # no answer at all (python or the resolver missing, a hard kill): the strict gate on the session's cwd AND the payload's cwd, never on one of them.
  # (A resolver that fails while it runs prints its own strict rows for every directory it had reached, so this covers only what it could not even do.)
  case $PG_PLAN in
    '') PG_PLAN=$(printf 'sweep\t%s\tfallback\t-' "$PG_HOME")
        case $PG_BASE in
          ''|"$PG_HOME") ;;
          *) PG_PLAN=$PG_PLAN$'\n'$(printf 'sweep\t%s\tfallback\t-' "$PG_BASE") ;;
        esac ;;
  esac
  # a row is `class<TAB>dir<TAB>extra<TAB>gitdir` (`-` for an empty column; gitdir is the git directory resolved together with dir): for repo-checks the commits the push sends (given to `status --pushes`: the receipt must be for every
  # one; a missing or unreadable list is "cannot be listed" and blocks), for a sweep row `fallback` when it is the strict class only because
  # the command or git could not be read (then a gate that was never evaluated blocks instead of allowing)
  while IFS=$'\t' read -r PG_CLASS PG_DIR PG_EXTRA PG_GITDIR; do
    case "$PG_CLASS" in
      repo-checks)
        PG_RUN="$PLUGIN/bin/heimdall-repo-checks"
        if [ -x "$PG_RUN" ]; then
          PG_PAIR=()
          case "$PG_GITDIR" in /*) PG_PAIR=(--git-dir "$PG_GITDIR") ;; esac
          PG_OUT=$("$PG_RUN" status --repo "$PG_DIR" "${PG_PAIR[@]}" --pushes "$PG_EXTRA" 2>&1)
          PG_RC=$?
        else
          PG_OUT="repo-checks: NOT GREEN - $PG_RUN is missing, so the record of this repository's own checks cannot be read"
          PG_RC=127
        fi
        if [ "$PG_RC" = 0 ]; then
          printf '%s\n' "$PG_OUT" >&2
        else
          ESC=$(printf '%s' "$PG_OUT" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
          PG_ESC=$(printf '%s' "$PG_DIR" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
          deny "$(printf '{"error": "BLOCKED: pre-push repo-checks gate failed for %s. This repository declares its own checks (.heimdall/repo-checks.json), so a push needs a green, current, clean-tree record of them for the commit it sends (the heimdall sweep rules do not apply to it). --- %s"}' "$PG_ESC" "$ESC")"
        fi ;;
      unmanaged)
        printf 'heimdall: WARNING - %s is not managed by hmd (no heimdall sweep regime, no .heimdall/repo-checks.json), so no test or lint gate ran for this push; the secret gates below still apply. To gate it, declare its checks in .heimdall/repo-checks.json and record them: %s/bin/heimdall-repo-checks run --repo %s\n' "$PG_DIR" "$PLUGIN" "$PG_DIR" >&2 ;;
      *)
        if ! cd "$PG_DIR" 2>/dev/null; then
          # the gate belongs to THIS directory: running it wherever the hook happens to be would grade another repository. A candidate that does not exist
          # (a fallback row from a command that could not be read) cannot be pushed from; a directory the resolver just named that cannot be entered blocks
          case "$PG_EXTRA" in fallback) continue ;; esac
          PG_ESC=$(printf '%s' "$PG_DIR" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
          deny "$(printf '{"error": "BLOCKED: pre-push gate cannot grade this push: %s is the repository it goes to and cannot be entered, so its quality gate cannot run there (and running it elsewhere would grade another repository)."}' "$PG_ESC")"
        fi
        PG_ENVP=()
        case "$PG_GITDIR" in /*) PG_ENVP=(env GIT_DIR="$PG_GITDIR" GIT_WORK_TREE="$PG_DIR") ;; esac
        QGOUT=$(case "$PG_GITDIR" in (/*) export GIT_DIR="$PG_GITDIR" GIT_WORK_TREE="$PG_DIR" ;; esac; "$HSTATE" check-quality-gates 2>&1)
        QGRC=$?
        # Work merged from sub-agent worktrees is in no session's edit-tracker ledger, so the per-turn lint receipt never covers it. When
        # the lint evidence is missing, stale or does not cover the push, lint everything changed since the last push (bounded well inside
        # the hook's own time: a push gate that times out is a gate that lets the push through) and evaluate the gate once more.
        if [ "$QGRC" = 2 ] && [ -x "$SLINT" ] && printf '%s' "$QGOUT" | grep -qE 'Lint not clean -- (no-evidence|stale|uncovered|no-coverage)'; then
          printf 'heimdall: the lint receipt does not cover what this push ships - running %s --since-push (bounded)\n' "$SLINT" >&2
          if command -v perl >/dev/null 2>&1; then "${PG_ENVP[@]}" perl -e 'alarm 45; exec @ARGV' "$SLINT" --since-push --repo "$PWD" --budget 30 >/dev/null || true
          else "${PG_ENVP[@]}" "$SLINT" --since-push --repo "$PWD" --budget 30 >/dev/null || true; fi
          QGOUT=$(case "$PG_GITDIR" in (/*) export GIT_DIR="$PG_GITDIR" GIT_WORK_TREE="$PG_DIR" ;; esac; "$HSTATE" check-quality-gates 2>&1)
          QGRC=$?
        fi
        if [ "$QGRC" = 2 ]; then
          ESC=$(printf '%s' "$QGOUT" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
          HINT=""
          if printf '%s' "$QGOUT" | grep -q 'Lint not clean'; then
            HINT=" Lint evidence for what this push ships: run \`$SLINT --since-push --repo $PWD\` (lints every file changed since the last push, merged agent work included; add --budget 300 for a big diff). A waiver is not the answer."
          fi
          HINT_ESC=$(printf '%s' "$HINT" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
          deny "$(printf '{"error": "BLOCKED: pre-push quality gate failed. CLAUDE.md enforces quality gates before git push: all tests passing, lint clean, no untested changes. Fix the failing gate, re-run the suite, then record the result with `heimdall-state mark-clean` before pushing.%s --- %s"}' "$HINT_ESC" "$ESC")"
        elif [ "$QGRC" = 0 ]; then
          printf '%s\n' "$QGOUT" >&2
        elif [ "$PG_EXTRA" = fallback ]; then
          # the strict class here is only a fallback (the command or git could not be read), so "never evaluated" cannot stand in for a gate
          ESC=$(printf '%s' "$QGOUT" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
          PG_ESC=$(printf '%s' "$PG_DIR" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
          deny "$(printf '{"error": "BLOCKED: pre-push gate cannot grade this push. The command could not be read exactly (or git failed), so the strict regime applies to %s, and its quality gate was never evaluated (exit %s), so nothing stands in for it. Restate the push plainly (git push <remote> HEAD, or git -C <dir> push), or arm the gate with `heimdall-state init` and `heimdall-state mark-clean` in that checkout. --- %s"}' "$PG_ESC" "$QGRC" "$ESC")"
        else
          printf 'heimdall: quality-gate verdict UNAVAILABLE (exit %s) - the gates were NEVER EVALUATED, which is not a pass. Run `heimdall-state init` then `heimdall-state mark-clean` in this checkout to arm the pre-push gate. Allowing push to proceed. --- %s\n' "$QGRC" "$QGOUT" >&2
        fi ;;
    esac
  done <<<"$PG_PLAN"
  cd "$PG_HOME" 2>/dev/null || true
  if [ -x "$SCAN" ]; then
    if ! OUT=$(SECRET_SCAN_REQUIRE=1 "$SCAN" --require 2>&1); then
      ESC=$(printf '%s' "$OUT" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
      deny "$(printf '{"error": "BLOCKED: pre-push secret gate failed (gitleaks). A secret in the push range or a missing scanner blocks the push — gitleaks must be present and the range clean. --- %s"}' "$ESC")"
    else
      printf '%s\n' "$OUT" >&2
    fi
  fi
  SELFSCAN="$PLUGIN/bin/heimdall-selfscan"
  if [ -x "$SELFSCAN" ]; then
    if ! OUT=$("$SELFSCAN" 2>&1); then
      ESC=$(printf '%s' "$OUT" | jq -Rsa . | sed -e 's/^"//' -e 's/"$//')
      deny "$(printf '{"error": "BLOCKED: pre-push self-scan failed (gitleaks over Heimdall OWN full history). A secret anywhere in this repo history, or a missing scanner, blocks the push. Agents commit --no-verify (bypassing the pre-commit gate), so this full-history self-scan is the backstop. Scrub the secret from history (git filter-repo) or install gitleaks. --- %s"}' "$ESC")"
    else
      printf '%s\n' "$OUT" >&2
    fi
  fi
  NHP=$(git config --get core.hooksPath 2>/dev/null || true)
  NATIVE_GATE=0
  if [ "${HMD_SKIP:-0}" != "1" ] && [ "$NHP" = ".heimdall/hooks" ] && [ -x ".heimdall/hooks/pre-push" ]; then
    NATIVE_GATE=1
    printf 'heimdall: oracle+corpus gates delegated to the native pre-push hook (.heimdall/hooks/pre-push runs heimdall-gate-run) — skipping the duplicate inline run.\n' >&2
  fi
  FALSIFY="$PLUGIN/bin/falsify"
  ORACLES="$PLUGIN/evals/oracles"
  if [ "$NATIVE_GATE" = 0 ] && [ -x "$FALSIFY" ] && [ -d "$ORACLES" ]; then
    for D in "$ORACLES"/*/; do
      DOM=$(basename "$D")
      if [ -d "$D/fixtures/mutants" ]; then
        APPLIES=0
        if [ -f .planning/detected-stack.json ] && grep -q "$DOM" .planning/detected-stack.json 2>/dev/null; then
          APPLIES=1
        fi
        if [ -d "evals/oracles/$DOM" ]; then
          APPLIES=1
        fi
        if [ "$APPLIES" = 1 ]; then
          if ! "$FALSIFY" "$DOM" --assert-score 1.0 >&2; then
            STAMP="$PLUGIN/bin/heimdall-stamp"
            REP="evals/oracles/$DOM/report.json"
            if [ -x "$STAMP" ]; then
              if [ -f "$REP" ]; then
                "$STAMP" --report "$REP" --branch "heimdall/blocked/$DOM" >&2 2>/dev/null || true
              else
                "$STAMP" --violation "oracle gate $DOM is not falsifiable (score < 1.0)" --branch "heimdall/blocked/$DOM" >&2 2>/dev/null || true
              fi
            fi
            deny "$(printf '{"error": "BLOCKED: oracle gate %s is not falsifiable (score < 1.0). A green test suite over a non-falsifiable gate must not pass push. Harden the gate until bin/falsify reports 1.0."}' "$DOM")"
          fi
        fi
      fi
    done
  fi
  CORPUS="$PLUGIN/bin/corpus"
  if [ "$NATIVE_GATE" = 0 ] && [ -f evals/corpus/INDEX.json ] && [ -x "$CORPUS" ]; then
    if ! "$CORPUS" run >&2; then
      STAMP="$PLUGIN/bin/heimdall-stamp"
      [ -x "$STAMP" ] && "$STAMP" --violation "corpus regression — a case the gates once caught is no longer caught" --branch "heimdall/blocked/corpus" >&2 2>/dev/null || true
      deny "$(printf '{"error": "BLOCKED: corpus regression — bin/corpus run is nonzero. A case the gates once caught is no longer caught (CI inversion, H-8). The gates are regression-tested by the failures they once caught; restore 100%% catch before push."}')"
    fi
  fi
fi
"$PLUGIN/bin/parallelism-tracker" check Bash 2>&1 || true
