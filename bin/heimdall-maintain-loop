#!/usr/bin/env bash
# heimdall-maintain-loop — the DURABLE maintainer AUTOPILOT loop.
#
# A survivable WRAPPER around the honest issue engine (bin/heimdall-issue-loop ->
# bin/lib/issue_loop.py). It drives issue_loop.run_once one-or-N cycles with the
# guarantees a bare `/loop` lacks: a hard BUDGET CAP, run-away STOP conditions, an
# approval PARK, agent-pool BACKPRESSURE, and a machine-readable CHECKPOINT receipt
# so a fresh session (post death / compaction) knows exactly where it was.
#
# Usage:
#   heimdall-maintain-loop run [--repo DIR] [--base REF] [--evidence CMD]... \
#         [--config @FILE|JSON] [--max N] [--budget-tokens N] [--max-failures N] \
#         [--planning-dir DIR] [--context FILE] [--context-max-bytes N] [--dry-run]
#       Drain the queue one issue per cycle until a STOP condition trips (budget /
#       empty-queue / repeated-failure) or --max cycles run. Each transition appends
#       an autopilot header block to .planning/CHECKPOINT.md. The budget is checked
#       BEFORE every cycle — an over-cap or unreadable meter STOPS without running.
#       --context FILE ingests the rr LOCAL-SESSION-CONTEXT capsule (see
#       bin/heimdall-context-capsule): it PREPENDS the capsule as a clearly-delimited
#       read-only "LOCAL SESSION CONTEXT" briefing to EACH fix cycle's prompt so the
#       cloud bot has continuity with the local session. Omit --context to auto-detect
#       the shipped capsule at ~/.heimdall/rr-context/<slug>/context.md. It is a
#       briefing, not instructions — the issue is still the task. Without a capsule the
#       loop is byte-identical to before. --dry-run previews the plan (incl. the
#       context that WOULD be prepended) and executes nothing.
#   heimdall-maintain-loop plan [--repo DIR] [--config C] [--budget-tokens N] \
#         [--context FILE] [--context-max-bytes N]
#       Read-only DRY-RUN: the budget, the queued issues in pick order, and what
#       each WOULD do (park vs fix). With a resolved context capsule it also surfaces
#       the read-only briefing block that WOULD be prepended. Mutates nothing.
#   heimdall-maintain-loop heartbeat [--repo DIR] [--planning-dir DIR]
#       Render the last checkpoint block as ONE line receipt (wired into summary-card).
#   heimdall-maintain-loop resume-hint [--repo DIR] [--planning-dir DIR]
#       Print the /loop re-arm line IFF the checkpoint has stop:null + maintainer
#       enabled + budget remaining; otherwise print nothing (SessionStart stays quiet).
#   heimdall-maintain-loop status [--repo DIR]
#       The queue status + the budget snapshot + the last checkpoint block.
#   heimdall-maintain-loop runner-beat [--repo OWNER/NAME] [--runner-id ID]
#   heimdall-maintain-loop register-runner [--repo OWNER/NAME] [--runner-id ID]
#       Register a self-hosted RUNNER LIVENESS beat with the control plane (Arch A). Run
#       this from the operator's box on a cron (~every 30-60s): it upserts a signed,
#       TTL'd "maintainer-runner" presence beat (reusing the cp_presence substrate) so the
#       HYBRID dispatch routes the maintainer cycle to THIS box while it is up, and falls
#       back to a Cloud Run Job (Arch B) when the beat goes stale. --runner-id defaults to
#       the hostname; --repo scopes the beat to one repo (omit to advertise for any repo).
#   -h, --help                  this help.
#
# Exit status:
#   0  a command completed (including an honest STOP / disabled / IDLE outcome)
#   2  usage error / python missing

set -euo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
BINDIR="$(dirname "$SELF")"
LIB="$BINDIR/lib/maintain_loop.py"

usage() { sed -n '2,50p' "$SELF" | sed 's/^# \{0,1\}//'; }

PY="$(command -v python3 || command -v python || true)"
if [ -z "$PY" ]; then
  echo "error: python3 not found (required for the maintain loop)" >&2
  exit 2
fi

[ -f "$LIB" ] || { echo "error: missing library: $LIB" >&2; exit 2; }

[ $# -ge 1 ] || { usage >&2; exit 2; }

case "$1" in
  -h|--help) usage; exit 0 ;;
  runner-beat|register-runner)
    # THE SELF-HOSTED RUNNER LIVENESS BEAT (Arch A). Reuse the cp_presence heartbeat
    # substrate via cp_maintainer_runner.record_runner_beat — a DATA-ONLY, secret-scrubbed,
    # TTL'd "maintainer-runner" presence record the control plane's hybrid selector reads to
    # decide whether to route the cycle to THIS box. NO token touches the beat by construction
    # (only runner_id + repo + ts are stored). The operator runs this on a cron on his box.
    shift
    exec env PYTHONPATH="$BINDIR/lib:${PYTHONPATH:-}" "$PY" - "$@" <<'PYEOF'
import argparse
import json
import socket
import sys

import cp_maintainer_runner as mr

ap = argparse.ArgumentParser(prog="heimdall-maintain-loop runner-beat", add_help=True)
ap.add_argument("--repo", default=None,
                help="OWNER/NAME to scope the beat to (omit to advertise for any repo)")
ap.add_argument("--runner-id", dest="runner_id", default=None,
                help="stable id for this box (default: hostname)")
ap.add_argument("--handle", default=None, help="optional human label for the runner")
ap.add_argument("--home", default=None, help="control-plane HEIMDALL_HOME override")
args = ap.parse_args()

runner_id = args.runner_id or socket.gethostname() or "self-hosted-runner"
res = mr.record_runner_beat(runner_id, repo=args.repo, handle=args.handle, home=args.home)
print(json.dumps(res, sort_keys=True))
sys.exit(0 if res.get("ok") else 1)
PYEOF
    ;;
esac

# Thin wrapper: the lib owns argv parsing + stdout shape (house style — same split
# as bin/heimdall-issue-loop over bin/lib/issue_loop.py). The queue/loop libs are
# siblings under bin/lib, so add it to PYTHONPATH for the imports/soft-imports.
exec env PYTHONPATH="$BINDIR/lib:${PYTHONPATH:-}" "$PY" "$LIB" "$@"
