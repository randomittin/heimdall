#!/usr/bin/env bash
# heimdall-team — per-repo TEAM secret manager (the CLIENT side of multi-tenant
# team presence). ZERO-CONFIG team UX: one file, one secret, clone == join.
#
# WHAT A TEAM IS. A team = a high-entropy SECRET scoped to a repo. Presence (a
# teammate's HAID + online + current file/edits) is visible ONLY to holders of
# that secret; cross-team and outsiders see NOTHING. The secret is a bearer
# capability — its NON-secret handle is
#
#     team_id = sha256(b"heimdall-team\0" + team_secret).hexdigest()[:32]
#
# a one-way hash the server keys every presence partition on. Knowing team_id
# (it appears in storage keys) never yields the secret.
#
# ONE CANONICAL FILE (zero-config collapse). The secret ALWAYS lives in
#   <repo>/.heimdall/team.json    { "team_secret": "<base64url-43>",
#                                   "created": <epoch>, "source": "...",
#                                   "owner": { "handle": "...", "haid": "..." } }
# Every reader (heimdall-presence, heimdall-invite, this CLI) resolves from THAT
# ONE path. There is no second secret name. `HEIMDALL_TEAM_SECRET` survives only
# as the install-pipe input; `HEIMDALL_TEAM_DIR` is a test-only dir override.
#
# TRACKED vs GITIGNORED — decided by repo VISIBILITY (fail-SAFE):
#   • PRIVATE repo  -> team.json is a TRACKED, COMMITTED file. A teammate who
#     clones/pulls the repo ALREADY HAS team.json, so their first session enrolls
#     into the repo's team with ZERO commands. SECURITY REASONING: for a private
#     repo, READ ACCESS *IS* the team boundary — committing the secret grants
#     exactly what repo access already implies. This is boundary ALIGNMENT, not a
#     weakening: anyone who can read the committed secret could already read the
#     whole repo. We commit ONLY when the repo is PROVEN private.
#   • PUBLIC / INDETERMINATE repo -> team.json stays GITIGNORED and is NEVER
#     committed (a world-readable repo must never carry the bearer secret — that
#     would revert the multi-tenant isolation for exactly the repos where it
#     matters most). The owner grows the team out-of-band with `hmd invite`.
#   VISIBILITY IS RE-CHECKED CHEAPLY EACH SESSION. A tracked team.json on a repo
#   now detected PUBLIC (a private->public flip) triggers a LOUD warning + a
#   prompt to `hmd team rotate` (the secret + its git history are now exposed).
#
# BACK-COMPAT. A legacy <repo>/.heimdall/team.shared.json (the previous two-file
# model's committed secret) is STILL READ so already-shared teams keep working;
# an existing team.json is read as-is (no reset). New commits only ever land in
# team.json.
#
# THE USER-FACING SURFACE:
#   hmd team           SMART DEFAULT. On a GitHub repo with an AUTHENTICATED gh, PREFERS the
#                      AUTO (GitHub) path: form/join this repo's team from your GitHub access —
#                      NOTHING to paste (WAVE-3 zero-touch). If AUTO can't run (no gh auth, no
#                      CP url, severed) or is DENIED (not a collaborator) it falls back to the
#                      BEARER-SECRET path: no team -> mint (private commits, public gitignores +
#                      invites); a PROVEN-private repo whose team.json is UNTRACKED -> PROMOTE it
#                      to the tracked path so clones auto-join (the MIGRATION); else SHOW status.
#                      Public/unverifiable NEVER commits a secret here (the leak guard).
#   hmd team auto      Explicitly run the AUTO (GitHub) path now (loud at a TTY). Same engine the
#                      SessionStart hook runs quietly — forms/joins via GitHub, persists the
#                      NON-secret team_id, no secret written.
#   hmd invite         the one join line to hand a teammate. Since same-repo GitHub teammates now
#                      AUTO-JOIN, invite is only needed for CROSS-REPO / NON-GitHub / air-gapped
#                      joins (or a public repo the secret path grows out-of-band).
#   hmd join <secret>  teammate-side manual join for the bearer-secret fallback (invite wraps it).
#
# Internal subcommands (not part of the surface; used by SessionStart + tooling):
#   heimdall-team auto            SessionStart entry: FIRST the AUTO (GitHub) path — form/join
#                                 the team from GitHub access + persist the NON-secret team_id
#                                 (quiet, throttled, idempotent); on success it stops. Else
#                                 ensure a bearer-secret team + auto-commit it in a verified-
#                                 PRIVATE repo; gitignore it in a public one; warn on a flip.
#   heimdall-team new [--force]   mint a team_secret -> team.json (+ commit if the
#                                 repo is private); print the invite one-liner.
#   heimdall-team join <secret>   write team.json with a teammate's secret.
#   heimdall-team rotate          mint a FRESH secret (the remedy for a flip / a
#                                 leaked or forked secret): git-history warning +
#                                 owner re-invites; re-commits in a private repo.
#   heimdall-team share [--rotate]  commit team.json in a verified-PRIVATE repo
#                                 (the tracked-team primitive; `auto` uses it).
#   heimdall-team show [--json]   print the NON-SECRET team_id + source + owner +
#                                 mode. NEVER the secret.
#   -h, --help
#
# SECURITY. The secret is written ONLY to team.json (0600) and — in a verified-
# private repo — committed (tracked; the private-repo access boundary is the
# control, not the file mode). The secret NEVER crosses the argv of a child
# process (argv shows in `ps`) — it travels bash->python via the ENVIRONMENT only
# — and is never logged. `new` prints it once (the owner must see it to share);
# `show` never prints it; `join` takes it as this CLI's own argv (the documented
# entry point) but re-exposes it to nothing.
#
# Store: <git toplevel of $PWD>/.heimdall/team.json. HEIMDALL_TEAM_DIR overrides
# the dir wholesale (tests + non-git trees). HEIMDALL_FORCE_VISIBILITY overrides
# visibility detection (private|public|indeterminate) — TEST-ONLY, undocumented.
#
# Exit: 0 ok; 2 usage / refuse-clobber / weak-secret / IO error; non-zero on a
# commit PRIVACY REFUSAL (public repo or privacy unverifiable).
set -uo pipefail

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)"
LIB_DIR="$BIN_DIR/lib"
INVITE_CLI="$BIN_DIR/heimdall-invite"
IDENTITY_CLI="$BIN_DIR/heimdall-identity"
HAID_CLI="$BIN_DIR/heimdall-haid"

# The control-plane URL + opt-out consent live in ONE place (lib/cp-consent.sh — the SAME
# source heimdall-presence sources). We reuse it so the AUTO (GitHub) path resolves the exact
# CP URL presence does and honors the SAME sever/opt-out gate (severed => ZERO egress). Absent
# lib => the helpers stay undefined and the AUTO path DEFERS to the bearer-secret fallback.
# shellcheck source=lib/cp-consent.sh
[ -f "$LIB_DIR/cp-consent.sh" ] && . "$LIB_DIR/cp-consent.sh"

PY="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
[ -n "$PY" ] || { echo "heimdall-team: python3 is required" >&2; exit 2; }

# Print the header comment block as help (shift-proof: lines 2..the line before
# `set -uo pipefail`, with the leading `# ` stripped).
usage() { sed -n '2,/^set -uo pipefail/p' "$SELF" | sed -e '$d' -e 's/^# \{0,1\}//'; }

# ── Store location (per-repo, mirrors heimdall-identity) ────────────────────────
repo_root() { git rev-parse --show-toplevel 2>/dev/null || pwd; }
TEAM_DIR="${HEIMDALL_TEAM_DIR:-$(repo_root)/.heimdall}"
TEAM_FILE="$TEAM_DIR/team.json"
SHARED_FILE="$TEAM_DIR/team.shared.json"   # LEGACY committed secret (read-only back-compat)

# ── Primitives (secret crosses to python via ENV, never argv) ───────────────────
# Mint 32 random bytes -> base64url (43 chars, no padding) == secrets.token_urlsafe(32).
mint_secret() { "$PY" -c 'import secrets; print(secrets.token_urlsafe(32))'; }

# team_id = sha256("heimdall-team\0"+secret)[:32] — MUST match the server byte-for-byte.
team_id_of() { # $1 = secret (via env, not argv)
  HMD_TEAM_SEC="$1" "$PY" - <<'PYEOF'
import hashlib, os
s = os.environ["HMD_TEAM_SEC"]
print(hashlib.sha256(b"heimdall-team\x00" + s.encode("utf-8")).hexdigest()[:32])
PYEOF
}

# Resolve owner/repo (a github slug) from a remote URL — https / ssh / scp forms.
github_slug_of() { # $1 = remote url
  HMD_ORIGIN="$1" "$PY" - <<'PYEOF'
import os, re, sys
u = (os.environ.get("HMD_ORIGIN") or "").strip()
u = re.sub(r"\.git$", "", u)
m = re.search(r"github\.com[:/]+([^/]+)/(.+)$", u)
if m:
    sys.stdout.write(m.group(1) + "/" + m.group(2).rstrip("/"))
PYEOF
}

# The current dev's identity (owner attribution). Prints "haid<TAB>handle"; either
# field may be empty (best-effort — never fatal, never argv-leaks a secret).
current_identity() {
  local h="" hd=""
  [ -x "$IDENTITY_CLI" ] && h="$("$IDENTITY_CLI" current 2>/dev/null || true)"
  [ -z "$h" ] && [ -x "$HAID_CLI" ] && h="$("$HAID_CLI" current 2>/dev/null || true)"
  [ -x "$IDENTITY_CLI" ] && hd="$("$IDENTITY_CLI" --handle 2>/dev/null || true)"
  printf '%s\t%s' "$h" "$hd"
}

# Read the existing owner (haid<TAB>handle) out of team.json, tab-only if none.
read_owner() {
  [ -f "$TEAM_FILE" ] || { printf '\t'; return; }
  HMD_TEAM_FILE="$TEAM_FILE" "$PY" - <<'PYEOF'
import json, os, sys
try:
    o = (json.load(open(os.environ["HMD_TEAM_FILE"])).get("owner") or {})
    sys.stdout.write((o.get("haid") or "") + "\t" + (o.get("handle") or ""))
except Exception:
    sys.stdout.write("\t")
PYEOF
}

# Atomically write team.json 0600 with the given secret + a `source` tag + optional
# OWNER (secret via env, never argv). `source` (new|join|auto-solo|rotate) lets the
# resolver tell a DELIBERATE choice from an auto-solo mint. OWNER (haid/handle) is
# embedded ONLY when HMD_TEAM_OWNER_HAID or _HANDLE is non-empty — so `join`
# (joining someone ELSE's team) leaves owner unset while `new`/`rotate` record it.
write_team() { # $1=secret  $2=source ; owner via HMD_TEAM_OWNER_HAID/_HANDLE env
  mkdir -p "$TEAM_DIR" 2>/dev/null || { echo "heimdall-team: cannot create $TEAM_DIR" >&2; exit 2; }
  if ! HMD_TEAM_SEC="$1" HMD_TEAM_SRC="${2:-}" HMD_TEAM_FILE="$TEAM_FILE" "$PY" - <<'PYEOF'
import json, os, time
sec = os.environ["HMD_TEAM_SEC"]
src = os.environ.get("HMD_TEAM_SRC") or ""
path = os.environ["HMD_TEAM_FILE"]
rec = {"team_secret": sec, "created": int(time.time())}
if src:
    rec["source"] = src
oh = os.environ.get("HMD_TEAM_OWNER_HAID") or ""
oname = os.environ.get("HMD_TEAM_OWNER_HANDLE") or ""
if oh or oname:
    rec["owner"] = {"handle": oname, "haid": oh}
data = json.dumps(rec) + "\n"
# O_CREAT|O_TRUNC at 0600 so the secret is never momentarily world-readable.
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
try:
    os.write(fd, data.encode("utf-8"))
finally:
    os.close(fd)
os.chmod(path, 0o600)
PYEOF
  then
    echo "heimdall-team: failed to write $TEAM_FILE" >&2
    exit 2
  fi
}

# ── team-secret resolution (team.json canonical; legacy shared as fallback) ──────
# Single source of truth, shared by `show` + `share` + the auto paths; heimdall-
# presence implements the IDENTICAL precedence inline. WANT=secret prints the raw
# secret (internal only — captured into a var, never echoed); WANT=info prints
# "source\ncreated\npath" (NO secret) for display. Precedence: an EXPLICIT personal
# team.json (source new|join) wins; else the legacy committed team.shared.json;
# else an auto-solo/legacy team.json; else nothing.
_resolve() { # $1 = secret|info
  HMD_PERSONAL="$TEAM_FILE" HMD_SHARED="$SHARED_FILE" HMD_WANT="$1" "$PY" - <<'PYEOF'
import json, os, sys
def rd(p):
    try:
        d = json.load(open(p))
        s = d.get("team_secret")
    except Exception:
        return "", "", None, ""
    if isinstance(s, str) and s:
        src = d.get("source")
        return s, (src if isinstance(src, str) else ""), d.get("created"), p
    return "", "", None, ""
ps, psrc, pc, pp = rd(os.environ["HMD_PERSONAL"])
ss, _ssrc, sc, sp = rd(os.environ["HMD_SHARED"])
if ps and psrc in ("new", "join"):
    source, secret, created, path = "personal", ps, pc, pp
elif ss:
    source, secret, created, path = "shared", ss, sc, sp
elif ps:
    source, secret, created, path = "solo", ps, pc, pp
else:
    source, secret, created, path = "", "", None, ""
if os.environ["HMD_WANT"] == "secret":
    sys.stdout.write(secret)
else:
    c = str(int(created)) if isinstance(created, (int, float)) else ""
    sys.stdout.write(source + "\n" + c + "\n" + path)
PYEOF
}

# ── visibility detection (fail-SAFE) ─────────────────────────────────────────────
# Prints exactly one of: private | public | indeterminate.
#   PRIVATE is the ONLY value that authorizes committing the secret, and we emit it
#   ONLY when the repo is PROVEN private (authenticated `gh api .private == true`).
#   PUBLIC when proven public (gh .private==false, or an UNAUTHENTICATED api probe
#   reaches the repo == world-readable). Anything else -> INDETERMINATE, which every
#   caller treats as PUBLIC (never auto-commit a secret you cannot prove is safe).
# Cheap enough to re-run each session; result cached ~daily to avoid per-render API
# calls. HEIMDALL_FORCE_VISIBILITY overrides everything (test-only).
detect_visibility() {
  if [ -n "${HEIMDALL_FORCE_VISIBILITY:-}" ]; then printf '%s' "$HEIMDALL_FORCE_VISIBILITY"; return; fi
  local root origin slug
  root="$(git rev-parse --show-toplevel 2>/dev/null || true)"; [ -n "$root" ] || { printf 'indeterminate'; return; }
  origin="$(git -C "$root" remote get-url origin 2>/dev/null || true)"; [ -n "$origin" ] || { printf 'indeterminate'; return; }
  slug="$(github_slug_of "$origin")"; [ -n "$slug" ] || { printf 'indeterminate'; return; }

  # ~daily cache keyed by slug (a private->public flip is caught within the TTL).
  local cache="" now mt slughash
  if [ -n "${HOME:-}" ]; then
    slughash="$(printf '%s' "$slug" | tr '/:' '__')"
    cache="$HOME/.heimdall/vis-cache/$slughash"
    if [ -f "$cache" ]; then
      now="$(date +%s 2>/dev/null || echo 0)"
      mt="$(stat -f %m "$cache" 2>/dev/null || stat -c %Y "$cache" 2>/dev/null || echo 0)"
      if [ "$((now - mt))" -lt "${HEIMDALL_VIS_TTL:-86400}" ]; then
        cat "$cache" 2>/dev/null && return
      fi
    fi
  fi

  local verdict="indeterminate" priv code
  if command -v gh >/dev/null 2>&1; then
    priv="$(gh api "repos/$slug" --jq .private 2>/dev/null || true)"
    case "$priv" in true) verdict="private" ;; false) verdict="public" ;; esac
  fi
  if [ "$verdict" = "indeterminate" ] && command -v curl >/dev/null 2>&1; then
    # UNAUTHENTICATED probe: 200 == the repo is world-readable == PUBLIC. A 404
    # means private-or-missing (can't prove private) -> stays INDETERMINATE.
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 5 "https://api.github.com/repos/$slug" 2>/dev/null || true)"
    [ "$code" = "200" ] && verdict="public"
  fi
  if [ -n "$cache" ]; then
    mkdir -p "$(dirname "$cache")" 2>/dev/null && printf '%s' "$verdict" > "$cache" 2>/dev/null || true
  fi
  printf '%s' "$verdict"
}

# team.json is git-TRACKED in this repo? (== the committed private-repo team).
team_is_tracked() {
  local root; root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$root" ] || return 1
  [ -n "$(git -C "$root" ls-files -- "$TEAM_FILE" 2>/dev/null)" ]
}

# Commit team.json (tracked). The caller MUST have verified the repo is PRIVATE.
# Force past .gitignore (team.json is ignored by default) + --no-verify so the
# owner's OWN secret-scan hook does not block THIS sanctioned private-repo commit.
commit_team() { # $1 = commit message
  local root; root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$root" ] || return 2
  git -C "$root" add -f "$TEAM_FILE" 2>/dev/null || return 2
  git -C "$root" commit --no-verify -m "$1" -- "$TEAM_FILE" >/dev/null 2>&1 || return 2
  return 0
}

# Ensure team.json is GITIGNORED (the public/indeterminate case) so it can never be
# accidentally committed. No-op if already ignored (e.g. the repo's `.heimdall/*`).
# Does NOT untrack an already-tracked file — a private->public flip is handled by
# `rotate`, not by silently un-committing an exposed secret.
ensure_team_gitignored() {
  local root; root="$(git rev-parse --show-toplevel 2>/dev/null || true)"; [ -n "$root" ] || return 0
  # An ACTIVE ignore rule already covers the (untracked) secret -> nothing to do.
  git -C "$root" check-ignore -q "$TEAM_FILE" 2>/dev/null && return 0
  # IDEMPOTENCY GUARD: `git check-ignore` reports a TRACKED file as NOT ignored
  # (tracking overrides .gitignore), so on a private->public flip where team.json
  # was previously committed, the check above MISSES and — without this guard — the
  # same block would be re-appended on EVERY run (unbounded .gitignore growth). Skip
  # when the literal pattern line is already present so the block lands at most once,
  # regardless of the file's tracking state.
  local gi="$root/.gitignore"
  if [ -f "$gi" ] && grep -qxF '.heimdall/team.json' "$gi" 2>/dev/null; then
    return 0
  fi
  {
    printf '\n# heimdall team secret — gitignored on a PUBLIC/unverified repo: a bearer\n'
    printf '# secret must never be committed to a world-readable repo. Grow the team\n'
    printf '# out-of-band with `hmd invite`.\n'
    printf '.heimdall/team.json\n'
  } >> "$gi" 2>/dev/null || true
}

log_auto() { # best-effort, secret-free
  mkdir -p "$HOME/.heimdall" 2>/dev/null || return 0
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo now)" "$*" \
    >> "$HOME/.heimdall/team-auto.log" 2>/dev/null || true
}

# ── the tracked-team primitive: commit team.json in a verified-PRIVATE repo ──────
# Used by `share` (the explicit command) and `auto` (SessionStart). Verifies the
# repo is PROVEN private, then mints/records the secret + owner and commits it.
# HARD-REFUSES (fail closed) on public/indeterminate — the cardinal leak guard.
do_share() { # $1 = rotate(1|"")
  local rotate="${1:-}"
  local REPO_ROOT ORIGIN SLUG VIS
  REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$REPO_ROOT" ]; then
    echo "heimdall-team: not inside a git repository — nothing to commit into." >&2
    return 2
  fi
  ORIGIN="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)"
  SLUG="$(github_slug_of "$ORIGIN")"
  VIS="$(detect_visibility)"

  # ── THE CARDINAL CONTROL: commit ONLY when the repo is PROVEN private. ──
  if [ "$VIS" != "private" ]; then
    if [ "$VIS" = "public" ]; then
      cat >&2 <<EOF
heimdall-team: REFUSING — ${SLUG:-this repo} is a PUBLIC repo.

Committing the team secret to a PUBLIC repo would expose your entire team's private
presence (every teammate's HAID + activity) to the WORLD. That is exactly what the
multi-tenant team model exists to prevent. NOTHING was written or committed.

Grow the team out-of-band instead:  hmd invite
EOF
    else
      cat >&2 <<EOF
heimdall-team: could not PROVE ${SLUG:-this repo} is PRIVATE (no authenticated gh, or
the repo is not reachable). I will NOT commit the team secret unless I can prove the
repo is private — a secret committed to a repo whose access control is unproven could
leak. NOTHING was written or committed.

Authenticate gh and retry:  gh auth login   (then: hmd team)
Or grow the team out-of-band:  hmd invite
EOF
    fi
    return 1
  fi

  # PRIVATE-verified. Determine the secret + owner to commit.
  local SECRET OWNER OH OHNAME
  if [ -n "$rotate" ]; then
    SECRET="$(mint_secret)"
    [ -n "$SECRET" ] || { echo "heimdall-team: failed to mint a secret" >&2; return 2; }
  else
    SECRET="$(_resolve secret)"
    if [ -z "$SECRET" ]; then
      SECRET="$(mint_secret)"
      [ -n "$SECRET" ] || { echo "heimdall-team: failed to mint a secret" >&2; return 2; }
    fi
  fi
  # Preserve an existing owner; else stamp the current identity as owner.
  OWNER="$(read_owner)"; OH="${OWNER%%$'\t'*}"; OHNAME="${OWNER#*$'\t'}"
  if [ -z "$OH$OHNAME" ]; then
    OWNER="$(current_identity)"; OH="${OWNER%%$'\t'*}"; OHNAME="${OWNER#*$'\t'}"
  fi
  HMD_TEAM_OWNER_HAID="$OH" HMD_TEAM_OWNER_HANDLE="$OHNAME" write_team "$SECRET" "$([ -n "$rotate" ] && echo rotate || echo new)"

  local MSG
  if [ -n "$rotate" ]; then
    MSG="chore(team): rotate team.json secret — private repo (collaborators re-join on pull)"
  else
    MSG="chore(team): commit team.json — private repo, read access is the team boundary"
  fi
  if ! commit_team "$MSG"; then
    echo "heimdall-team: git commit failed (nothing changed, or no commit identity" >&2
    echo "configured). team.json is staged at $TEAM_FILE; commit it manually." >&2
    return 2
  fi

  local TID; TID="$(team_id_of "$SECRET")"
  if [ -n "$rotate" ]; then
    printf 'Rotated + re-committed the team (team_id %s) for %s.\n' "$TID" "${SLUG:-this repo}"
    printf 'The previous team_id ages out in one presence TTL; collaborators re-join on next pull.\n'
  else
    printf 'Committed (tracked) team.json (team_id %s) for %s — private repo.\n' "$TID" "${SLUG:-this repo}"
    printf 'Collaborators AUTO-JOIN this team on their next clone/pull. No paste needed.\n'
  fi
  printf 'Tracked file: %s — NOT pushed (push when ready).\n' "$TEAM_FILE"
  return 0
}

# Warn LOUDLY when a TRACKED team.json is on a repo now detected PUBLIC (a private->
# public flip): the committed secret + its git history are exposed. Prints to stderr;
# returns 0 iff it warned (so callers can gate). Never fatal.
flip_warn() {
  team_is_tracked || return 1
  [ "$(detect_visibility)" = "public" ] || return 1
  cat >&2 <<'EOF'

  ⚠  SECURITY: this repo's team secret (.heimdall/team.json) is COMMITTED, but the
     repo is now PUBLIC. The secret AND its git history are world-readable — anyone
     can join your team's presence. Rotate the secret NOW:

         hmd team rotate

     (mints a fresh secret; the exposed one stops working. Teammates re-join on pull.)
EOF
  return 0
}

# ══ AUTO (GitHub) — ZERO-TOUCH team formation via CP POST /team/auto ══════════════
# WAVE 3: a repo's team FORMS or JOINS automatically from the dev's GitHub ACCESS — no
# bearer secret to paste. This is the DEFAULT for GitHub repos; the bearer-secret path
# (new / join <secret> / invite) STAYS as the documented fallback for non-GitHub / air-
# gapped teams. The two COEXIST in team.json: the AUTO path writes the NON-secret team_id
# (+ an `auto` marker), never a secret, and preserves any secret the fallback wrote.

# The CP url — flag/env override > shipped cp-endpoint.json > the consent DEFAULT (unless
# SEVERED). Mirrors heimdall-presence's resolution exactly. Empty => the AUTO path defers.
resolve_cp_url() {
  local url="${HEIMDALL_CP_URL:-${BASE_URL:-}}"
  if [ -z "$url" ] && [ -n "${HOME:-}" ] && [ -f "$HOME/.heimdall/cp-endpoint.json" ]; then
    url="$(HMD_CFG="$HOME/.heimdall/cp-endpoint.json" "$PY" - <<'PYEOF'
import json, os, sys
try:
    sys.stdout.write(json.load(open(os.environ["HMD_CFG"])).get("url") or "")
except Exception:
    sys.stdout.write("")
PYEOF
)"
  fi
  if [ -z "$url" ] && ! cp_severed; then
    command -v _cp_consent_url >/dev/null 2>&1 && url="$(_cp_consent_url 2>/dev/null || true)"
  fi
  printf '%s' "$url"
}

# The dev has OPTED OUT of the control plane (persisted sever/decline). Reuses the SAME
# consent gate presence uses — severed => zero egress. Missing lib => not severed (the
# AUTO path then still needs a url + gh auth, both of which it verifies).
cp_severed() {
  command -v _cp_consent_decision >/dev/null 2>&1 || return 1
  local d; d="$(_cp_consent_decision 2>/dev/null || true)"
  [ "$d" = "severed" ] || [ "$d" = "declined" ]
}

# team.json already carries a GitHub-formed team_id? (idempotency — don't re-POST every
# SessionStart once formed).
team_has_auto_id() {
  [ -f "$TEAM_FILE" ] || return 1
  HMD_TEAM_FILE="$TEAM_FILE" "$PY" - <<'PYEOF'
import json, os, sys
try:
    d = json.load(open(os.environ["HMD_TEAM_FILE"]))
    sys.exit(0 if isinstance(d, dict) and d.get("team_id") else 1)
except Exception:
    sys.exit(1)
PYEOF
}

# Read the GitHub-formed team (team_id<TAB>mode<TAB>project) out of team.json; tabs only if none.
read_auto() {
  [ -f "$TEAM_FILE" ] || { printf '\t\t'; return; }
  HMD_TEAM_FILE="$TEAM_FILE" "$PY" - <<'PYEOF'
import json, os, sys
try:
    d = json.load(open(os.environ["HMD_TEAM_FILE"]))
    a = d.get("auto") or {}
    sys.stdout.write((d.get("team_id") or "") + "\t" + (a.get("mode") or "") + "\t" + (a.get("project") or ""))
except Exception:
    sys.stdout.write("\t\t")
PYEOF
}

# Persist the NON-secret team_id (+ auto marker) into team.json 0600, MERGING so any bearer
# secret the fallback wrote is PRESERVED (the two coexist). Writes NO secret. `source` stays
# whatever the secret path set — the auto marker lives under `auto.source == "auto-github"`.
persist_team_id() { # $1=team_id  $2=mode  $3=project
  mkdir -p "$TEAM_DIR" 2>/dev/null || { echo "heimdall-team: cannot create $TEAM_DIR" >&2; return 2; }
  HMD_TID="$1" HMD_MODE="${2:-}" HMD_PROJ="${3:-}" HMD_TEAM_FILE="$TEAM_FILE" "$PY" - <<'PYEOF'
import json, os, time
path = os.environ["HMD_TEAM_FILE"]
try:
    rec = json.load(open(path))
    if not isinstance(rec, dict):
        rec = {}
except Exception:
    rec = {}
rec["team_id"] = os.environ["HMD_TID"]
rec.setdefault("created", int(time.time()))
rec["auto"] = {
    "source": "auto-github",
    "mode": os.environ.get("HMD_MODE") or "",
    "project": os.environ.get("HMD_PROJ") or "",
    "joined": int(time.time()),
}
data = json.dumps(rec) + "\n"
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
try:
    os.write(fd, data.encode("utf-8"))
finally:
    os.close(fd)
os.chmod(path, 0o600)
PYEOF
}

# THE AUTO PATH. Resolve gh_user (`gh api user`), gh_proof (`gh auth token` — TRANSIT-ONLY:
# env -> python -> TLS, NEVER argv/logged/persisted), the repo slug + haid, then POST
# {repo, gh_user, gh_proof, haid, sig?} to {CP}/team/auto. On {ok, team_id, mode} persist the
# NON-secret team_id and print ONE honest line. RETURNS:
#   0  formed/joined via GitHub (caller SKIPS the secret path — the GitHub team is authoritative)
#   3  DEFER — no gh auth / no github remote / no CP url / SEVERED / offline / throttled:
#      the caller falls through to the bearer-secret fallback (presence still works)
#   4  DENIED — 403 non-collaborator/read-only, initiate_denied, or enroll_required (actionable
#      message printed in loud mode); caller falls through to the fallback so the dev is never
#      left teamless.
# MODE: loud prints results (interactive `hmd team` / `hmd team auto` at a TTY); quiet stays
# silent (SessionStart), is idempotent (skips once formed) and throttled. The gh token NEVER
# touches argv, a log, an error string, or team.json.
gh_auto() { # $1 = loud|quiet
  local MODE="${1:-quiet}"
  # opt-out / sever gate — no gh call, no network when the dev has said no.
  [ "${HEIMDALL_NO_TEAM_AUTOSHARE:-0}" = "1" ] && return 3
  [ -n "${HOME:-}" ] && [ -f "$HOME/.heimdall/no-team-autoshare" ] && return 3
  cp_severed && return 3
  # idempotent at SessionStart: already GitHub-formed -> nothing to do (no repeat POST).
  [ "$MODE" = quiet ] && team_has_auto_id && return 0
  # need a github remote slug.
  local ORIGIN SLUG
  ORIGIN="$(git remote get-url origin 2>/dev/null || true)"
  SLUG="$(github_slug_of "$ORIGIN")"
  [ -n "$SLUG" ] || return 3
  # need an AUTHENTICATED gh — the PROOF. Absent/unauth -> DEFER (also the hermetic-test path).
  command -v gh >/dev/null 2>&1 || return 3
  local GH_PROOF GH_USER
  GH_PROOF="$(gh auth token 2>/dev/null || true)"
  [ -n "$GH_PROOF" ] || return 3
  GH_USER="$(gh api user --jq .login 2>/dev/null || true)"
  [ -n "$GH_USER" ] || return 3
  # a CP url must resolve (flag/env/config/consent-default). None -> defer.
  local URL; URL="$(resolve_cp_url)"
  [ -n "$URL" ] || return 3
  # SessionStart THROTTLE: a denied/failed repo must not POST every session.
  if [ "$MODE" = quiet ]; then
    local st="$HOME/.heimdall/.team-gh-auto-stamp" iv="${HEIMDALL_TEAM_GH_AUTO_THROTTLE:-86400}"
    if [ -f "$st" ]; then
      local now mt
      now="$(date +%s 2>/dev/null || echo 0)"
      mt="$(stat -f %m "$st" 2>/dev/null || stat -c %Y "$st" 2>/dev/null || echo 0)"
      [ "$((now - mt))" -lt "$iv" ] && return 3
    fi
    mkdir -p "$HOME/.heimdall" 2>/dev/null && : > "$st" 2>/dev/null || true
  fi
  # identity + the OPTIONAL signing seed (sig rides only if this dev is already enrolled).
  local IDENT HAID HAID_SLUG SEED_FILE=""
  IDENT="$(current_identity)"; HAID="${IDENT%%$'\t'*}"
  if [ -n "${HOME:-}" ] && [ -n "$HAID" ]; then
    HAID_SLUG="$(printf '%s' "$HAID" | tr '/:' '__')"
    SEED_FILE="$HOME/.heimdall/pki/$HAID_SLUG.seed"
  fi
  # POST — gh_proof crosses to python via ENV ONLY (never argv), rides the JSON body over TLS,
  # and is NEVER echoed. python prints 6 secret-free lines: status, ok, team_id, mode, project, reason.
  local RES
  RES="$(HMD_URL="$URL" HMD_REPO="$SLUG" HMD_GH_USER="$GH_USER" HMD_GH_PROOF="$GH_PROOF" \
         HMD_HAID="$HAID" HMD_SEED_FILE="$SEED_FILE" HMD_LIB="$LIB_DIR" "$PY" - <<'PYEOF'
import json, os, sys
import urllib.error
import urllib.request

url = os.environ["HMD_URL"].rstrip("/")
# The base body the OPTIONAL signature covers (sig is appended AFTER, last key, so the server
# strips it and re-serializes the remainder in the SAME order to verify).
base = {
    "repo": os.environ["HMD_REPO"],
    "gh_user": os.environ["HMD_GH_USER"],
    "gh_proof": os.environ["HMD_GH_PROOF"],
    "haid": os.environ.get("HMD_HAID") or "",
}
body = json.dumps(base, separators=(",", ":")).encode("utf-8")
seed_file = os.environ.get("HMD_SEED_FILE") or ""
lib = os.environ.get("HMD_LIB") or ""
if seed_file and os.path.exists(seed_file) and lib:
    try:
        sys.path.insert(0, lib)
        import cp_auth as K
        if K.crypto_available():
            with open(seed_file, "r", encoding="utf-8") as fh:
                seed = fh.read().strip()
            if seed:
                sig = K.sign(seed, K.canonical_message("POST", "/team/auto", body))
                signed = dict(base)
                signed["sig"] = sig
                body = json.dumps(signed, separators=(",", ":")).encode("utf-8")
    except Exception:
        body = json.dumps(base, separators=(",", ":")).encode("utf-8")

req = urllib.request.Request(url + "/team/auto", data=body, method="POST")
req.add_header("Content-Type", "application/json")
haid = os.environ.get("HMD_HAID") or ""
if haid:
    req.add_header("X-Heimdall-HAID", haid)
status, out = 0, {}
try:
    with urllib.request.urlopen(req, timeout=10) as resp:
        raw = resp.read()
        status = resp.status
        out = json.loads(raw) if raw else {}
except urllib.error.HTTPError as exc:
    status = exc.code
    try:
        raw = exc.read()
        out = json.loads(raw) if raw else {}
    except Exception:
        out = {}
except Exception:
    status, out = 0, {}


def field(k):
    v = out.get(k)
    return "" if v is None else str(v)


sys.stdout.write("\n".join([
    str(status),
    "1" if out.get("ok") else "0",
    field("team_id"),
    field("mode"),
    field("project"),
    field("reason") or field("error"),
]) + "\n")
PYEOF
)"
  local STATUS OKF TEAM_ID TMODE PROJECT REASON
  STATUS="$(printf '%s\n' "$RES" | sed -n '1p')"
  OKF="$(printf '%s\n'   "$RES" | sed -n '2p')"
  TEAM_ID="$(printf '%s\n' "$RES" | sed -n '3p')"
  TMODE="$(printf '%s\n'  "$RES" | sed -n '4p')"
  PROJECT="$(printf '%s\n' "$RES" | sed -n '5p')"
  REASON="$(printf '%s\n' "$RES" | sed -n '6p')"

  if [ "$OKF" = "1" ] && [ -n "$TEAM_ID" ]; then
    persist_team_id "$TEAM_ID" "$TMODE" "$PROJECT"
    if [ "$MODE" = loud ]; then
      case "$TMODE" in
        initiated) printf 'Initiated the team for %s via GitHub — teammates with repo access auto-join (nothing to paste).\n' "$SLUG" ;;
        joined)    printf "Joined %s's team via GitHub (team_id %s).\n" "$SLUG" "$TEAM_ID" ;;
        *)         printf 'Formed the team for %s via GitHub (team_id %s).\n' "$SLUG" "$TEAM_ID" ;;
      esac
    fi
    return 0
  fi

  # transport failure -> DEFER (offline is not a hard error; the secret path still works).
  if [ "${STATUS:-0}" = "0" ]; then
    [ "$MODE" = loud ] && printf "heimdall-team: couldn't reach the control plane to auto-form %s's team — falling back to the local team.\n" "$SLUG"
    return 3
  fi
  # DENIED — actionable, never leaks the token or the reason verbatim beyond the known codes.
  case "$REASON" in
    *non*collaborator*|*read*only*|*read-only*|*forbidden*|*not*collaborator*)
      if [ "$MODE" = loud ]; then
        printf 'heimdall-team: GitHub says you lack write (collaborator) access to %s, so I cannot auto-join you to its team.\n' "$SLUG"
        printf '  Ask a repo admin to add you, then rerun  hmd team  — or start your OWN team with:  hmd team new\n'
      fi
      return 4 ;;
    initiate_denied)
      if [ "$MODE" = loud ]; then
        printf 'heimdall-team: the control plane declined to initiate a team for %s (initiate_denied).\n' "$SLUG"
        printf '  Start one explicitly with:  hmd team new    (then grow it with:  hmd invite)\n'
      fi
      return 4 ;;
    enroll_required)
      if [ "$MODE" = loud ]; then
        printf "heimdall-team: %s's team needs an explicit enroll first (enroll_required).\n" "$SLUG"
        printf '  Run:  hmd team new    (or ask the owner to send you:  hmd invite)\n'
      fi
      return 4 ;;
  esac
  if [ "${STATUS:-0}" = "403" ]; then
    if [ "$MODE" = loud ]; then
      printf 'heimdall-team: GitHub access check failed for %s (HTTP 403) — I cannot auto-join you.\n' "$SLUG"
      printf '  Ask for collaborator access, or start your own team with:  hmd team new\n'
    fi
    return 4
  fi
  # any other non-ok -> defer to the secret path (never leave the dev teamless).
  [ "$MODE" = loud ] && printf 'heimdall-team: auto team formation for %s did not complete (status %s%s) — falling back to the local team.\n' "$SLUG" "${STATUS:-?}" "$([ -n "$REASON" ] && printf ', %s' "$REASON")"
  return 3
}

# ── `hmd team auto` — the zero-COMMAND SessionStart entry ─────────────────────────
# FIRST attempts the AUTO (GitHub) path — success => the GitHub team is authoritative and NO
# bearer secret is written (skip the ensure below); DEFER/DENY => fall through so presence still
# works zero-config. Then, when the repo is VERIFIABLY PRIVATE, commits team.json (tracked ->
# collaborators auto-join); when PUBLIC/indeterminate, gitignores it (never commit a secret).
# Warns on a flip. Never pushes, never blocks, idempotent. Opt out: HEIMDALL_NO_TEAM_AUTOSHARE=1
# or ~/.heimdall/no-team-autoshare. loud at a TTY (a human ran `hmd team auto`), quiet otherwise.
cmd_auto() {
  [ "${HEIMDALL_NO_TEAM_AUTOSHARE:-0}" = "1" ] && exit 0
  [ -f "$HOME/.heimdall/no-team-autoshare" ] && exit 0
  local _amode=quiet
  { [ -t 1 ] || [ -n "${HMD_TEAM_AUTO_LOUD:-}" ]; } && _amode=loud
  if gh_auto "$_amode"; then exit 0; fi
  # capture heimdall-ACTIVE *before* our own solo mint (else we'd mark ourselves active).
  local active=0 m
  for m in "$TEAM_FILE" "$TEAM_DIR/identity.json" .planning/heimdall-state.json heimdall-state.json superx-state.json; do
    [ -e "$m" ] && { active=1; break; }
  done
  # ALWAYS ensure a team (zero-config presence). Stamp the minter as owner.
  if [ -z "$(_resolve secret)" ]; then
    local sec ident oh ohname
    sec="$(mint_secret)"
    if [ -n "$sec" ]; then
      ident="$(current_identity)"; oh="${ident%%$'\t'*}"; ohname="${ident#*$'\t'}"
      HMD_TEAM_OWNER_HAID="$oh" HMD_TEAM_OWNER_HANDLE="$ohname" write_team "$sec" "auto-solo"
    fi
  fi
  # A tracked team.json now on a PUBLIC repo -> loud flip warning (always, cheap).
  flip_warn || true
  # Only touch git state inside a git repo.
  git rev-parse --show-toplevel >/dev/null 2>&1 || exit 0

  local VIS; VIS="$(detect_visibility)"
  if [ "$VIS" != "private" ]; then
    # PUBLIC / indeterminate -> ensure the secret can NEVER be committed. This is a
    # cheap, protective, always-on action (we already minted team.json into this
    # repo's .heimdall; gitignoring it is a strictly smaller footprint). It does NOT
    # untrack an already-tracked file — a flip is handled by `rotate`.
    team_is_tracked || ensure_team_gitignored
    exit 0
  fi

  # PRIVATE + heimdall ACTIVE here -> auto-commit team.json (tracked; teammates
  # auto-join on pull). The `active` gate keeps us from injecting a commit into a
  # repo the dev merely cd'd into without running heimdall. Throttled so we never
  # commit every session; skip if already tracked.
  [ "$active" = 1 ] || exit 0
  if ! team_is_tracked; then
    local stamp="$HOME/.heimdall/.team-auto-stamp" interval="${HEIMDALL_TEAM_AUTO_THROTTLE:-86400}"
    if [ -f "$stamp" ]; then
      local now mt; now="$(date +%s 2>/dev/null || echo 0)"
      mt="$(stat -f %m "$stamp" 2>/dev/null || stat -c %Y "$stamp" 2>/dev/null || echo 0)"
      [ "$((now - mt))" -lt "$interval" ] && exit 0
    fi
    mkdir -p "$HOME/.heimdall" 2>/dev/null && : > "$stamp" 2>/dev/null || true  # claim window before work
    do_share "" >/dev/null 2>&1 && log_auto "auto-committed team.json in $(repo_root)"
  fi
  exit 0
}

# ── `hmd team` (bare) — STATUS ────────────────────────────────────────────────────
cmd_status() { # $@ passed through (--json)
  local AS_JSON=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) AS_JSON=1; shift ;;
      *) echo "heimdall-team: unexpected argument: $1" >&2; exit 2 ;;
    esac
  done
  local INFO SOURCE CREATED SRCPATH SECRET TID VIS TRACKED MODE OWNER OH OHNAME
  local AUTO AUTO_TID AUTO_MODE AUTO_PROJ
  INFO="$(_resolve info)"
  SOURCE="$(printf '%s' "$INFO" | sed -n '1p')"
  CREATED="$(printf '%s' "$INFO" | sed -n '2p')"
  SRCPATH="$(printf '%s' "$INFO" | sed -n '3p')"
  SECRET="$(_resolve secret)"
  # The GitHub-formed (AUTO) team — a NON-secret team_id that COEXISTS with any bearer secret.
  AUTO="$(read_auto)"
  AUTO_TID="$(printf '%s' "$AUTO" | cut -f1)"
  AUTO_MODE="$(printf '%s' "$AUTO" | cut -f2)"
  AUTO_PROJ="$(printf '%s' "$AUTO" | cut -f3)"

  if [ -z "$SECRET" ]; then
    # No bearer secret — but a GitHub-formed team_id means the repo IS on a team (the AUTO path).
    if [ -n "$AUTO_TID" ]; then
      if [ -n "$AS_JSON" ]; then
        HMD_TEAM_TID="$AUTO_TID" HMD_TEAM_MODE="$AUTO_MODE" HMD_TEAM_PROJ="$AUTO_PROJ" \
        HMD_TEAM_FILE="$TEAM_FILE" "$PY" - <<'PYEOF'
import json, os
print(json.dumps({
    "configured": True,
    "source": "auto-github",
    "team_id": os.environ["HMD_TEAM_TID"],
    "owner": None,
    "mode": "auto-github (" + (os.environ.get("HMD_TEAM_MODE") or "formed") + ")",
    "project": os.environ.get("HMD_TEAM_PROJ") or None,
    "created": None,
    "path": os.environ["HMD_TEAM_FILE"],
}))
PYEOF
      else
        printf 'configured: yes (via GitHub — no secret to manage)\n'
        printf 'team_id:    %s\n' "$AUTO_TID"
        printf 'mode:       auto-github (%s)\n' "${AUTO_MODE:-formed}"
        [ -n "$AUTO_PROJ" ] && printf 'project:    %s\n' "$AUTO_PROJ"
        printf 'grow:       teammates with GitHub access to this repo AUTO-JOIN (nothing to share).\n'
        printf 'fallback:   for cross-repo / non-GitHub teammates use:  hmd invite\n'
      fi
      exit 0
    fi
    if [ -n "$AS_JSON" ]; then
      printf '{"configured": false, "source": null, "team_id": null, "owner": null, "mode": "none", "created": null, "path": "%s"}\n' "$TEAM_FILE"
    else
      printf 'configured: no\n'
      printf 'No team is configured for this repo yet.\n'
      printf 'DEFAULT (GitHub repos): a team forms automatically from your GitHub access —\n'
      printf '  run  hmd team  (or it happens on your next heimdall session). Nothing to paste.\n'
      printf 'FALLBACK (non-GitHub / air-gapped): mint a bearer-secret team explicitly:\n'
      printf '  hmd team new     then grow it with:  hmd invite\n'
    fi
    exit 0
  fi

  TID="$(team_id_of "$SECRET")"
  VIS="$(detect_visibility)"
  if team_is_tracked; then TRACKED="yes"; else TRACKED="no"; fi
  # MODE: shared-committed (tracked) vs solo/invite (untracked).
  if [ "$TRACKED" = "yes" ]; then MODE="shared (tracked team.json — clone = join)";
  elif [ "$SOURCE" = "shared" ]; then MODE="shared (legacy team.shared.json)";
  else MODE="solo (untracked — grow with hmd invite)"; fi
  OWNER="$(read_owner)"; OH="${OWNER%%$'\t'*}"; OHNAME="${OWNER#*$'\t'}"

  if [ -n "$AS_JSON" ]; then
    HMD_TEAM_TID="$TID" HMD_TEAM_CREATED="$CREATED" HMD_TEAM_SOURCE="$SOURCE" \
    HMD_TEAM_FILE="$SRCPATH" HMD_TEAM_VIS="$VIS" HMD_TEAM_TRACKED="$TRACKED" \
    HMD_TEAM_MODE="$MODE" HMD_TEAM_OH="$OH" HMD_TEAM_OHNAME="$OHNAME" "$PY" - <<'PYEOF'
import json, os
created = os.environ.get("HMD_TEAM_CREATED") or ""
oh = os.environ.get("HMD_TEAM_OH") or ""
oname = os.environ.get("HMD_TEAM_OHNAME") or ""
owner = {"handle": oname, "haid": oh} if (oh or oname) else None
print(json.dumps({
    "configured": True,
    "source": os.environ["HMD_TEAM_SOURCE"],
    "team_id": os.environ["HMD_TEAM_TID"],
    "owner": owner,
    "mode": os.environ["HMD_TEAM_MODE"],
    "visibility": os.environ["HMD_TEAM_VIS"],
    "tracked": os.environ["HMD_TEAM_TRACKED"] == "yes",
    "created": int(created) if created.isdigit() else None,
    "path": os.environ["HMD_TEAM_FILE"],
}))
PYEOF
  else
    printf 'configured: yes\n'
    printf 'team_id:    %s\n' "$TID"
    printf 'mode:       %s\n' "$MODE"
    if [ -n "$OHNAME$OH" ]; then
      printf 'owner:      %s%s\n' "${OHNAME:-?}" "$([ -n "$OH" ] && printf ' (%s)' "$OH")"
    fi
    printf 'visibility: %s\n' "$VIS"
    [ -n "$CREATED" ] && printf 'created:    %s\n' "$CREATED"
    printf 'store:      %s\n' "$SRCPATH"
    [ -n "$AUTO_TID" ] && printf 'github:     also GitHub-formed (team_id %s) — repo-access teammates auto-join.\n' "$AUTO_TID"
    if [ "$TRACKED" = "yes" ]; then
      printf 'grow:       collaborators AUTO-JOIN on clone/pull (nothing to share).\n'
    else
      printf 'grow:       hand a teammate:  hmd invite\n'
    fi
    printf 'note:       GitHub repos form teams automatically (hmd team); this bearer-secret\n'
    printf '            path is the FALLBACK for cross-repo / non-GitHub joins.\n'
    printf '(the team secret is never printed — see %s)\n' "$SRCPATH"
  fi
  # A flip (tracked + public) is the one loud, always-shown warning.
  flip_warn || true
  exit 0
}

# ── `hmd team new` — mint a fresh team (private -> commit; public -> gitignore+invite) ─
cmd_new() { # $1 = force(1|"")
  local FORCE="${1:-}"
  if [ -f "$TEAM_FILE" ] && [ -z "$FORCE" ]; then
    cat >&2 <<EOF
heimdall-team: a team is already configured for this repo:
    $TEAM_FILE
Refusing to overwrite it (that would orphan you from the current team).
Re-mint anyway with:   heimdall-team new --force
Or inspect it with:    hmd team
EOF
    return 2
  fi
  local SECRET IDENT OH OHNAME TID
  SECRET="$(mint_secret)"
  [ -n "$SECRET" ] || { echo "heimdall-team: failed to mint a secret" >&2; return 2; }
  IDENT="$(current_identity)"; OH="${IDENT%%$'\t'*}"; OHNAME="${IDENT#*$'\t'}"
  HMD_TEAM_OWNER_HAID="$OH" HMD_TEAM_OWNER_HANDLE="$OHNAME" write_team "$SECRET" "new"
  TID="$(team_id_of "$SECRET")"
  printf 'Minted a new team for this repo (team_id %s).\n' "$TID"
  printf 'Stored 0600 in %s\n' "$TEAM_FILE"
  # In a PROVEN-private repo, commit it (tracked -> collaborators auto-join).
  if [ "$(detect_visibility)" = "private" ]; then
    if commit_team "chore(team): commit team.json — private repo, read access is the team boundary"; then
      printf 'Committed (tracked) — collaborators AUTO-JOIN on clone/pull.\n\n'
    fi
  else
    ensure_team_gitignored
    printf '\n'
    printf '\xe2\x9a\xa0 the line below contains your TEAM SECRET — share only with teammates\n'
    printf '  (public repo: distribute out-of-band; never commit a bearer secret)\n\n'
    if [ -x "$INVITE_CLI" ]; then
      "$INVITE_CLI" || true
    fi
  fi
  return 0
}

# ── `hmd team` (bare) — SMART DEFAULT dispatch (the zero-thought surface) ───────────
# Resolves what the repo needs and does it, so a dev never has to know the internal verbs:
#   • NO team yet             -> MINT one (cmd_new): a PROVEN-private repo COMMITS it
#                                (clone == join); a public/unverifiable repo gitignores it
#                                + prints the invite line (never commit a bearer secret).
#   • team present, PROVEN    -> PROMOTE it to the committed/tracked path. THE MIGRATION:
#     private, but UNTRACKED     a repo minted BEFORE the committed-path feature, or minted
#                                while visibility was momentarily INDETERMINATE (no
#                                authenticated gh) — so its team.json was gitignored + never
#                                committed (the EXACT state that leaves a private repo's
#                                clones NOT auto-joining: they mint their own solo team and
#                                need a manual `hmd team join`). Force-add + commit it so
#                                clones/pulls carry it and first-session presence auto-joins.
#                                Idempotent: an already-tracked team is left untouched.
#   • otherwise               -> just SHOW status. A PUBLIC / privacy-unverifiable repo NEVER
#                                commits here (do_share hard-refuses regardless) — the cardinal
#                                leak guard: a bearer secret must never land in a public tree.
cmd_dispatch() {
  # PREFER the AUTO (GitHub) path when gh is authenticated + a github remote exists: a repo's
  # team forms/joins from GitHub access with nothing to paste (the WAVE-3 default). It DEFERS
  # (rc 3) when gh is absent/unauthenticated, no CP url resolves, or the dev is severed, and
  # DENIES (rc 4) for a non-collaborator — either way we fall through to the bearer-secret path,
  # the documented fallback (mint / promote-if-private / show). loud: this is an interactive run.
  local grc
  gh_auto loud; grc=$?
  [ "$grc" = 0 ] && exit 0
  local SECRET
  SECRET="$(_resolve secret)"
  if [ -z "$SECRET" ]; then
    cmd_new ""
    exit $?
  fi
  if ! team_is_tracked && [ "$(detect_visibility)" = "private" ]; then
    if do_share ""; then exit 0; fi
    # do_share failed (no commit identity / IO) -> fall through to status (never fatal).
  fi
  cmd_status "$@"
}

# ── argv ────────────────────────────────────────────────────────────────────────
SUB="${1:-}"; shift 2>/dev/null || true

case "$SUB" in
  -h|--help|help)
    usage; exit 0 ;;

  ""|dispatch)
    cmd_dispatch "$@"; exit $? ;;

  show|status)
    cmd_status "$@"; exit $? ;;

  auto)
    cmd_auto ;;

  new)
    FORCE=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --force) FORCE=1; shift ;;
        *) echo "heimdall-team new: unexpected argument: $1" >&2; exit 2 ;;
      esac
    done
    cmd_new "$FORCE"; exit $? ;;

  join)
    SECRET="${1:-}"
    [ -n "$SECRET" ] || { echo "heimdall-team join: needs a <secret> argument" >&2; exit 2; }
    if [ "${#SECRET}" -lt 32 ]; then
      echo "heimdall-team: refusing a weak team secret (<32 chars) — a hand-typed weak" >&2
      echo "secret could collide into another team. Ask your teammate for the full secret" >&2
      echo "(hmd team new mints a 43-char one)." >&2
      exit 2
    fi
    # A deliberate join into someone ELSE's team: no owner stamped (owner is theirs).
    write_team "$SECRET" "join"
    TID="$(team_id_of "$SECRET")"
    printf 'Joined team %s for this repo.\n' "$TID"
    printf 'Stored 0600 in %s\n' "$TEAM_FILE"
    printf 'Presence will scope to this team on your next beat/roster.\n'
    exit 0 ;;

  rotate)
    # The remedy for a private->public flip, or a leaked/forked secret: mint a FRESH
    # secret, re-commit it if the repo is private. The OLD team_id ages out in one
    # presence TTL; the owner must RE-INVITE anyone on the public/out-of-band path.
    WAS_TRACKED=""
    team_is_tracked && WAS_TRACKED=1
    if [ -n "$WAS_TRACKED" ]; then
      # A tracked team.json means the OLD secret is already in git history. Warn.
      cat >&2 <<'EOF'
heimdall-team rotate: the previous secret was COMMITTED, so it REMAINS in this repo's
git HISTORY even after rotation. Rotating mints a NEW secret that supersedes it for
presence, but to fully purge the exposed one you must also scrub git history
(git filter-repo / BFG) and force-push. Rotate now; scrub history if the repo was ever
public or forked outside your org.
EOF
    fi
    VIS="$(detect_visibility)"
    if [ "$VIS" = "private" ]; then
      if do_share "rotate"; then
        printf 'Owner: RE-INVITE anyone you added out-of-band — the old invite line is dead.\n'
        exit 0
      fi
      exit 2
    fi
    # Public/indeterminate: mint a fresh LOCAL secret (never commit), keep gitignored.
    SECRET="$(mint_secret)"
    [ -n "$SECRET" ] || { echo "heimdall-team rotate: failed to mint a secret" >&2; exit 2; }
    OWNER="$(read_owner)"; OH="${OWNER%%$'\t'*}"; OHNAME="${OWNER#*$'\t'}"
    if [ -z "$OH$OHNAME" ]; then OWNER="$(current_identity)"; OH="${OWNER%%$'\t'*}"; OHNAME="${OWNER#*$'\t'}"; fi
    HMD_TEAM_OWNER_HAID="$OH" HMD_TEAM_OWNER_HANDLE="$OHNAME" write_team "$SECRET" "rotate"
    ensure_team_gitignored
    TID="$(team_id_of "$SECRET")"
    printf 'Rotated the team secret (new team_id %s). The old secret no longer works.\n' "$TID"
    printf 'Stored 0600 in %s (gitignored — public/unverified repo).\n' "$TEAM_FILE"
    printf 'Owner: RE-INVITE your teammates with the fresh line:  hmd invite\n'
    exit 0 ;;

  share)
    ROTATE=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --rotate) ROTATE=1; shift ;;
        *) echo "heimdall-team share: unexpected argument: $1" >&2; exit 2 ;;
      esac
    done
    do_share "$ROTATE"; exit $? ;;

  *)
    echo "heimdall-team: unknown subcommand '$SUB' (surface: team | invite | join; internal: new | rotate | share | auto | show)" >&2
    usage >&2
    exit 2 ;;
esac
