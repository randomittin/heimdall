#!/usr/bin/env python3
# heimdall-gh-app-token — mint a SHORT-LIVED GitHub App INSTALLATION access token for
# the Heimdall maintainer's DEDICATED PR-BOT identity.
#
# WHY THIS EXISTS. The maintainer opens PRs as a bot (issue_pr.gh_bot_runner reads
# HEIMDALL_PR_BOT_TOKEN), NEVER as the operator's personal account. The clean, no-seat,
# auto-scoped, revocable way to be that bot is a GitHub App. But a GitHub App
# INSTALLATION token EXPIRES AFTER 1 HOUR — a static token cannot back a long-running,
# unattended loop. So the durable model is: store the App's ID + private key +
# installation id, and MINT A FRESH installation token ON DEMAND (per cycle) from the
# App's private key. This tool is that minter.
#
# THE FLOW (all stdlib + the repo's already-pinned `cryptography` — NO external jwt lib):
#   1. build an App JWT (RS256): header {alg:RS256,typ:JWT}, payload
#      {iat: now-60, exp: iat+600 (the 10-min max), iss: <App ID>}; sign the
#      base64url(header).base64url(payload) with the App private key (RSA PKCS1v15 +
#      SHA-256) and append base64url(signature).
#   2. POST {api-base}/app/installations/<installation-id>/access_tokens with
#      Authorization: Bearer <that JWT> — GitHub returns a fresh installation token
#      scoped to the permissions + repos the App was granted (contents:write on
#      heimdall/* + issues:write + pull_requests:write; NO main push, NO merge — enforced
#      server-side). Issues:write backs the connector's read/comment/close of the queue.
#   3. print ONLY the token to stdout (for capture into an env var).
#
# SECRET DISCIPLINE (the #1 bar). The private key is read from env / a 0600 file ONLY —
# NEVER an argv element, NEVER echoed or logged. The minted token goes to STDOUT ONLY
# (nothing else is printed to stdout); all diagnostics go to stderr. API errors are
# reported clearly (bad key, wrong installation id, App not installed) WITHOUT ever
# echoing the key or the JWT.
#
# CONFIG (env):
#   HEIMDALL_GH_APP_ID               (required) the GitHub App's App ID (an integer).
#   HEIMDALL_GH_APP_INSTALLATION_ID  (required) the installation id on the target repo(s).
#   HEIMDALL_GH_APP_PRIVATE_KEY      the App private key PEM inline, OR
#   HEIMDALL_GH_APP_PRIVATE_KEY_FILE a path to a 0600 .pem holding it (one of the two).
#   HEIMDALL_GH_APP_REPOSITORIES     (optional) comma-separated repo NAMES to further
#                                    restrict the token to (defense-in-depth; default =
#                                    the installation's full granted scope).
#   HEIMDALL_GH_API_BASE             (optional) API base, default https://api.github.com
#                                    (a test/GHE seam).
#
# Exit status: 0 minted (token on stdout); 2 missing/invalid config; 1 API failure.

from __future__ import annotations

import base64
import json
import os
import sys
import time
import urllib.error
import urllib.request

# 10 minutes is GitHub's hard maximum for an App JWT's lifetime. We backdate iat 60s
# for clock skew and set exp = iat + JWT_TTL so exp is <= 10 min from iat AND < 10 min
# from now — accepted under either interpretation of the cap.
JWT_TTL_SECONDS = 600
IAT_BACKDATE_SECONDS = 60
DEFAULT_API_BASE = "https://api.github.com"


def _die(msg, code):
    """Print a clear diagnostic to STDERR (never stdout) and exit nonzero. No secret
    (key/JWT/token) is ever part of `msg`."""
    sys.stderr.write("heimdall-gh-app-token: %s\n" % msg)
    raise SystemExit(code)


def _b64url(raw):
    """base64url WITHOUT padding (JWT wire form)."""
    return base64.urlsafe_b64encode(raw).rstrip(b"=")


def _load_private_key_pem():
    """Read the App private key PEM from HEIMDALL_GH_APP_PRIVATE_KEY (inline) or
    HEIMDALL_GH_APP_PRIVATE_KEY_FILE (a path). Returns the PEM bytes. The key value is
    NEVER logged. A missing/unreadable source is a clear exit(2)."""
    inline = os.environ.get("HEIMDALL_GH_APP_PRIVATE_KEY")
    if inline:
        return inline.encode("utf-8")
    path = os.environ.get("HEIMDALL_GH_APP_PRIVATE_KEY_FILE")
    if path:
        try:
            with open(path, "rb") as fh:
                return fh.read()
        except OSError as exc:
            _die(
                "cannot read HEIMDALL_GH_APP_PRIVATE_KEY_FILE (%s): %s"
                % (path, exc.strerror or "unreadable"),
                2,
            )
    _die(
        "no private key — set HEIMDALL_GH_APP_PRIVATE_KEY (PEM) or "
        "HEIMDALL_GH_APP_PRIVATE_KEY_FILE (path to a 0600 .pem)",
        2,
    )


def build_jwt(app_id, private_pem, now=None):
    """Build a signed RS256 App JWT for `app_id` using the App `private_pem` (bytes).
    iss=app_id, iat backdated 60s, exp=iat+600. Signed with RSA PKCS1v15 + SHA-256 via
    the repo's `cryptography` dep — no external jwt library. Returns the compact JWT str.

    A key that will not load as a PEM RSA private key is a clear exit(2) — WITHOUT
    echoing the key material."""
    # imported here so `import ast; parse` style checks + a missing dep degrade to a
    # clear runtime error rather than an import-time crash of the whole tool.
    try:
        from cryptography.hazmat.primitives import hashes, serialization
        from cryptography.hazmat.primitives.asymmetric import padding, rsa
    except Exception as exc:  # noqa: BLE001
        _die("the `cryptography` dependency is not importable: %s" % exc, 2)

    try:
        key = serialization.load_pem_private_key(private_pem, password=None)
    except Exception:  # noqa: BLE001 — bad/empty/encrypted PEM. Never echo the key.
        _die(
            "could not load the GitHub App private key — it is not a valid unencrypted "
            "PEM RSA private key (check HEIMDALL_GH_APP_PRIVATE_KEY[_FILE])",
            2,
        )
    if not isinstance(key, rsa.RSAPrivateKey):
        _die("the GitHub App private key must be an RSA key (GitHub Apps sign RS256)", 2)

    issued = int(now if now is not None else time.time())
    iat = issued - IAT_BACKDATE_SECONDS
    payload = {"iat": iat, "exp": iat + JWT_TTL_SECONDS, "iss": str(app_id)}
    header = {"alg": "RS256", "typ": "JWT"}
    signing_input = (
        _b64url(json.dumps(header, separators=(",", ":")).encode("utf-8"))
        + b"."
        + _b64url(json.dumps(payload, separators=(",", ":")).encode("utf-8"))
    )
    signature = key.sign(signing_input, padding.PKCS1v15(), hashes.SHA256())
    return (signing_input + b"." + _b64url(signature)).decode("ascii")


def _token_request_body():
    """Optionally scope the installation token to specific repositories (by NAME) for
    defense-in-depth. Default: no body -> the installation's full granted scope."""
    repos = os.environ.get("HEIMDALL_GH_APP_REPOSITORIES", "").strip()
    if not repos:
        return b"{}"
    names = [r.strip() for r in repos.split(",") if r.strip()]
    return json.dumps({"repositories": names}).encode("utf-8")


def mint_installation_token(app_id, installation_id, private_pem, api_base=None,
                            now=None):
    """Mint a fresh installation access token: build the App JWT, POST it to
    /app/installations/<id>/access_tokens, and return the token string. The JWT and
    token are never logged. A non-2xx response is a clear exit(1) carrying the HTTP
    status + a short (key-free) detail from GitHub's own error body."""
    base = (api_base or os.environ.get("HEIMDALL_GH_API_BASE") or DEFAULT_API_BASE)
    base = base.rstrip("/")
    jwt = build_jwt(app_id, private_pem, now=now)
    url = "%s/app/installations/%s/access_tokens" % (base, installation_id)
    req = urllib.request.Request(url, data=_token_request_body(), method="POST")
    req.add_header("Authorization", "Bearer " + jwt)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    req.add_header("Content-Type", "application/json")
    req.add_header("User-Agent", "heimdall-gh-app-token")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        detail = ""
        try:
            body = json.loads(exc.read().decode("utf-8", "replace"))
            detail = body.get("message", "") if isinstance(body, dict) else ""
        except Exception:  # noqa: BLE001
            detail = ""
        _die(
            "GitHub installation-token request failed: HTTP %s%s — check "
            "HEIMDALL_GH_APP_ID, HEIMDALL_GH_APP_INSTALLATION_ID, and that the App is "
            "installed on the target repo(s) with Contents+Issues+Pull requests write."
            % (exc.code, (" (%s)" % detail) if detail else ""),
            1,
        )
    except urllib.error.URLError as exc:
        _die("could not reach the GitHub API (%s): %s" % (url, exc.reason), 1)
    except (ValueError, TypeError) as exc:
        _die("GitHub returned an unparseable installation-token response: %s" % exc, 1)

    token = data.get("token") if isinstance(data, dict) else None
    if not token:
        _die("GitHub response carried no `token` field (unexpected API shape)", 1)
    return token


def main(argv):
    # This tool is env-configured on purpose: a secret must never ride an argv (argv is
    # ps-visible / recorded). The only accepted flags are informational.
    if any(a in ("-h", "--help") for a in argv):
        sys.stderr.write(
            "usage: heimdall-gh-app-token\n"
            "  Mints a short-lived GitHub App INSTALLATION token; prints ONLY the token\n"
            "  to stdout. Config is via env (secrets NEVER on argv):\n"
            "    HEIMDALL_GH_APP_ID, HEIMDALL_GH_APP_INSTALLATION_ID,\n"
            "    HEIMDALL_GH_APP_PRIVATE_KEY or HEIMDALL_GH_APP_PRIVATE_KEY_FILE,\n"
            "    [HEIMDALL_GH_APP_REPOSITORIES], [HEIMDALL_GH_API_BASE]\n"
        )
        return 0

    app_id = os.environ.get("HEIMDALL_GH_APP_ID", "").strip()
    if not app_id:
        _die("HEIMDALL_GH_APP_ID is not set — the GitHub App's numeric App ID", 2)
    installation_id = os.environ.get("HEIMDALL_GH_APP_INSTALLATION_ID", "").strip()
    if not installation_id:
        _die(
            "HEIMDALL_GH_APP_INSTALLATION_ID is not set — the App's installation id on "
            "the target repo(s)",
            2,
        )
    private_pem = _load_private_key_pem()

    token = mint_installation_token(app_id, installation_id, private_pem)
    # STDOUT carries ONLY the token (no trailing diagnostics) for `TOKEN=$(...)` capture.
    sys.stdout.write(token + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
