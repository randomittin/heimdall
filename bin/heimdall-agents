#!/usr/bin/env bash
# heimdall-agents — tracker + reaper for Claude Code Agent-tool SUBAGENTS.
#
# WHY THIS EXISTS ─────────────────────────────────────────────────────────────
# Subagents spawned via Claude Code's Agent tool (e.g. hmd:coder, hmd:reviewer)
# are owned by the Claude Code HARNESS. They NEVER enter heimdall's agent-pool or
# HAID ledger, so when one dies, hangs, or parks, heimdall has ZERO visibility —
# the harness still shows it in its FleetView and the swarm count keeps counting a
# corpse. This tool gives heimdall its OWN honest view: it enumerates the harness's
# per-subagent task files, classifies each by MEASURED evidence, serves a correct
# LIVE count for the statusline, and records a decision in heimdall's own registry
# so a dead/parked subagent stops inflating the count — automatically, on a hook,
# with no human input.
#
# CAN A PARKED "MAILBOX" AGENT BE CLEARED?  YES — BUT NEVER BY THIS TOOL ──────
# An Agent spawn carrying `name:` becomes a mailbox teammate. Its sidecar
# <transcript>.meta.json says so verbatim: "taskKind":"in_process_teammate".
# Measured on this machine, 2026-08-03 — why nothing OUTSIDE the harness reaches
# a parked teammate, which is why this tool cannot be the thing that clears it:
#   • NO PROCESS TO SIGNAL. `pgrep -x claude` lists only top-level session
#     processes. 5 parked teammates in one session produced 0 extra PIDs, and
#     `lsof` on a parked agent's transcript returns no holder. "in_process" is
#     literal: the agent is a coroutine inside the session's event loop. The only
#     signalable PID is the session itself — killing it destroys all live work.
#   • NO CONTROL SURFACE. A session dir contains exactly `scratchpad/` + `tasks/`.
#     A `find` for any non-`.output` file across every task dir on disk returned
#     nothing: no socket, no pidfile, no terminate marker. (Note: this also means
#     the `<id>.status` file this tool once relied on NEVER EXISTS in production.)
#   • SendMessage DOES NOT TERMINATE. Of 20 real SendMessage invocations across
#     566 transcripts, 19 hard-failed with "No such tool available: SendMessage.
#     SendMessage exists but is not enabled in this context." The 1 success merely
#     delivered to an inbox — the recipient stayed resident.
#   • NO NAMED AGENT HAS EVER COMPLETED. Across 566 transcripts: 118 spawns with
#     taskKind=in_process_teammate produced 0 <task-notification> events. 266
#     regular subagents produced 213 (80.1%). A mailbox agent reaches end_turn,
#     finishes its work, and then parks forever awaiting a message that no
#     terminate path exists to send.
# CONCLUSION: no signal, no file and no message reaches a parked teammate from
# outside, so THIS TOOL cannot clear one and never claims to. The HARNESS can:
#   • `TaskStop` — Claude Code 2.1.198+ ("stops a running background task by ID.
#     It also accepts an agent-team teammate or a named background agent by agent
#     ID or name"). This machine runs 2.1.220 and b214eb1 declared TaskStop on
#     every heimdall agent that can spawn. This is the programmatic path.
#   • `/tasks` → select → Ctrl+X — the same clear, performed by hand.
#   • restarting the owning session — the blunt fallback, always available.
# SAY "DOCUMENTED", NOT "PROVEN": agent definitions load at session start, so
# TaskStop was not available to the session that wrote this and NOBODY has yet
# exercised it against a parked teammate end to end. Report it as the documented
# mechanism pending verification — do not upgrade that wording without a run.
# WHAT DID NOT CHANGE: `name:` is still a defect and the PreToolUse deny stands.
# A named agent NEVER returns a result to its spawn call and NEVER self-terminates
# (measured 0/43 named spawns completed vs 59/66 unnamed; a controlled pair
# emitted one idle_notification each, both "taskKind":"in_process_teammate").
# TaskStop converts a wedge into a leak — it does not make `name:` safe.
# This tool therefore does the strongest HONEST thing available to it: it detects
# parked teammates automatically, excludes them from every heimdall count, reaps
# the ones that are PROVABLY gone, and prints a loud, precise report naming every
# mechanism that clears them. It never claims a kill it did not perform.
#
# HONEST BOUNDARY (do not overclaim) ──────────────────────────────────────────
# The harness's task files are NOT ours — we NEVER delete or modify them. `reap`
# writes only to heimdall's own registry so heimdall's list/count exclude the
# corpse thereafter. This tool CANNOT remove an entry from Claude Code's
# FleetView; that surface is owned by the harness.
#
# THE DATA SOURCES — TWO OF THEM, AND BOTH ARE REQUIRED ───────────────────────
# (1) THE TASK DIR   <tmp>/claude-<uid>/<slug>/<session>/tasks/<task-id>.output
#     Each `.output` is a symlink to the subagent's transcript jsonl (or a plain
#     file). Authoritative metadata is the transcript's sibling `.meta.json`
#     (agentType, name, taskKind). Files with NO agent metadata and a
#     background-Bash id shape (b + 8-9 alnum) are BACKGROUND SHELL TASKS, not
#     agents, and are excluded.
#     MEASURED 2026-08-03: the symlink routinely points CROSS-SESSION — a task
#     dir under session 2ac8810f held links to transcripts under session
#     da3a8887. Never assume the task dir's session owns the transcript.
# (2) THE SUBAGENTS DIR  ~/.claude/projects/<slug>/<session>/subagents/
#     A parked mailbox teammate NEVER gets a task-dir `.output` entry. MEASURED:
#     the session owning 17 parked teammates had NO `tasks/` dir at all, only
#     `scratchpad/`. Those agents exist ONLY as `agent-<id>.jsonl` plus an
#     `agent-<id>.meta.json` sidecar here. Enumerating the task dir alone is
#     BLIND to the exact agents this tool exists to surface, so the inventory is
#     the UNION of both sources, deduped by id.
#
# COMPLETION EVIDENCE — WHAT PROVES AN AGENT FINISHED ─────────────────────────
# When a subagent stops, the harness enqueues a record into its PARENT session
# transcript (~/.claude/projects/<slug>/<session>.jsonl):
#   {"type":"queue-operation","operation":"enqueue",…,"content":
#    "<task-notification>\n<task-id>ID</task-id>\n<tool-use-id>…</tool-use-id>\n
#     <output-file>…</output-file>\n<status>completed</status>\n<summary>…"}
# That notification is AUTHORITATIVE and is the only positive proof of a result
# being returned. Measured statuses: completed | failed | killed. Measured on
# this machine: 244 notifications across one session — and 0 of the 17 parked
# teammates had one, which is precisely why they leak.
#
# SUBCOMMANDS ─────────────────────────────────────────────────────────────────
#   list [--json]    enumerate subagents: id, age(s), state, name
#   count            print the number of LIVE subagents (statusline consumes this)
#   orphans [--json] OPERATOR VIEW: only the agents that need attention —
#                    parked mailbox teammates, provably-dead orphans, wedged and
#                    stale agents. Excludes anything live, working or completed.
#   reap [--json]    record terminal/parked subagents in heimdall's registry
#                    (idempotent). Never touches harness files.
#   sweep [--json]   AUTOMATION ENTRY POINT: reap + print an actionable report
#                    naming every parked agent and every mechanism that clears it.
#                    Idempotent, safe to run repeatedly, exit 0 always.
#   -h | --help
#
# STATE MODEL (precedence order — first match wins) ───────────────────────────
#   reaped    — already recorded in heimdall's registry (excluded from count)
#   working   — last transcript event is a tool_use: the agent is AWAITING A TOOL
#               RESULT and is genuinely alive no matter how old its mtime is.
#               NEVER reaped. This is the guard that makes a 40-minute build safe.
#   hung      — awaiting a tool result for >= HMD_AGENT_HUNG_SECS (default 3600).
#               An hour on one tool call is not work; it is a wedge.
#   done      — a task-notification says `completed`. THE AGENT SUCCEEDED. This
#               outranks every negative state, including a dead session: the work
#               was finished and returned before the session went away. Calling a
#               success `orphaned` is the single worst lie this tool can tell.
#   failed    — a task-notification says `failed`, or a terminal `.status` marker
#   killed    — a task-notification says `killed`
#   orphaned  — NO completion evidence AND the owning session is GONE, so this
#               in-process agent is provably dead with nothing to show for it.
#   mailbox   — taskKind=in_process_teammate, no notification, session ALIVE.
#               Parked until something clears it. Excluded from the live count.
#               Cleared from INSIDE the harness — TaskStop, /tasks → Ctrl+X, or a
#               session restart — never by this tool.
#   stale     — age >= HMD_AGENT_STALE_SECS (default 900), not working
#   live      — age < threshold, regular subagent      ← counted, with `working`
#
# LIVENESS — WHY NOT pgrep ─────────────────────────────────────────────────────
# MEASURED 2026-08-03: `pgrep -x claude` returned 2 pids whose lsof cwds were
# /Users/rj/Downloads/code/rally and /…/SuperSmartVerify. The heimdall session
# that was running AT THAT MOMENT appeared in neither. Deciding liveness from the
# process table alone therefore produced false "dead" verdicts for every agent in
# the live session — the root cause of completed agents being labelled `orphaned`.
# A session's own transcript is written continuously while it runs, so its mtime
# is a reliable, read-only liveness signal and is consulted FIRST. The pgrep/lsof
# probe remains as a fallback for sessions that are idle but still resident.
#
# ENV ─────────────────────────────────────────────────────────────────────────
#   HMD_AGENT_STALE_SECS    live/stale threshold, seconds (default 900)
#   HMD_AGENT_HUNG_SECS     awaiting-a-tool-result wedge threshold (default 3600)
#   HMD_AGENT_SESSION_LIVE_SECS  a session transcript touched more recently than
#                           this proves the session is alive (default STALE_SECS)
#   HMD_AGENT_TASKDIR       override the task dir (skips discovery). Tests use it.
#   HMD_AGENT_SUBAGENTS_DIR override the subagents dir (skips discovery)
#   HMD_AGENT_REAPED_FILE   override registry (default
#                           ${HEIMDALL_HOME:-$HOME/.heimdall}/agents-reaped.json)
#   HMD_AGENT_PROJECTS_DIR  override ~/.claude/projects (tests)
#   HMD_AGENT_LIVE_SLUGS    if DEFINED (even empty), used verbatim as the list of
#                           project slugs whose session process is alive, instead
#                           of probing pgrep/lsof. Empty ⇒ no session alive.
#                           Hermetic tests set this; production leaves it unset.
#   HMD_AGENT_CWD           cwd whose slug drives task-dir discovery (default PWD)
#   HMD_NOW                 override "now" epoch seconds (deterministic tests)
#   HMD_AGENT_NO_SWEEP      if set to 1, `sweep` is an explicit opt-out no-op
#
# Exit: 0 always for list/count/orphans/reap/sweep (fail-closed, degraded, never
#       crashes); 2 only on usage error.
set -uo pipefail

command -v jq >/dev/null 2>&1 || { echo "error: jq is required" >&2; exit 2; }

# ── config ───────────────────────────────────────────────────────────────────
STALE_SECS="${HMD_AGENT_STALE_SECS:-}"
case "$STALE_SECS" in ''|*[!0-9]*) STALE_SECS=900 ;; esac
HUNG_SECS="${HMD_AGENT_HUNG_SECS:-}"
case "$HUNG_SECS" in ''|*[!0-9]*) HUNG_SECS=3600 ;; esac
SESSION_LIVE_SECS="${HMD_AGENT_SESSION_LIVE_SECS:-}"
case "$SESSION_LIVE_SECS" in ''|*[!0-9]*) SESSION_LIVE_SECS="$STALE_SECS" ;; esac
NOW="${HMD_NOW:-}"
case "$NOW" in ''|*[!0-9]*) NOW="$(date +%s)" ;; esac
HMD_HOME="${HEIMDALL_HOME:-${HOME:-}/.heimdall}"
REAPED_FILE="${HMD_AGENT_REAPED_FILE:-$HMD_HOME/agents-reaped.json}"
PROJECTS_DIR="${HMD_AGENT_PROJECTS_DIR:-${HOME:-}/.claude/projects}"

# ── portable mtime (follow symlink → the transcript's real last-activity time) ─
_mtime() { stat -L -f%m "$1" 2>/dev/null || stat -L -c%Y "$1" 2>/dev/null || echo 0; }

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

_slug_for_cwd() {
  # Claude projects slug: every non-alphanumeric char -> '-'. Mirrors
  # heimdall-tokens _slug_for_cwd so we resolve the SAME dir the harness names.
  local s="$1"
  printf '%s' "${s//[^A-Za-z0-9]/-}"
}

# ── task-dir discovery ────────────────────────────────────────────────────────
# HMD_AGENT_TASKDIR wins outright. Otherwise derive from the cwd slug: glob every
# plausible tmp root for claude-*/<slug>/*/tasks and pick the NEWEST. Fail CLOSED
# to "" if nothing matches — callers treat "" as zero agents.
resolve_taskdir() {
  if [ -n "${HMD_AGENT_TASKDIR:-}" ]; then
    printf '%s' "$HMD_AGENT_TASKDIR"
    return 0
  fi
  local cwd slug root newest newest_mt mt d
  cwd="${HMD_AGENT_CWD:-$PWD}"
  slug="$(_slug_for_cwd "$cwd")"
  newest=""; newest_mt=-1
  for root in "${TMPDIR:-}" /private/tmp /tmp; do
    [ -n "$root" ] || continue
    for d in "${root%/}"/claude-*/"$slug"/*/tasks; do
      [ -d "$d" ] || continue
      mt="$(_mtime "$d")"
      if [ "$mt" -gt "$newest_mt" ] 2>/dev/null; then
        newest_mt="$mt"; newest="$d"
      fi
    done
  done
  printf '%s' "$newest"
}

# ── reaped-registry membership (loaded ONCE; no subprocess per file) ──────────
load_reaped() {
  local ids=""
  if [ -f "$REAPED_FILE" ]; then
    ids="$(jq -r 'keys[]?' "$REAPED_FILE" 2>/dev/null | tr '\n' ' ')"
  fi
  printf ' %s ' "$ids"
}

# ── live-session detection ────────────────────────────────────────────────────
# A subagent runs INSIDE its session's process. If that process is gone, the agent
# is provably gone with it. We identify a session by its project slug: every live
# `claude` process's cwd is slugified and compared against the task dir's slug.
#
# SAFETY: this is deliberately CONSERVATIVE. If ANY live claude process maps to
# the slug, every agent under it is treated as possibly-alive and is NEVER
# orphan-reaped. We only ever declare "orphaned" when NO process for that project
# exists at all. Probing is LAZY (only when a candidate exists) and cached, so the
# statusline's `count` never pays for pgrep/lsof in the common case.
_LIVE_SLUGS=""
_LIVE_SLUGS_LOADED=""
live_slugs() {
  if [ -n "$_LIVE_SLUGS_LOADED" ]; then printf '%s' "$_LIVE_SLUGS"; return 0; fi
  _LIVE_SLUGS_LOADED=1
  if [ "${HMD_AGENT_LIVE_SLUGS+defined}" = "defined" ]; then
    # Test/explicit override: use verbatim, never probe the real process table.
    _LIVE_SLUGS=" $(printf '%s' "$HMD_AGENT_LIVE_SLUGS" | tr '\n' ' ') "
    printf '%s' "$_LIVE_SLUGS"; return 0
  fi
  local pid cwd acc=""
  for pid in $(pgrep -x claude 2>/dev/null); do
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    cwd="$(lsof -p "$pid" 2>/dev/null | awk '$4=="cwd"{print $NF; exit}')"
    [ -n "$cwd" ] || continue
    acc="$acc $(_slug_for_cwd "$cwd")"
  done
  _LIVE_SLUGS=" ${acc# } "
  printf '%s' "$_LIVE_SLUGS"
}

# Slug + session encoded in the task dir path: .../<slug>/<session>/tasks
_slug_of_taskdir()    { local b="${1%/tasks}"; b="${b%/*}"; printf '%s' "${b##*/}"; }
_session_of_taskdir() { local b="${1%/tasks}"; printf '%s' "${b##*/}"; }

# A session's own transcript. The harness appends to it continuously while the
# session runs, so its mtime is direct, read-only evidence of liveness.
_session_transcript() {
  local slug="$1" sess="$2"
  [ -n "$slug" ] && [ -n "$sess" ] || return 0
  printf '%s' "$PROJECTS_DIR/$slug/$sess.jsonl"
}

# session_is_alive <slug> [session]
# EVIDENCE ORDER MATTERS. The process probe alone is provably unreliable (see the
# LIVENESS note in the header: the running session was invisible to pgrep/lsof),
# so a freshly-written session transcript is consulted FIRST. Only when that
# yields nothing do we fall back to the process table.
session_is_alive() {
  local slug="$1" sess="${2:-}" f mt
  [ -n "$slug" ] || return 1
  # Explicit override (hermetic tests / callers that already know) wins outright.
  if [ "${HMD_AGENT_LIVE_SLUGS+defined}" = "defined" ]; then
    case "$(live_slugs)" in *" $slug "*) return 0 ;; esac
    return 1
  fi
  if [ -n "$sess" ]; then
    f="$(_session_transcript "$slug" "$sess")"
    if [ -n "$f" ] && [ -f "$f" ]; then
      mt="$(_mtime "$f")"
      if [ $(( NOW - mt )) -lt "$SESSION_LIVE_SECS" ] 2>/dev/null; then return 0; fi
    fi
  fi
  case "$(live_slugs)" in *" $slug "*) return 0 ;; esac
  return 1
}

# The project slug for this invocation. When a task dir is pinned we read the
# slug straight out of its path so tests and explicit callers stay consistent.
_slug_now() {
  if [ -n "${HMD_AGENT_TASKDIR:-}" ]; then _slug_of_taskdir "$HMD_AGENT_TASKDIR"; return 0; fi
  _slug_for_cwd "${HMD_AGENT_CWD:-$PWD}"
}

# ── the AUTHORITATIVE agent inventory ─────────────────────────────────────────
# MEASURED 2026-08-03: a parked mailbox teammate NEVER gets a task-dir `.output`
# entry. The session that owned 5 of them had no `tasks/` dir at all — only
# `scratchpad/`. In-process teammates exist ONLY as a transcript + `.meta.json`
# under ~/.claude/projects/<slug>/<session>/subagents/. Enumerating the task dir
# alone therefore CANNOT see the very agents that leak. This is the real source.
#
# scope: "current" = newest session for the slug (what the statusline counts)
#        "all"     = every session for the slug — required for the SessionStart
#                    sweep, whose whole job is cleaning up what a PREVIOUS
#                    session leaked.
resolve_subagentsdirs() {
  local scope="${1:-current}" slug d newest newest_mt mt
  if [ -n "${HMD_AGENT_SUBAGENTS_DIR:-}" ]; then
    printf '%s\n' "$HMD_AGENT_SUBAGENTS_DIR"
    return 0
  fi
  slug="$(_slug_now)"
  [ -n "$slug" ] || return 0
  if [ "$scope" = "all" ]; then
    for d in "$PROJECTS_DIR/$slug"/*/subagents; do
      [ -d "$d" ] && printf '%s\n' "$d"
    done
    return 0
  fi
  newest=""; newest_mt=-1
  for d in "$PROJECTS_DIR/$slug"/*/subagents; do
    [ -d "$d" ] || continue
    mt="$(_mtime "$d")"
    if [ "$mt" -gt "$newest_mt" ] 2>/dev/null; then newest_mt="$mt"; newest="$d"; fi
  done
  [ -n "$newest" ] && printf '%s\n' "$newest"
  return 0
}

# ── transcript + metadata resolution ──────────────────────────────────────────
# The `.output` is normally a symlink straight to the transcript. If not, derive
# the canonical projects path. Returns "" when nothing resolves.
_transcript_for() {
  local taskdir="$1" id="$2" out tgt sess slug cand d
  out="$taskdir/$id.output"
  if [ -L "$out" ]; then
    tgt="$(readlink "$out" 2>/dev/null)"
    case "$tgt" in /*) printf '%s' "$tgt"; return 0 ;; esac
  fi
  sess="$(_session_of_taskdir "$taskdir")"
  slug="$(_slug_of_taskdir "$taskdir")"
  [ -n "$sess" ] && [ -n "$slug" ] || return 0
  cand="$PROJECTS_DIR/$slug/$sess/subagents/agent-$id.jsonl"
  if [ ! -f "$cand" ]; then
    # The task dir's own session frequently does NOT own the transcript (measured
    # cross-session links). Sweep the slug's other sessions before giving up.
    for d in "$PROJECTS_DIR/$slug"/*/subagents/"agent-$id.jsonl"; do
      [ -f "$d" ] && { printf '%s' "$d"; return 0; }
    done
  fi
  printf '%s' "$cand"
}

# Session that OWNS a transcript: <projects>/<slug>/<session>/subagents/agent-x.jsonl
_session_of_transcript() {
  local d="${1%/*}"          # strip /agent-x.jsonl  -> .../<session>/subagents
  d="${d%/subagents}"        # -> .../<session>
  case "$d" in */*) printf '%s' "${d##*/}" ;; esac
}

# TRUE when the agent is AWAITING A TOOL RESULT ⇒ genuinely alive regardless of
# mtime. A cheap substring prefilter on the last line skips a jq spawn for the
# overwhelming majority of transcripts, keeping `count` fast for the statusline.
_awaiting_tool_result() {
  local f="$1" line
  [ -n "$f" ] && [ -f "$f" ] || return 1
  line="$(tail -n 1 "$f" 2>/dev/null)"
  case "$line" in *'"type":"tool_use"'*) ;; *) return 1 ;; esac
  [ "$(printf '%s' "$line" | jq -r '
      (.message.content? // null) as $c
      | if ($c|type) == "array" and ([ $c[] | select(.type? == "tool_use") ] | length) > 0
        then "tool_use" else "" end' 2>/dev/null | head -n 1)" = "tool_use" ]
}

# ── the notification index: AUTHORITATIVE completion evidence ────────────────
# Scans the given parent session transcripts for <task-notification> blocks and
# builds a " id:status id:status " lookup string, LAST notification winning (an
# agent may stop, be resumed, and stop again). Parsed straight off the raw JSONL
# with grep+perl — no jq — because these transcripts reach 16MB and this runs on
# the statusline path. Built at most once per invocation.
_NOTIF_IDX=""
_NOTIF_LOADED=""
build_notif_index() {
  local files="$1" f existing=""
  _NOTIF_LOADED=1
  for f in $files; do
    [ -f "$f" ] && existing="$existing $f"
  done
  [ -n "$existing" ] || { _NOTIF_IDX=" "; return 0; }
  # shellcheck disable=SC2086
  _NOTIF_IDX="$(grep -hF '<task-notification>' $existing 2>/dev/null \
    | perl -ne 'while(m{<task-id>([^<]+)</task-id>.*?<status>([^<]+)</status>}g){print "$1\t$2\n"}' 2>/dev/null \
    | awk -F'\t' 'NF==2{last[$1]=$2} END{printf " "; for(k in last) printf "%s:%s ", k, last[k]}')"
  [ -n "$_NOTIF_IDX" ] || _NOTIF_IDX=" "
}

# Terminal status for one task id, or "" when the harness never notified.
_notif_status() {
  local id="$1"
  [ -n "$_NOTIF_LOADED" ] || return 0
  case "$_NOTIF_IDX" in
    *" $id:completed "*) printf 'completed' ;;
    *" $id:failed "*)    printf 'failed'    ;;
    *" $id:killed "*)    printf 'killed'    ;;
  esac
}

# ── terminal marker: a sibling <id>.status (fixtures / future harness use) ─────
_terminal_state() {
  local sfile="$1" s=""
  [ -f "$sfile" ] || return 0
  s="$(tr '[:upper:]' '[:lower:]' < "$sfile" 2>/dev/null)"
  case "$s" in
    *fail*|*error*)    printf 'failed' ;;
    *done*|*complete*) printf 'done'   ;;
  esac
}

# ── core enumeration ──────────────────────────────────────────────────────────
# Emits `id<TAB>age<TAB>state<TAB>name` per subagent, sorted by id. Shared by
# list/count/reap/sweep so classification lives in exactly ONE place.
# Candidate rows: `id<TAB>transcript` for the UNION of both sources, deduped.
# Source 1 is the task dir. Source 2 is the subagents dir, restricted to parked
# mailbox teammates — the class that never gets an `.output` entry. A `grep -l`
# over the sidecars narrows 157 files to the handful that matter in one process.
_collect_candidates() {
  local taskdir="$1" subdirs="$2" f d m id tr meta seen=" "
  if [ -n "$taskdir" ] && [ -d "$taskdir" ]; then
    for f in "$taskdir"/*.output; do
      [ -e "$f" ] || continue
      id="${f##*/}"; id="${id%.output}"
      tr="$(_transcript_for "$taskdir" "$id")"
      meta=""
      [ -n "$tr" ] && [ -f "${tr%.jsonl}.meta.json" ] && meta="${tr%.jsonl}.meta.json"
      # NOT AN AGENT: a background Bash task. The harness writes those into the
      # very same dir with a b+8/9 id and no agent metadata at all.
      if [ -z "$meta" ] && { [ -z "$tr" ] || [ ! -f "$tr" ]; }; then
        case "$id" in
          b[0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z]|\
          b[0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z])
            continue ;;
        esac
      fi
      case "$seen" in *" $id "*) continue ;; esac
      seen="$seen$id "
      printf '%s\t%s\n' "$id" "$tr"
    done
  fi
  for d in $subdirs; do
    [ -d "$d" ] || continue
    for m in $(grep -lF 'in_process_teammate' "$d"/*.meta.json 2>/dev/null); do
      id="${m##*/}"; id="${id%.meta.json}"; id="${id#agent-}"
      [ -n "$id" ] || continue
      case "$seen" in *" $id "*) continue ;; esac
      seen="$seen$id "
      printf '%s\t%s\n' "$id" "${m%.meta.json}.jsonl"
    done
  done
}

enumerate() {
  local taskdir subdirs reaped cands sessions tsess slug
  local id tr meta mt age term state name kind nstat sess row
  taskdir="$(resolve_taskdir)"
  subdirs="$(resolve_subagentsdirs current)"
  cands="$(_collect_candidates "$taskdir" "$subdirs")"
  [ -n "$cands" ] || return 0          # fail-closed: no agents

  reaped="$(load_reaped)"
  if [ -n "$taskdir" ]; then
    slug="$(_slug_of_taskdir "$taskdir")"
    tsess="$(_session_of_taskdir "$taskdir")"
  else
    slug="$(_slug_now)"; tsess=""
  fi

  # Every session that could hold a task-notification for these agents: the task
  # dir's own session plus the session that actually owns each transcript (they
  # differ in practice).
  sessions=" "
  [ -n "$tsess" ] && sessions=" $tsess "
  while IFS=$'\t' read -r id tr; do
    [ -n "$tr" ] || continue
    sess="$(_session_of_transcript "$tr")"
    [ -n "$sess" ] || continue
    case "$sessions" in *" $sess "*) ;; *) sessions="$sessions$sess " ;; esac
  done <<< "$cands"
  local notif_files="" s
  for s in $sessions; do
    notif_files="$notif_files $(_session_transcript "$slug" "$s")"
  done
  build_notif_index "$notif_files"

  while IFS=$'\t' read -r id tr; do
    [ -n "$id" ] || continue
    mt=0
    if [ -n "$tr" ] && [ -e "$tr" ]; then mt="$(_mtime "$tr")"
    elif [ -n "$taskdir" ] && [ -e "$taskdir/$id.output" ]; then mt="$(_mtime "$taskdir/$id.output")"
    fi
    age=$(( NOW - mt ))
    [ "$age" -lt 0 ] && age=0

    meta=""; name=""; kind=""
    if [ -n "$tr" ] && [ -f "${tr%.jsonl}.meta.json" ]; then
      meta="${tr%.jsonl}.meta.json"
      name="$(jq -r '.name // ""' "$meta" 2>/dev/null)"
      kind="$(jq -r '.taskKind // ""' "$meta" 2>/dev/null)"
    fi
    [ -n "$name" ] || name="-"
    sess="$(_session_of_transcript "$tr")"
    [ -n "$sess" ] || sess="$tsess"

    state=""
    case "$reaped" in *" $id "*) state="reaped" ;; esac

    # THE GUARD, FIRST: an agent awaiting a tool result is alive regardless of
    # age, of a dead session, or of any earlier notification (it may have been
    # resumed). This is what makes a 40-minute build safe from the reaper.
    if [ -z "$state" ] && _awaiting_tool_result "$tr"; then
      if [ "$age" -ge "$HUNG_SECS" ]; then state="hung"; else state="working"; fi
    fi

    # AUTHORITATIVE COMPLETION EVIDENCE, SECOND. A notified result outranks every
    # negative state below — most importantly `orphaned`. An agent that finished
    # and returned its report is a success, not a corpse, and stays a success
    # even after its session is gone.
    if [ -z "$state" ]; then
      nstat="$(_notif_status "$id")"
      case "$nstat" in
        completed) state="done"   ;;
        failed)    state="failed" ;;
        killed)    state="killed" ;;
      esac
    fi

    if [ -z "$state" ]; then
      term=""
      [ -n "$taskdir" ] && term="$(_terminal_state "$taskdir/$id.status")"
      if [ -n "$term" ]; then
        state="$term"
      elif [ "$age" -ge "$STALE_SECS" ] && ! session_is_alive "$slug" "$sess"; then
        # No completion evidence AND the owning session is gone ⇒ provably dead.
        state="orphaned"
      elif [ "$kind" = "in_process_teammate" ]; then
        state="mailbox"
      elif [ "$age" -ge "$STALE_SECS" ]; then
        state="stale"
      else
        state="live"
      fi
    fi
    printf '%s\t%s\t%s\t%s\n' "$id" "$age" "$state" "$name"
  done <<< "$cands" | sort
}

# ── subcommands ───────────────────────────────────────────────────────────────
cmd_list() {
  local as_json="" rows
  [ "${1:-}" = "--json" ] && as_json=1
  rows="$(enumerate)"
  if [ -n "$as_json" ]; then
    if [ -z "$rows" ]; then echo '[]'; return 0; fi
    printf '%s\n' "$rows" | jq -R -s '
      split("\n") | map(select(length>0) | split("\t"))
      | map({id: .[0], age_secs: (.[1]|tonumber), state: .[2], name: .[3]})'
    return 0
  fi
  if [ -z "$rows" ]; then
    echo "no tracked subagents"
    return 0
  fi
  # Width 42: named teammates carry their name in the id (atermprobe-<16 hex>),
  # so a 22-column field ragged-wrapped every agent this tool most needs to show.
  printf '%-42s %8s  %-9s %s\n' "SUBAGENT" "AGE(s)" "STATE" "NAME"
  printf '%s\n' "$rows" | while IFS=$'\t' read -r id age state name; do
    printf '%-42s %8s  %-9s %s\n' "$id" "$age" "$state" "$name"
  done
}

cmd_count() {
  # LIVE only — the statusline's authoritative count. `working` counts as live
  # (it is genuinely running); stale/hung/terminal/orphaned/mailbox/reaped do not.
  local n
  n="$(enumerate | awk -F'\t' '$3=="live" || $3=="working"' | wc -l | tr -d ' ')"
  printf '%s\n' "${n:-0}"
}

# ── orphans: the operator-facing view of what needs attention ────────────────
# Everything that is NOT live, NOT working and NOT a returned result: parked
# mailbox teammates (clearable only from inside the harness), provably-dead
# orphans, wedged and stale agents. This is the class the tool exists to surface,
# so it gets its own subcommand rather than making an operator eyeball a `list`.
_orphan_rows() {
  enumerate | awk -F'\t' '$3=="mailbox" || $3=="orphaned" || $3=="hung" || $3=="stale"'
}

cmd_orphans() {
  local as_json="" rows
  [ "${1:-}" = "--json" ] && as_json=1
  rows="$(_orphan_rows)"
  if [ -n "$as_json" ]; then
    if [ -z "$rows" ]; then echo '[]'; return 0; fi
    printf '%s\n' "$rows" | jq -R -s '
      split("\n") | map(select(length>0) | split("\t"))
      | map({id: .[0], age_secs: (.[1]|tonumber), state: .[2], name: .[3]})'
    return 0
  fi
  if [ -z "$rows" ]; then
    echo "no orphaned, parked or wedged subagents"
    return 0
  fi
  printf '%-42s %8s  %-9s %s\n' "SUBAGENT" "AGE(s)" "STATE" "NAME"
  printf '%s\n' "$rows" | while IFS=$'\t' read -r id age state name; do
    printf '%-42s %8s  %-9s %s\n' "$id" "$age" "$state" "$name"
  done
  if printf '%s\n' "$rows" | awk -F'\t' '$3=="mailbox"{f=1} END{exit !f}'; then
    echo
    echo "  mailbox = parked in-process teammate: no PID to signal, no control file."
    echo "  CLEAR FROM INSIDE THE HARNESS — this tool cannot: TaskStop <id|name>,"
    echo "  or /tasks → select → Ctrl+X, or restart the owning session."
  fi
}

# Record one id in heimdall's own registry. jq is the single writer.
_record_reap() {
  local id="$1" reason="$2" now="$3" tmp
  tmp="$(mktemp "${REAPED_FILE}.XXXXXX" 2>/dev/null)" || return 1
  if jq --arg id "$id" --arg at "$now" --arg r "$reason" \
        '. + {($id): {reaped_at:$at, reason:$r}}' \
        "$REAPED_FILE" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$REAPED_FILE" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 1; }
    return 0
  fi
  rm -f "$tmp" 2>/dev/null
  return 1
}

# Shared by reap + sweep. Echoes "id<TAB>reason<TAB>name" for each NEW record.
_do_reap() {
  local rows id age state name reason now added=""
  rows="$(enumerate)"
  mkdir -p "$(dirname "$REAPED_FILE")" 2>/dev/null || true
  [ -f "$REAPED_FILE" ] || printf '{}\n' > "$REAPED_FILE" 2>/dev/null || true
  now="$(now_iso)"
  [ -n "$rows" ] || return 0
  while IFS=$'\t' read -r id age state name; do
    case "$state" in
      stale)    reason="stale" ;;
      failed)   reason="failed" ;;
      done)     reason="done" ;;
      killed)   reason="killed" ;;
      hung)     reason="hung" ;;
      orphaned) reason="orphaned" ;;
      mailbox)  reason="mailbox-parked" ;;
      # live, working and already-reaped are NEVER recorded. This is the guard.
      *)        continue ;;
    esac
    if _record_reap "$id" "$reason" "$now"; then
      added="$added$id	$reason	$name"$'\n'
    fi
  done <<< "$rows"
  printf '%s' "$added"
}

cmd_reap() {
  local as_json="" added
  [ "${1:-}" = "--json" ] && as_json=1
  added="$(_do_reap)"
  if [ -n "$as_json" ]; then
    if [ -z "$added" ]; then echo '[]'; return 0; fi
    printf '%s' "$added" | jq -R -s '
      split("\n") | map(select(length>0) | split("\t"))
      | map({task_id: .[0], reason: .[1], name: .[2]})'
    return 0
  fi
  if [ -z "$added" ]; then
    echo "reap: nothing to reap (idempotent no-op)"
    return 0
  fi
  printf '%s' "$added" | while IFS=$'\t' read -r id reason name; do
    [ -n "$id" ] || continue
    printf 'reaped %s (%s)%s\n' "$id" "$reason" \
      "$([ "$name" != "-" ] && [ -n "$name" ] && printf ' name=%s' "$name")"
  done
}

# ── sweep: the automation entry point ─────────────────────────────────────────
# Reaps everything reapable, then reports honestly. The distinction it draws is
# the whole point: `orphaned` agents are GONE (we proved the session died);
# `mailbox` agents are still resident in a live session and NOTHING outside the
# harness can clear them — so we name them and name every action that does clear
# them, flagging which of those is documented-but-not-yet-verified.
cmd_sweep() {
  local as_json="" added rows parked_now parked_all n_reap n_parked
  [ "${1:-}" = "--json" ] && as_json=1

  if [ "${HMD_AGENT_NO_SWEEP:-}" = "1" ]; then
    [ -n "$as_json" ] && { echo '{"skipped":"HMD_AGENT_NO_SWEEP=1"}'; return 0; }
    echo "sweep: disabled via HMD_AGENT_NO_SWEEP=1"
    return 0
  fi

  added="$(_do_reap)"
  rows="$(enumerate)"

  # Parked teammates recorded THIS run, plus any still present from earlier runs.
  parked_now="$(printf '%s' "$added" | awk -F'\t' '$2=="mailbox-parked"{print $1"\t"$3}')"
  parked_all="$parked_now"
  if [ -f "$REAPED_FILE" ]; then
    local prev
    prev="$(jq -r 'to_entries[] | select(.value.reason=="mailbox-parked") | .key' \
            "$REAPED_FILE" 2>/dev/null)"
    if [ -n "$prev" ]; then
      parked_all="$(printf '%s\n%s\n' "$parked_now" \
                    "$(printf '%s\n' "$prev" | awk 'NF{print $0"\t-"}')" \
                    | awk -F'\t' 'NF && !seen[$1]++')"
    fi
  fi

  n_reap="$(printf '%s' "$added" | grep -c . 2>/dev/null || echo 0)"
  n_parked="$(printf '%s' "$parked_all" | grep -c . 2>/dev/null || echo 0)"

  # JSON CONTRACT — `clearable_by` is a LIST OF MECHANISM IDENTIFIERS, never a
  # sentence. A consumer must be able to branch (`index("TaskStop")`) instead of
  # parsing prose, and a list is the only shape that can carry more than one
  # mechanism — which is the whole correction: restart is no longer the only way.
  # Elements are the literal invocable name where one exists (the `TaskStop` tool,
  # the `/tasks` command) and a kebab token where none does (`session-restart`).
  # Ordered programmatic → interactive → blunt fallback, so element 0 is the one
  # an automated consumer should reach for.
  # `clearable_by_verified` is the SUBSET proven end to end on this machine.
  # TaskStop is documented (Claude Code 2.1.198+, this machine runs 2.1.220) but
  # unexercised — agent definitions load at session start — so it is deliberately
  # ABSENT from the verified list. Do not add it there without a run that proves
  # it; the test asserts its absence precisely so that upgrade must be conscious.
  if [ -n "$as_json" ]; then
    jq -n --arg reaped "$added" --arg parked "$parked_all" '
      ($parked | split("\n") | map(select(length>0))) as $p |
      {
        reaped: ($reaped | split("\n") | map(select(length>0) | split("\t"))
                 | map({task_id: .[0], reason: .[1], name: .[2]})),
        parked_mailbox: ($p | map(split("\t")) | map({task_id: .[0], name: .[1]})),
        clearable_by: (if ($p | length) > 0
                       then ["TaskStop", "/tasks", "session-restart"] else null end),
        clearable_by_verified: (if ($p | length) > 0
                       then ["session-restart"] else null end)
      }'
    return 0
  fi

  if [ "$n_reap" -eq 0 ] && [ "$n_parked" -eq 0 ]; then
    echo "sweep: clean — no stale, orphaned or parked subagents"
    return 0
  fi

  if [ -n "$added" ]; then
    printf '%s' "$added" | while IFS=$'\t' read -r id reason name; do
      [ -n "$id" ] || continue
      case "$reason" in
        orphaned) printf 'reaped   %s (%s — session process gone, provably dead)\n' "$id" "$reason" ;;
        mailbox-parked) : ;;   # reported in the loud block below
        *)        printf 'reaped   %s (%s)\n' "$id" "$reason" ;;
      esac
    done
  fi

  if [ "$n_parked" -gt 0 ]; then
    echo
    echo "  ⚠  $n_parked PARKED MAILBOX AGENT(S) — excluded from heimdall's count,"
    echo "     but STILL RESIDENT in the harness. They are in-process coroutines:"
    echo "     there is no PID to signal and no control file to write."
    printf '%s\n' "$parked_all" | while IFS=$'\t' read -r id name; do
      [ -n "$id" ] || continue
      if [ -n "$name" ] && [ "$name" != "-" ]; then
        printf '       • %s  (name: %s)\n' "$id" "$name"
      else
        printf '       • %s\n' "$id"
      fi
    done
    echo "     CLEAR THEM FROM INSIDE THE HARNESS — this tool cannot:"
    echo "       • TaskStop <agent-id|name>  (Claude Code 2.1.198+; documented,"
    echo "         not yet verified end to end — definitions load at session start)"
    echo "       • /tasks → select → Ctrl+X  (the same clear, by hand)"
    echo "       • restart the owning session (blunt fallback, always works)"
    echo "     Prevention: never pass name: to the Agent tool (see CLAUDE.md)."
  fi
}

# Print the comment header, stopping at the first non-comment line so the help
# text cannot drift out of sync with the file when the header changes length.
usage() { sed -n '2,${/^[^#]/q;p;}' "$0" | sed 's/^# \{0,1\}//'; }

main() {
  local sub="${1:-}"
  case "$sub" in
    list)    shift; cmd_list "$@" ;;
    count)   shift; cmd_count "$@" ;;
    orphans) shift; cmd_orphans "$@" ;;
    reap)    shift; cmd_reap "$@" ;;
    sweep)   shift; cmd_sweep "$@" ;;
    -h|--help|help|'') usage ;;
    *) echo "error: unknown subcommand: $sub" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
