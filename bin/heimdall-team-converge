#!/usr/bin/env python3
# heimdall-team-converge — CONVERGE-FORWARD migration: collapse a repo split onto ONE team_id.
#
# THE BUG THIS HEALS (TEAM-SPLIT-BUG.md / TEAM-FIX-PLAN.md §4). One repo could end up with
# MULTIPLE team_ids — a committed/legacy secret derives one, /team/auto derives another, an
# auto-solo mint invents a third — so same-repo teammates land in different presence partitions
# and cannot see each other. §1's resolver stops NEW splits; this tool heals the EXISTING ones:
# it groups every enrolled machine by its canonical repo (repo_slug), elects ONE canonical team
# per repo, and re-points every member's registry binding to it. Converge-FORWARD — it never
# hard-deletes a key/enrollment; a losing team_id simply loses its last member and ages out of
# presence via the read-time TTL. The move is auditable (a per-repo ledger) and idempotent.
#
# ⚠ TOUCHES DEPLOYED CP STATE. Against a real backend this re-stamps live registry bindings.
# The OWNER (RJ) runs it against prod (Wave 4), always `--dry-run` first. This tool builds +
# tests hermetically against a LOCAL temp backend only; it opens no network and mints no secret.
#
# THE GROUPING KEY IS THE DURABLE PRESENCE TREE (§4.1), NOT the key-registry `project` field.
# The presence-client bootstrap enroll sends no `project`, so most registry bindings have
# project=None — an unreliable grouping source. cp_presence instead writes one durable record per
# (project, team_id, haid) at presence/<project>/<team_id>/<haid>.json (the ~45s TTL is a
# READ-time freshness filter; the stored records PERSIST). We enumerate that tree exactly like
# cp_god.aggregate_roster (bin/lib/cp_god.py:82): list_names(presence) -> project ->
# list_names(presence/<project>) -> team_id -> list_names(.../<team_id>, ".json") -> haid.
#
# TWO SHAPE FACTS the naive pseudocode glosses (both verified against the shipped stores):
#   * The presence PROJECT dir is cp_presence._slug'd — `github.com/owner/name` is stored as the
#     single segment `github.com_owner_name` (every "/" and ":" collapses to "_"). repo_slug()
#     needs the "/"-separated form, so we recover it by trying repo_slug on the raw name first,
#     then on the "_"->"/" reversal, and take repo_slug's last-two-segments (host-agnostic).
#   * The presence RECORD filename is cp_presence._slug(haid), NOT the raw HAID — a HAID carries a
#     ":" (`haid:human.machine-hash4`) that slugs to "_". The registry is keyed by the RAW haid,
#     so we bridge with a slug(raw_haid) -> raw_haid map built from the registry. A slugged
#     presence haid with no registry counterpart is a HAID present in the tree but ABSENT from the
#     key registry — it cannot be re-pointed (bind_haid_to_team fail-closes on no pubkey,
#     cp_repoteam.py:340) — so it is recorded SKIPPED, never a crash.
#
# ELECTION + RE-POINT (§4.2). Per repo_slug: canonical = cp_repoteam.get_team_for_repo(slug) when
# the /team/auto repo->team binding exists, else the team_id with the EARLIEST enrolled_at across
# its members (grandfather a missing stamp to +inf; sorted tiebreak), then bind_repo_team (CAS,
# first-writer-wins) locks it. Every member re-points via cp_repoteam.bind_haid_to_team — the SAME
# accessor /team/auto uses (cp_autoteam.py:279): it re-registers through cp_auth.register_key,
# PRESERVING pubkey/owner/project/enrolled_at and swapping ONLY team_id. It NEVER hard-deletes a
# key/enrollment (the cp_auth registry-eviction path is never invoked) — losers only lose a member.
#
# FAIL-CLOSED ON CROSS-REPO-SHARED team_ids (the safety invariant). A single team_id can leave
# beats under MULTIPLE projects (a reused/default/maintainer team). The presence-tree grouping then
# lands that SAME team_id in MULTIPLE repo_slug groups — elected canonical in one, superseded in
# another. Because a HAID has exactly ONE registered_team (cp_auth), re-pointing a shared team's
# members toward one repo YANKS them out of the other repos that share it (order-dependent
# membership corruption). A two-pass detection computes every team_id present in >1 group; those
# CROSS-REPO teams are NEVER re-pointed and NEVER elected as an absorbing canonical — the group is
# SKIPPED and the team is reported under "CROSS-REPO TEAMS (skipped — manual review)" and recorded
# in migration/team-converge/_conflicts.json for human/repo-binding disambiguation. Only UNAMBIGUOUS
# groups (all split team_ids exclusive to that one repo) converge, exactly as before.
#
# stdlib-only (argparse/json/os/sys/time) + the SHIPPED cp_state / cp_auth / cp_repoteam /
# cp_presence substrate — no new dependency; honors HEIMDALL_HOME so a test pins a temp backend.

from __future__ import annotations

import argparse
import json
import os
import sys
import threading
import time

# Resolve bin/lib (the cp_* substrate) onto sys.path exactly as every other bin/ python tool.
_BIN = os.path.dirname(os.path.abspath(__file__))
_LIB = os.path.join(_BIN, "lib")
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

import cp_state      # the backend factory + firestore-safe list_names/get_record/put_record.
import cp_state_firestore  # the firestore coordinate env-var NAMES (root/database/project) — stdlib-safe import.
import cp_auth       # _load_keys (raw-haid registry) + registered_team_field (current binding).
import cp_repoteam   # repo_slug + get_team_for_repo + bind_repo_team (CAS) + bind_haid_to_team.
import cp_presence   # _PRESENCE_REL + _slug (the SAME slug the presence store keys records by).
import issue_queue   # heimdall_home() — the SAME local store-root resolution cp_state.LocalBackend uses.

_LEDGER_DIR = "migration/team-converge"
_LEDGER_VERSION = "1.0.0"
_RECORD_SUFFIX = ".json"

# The guard message a real EXECUTE against the LOCAL store prints before refusing (grep-anchored).
_LOCAL_EXECUTE_GUARD = (
    "REFUSING to EXECUTE against the LOCAL store — a real convergence would re-stamp the LOCAL "
    "control-plane, not prod Firestore. Prod convergence needs HEIMDALL_STATE_BACKEND=firestore; "
    "pass --allow-local ONLY when you deliberately mean the local store (e.g. hermetic tests)."
)


def _resolve_backend_name(backend=None):
    """The RESOLVED backend name, computed EXACTLY as cp_state.get_backend does (explicit arg,
    else HEIMDALL_STATE_BACKEND, else 'local'; stripped + lowercased). One source of truth so the
    banner names the store the run will actually hit."""
    return (backend if backend is not None
            else os.environ.get(cp_state.BACKEND_ENV) or cp_state.BACKEND_LOCAL).strip().lower()


def _backend_banner(home, backend=None):
    """Return (name, banner) for the RESOLVED state backend and its coordinates, read from the
    SAME env cp_state / cp_state_firestore resolve from — so the printed line is UNAMBIGUOUS about
    which store this run reads/writes. Builds NO live client (pure string build; safe to unit-test
    with HEIMDALL_STATE_BACKEND=firestore set and no network).

      firestore -> `backend: firestore  project=<...>  root=<...>  database=<...>`
                   project: HEIMDALL_FIRESTORE_PROJECT, else GOOGLE_CLOUD_PROJECT, else the
                   gcloud/ADC default the client resolves at connect time (named honestly);
                   root:    HEIMDALL_FIRESTORE_ROOT or the DEFAULT_ROOT ('heimdall_cp');
                   database:HEIMDALL_FIRESTORE_DATABASE or '(default)'.
      local     -> `backend: LOCAL  home=<resolved control-plane store root>`
                   resolved the SAME way LocalBackend does: (home or issue_queue.heimdall_home())
                   joined with cp_state.CONTROL_PLANE_DIR."""
    name = _resolve_backend_name(backend)
    if name == cp_state.BACKEND_FIRESTORE:
        project = (os.environ.get(cp_state_firestore.FIRESTORE_PROJECT_ENV)
                   or os.environ.get("GOOGLE_CLOUD_PROJECT")
                   or "(gcloud/ADC default)")
        root = (os.environ.get(cp_state_firestore.FIRESTORE_ROOT_ENV)
                or cp_state_firestore.DEFAULT_ROOT)
        database = os.environ.get(cp_state_firestore.FIRESTORE_DATABASE_ENV) or "(default)"
        return name, ("backend: firestore  project=%s  root=%s  database=%s"
                      % (project, root, database))
    if name == cp_state.BACKEND_LOCAL:
        base = home if home else issue_queue.heimdall_home()
        home_path = os.path.join(base, cp_state.CONTROL_PLANE_DIR)
        return name, "backend: LOCAL  home=%s" % home_path
    # An unknown backend: name it (get_backend will raise ValueError right after — fail closed).
    return name, "backend: %s (UNKNOWN — get_backend will refuse)" % name


# ── FIRESTORE PREFLIGHT (fail-fast + self-heal — the "no more silent hang" fix) ─────────────────
#
# THE INCIDENT THIS HEALS. A real prod convergence printed the firestore banner then FROZE FOREVER
# on the first query — no timeout, no diagnostic. TWO environment faults, neither surfaced: (1) ADC
# was missing, so google-auth could not authenticate; (2) the pyenv Python shipped a broken urllib3
# (2.6.x) whose RequestsDependencyWarning stalls google-auth's TOKEN REFRESH — an HTTP round-trip
# over the requests/urllib3 transport that the FirestoreBackend's gRPC query timeout (bug #17) does
# NOT bound. So the tool wedged inside token refresh with no wall clock. This preflight is modeled
# on go-live.sh STEP-0 (verify a REAL token, self-heal, fail LOUD before the real work): it runs
# ONLY for the firestore backend (the LOCAL path — and every hermetic test — skips it entirely) and
# ALWAYS after the banner, so the resolved store is on screen even on a fast failure.
_PROBE_TIMEOUT_ENV = "HEIMDALL_CONVERGE_PROBE_TIMEOUT_SECONDS"
# 30s sits ABOVE the FirestoreBackend gRPC query timeout (20s default, cp_state_firestore
# _QUERY_TIMEOUT_DEFAULT) so a legit slow-but-working query is never falsely aborted — only a TRUE
# unbounded stall (the token-refresh wedge) crosses this wall clock.
_PROBE_TIMEOUT_DEFAULT = 30.0

# The clean-venv escape hatch printed in every broken-transport / stall message (a from-scratch env
# with a compatible urllib3, run against the SAME firestore via HEIMDALL_STATE_BACKEND).
_VENV_FIX = ("python3 -m venv /tmp/hmdconv && /tmp/hmdconv/bin/pip install google-cloud-firestore "
             "&& HEIMDALL_STATE_BACKEND=firestore /tmp/hmdconv/bin/python bin/heimdall-team-converge")


def _probe_timeout():
    """The ADC-probe wall-clock timeout (seconds) — HEIMDALL_CONVERGE_PROBE_TIMEOUT_SECONDS, default
    30. A malformed / non-positive override falls back to the default so a misconfig can never
    DISABLE the anti-hang guard (the whole point of this preflight)."""
    raw = os.environ.get(_PROBE_TIMEOUT_ENV)
    try:
        val = float(raw) if raw not in (None, "") else _PROBE_TIMEOUT_DEFAULT
    except (TypeError, ValueError):
        return _PROBE_TIMEOUT_DEFAULT
    return val if val > 0 else _PROBE_TIMEOUT_DEFAULT


def _urllib3_version():
    """This interpreter's urllib3 version string, or None when urllib3 is absent — named in the
    stall diagnostic so an operator sees the exact broken version they are running."""
    try:
        import urllib3
        return getattr(urllib3, "__version__", None)
    except Exception:  # noqa: BLE001 — absent/unimportable urllib3: nothing to name.
        return None


def _google_auth_available():
    """True when google-auth is importable (the firestore dep is installed). Its OWN function so a
    hermetic test can force the ADC-probe path without a live google-auth install, and so a missing
    dep is deferred to get_backend's honest BackendUnavailable (which names exactly what to pip)."""
    try:
        import google.auth  # noqa: F401
        return True
    except Exception:  # noqa: BLE001 — dep absent.
        return False


def _detect_broken_transport():
    """Return (urllib3_version, requests_version) when THIS interpreter's requests<->urllib3 pairing
    is the incompatible combo that emits requests' RequestsDependencyWarning (the exact condition
    that stalled google-auth's token refresh in the field), else None. Detection re-runs requests'
    OWN import-time compatibility gate under a warnings recorder — faithful across requests versions
    (no hardcoded version matrix) — and treats any RequestsDependencyWarning as the signature. The
    recorder suppresses the stray stderr warning the import would otherwise emit."""
    import warnings
    import importlib
    try:
        import urllib3  # noqa: F401
    except Exception:  # noqa: BLE001 — no urllib3: nothing to mismatch.
        return None
    with warnings.catch_warnings(record=True) as caught:
        warnings.simplefilter("always")
        mod = sys.modules.get("requests")
        try:
            if mod is None:
                mod = importlib.import_module("requests")   # fresh import re-runs the compat gate.
            else:
                importlib.reload(mod)                        # already-imported: reload to re-run it.
        except Exception:  # noqa: BLE001 — requests absent/unimportable: cannot classify → no signal.
            return None
        for w in caught:
            if ("RequestsDependencyWarning" in type(w.message).__name__
                    or "doesn't match a supported version" in str(w.message)):
                return (getattr(sys.modules.get("urllib3"), "__version__", "?"),
                        getattr(mod, "__version__", "?"))
    return None


def _run_in_watchdog(fn, timeout):
    """Run fn() in a daemon thread and join for at most `timeout` seconds. Returns
    ("ok", result) | ("error", exc) | ("timeout", None). A stalled fn leaves its daemon thread
    wedged in the blocking call — harmless: a daemon thread dies with the process, and the ONLY
    caller ABORTS (nonzero exit) on "timeout", so the process exits promptly instead of hanging."""
    box = {}

    def _run():
        try:
            box["result"] = fn()
            box["status"] = "ok"
        except BaseException as exc:  # noqa: BLE001 — capture ANY failure for the caller to classify.
            box["exc"] = exc
            box["status"] = "error"

    t = threading.Thread(target=_run, name="hmd-converge-fs-probe", daemon=True)
    t.start()
    t.join(timeout)
    if t.is_alive():
        return ("timeout", None)
    if box.get("status") == "ok":
        return ("ok", box.get("result"))
    return ("error", box.get("exc"))


def _is_missing_adc(exc):
    """True when `exc` is google-auth's DefaultCredentialsError (ADC not configured), matched by
    isinstance when google.auth is importable AND by type-name/message as a fallback so the
    classification (and its hermetic test) needs no live google-auth import."""
    try:
        from google.auth.exceptions import DefaultCredentialsError as _dce
    except Exception:  # noqa: BLE001 — google-auth absent: fall back to a name/message probe.
        _dce = None
    if _dce is not None and isinstance(exc, _dce):
        return True
    if type(exc).__name__ == "DefaultCredentialsError":
        return True
    msg = str(exc).lower()
    return "default credentials" in msg or "could not automatically determine credentials" in msg


def _probe_adc(timeout):
    """Resolve Application Default Credentials AND mint a token under a hard wall-clock `timeout`,
    returning a (status, payload):
      ("ok", token)   — ADC resolved and a token minted (the store is authenticable/reachable).
      ("no_adc", exc) — ADC is not configured (DefaultCredentialsError) — the operator must run
                        `gcloud auth application-default login`.
      ("stall", None) — the resolve/refresh HUNG past `timeout` — the broken-urllib3 signature
                        (google-auth's token refresh wedged in a broken requests/urllib3 transport).
      ("error", exc)  — any other auth/transport failure (surfaced; never a silent empty run).
    The refresh is the EXACT operation the real incident stalled on (google-auth mints the token
    over the requests/urllib3 transport), so this probe is a faithful, DATA-FREE reachability test:
    it needs no Firestore documents, only working auth + egress to oauth2.googleapis.com."""
    def _resolve_and_mint():
        import google.auth
        import google.auth.transport.requests as _gart
        creds, _proj = google.auth.default()
        creds.refresh(_gart.Request())
        return getattr(creds, "token", True)

    status, payload = _run_in_watchdog(_resolve_and_mint, timeout)
    if status == "timeout":
        return ("stall", None)
    if status == "error":
        return ("no_adc" if _is_missing_adc(payload) else "error", payload)
    return ("ok", payload)


def _preflight_firestore(home, *, out, err):
    """FIRESTORE-ONLY fail-fast preflight (never runs for the LOCAL backend): catch the broken
    environments that used to make a prod run HANG SILENTLY after the banner. Writes its findings
    to `err`; returns 0 to proceed, or a nonzero exit code to ABORT before any enumeration.

      1. ADC — Application Default Credentials must resolve AND mint a token. Missing ADC -> the
         EXACT fix (gcloud auth application-default login + set-quota-project) and a nonzero exit.
      2. broken transport (WARN-only) — an incompatible requests/urllib3 pairing (the urllib3 2.6.x
         RequestsDependencyWarning that stalled google-auth in the field) is named up front with two
         fixes, but the run CONTINUES (it MIGHT still work; the timeout below is the hard backstop).
      3. connection timeout (the core fix) — the ADC token mint (the exact op the incident stalled
         on) runs under a hard wall-clock timeout; a stall ABORTS with the urllib3 diagnostic instead
         of hanging forever."""
    project = (os.environ.get(cp_state_firestore.FIRESTORE_PROJECT_ENV)
               or os.environ.get("GOOGLE_CLOUD_PROJECT")
               or "<your-firestore-project>")

    # 2. broken-transport WARNING (non-fatal) — surfaced BEFORE the probe so the likely cause is on
    #    screen even if the probe then succeeds slowly.
    broken = _detect_broken_transport()
    if broken:
        u3, rq = broken
        err.write("=" * 72 + "\n")
        err.write("WARNING: this Python env has an INCOMPATIBLE requests/urllib3 pairing "
                  "(urllib3 %s, requests %s) — emits\n" % (u3, rq))
        err.write("         RequestsDependencyWarning and can STALL google-auth's token refresh "
                  "(the exact failure that\n")
        err.write("         hung a prod convergence). Two fixes:\n")
        err.write("           (a) run in a clean venv:\n")
        err.write("               %s\n" % _VENV_FIX)
        err.write("           (b) pin a compatible urllib3:  pip install 'urllib3<2'\n")
        err.write("         Continuing — it MIGHT still work; the connection timeout below is the "
                  "hard backstop.\n")
        err.write("=" * 72 + "\n")

    # google-auth present? If not, the firestore dep is not installed — get_backend's first touch
    # raises a clear BackendUnavailable naming exactly what to install. Let THAT honest boundary
    # fire rather than half-diagnosing here.
    if not _google_auth_available():
        err.write("preflight: google-auth not importable — skipping ADC probe; the firestore "
                  "backend build will name the missing dependency.\n")
        return 0

    # 1 + 3. ADC resolve + token mint under a hard timeout (the core anti-hang guard).
    timeout = _probe_timeout()
    status, payload = _probe_adc(timeout)
    if status == "no_adc":
        err.write("=" * 72 + "\n")
        err.write("FATAL: Application Default Credentials are NOT configured — the firestore backend "
                  "cannot authenticate.\n")
        err.write("       Fix (run BOTH, then re-run):\n")
        err.write("         gcloud auth application-default login\n")
        err.write("         gcloud auth application-default set-quota-project %s\n" % project)
        err.write("=" * 72 + "\n")
        return 3
    if status == "stall":
        u3 = _urllib3_version()
        err.write("=" * 72 + "\n")
        err.write("FATAL: Firestore auth/query STALLED after %.0fs%s — almost always a broken "
                  "urllib3 in this\n"
                  % (timeout, (" (saw urllib3 %s)" % u3) if u3 else ""))
        err.write("       Python env: google-auth's token refresh wedged in a broken "
                  "requests/urllib3 transport. Fix EITHER:\n")
        err.write("         (a) run in a clean venv:\n")
        err.write("             %s\n" % _VENV_FIX)
        err.write("         (b) pin a compatible urllib3:  pip install 'urllib3<2'\n")
        err.write("=" * 72 + "\n")
        return 4
    if status == "error":
        err.write("=" * 72 + "\n")
        err.write("FATAL: could not authenticate to Firestore (ADC token refresh failed): %s: %s\n"
                  % (type(payload).__name__, payload))
        err.write("       Verify ADC (gcloud auth application-default login), the quota project "
                  "(%s), and network\n" % project)
        err.write("       egress to oauth2.googleapis.com, then re-run.\n")
        err.write("=" * 72 + "\n")
        return 5
    err.write("preflight: ok — ADC resolved and a token minted (firestore reachable).\n")
    return 0


def _project_repo_slug(project_dirname):
    """Recover the canonical `owner/name` repo_slug from a PRESENCE PROJECT dir name, or None for a
    truly-local (non-resolvable) project — the "leave it alone" signal.

    The presence tree stores the project cp_presence._slug'd, so `github.com/owner/name` arrives as
    the single segment `github.com_owner_name`. repo_slug() (host-agnostic, last-two-segments) needs
    the "/"-separated form. Try the raw name first (in case an un-slugged project was ever stored),
    then the "_"->"/" reversal. A bare local dir name (`code`, `mytool`) has one segment -> repo_slug
    returns None on both -> the caller SKIPS it (truly-local: never re-pointed)."""
    slug = cp_repoteam.repo_slug(project_dirname)
    if slug:
        return slug
    return cp_repoteam.repo_slug(project_dirname.replace("_", "/"))


def _enrolled_at(entry):
    """The numeric enrolled_at stamp on a registry entry, or +inf when absent/non-numeric — a
    legacy binding with no stamp is grandfathered to the LATEST possible time so it never wins the
    earliest-created election over a stamped member."""
    if isinstance(entry, dict):
        v = entry.get("enrolled_at")
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            return float(v)
    return float("inf")


def _elect_earliest(team_ids, team_members, reg_keys):
    """Elect the canonical team_id when no /team/auto binding exists: the team_id with the EARLIEST
    enrolled_at across its members (min over members; a team with no registry-present member scores
    +inf). Deterministic — team_ids are scanned sorted, so an exact-tie resolves to the smallest id."""
    best_tid = None
    best_at = None
    for tid in sorted(team_ids):
        members = team_members.get(tid) or set()
        ats = [_enrolled_at(reg_keys.get(h)) for h in members]
        tmin = min(ats) if ats else float("inf")
        if best_at is None or tmin < best_at:
            best_at, best_tid = tmin, tid
    return best_tid


def _scan(backend, home):
    """Enumerate the durable presence tree and group every enrolled machine by its canonical
    repo_slug. Returns a dict: slug -> {team_ids:set, haids:set(raw), team_members:{tid:set(raw)},
    skipped:set(slugged-haid-with-no-registry)}. Truly-local (repo_slug None) projects are dropped.

    The registry supplies the slug(raw_haid) -> raw_haid bridge: a presence record filename is the
    SLUGGED haid, but the registry (and every re-point accessor) is keyed by the RAW haid. A slugged
    presence haid with no registry counterpart is tracked as skipped (registry-missing)."""
    reg_keys = cp_auth._load_keys(home)["keys"]
    slug_to_raw = {}
    for raw in reg_keys:
        slug_to_raw[cp_presence._slug(raw)] = raw

    groups = {}
    for project in backend.list_names(cp_presence._PRESENCE_REL):
        slug = _project_repo_slug(project)
        if not slug:
            continue  # truly-local tree — LEAVE ALONE (no owner/name to converge).
        proj_rel = os.path.join(cp_presence._PRESENCE_REL, project)
        g = groups.setdefault(
            slug, {"team_ids": set(), "haids": set(), "team_members": {}, "skipped": set()})
        for team_id in backend.list_names(proj_rel):
            team_rel = os.path.join(proj_rel, team_id)
            for rec in backend.list_names(team_rel, suffix=_RECORD_SUFFIX):
                shaid = rec[: -len(_RECORD_SUFFIX)]
                g["team_ids"].add(team_id)
                raw = slug_to_raw.get(shaid)
                if raw is None:
                    g["skipped"].add(shaid)  # in the tree, absent from the registry — cannot re-point.
                    continue
                g["haids"].add(raw)
                g["team_members"].setdefault(team_id, set()).add(raw)
    return groups, reg_keys


def converge(*, home=None, dry_run=False, allow_local=False, out=sys.stdout, err=sys.stderr):
    """The migration. Scan -> per-slug elect canonical -> re-point every member -> ledger. In
    --dry-run every write is suppressed (no bind_repo_team, no bind_haid_to_team, no ledger) and
    only the plan is printed. Returns an exit code (0 = converged/planned, no crash on any skip;
    nonzero = refused a real EXECUTE against the LOCAL store without --allow-local).

    BACKEND TRANSPARENCY (never a silent wrong-store run). Before enumerating, the RESOLVED backend
    + its coordinates are printed to stderr, read from the SAME env cp_state resolves from — so a
    run can never quietly read the empty LOCAL store while looking like a clean prod pass. On LOCAL
    a loud warning fires; a real EXECUTE against LOCAL is REFUSED unless --allow-local is explicit
    (--dry-run is read-only and always allowed)."""
    name, banner = _backend_banner(home)
    err.write(banner + "\n")

    is_local = (name == cp_state.BACKEND_LOCAL)
    if is_local:
        err.write("=" * 72 + "\n")
        err.write("WARNING: this is the LOCAL control-plane store, NOT prod Firestore.\n")
        err.write("         Prod convergence needs HEIMDALL_STATE_BACKEND=firestore (a 0-group "
                  "result here is an EMPTY local store, not an already-converged prod).\n")
        err.write("=" * 72 + "\n")
        if not dry_run and not allow_local:
            err.write(_LOCAL_EXECUTE_GUARD + "\n")
            return 2

    # FIRESTORE fail-fast preflight (never for LOCAL — the hermetic tests skip it entirely): ADC +
    # broken-urllib3 checks + a hard-timeout token probe, so a broken env fails LOUD in seconds
    # instead of hanging forever on the first enumeration. Runs for BOTH dry-run and execute (a
    # dry-run still READS firestore, so it can stall too). A nonzero return ABORTS before any query.
    if name == cp_state.BACKEND_FIRESTORE:
        rc = _preflight_firestore(home, out=out, err=err)
        if rc != 0:
            return rc

    backend = cp_state.get_backend(home=home)
    groups, reg_keys = _scan(backend, home)

    # ── PASS 2: CROSS-REPO-SHARED team detection (the fail-closed guard) ─────────────────────────
    # A single team_id can leave presence beats under MULTIPLE projects — a reused/default/maintainer
    # team whose members worked across several repos. The presence-tree grouping then lands that SAME
    # team_id in MULTIPLE repo_slug groups (elected canonical in one, superseded in another). Because
    # a HAID has exactly ONE registered_team (cp_auth), re-pointing such a shared team's members
    # toward one repo YANKS them out of the OTHER repos that share it — order-dependent membership
    # corruption. So: any team_id present in MORE THAN ONE group's presence tree is AMBIGUOUS — its
    # home repo cannot be inferred — and must NEVER be re-pointed nor elected as an absorbing
    # canonical. cross_repo maps such a team_id -> the sorted repo_slugs it spans.
    _tid_to_slugs = {}
    for slug, g in groups.items():
        for tid in g["team_ids"]:
            _tid_to_slugs.setdefault(tid, set()).add(slug)
    cross_repo = {tid: sorted(slugs) for tid, slugs in _tid_to_slugs.items() if len(slugs) > 1}

    mode = "DRY-RUN (zero writes)" if dry_run else "EXECUTE"
    out.write("heimdall-team-converge [%s] — %d repo_slug group(s)\n" % (mode, len(groups)))
    if not groups and is_local:
        out.write("hint: 0 groups is EXPECTED for an empty LOCAL store — prod convergence needs "
                  "HEIMDALL_STATE_BACKEND=firestore (this run did NOT read prod Firestore).\n")

    total_repointed = 0
    skipped_groups = []
    for slug in sorted(groups):
        g = groups[slug]

        # The cross-repo team_ids present in THIS group + the registry-present HAIDs that belong to
        # them — those HAIDs are PROTECTED: never re-pointed (they live in the shared team that also
        # serves other repos), so a converge here cannot yank them out of those repos.
        cross_in_group = sorted(tid for tid in g["team_ids"] if tid in cross_repo)
        protected = set()
        for tid in cross_in_group:
            protected |= g["team_members"].get(tid, set())

        # 1. ELECT canonical — the /team/auto binding if present, else earliest-enrolled_at. READ
        #    ONLY here: do NOT bind yet, so a group that elects a cross-repo team writes NOTHING.
        canonical = cp_repoteam.get_team_for_repo(slug, home=home)
        elected_locally = not canonical
        if elected_locally:
            canonical = _elect_earliest(g["team_ids"], g["team_members"], reg_keys)
        if not canonical:
            out.write("  %s -> (no electable team; %d skipped) — LEFT ALONE\n"
                      % (slug, len(g["skipped"])))
            continue

        # FAIL-CLOSED: a cross-repo-shared team must NEVER be elected canonical — absorbing others
        # into it would pull the OTHER repos' members in. Skip the whole group for manual review and
        # write NOTHING (no bind_repo_team, no re-point, no ledger). Its conflict is reported below.
        if canonical in cross_repo:
            out.write("  %s -> SKIPPED (elected canonical %s spans %d repos: %s — manual review)\n"
                      % (slug, canonical, len(cross_repo[canonical]), cross_repo[canonical]))
            skipped_groups.append(slug)
            continue

        # Lock the election only now that canonical is confirmed repo-exclusive.
        if elected_locally and not dry_run:
            # CAS first-writer-wins: if a concurrent/prior bind exists we converge on IT.
            canonical = cp_repoteam.bind_repo_team(slug, canonical, home=home)
            # A concurrent bind could have landed a cross-repo team — re-check and fail closed
            # BEFORE any member is moved (no re-point has happened yet).
            if canonical in cross_repo:
                out.write("  %s -> SKIPPED (CAS resolved to cross-repo %s: %s — manual review)\n"
                          % (slug, canonical, cross_repo[canonical]))
                skipped_groups.append(slug)
                continue

        # 2. RE-POINT every registry-present member to canonical (idempotent skip when already there),
        #    EXCEPT protected members of a cross-repo-shared team — those are never touched.
        repointed = []
        for haid in sorted(g["haids"]):
            if haid in protected:
                continue  # member of a cross-repo-shared team — fail-closed, never re-point.
            if cp_auth.registered_team_field(haid, home=home) == canonical:
                continue
            if not dry_run:
                if not cp_repoteam.bind_haid_to_team(haid, canonical, home=home):
                    # fail-closed (no registered pubkey) — record skipped, never crash.
                    g["skipped"].add(haid)
                    continue
            repointed.append(haid)
        total_repointed += len(repointed)

        # superseded = the group's OTHER team_ids that were absorbed — canonical AND every cross-repo
        # team excluded (a shared team is never "superseded away"; it stays put for manual review).
        superseded = sorted(g["team_ids"] - {canonical} - set(cross_repo))

        # 3. RECORD the superseded ledger — only when this run actually MOVED members, so a
        #    re-run over an already-converged repo writes NOTHING (true idempotent no-op).
        if repointed and not dry_run:
            backend.put_record(
                os.path.join(_LEDGER_DIR, "%s%s" % (cp_repoteam._key(slug), _RECORD_SUFFIX)),
                {"version": _LEDGER_VERSION,
                 "repo_slug": slug,
                 "canonical_team_id": canonical,
                 "superseded_team_ids": superseded,
                 "cross_repo_excluded": cross_in_group,
                 "haids_repointed": sorted(repointed),
                 "ts": int(time.time())})

        skipped_note = (", skipped=%d" % len(g["skipped"])) if g["skipped"] else ""
        cross_note = (", cross_repo_excluded=%s" % cross_in_group) if cross_in_group else ""
        out.write("  %s -> %s  (+%d repointed, superseded=%s%s%s)\n"
                  % (slug, canonical, len(repointed), superseded, cross_note, skipped_note))

    # ── REPORT cross-repo-shared teams (skipped — manual review) + persist the conflicts ledger ──
    # These need human/repo-binding disambiguation, not an automated guess. The ledger is written
    # deterministically (sorted, no wall-clock ts) so a re-run is byte-idempotent.
    if cross_repo:
        out.write("\nCROSS-REPO TEAMS (skipped — manual review):\n")
        for tid in sorted(cross_repo):
            out.write("  %s spans %d repos: %s\n" % (tid, len(cross_repo[tid]), cross_repo[tid]))
        if not dry_run:
            backend.put_record(
                os.path.join(_LEDGER_DIR, "_conflicts%s" % _RECORD_SUFFIX),
                {"version": _LEDGER_VERSION,
                 "conflicts": [{"team_id": tid, "repo_slugs": cross_repo[tid]}
                               for tid in sorted(cross_repo)]})

    out.write("done: %d member(s) re-pointed%s%s.\n"
              % (total_repointed,
                 (", %d group(s) skipped (cross-repo)" % len(skipped_groups)) if skipped_groups else "",
                 " (dry-run — nothing written)" if dry_run else ""))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="heimdall-team-converge",
        description="Converge every repo's split team_ids onto ONE canonical team (converge-forward).")
    p.add_argument("--dry-run", action="store_true",
                   help="compute + print the full per-slug plan with ZERO writes.")
    p.add_argument("--allow-local", action="store_true",
                   help="permit a real EXECUTE against the LOCAL store (else refused — prod needs "
                        "HEIMDALL_STATE_BACKEND=firestore). --dry-run is read-only and never gated.")
    p.add_argument("--home", default=None,
                   help="control-plane HEIMDALL_HOME (default: the HEIMDALL_HOME env).")
    args = p.parse_args(argv)
    home = args.home if args.home is not None else os.environ.get("HEIMDALL_HOME")
    return converge(home=home, dry_run=args.dry_run, allow_local=args.allow_local)


if __name__ == "__main__":
    sys.exit(main())
