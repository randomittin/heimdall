#!/usr/bin/env bash
# heimdall-who — per-agent view over the HAID registry (spec T-1).
#
# Read-only. Answers "who is acting in this repo, under whose human identity,
# and is each still alive / trusted?" by summarising .planning/ledger/agents.json
# (the registry written by `heimdall-haid register`). It NEVER mutates state.
#
# It also surfaces the CURRENT instance's HAID and whether it is registered yet,
# so an operator can see at a glance if this checkout has announced itself.
#
# Heartbeat freshness: an entry whose last_heartbeat is older than the stale
# window (default 1800s / 30m, override with --stale-after N) is shown as
# "stale" even if its stored status is "active" — a derived liveness view that
# does not write back. Stored "revoked" always wins (trust beats liveness).
#
# Forward ref (T-2): once the ledger lands, this view will also fold in each
# HAID's claim/commit counts. For now it reports identity + liveness, which is
# the attribution backbone those counts will hang off.
#
# TEAM MODE P1+P2 (Shared Awareness + Gate Surface): the `team` subcommand JOINs
# the git-backed stores — the HAID registry (identity + liveness), the claims
# store, the activity store (bin/heimdall-activity), AND the gate-verdict store
# (bin/heimdall-gate-surface) — into one "who's-working-where + what's-PROVEN-where"
# view:
#   "sarah → auth/ (login refactor)  ·  PROVEN ✓ (12 gates)
#    raj   → payments/ (3 agents)    ·  BLOCKED ⛔ (secret-scan, cards.ts:5)
#    priya → api/ (rate limits)      ·  pending".
# P1 SURFACES an overlap warning (⚠) where two instances touch the same files;
# P2 appends each dev's REAL gate verdict (PROVEN/BLOCKED/pending — never a
# fabricated pass). All INFORMATIONAL, never a block: the team view always exits 0.
# Solo / feature-off (no activity/verdict records, or HEIMDALL_TEAM=off) → the
# plain default view below is byte-identical to today.
#
# Usage:
#   heimdall-who                       table: HAID, human, role, status, heartbeat
#   heimdall-who --json                machine-readable array of the same
#   heimdall-who --stale-after <secs>  override the staleness window (default 1800)
#   heimdall-who team [--json] [--gates]   JOIN agents × claims × activity × verdicts
#   -h, --help
#
# Exit: 0 ok; 2 usage/IO error.
set -euo pipefail

SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
fi
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PLUGIN_DIR="$(cd "$BIN_DIR/.." && pwd)"
PLANNING_DIR="${HEIMDALL_PLANNING_DIR:-$PLUGIN_DIR/.planning}"
REGISTRY_FILE="$PLANNING_DIR/ledger/agents.json"
ACTIVITY_BIN="$BIN_DIR/heimdall-activity"
GATE_SURFACE_BIN="$BIN_DIR/heimdall-gate-surface"
HAID_BIN="$BIN_DIR/heimdall-haid"
AGENTS_BIN="$BIN_DIR/heimdall-agents"

command -v jq >/dev/null 2>&1 || { echo "error: jq is required" >&2; exit 2; }

usage() { sed -n '2,39p' "$SELF" | sed 's/^# \{0,1\}//'; }

# ── HARNESS SUBAGENTS section (human view only) ───────────────────────────────
# The HAID table above is heimdall's OWN agents (agent-pool / ledger). Claude Code
# Agent-tool subagents (hmd:coder &c.) live in the HARNESS and never register here,
# so a hung/failed one would otherwise be invisible. bin/heimdall-agents enumerates
# them from the harness task dir + classifies by staleness/terminal marker; we fold
# its REAL per-subagent state (live/stale/failed/done/reaped) into the roster so the
# operator sees their true state, not "idle forever". Best-effort: absent tool or no
# task dir → the section is silently omitted (never an error, never a fabricated row).
subagents_section() {
  [ -x "$AGENTS_BIN" ] || return 0
  local rows
  rows="$("$AGENTS_BIN" list --json 2>/dev/null || echo '[]')"
  [ -n "$rows" ] || return 0
  local n
  n="$(printf '%s' "$rows" | jq 'length' 2>/dev/null || echo 0)"
  [ "${n:-0}" -gt 0 ] 2>/dev/null || return 0
  local live
  live="$(printf '%s' "$rows" | jq '[.[]|select(.state=="live")]|length' 2>/dev/null || echo 0)"
  echo
  echo "HARNESS SUBAGENTS ($n tracked, $live live) — Agent-tool, not in the HAID registry"
  printf '%s' "$rows" | jq -r '
    sort_by(.id)[] |
    "  " + .id + "\t" + .state + "\t" + "age:" + (.age_secs|tostring) + "s"
  ' | column -t -s "$(printf '\t')" 2>/dev/null || printf '%s' "$rows" | jq -r '
    sort_by(.id)[] | "  " + .id + "  " + .state + "  age:" + (.age_secs|tostring) + "s"'
}

# ── TEAM VIEW (P1 + P2) — JOIN agents × claims × activity × VERDICTS ──────────
# Read-only. Delegates the activity read + overlap to bin/heimdall-activity and
# the gate-verdict read to bin/heimdall-gate-surface (each is the one writer/reader
# of its store) so this view never re-derives a store's schema. ALWAYS exits 0
# (informational). Graceful with no records.
#
# P2 GATES column: P1 answered "who is working where"; P2 adds "what is PROVEN
# where". Each active dev's roster line carries their gate verdict, JOINed by HAID
# against the verdicts/ store: PROVEN ✓ (N gates) · BLOCKED ⛔ (gate, loc) · or an
# HONEST "pending" when no verdict has been published yet (never an invented pass).
# `--gates` is accepted for symmetry with the dossier (`hmd team --gates`) but the
# verdict is shown unconditionally — the gate surface IS the team wedge.
team_view() {
  local as_json="" want_gates=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)  as_json=1; shift ;;
      --gates) want_gates=1; shift ;;
      *) echo "error: unknown argument to team: $1" >&2; exit 2 ;;
    esac
  done
  : "$want_gates"  # accepted flag; gates are surfaced unconditionally below
  if [ ! -x "$ACTIVITY_BIN" ]; then
    if [ -n "$as_json" ]; then echo '[]'; else echo "(activity reader unavailable — no team view)"; fi
    exit 0
  fi
  local recs verdicts
  recs="$(HEIMDALL_PLANNING_DIR="$PLANNING_DIR" "$ACTIVITY_BIN" list --json 2>/dev/null || echo '[]')"
  # Read the git-tracked verdict store (P2). Absent / empty → an empty array, so a
  # P1-only world (no verdicts published) renders every active dev as "pending".
  if [ -x "$GATE_SURFACE_BIN" ]; then
    verdicts="$(HEIMDALL_PLANNING_DIR="$PLANNING_DIR" "$GATE_SURFACE_BIN" list --json 2>/dev/null || echo '[]')"
  else
    verdicts='[]'
  fi
  if [ -n "$as_json" ]; then
    # JOIN each activity record with its gate verdict (by HAID) so a JSON consumer
    # sees the merged "who + what's proven" record. A dev with no verdict carries
    # gate:{verdict:"pending"} — honest, never a fabricated pass.
    printf '%s' "$recs" | jq --argjson verdicts "$verdicts" '
      ($verdicts | map({(.haid): .}) | add // {}) as $vbyhaid
      | map(. + {gate: (
          ($vbyhaid[.haid]) as $v
          | if $v == null then {verdict: "pending"}
            else {verdict: $v.verdict, gates_total: $v.gates_total,
                  gates_passed: $v.gates_passed, gates_failed: $v.gates_failed,
                  failing_gates: ($v.failing_gates // []), loc: $v.loc} end)})'
    exit 0
  fi
  local count
  count="$(printf '%s' "$recs" | jq 'length' 2>/dev/null || echo 0)"
  if [ "$count" -eq 0 ]; then
    echo "(no team activity — solo, or no sibling has published yet)"
    exit 0
  fi
  echo "TEAM ACTIVITY ($count working)"
  # Roster line + GATES column: JOIN activity × verdict by HAID. PROVEN/BLOCKED are
  # the REAL recorded verdict; a missing verdict is honestly "pending".
  printf '%s' "$recs" | jq -r --argjson verdicts "$verdicts" '
    ($verdicts | map({(.haid): .}) | add // {}) as $vbyhaid
    | sort_by(.human)[]
    | . as $r
    | ($vbyhaid[$r.haid]) as $v
    | ($r.files_touched | if length>0 then (.[0] | sub("/\\*\\*$";"/") | sub("#.*$";"")) else "?" end) as $surface
    | (if $v == null then "pending"
       elif $v.verdict == "PROVEN" then "PROVEN ✓ (\($v.gates_passed) gates)"
       elif $v.verdict == "BLOCKED" then "BLOCKED ⛔ (\(($v.failing_gates // []) | join(", "))\(if $v.loc then ", \($v.loc)" else "" end))"
       elif $v.verdict == "PENDING" then "pending"
       else ($v.verdict // "pending") end) as $gate
    | "  \($r.human) → \($surface) (\($r.active_task)\(if ($r.agents_running // 1) > 1 then ", \($r.agents_running) agents" else "" end))  ·  \($gate)"
  '
  # Overlap warnings: ask the activity reader, per active instance, whether its
  # files intersect a sibling's. Informational — printed under the roster, never
  # blocks. Each instance's HAID drives one overlap pass.
  local printed_hdr=0 haid line
  while IFS= read -r haid; do
    [ -n "$haid" ] || continue
    while IFS= read -r line; do
      case "$line" in
        '⚠'*)
          if [ "$printed_hdr" -eq 0 ]; then echo; echo "OVERLAPS"; printed_hdr=1; fi
          printf '  %s\n' "$line" ;;
      esac
    done < <(HEIMDALL_PLANNING_DIR="$PLANNING_DIR" "$ACTIVITY_BIN" overlap --haid "$haid" 2>/dev/null || true)
  done < <(printf '%s' "$recs" | jq -r '.[].haid')
  exit 0  # team view is informational — ALWAYS 0
}

# ── argv: an optional leading `team` subcommand, else the legacy flag view ────
if [ "${1:-}" = "team" ]; then
  shift
  team_view "$@"
fi

AS_JSON=""
STALE_AFTER=1800
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --json) AS_JSON=1; shift ;;
    --stale-after)
      STALE_AFTER="${2:?--stale-after needs a value (seconds)}"
      case "$STALE_AFTER" in (*[!0-9]*|'') echo "error: --stale-after must be a non-negative integer" >&2; exit 2 ;; esac
      shift 2 ;;
    *) echo "error: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# Empty/absent registry → nothing registered yet. Report it honestly.
if [ ! -f "$REGISTRY_FILE" ]; then
  if [ -n "$AS_JSON" ]; then
    printf '[]\n'
  else
    echo "(no registry at $REGISTRY_FILE — no agents have registered yet)"
    subagents_section
  fi
  exit 0
fi

NOW_EPOCH="$(date +%s)"

# Current instance HAID (best-effort; the bin may not have run register yet).
CURRENT_HAID=""
if [ -x "$HAID_BIN" ]; then
  CURRENT_HAID="$($HAID_BIN current 2>/dev/null || true)"
fi

# Build the derived view: fold liveness over stored status. We parse the ISO
# heartbeat to epoch in jq via `fromdateiso8601` (GNU/macOS jq both support it).
VIEW="$(jq \
  --argjson now "$NOW_EPOCH" \
  --argjson window "$STALE_AFTER" \
  --arg current "$CURRENT_HAID" '
  [ .agents | to_entries[] | {
      haid: .key,
      human: (.value.human // "unknown"),
      role: (.value.role // "unknown"),
      tool: (.value.tool // "unknown"),
      tool_version: (.value.tool_version // "unknown"),
      first_seen: (.value.first_seen // null),
      last_heartbeat: (.value.last_heartbeat // null),
      stored_status: (.value.status // "unknown"),
      is_current: (.key == $current)
    }
    | .age = ( if .last_heartbeat == null then null
               else ($now - (.last_heartbeat | fromdateiso8601? // $now)) end )
    | .status = (
        if .stored_status == "revoked" then "revoked"
        elif (.age != null and .age > $window) then "stale"
        else .stored_status end )
  ]
  | sort_by(.haid)
' "$REGISTRY_FILE")"

if [ -n "$AS_JSON" ]; then
  printf '%s\n' "$VIEW"
  exit 0
fi

COUNT="$(printf '%s' "$VIEW" | jq 'length')"
if [ "$COUNT" -eq 0 ]; then
  echo "(no agents registered yet)"
  subagents_section
  exit 0
fi

# Human-readable table. Marker '*' flags the current instance.
echo "HEIMDALL AGENTS ($COUNT registered)"
printf '%s\n' "$VIEW" | jq -r '
  .[] |
  ( if .is_current then "*" else " " end ) + " " +
  .haid + "\t" +
  .status + "\t" +
  .human + "\t" +
  .role + "\t" +
  "v:" + .tool_version + "\t" +
  "last:" + ( .last_heartbeat // "never" )
' | column -t -s "$(printf '\t')" 2>/dev/null || printf '%s\n' "$VIEW" | jq -r '
  .[] |
  ( if .is_current then "*" else " " end ) + " " +
  .haid + "  " + .status + "  " + .human + "  " + .role +
  "  last:" + ( .last_heartbeat // "never" )'

# Footnote: is THIS instance announced?
if [ -n "$CURRENT_HAID" ]; then
  if printf '%s' "$VIEW" | jq -e --arg c "$CURRENT_HAID" 'any(.haid == $c)' >/dev/null 2>&1; then
    :
  else
    echo
    echo "note: this instance ($CURRENT_HAID) is not yet registered — run 'heimdall-haid register'"
  fi
fi

# Harness Agent-tool subagents (not in the HAID registry) — their REAL live state.
subagents_section
