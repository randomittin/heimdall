#!/usr/bin/env bash
# heimdall-cc-selfheal — hmd auto-heals Claude Code's NATIVE auto-updater.
#
# THE PROBLEM IT FIXES. On a NATIVE Claude Code install (~/.local/bin/claude ->
# ~/.local/share/claude/versions/<v>, installMethod=native) a STALE npm-global
# `@anthropic-ai/claude-code` left over from an older npm install conflicts with the
# native updater — Claude Code shows "✘ Auto-update failed · Run /doctor". The proven
# repair (verified on a real machine): remove the conflicting npm-global package,
# ensure autoUpdates:true in ~/.claude.json, then `claude update`. This automates that.
#
# THE SAFE-APPLY MODEL — the running session is NEVER touched. We do NOT hot-swap or
# restart the live `claude` process; the native updater stages the next version into a
# new versions/ dir + repoints the symlink, taking effect on the NEXT launch. The
# durable repair is removing the npm conflict + the config flag — after that Claude
# Code's OWN updater works again; our `claude update` is a best-effort re-stage/verify.
#
# DETECTION IS READ-ONLY — AND WHY THAT MATTERS. This tool used to PROBE health by
# running `claude update` and treating a non-zero exit as "unhealthy". That probe is a
# mutating INSTALL, not a query: it made hmd spawn an updater that competes with the
# auto-update poll every live session already runs (~30 min) for Claude's per-version
# install lock. A losing racer throws, and Claude renders exactly the banner this tool
# exists to remove: "✘ Auto-update failed · Run claude doctor". On a machine with no npm
# conflict the probe was also pointless — repair() had nothing to fix and just re-ran
# `claude update` ("self-heal: nothing to repair" in the log, twice a window).
# Health is now read from Claude's OWN recorded outcome, ~/.claude/.last-update-result.json
# ({outcome,status,version_from,version_to,error_code}), which is authoritative and free.
# `claude update` is now issued ONLY after we actually repaired something — never as a probe.
#
# THE SECOND FAILURE MODE (added after a real sighting): that record can OUTLIVE the
# fault it describes. Claude writes it only when it ATTEMPTS an install, so a transient
# version-check failure recorded while you are ALREADY on the newest version can never be
# superseded — nothing is left to install, so no attempt happens, so no success record is
# ever written. Observed: install_failed, version_to=null, error_code=null, on a machine
# with installMethod=native, autoUpdates=true, PATH fine, dirs writable, releases endpoint
# 200 and `claude update` reporting "up to date". The banner had been up for hours with
# nothing wrong. That is a fault report that cannot expire — worse than no banner, because
# it teaches the operator to ignore the one channel that would show a REAL failure.
# update_result_obsolete() detects exactly that shape and clears it; see its comment for
# why age (not just version) is the load-bearing condition.
#
# SUBCOMMANDS (the SessionStart hook depends on `check` — keep the interface stable):
#   heimdall-cc-selfheal check    throttled, background, safe. Detect → repair → log.
#                                 ALWAYS exit 0 fast; the repair runs DETACHED.
#   heimdall-cc-selfheal status   read-only: print healthy/unhealthy + what it would do.
#   heimdall-cc-selfheal pin-notice
#                                 read-only, fast, ONE line: warn when THIS session is
#                                 pinned to an older binary than the newest installed.
#                                 A running process cannot be hot-swapped onto a new
#                                 binary, so the only honest remedy is "restart" — we say
#                                 so once at SessionStart rather than nagging every render.
#   heimdall-cc-selfheal --force  ignore the throttle; run now.
#
# SAFETY CONTRACT.
#   * ONLY acts on a NATIVE install — never touches an npm/brew/other-managed Claude Code.
#   * The ONLY package it ever uninstalls is the exact conflict `@anthropic-ai/claude-code`.
#   * NEVER blocks SessionStart (detached + throttled + fast-exit); offline/missing-tools =
#     silent no-op, exit 0. Idempotent: a healthy machine is a pure no-op.
#   * Atomic, key-preserving edit of ~/.claude.json (tmp+rename). NEVER touches credentials,
#     never echoes/stores a secret. `set -uo pipefail`, never `set -x`.
#   * Opt out: HEIMDALL_NO_SELFHEAL=1 or ${HOME}/.heimdall/no-selfheal.
#
# ENV / OVERRIDES:
#   HEIMDALL_NO_SELFHEAL=1          opt out (also: ${HOME}/.heimdall/no-selfheal file).
#   HEIMDALL_SELFHEAL_INTERVAL=N    throttle window in seconds (default 86400 = 24h).
#   HEIMDALL_HOME                   state home (stamp + log + opt-out). Default ~/.heimdall.
#   HEIMDALL_CLAUDE_CONFIG          path to claude.json (default ~/.claude.json). TEST seam.
#   HEIMDALL_SELFHEAL_DRYRUN=1      TEST seam: detect + log "would-repair", apply NOTHING.
#   HEIMDALL_CC_UPDATE_RESULT       path to Claude's own last-update-result.json
#                                   (default ~/.claude/.last-update-result.json). TEST seam.
#   HEIMDALL_CC_RESULT_STALE_HOURS  age past which a recorded FAILURE is treated as dead
#                                   rather than live, and cleared (default 6). TEST seam.
#   HEIMDALL_CC_VERSIONS            claude versions dir. TEST seam.
#   HEIMDALL_CC_PIN_PID             pid to resolve the running version from. TEST seam.
#   HEIMDALL_CC_LSOF                `lsof -p <pid>`-style stub. TEST seam.

set -uo pipefail

HMD_HOME="${HEIMDALL_HOME:-$HOME/.heimdall}"
STAMP="$HMD_HOME/.cc-selfheal-stamp"
OPT_OUT_FILE="$HMD_HOME/no-selfheal"
LOG_FILE="$HMD_HOME/cc-selfheal.log"
CLAUDE_JSON="${HEIMDALL_CLAUDE_CONFIG:-$HOME/.claude.json}"
INTERVAL="${HEIMDALL_SELFHEAL_INTERVAL:-86400}"
NPM_CONFLICT="@anthropic-ai/claude-code"
UPDATE_RESULT="${HEIMDALL_CC_UPDATE_RESULT:-$HOME/.claude/.last-update-result.json}"
# Hours after which a recorded FAILURE is treated as dead rather than live. A real
# failing updater retries and rewrites the record, so age is what separates the two.
# Deliberately well above Claude's own retry cadence so a flapping updater is never
# mistaken for a settled one. Test seam.
STALE_HOURS="${HEIMDALL_CC_RESULT_STALE_HOURS:-6}"
CC_VERSIONS="${HEIMDALL_CC_VERSIONS:-$HOME/.local/share/claude/versions}"

log() {  # one-line, secret-free, best-effort
  mkdir -p "$HMD_HOME" 2>/dev/null || return 0
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo now)" "$*" >> "$LOG_FILE" 2>/dev/null || true
}

opted_out() {
  [ "${HEIMDALL_NO_SELFHEAL:-0}" = "1" ] && return 0
  [ -f "$OPT_OUT_FILE" ] && return 0
  return 1
}

# native install? — the ONLY shape we ever act on. Read installMethod from claude.json;
# fall back to the binary-symlink shape (~/.local/.../share/claude/versions). Anything
# else (npm/brew/unknown) -> NOT native -> we never touch it.
is_native() {
  if [ -r "$CLAUDE_JSON" ] && command -v python3 >/dev/null 2>&1; then
    local m
    m="$(python3 -c "import json,sys
try: print(json.load(open(sys.argv[1])).get('installMethod') or '')
except Exception: print('')" "$CLAUDE_JSON" 2>/dev/null)"
    [ "$m" = "native" ] && return 0
    [ -n "$m" ] && return 1   # an explicit non-native method -> not ours
  fi
  # no method recorded: infer from the binary location
  local b; b="$(command -v claude 2>/dev/null || true)"
  case "$b" in */.local/bin/claude|*/.local/share/claude/*) return 0 ;; esac
  return 1
}

# the conflicting npm-global package present?
npm_conflict_present() {
  command -v npm >/dev/null 2>&1 || return 1
  npm ls -g --depth=0 "$NPM_CONFLICT" >/dev/null 2>&1
}

# autoUpdates explicitly false in claude.json?
autoupdates_false() {
  [ -r "$CLAUDE_JSON" ] && command -v python3 >/dev/null 2>&1 || return 1
  python3 -c "import json,sys
try: sys.exit(0 if json.load(open(sys.argv[1])).get('autoUpdates') is False else 1)
except Exception: sys.exit(1)" "$CLAUDE_JSON" 2>/dev/null
}

# Did the native updater's LAST REAL attempt fail? READ-ONLY: Claude records every
# attempt's outcome itself, so we read that instead of provoking a fresh install.
# Absent/unreadable/unparseable file -> NOT failing (we never invent a fault).
updater_failing() {
  [ -r "$UPDATE_RESULT" ] && command -v python3 >/dev/null 2>&1 || return 1
  python3 -c "import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(1)
if not isinstance(d,dict): sys.exit(1)
sys.exit(0 if (d.get('outcome')=='failed' or (d.get('status') or '').endswith('_failed')) else 1)" \
    "$UPDATE_RESULT" 2>/dev/null
}

# one-line human summary of that recorded outcome (read-only; never a secret).
update_result_detail() {
  [ -r "$UPDATE_RESULT" ] && command -v python3 >/dev/null 2>&1 || return 1
  python3 -c "import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(1)
if not isinstance(d,dict): sys.exit(1)
print('%s (%s->%s%s)' % (d.get('status') or d.get('outcome') or '?',
      d.get('version_from') or '?', d.get('version_to') or '?',
      ', error_code=%s' % d['error_code'] if d.get('error_code') else ''))" \
    "$UPDATE_RESULT" 2>/dev/null
}

# Is the recorded failure OBSOLETE — a failure that can never be superseded?
#
# THE BUG THIS EXISTS FOR. Claude writes .last-update-result.json only when it
# ATTEMPTS an install, and the banner renders from that record. So a transient
# version-check failure (observed: status=install_failed, version_to=null,
# error_code=null — it never even resolved a target) gets recorded while you are
# ALREADY on the newest version. Now nothing is left to install, so no further
# attempt happens, so no success record is ever written, so the record can never
# be replaced — and the banner shows a dead failure indefinitely. On the machine
# this was found on it had been showing one for hours with a healthy install:
# installMethod=native, autoUpdates=true, PATH fine, dirs writable, releases
# endpoint 200, `claude update` -> "up to date".
#
# This is the silent-aging class: not a monitor that stopped, but a fault report
# that cannot expire. It is strictly worse than no banner, because it trains the
# operator to ignore the one channel that would report a REAL update failure.
#
# WHY THIS IS NOT JUST "DELETE THE ANNOYING FILE". Clearing a record that
# describes a LIVE failure would hide a real fault. All of these must hold:
#   1. the record says failed;
#   2. it is OLD (> STALE_HOURS). A genuinely failing updater retries and
#      rewrites this file, so an unrefreshed record means nothing has failed
#      since. This is the load-bearing condition — it is what distinguishes a
#      dead record from an actively failing one, without any network call;
#   3. we are already running the newest binary present locally, so there is no
#      staged install the record could still be describing;
#   4. the install is otherwise healthy (native, no npm conflict) — if the npm
#      conflict is present, that is the real fault and repair() fixes THAT.
# Fail closed: unreadable, unparseable or undatable -> NOT obsolete.
update_result_obsolete() {
  [ -r "$UPDATE_RESULT" ] && command -v python3 >/dev/null 2>&1 || return 1
  is_native || return 1
  npm_conflict_present && return 1
  local newest; newest="$(_newest_installed)"
  [ -n "$newest" ] || return 1
  python3 -c "import json,sys,datetime
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(1)
if not isinstance(d,dict): sys.exit(1)
if not (d.get('outcome')=='failed' or (d.get('status') or '').endswith('_failed')): sys.exit(1)
ts=d.get('timestamp')
if not isinstance(ts,str): sys.exit(1)
try: t=datetime.datetime.fromisoformat(ts.replace('Z','+00:00'))
except Exception: sys.exit(1)
now=datetime.datetime.now(datetime.timezone.utc)
age_h=(now-t).total_seconds()/3600.0
if age_h < float(sys.argv[3]): sys.exit(1)   # too recent — could still be live
# Must already be on the newest local binary, and the record must not name a
# DIFFERENT target still pending. version_to=null means no target was resolved.
if (d.get('version_from') or '') != sys.argv[2]: sys.exit(1)
vt=d.get('version_to')
if vt not in (None,'',sys.argv[2]): sys.exit(1)
sys.exit(0)" "$UPDATE_RESULT" "$newest" "$STALE_HOURS" 2>/dev/null
}

# unhealthy iff (on a native install) the npm conflict exists OR the updater fails.
# autoUpdates:false alone is NOT treated as unhealthy (could be a deliberate user choice);
# it is only repaired when a real failure is also present.
detect_unhealthy() {
  is_native || return 1
  npm_conflict_present && return 0
  updater_failing && return 0
  return 1
}

set_autoupdates_true() {  # atomic, key-preserving
  [ -w "$CLAUDE_JSON" ] || [ ! -e "$CLAUDE_JSON" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$CLAUDE_JSON" <<'PY' 2>/dev/null || return 1
import json,os,sys,tempfile
p=sys.argv[1]
try: d=json.load(open(p))
except Exception: d={}
if d.get("autoUpdates") is True: sys.exit(0)
d["autoUpdates"]=True
dirp=os.path.dirname(p) or "."
fd,tmp=tempfile.mkstemp(dir=dirp,prefix=".claude.",suffix=".tmp")
with os.fdopen(fd,"w") as f: json.dump(d,f,indent=2)
os.replace(tmp,p)
PY
}

repair() {
  local did=0 cleared=0
  if [ "${HEIMDALL_SELFHEAL_DRYRUN:-0}" = "1" ]; then
    npm_conflict_present && log "would-repair: uninstall $NPM_CONFLICT (npm conflict)"
    autoupdates_false && log "would-repair: set autoUpdates=true"
    update_result_obsolete && log "would-repair: clear obsolete update-failure record ($(update_result_detail))"
    log "would-repair: claude update"
    return 0
  fi
  # Clear an obsolete failure record FIRST, and unconditionally log that we did.
  # Deleting a fault report silently would be its own version of this bug, so the
  # log line names exactly what was removed. Claude treats an absent record as
  # "no result" (verified in the 2.1.227 reader: a missing file returns null),
  # so removal is the supported way to say "this no longer describes anything".
  if update_result_obsolete; then
    local detail; detail="$(update_result_detail)"
    if rm -f "$UPDATE_RESULT" 2>/dev/null; then
      log "repaired: cleared obsolete update-failure record [$detail] — older than ${STALE_HOURS}h, already on newest local binary, no npm conflict"
      # Deliberately does NOT set `did`. `did` gates the `claude update` re-stage
      # at the end of this function, and clearing a dead record is precisely the
      # case where there is nothing to install. Re-staging here would race the
      # auto-update poll of every live session for the install lock — which is
      # how this tool could CAUSE the banner it just removed. Nothing to install,
      # nothing to run.
      cleared=1
    else
      log "WARN: could not remove obsolete update-failure record at $UPDATE_RESULT"
    fi
  fi
  if npm_conflict_present; then
    if npm uninstall -g "$NPM_CONFLICT" >/dev/null 2>&1; then
      log "repaired: uninstalled npm-global $NPM_CONFLICT (native-install conflict)"; did=1
      # tidy the empty @anthropic-ai parent dir if npm left one
      local root; root="$(npm root -g 2>/dev/null)"
      [ -n "$root" ] && [ -d "$root/@anthropic-ai" ] && [ -z "$(ls -A "$root/@anthropic-ai" 2>/dev/null)" ] && rmdir "$root/@anthropic-ai" 2>/dev/null || true
    else
      log "WARN: npm uninstall $NPM_CONFLICT failed (left as-is)"
    fi
  fi
  if autoupdates_false; then
    set_autoupdates_true && { log "repaired: set autoUpdates=true in claude.json"; did=1; } || log "WARN: could not set autoUpdates"
  fi
  # Re-stage ONLY if we genuinely repaired something. Issuing `claude update` when there
  # was nothing to fix is not a no-op: it races the auto-update poll of every live
  # session for the install lock and can itself CAUSE the "Auto-update failed" banner.
  # With the conflict gone, Claude's own updater is the one that should drive the install.
  if [ "$did" = 1 ] && command -v claude >/dev/null 2>&1; then
    if claude update >/dev/null 2>&1; then log "verified: claude update -> ok"; else log "NOTE: claude update non-zero after repair (Claude's own updater will retry)"; fi
  fi
  if [ "$did" = 1 ] || [ "$cleared" = 1 ]; then log "self-heal complete"; else log "self-heal: nothing to repair (no mutation attempted)"; fi
}

throttled() {  # true if checked within the window (skip)
  [ -f "$STAMP" ] || return 1
  local now mt; now="$(date +%s 2>/dev/null || echo 0)"
  mt="$(stat -f %m "$STAMP" 2>/dev/null || stat -c %Y "$STAMP" 2>/dev/null || echo 0)"
  [ "$((now - mt))" -lt "$INTERVAL" ]
}

cmd_status() {  # read-only
  if ! is_native; then echo "cc-selfheal: not a native Claude Code install — skipped"; return 0; fi
  local issues="" detail
  npm_conflict_present && issues="${issues} npm-conflict($NPM_CONFLICT)"
  if updater_failing; then
    detail="$(update_result_detail 2>/dev/null || true)"
    # Distinguish a LIVE failure from a dead one. Reporting both as the same thing
    # is what let a banner sit for hours on a demonstrably healthy install.
    if update_result_obsolete; then
      issues="${issues} stale-update-failure${detail:+[$detail]}(obsolete:would-clear)"
    else
      issues="${issues} last-update-failed${detail:+[$detail]}"
    fi
  fi
  autoupdates_false && issues="${issues} autoUpdates:false"
  if [ -n "$issues" ]; then echo "cc-selfheal: UNHEALTHY —$issues (would repair)"; else echo "cc-selfheal: healthy"; fi
  cmd_pin_notice || true
}

# ── the pin notice ───────────────────────────────────────────────────────────────
# A live process executes its binary for its whole life; hmd can NEVER hot-swap it onto
# a newer one, and killing a session to force adoption is off the table. So the honest
# fix is to TELL the user, once, at SessionStart. Resolution is by lsof, because argv is
# not sufficient: a pinned session's argv is just "claude" with no version in it.
_lsof_p() {
  if [ -n "${HEIMDALL_CC_LSOF:-}" ]; then "$HEIMDALL_CC_LSOF" "$1" 2>/dev/null; return 0; fi
  lsof -p "$1" 2>/dev/null || true
}

# nearest ancestor pid whose command is claude (the session hosting this hook).
_claude_ancestor() {
  if [ -n "${HEIMDALL_CC_PIN_PID:-}" ]; then printf '%s\n' "$HEIMDALL_CC_PIN_PID"; return 0; fi
  local pid="$PPID" n=0 comm
  while [ -n "$pid" ] && [ "$pid" != 0 ] && [ "$pid" != 1 ] && [ "$n" -lt 12 ]; do
    comm="$(ps -o comm= -p "$pid" 2>/dev/null || true)"
    case "${comm##*/}" in claude) printf '%s\n' "$pid"; return 0 ;; esac
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
    n=$((n + 1))
  done
  return 1
}

# the versions/<v> binary a pid actually has open.
_running_version() {
  _lsof_p "$1" | tr ' ' '\n' | grep -F "$CC_VERSIONS/" | head -1 | sed "s|^.*$CC_VERSIONS/||;s|/.*$||"
}

_newest_installed() { ls "$CC_VERSIONS" 2>/dev/null | sort -V | tail -1; }

cmd_pin_notice() {
  opted_out && return 0
  is_native || return 0
  [ -d "$CC_VERSIONS" ] || return 0
  local pid running newest
  pid="$(_claude_ancestor || true)";        [ -n "$pid" ] || return 0
  running="$(_running_version "$pid" || true)"; [ -n "$running" ] || return 0
  newest="$(_newest_installed || true)";    [ -n "$newest" ] || return 0
  [ "$running" = "$newest" ] && return 0
  # only ever report BEHIND — a session ahead of the newest on-disk build is not a fault.
  [ "$(printf '%s\n%s\n' "$running" "$newest" | sort -V | head -1)" = "$running" ] || return 0
  printf '[heimdall] claude %s is pinned by this session; %s is installed — restart to adopt it (auto-update cannot swap a running binary).\n' \
    "$running" "$newest"
}

cmd_check() {  # throttled + DETACHED; never blocks the session
  opted_out && exit 0
  is_native || exit 0
  [ "${1:-}" = "--force" ] || ! throttled || exit 0
  mkdir -p "$HMD_HOME" 2>/dev/null || exit 0
  : > "$STAMP" 2>/dev/null || true   # claim the window BEFORE the detached run
  # detached so SessionStart returns instantly; the detect+repair (incl `claude update`)
  # happens in the background and only mutates when genuinely unhealthy.
  ( detect_unhealthy && repair ) >/dev/null 2>&1 &
  exit 0
}

case "${1:-check}" in
  check)        shift 2>/dev/null || true; cmd_check "${1:-}" ;;
  --force)      cmd_check --force ;;
  status)       cmd_status ;;
  pin-notice)   cmd_pin_notice ;;
  -h|--help)    sed -n '2,60p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)            echo "heimdall-cc-selfheal: unknown arg '${1}' (check|status|pin-notice|--force)" >&2; exit 2 ;;
esac
