# heimdall-maintainer-job.yaml — the Cloud Run Job manifest for UNATTENDED maintainer
# dispatch (Arch B, fully-cloud). Apply with:
#
#   gcloud run jobs replace deploy/cloud-run/heimdall-maintainer-job.yaml --region=us-central1
#
# This runs the SAME run-to-completion entrypoint as heimdall-long-job
# (`heimdall-control-plane run-job`); each execution overrides the container args to
# `run-job,<JOB_ID>` (the dispatcher supplies the per-job id). The difference from
# heimdall-long-job is an image carrying the maintainer toolchain (git + gh CLI + claude
# CLI). See MAINTAINER-RUNBOOK.md.
#
# DIGEST-PINNED (required): the `image` below MUST be a content-addressed
# `...@sha256:<digest>` reference, never a mutable tag — a Job must pin exactly what runs
# so a re-tag cannot silently change it. Resolve the digest per MAINTAINER-RUNBOOK.md §3.2
# and paste it in before `gcloud run jobs replace` (deploy-arch-b.sh does this automatically).
#
# MULTITENANT LLM/PR AUTH — NOT baked into this base manifest. The per-team LLM token
# (CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY) and the PR-bot token (HEIMDALL_PR_BOT_TOKEN)
# are supplied PER EXECUTION by the DISPATCHER's env override (cp_maintainer_runner /
# CloudRunJobRunner — the other agent's domain), scoped to the team the cycle runs for. They
# are DELIBERATELY absent below so `gcloud run jobs replace` does NOT fail on secrets that may
# not exist for every team, and so no single team's token is baked into a shared base Job.
# NEVER commit a token value here.
#
# JOB-NAME ALIGNMENT: cp_jobrunner.CloudRunJobRunner defaults to 'heimdall-long-job'
# (JOB_NAME_DEFAULT), overridable ONLY via env HEIMDALL_CP_JOB_NAME (JOB_NAME_ENV). This Job
# is named 'heimdall-maintainer-job', so the control-plane SERVICE that fires the maintainer
# tick MUST run with HEIMDALL_CP_JOB_NAME=heimdall-maintainer-job (MAINTAINER-RUNBOOK.md §3),
# else the cycle dispatches to heimdall-long-job (which lacks git/gh/claude) and fails.

apiVersion: run.googleapis.com/v1
kind: Job
metadata:
  name: heimdall-maintainer-job
  labels:
    heimdall-component: maintainer
  annotations:
    run.googleapis.com/launch-stage: GA
spec:
  template:
    spec:
      # --max-retries=1 -> a failed execution is retried once (restart-safe: all durable
      # state is in Firestore, not local disk).
      taskCount: 1
      parallelism: 1
      template:
        spec:
          maxRetries: 1
          # --task-timeout=3600 -> bound one maintainer execution to 1h. A Job has no
          # request timeout; it runs to completion with full CPU (unlike the service).
          timeoutSeconds: 3600
          # the runtime SA MUST hold roles/datastore.user + secretmanager.secretAccessor
          # on the mounted secrets (RUNBOOK §3.1). It does NOT need run.jobs.run — that is
          # the DISPATCHER's permission, not the executor's.
          serviceAccountName: heimdall-cp-runtime@heimdall-cp-prod.iam.gserviceaccount.com
          containers:
              # DIGEST-PINNED image carrying git + gh + the claude CLI on top of the
              # control-plane image. Replace with the resolved @sha256 digest.
            - image: us-central1-docker.pkg.dev/heimdall-cp-prod/heimdall/heimdall-maintainer@sha256:b1aa78d2958dd51549717e188a89c2f43c70ad1318b20f83bbf07051e10f069d
              # the run-to-completion entrypoint; each execution overrides args -> run-job,<JOB_ID>.
              command:
                - heimdall-control-plane
              args:
                - run-job
              env:
                # ── control-plane identity (identical seed + server HAID as the service) ──
                - name: HEIMDALL_STATE_BACKEND
                  value: firestore
                - name: GOOGLE_CLOUD_PROJECT
                  value: heimdall-cp-prod
                - name: HEIMDALL_CP_SERVER_HAID
                  value: cp-server
                - name: HEIMDALL_CP_PKI_KEY
                  valueFrom:
                    secretKeyRef:
                      name: cp-pki-key
                      key: latest
                # ── per-team LLM + PR-bot auth is NOT here (see header) ──────────────────────
                # CLAUDE_CODE_OAUTH_TOKEN (or ANTHROPIC_API_KEY) and HEIMDALL_PR_BOT_TOKEN are
                # injected PER EXECUTION by the dispatcher's env override, scoped to the team the
                # cycle runs for — never baked into this shared base Job (multitenant-safe: a
                # `jobs replace` here does not depend on any team's token secret existing).
              resources:
                limits:
                  cpu: "1"
                  memory: 1Gi
