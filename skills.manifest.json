  "detection_rules": {
    "frontend": {
      "files": ["*.tsx", "*.jsx", "*.vue", "*.svelte", "*.css", "*.scss", "*.less", "tailwind.config.*", "postcss.config.*", "vite.config.*"],
      "entries": ["frontend-design", "design-for-ai"]
    },
    "playwright": {"files": ["playwright.config.*", "cypress.config.*", "*.spec.ts"], "entries": ["playwright"]},
    "pr-workflow": {"files": [".github/pull_request_template*", ".github/workflows/*", ".github/CODEOWNERS"], "entries": ["pr-review-toolkit"]},
    "code-review": {"files": ["*.ts", "*.js", "*.py", "*.go", "*.rs", "*.java", "*.rb", "*.sh", "*.tsx", "*.jsx"], "entries": ["code-review"]},
    "security": {"files": ["*.ts", "*.js", "*.py", "*.go", "*.rs", "*.java"], "entries": ["security-guidance"]},
    "slack": {"files": [".slack*", "slack.json", "slack-*.json"], "entries": ["slack"]},
    "docs": {"files": ["CLAUDE.md", "AGENTS.md", "GEMINI.md"], "entries": ["claude-md-management"]}
  },
  "keyword_skills": ["ui-ux-pro-max", "oh-my-mermaid", "token-optimizer", "context-mode", "godogen", "claude-obsidian", "claude-ads", "claude-seo", "get-shit-done"]
